<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Elysian</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        /* Inherit all base styles */
        :root {
            --cream: #fdf0ec;
            --light-blue: #aee1f9;
            --medium-blue: #bde3fb;
            --deep-blue: #92bcfa;
            --text-dark: #333333;
            --text-light: #666666;
            --shadow: rgba(146, 188, 250, 0.1);
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            background-color: var(--cream);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            line-height: 1.2;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        section {
            padding: 80px 0;
        }

        /* Contact Header */
        .contact-header {
            padding-top: 150px;
            padding-bottom: 60px;
            background: linear-gradient(to right, var(--cream) 0%, rgba(253, 240, 236, 0.9) 100%);
        }

        .contact-header-content {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .contact-header h1 {
            font-size: 48px;
            margin-bottom: 20px;
            color: var(--text-dark);
        }

        .contact-header p {
            font-size: 18px;
            color: var(--text-light);
            margin-bottom: 30px;
        }

        /* Contact Section */
        .contact-section {
            background-color: white;
            padding: 60px 0 100px;
        }

        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        /* Contact Info */
        .contact-info {
            background-color: var(--cream);
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 8px 25px var(--shadow);
        }

        .info-title {
            font-size: 28px;
            margin-bottom: 30px;
            color: var(--text-dark);
        }

        .contact-method {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid rgba(146, 188, 250, 0.2);
        }

        .contact-method:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .contact-icon {
            width: 60px;
            height: 60px;
            background-color: var(--deep-blue);
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .contact-details h4 {
            font-size: 20px;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .contact-details p {
            color: var(--text-light);
            margin-bottom: 5px;
        }

        .contact-hours {
            color: var(--text-light);
            font-size: 14px;
        }

        .social-links {
            display: flex;
            gap: 15px;
            margin-top: 40px;
        }

        .social-link {
            width: 48px;
            height: 48px;
            background-color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--deep-blue);
            font-size: 20px;
            transition: var(--transition);
            border: 1px solid var(--medium-blue);
        }

        .social-link:hover {
            background-color: var(--deep-blue);
            color: white;
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(146, 188, 250, 0.3);
        }

        /* Contact Form */
        .contact-form {
            background-color: white;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 8px 25px var(--shadow);
            border: 1px solid rgba(146, 188, 250, 0.2);
        }

        .form-title {
            font-size: 28px;
            margin-bottom: 30px;
            color: var(--text-dark);
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--text-dark);
        }

        .form-input, .form-textarea {
            width: 100%;
            padding: 15px 20px;
            border: 2px solid var(--medium-blue);
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-size: 16px;
            transition: var(--transition);
            background-color: white;
        }

        .form-input:focus, .form-textarea:focus {
            outline: none;
            border-color: var(--deep-blue);
            box-shadow: 0 0 0 3px rgba(146, 188, 250, 0.2);
        }

        .form-textarea {
            min-height: 150px;
            resize: vertical;
        }

        .submit-temp-btn {
            width: 100%;
            background-color: var(--deep-blue);
            color: white;
            border: none;
            padding: 18px 30px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 16px;
        }

        .submit-temp-btn:hover {
            background-color: var(--medium-blue);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(146, 188, 250, 0.3);
        }

        /* FAQ Section */
        .faq-section {
            background-color: var(--light-blue);
            padding: 100px 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 36px;
            color: var(--text-dark);
            margin-bottom: 15px;
        }

        .section-header p {
            font-size: 18px;
            color: var(--text-light);
            max-width: 600px;
            margin: 0 auto;
        }

        .faq-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .faq-item {
            background-color: white;
            border-radius: 12px;
            margin-bottom: 20px;
            overflow: hidden;
            box-shadow: 0 5px 20px var(--shadow);
            transition: var(--transition);
        }

        .faq-item:hover {
            box-shadow: 0 10px 30px rgba(146, 188, 250, 0.2);
        }

        .faq-question {
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .faq-question:hover {
            background-color: rgba(146, 188, 250, 0.05);
        }

        .faq-question h3 {
            font-size: 20px;
            color: var(--text-dark);
            margin: 0;
            flex: 1;
        }

        .faq-icon {
            color: var(--deep-blue);
            font-size: 20px;
            transition: var(--transition);
            margin-left: 20px;
        }

        .faq-answer {
            padding: 0 30px;
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
            color: var(--text-light);
            line-height: 1.7;
        }

        .faq-item.active .faq-answer {
            padding: 0 30px 30px 30px;
            max-height: 500px;
        }

        .faq-item.active .faq-icon {
            transform: rotate(180deg);
        }

        /* Map Section */
        .map-section {
            background-color: white;
            padding: 100px 0;
        }

        .map-container {
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 25px var(--shadow);
            height: 400px;
            background-color: var(--cream);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
        }

        .map-placeholder {
            text-align: center;
            padding: 40px;
        }

        .map-placeholder i {
            font-size: 64px;
            color: var(--medium-blue);
            margin-bottom: 20px;
        }

        .map-placeholder h3 {
            font-size: 24px;
            margin-bottom: 10px;
            color: var(--text-dark);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .contact-header h1 {
                font-size: 42px;
            }
            
            .section-header h2 {
                font-size: 32px;
            }
        }

        @media (max-width: 992px) {
            .contact-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .contact-header h1 {
                font-size: 36px;
            }
            
            .section-header h2 {
                font-size: 28px;
            }
        }

        @media (max-width: 768px) {
            .contact-header {
                padding-top: 120px;
            }
            
            .contact-info,
            .contact-form {
                padding: 30px;
            }
            
            .contact-header h1 {
                font-size: 32px;
            }
            
            .info-title,
            .form-title {
                font-size: 24px;
            }
            
            .contact-method {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .faq-question {
                padding: 20px;
            }
            
            .faq-question h3 {
                font-size: 18px;
            }
            
            .faq-answer {
                padding: 0 20px;
            }
            
            .faq-item.active .faq-answer {
                padding: 0 20px 20px 20px;
            }
        }

        @media (max-width: 576px) {
            .social-links {
                justify-content: center;
            }
            
            .contact-icon {
                width: 50px;
                height: 50px;
                font-size: 20px;
            }
            
            .map-container {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <!-- Contact Header -->
    <section class="contact-header editable-section" data-section="190">
        <div class="container">
            <div class="contact-header-content">
                <h1 class="editable-text editable-section no-drop-zone" data-section="191" data-text="146">Get in Touch</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="192" data-text="147">Have questions about our luxury home accessories? We're here to help you find the perfect pieces for your space.</p>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section editable-section" data-section="193">
        <div class="container">
            <div class="contact-container">
                <!-- Contact Info -->
                <div class="contact-info editable-section no-drop-zone" data-section="194">
                    <h2 class="info-title editable-text editable-section no-drop-zone" data-section="195" data-text="148">Contact Information</h2>
                    
                    <div class="contact-method editable-section no-drop-zone" data-section="196">
                        <div class="contact-icon">
                            <i class="fas fa-map-marker-alt editable-icon" data-icon="31" data-default-class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-details">
                            <h4 class="editable-text editable-section no-drop-zone" data-section="197" data-text="149">Visit Our Showroom</h4>
                            <p class="editable-text editable-section no-drop-zone" data-section="198" data-text="150">123 Luxury Avenue</p>
                            <p class="editable-text editable-section no-drop-zone" data-section="199" data-text="151">Design District, New York, NY 10001</p>
                        </div>
                    </div>
                    
                    <div class="contact-method editable-section no-drop-zone" data-section="200">
                        <div class="contact-icon">
                            <i class="fas fa-phone-alt editable-icon" data-icon="32" data-default-class="fas fa-phone-alt"></i>
                        </div>
                        <div class="contact-details">
                            <h4 class="editable-text editable-section no-drop-zone" data-section="201" data-text="152">Call Us</h4>
                            <p class="editable-text editable-section no-drop-zone" data-section="202" data-text="153">+1 (555) 123-4567</p>
                            <p class="contact-hours editable-text editable-section no-drop-zone" data-section="203" data-text="154">Mon-Fri: 9am-6pm | Sat: 10am-4pm</p>
                        </div>
                    </div>
                    
                    <div class="contact-method editable-section no-drop-zone" data-section="204">
                        <div class="contact-icon">
                            <i class="fas fa-envelope editable-icon" data-icon="33" data-default-class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-details">
                            <h4 class="editable-text editable-section no-drop-zone" data-section="205" data-text="155">Email Us</h4>
                            <p class="editable-text editable-section no-drop-zone" data-section="206" data-text="156">hello@elysianhome.com</p>
                            <p class="editable-text editable-section no-drop-zone" data-section="207" data-text="157">We typically respond within 24 hours</p>
                        </div>
                    </div>
                    
                    <div class="social-links editable-section no-drop-zone" data-section="208">
                        <a href="#" class="social-link editable-section no-drop-zone" data-section="209">
                            <i class="fab fa-instagram editable-icon" data-icon="34" data-default-class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="social-link editable-section no-drop-zone" data-section="210">
                            <i class="fab fa-pinterest editable-icon" data-icon="35" data-default-class="fab fa-pinterest"></i>
                        </a>
                        <a href="#" class="social-link editable-section no-drop-zone" data-section="211">
                            <i class="fab fa-facebook editable-icon" data-icon="36" data-default-class="fab fa-facebook"></i>
                        </a>
                        <a href="#" class="social-link editable-section no-drop-zone" data-section="212">
                            <i class="fab fa-youtube editable-icon" data-icon="37" data-default-class="fab fa-youtube"></i>
                        </a>
                    </div>
                </div>
                
                <!-- Contact Form -->
                <div class="contact-form editable-section no-drop-zone" data-section="213">
                    <h2 class="form-title editable-text editable-section no-drop-zone" data-section="214" data-text="158">Send Us a Message</h2>
                    <form id="contact-form">
                        <div class="form-group editable-section no-drop-zone" data-section="215">
                            <label for="name" class="editable-text editable-section no-drop-zone" data-section="216" data-text="159">Your Name</label>
                            <input type="text" id="name" class="form-input" placeholder="Enter your full name">
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="217">
                            <label for="email" class="editable-text editable-section no-drop-zone" data-section="218" data-text="160">Email Address</label>
                            <input type="email" id="email" class="form-input" placeholder="Enter your email address">
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="219">
                            <label for="subject" class="editable-text editable-section no-drop-zone" data-section="220" data-text="161">Subject</label>
                            <input type="text" id="subject" class="form-input" placeholder="What is this regarding?">
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="221">
                            <label for="message" class="editable-text editable-section no-drop-zone" data-section="222" data-text="162">Your Message</label>
                            <textarea id="message" class="form-textarea" placeholder="Tell us how we can help you..."></textarea>
                        </div>
                        
                        <button type="submit" class="submit-temp-btn editable-text editable-section no-drop-zone" data-section="223" data-text="163">
                            <i class="fas fa-paper-plane editable-icon" data-icon="38" data-default-class="fas fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section editable-section" data-section="224">
        <div class="container">
            <div class="section-header">
                <h2 class="editable-text editable-section no-drop-zone" data-section="225" data-text="164">Frequently Asked Questions</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="226" data-text="165">Find quick answers to common questions about our products and services</p>
            </div>
            
            <div class="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item editable-section no-drop-zone" data-section="227">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="228" data-text="166">What is your return policy for luxury home accessories?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down editable-icon" data-icon="39" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="229" data-text="167">
                        We offer a 30-day return policy for all unused items in their original packaging. For luxury items over $500, we provide a 60-day return window. All returns are processed within 5-7 business days after we receive the item. Please note that custom or personalized items are final sale.
                    </div>
                </div>
                
                <!-- FAQ 2 -->
                <div class="faq-item editable-section no-drop-zone" data-section="230">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="231" data-text="168">How do I care for and maintain my luxury home accessories?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down editable-icon" data-icon="39" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="232" data-text="169">
                        Each product comes with specific care instructions. For marble items, use only mild soap and water. Brass accents should be polished monthly with a soft cloth. Crystal pieces require gentle hand washing. We recommend using our specially formulated care kits available for purchase.
                    </div>
                </div>
                
                <!-- FAQ 3 -->
                <div class="faq-item editable-section no-drop-zone" data-section="233">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="234" data-text="170">Do you offer international shipping?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down editable-icon" data-icon="39" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="235" data-text="171">
                        Yes, we ship to over 50 countries worldwide. International shipping typically takes 7-14 business days. All customs duties and taxes are calculated at checkout for complete transparency. We recommend checking your country's import regulations before ordering.
                    </div>
                </div>
                
                <!-- FAQ 4 -->
                <div class="faq-item editable-section no-drop-zone" data-section="236">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="237" data-text="172">Can I visit your showroom to see products in person?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down editable-icon" data-icon="39" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="238" data-text="173">
                        Absolutely! Our flagship showroom in New York is open Monday through Saturday. We recommend booking an appointment for a personalized consultation, especially for larger purchases. Virtual showroom tours are also available by request.
                    </div>
                </div>
                
                <!-- FAQ 5 -->
                <div class="faq-item editable-section no-drop-zone" data-section="239">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="240" data-text="174">Do you offer custom or bespoke home accessories?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-chevron-down editable-icon" data-icon="39" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="241" data-text="175">
                        Yes, we have an in-house design team that works on custom projects. The process begins with a consultation to discuss your vision, materials, and timeline. Custom projects typically take 8-12 weeks from design approval to completion. A 50% deposit is required to begin production.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="map-section editable-section" data-section="242">
        <div class="container">
            <div class="section-header">
                <h2 class="editable-text editable-section no-drop-zone" data-section="243" data-text="176">Visit Our Showroom</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="244" data-text="177">Experience our luxury collections in person at our flagship location</p>
            </div>
            
            <div class="map-container editable-section no-drop-zone" data-section="245">
                <div class="map-placeholder">
                    <i class="fas fa-map-marked-alt editable-icon" data-icon="40" data-default-class="fas fa-map-marked-alt"></i>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="246" data-text="178">Elysian Flagship Showroom</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="247" data-text="179">123 Luxury Avenue, Design District</p>
                    <p class="editable-text editable-section no-drop-zone" data-section="248" data-text="180">New York, NY 10001</p>
                    <p class="editable-text editable-section no-drop-zone" data-section="249" data-text="181">Open Mon-Fri: 9am-6pm | Sat: 10am-4pm</p>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Contact form submission
        document.getElementById('contact-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const name = document.getElementById('name').value;
            const email = document.getElementById('email').value;
            const subject = document.getElementById('subject').value;
            const message = document.getElementById('message').value;
            
            if (!name || !email || !subject || !message) {
                alert('Please fill in all fields');
                return;
            }
            
            // In real implementation, this would send to server
            alert('Thank you for your message! We will get back to you within 24 hours.');
            this.reset();
        });
        
        // FAQ toggle functionality
        document.querySelectorAll('.faq-question').forEach(question => {
            question.addEventListener('click', function() {
                const faqItem = this.closest('.faq-item');
                
                // Close all other FAQ items
                document.querySelectorAll('.faq-item').forEach(item => {
                    if (item !== faqItem) {
                        item.classList.remove('active');
                    }
                });
                
                // Toggle current FAQ item
                faqItem.classList.toggle('active');
            });
        });
        
        // Social link clicks
        document.querySelectorAll('.social-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const platform = this.querySelector('i').className.split(' ')[1];
                alert(`Following us on ${platform.replace('fa-', '')}`);
            });
        });
        
        // Contact method clicks
        document.querySelectorAll('.contact-method').forEach(method => {
            method.addEventListener('click', function() {
                const title = this.querySelector('h4').textContent;
                
                if (title.includes('Call')) {
                    alert('Calling our customer service team...');
                } else if (title.includes('Email')) {
                    alert('Opening email client...');
                } else if (title.includes('Visit')) {
                    alert('Opening directions to our showroom...');
                }
            });
        });
        
        // Initialize first FAQ as open
        document.querySelector('.faq-item').classList.add('active');
    </script>
</body>
</html>