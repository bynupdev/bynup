<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shopping Cart | PŌTA Luxury Pet Essentials</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

main {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
    /* padding-top: 100px; */
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Page Header */
.page-header {
    text-align: center;
    padding: var(--spacing-lg) 0 var(--spacing-md);
    margin-bottom: var(--spacing-md);
}

h1.cart-title {
    font-size: 3rem;
    color: var(--espresso-dark);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
}

h1.cart-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
}

/* Cart Content Layout */
.cart-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
}

/* Cart Items Section */
.cart-items {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    box-shadow: 0 6px 12px var(--shadow-soft);
    padding: var(--spacing-md);
}

.cart-items-header {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr 0.5fr;
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
    font-weight: 600;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-md);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.cart-item {
    display: grid;
    grid-template-columns: 3fr 1fr 1fr 0.5fr;
    align-items: center;
    padding: var(--spacing-sm) 0;
    border-bottom: 1px solid rgba(102, 47, 23, 0.05);
    transition: var(--transition);
}

.cart-item:hover {
    background: rgba(227, 194, 163, 0.05);
}

/* Product Info in Cart */
.cart-product-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
}

.cart-product-image {
    width: 80px;
    height: 80px;
    border-radius: calc(var(--border-radius) - 2px);
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    background-color: var(--cream-warm);
}

.cart-product-details {
    flex: 1;
}

.cart-product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
}

.cart-product-category {
    color: var(--terracotta);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.3rem;
}

.cart-product-variant {
    font-size: 0.7rem;
    color: var(--sienna-deep);
}

/* Quantity Controls */
.quantity-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.quantity-btn {
    width: 32px;
    height: 32px;
    background: var(--white-pure);
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
    font-size: 1rem;
    color: var(--espresso-dark);
}

.quantity-btn:hover {
    background: var(--bg-light);
    border-color: var(--terracotta);
    color: var(--terracotta);
}

.quantity-input {
    width: 50px;
    height: 32px;
    text-align: center;
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: 2rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    background: var(--white-pure);
}

.quantity-input:focus {
    outline: none;
    border-color: var(--terracotta);
}

/* Price Display */
.cart-product-price {
    font-size: 0.95rem;
    color: var(--terracotta);
    font-weight: 500;
}

.item-total {
    font-weight: 600;
    color: var(--espresso-dark);
    font-size: 0.95rem;
}

/* Remove Button */
.remove-btn {
    background: none;
    border: none;
    color: rgba(102, 47, 23, 0.4);
    cursor: pointer;
    font-size: 0.9rem;
    transition: var(--transition);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
}

.remove-btn:hover {
    color: var(--terracotta);
    background: rgba(209, 134, 80, 0.1);
}

/* Cart Summary */
.cart-summary {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    box-shadow: 0 6px 12px var(--shadow-soft);
    padding: var(--spacing-md);
    height: fit-content;
    position: sticky;
    top: 120px;
}

.cart-summary h2 {
    font-size: 1.3rem;
    margin-bottom: var(--spacing-md);
    color: var(--espresso-dark);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8rem;
    color: var(--sienna-deep);
    font-size: 0.9rem;
}

.summary-row.total {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--terracotta);
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-sm);
    border-top: 1px solid rgba(102, 47, 23, 0.1);
}

/* Promo Code */
.promo-code {
    margin: var(--spacing-md) 0;
}

.promo-code h3 {
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
    color: var(--espresso-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.promo-input-group {
    display: flex;
    gap: 0.5rem;
}

.promo-input {
    flex: 1;
    padding: 0.7rem 1rem;
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: 2rem;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    background: var(--white-pure);
}

.promo-input:focus {
    outline: none;
    border-color: var(--terracotta);
}

.apply-promo-btn {
    background: var(--espresso-dark);
    color: var(--white-pure);
    border: none;
    padding: 0.7rem 1.2rem;
    border-radius: 2rem;
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.8rem;
    font-weight: 500;
    font-family: 'Montserrat', sans-serif;
}

.apply-promo-btn:hover {
    background: var(--terracotta);
    transform: translateY(-2px);
}

/* Checkout Button */
.checkout-btn {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, var(--terracotta), var(--sienna-deep));
    color: var(--white-pure);
    padding: 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 1px;
    border-radius: 3rem;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    margin-top: var(--spacing-md);
    text-align: center;
    font-family: 'Montserrat', sans-serif;
}

.checkout-btn:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 47, 23, 0.2);
}

/* Continue Shopping */
.continue-shopping {
    text-align: center;
    margin-top: var(--spacing-sm);
}

.continue-shopping a {
    color: var(--terracotta);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.continue-shopping a:hover {
    color: var(--espresso-dark);
}

/* Empty Cart State */
.empty-cart {
    text-align: center;
    padding: var(--spacing-xl) var(--spacing-md);
    background: var(--white-pure);
    border-radius: var(--border-radius);
    box-shadow: 0 6px 12px var(--shadow-soft);
}

.empty-cart-icon {
    font-size: 4rem;
    color: var(--terracotta-light);
    margin-bottom: var(--spacing-md);
}

.empty-cart h2 {
    font-size: 1.6rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
}

.empty-cart p {
    color: var(--sienna-deep);
    margin-bottom: var(--spacing-md);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    font-size: 0.9rem;
}

.shop-now-btn {
    display: inline-block;
    background: var(--terracotta);
    color: var(--white-pure);
    padding: 0.8rem 2rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 3rem;
    transition: var(--transition);
    font-family: 'Montserrat', sans-serif;
}

.shop-now-btn:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
}

/* You May Also Like Section */
.you-may-also-like {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid rgba(102, 47, 23, 0.1);
}

.you-may-also-like h2 {
    font-size: 1.8rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.recommended-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: var(--spacing-lg);
}

.recommended-product-card {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: 0 5px 15px var(--shadow-soft);
    cursor: pointer;
}

.recommended-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px var(--shadow-hover);
}

.recommended-product-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
    background-color: var(--cream-warm);
}

.recommended-product-card:hover .recommended-product-img {
    transform: scale(1.02);
}

.recommended-product-info {
    padding: 1rem;
    text-align: center;
}

.recommended-product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
}

.recommended-product-price {
    color: var(--terracotta);
    font-weight: 500;
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
}

.add-to-cart-small {
    width: 100%;
    background: var(--bg-light);
    color: var(--terracotta);
    padding: 0.5rem;
    font-size: 0.7rem;
    font-weight: 500;
    border-radius: 2rem;
    border: 1px solid var(--terracotta);
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    font-family: 'Montserrat', sans-serif;
}

.add-to-cart-small:hover {
    background: var(--terracotta);
    color: var(--white-pure);
}

/* Responsive Styles */
@media (max-width: 992px) {
    .cart-content {
        grid-template-columns: 1fr;
    }
    .cart-summary {
        position: static;
        order: -1;
    }
    .recommended-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    main {
        padding-top: 80px;
    }
    .cart-items-header {
        display: none;
    }
    .cart-item {
        grid-template-columns: 1fr;
        gap: var(--spacing-sm);
        padding: var(--spacing-md) 0;
        position: relative;
    }
    .cart-product-price {
        position: absolute;
        top: var(--spacing-md);
        right: 0;
    }
    .item-total {
        position: absolute;
        bottom: var(--spacing-md);
        right: 0;
    }
    .remove-btn {
        position: absolute;
        top: var(--spacing-md);
        right: 40px;
    }
    .quantity-controls {
        justify-content: flex-start;
        margin-top: 0.5rem;
    }
    .cart-product-image {
        width: 70px;
        height: 70px;
    }
    .recommended-grid {
        grid-template-columns: 1fr;
        max-width: 280px;
        margin-left: auto;
        margin-right: auto;
    }
    h1.cart-title {
        font-size: 2rem;
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 1.2rem;
    }
    .promo-input-group {
        flex-direction: column;
    }
    .apply-promo-btn {
        width: 100%;
    }
}
</style>
</head>
<body>

<main>
    <!-- Page Header -->
<div class="page-header editable-section" data-section="279">
    <div class="container">
        <h1 class="cart-title editable-text editable-section no-drop-zone" data-section="280" data-text="400">Shopping Cart</h1>
    </div>
</div>

<!-- Cart Content -->
<div class="container">
    <div class="cart-content" id="cartContent">
        <!-- Cart Items -->
        <div class="cart-items" id="cartItems">
            <div class="cart-items-header">
                <div class="editable-text editable-section no-drop-zone" data-section="281" data-text="401">Product</div>
                <div class="editable-text editable-section no-drop-zone" data-section="282" data-text="402">Price</div>
                <div class="editable-text editable-section no-drop-zone" data-section="283" data-text="403">Quantity</div>
                <div class="editable-text editable-section no-drop-zone" data-section="284" data-text="404">Total</div>
            </div>
            
            <!-- Cart Item 1 (Editable - First in list) -->
            <div class="cart-item editable-section no-drop-zone" data-section="285" data-product-id="1">
                <div class="cart-product-info">
                    <div class="cart-product-image editable-image" data-image="350" style="background-image: url('https://images.pexels.com/photos/5915865/pexels-photo-5915865.jpeg?auto=compress&cs=tinysrgb&w=200&h=200&fit=crop')"></div>
                    <div class="cart-product-details">
                        <div class="cart-product-name editable-text editable-section no-drop-zone" data-section="286" data-text="405">Cashmere Cloud Bed</div>
                        <div class="cart-product-category editable-text editable-section no-drop-zone" data-section="287" data-text="406">BEDS</div>
                        <div class="cart-product-variant editable-text editable-section no-drop-zone" data-section="288" data-text="407">Color: Sand | Size: Medium</div>
                    </div>
                </div>
                <div class="cart-product-price editable-text editable-section no-drop-zone" data-section="289" data-text="408">$189</div>
                <div class="quantity-controls">
                    <button class="quantity-btn decrement">-</button>
                    <input type="number" class="quantity-input" value="1" min="1" max="10">
                    <button class="quantity-btn increment">+</button>
                </div>
                <div class="item-total">$189</div>
                <button class="remove-btn"><i class="fas fa-times editable-icon" data-icon="350" data-default-class="fas fa-times"></i></button>
            </div>
            
            <!-- Cart Item 2 (Non-editable sample) -->
            <div class="cart-item" data-product-id="2">
                <div class="cart-product-info">
                    <div class="cart-product-image" style="background-image: url('https://images.pexels.com/photos/5794844/pexels-photo-5794844.jpeg?auto=compress&cs=tinysrgb&w=200&h=200&fit=crop')"></div>
                    <div class="cart-product-details">
                        <div class="cart-product-name">Herbal Grooming Set</div>
                        <div class="cart-product-category">GROOMING</div>
                        <div class="cart-product-variant">Color: Natural | Size: Standard</div>
                    </div>
                </div>
                <div class="cart-product-price">$96</div>
                <div class="quantity-controls">
                    <button class="quantity-btn decrement">-</button>
                    <input type="number" class="quantity-input" value="2" min="1" max="10">
                    <button class="quantity-btn increment">+</button>
                </div>
                <div class="item-total">$192</div>
                <button class="remove-btn"><i class="fas fa-times"></i></button>
            </div>
        </div>
        
        <!-- Cart Summary -->
        <div class="cart-summary">
            <h2 class="editable-text editable-section no-drop-zone" data-section="290" data-text="409">Order Summary</h2>
            <div class="summary-row">
                <span class="editable-text editable-section no-drop-zone" data-section="291" data-text="410">Subtotal</span>
                <span id="cartSubtotal">$381</span>
            </div>
            <div class="summary-row">
                <span class="editable-text editable-section no-drop-zone" data-section="292" data-text="411">Shipping</span>
                <span id="cartShipping">$5.00</span>
            </div>
            <div class="summary-row">
                <span class="editable-text editable-section no-drop-zone" data-section="293" data-text="412">Tax</span>
                <span id="cartTax">$30.48</span>
            </div>
            <div class="summary-row total">
                <span class="editable-text editable-section no-drop-zone" data-section="294" data-text="413">Total</span>
                <span id="cartTotal">$416.48</span>
            </div>
            
            <div class="promo-code">
                <h3 class="editable-text editable-section no-drop-zone" data-section="295" data-text="414">Promo Code</h3>
                <div class="promo-input-group">
                    <input type="text" class="promo-input" placeholder="Enter code" id="promoCodeInput">
                    <button class="apply-promo-btn editable-text editable-section no-drop-zone" data-section="296" data-text="415">Apply</button>
                </div>
            </div>
            
            <button class="checkout-btn editable-text editable-section no-drop-zone" data-section="297" data-text="416">
                <i class="fas fa-lock editable-icon" data-icon="351" data-default-class="fas fa-lock"></i> Proceed to Checkout
            </button>
            
            <div class="continue-shopping">
                <a href="?page=products" class="editable-text editable-section no-drop-zone" data-section="298" data-text="417">
                    <i class="fas fa-arrow-left editable-icon" data-icon="352" data-default-class="fas fa-arrow-left"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
    
    <!-- You May Also Like Section -->
    <div class="you-may-also-like editable-section" data-section="299">
        <h2 class="editable-text editable-section no-drop-zone" data-section="300" data-text="418">You May Also Like</h2>
        <div class="recommended-grid">
            <!-- Recommended Product 1 (Editable - First in list) -->
            <div class="recommended-product-card">
                <img src="https://images.pexels.com/photos/6853401/pexels-photo-6853401.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" alt="Pet Bowl" class="recommended-product-img editable-image" data-image="353">
                <div class="recommended-product-info">
                    <div class="recommended-product-name editable-section no-drop-zone" data-section="301" data-text="419">Oak & Stone Feeding Set</div>
                    <div class="recommended-product-price editable-section no-drop-zone" data-section="302" data-text="420">$74</div>
                    <button class="add-to-cart-small editable-section no-drop-zone" data-section="306"><i class="fas fa-shopping-bag editable-icon" data-icon="353" data-default-class="fas fa-shopping-bag"></i> Add to Cart</button>
                </div>
            </div>
            <!-- Recommended Product 2 (Non-editable) -->
            <div class="recommended-product-card">
                <img src="https://images.pexels.com/photos/8263769/pexels-photo-8263769.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" alt="Pet Toy" class="recommended-product-img">
                <div class="recommended-product-info">
                    <div class="recommended-product-name">Artisan Silk Rope Toy</div>
                    <div class="recommended-product-price">$42</div>
                    <button class="add-to-cart-small"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                </div>
            </div>
            <!-- Recommended Product 3 (Non-editable) -->
            <div class="recommended-product-card">
                <img src="https://images.pexels.com/photos/6373812/pexels-photo-6373812.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" alt="Leash" class="recommended-product-img">
                <div class="recommended-product-info">
                    <div class="recommended-product-name">Italian Leather Leash</div>
                    <div class="recommended-product-price">$128</div>
                    <button class="add-to-cart-small"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                </div>
            </div>
            <!-- Recommended Product 4 (Non-editable) -->
            <div class="recommended-product-card">
                <img src="https://images.pexels.com/photos/6909808/pexels-photo-6909808.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" alt="Collar" class="recommended-product-img">
                <div class="recommended-product-info">
                    <div class="recommended-product-name">Handcrafted Leather Collar</div>
                    <div class="recommended-product-price">$85</div>
                    <button class="add-to-cart-small"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                </div>
            </div>
        </div>
    </div>
</div>
</main>

<script>
// Cart Item Management
document.addEventListener('DOMContentLoaded', function() {
    updateCartTotals();
    
    // Quantity increment/decrement
    document.querySelectorAll('.quantity-btn.increment').forEach(btn => {
        btn.addEventListener('click', function() {
            const cartItem = this.closest('.cart-item');
            const input = cartItem.querySelector('.quantity-input');
            let value = parseInt(input.value);
            if (value < 10) {
                input.value = value + 1;
                updateItemTotal(cartItem);
                updateCartTotals();
            }
        });
    });
    
    document.querySelectorAll('.quantity-btn.decrement').forEach(btn => {
        btn.addEventListener('click', function() {
            const cartItem = this.closest('.cart-item');
            const input = cartItem.querySelector('.quantity-input');
            let value = parseInt(input.value);
            if (value > 1) {
                input.value = value - 1;
                updateItemTotal(cartItem);
                updateCartTotals();
            }
        });
    });
    
    // Manual quantity input
    document.querySelectorAll('.quantity-input').forEach(input => {
        input.addEventListener('change', function() {
            let value = parseInt(this.value);
            if (isNaN(value) || value < 1) value = 1;
            if (value > 10) value = 10;
            this.value = value;
            const cartItem = this.closest('.cart-item');
            updateItemTotal(cartItem);
            updateCartTotals();
        });
    });
    
    // Remove item
    document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const cartItem = this.closest('.cart-item');
            cartItem.remove();
            updateCartTotals();
            checkEmptyCart();
        });
    });
    
    // Apply promo code
    const applyPromoBtn = document.querySelector('.apply-promo-btn');
    if (applyPromoBtn) {
        applyPromoBtn.addEventListener('click', applyPromoCode);
    }
    
    // Proceed to checkout
    const checkoutBtn = document.querySelector('.checkout-btn');
    if (checkoutBtn) {
        checkoutBtn.addEventListener('click', proceedToCheckout);
    }
    
    // Add to cart from recommended section
    document.querySelectorAll('.add-to-cart-small').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            const productCard = this.closest('.recommended-product-card');
            const productName = productCard.querySelector('.recommended-product-name').textContent;
            alert(`${productName} added to cart!`);
        });
    });
    
    // Recommended product click
    document.querySelectorAll('.recommended-product-card').forEach(card => {
        card.addEventListener('click', function(e) {
            if (e.target.classList.contains('add-to-cart-small') || e.target.closest('.add-to-cart-small')) return;
            const productName = this.querySelector('.recommended-product-name').textContent;
            alert(`Viewing ${productName}`);
        });
    });
});

function updateItemTotal(cartItem) {
    const priceText = cartItem.querySelector('.cart-product-price').textContent;
    const price = parseFloat(priceText.replace('$', ''));
    const quantity = parseInt(cartItem.querySelector('.quantity-input').value);
    const total = price * quantity;
    cartItem.querySelector('.item-total').textContent = `$${total.toFixed(2)}`;
}

function updateCartTotals() {
    let subtotal = 0;
    document.querySelectorAll('.cart-item').forEach(item => {
        const totalText = item.querySelector('.item-total').textContent;
        const total = parseFloat(totalText.replace('$', ''));
        subtotal += total;
    });
    
    const shipping = subtotal > 0 ? 5.00 : 0;
    const tax = subtotal * 0.08;
    const total = subtotal + shipping + tax;
    
    document.getElementById('cartSubtotal').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('cartShipping').textContent = shipping === 0 ? 'FREE' : `$${shipping.toFixed(2)}`;
    document.getElementById('cartTax').textContent = `$${tax.toFixed(2)}`;
    document.getElementById('cartTotal').textContent = `$${total.toFixed(2)}`;
}

let promoApplied = false;
let discountAmount = 0;

function applyPromoCode() {
    const promoInput = document.querySelector('.promo-input');
    const promoCode = promoInput.value.trim().toUpperCase();
    
    const validPromos = {
        'WELCOME10': 0.10,
        'POTA20': 0.20,
        'FREESHIP': 'free'
    };
    
    if (promoApplied) {
        alert('Promo code already applied!');
        return;
    }
    
    if (validPromos[promoCode]) {
        const discount = validPromos[promoCode];
        const subtotalText = document.getElementById('cartSubtotal').textContent;
        const subtotal = parseFloat(subtotalText.replace('$', ''));
        
        if (discount === 'free') {
            document.getElementById('cartShipping').textContent = 'FREE';
            discountAmount = 0;
            alert('Free shipping applied!');
        } else {
            discountAmount = subtotal * discount;
            alert(`${promoCode} applied! ${discount * 100}% discount added.`);
        }
        
        promoApplied = true;
        updateTotalsWithDiscount();
        promoInput.disabled = true;
        document.querySelector('.apply-promo-btn').disabled = true;
        document.querySelector('.apply-promo-btn').style.opacity = '0.5';
    } else {
        alert('Invalid promo code. Try: WELCOME10, POTA20, or FREESHIP');
    }
}

function updateTotalsWithDiscount() {
    const subtotalText = document.getElementById('cartSubtotal').textContent;
    let subtotal = parseFloat(subtotalText.replace('$', ''));
    subtotal = subtotal - discountAmount;
    
    const shippingText = document.getElementById('cartShipping').textContent;
    const shipping = shippingText === 'FREE' ? 0 : parseFloat(shippingText.replace('$', ''));
    const tax = subtotal * 0.08;
    const total = subtotal + shipping + tax;
    
    document.getElementById('cartSubtotal').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('cartTax').textContent = `$${tax.toFixed(2)}`;
    document.getElementById('cartTotal').textContent = `$${total.toFixed(2)}`;
}

function proceedToCheckout() {
    const cartItems = document.querySelectorAll('.cart-item');
    if (cartItems.length === 0) {
        alert('Your cart is empty. Please add items before checkout.');
        return;
    }
    alert('Proceeding to checkout...');
}

function checkEmptyCart() {
    const cartItems = document.querySelectorAll('.cart-item');
    const cartContent = document.querySelector('.cart-content');
    const emptyCartState = document.querySelector('.empty-cart');
    
    if (cartItems.length === 0 && !emptyCartState) {
        const emptyHtml = `
            <div class="empty-cart">
                <div class="empty-cart-icon">
                    <i class="fas fa-shopping-bag editable-icon" data-icon="354" data-default-class="fas fa-shopping-bag"></i>
                </div>
                <h2 class="editable-text editable-section no-drop-zone" data-section="303" data-text="421">Your Cart is Empty</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="304" data-text="422">Looks like you haven't added any items to your cart yet. Explore our collection to find the perfect pieces for your pet.</p>
                <a href="?page=products" class="shop-now-btn editable-text editable-section no-drop-zone" data-section="305" data-text="423">Start Shopping</a>
            </div>
        `;
        const container = document.querySelector('.container');
        const existingCartContent = document.querySelector('.cart-content');
        if (existingCartContent) existingCartContent.remove();
        container.insertAdjacentHTML('afterbegin', emptyHtml);
    }
}
</script>
</body>
</html>