<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact Us | PŌTA Luxury Pet Essentials</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

main {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
    padding-top: 100px;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Page Header */
.page-header {
    text-align: center;
    padding: var(--spacing-lg) 0 var(--spacing-md);
    margin-bottom: var(--spacing-md);
}

h1.contact-title {
    font-size: 3rem;
    color: var(--espresso-dark);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
}

h1.contact-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
}

p.contact-subtitle {
    color: var(--sienna-deep);
    font-size: 1rem;
    max-width: 700px;
    margin: 1rem auto 0;
    opacity: 0.8;
}

/* Contact Layout */
.contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
}

/* Contact Information */
.contact-info {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    box-shadow: 0 6px 12px var(--shadow-soft);
    height: fit-content;
}

.contact-info h2 {
    font-size: 1.5rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.contact-method {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
}

.contact-icon {
    width: 48px;
    height: 48px;
    background: rgba(209, 134, 80, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--terracotta);
    font-size: 1.2rem;
    flex-shrink: 0;
}

.contact-details h3 {
    font-size: 1rem;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
    font-weight: 600;
}

.contact-details p {
    color: var(--sienna-deep);
    font-size: 0.85rem;
    line-height: 1.5;
}

.contact-details a {
    color: var(--terracotta);
    text-decoration: none;
    transition: var(--transition);
}

.contact-details a:hover {
    text-decoration: underline;
}

/* Business Hours - FULLY EDITABLE */
.business-hours {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(102, 47, 23, 0.1);
}

.business-hours h3 {
    font-size: 1rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
}

.hours-list {
    list-style: none;
}

.hours-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(102, 47, 23, 0.05);
    font-size: 0.85rem;
}

.hours-list li:last-child {
    border-bottom: none;
}

.day {
    color: var(--espresso-dark);
    font-weight: 500;
}

.time {
    color: var(--sienna-deep);
}

/* Contact Form */
.contact-form-section {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    box-shadow: 0 6px 12px var(--shadow-soft);
}

.contact-form-section h2 {
    font-size: 1.5rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
}

.form-group {
    margin-bottom: var(--spacing-sm);
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--espresso-dark);
    font-weight: 500;
    font-size: 0.85rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: var(--border-radius);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    transition: var(--transition);
    background: var(--white-pure);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--terracotta);
    box-shadow: 0 0 0 3px rgba(209, 134, 80, 0.1);
}

.form-group textarea {
    min-height: 120px;
    resize: vertical;
}

.submit-btn {
    background: linear-gradient(135deg, var(--terracotta), var(--sienna-deep));
    color: var(--white-pure);
    padding: 0.9rem 2rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 1px;
    border-radius: 3rem;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    margin-top: var(--spacing-sm);
    width: auto;
    align-self: flex-start;
    font-family: 'Montserrat', sans-serif;
}

.submit-btn:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
}

/* Shop Locations Section - FULLY EDITABLE */
.shop-locations {
    margin-bottom: var(--spacing-xl);
}

.shop-locations h2 {
    font-size: 1.8rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.locations-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
}

.location-card {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: 0 6px 12px var(--shadow-soft);
}

.location-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px var(--shadow-hover);
}

.location-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
    background-color: var(--cream-warm);
}

.location-card:hover .location-image {
    transform: scale(1.02);
}

.location-info {
    padding: 1.2rem;
    text-align: left;
}

.location-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--espresso-dark);
    margin-bottom: 0.5rem;
}

.location-address {
    color: var(--sienna-deep);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
}

.location-phone {
    color: var(--terracotta);
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
}

.location-hours {
    color: var(--sienna-deep);
    font-size: 0.75rem;
    font-style: italic;
}

/* FAQ Section - FULLY EDITABLE */
.faq-section {
    margin-bottom: var(--spacing-xl);
}

.faq-section h2 {
    font-size: 1.8rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.faq-container {
    max-width: 900px;
    margin: 0 auto;
}

.faq-item {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    margin-bottom: var(--spacing-sm);
    box-shadow: 0 4px 12px var(--shadow-soft);
    overflow: hidden;
    transition: var(--transition);
}

.faq-item:hover {
    box-shadow: 0 8px 20px var(--shadow-hover);
}

.faq-question {
    padding: 1.2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    background: var(--white-pure);
    border: none;
    width: 100%;
    text-align: left;
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--espresso-dark);
    transition: var(--transition);
}

.faq-question:hover {
    background: rgba(227, 194, 163, 0.1);
}

.faq-question.active {
    color: var(--terracotta);
}

.faq-icon {
    color: var(--terracotta);
    font-size: 1rem;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: var(--spacing-sm);
}

.faq-question.active .faq-icon {
    transform: rotate(45deg);
}

.faq-answer {
    padding: 0 1.5rem;
    max-height: 0;
    overflow: hidden;
    transition: all 0.3s ease;
    color: var(--sienna-deep);
    line-height: 1.7;
    font-size: 0.9rem;
}

.faq-answer.active {
    padding: 0 1.5rem 1.2rem;
    max-height: 500px;
}

.faq-question span {
    /* For editable question text */
}

.faq-answer {
    /* For editable answer text */
}

/* Additional Support - FULLY EDITABLE */
.additional-support {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-lg);
    box-shadow: 0 6px 12px var(--shadow-soft);
    margin-bottom: var(--spacing-xl);
}

.additional-support h2 {
    font-size: 1.5rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.support-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
}

.support-item {
    text-align: center;
    padding: var(--spacing-md);
}

.support-icon {
    font-size: 2rem;
    color: var(--terracotta);
    margin-bottom: var(--spacing-sm);
}

.support-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    color: var(--espresso-dark);
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.support-description {
    color: var(--sienna-deep);
    font-size: 0.85rem;
    line-height: 1.5;
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .locations-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 992px) {
    .contact-layout {
        grid-template-columns: 1fr;
    }
    .support-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .locations-grid {
        gap: 1.5rem;
    }
}

@media (max-width: 768px) {
    main {
        padding-top: 80px;
    }
    .form-row {
        grid-template-columns: 1fr;
    }
    .support-grid {
        grid-template-columns: 1fr;
        max-width: 320px;
        margin: 0 auto;
    }
    .locations-grid {
        grid-template-columns: 1fr;
        max-width: 320px;
        margin-left: auto;
        margin-right: auto;
    }
    .submit-btn {
        width: 100%;
    }
    h1.contact-title {
        font-size: 2rem;
    }
    .faq-question {
        font-size: 0.9rem;
        padding: 1rem;
    }
    .contact-method {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.8rem;
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 1.2rem;
    }
    .contact-info,
    .contact-form-section {
        padding: var(--spacing-sm);
    }
}
</style>
</head>
<body>

<main>
    <!-- Page Header -->
<div class="page-header editable-section" data-section="372">
    <div class="container">
        <h1 class="contact-title editable-text editable-section no-drop-zone" data-section="373" data-text="700">Contact Us</h1>
        <p class="contact-subtitle editable-text editable-section no-drop-zone" data-section="374" data-text="701">We'd love to hear from you. Reach out with any questions about our products, orders, or custom requests.</p>
    </div>
</div>

<!-- Contact Layout -->
<div class="container">
    <div class="contact-layout">
        <!-- Contact Information -->
        <div class="contact-info editable-section no-drop-zone" data-section="375">
            <h2 class="editable-text editable-section no-drop-zone" data-section="376" data-text="702">Get In Touch</h2>
            <div class="contact-methods">
                <div class="contact-method">
                    <div class="contact-icon">
                        <i class="fas fa-map-marker-alt editable-icon" data-icon="600" data-default-class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="contact-details">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="377" data-text="703">Visit Our Boutique</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="378" data-text="704">123 Luxury Avenue<br>New York, NY 10001<br>United States</p>
                    </div>
                </div>
                <div class="contact-method">
                    <div class="contact-icon">
                        <i class="fas fa-phone editable-icon" data-icon="601" data-default-class="fas fa-phone"></i>
                    </div>
                    <div class="contact-details">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="379" data-text="705">Call Us</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="380" data-text="706"><a href="tel:+15551234567">+1 (555) 123-4567</a><br>Monday - Friday: 9AM - 6PM EST<br>Saturday: 10AM - 4PM EST</p>
                    </div>
                </div>
                <div class="contact-method">
                    <div class="contact-icon">
                        <i class="fas fa-envelope editable-icon" data-icon="602" data-default-class="fas fa-envelope"></i>
                    </div>
                    <div class="contact-details">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="381" data-text="707">Email Us</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="382" data-text="708"><a href="mailto:hello@pota.com">hello@pota.com</a><br>General Inquiries<br><a href="mailto:support@pota.com">support@pota.com</a><br>Customer Support</p>
                    </div>
                </div>
            </div>
            <!-- Business Hours - FULLY EDITABLE -->
            <div class="business-hours">
                <h3 class="editable-text editable-section no-drop-zone" data-section="383" data-text="709">Business Hours</h3>
                <ul class="hours-list">
                    <li>
                        <span class="day editable-text editable-section no-drop-zone" data-section="384" data-text="710">Monday - Friday</span>
                        <span class="time editable-text editable-section no-drop-zone" data-section="385" data-text="711">9:00 AM - 6:00 PM</span>
                    </li>
                    <li>
                        <span class="day editable-text editable-section no-drop-zone" data-section="386" data-text="712">Saturday</span>
                        <span class="time editable-text editable-section no-drop-zone" data-section="387" data-text="713">10:00 AM - 4:00 PM</span>
                    </li>
                    <li>
                        <span class="day editable-text editable-section no-drop-zone" data-section="388" data-text="714">Sunday</span>
                        <span class="time editable-text editable-section no-drop-zone" data-section="389" data-text="715">Closed</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form-section editable-section no-drop-zone" data-section="390">
            <h2 class="editable-text editable-section no-drop-zone" data-section="391" data-text="716">Send Us a Message</h2>
            <form class="contact-form" id="contactForm">
                <div class="form-row">
                    <div class="form-group">
                        <label class="editable-text editable-section no-drop-zone" data-section="392" data-text="717">First Name *</label>
                        <input type="text" id="firstName" name="firstName" required>
                    </div>
                    <div class="form-group">
                        <label class="editable-text editable-section no-drop-zone" data-section="393" data-text="718">Last Name *</label>
                        <input type="text" id="lastName" name="lastName" required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="394" data-text="719">Email Address *</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="395" data-text="720">Phone Number</label>
                    <input type="tel" id="phone" name="phone">
                </div>
                <div class="form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="396" data-text="721">Subject *</label>
                    <select id="subject" name="subject" required>
                        <option value="" data-text="722">Select a subject</option>
                        <option value="general" data-text="723">General Inquiry</option>
                        <option value="order" data-text="724">Order Status</option>
                        <option value="custom" data-text="725">Custom Design Request</option>
                        <option value="repair" data-text="726">Product Care & Repair</option>
                        <option value="wholesale" data-text="727">Wholesale Inquiry</option>
                        <option value="other" data-text="728">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="397" data-text="729">Your Message *</label>
                    <textarea id="message" name="message" rows="4" required></textarea>
                </div>
                <button type="submit" class="submit-btn editable-text editable-section no-drop-zone" data-section="398" data-text="730">Send Message</button>
            </form>
        </div>
    </div>
</div>

<!-- Shop Locations Section (4 Editable Locations) -->
<div class="container">
    <div class="shop-locations editable-section" data-section="399">
        <h2 class="editable-text editable-section no-drop-zone" data-section="400" data-text="731">Our Boutique Locations</h2>
        <div class="locations-grid">
            <!-- Location 1 (Editable) -->
            <div class="location-card editable-section no-drop-zone" data-section="401">
                <img src="https://images.pexels.com/photos/1484852/pexels-photo-1484852.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="New York Boutique" class="location-image editable-image" data-image="600">
                <div class="location-info">
                    <div class="location-name editable-text editable-section no-drop-zone" data-section="402" data-text="732">New York - Fifth Avenue</div>
                    <div class="location-address editable-text editable-section no-drop-zone" data-section="403" data-text="733">123 Fifth Avenue, New York, NY 10001</div>
                    <div class="location-phone editable-text editable-section no-drop-zone" data-section="404" data-text="734">+1 (212) 555-0123</div>
                    <div class="location-hours editable-text editable-section no-drop-zone" data-section="405" data-text="735">Mon-Sat: 10AM-7PM | Sun: 12PM-5PM</div>
                </div>
            </div>
            <!-- Location 2 (Editable) -->
            <div class="location-card editable-section no-drop-zone" data-section="406">
                <img src="https://images.pexels.com/photos/1251202/pexels-photo-1251202.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Los Angeles Boutique" class="location-image editable-image" data-image="601">
                <div class="location-info">
                    <div class="location-name editable-text editable-section no-drop-zone" data-section="407" data-text="736">Los Angeles - Beverly Hills</div>
                    <div class="location-address editable-text editable-section no-drop-zone" data-section="408" data-text="737">456 Rodeo Drive, Beverly Hills, CA 90210</div>
                    <div class="location-phone editable-text editable-section no-drop-zone" data-section="409" data-text="738">+1 (310) 555-0456</div>
                    <div class="location-hours editable-text editable-section no-drop-zone" data-section="410" data-text="739">Mon-Sat: 10AM-8PM | Sun: 11AM-6PM</div>
                </div>
            </div>
            <!-- Location 3 (Editable) -->
            <div class="location-card editable-section no-drop-zone" data-section="411">
                <img src="https://images.pexels.com/photos/1080696/pexels-photo-1080696.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="London Boutique" class="location-image editable-image" data-image="602">
                <div class="location-info">
                    <div class="location-name editable-text editable-section no-drop-zone" data-section="412" data-text="740">London - Mayfair</div>
                    <div class="location-address editable-text editable-section no-drop-zone" data-section="413" data-text="741">78-80 Regent Street, Mayfair, London W1B 5RS</div>
                    <div class="location-phone editable-text editable-section no-drop-zone" data-section="414" data-text="742">+44 20 7123 4567</div>
                    <div class="location-hours editable-text editable-section no-drop-zone" data-section="415" data-text="743">Mon-Sat: 10AM-6PM | Sun: 12PM-5PM</div>
                </div>
            </div>
            <!-- Location 4 (Editable) -->
            <div class="location-card editable-section no-drop-zone" data-section="416">
                <img src="https://images.pexels.com/photos/1449773/pexels-photo-1449773.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Tokyo Boutique" class="location-image editable-image" data-image="603">
                <div class="location-info">
                    <div class="location-name editable-text editable-section no-drop-zone" data-section="417" data-text="744">Tokyo - Ginza</div>
                    <div class="location-address editable-text editable-section no-drop-zone" data-section="418" data-text="745">6-9-5 Ginza, Chuo City, Tokyo 104-0061</div>
                    <div class="location-phone editable-text editable-section no-drop-zone" data-section="419" data-text="746">+81 3-1234-5678</div>
                    <div class="location-hours editable-text editable-section no-drop-zone" data-section="420" data-text="747">Daily: 11AM-8PM</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FAQ Section (5 Editable Questions) -->
<div class="container">
    <div class="faq-section editable-section" data-section="421">
        <h2 class="editable-text editable-section no-drop-zone" data-section="422" data-text="748">Frequently Asked Questions</h2>
        <div class="faq-container">
            <!-- FAQ 1 -->
            <div class="faq-item editable-text editable-section no-drop-zone" data-section="423">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="424" data-text="749">What is your return policy?</span>
                    <i class="fas fa-plus faq-icon editable-icon" data-icon="604" data-default-class="fas fa-plus"></i>
                </button>
                <div class="faq-answer editable-text editable-section no-drop-zone" data-section="425" data-text="750">We offer a 30-day return policy for all unused items in their original packaging. Custom items and personalized products are non-returnable. Returns are processed within 5-7 business days, and you will receive a full refund to your original payment method. For more details, please visit our Returns & Exchanges page.</div>
            </div>
            <!-- FAQ 2 -->
            <div class="faq-item editable-text editable-section no-drop-zone" data-section="426">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="427" data-text="751">How do I determine the right size for my pet?</span>
                    <i class="fas fa-plus faq-icon"></i>
                </button>
                <div class="faq-answer editable-text editable-section no-drop-zone" data-section="428" data-text="752">We provide detailed sizing guides for each product category. For beds, measure your pet from nose to tail while lying down and add 4-6 inches. For collars and harnesses, measure around the neck and add two finger widths for comfort. Our customer service team is also available to help you select the perfect size for your companion.</div>
            </div>
            <!-- FAQ 3 -->
            <div class="faq-item editable-text editable-section no-drop-zone" data-section="429">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="430" data-text="753">Do you offer international shipping?</span>
                    <i class="fas fa-plus faq-icon"></i>
                </button>
                <div class="faq-answer editable-text editable-section no-drop-zone" data-section="431" data-text="754">Yes, we ship to over 50 countries worldwide. International shipping rates and delivery times vary by destination. Please note that customs duties and taxes may apply and are the responsibility of the customer. For a complete list of countries we ship to and estimated delivery times, please visit our Shipping Information page.</div>
            </div>
            <!-- FAQ 4 -->
            <div class="faq-item editable-text editable-section no-drop-zone" data-section="432">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="433" data-text="755">How do I care for my PŌTA products?</span>
                    <i class="fas fa-plus faq-icon"></i>
                </button>
                <div class="faq-answer editable-text editable-section no-drop-zone" data-section="434" data-text="756">Care instructions vary by product. Most beds feature removable, machine-washable covers. Grooming tools can be cleaned with mild soap and water. For leather accessories, we recommend using a leather conditioner to maintain softness and durability. Detailed care instructions are included with each product and available on our product pages.</div>
            </div>
            <!-- FAQ 5 -->
            <div class="faq-item editable-text editable-section no-drop-zone" data-section="435">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="436" data-text="757">Can I track my order?</span>
                    <i class="fas fa-plus faq-icon"></i>
                </button>
                <div class="faq-answer editable-text editable-section no-drop-zone" data-section="437" data-text="758">Yes! Once your order ships, you'll receive a confirmation email with a tracking number. You can also track your order status by logging into your account and visiting the Orders section. If you have any questions about your shipment, our customer service team is happy to help.</div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Support Section -->
<div class="container">
    <div class="additional-support editable-section" data-section="438">
        <h2 class="editable-text editable-section no-drop-zone" data-section="439" data-text="759">Additional Support</h2>
        <div class="support-grid">
            <div class="support-item">
                <div class="support-icon">
                    <i class="fas fa-shipping-fast editable-icon" data-icon="605" data-default-class="fas fa-shipping-fast"></i>
                </div>
                <div class="support-title editable-text editable-section no-drop-zone" data-section="440" data-text="760">Shipping & Delivery</div>
                <div class="support-description editable-text editable-section no-drop-zone" data-section="441" data-text="761">Track your order, view shipping policies, and learn about delivery options.</div>
            </div>
            <div class="support-item">
                <div class="support-icon">
                    <i class="fas fa-exchange-alt editable-icon" data-icon="606" data-default-class="fas fa-exchange-alt"></i>
                </div>
                <div class="support-title editable-text editable-section no-drop-zone" data-section="442" data-text="762">Returns & Exchanges</div>
                <div class="support-description editable-text editable-section no-drop-zone" data-section="443" data-text="763">Information about our return policy, exchange process, and warranty coverage.</div>
            </div>
            <div class="support-item">
                <div class="support-icon">
                    <i class="fas fa-user-cog editable-icon" data-icon="607" data-default-class="fas fa-user-cog"></i>
                </div>
                <div class="support-title editable-text editable-section no-drop-zone" data-section="444" data-text="764">Account Support</div>
                <div class="support-description editable-text editable-section no-drop-zone" data-section="445" data-text="765">Help with account management, order history, password resets, and privacy settings.</div>
            </div>
        </div>
    </div>
</div>
</main>

<script>
// FAQ Accordion
document.addEventListener('DOMContentLoaded', function() {
    const faqQuestions = document.querySelectorAll('.faq-question');
    
    if (faqQuestions.length > 0) {
        faqQuestions.forEach(question => {
            question.addEventListener('click', function() {
                const faqItem = this.closest('.faq-item');
                const answer = faqItem.querySelector('.faq-answer');
                
                // Close all other FAQs
                faqQuestions.forEach(otherQuestion => {
                    if (otherQuestion !== this) {
                        const otherItem = otherQuestion.closest('.faq-item');
                        const otherAnswer = otherItem.querySelector('.faq-answer');
                        otherQuestion.classList.remove('active');
                        otherAnswer.classList.remove('active');
                    }
                });
                
                // Toggle current FAQ
                const isActive = this.classList.contains('active');
                if (isActive) {
                    this.classList.remove('active');
                    answer.classList.remove('active');
                } else {
                    this.classList.add('active');
                    answer.classList.add('active');
                }
            });
        });
        
        // Open first FAQ by default for better UX
        if (faqQuestions[0]) {
            faqQuestions[0].click();
        }
    }
    
    // Contact Form Submission
    const contactForm = document.getElementById('contactForm');
    if (contactForm) {
        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you for your message! We will get back to you within 24-48 hours.');
            this.reset();
        });
    }
    
    // Support item click handlers
    document.querySelectorAll('.support-item').forEach(item => {
        item.addEventListener('click', function() {
            const title = this.querySelector('.support-title').textContent;
            alert(`Redirecting to ${title} page...`);
        });
    });
    
    // Location card click
    document.querySelectorAll('.location-card').forEach(card => {
        card.addEventListener('click', function() {
            const locationName = this.querySelector('.location-name').textContent;
            alert(`Viewing details for ${locationName}`);
        });
    });
});
</script>
</body>
</html>