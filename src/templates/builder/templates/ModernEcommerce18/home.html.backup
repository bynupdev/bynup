{%load static%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PŌTA | Luxury Pet Essentials</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
    /* Index 0: Background */
    --bg-light: #FDF7F0;
    
    /* Index 1: Text */
    --espresso-dark: #662F17;
    
    /* Index 2: Heading */
    --espresso-dark: #662F17;
    
    /* Index 3: Primary */
    --espresso-dark: #662F17;
    
    /* Index 4: Secondary */
    --sienna-deep: #93523B;
    
    /* Index 5: Accent */
    --terracotta: #D08650;
    
    /* Index 6: Border */
    --cream-warm: #E3C2A3;
    
    /* Index 7: Success */
    --terracotta-light: #E1A16F;
    
    /* Index 8: Warning */
    --terracotta: #D08650;
    
    /* Index 9: Error */
    --sienna-deep: #93523B;
    
    /* Remaining variables (keep as-is after index 9) */
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body,header, .hero, .new-arrivals {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Header / Navigation */
header{
    /* position: fixed;
    top: 0;
    left: 0; */
    width: 100%;
    z-index: 1000;
    padding: 1.2rem 0;
    background-color: rgba(253, 247, 240, 0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(102, 47, 23, 0.05);
    transition: var(--transition);
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo a {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--espresso-dark);
    text-decoration: none;
    letter-spacing: 1px;
}

.logo span{
    color: var(--espresso-dark);
}

.logo spanspan {
    color: var(--terracotta);
}

.desktop-nav {
    display: flex;
    gap: 2.5rem;
}

.desktop-nav a {
    text-decoration: none;
    color: var(--espresso-dark);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    transition: var(--transition);
    position: relative;
}

.desktop-nav a:hover {
    color: var(--terracotta);
}

.desktop-nav a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
    transition: width 0.3s ease;
}

.desktop-nav a:hover::after {
    width: 100%;
}

.nav-icons {
    display: flex;
    gap: 1.5rem;
    align-items: center;
}

.nav-icons i {
    font-size: 1.2rem;
    color: var(--espresso-dark);
    cursor: pointer;
    transition: var(--transition);
}

.nav-icons i:hover {
    color: var(--terracotta);
}

/* Account Dropdown */
.account-dropdown {
    position: relative;
    display: inline-block;
}

.dropdown-content {
    display: none;
    position: absolute;
    right: 0;
    top: 100%;
    background-color: var(--white-pure);
    min-width: 200px;
    box-shadow: 0 8px 25px rgba(102, 47, 23, 0.1);
    z-index: 1;
    border-radius: var(--border-radius);
    overflow: hidden;
    margin-top: 10px;
}

.dropdown-content a {
    color: var(--espresso-dark);
    padding: 0.8rem 1.2rem;
    text-decoration: none;
    display: block;
    font-size: 0.9rem;
    transition: var(--transition);
}

.dropdown-content a:hover {
    background-color: rgba(227, 194, 163, 0.3);
    color: var(--terracotta);
}

.account-dropdown:hover .dropdown-content {
    display: block;
}

/* Hamburger Menu */
.hamburger {
    display: none;
    cursor: pointer;
    font-size: 1.5rem;
    color: var(--espresso-dark);
}

.mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--bg-light);
    z-index: 9999;
    padding: 2rem;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
}

.mobile-nav.active {
    transform: translateX(0);
}

.mobile-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

.mobile-nav-links a {
    text-decoration: none;
    color: var(--espresso-dark);
    font-size: 1.2rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(102, 47, 23, 0.05);
}

.back-button {
    background: none;
    border: none;
    font-size: 1rem;
    color: var(--espresso-dark);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--cream-warm);
    border-radius: 2rem;
}

/* Hero Section */
section.hero {
    height: 100vh;
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    /* margin-top: 80px; */
}

.hero{
width: 100%;
    height: 100%;
    background-image: url('{%static "images/Ecom18/hero.png"%}');
    background-size: cover;
    background-position: center 30%;
    z-index: 1;
}
.hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    /* width: 100%;
    height: 100%;
    background-image: url('https://images.pexels.com/photos/6231634/pexels-photo-6231634.jpeg?auto=compress&cs=tinysrgb&w=1600');
    background-size: cover;
    background-position: center 30%;
    z-index: 1; */
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(120deg, rgba(227, 194, 163, 0.25) 0%, rgba(102, 47, 23, 0.15) 100%);
    z-index: 2;
}

.hero-content {
    position: relative;
    z-index: 3;
    max-width: 650px;
    padding: 2rem;
    background: rgba(253, 247, 240, 0.75);
    backdrop-filter: blur(8px);
    border-radius: 2rem;
    margin: 2rem;
}

h1 {
    font-size: 3.5rem;
    color: var(--espresso-dark);
    line-height: 1.2;
    margin-bottom: 1.2rem;
    font-weight: 600;
}

p {
    font-size: 1.1rem;
    color: var(--sienna-deep);
    margin-bottom: 2rem;
    font-weight: 400;
    line-height: 1.6;
}

a.cta-btn {
    display: inline-block;
    background: var(--terracotta);
    color: white;
    padding: 1rem 2rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-decoration: none;
    border-radius: 3rem;
    transition: var(--transition);
    box-shadow: 0 4px 12px rgba(102, 47, 23, 0.15);
}

a.cta-btn:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 47, 23, 0.2);
}

/* New Arrivals Section */
section.new-arrivals {
    padding: var(--spacing-xl) 0;
    text-align: center;
}

.section-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
}

h2 {
    font-size: 2.8rem;
    color: var(--espresso-dark);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
}

h2::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
}

p {
    color: var(--sienna-deep);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: var(--spacing-lg);
}

div.product-card {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: 0 6px 12px var(--shadow-soft);
    cursor: pointer;
}

div.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 28px var(--shadow-hover);
}

.product-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
}

div.product-card:hover .product-img {
    transform: scale(1.02);
}

.product-info {
    padding: 1.2rem;
    text-align: left;
}

.product-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
}

.product-price {
    font-weight: 500;
    color: var(--terracotta);
    font-size: 1rem;
}

.product-category {
    color: var(--sienna-deep);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
}

.see-more {
    display: inline-block;
    background: none;
    border: none;
    font-weight: 600;
    color: var(--sienna-deep);
    font-size: 1rem;
    cursor: pointer;
    border-bottom: 2px solid var(--terracotta-light);
    padding-bottom: 4px;
    transition: 0.2s;
    font-family: inherit;
}

.see-more:hover {
    color: var(--espresso-dark);
    border-bottom-color: var(--espresso-dark);
}

/* Footer */
footer {
    background-color: var(--espresso-dark);
    color: var(--bg-light);
    padding: var(--spacing-lg) 0;
    /* margin-top: var(--spacing-lg); */
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
}

.footer-section {
    flex: 1;
    min-width: 200px;
}

h3.editable-section.no-drop-zone[data-section="27"] {
    font-size: 1.3rem;
    margin-bottom: 1.2rem;
    color: var(--cream-warm);
    font-family: 'Cormorant Garamond', serif;
}

.footer-column p, .footer-column a {
    color: rgba(253, 247, 240, 0.8);
    margin-bottom: 0.6rem;
    display: block;
    text-decoration: none;
    transition: var(--transition);
    font-size: 0.9rem;
}

.footer-column a:hover {
    color: var(--cream-warm);
}

.social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
}

.social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(253, 247, 240, 0.1);
    color: var(--bg-light);
    transition: var(--transition);
}

.social-link:hover {
    background: var(--terracotta);
    transform: translateY(-3px);
}

.copyright {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(253, 247, 240, 0.1);
    color: rgba(253, 247, 240, 0.6);
    font-size: 0.85rem;
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .products-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.8rem;
    }
    h1 {
        font-size: 3rem;
    }
}

@media (max-width: 992px) {
    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    h1 {
        font-size: 2.8rem;
    }
    .desktop-nav {
        gap: 1.8rem;
    }
}

@media (max-width: 768px) {
    .hamburger {
        display: block;
    }
    .desktop-nav {
        display: none;
    }
    section.hero {
        height: 80vh;
        /* margin-top: 70px; */
        justify-content: center;
        text-align: center;
    }
    .hero-content {
        margin: 1rem;
        padding: 1.5rem;
    }
    h1 {
        font-size: 2.2rem;
    }
    p {
        font-size: 1rem;
    }
    .products-grid {
        grid-template-columns: 1fr;
        max-width: 380px;
        margin: 0 auto 2rem;
    }
    h2 {
        font-size: 2rem;
    }
    .container {
        padding: 0 1.2rem;
    }
    .footer-content {
        flex-direction: column;
        gap: 2rem;
    }
    .footer-section {
        min-width: 100%;
    }
}

@media (max-width: 576px) {
    h1 {
        font-size: 1.8rem;
    }
    a.cta-btn,
    .see-more {
        padding: 0.8rem 1.5rem;
        font-size: 0.9rem;
    }
}
</style>
</head>
<body>

<!-- Header -->
<header class="editable-section no-drop-zone" data-section="1">
    <div class="container header-container">
        <div class="logo">
            <a href="?page=home">
                <i class="fas fa-paw editable-icon" data-icon="1" data-default-class="fas fa-paw"></i>
                <span class="editable-text editable-section no-drop-zone" data-section="2" data-text="1">PŌTA<span>Pet</span></span>
            </a>
        </div>
        <nav class="desktop-nav">
            <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="3" data-text="2">Home</a>
            <a href="?page=shop" class="editable-text editable-section no-drop-zone" data-section="4" data-text="3">Shop</a>
            <a href="?page=about" class="editable-text editable-section no-drop-zone" data-section="5" data-text="4">About Us</a>
            <a href="?page=contact" class="editable-text editable-section no-drop-zone" data-section="6" data-text="5">Contact</a>
        </nav>
        <div class="nav-icons">
            <a href="?page=cart" class="icon-btn">
                <i class="fas fa-shopping-bag editable-icon" data-icon="2" data-default-class="fas fa-shopping-bag"></i>
            </a>
            <a href="?page=wishlist" class="icon-btn">
                <i class="far fa-heart editable-icon" data-icon="3" data-default-class="far fa-heart"></i>
            </a>
            <div class="account-dropdown">
                <i class="far fa-user editable-icon" data-icon="4" data-default-class="far fa-user"></i>
                <div class="dropdown-content">
                    <a href="?page=login" class="editable-section editable-text no-drop-zone" data-section="7" data-text="6">Sign In</a>
                    <a href="?page=register" class="editable-section editable-text no-drop-zone" data-section="8" data-text="7">Sign Up</a>
                    <a href="?page=orders" class="editable-section editable-text no-drop-zone" data-section="9" data-text="8">Orders</a>
                    <a href="?page=wishlist" class="editable-section editable-text no-drop-zone" data-section="10" data-text="9">Wishlist</a>
                    <a href="?page=account" class="editable-section editable-text no-drop-zone" data-section="11" data-text="10">Account Settings</a>
                </div>
            </div>
            <div class="hamburger">
                <i class="fas fa-bars editable-icon" data-icon="5" data-default-class="fas fa-bars"></i>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Navigation -->
<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="?page=home" class="logo">PŌTA<span>Pet</span></a>
        <button class="back-button" id="closeNav">
            <i class="fas fa-arrow-left editable-icon" data-icon="6" data-default-class="fas fa-arrow-left"></i> Back
        </button>
    </div>
    <div class="mobile-nav-links">
        <a href="?page=home">Home</a>
        <a href="?page=shop">Shop</a>
        <a href="?page=about">About Us</a>
        <a href="?page=contact">Contact</a>
        <a href="?page=cart"><i class="fas fa-shopping-bag"></i> Cart</a>
        <a href="?page=wishlist"><i class="far fa-heart"></i> Wishlist</a>
        <a href="?page=account"><i class="far fa-user"></i> Account</a>
    </div>
</div>

<!-- Hero Section -->
<section class="hero editable-section" data-section="13">
    <div class="hero-bg editable-section no-drop-zone" data-section="46"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 class="editable-text editable-section no-drop-zone" data-section="14" data-text="11">Care Beyond Companionship</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="15" data-text="12">Premium essentials crafted for the comfort, health, and happiness of your pet.</p>
        <a href="?page=shop" class="cta-btn editable-text editable-section no-drop-zone" data-section="16" data-text="13">Shop Pet Essentials</a>
    </div>
</section>

<!-- New Arrivals Section -->
<section class="new-arrivals editable-section" data-section="17">
    <div class="container">
        <div class="section-header">
            <h2 class="editable-text editable-section no-drop-zone" data-section="18" data-text="14">New Arrivals</h2>
            <p class="editable-text editable-section no-drop-zone" data-section="19" data-text="15">Curated essentials for the discerning pet parent.</p>
        </div>
        <div class="products-grid">
            <!-- Product 1 (Editable) -->
            <div class="product-card editable-section no-drop-zone" data-section="20">
                <img src="{%static 'images/Ecom18/hero.png'%}" alt="Luxury Pet Bed" class="product-img editable-image" data-image="7">
                <div class="product-info">
                    <div class="product-category editable-section no-drop-zone" data-section="21" data-text="16">BEDS</div>
                    <div class="product-name editable-section no-drop-zone" data-section="22" data-text="17">Cashmere Cloud Bed</div>
                    <div class="product-price editable-section no-drop-zone" data-section="23" data-text="18">$189</div>
                </div>
            </div>
            <!-- Product 2 (Non-editable sample) -->
            <div class="product-card">
                <img src="https://images.pexels.com/photos/5794844/pexels-photo-5794844.jpeg?auto=compress&cs=tinysrgb&w=600&h=600&fit=crop" alt="Grooming Kit" class="product-img">
                <div class="product-info">
                    <div class="product-category">GROOMING</div>
                    <div class="product-name">Herbal Grooming Set</div>
                    <div class="product-price">$96</div>
                </div>
            </div>
            <!-- Product 3 (Non-editable sample) -->
            <div class="product-card">
                <img src="https://images.pexels.com/photos/6853401/pexels-photo-6853401.jpeg?auto=compress&cs=tinysrgb&w=600&h=600&fit=crop" alt="Pet Bowl" class="product-img">
                <div class="product-info">
                    <div class="product-category">DINING</div>
                    <div class="product-name">Oak & Stone Feeding Set</div>
                    <div class="product-price">$74</div>
                </div>
            </div>
            <!-- Product 4 (Non-editable sample) -->
            <div class="product-card">
                <img src="https://images.pexels.com/photos/8263769/pexels-photo-8263769.jpeg?auto=compress&cs=tinysrgb&w=600&h=600&fit=crop" alt="Pet Toy" class="product-img">
                <div class="product-info">
                    <div class="product-category">TOYS</div>
                    <div class="product-name">Artisan Silk Rope Toy</div>
                    <div class="product-price">$42</div>
                </div>
            </div>
        </div>
        <a href="?page=shop" class="see-more editable-text editable-section no-drop-zone" data-section="24" data-text="19">View All →</a>
    </div>
</section>

<!-- Footer -->
<footer class="editable-section" data-section="25">
    <div class="container">
        <div class="footer-content">
            <div class="footer-section editable-section no-drop-zone" data-section="26">
                <h3 class="editable-section editable-text no-drop-zone" data-section="27" data-text="20">PŌTA</h3>
                <ul>
                    <li class="editable-section editable-text no-drop-zone" data-section="28" data-text="21">Premium essentials for the modern pet parent. Thoughtfully crafted with love and care.</li>
                </ul>
                <div class="social-links">
                    <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-pinterest-p"></i></a>
                </div>
            </div>
            <div class="footer-section">
                <h3 class="editable-section editable-text no-drop-zone" data-section="29" data-text="22">Quick Links</h3>
                <ul>
                    <li><a href="?page=home" class="editable-section editable-text no-drop-zone" data-section="30" data-text="23">Home</a></li>
                    <li><a href="?page=shop" class="editable-section editable-text no-drop-zone" data-section="31" data-text="24">Shop</a></li>
                    <li><a href="?page=about" class="editable-section editable-text no-drop-zone" data-section="32" data-text="25">About Us</a></li>
                    <li><a href="?page=contact" class="editable-section editable-text no-drop-zone" data-section="33" data-text="26">Contact</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3 class="editable-section editable-text no-drop-zone" data-section="34" data-text="27">Customer Service</h3>
