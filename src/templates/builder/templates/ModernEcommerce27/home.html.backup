<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ATELIER VREDE // Avant-Garde Carry Systems</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Syne:wght@800&display=swap" rel="stylesheet">

    <style>
        /* --- HIGH-CONTRAST NEO-BRUTALIST PALETTE --- */
        :root {
            --text: #DFFF19;
            --background: #0D0D11;
            --border: #18181F;
            --heading: #F4F4F0;
            --primary: #FFFFFF;
            --secondary: #6B6B76;
            --heavy-border: 2px solid #0D0D11;
            --thin-border: 1px solid rgba(13, 13, 17, 0.15);
            --font-display: 'Syne', sans-serif;
            --font-body: 'Space Grotesk', sans-serif;
            --transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: var(--font-body);
        }

        body {
            background-color: var(--heading);
            color: var(--background);
            overflow-x: hidden;
            letter-spacing: -0.3px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            cursor: pointer;
            border: none;
            background: none;
            transition: var(--transition);
        }

        /* --- GLOBAL CONTAINERS & BOX DECORATIONS --- */
        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .section-padding {
            padding: clamp(50px, 8vw, 100px) 0;
            border-bottom: var(--heavy-border);
        }

        .section-title {
            font-family: var(--font-display);
            font-size: clamp(32px, 5vw, 64px);
            font-weight: 800;
            text-transform: uppercase;
            line-height: 0.9;
            margin-bottom: clamp(40px, 6vw, 70px);
            letter-spacing: -2px;
            word-break: break-word;
        }
        .section-title span{
            font-family: var(--font-display);
            font-size: clamp(32px, 5vw, 64px);
            font-weight: 800;
            text-transform: uppercase;
            line-height: 0.9;
            margin-bottom: clamp(40px, 6vw, 70px);
            letter-spacing: -2px;
            word-break: break-word;
        }

        .section-title .module {
            background: var(--background);
            color: var(--text);
            padding: 0 12px;
            display: inline-block;
            transform: rotate(-1deg);
        }
        .section-title .protocol {
            background: var(--background);
            color: var(--text);
            padding: 0 12px;
            display: inline-block;
            transform: rotate(-1deg);
        }

        /* --- BRUTALIST RAW HEADER NAVIGATION --- */
        header {
            background: var(--primary);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: var(--heavy-border);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
        }

        .logo {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: clamp(20px, 2.5vw, 26px);
            letter-spacing: -1.5px;
            text-transform: uppercase;
            background: var(--background);
            color: #FFFFFF;
            padding: 4px 12px;
        }

        .logo .slash {
            color: var(--text);
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 40px;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
        }

        .nav-links li a {
            padding: 8px 12px;
        }

        .nav-links li a:hover {
            background: var(--background);
            color: var(--text);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        /* Account Dropdown Styles */
        .account-dropdown {
            position: relative;
        }

        .account-menu {
            position: absolute;
            top: 100%;
            right: 0;
            width: 220px;
            background: var(--primary);
            border: var(--heavy-border);
            z-index: 101;
            display: none;
            margin-top: 10px;
        }

        .account-menu.active {
            display: block;
        }

        .account-menu a {
            display: block;
            padding: 14px 20px;
            font-size: 13px;
            font-weight: 500;
            text-transform: uppercase;
            border-bottom: 1px solid rgba(13, 13, 17, 0.1);
        }

        .account-menu a:hover {
            background: var(--background);
            color: var(--text);
        }

        .account-menu a:last-child {
            border-bottom: none;
        }

        .action-square-btn {
            width: 44px;
            height: 44px;
            border: var(--heavy-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            color: var(--background);
            position: relative;
            background: var(--primary);
        }

        .action-square-btn:hover {
            background: var(--background);
            color: var(--text);
            transform: translate(-2px, -2px);
            box-shadow: 4px 4px 0 var(--background);
        }

        .badge-block {
            position: absolute;
            bottom: -5px;
            right: -5px;
            background: var(--text);
            color: var(--background);
            border: 1px solid var(--background);
            font-size: 10px;
            font-weight: 700;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* --- INDUSTRIAL SIDE PANEL DRAWERS --- */
        .panel-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(13, 13, 17, 0.4);
            z-index: 300;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
        }

        .panel-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .side-panel {
            position: fixed;
            top: 0;
            right: -100%;
            width: 100%;
            max-width: 500px;
            height: 100%;
            background: var(--primary);
            border-left: var(--heavy-border);
            z-index: 301;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
        }

        .side-panel.active {
            right: 0;
        }

        .panel-header {
            padding: 24px;
            background: var(--background);
            color: #FFFFFF;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-header h3 {
            font-family: var(--font-display);
            font-size: 18px;
            text-transform: uppercase;
            letter-spacing: -0.5px;
        }

        .close-panel-square {
            color: var(--text);
            font-size: 20px;
        }

        .panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            background: var(--heading);
        }

        .panel-empty {
            font-weight: 500;
            text-transform: uppercase;
            color: var(--secondary);
            text-align: center;
            margin-top: 40px;
        }

        .brutal-item-card {
            background: var(--primary);
            border: var(--heavy-border);
            padding: 16px;
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .panel-item-img {
            width: 75px;
            height: 75px;
            object-fit: cover;
            border: var(--heavy-border);
            background: var(--heading);
        }

        .panel-item-info {
            flex: 1;
        }

        .panel-item-title {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--background);
        }

        .panel-item-variant {
            font-size: 12px;
            color: var(--secondary);
            margin: 4px 0;
        }

        .panel-item-price {
            font-weight: 700;
            font-size: 15px;
        }

        .panel-item-remove {
            color: var(--background);
            font-size: 16px;
            padding: 8px;
        }

        .panel-item-remove:hover {
            color: #FF2424;
        }

        .panel-footer {
            padding: 24px;
            border-top: var(--heavy-border);
            background: var(--primary);
        }

        .promo-block {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
        }

        .promo-input {
            flex: 1;
            padding: 14px;
            background: var(--heading);
            border: var(--heavy-border);
            color: var(--background);
            font-weight: 500;
        }

        .promo-btn {
            background: var(--background);
            color: #FFFFFF;
            padding: 0 16px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 12px;
        }

        .promo-btn:hover {
            background: var(--text);
            color: var(--background);
        }

        .promo-feedback {
            font-size: 12px;
            font-weight: 700;
            margin-top: -10px;
            margin-bottom: 14px;
            display: none;
            text-transform: uppercase;
        }
        .promo-feedback.valid { color: #008822; display: block; }
        .promo-feedback.invalid { color: #FF2424; display: block; }

        .bill-row {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .bill-row.grand-total {
            font-size: 18px;
            color: var(--background);
            font-weight: 700;
            text-transform: uppercase;
            border-top: var(--heavy-border);
            padding-top: 14px;
            margin-top: 14px;
        }

        .checkout-btn {
            width: 100%;
            background: var(--background);
            color: var(--text);
            padding: 18px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 14px;
            margin-top: 12px;
            border: var(--heavy-border);
        }

        .checkout-btn:hover {
            background: var(--text);
            color: var(--background);
            box-shadow: 4px 4px 0 var(--background);
            transform: translate(-2px, -2px);
        }

        /* --- STICKY FLOATING BOTTOM CART BAR --- */
        .sticky-cart-bar {
            position: fixed;
            bottom: -120px;
            left: 0;
            width: 100%;
            background: var(--background);
            color: #FFFFFF;
            border-top: var(--heavy-border);
            padding: 20px 24px;
            z-index: 90;
            transition: var(--transition);
        }

        .sticky-cart-bar.active {
            bottom: 0;
        }

        .sticky-cart-layout {
            max-width: 1440px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .sticky-cart-summary {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .sticky-cart-icon-box {
            background: var(--text);
            color: var(--background);
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 700;
        }

        .sticky-cart-meta {
            text-transform: uppercase;
            font-size: 13px;
            font-weight: 700;
        }

        .sticky-cart-total {
            color: var(--text);
            font-size: 18px;
        }

        .sticky-cart-actions {
            display: flex;
            gap: 12px;
        }

        .sticky-view-bag-btn {
            border: 2px solid #FFFFFF;
            color: #FFFFFF;
            padding: 14px 24px;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
        }

        .sticky-view-bag-btn:hover {
            background: rgba(255,255,255,0.1);
        }

        .sticky-checkout-btn {
            background: var(--text);
            color: var(--background);
            padding: 14px 32px;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
        }

        .sticky-checkout-btn:hover {
            background: #FFFFFF;
        }

        /* --- INDUSTRIAL RAW EDITORIAL HERO --- */
        .hero {
            padding: 40px 0 80px 0;
            border-bottom: var(--heavy-border);
        }

        .hero-layout {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            align-items: stretch;
            border: var(--heavy-border);
            background: var(--primary);
        }

        .hero-text-box {
            padding: clamp(30px, 6vw, 80px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            border-right: var(--heavy-border);
        }

        .hero-tag {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            background: var(--background);
            color: var(--text);
            align-self: flex-start;
            padding: 4px 10px;
            margin-bottom: 24px;
        }

        .hero-heading {
            font-family: var(--font-display);
            font-size: clamp(36px, 6vw, 76px);
            line-height: 0.85;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -3px;
            margin-bottom: 24px;
        }

        .hero-heading .faded {
            display: block;
            color: var(--secondary);
        }

        .hero-description {
            color: var(--background);
            font-size: 16px;
            line-height: 1.5;
            max-width: 520px;
            margin-bottom: 36px;
            font-weight: 500;
        }

        .hero-cta {
            background: var(--background);
            color: #FFFFFF;
            padding: 20px 40px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            align-self: flex-start;
            text-align: center;
        }

        .hero-cta:hover {
            background: var(--text);
            color: var(--background);
            box-shadow: 6px 6px 0 var(--background);
            transform: translate(-3px, -3px);
        }

        .hero-showcase {
            background: var(--heading);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .hero-showcase-img {
            width: 100%;
            height: 100%;
            min-height: 450px;
            object-fit: cover;
        }

        /* --- PRODUCT GRID SYSTEM --- */
        .shop-section {
            background: var(--primary);
        }

        .grid-layout {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2px;
            background: var(--background);
            border: var(--heavy-border);
        }

        .item-card {
            background: var(--primary);
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .item-display {
            background: var(--heading);
            border: var(--heavy-border);
            height: 360px;
            position: relative;
            cursor: pointer;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .item-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: grayscale(10%);
            transition: var(--transition);
        }

        .item-card:hover .item-img {
            transform: scale(1.05) rotate(1deg);
            filter: grayscale(0%);
        }

        .item-overlay-actions {
            position: absolute;
            bottom: 20px;
            right: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .action-square {
            background: var(--primary);
            border: var(--heavy-border);
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--background);
            font-size: 16px;
        }

        .action-square:hover {
            background: var(--background);
            color: var(--text);
        }

        .item-meta {
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .item-title {
            font-family: var(--font-display);
            font-size: 18px;
            text-transform: uppercase;
            letter-spacing: -0.5px;
            line-height: 1;
            margin-bottom: 6px;
            cursor: pointer;
        }

        .item-title:hover {
            color: var(--secondary);
        }

        .item-tagline {
            font-size: 13px;
            color: var(--secondary);
            font-weight: 500;
        }

        .item-price {
            font-size: 18px;
            font-weight: 700;
            background: var(--text);
            padding: 2px 8px;
            border: 1px solid var(--background);
        }

        /* --- THE ATELIER PHILOSOPHY BLOCK --- */
        .about-section {
            background: var(--heading);
        }

        .about-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(40px, 6vw, 80px);
            align-items: center;
        }

        .about-photo-wrapper {
            border: var(--heavy-border);
            background: var(--background);
            padding: 12px;
        }

        .about-photo {
            width: 100%;
            height: clamp(400px, 50vh, 550px);
            object-fit: cover;
            border: var(--heavy-border);
        }

        .about-text h3 {
            font-family: var(--font-display);
            font-size: 24px;
            text-transform: uppercase;
            margin-bottom: 20px;
            line-height: 1.1;
            letter-spacing: -0.5px;
        }

        .about-text p {
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 18px;
            color: var(--background);
            font-weight: 500;
        }

        /* --- RAW INDUSTRIAL ACCORDION --- */
        .faq-section {
            background: var(--primary);
        }

        .faq-wrapper {
            max-width: 1000px;
            border: var(--heavy-border);
            background: var(--heading);
        }

        .faq-row {
            border-bottom: var(--heavy-border);
        }

        .faq-row:last-child {
            border-bottom: none;
        }

        .faq-trigger {
            width: 100%;
            padding: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: left;
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--background);
            background: var(--primary);
        }

        .faq-trigger:hover {
            background: var(--background);
            color: var(--text);
        }

        .faq-icon-state {
            font-size: 14px;
            transition: var(--transition);
        }

        .faq-content {
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
            font-size: 15px;
            line-height: 1.6;
            font-weight: 500;
        }

        .faq-content-inner {
            padding: 30px;
            background: var(--heading);
        }

        .faq-row.active .faq-content {
            max-height: 300px;
        }

        .faq-row.active .faq-icon-state {
            transform: rotate(180deg);
        }

        /* --- CONTACT BASE GRID --- */
        .contact-layout {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 40px;
        }

        .contact-card {
            background: var(--background);
            color: #FFFFFF;
            padding: 40px;
            display: flex;
            flex-direction: column;
            gap: 40px;
            border: var(--heavy-border);
        }

        .contact-card-header {
            font-family: var(--font-display);
            font-size: 20px;
            text-transform: uppercase;
            color: var(--text);
            letter-spacing: -0.5px;
        }

        .contact-node i {
            color: var(--text);
            font-size: 20px;
            margin-bottom: 12px;
        }

        .contact-node h4 {
            font-size: 14px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .contact-node p {
            color: #B5B5C0;
            font-size: 15px;
            line-height: 1.4;
        }

        .contact-form-wrapper {
            background: var(--primary);
            border: var(--heavy-border);
            padding: 40px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .input-row {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .input-row label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .field-input {
            padding: 16px;
            border: var(--heavy-border);
            font-size: 15px;
            background: var(--heading);
            color: var(--background);
            font-weight: 500;
        }

        .field-input:focus {
            background: var(--primary);
            outline: none;
            box-shadow: 4px 4px 0 var(--background);
        }

        .form-send {
            background: var(--background);
            color: var(--text);
            padding: 18px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            margin-top: 10px;
            border: var(--heavy-border);
        }

        .form-send:hover {
            background: var(--text);
            color: var(--background);
            box-shadow: 4px 4px 0 var(--background);
            transform: translate(-2px, -2px);
        }

        /* --- DETAILED QUICK-VIEW MODAL --- */
        .modal-mask {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(13, 13, 17, 0.6);
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
            padding: 20px;
        }

        .modal-mask.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-wrapper {
            background: var(--primary);
            border: var(--heavy-border);
            width: 100%;
            max-width: 1150px;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            padding: clamp(24px, 4vw, 50px);
            transform: scale(0.95);
            transition: var(--transition);
        }

        .modal-mask.active .modal-wrapper {
            transform: scale(1);
        }

        .modal-dismiss {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 24px;
            z-index: 5;
            color: var(--background);
        }

        .modal-dismiss:hover {
            color: var(--text);
            background: var(--background);
            padding: 4px;
        }

        .modal-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        .modal-viewport {
            background: var(--heading);
            border: var(--heavy-border);
            display: flex;
            align-items: center;
            justify-content: center;
            height: clamp(340px, 45vh, 500px);
        }

        .modal-viewport img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .modal-meta-box h2 {
            font-family: var(--font-display);
            font-size: clamp(24px, 3vw, 36px);
            text-transform: uppercase;
            margin-bottom: 12px;
            line-height: 0.9;
            letter-spacing: -1px;
        }

        .modal-price-tag {
            font-size: 22px;
            font-weight: 700;
            display: inline-block;
            background: var(--text);
            padding: 2px 10px;
            border: var(--heavy-border);
            margin-bottom: 20px;
        }

        .modal-summary {
            font-size: 15px;
            line-height: 1.5;
            margin-bottom: 24px;
            font-weight: 500;
        }

        .spec-grid {
            width: 100%;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .spec-grid td {
            padding: 10px 0;
            border-bottom: var(--thin-border);
            font-weight: 500;
        }

        .spec-grid td:first-child {
            font-weight: 700;
            color: var(--secondary);
            width: 35%;
            text-transform: uppercase;
        }

        .selector-header {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .swatch-row {
            display: flex;
            gap: 10px;
            margin-bottom: 24px;
        }

        .swatch-node {
            width: 55px;
            height: 55px;
            border: var(--heavy-border);
            cursor: pointer;
            padding: 2px;
            background: var(--heading);
        }

        .swatch-node.active {
            background: var(--text);
        }

        .swatch-node img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .qty-controls {
            display: inline-flex;
            border: var(--heavy-border);
            align-items: center;
            margin-bottom: 30px;
            background: var(--heading);
        }

        .qty-action {
            padding: 10px 16px;
            font-weight: 700;
            font-size: 16px;
        }

        .qty-view {
            width: 40px;
            text-align: center;
            border: none;
            font-weight: 700;
            background: transparent;
        }

        .modal-footer-btns {
            display: grid;
            grid-template-columns: 1fr 1fr 50px;
            gap: 10px;
        }

        .btn-cart-add {
            background: transparent;
            border: var(--heavy-border);
            color: var(--background);
            padding: 16px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
        }

        .btn-cart-add:hover {
            background: var(--background);
            color: #FFFFFF;
        }

        .btn-buy-now {
            background: var(--background);
            color: var(--text);
            border: var(--heavy-border);
            padding: 16px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
        }

        .btn-buy-now:hover {
            background: var(--text);
            color: var(--background);
        }

        .btn-wish-add {
            border: var(--heavy-border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .btn-wish-add:hover {
            background: var(--background);
            color: var(--text);
        }

        /* --- REVIEW SECTION STYLES --- */
        .review-section {
            margin-top: 32px;
            border-top: var(--heavy-border);
            padding-top: 24px;
        }

        .review-title {
            font-family: var(--font-display);
            font-size: 16px;
            text-transform: uppercase;
            margin-bottom: 16px;
            letter-spacing: -0.5px;
        }

        .review-stats {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: var(--thin-border);
        }

        .avg-rating {
            font-size: 28px;
            font-weight: 700;
            color: var(--background);
        }

        .review-stars {
            color: #FFD700;
            font-size: 14px;
        }

        .review-count {
            font-size: 12px;
            color: var(--secondary);
        }

        .review-list {
            margin-bottom: 20px;
            max-height: 250px;
            overflow-y: auto;
        }

        .review-card-item {
            background: var(--heading);
            padding: 14px;
            margin-bottom: 12px;
            border: var(--thin-border);
        }

        .review-card-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .reviewer-name {
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
        }

        .review-date {
            font-size: 10px;
            color: var(--secondary);
        }

        .review-stars-small {
            color: #FFD700;
            font-size: 10px;
            margin-bottom: 6px;
        }

        .review-text {
            font-size: 13px;
            line-height: 1.4;
        }

        .write-review-btn {
            width: 100%;
            background: var(--background);
            color: var(--text);
            padding: 12px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 12px;
            border: var(--heavy-border);
            margin-top: 12px;
        }

        .write-review-btn:hover {
            background: var(--text);
            color: var(--background);
        }

        /* Review Form Modal */
        .review-form-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(13, 13, 17, 0.8);
            z-index: 400;
            align-items: center;
            justify-content: center;
        }

        .review-form-modal.active {
            display: flex;
        }

        .review-form-container {
            background: var(--primary);
            border: var(--heavy-border);
            width: 90%;
            max-width: 500px;
            padding: 30px;
        }

        .review-form-container h3 {
            font-family: var(--font-display);
            font-size: 20px;
            margin-bottom: 20px;
        }

        .review-form-group {
            margin-bottom: 16px;
        }

        .review-form-group label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .review-form-group input,
        .review-form-group textarea,
        .review-form-group select {
            width: 100%;
            padding: 12px;
            border: var(--heavy-border);
            background: var(--heading);
            font-family: var(--font-body);
        }

        .rating-select {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }

        .rating-star-select {
            font-size: 24px;
            cursor: pointer;
            color: #ddd;
        }

        .rating-star-select.active {
            color: #FFD700;
        }

        .submit-review-modal {
            width: 100%;
            background: var(--background);
            color: var(--text);
            padding: 14px;
            font-weight: 700;
            text-transform: uppercase;
            border: var(--heavy-border);
            margin-top: 16px;
        }

        /* --- BRUTAL FOOTER --- */
        footer {
            background: var(--background);
            color: #858590;
            padding: 50px 0 30px 0;
            text-align: center;
            font-size: 13px;
            font-weight: 500;
            text-transform: uppercase;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            margin-bottom: 40px;
            text-align: left;
        }

        .footer-column h4 {
            font-family: var(--font-display);
            font-size: 14px;
            color: var(--text);
            margin-bottom: 16px;
            letter-spacing: -0.5px;
        }

        .footer-column a {
            display: block;
            color: #858590;
            margin-bottom: 10px;
            font-size: 12px;
            text-transform: none;
        }

        .footer-column a:hover {
            color: var(--text);
        }

        .social-links {
            display: flex;
            gap: 16px;
            margin-top: 16px;
        }

        .social-links a {
            font-size: 18px;
        }

        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(133, 133, 144, 0.2);
            font-size: 11px;
        }

        footer span {
            color: #FFFFFF;
            font-weight: 700;
        }

        /* --- HARD RESPONSIVE BREAKS --- */
        @media (max-width: 992px) {
            .hero-layout, .about-layout, .contact-layout, .modal-split {
                grid-template-columns: 1fr;
            }
            .hero-text-box {
                border-right: none;
                border-bottom: var(--heavy-border);
            }
            .sticky-cart-meta {
                display: none;
            }
            .footer-content {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .nav-links { 
                display: none; 
            }
            .side-panel { 
                max-width: 100%; 
                right: -100%; 
            }
            .modal-footer-btns {
                grid-template-columns: 1fr;
            }
            .btn-wish-add {
                padding: 16px;
            }
            .footer-content {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .social-links {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <header>
        <div class="container nav-container editable-section" data-section="1">
            <div class="logo editable-section no-drop-zone" data-section="612"><a href="#"><span class="editable-text editable-section no-drop-zone" data-section="2" data-text="1">VREDE</span><span class="slash editable-text editable-section no-drop-zone" data-section="610" data-text="611">//</span></a></div>
            <ul class="nav-links">
                <li><a href="#showroom" class="editable-text editable-section no-drop-zone" data-section="3" data-text="2">Index Drop</a></li>
                <li><a href="#lineage" class="editable-text editable-section no-drop-zone" data-section="4" data-text="3">The System</a></li>
                <li><a href="#intel" class="editable-text editable-section no-drop-zone" data-section="5" data-text="4">Faq Specs</a></li>
                <li><a href="#coordinates" class="editable-text editable-section no-drop-zone" data-section="6" data-text="5">Inquire</a></li>
            </ul>
            <div class="nav-actions">
                <!-- Account Dropdown -->
                <div class="account-dropdown editable-section no-drop-zone" data-section="200">
                    <button class="action-square-btn editable-section no-drop-zone" id="account-trigger" data-section="201">
                        <i class="fa-regular fa-user editable-icon" data-icon="100" data-default-class="fa-regular fa-user"></i>
                    </button>
                    <div class="account-menu" id="account-menu" data-section="202">
                        <a href="?page=login" class="editable-text editable-section no-drop-zone" data-section="203" data-text="300">SIGN IN</a>
                        <a href="?page=register" class="editable-text editable-section no-drop-zone" data-section="204" data-text="301">SIGN UP</a>
                        <a href="?page=orders" class="editable-text editable-section no-drop-zone" data-section="205" data-text="302">ORDERS</a>
                        <a href="?page=logout" class="editable-text editable-section no-drop-zone" data-section="206" data-text="303">LOGOUT</a>
                    </div>
                </div>
                <button class="action-square-btn editable-section no-drop-zone" id="trigger-wishlist" data-section="207">
                    <i class="fa-regular fa-heart editable-icon" data-icon="101" data-default-class="fa-regular fa-heart"></i>
                    <span class="badge-block" id="wishlist-indicator">0</span>
                </button>
                <button class="action-square-btn editable-section no-drop-zone" id="trigger-cart" data-section="208">
                    <i class="fa-solid fa-arrow-right-arrow-left editable-icon" data-icon="120" style="transform: rotate(90deg);"></i>
                    <span class="badge-block" id="cart-indicator">0</span>
                </button>
            </div>
        </div>
    </header>

    <div class="panel-overlay" id="panel-mask"></div>

    <div class="side-panel" id="wishlist-sidebar">
        <div class="panel-header">
            <h3 class="editable-text editable-section no-drop-zone" data-section="209" data-text="304">Archived Logs</h3>
            <button class="close-panel-square" onclick="toggleSidebar('wishlist', false)"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="panel-body" id="wishlist-node-target"></div>
    </div>

    <div class="side-panel" id="cart-sidebar">
        <div class="panel-header">
            <h3 class="editable-text editable-section no-drop-zone" data-section="210" data-text="305">Active Manifest</h3>
            <button class="close-panel-square" onclick="toggleSidebar('cart', false)"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="panel-body" id="cart-node-target"></div>
        <div class="panel-footer">
            <div class="promo-block">
                <input type="text" class="promo-input editable-text" id="coupon-field" data-section="211" data-text="306" placeholder="ACCESS CODE: ATELIER10">
                <button class="promo-btn editable-text editable-section no-drop-zone" data-section="212" data-text="307" onclick="applyPromo()">Verify</button>
            </div>
            <div id="coupon-alert" class="promo-feedback"></div>
            <div class="bill-row">
                <span class="editable-text editable-section no-drop-zone" data-section="213" data-text="308">Gross Payload Asset</span>
                <span id="bill-subtotal">$0.00</span>
            </div>
            <div class="bill-row" id="bill-discount-row" style="display: none; color: #008822;">
                <span>System Adjustment (10%)</span>
                <span id="bill-discount">-$0.00</span>
            </div>
            <div class="bill-row grand-total">
                <span class="editable-text editable-section no-drop-zone" data-section="214" data-text="309">Net Total Invoice</span>
                <span id="bill-total">$0.00</span>
            </div>
            <button class="checkout-btn editable-text editable-section no-drop-zone" data-section="215" data-text="310" onclick="executeCheckout()">Initialize Terminal Checkout</button>
        </div>
    </div>

    <div class="sticky-cart-bar" id="sticky-cart-tracker">
        <div class="sticky-cart-layout">
            <div class="sticky-cart-summary">
                <div class="sticky-cart-icon-box">
                    <i class="fa-solid fa-terminal"></i>
                </div>
                <div class="sticky-cart-meta">
                    <div>Manifest Allocation: <span id="sticky-items-label" style="color:var(--text);">0 Modules</span></div>
                    <div class="sticky-cart-total" id="sticky-total-label">$0.00</div>
                </div>
            </div>
            <div class="sticky-cart-actions">
                <button class="sticky-view-bag-btn editable-text editable-section no-drop-zone" data-section="216" data-text="311" onclick="toggleSidebar('cart', true)">Inspect Manifest</button>
                <button class="sticky-checkout-btn editable-text editable-section no-drop-zone" data-section="217" data-text="312" onclick="executeCheckout()">Clear Queue</button>
            </div>
        </div>
    </div>

    <section class="hero editable-section" data-section="218">
        <div class="container hero-layout">
            <div class="hero-text-box editable-section no-drop-zone" data-section="219">
                <span class="hero-tag editable-text editable-section no-drop-zone" data-section="220" data-text="313">System.026 // Outpost</span>
                <h1 class="hero-heading" ><span class="editable-text editable-section no-drop-zone" data-section="221" data-text="314">Heavy Core.</span><br><span class="editable-text editable-section no-drop-zone" data-section="600" data-text="600">Asymmetric</span><br><span class="faded editable-text editable-section no-drop-zone" data-section="601" data-text="601">Architecture.</span></h1>
                <p class="hero-description editable-text editable-section no-drop-zone" data-section="222" data-text="315">A radical challenge to traditional luxury. Raw, industrial structural silhouettes built from extreme wear-rated architectural materials and premium milled calfskins.</p>
                <a href="#showroom" class="hero-cta editable-text editable-section no-drop-zone" data-section="223" data-text="316">Initialize Grid Catalog</a>
            </div>
            <div class="hero-showcase">
                <img src="https://images.pexels.com/photos/904350/pexels-photo-904350.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Vrede Brutalist Showcase" class="hero-showcase-img editable-image" data-image="1">
            </div>
        </div>
    </section>

    <section class="shop-section section-padding editable-section" id="showroom" data-section="224">
        <div class="container">
            <h2 class="section-title"><span class="editable-text editable-section no-drop-zone" data-section="225" data-text="317">Drop Inventory</span> <span class="module editable-text editable-section no-drop-zone" data-section="603" data-text="603">Modules</span></h2>
            <div class="grid-layout" id="shop-items-target"></div>
        </div>
    </section>

    <section class="about-section section-padding editable-section" id="lineage" data-section="226">
        <div class="container about-layout">
            <div class="about-photo-wrapper editable-section no-drop-zone" data-section="109">
                <img src="https://images.pexels.com/photos/6045028/pexels-photo-6045028.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Raw structural materials manipulation" class="about-photo editable-image" data-image="2">
            </div>
            <div class="about-text editable-section no-drop-zone" data-section="227">
                <h2 class="section-title"><span class="editable-text editable-section no-drop-zone" data-section="228" data-text="318">The Vrede</span>  <span class="protocol editable-text editable-section no-drop-zone" data-section="604" data-text="604">Protocol</span></h2>
                <h3 class="editable-text editable-section no-drop-zone" data-section="229" data-text="319">Zero Decoration. Pure Structural Performance.</h3>
                <p class="editable-text editable-section no-drop-zone" data-section="230" data-text="320">We reject the classical delicate definitions of luxury utility. Our carry systems are treated as portable architectures—crafted with hard-angled self-supporting base geometries, thick dual-pass industrial bonding seams, and custom hardware matrix blocks.</p>
                <p class="editable-text editable-section no-drop-zone" data-section="231" data-text="321">Every hide undergoes deep aniline mineral processing inside certified local low-emission facilities, yielding intense core strength that retains its structural signature under heavy load dynamics.</p>
            </div>
        </div>
    </section>

    <section class="faq-section section-padding" id="intel" data-section="232">
        <div class="container">
            <h2 class="section-title editable-section no-drop-zone" data-section="233"><span class="editable-text editable-section no-drop-zone" data-section="605" data-text="322">Technical</span> <span class="protocol editable-text editable-section no-drop-zone" data-section="606" data-text="606">Log Spec</span></h2>
            <div class="faq-wrapper">
                
                <div class="faq-row editable-section no-drop-zone" data-section="234">
                    <button class="faq-trigger" onclick="handleAccordion(this)">
                        <span class="editable-text editable-section no-drop-zone" data-section="235" data-text="323">01 / Explain the raw structural hardware architecture?</span>
                        <i class="fa-solid fa-plus faq-icon-state"></i>
                    </button>
                    <div class="faq-content">
                        <div class="faq-content-inner editable-text editable-section no-drop-zone" data-section="236" data-text="324">
                            Every handle load node is reinforced with solid, custom-milled high-density raw brass or tempered carbon alloy bars. These elements bypass standard rivet layouts, ensuring permanent geometric integrity.
                        </div>
                    </div>
                </div>

                <div class="faq-row editable-section no-drop-zone" data-section="237">
                    <button class="faq-trigger" onclick="handleAccordion(this)">
                        <span class="editable-text editable-section no-drop-zone" data-section="238" data-text="325">02 / What is the processing blueprint behind the leather weight?</span>
                        <i class="fa-solid fa-plus faq-icon-state"></i>
                    </button>
                    <div class="faq-content">
                        <div class="faq-content-inner editable-text editable-section no-drop-zone" data-section="239" data-text="326">
                            We preserve the organic high-density thickness of natural selection full-grain hides. No surface mechanical sanding, buffing, or heavy synthetic coating takes place. The raw texture and natural variations are intentional features.
                        </div>
                    </div>
                </div>

                <div class="faq-row editable-section no-drop-zone" data-section="240">
                    <button class="faq-trigger" onclick="handleAccordion(this)">
                        <span class="editable-text editable-section no-drop-zone" data-section="241" data-text="327">03 / How do custom allocation queuing pipelines run?</span>
                        <i class="fa-solid fa-plus faq-icon-state"></i>
                    </button>
                    <div class="faq-content">
                        <div class="faq-content-inner editable-text editable-section no-drop-zone" data-section="242" data-text="328">
                            Production is limited strictly to synchronized micro-batches to eliminate industrial waste pipelines. Once a batch matrix hits maximum capacity limits, production loops cycle offline for roughly 45 to 60 days.
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="contact-section section-padding editable-section" id="coordinates" data-section="243">
        <div class="container contact-layout">
            <div class="contact-card editable-section no-drop-zone" data-section="244">
                <h3 class="contact-card-header editable-text editable-section no-drop-zone" data-section="245" data-text="329">// Operational Nodes</h3>
                <div class="contact-node">
                    <i class="fa-solid fa-network-wired"></i>
                    <h4 class="editable-text editable-section no-drop-zone" data-section="246" data-text="330">Primary Production Outpost</h4>
                    <p class="editable-text editable-section no-drop-zone" data-section="247" data-text="331">82 Rue du Faubourg Saint-Honoré<br>75008 Paris, France</p>
                </div>
                <div class="contact-node">
                    <i class="fa-solid fa-terminal"></i>
                    <h4 class="editable-text editable-section no-drop-zone" data-section="248" data-text="332">Secure Node Terminal</h4>
                    <p class="editable-text editable-section no-drop-zone" data-section="249" data-text="333">protocols@ateliervrede.io</p>
                </div>
            </div>
            <form class="contact-form-wrapper no-drop-zone editable-text editable-section" data-section="608" onsubmit="event.preventDefault(); alert('Inquiry pipeline open. Our terminal desk will transmit responses within 120 minutes.'); this.reset();">
                <div class="input-row">
                    <label class="editable-text editable-section no-drop-zone" data-section="250" data-text="334">Inquirer Identifier Key</label>
                    <input type="text" class="field-input editable-text" data-text="335" placeholder="e.g. Eleanor Vance" required>
                </div>
                <div class="input-row">
                    <label class="editable-text editable-section no-drop-zone" data-section="251" data-text="336">Transmission Return Address</label>
                    <input type="email" class="field-input editable-text" data-text="337" placeholder="evance@monolith.io" required>
                </div>
                <div class="input-row">
                    <label class="editable-text editable-section no-drop-zone" data-section="252" data-text="338">Structural Customization Specifications Matrix</label>
                    <textarea class="field-input editable-text" data-text="339" rows="5" placeholder="Define dimensional configurations, component plating requests, shipment coordinates..." required></textarea>
                </div>
                <button type="submit" class="form-send editable-text editable-section no-drop-zone" data-section="253" data-text="340">Transmit Registry Request</button>
            </form>
        </div>
    </section>

    <div class="modal-mask" id="details-modal">
        <div class="modal-wrapper">
            <button class="modal-dismiss" id="dismiss-modal" title="Abort Layout"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-split" id="modal-injector-target"></div>
        </div>
    </div>

    <!-- Review Form Modal -->
    <div class="review-form-modal" id="review-modal">
        <div class="review-form-container">
            <h3 class="editable-text editable-section no-drop-zone" data-section="254" data-text="341">Write a Review</h3>
            <form id="review-submit-form">
                <div class="review-form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="255" data-text="342">Your Name</label>
                    <input type="text" id="reviewer-name" class="editable-text" data-text="343" required>
                </div>
                <div class="review-form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="256" data-text="344">Rating</label>
                    <div class="rating-select" id="rating-select">
                        <span class="rating-star-select" data-rating="1">★</span>
                        <span class="rating-star-select" data-rating="2">★</span>
                        <span class="rating-star-select" data-rating="3">★</span>
                        <span class="rating-star-select" data-rating="4">★</span>
                        <span class="rating-star-select" data-rating="5">★</span>
                    </div>
                    <input type="hidden" id="review-rating" value="0">
                </div>
                <div class="review-form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="257" data-text="345">Review Title</label>
                    <input type="text" id="review-title" class="editable-text" data-text="346" required>
                </div>
                <div class="review-form-group">
                    <label class="editable-text editable-section no-drop-zone" data-section="258" data-text="347">Your Review</label>
                    <textarea id="review-comment" rows="4" class="editable-text" data-text="348" required></textarea>
                </div>
                <button type="submit" class="submit-review-modal editable-text editable-section no-drop-zone" data-section="259" data-text="349">Submit Review</button>
                <button type="button" class="submit-review-modal" style="background:transparent; color:var(--background); margin-top:8px;" onclick="closeReviewModal()">Cancel</button>
            </form>
        </div>
    </div>

    <footer class="editable-section" data-section="260">
        <div class="container">
            <div class="footer-content">
                <div class="footer-column editable-section no-drop-zone" data-section="261">
                    <h4 class="editable-text editable-section no-drop-zone" data-section="262" data-text="350">About Vrede</h4>
                    <p class="editable-text editable-section no-drop-zone" data-section="263" data-text="351">Avant-garde carry systems engineered for extreme structural performance and raw architectural aesthetics.</p>
                </div>
                <div class="footer-column editable-section no-drop-zone" data-section="264">
                    <h4 class="editable-text editable-section no-drop-zone" data-section="265" data-text="352">Policies</h4>
                    <a href="?page=return-policy" class="editable-text editable-section no-drop-zone" data-section="266" data-text="353">Return Policy</a>
                    <a href="?page=terms" class="editable-text editable-section no-drop-zone" data-section="267" data-text="354">Terms & Conditions</a>
                    <a href="?page=shipping" class="editable-text editable-section no-drop-zone" data-section="268" data-text="355">Shipping Policy</a>
                    <a href="?page=privacy" class="editable-text editable-section no-drop-zone" data-section="269" data-text="356">Privacy Policy</a>
                </div>
                <div class="footer-column editable-section no-drop-zone" data-section="270">
                    <h4 class="editable-text editable-section no-drop-zone" data-section="271" data-text="357">Support</h4>
                    <a href="#coordinates" class="editable-text editable-section no-drop-zone" data-section="272" data-text="358">Contact Us</a>
                    <a href="#intel" class="editable-text editable-section no-drop-zone" data-section="273" data-text="359">FAQ</a>
                    <a href="#" class="editable-text editable-section no-drop-zone" data-section="274" data-text="360">Size Guide</a>
                </div>
                <div class="footer-column editable-section no-drop-zone" data-section="275">
                    <h4 class="editable-text editable-section no-drop-zone" data-section="276" data-text="361">Connect</h4>
                    <div class="social-links">
                        <a href="#" class="editable-icon" data-icon="102"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="editable-icon" data-icon="103"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="editable-icon" data-icon="104"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="editable-icon" data-icon="105"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>
            <div class="copyright">
                <p class="editable-text editable-section no-drop-zone" data-section="277" data-text="362">&copy; 2026 <span>ATELIER VREDE SYSTEM LOGS</span>. Asymmetric Heavy Cargo Logistics. Terminal Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // PRODUCT INVENTORY DATA
        const bagInventory = [
            {
                id: 101, name: "V1 Monolith Cargo Base", price: 460.00,
                desc: "Severe structural tote module engineered with solid multi-layer perimeter walls and raw vulcanized leather wear pads.",
                specs: { "Volume Metric": "38cm x 30cm x 15cm", "Hardware Core": "Milled Black Oxide Steel Brackets", "Hide Rating": "Ultra-Thick Box Calfskin" },
                variants: [
                    { color: "Obsidian Slate Pitch", img: "https://images.pexels.com/photos/904350/pexels-photo-904350.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ],
                reviews: [
                    { name: "Marcus V.", rating: 5, title: "Absolute Tank", comment: "Most rugged bag I've owned.", date: "2024-02-15" },
                    { name: "Sarah K.", rating: 4, title: "Solid Construction", comment: "Very impressed with the hardware quality.", date: "2024-01-20" }
                ]
            },
            {
                id: 102, name: "V2 Asymmetric Crescent", price: 340.00,
                desc: "Heavy-line ergonomic body bag using raw internal support inserts and variable position shoulder track rigs.",
                specs: { "Volume Metric": "25cm x 19cm x 8cm", "Hardware Core": "Raw Tooled Silver Toggles", "Hide Rating": "High-Density Aniline Shell" },
                variants: [
                    { color: "Industrial Chalk Sand", img: "https://images.pexels.com/photos/1152077/pexels-photo-1152077.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ],
                reviews: [
                    { name: "Alex P.", rating: 5, title: "Perfect Daily Carry", comment: "Sits perfectly on the shoulder.", date: "2024-02-10" }
                ]
            },
            {
                id: 103, name: "V3 Geometric Hauler", price: 410.00,
                desc: "Angular open-format structural haul deck designed to withstand deep compression while maintaining vertical geometry profiles.",
                specs: { "Volume Metric": "34cm x 36cm x 13cm", "Hardware Core": "Anodized Dark Charcoal Anchors", "Hide Rating": "Pebbled Mineral Tannage" },
                variants: [
                    { color: "Deep Muted Umber Smoke", img: "https://images.pexels.com/photos/3731256/pexels-photo-3731256.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ],
                reviews: []
            },
            {
                id: 104, name: "V4 Micro Utility Lock", price: 220.00,
                desc: "High-rigidity compact hard pouch featuring custom armor plate latches and completely detachable modular steel carry wire loops.",
                specs: { "Volume Metric": "20cm x 13cm x 5cm", "Hardware Core": "Hard-Tempered Mechanical Latch", "Hide Rating": "Saffiano Scratch Defeating Skin" },
                variants: [
                    { color: "Raw Oxide Tan Matrix", img: "https://images.pexels.com/photos/1930030/pexels-photo-1930030.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ],
                reviews: []
            }
        ];

        let shoppingBag = [];
        let wishlistBag = [];
        let couponPercentage = 0.0;
        let currentProductId = null;

        const shopItemsTarget = document.getElementById('shop-items-target');
        const detailsModal = document.getElementById('details-modal');
        const modalInjectorTarget = document.getElementById('modal-injector-target');
        const dismissModal = document.getElementById('dismiss-modal');
        const panelMask = document.getElementById('panel-mask');
        const stickyCartTracker = document.getElementById('sticky-cart-tracker');
        const accountTrigger = document.getElementById('account-trigger');
        const accountMenu = document.getElementById('account-menu');

        // --- ACCOUNT DROPDOWN ---
        if (accountTrigger) {
            accountTrigger.addEventListener('click', () => {
                accountMenu.classList.toggle('active');
            });
            
            document.addEventListener('click', (e) => {
                if (!accountTrigger.contains(e.target) && !accountMenu.contains(e.target)) {
                    accountMenu.classList.remove('active');
                }
            });
        }

        // --- INVENTORY BINDINGS LAYOUT ---
        function generateCatalogLayout() {
            shopItemsTarget.innerHTML = bagInventory.map(bag => `
                <div class="item-card">
                    <div class="item-display" onclick="triggerProductModal(${bag.id})">
                        <img src="${bag.variants[0].img}" alt="${bag.name}" class="item-img">
                        <div class="item-overlay-actions">
                            <button class="action-square" onclick="event.stopPropagation(); addToWishlistPipeline(${bag.id})" title="Archive Profile"><i class="fa-regular fa-heart"></i></button>
                            <button class="action-square" onclick="event.stopPropagation(); instantaneousCartAdd(${bag.id})" title="Deploy System Add"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-meta">
                        <div>
                            <div class="item-title" onclick="triggerProductModal(${bag.id})">${bag.name}</div>
                            <div class="item-tagline">${bag.variants[0].color}</div>
                        </div>
                        <div class="item-price">$${bag.price.toFixed(2)}</div>
                    </div>
                </div>
            `).join('');
        }

        // --- REVIEW SECTION RENDERING ---
        function renderReviewsInModal(productId) {
            const product = bagInventory.find(p => p.id === productId);
            if (!product) return '';
            
            const avgRating = product.reviews.length > 0 
                ? (product.reviews.reduce((sum, r) => sum + r.rating, 0) / product.reviews.length).toFixed(1)
                : 0;
            
            const reviewStars = (rating) => {
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    stars += i <= rating ? '★' : '☆';
                }
                return stars;
            };
            
            const reviewListHtml = product.reviews.map(review => `
                <div class="review-card-item">
                    <div class="review-card-header">
                        <span class="reviewer-name">${review.name}</span>
                        <span class="review-date">${review.date}</span>
                    </div>
                    <div class="review-stars-small">${reviewStars(review.rating)}</div>
                    <div class="review-text"><strong>${review.title}</strong><br>${review.comment}</div>
                </div>
            `).join('');
            
            return `
                <div class="review-section">
                    <div class="review-title">CUSTOMER FEEDBACK</div>
                    <div class="review-stats">
                        <span class="avg-rating">${avgRating}</span>
                        <div class="review-stars">${reviewStars(Math.round(avgRating))}</div>
                        <span class="review-count">(${product.reviews.length} reviews)</span>
                    </div>
                    <div class="review-list" id="review-list-container">
                        ${reviewListHtml || '<div class="review-card-item">No reviews yet. Be the first to review this product.</div>'}
                    </div>
                    <button class="write-review-btn" onclick="openReviewModal(${productId})">WRITE A REVIEW</button>
                </div>
            `;
        }

        // --- OPEN REVIEW MODAL ---
        function openReviewModal(productId) {
            currentProductId = productId;
            document.getElementById('review-modal').classList.add('active');
            document.getElementById('reviewer-name').value = '';
            document.getElementById('review-title').value = '';
            document.getElementById('review-comment').value = '';
            document.getElementById('review-rating').value = 0;
            
            // Reset star rating highlight
            document.querySelectorAll('.rating-star-select').forEach(star => {
                star.classList.remove('active');
            });
        }

        function closeReviewModal() {
            document.getElementById('review-modal').classList.remove('active');
        }

        // Submit review
        function submitReview(event) {
            event.preventDefault();
            const product = bagInventory.find(p => p.id === currentProductId);
            if (!product) return;
            
            const name = document.getElementById('reviewer-name').value;
            const rating = parseInt(document.getElementById('review-rating').value);
            const title = document.getElementById('review-title').value;
            const comment = document.getElementById('review-comment').value;
            
            if (rating === 0) {
                alert('Please select a rating');
                return;
            }
            
            const newReview = {
                name: name,
                rating: rating,
                title: title,
                comment: comment,
                date: new Date().toISOString().split('T')[0]
            };
            
            product.reviews.push(newReview);
            
            // Refresh the modal view
            const currentModalProduct = bagInventory.find(p => p.id === currentProductId);
            if (currentModalProduct) {
                const reviewSectionHtml = renderReviewsInModal(currentProductId);
                const reviewSectionElement = document.querySelector('#modal-injector-target .review-section');
                if (reviewSectionElement) {
                    reviewSectionElement.outerHTML = reviewSectionHtml;
                } else {
                    // Append to modal meta box
                    const metaBox = document.querySelector('#modal-injector-target .modal-meta-box');
                    if (metaBox) {
                        metaBox.insertAdjacentHTML('beforeend', reviewSectionHtml);
                    }
                }
            }
            
            closeReviewModal();
            alert('Review submitted successfully!');
        }

        // Star rating selection in modal
        function setupStarRating() {
            document.querySelectorAll('.rating-star-select').forEach(star => {
                star.addEventListener('click', function() {
                    const rating = parseInt(this.getAttribute('data-rating'));
                    document.getElementById('review-rating').value = rating;
                    document.querySelectorAll('.rating-star-select').forEach(s => {
                        if (parseInt(s.getAttribute('data-rating')) <= rating) {
                            s.classList.add('active');
                        } else {
                            s.classList.remove('active');
                        }
                    });
                });
            });
        }

        // --- DRAWER LAYOUT STATE SWITCHES ---
        function toggleSidebar(panelType, setOpen) {
            if (setOpen) {
                panelMask.classList.add('active');
                document.getElementById(`${panelType}-sidebar`).classList.add('active');
                document.body.style.overflow = 'hidden';
            } else {
                panelMask.classList.remove('active');
                document.getElementById('cart-sidebar').classList.remove('active');
                document.getElementById('wishlist-sidebar').classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        document.getElementById('trigger-cart').addEventListener('click', () => toggleSidebar('cart', true));
        document.getElementById('trigger-wishlist').addEventListener('click', () => toggleSidebar('wishlist', true));
        panelMask.addEventListener('click', () => toggleSidebar('', false));

        // --- MANIFEST INVOICING ARCHITECTURE ---
        function refreshBagUI() {
            const container = document.getElementById('cart-node-target');
            const totalQtyCount = shoppingBag.reduce((sum, item) => sum + item.qty, 0);
            
            document.getElementById('cart-indicator').innerText = totalQtyCount;
            document.getElementById('wishlist-indicator').innerText = wishlistBag.length;

            if (totalQtyCount > 0) {
                document.getElementById('sticky-items-label').innerText = totalQtyCount === 1 ? "1 Module" : `${totalQtyCount} Modules`;
                stickyCartTracker.classList.add('active');
            } else {
                stickyCartTracker.classList.remove('active');
            }

            if (shoppingBag.length === 0) {
                container.innerHTML = `<div class="panel-empty">Allocation Queue is Clear.</div>`;
                recalcCartFinancials();
                return;
            }

            container.innerHTML = shoppingBag.map((item, index) => `
                <div class="brutal-item-card">
                    <img src="${item.img}" class="panel-item-img">
                    <div class="panel-item-info">
                        <div class="panel-item-title">${item.title}</div>
                        <div class="panel-item-variant">Units: ${item.qty}</div>
                        <div class="panel-item-price">$${(item.basePrice * item.qty).toFixed(2)}</div>
                    </div>
                    <button class="panel-item-remove" onclick="ejectBagItem(${index})"><i class="fa-solid fa-trash-can"></i></button>
                </div>
            `).join('');
            recalcCartFinancials();
        }

        function refreshWishlistUI() {
            const node = document.getElementById('wishlist-node-target');
            document.getElementById('wishlist-indicator').innerText = wishlistBag.length;

            if (wishlistBag.length === 0) {
                node.innerHTML = `<div class="panel-empty">No objects saved to active archives.</div>`;
                return;
            }

            node.innerHTML = wishlistBag.map((item, idx) => `
                <div class="brutal-item-card">
                    <img src="${item.img}" class="panel-item-img">
                    <div class="panel-item-info">
                        <div class="panel-item-title">${item.name}</div>
                        <div class="panel-item-price">$${item.price.toFixed(2)}</div>
                    </div>
                    <button class="panel-item-remove" onclick="ejectWishItem(${idx})"><i class="fa-solid fa-xmark"></i></button>
                </div>
            `).join('');
        }

        function recalcCartFinancials() {
            let subtotal = shoppingBag.reduce((sum, item) => sum + (item.basePrice * item.qty), 0);
            let deduction = subtotal * couponPercentage;
            let finalTotal = subtotal - deduction;

            document.getElementById('bill-subtotal').innerText = `$${subtotal.toFixed(2)}`;
            if (couponPercentage > 0) {
                document.getElementById('bill-discount-row').style.display = 'flex';
                document.getElementById('bill-discount').innerText = `-$${deduction.toFixed(2)}`;
            } else {
                document.getElementById('bill-discount-row').style.display = 'none';
            }
            
            const formattedTotal = `$${finalTotal.toFixed(2)}`;
            document.getElementById('bill-total').innerText = formattedTotal;
            document.getElementById('sticky-total-label').innerText = formattedTotal;
        }

        function pushToBagDataArray(title, basePrice, img, color, qty) {
            const indexMatch = shoppingBag.findIndex(i => i.title === title && i.color === color);
            if (indexMatch > -1) {
                shoppingBag[indexMatch].qty += qty;
            } else {
                shoppingBag.push({ title, basePrice, img, color, qty });
            }
            refreshBagUI();
        }

        function instantaneousCartAdd(id) {
            const product = bagInventory.find(p => p.id === id);
            pushToBagDataArray(product.name, product.price, product.variants[0].img, product.variants[0].color, 1);
            toggleSidebar('cart', true);
        }

        function ejectBagItem(index) {
            shoppingBag.splice(index, 1);
            refreshBagUI();
        }

        function ejectWishItem(index) {
            wishlistBag.splice(index, 1);
            refreshWishlistUI();
        }

        function applyPromo() {
            const field = document.getElementById('coupon-field').value.trim();
            const alertNode = document.getElementById('coupon-alert');

            if (field === 'ATELIER10') {
                couponPercentage = 0.10;
                alertNode.className = "promo-feedback valid";
                alertNode.innerText = "Access Token Cleared. System Discount Applied.";
            } else {
                couponPercentage = 0.0;
                alertNode.className = "promo-feedback invalid";
                alertNode.innerText = "Invalid System Authentication Token.";
            }
            recalcCartFinancials();
        }

        function executeCheckout() {
            if(shoppingBag.length === 0) {
                alert("Cannot clear empty operational terminal pipelines.");
                return;
            }
            alert("Rerouting metrics to localized clearance terminal channels...");
        }

        function addToWishlistPipeline(id) {
            const product = bagInventory.find(p => p.id === id);
            if (!wishlistBag.some(item => item.id === id)) {
                wishlistBag.push({ id: product.id, name: product.name, price: product.price, img: product.variants[0].img });
                refreshWishlistUI();
            }
            toggleSidebar('wishlist', true);
        }

        // --- OVERLAY INTERFACE INTERACTIVITY LOGICS ---
        window.triggerProductModal = function(id) {
            const product = bagInventory.find(p => p.id === id);
            if (!product) return;

            let rowInjections = Object.entries(product.specs).map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('');
            let swatchInjections = product.variants.map((v, i) => `<div class="swatch-node ${i===0?'active':''}" data-img="${v.img}" data-color="${v.color}" onclick="swapModalVariant(this)"><img src="${v.img}"></div>`).join('');
            const reviewSectionHtml = renderReviewsInModal(id);

            modalInjectorTarget.innerHTML = `
                <div class="modal-viewport">
                    <img src="${product.variants[0].img}" id="modal-primary-view-node">
                </div>
                <div class="modal-meta-box">
                    <h2>${product.name}</h2>
                    <div class="modal-price-tag">$${product.price.toFixed(2)}</div>
                    <p class="modal-summary">${product.desc}</p>
                    <table class="spec-grid">${rowInjections}</table>
                    
                    <div class="selector-header">Color Profile Mask:</div>
                    <div class="swatch-row">${swatchInjections}</div>
                    
                    <div class="selector-header">Allocation Scale:</div>
                    <div class="qty-controls">
                        <button class="qty-action" onclick="alterModalQty(-1)">-</button>
                        <input type="text" class="qty-view" id="modal-qty-input" value="1" readonly>
                        <button class="qty-action" onclick="alterModalQty(1)">+</button>
                    </div>

                    <div class="modal-footer-btns">
                        <button class="btn-cart-add" onclick="commitModalAddToBag('${product.name}', ${product.price}, false)">Push To Manifest</button>
                        <button class="btn-buy-now" onclick="commitModalAddToBag('${product.name}', ${product.price}, true)">Buy Now (Fast Clearance)</button>
                        <button class="btn-wish-add" onclick="addToWishlistPipeline(${product.id})"><i class="fa-regular fa-heart"></i></button>
                    </div>
                    ${reviewSectionHtml}
                </div>
            `;
            detailsModal.classList.add('active');
            document.body.style.overflow = 'hidden';
            setupStarRating();
        }

        function shutdownProductModal() {
            detailsModal.classList.remove('active');
            if(!panelMask.classList.contains('active')) document.body.style.overflow = 'auto';
        }
        dismissModal.addEventListener('click', shutdownProductModal);
        detailsModal.addEventListener('click', (e) => { if(e.target === detailsModal) shutdownProductModal(); });

        window.swapModalVariant = function(el) {
            document.querySelectorAll('.swatch-node').forEach(n => n.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('modal-primary-view-node').src = el.getAttribute('data-img');
        }

        window.alterModalQty = function(val) {
            const el = document.getElementById('modal-qty-input');
            let result = parseInt(el.value) + val;
            el.value = result < 1 ? 1 : result;
        }

        window.commitModalAddToBag = function(name, basePrice, instantCheckoutTrigger) {
            const img = document.getElementById('modal-primary-view-node').src;
            const color = document.querySelector('.swatch-node.active').getAttribute('data-color');
            const qty = parseInt(document.getElementById('modal-qty-input').value);

            pushToBagDataArray(name, basePrice, img, color, qty);
            shutdownProductModal();
            
            if (instantCheckoutTrigger) {
                executeCheckout();
            } else {
                toggleSidebar('cart', true);
            }
        }

        // --- LOG COMPONENT ACCORDION SWITCH ---
        window.handleAccordion = function(element) {
            element.parentElement.classList.toggle('active');
            const icon = element.querySelector('.faq-icon-state');
            if (element.parentElement.classList.contains('active')) {
                icon.className = "fa-solid fa-minus faq-icon-state";
            } else {
                icon.className = "fa-solid fa-plus faq-icon-state";
            }
        }

        // Attach review form submission
        document.getElementById('review-submit-form').addEventListener('submit', submitReview);

        // INITIALIZE
        generateCatalogLayout();
        refreshBagUI();
        refreshWishlistUI();
    </script>
</body>
</html>