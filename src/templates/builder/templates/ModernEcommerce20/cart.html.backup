<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - LuxePaws Premium Pet Essentials</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-warm: #b87a3f;
            --secondary-warm: #c8a477;
            --terracotta: #b56422;
            --sand: #d8bca4;
            --neutral-rich: #5c544c;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fefaf5;
            color: var(--neutral-rich);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header.editable-section[data-section="71"] {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1.cart-title.editable-text.editable-section.no-drop-zone[data-section="72"] {
            font-size: 3.5rem;
            color: var(--neutral-rich);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1.cart-title.editable-text.editable-section.no-drop-zone[data-section="72"]::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-warm), var(--terracotta));
        }

        /* Cart Content Layout */
        .cart-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Cart Items Section */
        .cart-items.editable-section.no-drop-zone[data-section="73"] {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(92, 84, 76, 0.05);
            padding: var(--spacing-md);
        }

        .cart-items-header {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(92, 84, 76, 0.1);
            font-weight: 500;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-md);
        }

        .cart-item {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            align-items: center;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid rgba(92, 84, 76, 0.05);
            transition: var(--transition);
        }

        .cart-item:hover {
            background: rgba(216, 188, 164, 0.2);
        }

        /* Product Info in Cart */
        .cart-product-info {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }

        .cart-product-image {
            width: 100px;
            height: 100px;
            border-radius: calc(var(--border-radius) - 2px);
            background-size: cover;
            background-position: center;
            flex-shrink: 0;
        }

        .cart-product-details {
            flex: 1;
        }

        .cart-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            color: var(--neutral-rich);
            margin-bottom: 0.3rem;
            font-weight: 600;
        }

        .cart-product-category {
            color: var(--terracotta);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.3rem;
        }

        .cart-product-variant {
            font-size: 0.8rem;
            color: rgba(92, 84, 76, 0.7);
        }

        /* Quantity Controls */
        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .quantity-btn {
            width: 32px;
            height: 32px;
            background: white;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.1rem;
            color: var(--neutral-rich);
        }

        .quantity-btn:hover {
            background: var(--sand);
            border-color: var(--primary-warm);
            color: var(--terracotta);
        }

        .quantity-input {
            width: 50px;
            height: 32px;
            text-align: center;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: 4px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
        }

        .quantity-input:focus {
            outline: none;
            border-color: var(--primary-warm);
        }

        /* Price Display */
        .cart-product-price {
            font-size: 1.1rem;
            color: var(--primary-warm);
            font-weight: 500;
        }

        .item-total {
            font-size: 1.1rem;
            color: var(--terracotta);
            font-weight: 600;
        }

        /* Remove Button */
        .remove-btn {
            background: none;
            border: none;
            color: rgba(92, 84, 76, 0.5);
            cursor: pointer;
            font-size: 1.2rem;
            transition: var(--transition);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
        }

        .remove-btn:hover {
            color: var(--terracotta);
            background: rgba(181, 100, 34, 0.1);
        }

        /* Cart Summary */
        .cart-summary.editable-section.no-drop-zone[data-section="78"] {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(92, 84, 76, 0.05);
            padding: var(--spacing-md);
            height: fit-content;
            position: sticky;
            top: 120px;
        }

        .cart-summary h2.editable-text.editable-section.no-drop-zone[data-section="79"] {
            font-size: 1.8rem;
            margin-bottom: var(--spacing-md);
            color: var(--neutral-rich);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(92, 84, 76, 0.1);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            color: var(--neutral-rich);
        }

        .summary-row.total {
            font-size: 1.3rem;
            font-weight: 500;
            color: var(--terracotta);
            margin-top: var(--spacing-sm);
            padding-top: var(--spacing-sm);
            border-top: 1px solid rgba(92, 84, 76, 0.1);
        }

        /* Promo Code */
        .promo-code {
            margin: var(--spacing-md) 0;
        }

        .promo-code h3 {
            font-size: 1.1rem;
            margin-bottom: 0.8rem;
            color: var(--neutral-rich);
        }

        .promo-input-group {
            display: flex;
            gap: 0.5rem;
        }

        .promo-input {
            flex: 1;
            padding: 0.8rem 1rem;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: var(--border-radius);
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
        }

        .promo-input:focus {
            outline: none;
            border-color: var(--primary-warm);
        }

        .apply-promo-btn.editable-text.editable-section.no-drop-zone[data-section="80"] {
            background: var(--primary-warm);
            color: white;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: var(--border-radius);
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.95rem;
        }

        .apply-promo-btn.editable-text.editable-section.no-drop-zone[data-section="80"]:hover {
            background: var(--terracotta);
            transform: translateY(-2px);
        }

        /* Checkout Button */
        .checkout-btn.editable-text.editable-section.no-drop-zone[data-section="81"] {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: white;
            padding: 1.2rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: none;
            cursor: pointer;
            transition: var(--transition);
            margin-top: var(--spacing-md);
            text-align: center;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .checkout-btn.editable-text.editable-section.no-drop-zone[data-section="81"]:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(92, 84, 76, 0.3);
        }

        /* Continue Shopping */
        .continue-shopping {
            text-align: center;
            margin-top: var(--spacing-sm);
        }

        .continue-shopping a {
            color: var(--primary-warm);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .continue-shopping a:hover {
            text-decoration: underline;
        }

        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            grid-column: 1 / -1;
        }

        .empty-cart-icon {
            font-size: 4rem;
            color: var(--primary-warm);
            margin-bottom: var(--spacing-md);
        }

        .empty-cart h2 {
            font-size: 2.2rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .empty-cart p {
            color: var(--neutral-rich);
            opacity: 0.8;
            margin-bottom: var(--spacing-md);
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-now-btn.editable-text.editable-section.no-drop-zone[data-section="82"] {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: white;
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

        .shop-now-btn.editable-text.editable-section.no-drop-zone[data-section="82"]:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(181, 100, 34, 0.3);
        }

        /* You May Also Like Section */
        .you-may-also-like.editable-section[data-section="83"] {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(92, 84, 76, 0.1);
        }

        .you-may-also-like h2.editable-text.editable-section.no-drop-zone[data-section="84"] {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .recommended-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .recommended-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .recommended-product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .recommended-product-img {
            height: 250px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .recommended-product-card:hover .recommended-product-img {
            transform: scale(1.05);
        }

        .recommended-product-info {
            padding: 1.5rem;
        }

        .recommended-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            color: var(--neutral-rich);
            margin-bottom: 0.5rem;
        }

        .recommended-product-price {
            color: var(--primary-warm);
            font-weight: 500;
            margin-bottom: 1rem;
        }

        .add-to-cart-small {
            width: 100%;
            background: var(--sand);
            color: var(--terracotta);
            padding: 0.7rem;
            font-size: 0.9rem;
            font-weight: 300;
            border-radius: var(--border-radius);
            border: 1px solid var(--primary-warm);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-to-cart-small:hover {
            background: var(--primary-warm);
            color: white;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .recommended-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            h1.cart-title.editable-text.editable-section.no-drop-zone[data-section="72"] {
                font-size: 3.2rem;
            }
        }

        @media (max-width: 992px) {
            .cart-content {
                grid-template-columns: 1fr;
            }
            .cart-summary {
                position: static;
                order: -1;
            }
            .recommended-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .cart-items-header {
                display: none;
            }
            .cart-item {
                grid-template-columns: 1fr;
                gap: var(--spacing-sm);
                padding: var(--spacing-md) 0;
                position: relative;
            }
            .cart-product-price {
                position: absolute;
                top: var(--spacing-md);
                right: 0;
            }
            .remove-btn {
                position: absolute;
                bottom: var(--spacing-md);
                right: 0;
            }
            .quantity-controls {
                justify-content: flex-start;
            }
        }

        @media (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            h1.cart-title.editable-text.editable-section.no-drop-zone[data-section="72"] {
                font-size: 2.5rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .cart-items, .cart-summary {
                padding: var(--spacing-sm);
            }
            .cart-product-image {
                width: 80px;
                height: 80px;
            }
            .recommended-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .you-may-also-like h2.editable-text.editable-section.no-drop-zone[data-section="84"] {
                font-size: 2rem;
            }
        }

        @media (max-width: 576px) {
            h1.cart-title.editable-text.editable-section.no-drop-zone[data-section="72"] {
                font-size: 2.2rem;
            }
            .promo-input-group {
                flex-direction: column;
            }
            .apply-promo-btn.editable-text.editable-section.no-drop-zone[data-section="80"],
            .checkout-btn.editable-text.editable-section.no-drop-zone[data-section="81"],
            .shop-now-btn.editable-text.editable-section.no-drop-zone[data-section="82"] {
                padding: 0.8rem 1.5rem;
                font-size: 1rem;
            }
            .empty-cart h2 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>

    <!-- Page Header -->
    <div class="page-header editable-section" data-section="71">
        <div class="container">
            <h1 class="cart-title editable-text editable-section no-drop-zone" data-section="72" data-text="48">Your Shopping Cart</h1>
        </div>
    </div>

    <!-- Cart Content -->
    <div class="container">
        <div class="cart-content">
            <!-- Cart Items -->
            <div class="cart-items editable-section no-drop-zone" data-section="73">
                <div class="cart-items-header">
                    <div>Product</div>
                    <div>Price</div>
                    <div>Quantity</div>
                    <div>Total</div>
                    <div></div>
                </div>

                <!-- Cart Item 1 (Editable) -->
                <div class="cart-item" data-cart-item-id="1" data-product-id="1">
                    <div class="cart-product-info">
                        <div class="cart-product-image" style="background-image: url('https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=200')"></div>
                        <div class="cart-product-details">
                            <div class="cart-product-name editable-text editable-section no-drop-zone" data-section="75" data-text="49">Heritage Velvet Dog Bed</div>
                            <div class="cart-product-category editable-text editable-section no-drop-zone" data-section="76" data-text="50">BEDS</div>
                            <div class="cart-product-variant">Color: Brown | Size: Large</div>
                        </div>
                    </div>
                    <div class="cart-product-price" data-price="229">$229</div>
                    <div class="quantity-controls">
                        <button class="quantity-btn minus" data-action="decrement" data-product-id="1">-</button>
                        <input type="number" class="quantity-input" value="1" min="1" max="10" data-product-id="1">
                        <button class="quantity-btn plus" data-action="increment" data-product-id="1">+</button>
                    </div>
                    <div class="item-total" data-product-id="1">$229</div>
                    <button class="remove-btn" data-action="remove" data-product-id="1">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <!-- Cart Item 2 (Sample - non-editable) -->
                <div class="cart-item" data-cart-item-id="2" data-product-id="2">
                    <div class="cart-product-info">
                        <div class="cart-product-image" style="background-image: url('https://images.pexels.com/photos/6963939/pexels-photo-6963939.jpeg?auto=compress&cs=tinysrgb&w=200')"></div>
                        <div class="cart-product-details">
                            <div class="cart-product-name">Silk Feather Wand Toy</div>
                            <div class="cart-product-category">TOYS</div>
                            <div class="cart-product-variant">Color: Pink | Size: One Size</div>
                        </div>
                    </div>
                    <div class="cart-product-price" data-price="48">$48</div>
                    <div class="quantity-controls">
                        <button class="quantity-btn minus" data-action="decrement" data-product-id="2">-</button>
                        <input type="number" class="quantity-input" value="2" min="1" max="10" data-product-id="2">
                        <button class="quantity-btn plus" data-action="increment" data-product-id="2">+</button>
                    </div>
                    <div class="item-total" data-product-id="2">$96</div>
                    <button class="remove-btn" data-action="remove" data-product-id="2">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <!-- Cart Item 3 (Sample - non-editable) -->
                <div class="cart-item" data-cart-item-id="3" data-product-id="3">
                    <div class="cart-product-info">
                        <div class="cart-product-image" style="background-image: url('https://images.pexels.com/photos/5967508/pexels-photo-5967508.jpeg?auto=compress&cs=tinysrgb&w=200')"></div>
                        <div class="cart-product-details">
                            <div class="cart-product-name">Artisan Stoneware Bowl</div>
                            <div class="cart-product-category">BOWLS</div>
                            <div class="cart-product-variant">Color: Cream | Size: Medium</div>
                        </div>
                    </div>
                    <div class="cart-product-price" data-price="68">$68</div>
                    <div class="quantity-controls">
                        <button class="quantity-btn minus" data-action="decrement" data-product-id="3">-</button>
                        <input type="number" class="quantity-input" value="1" min="1" max="10" data-product-id="3">
                        <button class="quantity-btn plus" data-action="increment" data-product-id="3">+</button>
                    </div>
                    <div class="item-total" data-product-id="3">$68</div>
                    <button class="remove-btn" data-action="remove" data-product-id="3">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Cart Summary -->
            <div class="cart-summary editable-section no-drop-zone" data-section="78">
                <h2 class="editable-text editable-section no-drop-zone" data-section="79" data-text="51">Order Summary</h2>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="cart-subtotal">$393</span>
                </div>
                <div class="summary-row">
                    <span>Shipping</span>
                    <span id="cart-shipping">FREE</span>
                </div>
                <div class="summary-row">
                    <span>Tax</span>
                    <span id="cart-tax">$31.44</span>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <span id="cart-total">$424.44</span>
                </div>

                <!-- Promo Code -->
                <div class="promo-code">
                    <h3>Promo Code</h3>
                    <div class="promo-input-group">
                        <input type="text" class="promo-input" placeholder="Enter code" id="promo-code-input">
                        <button class="apply-promo-btn editable-text editable-section no-drop-zone" data-section="80" data-text="52">Apply</button>
                    </div>
                </div>

                <!-- Checkout Button -->
                <button class="checkout-btn editable-text editable-section no-drop-zone" data-section="81" data-text="53" onclick="proceedToCheckout()">
                    <i class="fas fa-lock"></i> Proceed to Checkout
                </button>

                <!-- Continue Shopping -->
                <div class="continue-shopping">
                    <a href="?page=shop">
                        <i class="fas fa-arrow-left"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>

        <!-- You May Also Like Section -->
        <div class="you-may-also-like editable-section" data-section="83">
            <h2 class="editable-text editable-section no-drop-zone" data-section="84" data-text="54">You May Also Like</h2>
            <div class="recommended-grid">
                <div class="recommended-product-card" data-product-id="4">
                    <div class="recommended-product-img" style="background-image: url('https://images.pexels.com/photos/4060140/pexels-photo-4060140.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recommended-product-info">
                        <div class="recommended-product-name">SpaEase Grooming Kit</div>
                        <div class="recommended-product-price">$145</div>
                        <button class="add-to-cart-small" data-product-id="4">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                    </div>
                </div>
                <div class="recommended-product-card" data-product-id="5">
                    <div class="recommended-product-img" style="background-image: url('https://images.pexels.com/photos/1121378/pexels-photo-1121378.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recommended-product-info">
                        <div class="recommended-product-name">Modern Cat Tree Tower</div>
                        <div class="recommended-product-price">$189</div>
                        <button class="add-to-cart-small" data-product-id="5">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                    </div>
                </div>
                <div class="recommended-product-card" data-product-id="6">
                    <div class="recommended-product-img" style="background-image: url('https://images.pexels.com/photos/4090461/pexels-photo-4090461.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recommended-product-info">
                        <div class="recommended-product-name">Organic Gourmet Treats</div>
                        <div class="recommended-product-price">$32</div>
                        <button class="add-to-cart-small" data-product-id="6">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                    </div>
                </div>
                <div class="recommended-product-card" data-product-id="7">
                    <div class="recommended-product-img" style="background-image: url('https://images.pexels.com/photos/38238/maltezer-dog-puppy-cute-38238.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recommended-product-info">
                        <div class="recommended-product-name">Italian Leather Collar</div>
                        <div class="recommended-product-price">$79</div>
                        <button class="add-to-cart-small" data-product-id="7">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Cart Data
        let cartData = {
            items: [],
            subtotal: 0,
            shipping_amount: 0,
            tax_amount: 0,
            total_amount: 0,
            promo_code: null,
            discount_amount: 0
        };

        // Initialize Cart Data
        function initializeCartData() {
            const cartItems = document.querySelectorAll('.cart-item');
            cartData.items = [];
            cartData.subtotal = 0;

            cartItems.forEach(item => {
                const productId = item.getAttribute('data-product-id');
                const price = parseFloat(item.querySelector('.cart-product-price').getAttribute('data-price'));
                const quantity = parseInt(item.querySelector('.quantity-input').value);
                const itemTotal = price * quantity;

                cartData.items.push({
                    id: productId,
                    title: item.querySelector('.cart-product-name').textContent,
                    price: price,
                    quantity: quantity,
                    total_price: itemTotal
                });
                cartData.subtotal += itemTotal;
            });

            // Calculate shipping (free if over $100)
            cartData.shipping_amount = cartData.subtotal > 100 ? 0 : 5.00;
            // Calculate tax (8%)
            cartData.tax_amount = cartData.subtotal * 0.08;
            // Calculate total
            cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;

            updateCartSummary();
        }

        // Update Cart Summary Display
        function updateCartSummary() {
            document.getElementById('cart-subtotal').textContent = '$' + cartData.subtotal.toFixed(2);
            document.getElementById('cart-shipping').textContent = cartData.shipping_amount === 0 ? 'FREE' : '$' + cartData.shipping_amount.toFixed(2);
            document.getElementById('cart-tax').textContent = '$' + cartData.tax_amount.toFixed(2);
            document.getElementById('cart-total').textContent = '$' + cartData.total_amount.toFixed(2);
        }

        // Update Individual Item Total
        function updateItemTotal(productId) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return;
            const price = parseFloat(itemElement.querySelector('.cart-product-price').getAttribute('data-price'));
            const quantity = parseInt(itemElement.querySelector('.quantity-input').value);
            const itemTotal = price * quantity;
            const itemTotalElement = itemElement.querySelector('.item-total');
            if (itemTotalElement) {
                itemTotalElement.textContent = '$' + itemTotal.toFixed(2);
            }
        }

        // Quantity Control Handlers
        document.addEventListener('DOMContentLoaded', function() {
            initializeCartData();

            // Quantity button events
            document.querySelectorAll('.quantity-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const action = this.getAttribute('data-action');
                    const productId = this.getAttribute('data-product-id');
                    const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                    if (!input) return;

                    let currentValue = parseInt(input.value);
                    if (action === 'increment' && currentValue < 10) {
                        input.value = currentValue + 1;
                    } else if (action === 'decrement' && currentValue > 1) {
                        input.value = currentValue - 1;
                    }
                    updateItemTotal(productId);
                    initializeCartData();
                });
            });

            // Quantity input change events
            document.querySelectorAll('.quantity-input').forEach(input => {
                input.addEventListener('change', function() {
                    const productId = this.getAttribute('data-product-id');
                    let value = parseInt(this.value);
                    if (value < 1) {
                        value = 1;
                        this.value = 1;
                    } else if (value > 10) {
                        value = 10;
                        this.value = 10;
                    }
                    updateItemTotal(productId);
                    initializeCartData();
                });
            });

            // Remove button events
            document.querySelectorAll('.remove-btn[data-action="remove"]').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    const cartItem = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                    if (cartItem) {
                        cartItem.remove();
                        initializeCartData();
                    }
                });
            });

            // Add to cart from recommended products
            document.querySelectorAll('.add-to-cart-small').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const productId = this.getAttribute('data-product-id');
                    alert('Item added to cart!');
                });
            });

            // Promo code application
            document.querySelector('.apply-promo-btn')?.addEventListener('click', applyPromoCode);
            document.querySelector('.promo-input')?.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    applyPromoCode();
                }
            });
        });

        // Apply Promo Code
        function applyPromoCode() {
            const promoInput = document.querySelector('.promo-input');
            const promoCode = promoInput ? promoInput.value.trim() : '';

            if (!promoCode) {
                alert('Please enter a promo code');
                return;
            }

            const validPromoCodes = {
                'LUXE10': 0.10,
                'PAWS15': 0.15,
                'FREESHIP': 'free_shipping'
            };

            if (validPromoCodes[promoCode]) {
                const discount = validPromoCodes[promoCode];
                if (discount === 'free_shipping') {
                    cartData.shipping_amount = 0;
                    cartData.promo_code = promoCode;
                    cartData.discount_amount = 0;
                    alert('Free shipping applied!');
                } else {
                    cartData.discount_amount = cartData.subtotal * discount;
                    cartData.promo_code = promoCode;
                    alert(`Promo code applied! ${discount * 100}% discount added.`);
                }
                cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;
                updateCartSummary();
            } else {
                alert('Invalid promo code');
            }
        }

        // Proceed to Checkout
        function proceedToCheckout() {
            if (cartData.items.length === 0) {
                alert('Your cart is empty. Please add items before checkout.');
                return;
            }
            alert('Proceeding to checkout!');
            console.log('Cart Data:', cartData);
        }
    </script>
</body>
</html>