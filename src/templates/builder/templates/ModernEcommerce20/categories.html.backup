<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - LuxePaws Premium Pet Essentials</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-warm: #b87a3f;
            --secondary-warm: #c8a477;
            --terracotta: #b56422;
            --sand: #d8bca4;
            --neutral-rich: #5c544c;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fefaf5;
            color: var(--neutral-rich);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header.editable-section[data-section="99"] {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1.categories-title.editable-text.editable-section.no-drop-zone[data-section="100"] {
            font-size: 3.5rem;
            color: var(--neutral-rich);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1.categories-title.editable-text.editable-section.no-drop-zone[data-section="100"]::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 140px;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-warm), var(--terracotta));
        }

        .categories-subtitle.editable-text.editable-section.no-drop-zone[data-section="101"] {
            color: var(--neutral-rich);
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 2rem;
            opacity: 0.8;
        }

        /* Categories Filter */
        .categories-filter {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 0.8rem 1.8rem;
            background: white;
            border: 1px solid rgba(92, 84, 76, 0.1);
            border-radius: var(--border-radius);
            color: var(--neutral-rich);
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-btn:hover {
            border-color: var(--primary-warm);
            color: var(--primary-warm);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: white;
            border-color: transparent;
        }

        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2.5rem;
            margin-bottom: var(--spacing-xl);
        }

        .category-card.editable-section.no-drop-zone[data-section="103"] {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            position: relative;
        }

        .category-card.editable-section.no-drop-zone[data-section="103"]:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .category-image-container {
            height: 300px;
            width: 100%;
            position: relative;
            overflow: hidden;
        }

        .category-image {
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .category-card.editable-section.no-drop-zone[data-section="103"]:hover .category-image {
            transform: scale(1.1);
        }

        .category-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(92, 84, 76, 0.7), transparent 50%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: var(--spacing-md);
            color: white;
        }

        .category-name.editable-text.editable-section.no-drop-zone[data-section="104"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            color: white;
            margin-bottom: 0.5rem;
        }

        .category-count.editable-text.editable-section.no-drop-zone[data-section="105"] {
            color: var(--sand);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .category-info {
            padding: 1.5rem;
            text-align: center;
        }

        .category-description.editable-text.editable-section.no-drop-zone[data-section="106"] {
            color: var(--neutral-rich);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            opacity: 0.8;
        }

        .btn-explore-category.editable-text.editable-section.no-drop-zone[data-section="107"] {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: white;
            padding: 0.8rem 1.8rem;
            font-size: 0.95rem;
            font-weight: 300;
            letter-spacing: 0.5px;
            text-decoration: none;
            border-radius: var(--border-radius);
            transition: var(--transition);
            border: none;
            cursor: pointer;
        }

        .btn-explore-category.editable-text.editable-section.no-drop-zone[data-section="107"]:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(181, 100, 34, 0.3);
        }

        /* Featured Collections */
        .featured-collections.editable-section[data-section="108"] {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(92, 84, 76, 0.1);
        }

        .featured-collections h2.editable-text.editable-section.no-drop-zone[data-section="109"] {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .collections-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2.5rem;
            margin-bottom: var(--spacing-lg);
        }

        .collection-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            position: relative;
        }

        .collection-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .collection-image {
            height: 250px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .collection-card:hover .collection-image {
            transform: scale(1.05);
        }

        .collection-info {
            padding: 1.5rem;
            text-align: center;
        }

        .collection-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            color: var(--neutral-rich);
            margin-bottom: 0.5rem;
        }

        .collection-description {
            color: var(--neutral-rich);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 1rem;
            opacity: 0.8;
        }

        .btn-view-collection {
            display: inline-block;
            background: transparent;
            color: var(--primary-warm);
            padding: 0.7rem 1.5rem;
            font-size: 0.9rem;
            font-weight: 300;
            border-radius: var(--border-radius);
            border: 1px solid var(--primary-warm);
            text-decoration: none;
            transition: var(--transition);
        }

        .btn-view-collection:hover {
            background: var(--primary-warm);
            color: white;
        }

        /* Pet Care Guide */
        .pet-care-guide.editable-section[data-section="110"] {
            margin-top: var(--spacing-xl);
            padding: var(--spacing-lg);
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(92, 84, 76, 0.05);
        }

        .pet-care-guide h2.editable-text.editable-section.no-drop-zone[data-section="111"] {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .guide-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }

        .guide-item {
            text-align: center;
            padding: 1.5rem;
        }

        .guide-icon {
            font-size: 2.5rem;
            color: var(--primary-warm);
            margin-bottom: 1rem;
        }

        .guide-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--neutral-rich);
            margin-bottom: 0.8rem;
        }

        .guide-description {
            color: var(--neutral-rich);
            font-size: 0.95rem;
            line-height: 1.6;
            opacity: 0.8;
        }

        /* Empty State */
        .empty-categories {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            grid-column: 1 / -1;
        }

        .empty-categories-icon {
            font-size: 4rem;
            color: var(--sand);
            margin-bottom: var(--spacing-md);
        }

        .empty-categories h2 {
            font-size: 2.2rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .empty-categories p {
            color: var(--neutral-rich);
            opacity: 0.8;
            margin-bottom: var(--spacing-md);
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .btn-add-category {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: white;
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

        .btn-add-category:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(181, 100, 34, 0.3);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .collections-grid, .guide-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1.categories-title.editable-text.editable-section.no-drop-zone[data-section="100"] {
                font-size: 3.2rem;
            }
        }

        @media (max-width: 992px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1.categories-title.editable-text.editable-section.no-drop-zone[data-section="100"] {
                font-size: 2.8rem;
            }
            .categories-filter {
                gap: 0.8rem;
            }
            .filter-btn {
                padding: 0.7rem 1.5rem;
                font-size: 0.95rem;
            }
        }

        @media (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            .categories-grid,
            .collections-grid,
            .guide-grid {
                grid-template-columns: 1fr;
                max-width: 500px;
                margin-left: auto;
                margin-right: auto;
            }
            h1.categories-title.editable-text.editable-section.no-drop-zone[data-section="100"] {
                font-size: 2.5rem;
            }
            .categories-subtitle.editable-text.editable-section.no-drop-zone[data-section="101"] {
                font-size: 1.1rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .category-image-container {
                height: 250px;
            }
            .featured-collections h2.editable-text.editable-section.no-drop-zone[data-section="109"],
            .pet-care-guide h2.editable-text.editable-section.no-drop-zone[data-section="111"] {
                font-size: 2rem;
            }
            .pet-care-guide {
                padding: var(--spacing-md);
            }
        }

        @media (max-width: 576px) {
            h1.categories-title.editable-text.editable-section.no-drop-zone[data-section="100"] {
                font-size: 2.2rem;
            }
            .categories-subtitle.editable-text.editable-section.no-drop-zone[data-section="101"] {
                font-size: 1rem;
            }
            .categories-filter {
                flex-direction: column;
                align-items: stretch;
            }
            .filter-btn {
                width: 100%;
                text-align: center;
            }
            .btn-explore-category,
            .btn-view-collection,
            .btn-add-category {
                padding: 0.8rem 1.5rem;
                font-size: 1rem;
            }
            .empty-categories h2 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>

    <!-- Page Header -->
    <div class="page-header editable-section" data-section="99">
        <div class="container">
            <h1 class="categories-title editable-text editable-section no-drop-zone" data-section="100" data-text="107">Pet Collections</h1>
            <p class="categories-subtitle editable-text editable-section no-drop-zone" data-section="101" data-text="108">Explore our curated collections of premium pet essentials, each crafted with exceptional attention to detail and timeless elegance.</p>

            <!-- Categories Filter -->
            <div class="categories-filter">
                <button class="filter-btn active" data-filter="all">All Categories</button>
                <button class="filter-btn" data-filter="beds">Beds & Furniture</button>
                <button class="filter-btn" data-filter="toys">Toys & Entertainment</button>
                <button class="filter-btn" data-filter="grooming">Grooming & Care</button>
                <button class="filter-btn" data-filter="bowls">Bowls & Feeders</button>
                <button class="filter-btn" data-filter="accessories">Accessories</button>
            </div>
        </div>
    </div>

    <!-- Categories Grid -->
    <div class="container">
        <div class="categories-grid" id="section-102">
            <!-- Category 1 (Editable) -->
            <div class="category-card editable-section no-drop-zone" data-section="103" data-category="beds">
                <div class="category-image-container">
                    <div class="category-image editable-image" data-image="27" style="background-image: url('https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                    <div class="category-overlay">
                        <h3 class="category-name editable-text editable-section no-drop-zone" data-section="104" data-text="109">Luxury Beds</h3>
                        <div class="category-count editable-text editable-section no-drop-zone" data-section="105" data-text="110">12 Products</div>
                    </div>
                </div>
                <div class="category-info">
                    <p class="category-description editable-text editable-section no-drop-zone" data-section="106" data-text="111">Premium orthopedic beds designed for ultimate comfort and support. Each bed features memory foam, luxurious fabrics, and elegant designs.</p>
                    <a href="?page=shop&category=beds" class="btn-explore-category editable-text editable-section no-drop-zone" data-section="107" data-text="112">Explore Collection</a>
                </div>
            </div>

            <!-- Category 2 (Sample) -->
            <div class="category-card" data-category="toys">
                <div class="category-image-container">
                    <div class="category-image" style="background-image: url('https://images.pexels.com/photos/6963939/pexels-photo-6963939.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                    <div class="category-overlay">
                        <h3 class="category-name">Interactive Toys</h3>
                        <div class="category-count">18 Products</div>
                    </div>
                </div>
                <div class="category-info">
                    <p class="category-description">Engaging toys designed to stimulate your pet's mind and encourage active play. Durable, safe, and endlessly entertaining.</p>
                    <a href="?page=shop&category=toys" class="btn-explore-category">Explore Collection</a>
                </div>
            </div>

            <!-- Category 3 (Sample) -->
            <div class="category-card" data-category="grooming">
                <div class="category-image-container">
                    <div class="category-image" style="background-image: url('https://images.pexels.com/photos/4060140/pexels-photo-4060140.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                    <div class="category-overlay">
                        <h3 class="category-name">Grooming Essentials</h3>
                        <div class="category-count">8 Products</div>
                    </div>
                </div>
                <div class="category-info">
                    <p class="category-description">Professional-grade grooming tools for a spa-like experience at home. Keep your pet looking and feeling their best.</p>
                    <a href="?page=shop&category=grooming" class="btn-explore-category">Explore Collection</a>
                </div>
            </div>

            <!-- Category 4 (Sample) -->
            <div class="category-card" data-category="bowls">
                <div class="category-image-container">
                    <div class="category-image" style="background-image: url('https://images.pexels.com/photos/5967508/pexels-photo-5967508.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                    <div class="category-overlay">
                        <h3 class="category-name">Artisan Bowls</h3>
                        <div class="category-count">6 Products</div>
                    </div>
                </div>
                <div class="category-info">
                    <p class="category-description">Handcrafted ceramic and stoneware bowls that combine functionality with elegant design. Elevated and slow-feed options available.</p>
                    <a href="?page=shop&category=bowls" class="btn-explore-category">Explore Collection</a>
                </div>
            </div>

            <!-- Category 5 (Sample) -->
            <div class="category-card" data-category="accessories">
                <div class="category-image-container">
                    <div class="category-image" style="background-image: url('https://images.pexels.com/photos/38238/maltezer-dog-puppy-cute-38238.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                    <div class="category-overlay">
                        <h3 class="category-name">Designer Accessories</h3>
                        <div class="category-count">15 Products</div>
                    </div>
                </div>
                <div class="category-info">
                    <p class="category-description">Luxury collars, leashes, and wearables crafted from premium materials. Make a statement with every walk.</p>
                    <a href="?page=shop&category=accessories" class="btn-explore-category">Explore Collection</a>
                </div>
            </div>

            <!-- Category 6 (Sample) -->
            <div class="category-card" data-category="treats">
                <div class="category-image-container">
                    <div class="category-image" style="background-image: url('https://images.pexels.com/photos/4090461/pexels-photo-4090461.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                    <div class="category-overlay">
                        <h3 class="category-name">Gourmet Treats</h3>
                        <div class="category-count">10 Products</div>
                    </div>
                </div>
                <div class="category-info">
                    <p class="category-description">All-natural, organic treats made with premium ingredients. Healthy and delicious rewards for your beloved companion.</p>
                    <a href="?page=shop&category=treats" class="btn-explore-category">Explore Collection</a>
                </div>
            </div>
        </div>

        <!-- Featured Collections -->
        <div class="featured-collections editable-section" data-section="108">
            <h2 class="editable-text editable-section no-drop-zone" data-section="109" data-text="113">Featured Collections</h2>
            <div class="collections-grid">
                <div class="collection-card">
                    <div class="collection-image" style="background-image: url('https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="collection-info">
                        <div class="collection-name">Heritage Collection</div>
                        <p class="collection-description">Timeless designs inspired by classic elegance, crafted for discerning pet owners who appreciate quality.</p>
                        <a href="?page=shop&collection=heritage" class="btn-view-collection">View Collection</a>
                    </div>
                </div>
                <div class="collection-card">
                    <div class="collection-image" style="background-image: url('https://images.pexels.com/photos/1121378/pexels-photo-1121378.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="collection-info">
                        <div class="collection-name">Modern Minimalist</div>
                        <p class="collection-description">Clean lines and contemporary aesthetics for the modern home. Sleek, functional, and effortlessly stylish.</p>
                        <a href="?page=shop&collection=modern" class="btn-view-collection">View Collection</a>
                    </div>
                </div>
                <div class="collection-card">
                    <div class="collection-image" style="background-image: url('https://images.pexels.com/photos/4060140/pexels-photo-4060140.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="collection-info">
                        <div class="collection-name">Spa Series</div>
                        <p class="collection-description">Premium grooming and wellness products that transform daily care into a luxurious ritual.</p>
                        <a href="?page=shop&collection=spa" class="btn-view-collection">View Collection</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pet Care Guide -->
        <div class="pet-care-guide editable-section" data-section="110">
            <h2 class="editable-text editable-section no-drop-zone" data-section="111" data-text="114">Pet Care Guide</h2>
            <div class="guide-grid">
                <div class="guide-item">
                    <div class="guide-icon">
                        <i class="fas fa-ruler-combined editable-icon" data-icon="23" data-default-class="fas fa-ruler-combined"></i>
                    </div>
                    <h3 class="guide-title">Sizing Guide</h3>
                    <p class="guide-description">Learn how to measure your pet for the perfect fit. Find the right bed size, collar length, and more with our detailed guide.</p>
                </div>
                <div class="guide-item">
                    <div class="guide-icon">
                        <i class="fas fa-heartbeat editable-icon" data-icon="24" data-default-class="fas fa-heartbeat"></i>
                    </div>
                    <h3 class="guide-title">Wellness Tips</h3>
                    <p class="guide-description">Expert advice on nutrition, exercise, and overall wellness to keep your furry friend healthy and happy.</p>
                </div>
                <div class="guide-item">
                    <div class="guide-icon">
                        <i class="fas fa-brush editable-icon" data-icon="25" data-default-class="fas fa-brush"></i>
                    </div>
                    <h3 class="guide-title">Grooming Care</h3>
                    <p class="guide-description">Professional tips for maintaining your pet's coat, nails, and overall hygiene between professional grooming sessions.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Categories Filtering
        const filterButtons = document.querySelectorAll('.filter-btn');
        const categoryCards = document.querySelectorAll('.category-card');

        if (filterButtons.length > 0 && categoryCards.length > 0) {
            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    const filterValue = this.getAttribute('data-filter');
                    filterCategories(filterValue);
                });
            });
        }

        function filterCategories(filterValue) {
            categoryCards.forEach(card => {
                const category = card.getAttribute('data-category');
                if (filterValue === 'all' || category === filterValue) {
                    card.style.display = 'block';
                    setTimeout(() => {
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    }, 50);
                } else {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(20px)';
                    setTimeout(() => {
                        card.style.display = 'none';
                    }, 300);
                }
            });
        }

        // Category card click handlers
        categoryCards.forEach(card => {
            card.addEventListener('click', function(e) {
                if (e.target.tagName === 'A' || e.target.tagName === 'BUTTON' ||
                    e.target.closest('a') || e.target.closest('button')) {
                    return;
                }
                const categoryName = this.querySelector('.category-name').textContent;
                console.log(`Browsing ${categoryName} collection`);
            });
        });

        // Initialize filter
        filterCategories('all');
    </script>
</body>
</html>