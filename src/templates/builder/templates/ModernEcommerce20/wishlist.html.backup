<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist - LuxePaws Premium Pet Essentials</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-warm: #b87a3f;
            --secondary-warm: #c8a477;
            --terracotta: #b56422;
            --sand: #d8bca4;
            --neutral-rich: #5c544c;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fefaf5;
            color: var(--neutral-rich);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header.editable-section[data-section="85"] {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1.wishlist-title.editable-text.editable-section.no-drop-zone[data-section="86"] {
            font-size: 3.5rem;
            color: var(--neutral-rich);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1.wishlist-title.editable-text.editable-section.no-drop-zone[data-section="86"]::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-warm), var(--terracotta));
        }

        .wishlist-subtitle.editable-text.editable-section.no-drop-zone[data-section="87"] {
            color: var(--neutral-rich);
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 2rem;
            opacity: 0.8;
        }

        /* Wishlist Stats */
        .wishlist-stats.editable-section[data-section="157"] {
            padding: 30px 0;
            background-color: #fefaf5;
            border-bottom: 1px solid rgba(92, 84, 76, 0.2);
        }

        .stats-container {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
        }

        .stat-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .stat-value.editable-text.editable-section.no-drop-zone[data-section="158"] {
            font-size: 32px;
            color: var(--primary-warm);
            font-weight: 500;
            font-family: 'Cormorant Garamond', serif;
        }

        .stat-label.editable-text.editable-section.no-drop-zone[data-section="159"] {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--neutral-rich);
            opacity: 0.8;
        }

        /* Wishlist Content */
        .wishlist-content.editable-section[data-section="166"] {
            padding: 60px 0 120px;
        }

        .wishlist-container {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        /* Wishlist Actions */
        .wishlist-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .wishlist-filters {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 10px 20px;
            background-color: transparent;
            color: var(--neutral-rich);
            font-size: 14px;
            border: 1px solid var(--sand);
            border-radius: var(--border-radius);
            transition: var(--transition);
            cursor: pointer;
        }

        .filter-btn:hover {
            border-color: var(--primary-warm);
            color: var(--primary-warm);
        }

        .filter-btn.active {
            background-color: var(--primary-warm);
            color: white;
            border-color: var(--primary-warm);
        }

        .btn-clear-wishlist.editable-text.editable-section.no-drop-zone[data-section="171"] {
            padding: 10px 20px;
            background-color: transparent;
            color: var(--neutral-rich);
            font-size: 14px;
            border: 1px solid var(--sand);
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-clear-wishlist.editable-text.editable-section.no-drop-zone[data-section="171"]:hover {
            border-color: var(--terracotta);
            color: var(--terracotta);
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .wishlist-item.editable-section.no-drop-zone[data-section="89"] {
            background-color: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            border: 1px solid rgba(216, 188, 164, 0.2);
            position: relative;
        }

        .wishlist-item.editable-section.no-drop-zone[data-section="89"]:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .wishlist-item-image {
            width: 100%;
            height: 280px;
            background-size: cover;
            background-position: center;
            background-color: var(--sand);
        }

        .wishlist-item-info {
            padding: 20px;
        }

        .wishlist-item-category.editable-section.no-drop-zone[data-section="90"] {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-warm);
            margin-bottom: 8px;
            font-weight: 400;
        }

        .wishlist-item-name.editable-section.no-drop-zone[data-section="91"] {
            font-size: 18px;
            font-family: 'Cormorant Garamond', serif;
            color: var(--neutral-rich);
            margin-bottom: 10px;
            font-weight: 500;
            line-height: 1.3;
        }

        .wishlist-item-price.editable-section.no-drop-zone[data-section="92"] {
            font-size: 20px;
            color: var(--primary-warm);
            font-weight: 500;
            margin-bottom: 15px;
        }

        .wishlist-item-actions-bottom {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .btn-add-to-cart-wishlist.editable-text.editable-section.no-drop-zone[data-section="93"] {
            flex: 1;
            padding: 10px 15px;
            background-color: var(--primary-warm);
            color: white;
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            transition: var(--transition);
            border: none;
        }

        .btn-add-to-cart-wishlist.editable-text.editable-section.no-drop-zone[data-section="93"]:hover {
            background-color: var(--terracotta);
        }

        .btn-remove-wishlist {
            width: 40px;
            height: 40px;
            background-color: white;
            border: 1px solid var(--sand);
            color: var(--neutral-rich);
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-remove-wishlist:hover {
            border-color: var(--terracotta);
            color: var(--terracotta);
        }

        /* Empty Wishlist State */
        .empty-wishlist {
            text-align: center;
            padding: 80px 20px;
            background-color: white;
            border-radius: var(--border-radius);
            border: 1px solid rgba(216, 188, 164, 0.2);
            margin-top: 30px;
            grid-column: 1 / -1;
        }

        .empty-wishlist-icon {
            font-size: 64px;
            color: var(--sand);
            margin-bottom: 25px;
        }

        .empty-wishlist-title.editable-text.editable-section.no-drop-zone[data-section="176"] {
            font-size: 28px;
            color: var(--neutral-rich);
            margin-bottom: 15px;
            font-weight: 500;
        }

        .empty-wishlist-message.editable-text.editable-section.no-drop-zone[data-section="177"] {
            font-size: 16px;
            color: var(--neutral-rich);
            opacity: 0.8;
            margin-bottom: 30px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .btn-start-shopping.editable-text.editable-section.no-drop-zone[data-section="178"] {
            display: inline-block;
            padding: 14px 30px;
            background-color: var(--primary-warm);
            color: white;
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: var(--border-radius);
            text-decoration: none;
            transition: var(--transition);
        }

        .btn-start-shopping.editable-text.editable-section.no-drop-zone[data-section="178"]:hover {
            background-color: var(--terracotta);
            transform: translateY(-3px);
        }

        /* Recently Viewed Section */
        .recently-viewed.editable-section[data-section="179"] {
            padding: 60px 0;
            background-color: rgba(216, 188, 164, 0.05);
            border-top: 1px solid rgba(92, 84, 76, 0.1);
            margin-top: 40px;
        }

        .section-title.editable-text.editable-section.no-drop-zone[data-section="180"] {
            font-size: 32px;
            margin-bottom: 40px;
            color: var(--neutral-rich);
            font-weight: 500;
            text-align: center;
        }

        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .recent-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .recent-product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .recent-product-img {
            height: 220px;
            width: 100%;
            background-size: cover;
            background-position: center;
            background-color: var(--sand);
            transition: transform 0.5s ease;
        }

        .recent-product-card:hover .recent-product-img {
            transform: scale(1.05);
        }

        .recent-product-info {
            padding: 20px;
        }

        .recent-product-name {
            font-size: 16px;
            margin-bottom: 8px;
            font-weight: 500;
            font-family: 'Cormorant Garamond', serif;
            color: var(--neutral-rich);
        }

        .recent-product-price {
            font-size: 18px;
            font-weight: 500;
            color: var(--primary-warm);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            h1.wishlist-title.editable-text.editable-section.no-drop-zone[data-section="86"] {
                font-size: 3.2rem;
            }
        }

        @media (max-width: 992px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1.wishlist-title.editable-text.editable-section.no-drop-zone[data-section="86"] {
                font-size: 2.8rem;
            }
            .wishlist-actions {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            h1.wishlist-title.editable-text.editable-section.no-drop-zone[data-section="86"] {
                font-size: 2.5rem;
            }
            .wishlist-subtitle.editable-text.editable-section.no-drop-zone[data-section="87"] {
                font-size: 1.1rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .stats-container {
                gap: 20px;
            }
            .stat-item {
                min-width: 100px;
            }
            .section-title.editable-text.editable-section.no-drop-zone[data-section="180"] {
                font-size: 28px;
            }
        }

        @media (max-width: 576px) {
            h1.wishlist-title.editable-text.editable-section.no-drop-zone[data-section="86"] {
                font-size: 2.2rem;
            }
            .wishlist-subtitle.editable-text.editable-section.no-drop-zone[data-section="87"] {
                font-size: 1rem;
            }
            .btn-add-to-cart-wishlist.editable-text.editable-section.no-drop-zone[data-section="93"],
            .btn-start-shopping.editable-text.editable-section.no-drop-zone[data-section="178"] {
                padding: 0.8rem 1.5rem;
                font-size: 1rem;
            }
            .empty-wishlist-title.editable-text.editable-section.no-drop-zone[data-section="176"] {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>

    <!-- Page Header -->
    <div class="page-header editable-section" data-section="85">
        <div class="container">
            <h1 class="wishlist-title editable-text editable-section no-drop-zone" data-section="86" data-text="92">Your Wishlist</h1>
            <p class="wishlist-subtitle editable-text editable-section no-drop-zone" data-section="87" data-text="93">Save your favorite pet essentials for later. Your wishlist is always here when you're ready to make them yours.</p>
        </div>
    </div>

    <!-- Wishlist Stats -->
    <div class="wishlist-stats editable-section" data-section="157">
        <div class="container">
            <div class="stats-container">
                <div class="stat-item">
                    <span class="stat-value editable-text editable-section no-drop-zone" data-section="158" data-text="94">3</span>
                    <span class="stat-label editable-text editable-section no-drop-zone" data-section="159" data-text="95">Items Saved</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value editable-text editable-section no-drop-zone" data-section="160" data-text="96">2</span>
                    <span class="stat-label editable-text editable-section no-drop-zone" data-section="161" data-text="97">On Sale</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value editable-text editable-section no-drop-zone" data-section="162" data-text="98">$345</span>
                    <span class="stat-label editable-text editable-section no-drop-zone" data-section="163" data-text="99">Total Value</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value editable-text editable-section no-drop-zone" data-section="164" data-text="100">1</span>
                    <span class="stat-label editable-text editable-section no-drop-zone" data-section="165" data-text="101">Low in Stock</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Wishlist Content -->
    <div class="wishlist-content editable-section" data-section="166">
        <div class="container">
            <div class="wishlist-container">
                <!-- Wishlist Actions -->
                <div class="wishlist-actions">
                    <div class="wishlist-filters">
                        <button class="filter-btn active" data-filter="all">All Items</button>
                        <button class="filter-btn" data-filter="on-sale">On Sale</button>
                        <button class="filter-btn" data-filter="in-stock">In Stock</button>
                        <button class="filter-btn" data-filter="new-arrivals">New Arrivals</button>
                    </div>
                    <button class="btn-clear-wishlist editable-text editable-section no-drop-zone" data-section="171" data-text="102">
                        <i class="far fa-trash-alt"></i> Clear All
                    </button>
                </div>

                <!-- Wishlist Grid -->
                <div class="wishlist-grid">
                    <!-- Wishlist Item 1 (Editable) -->
                    <div class="wishlist-item editable-section no-drop-zone" data-section="89" data-category="beds" data-status="in-stock">
                        <div class="wishlist-item-image editable-image" data-image="21" style="background-image: url('https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                        <div class="wishlist-item-info">
                            <div class="wishlist-item-category editable-section no-drop-zone" data-section="90" data-text="103">BEDS</div>
                            <div class="wishlist-item-name editable-section no-drop-zone" data-section="91" data-text="104">Heritage Velvet Dog Bed</div>
                            <div class="wishlist-item-price editable-section no-drop-zone" data-section="92" data-text="105">$229</div>
                            <div class="wishlist-item-actions-bottom">
                                <button class="btn-add-to-cart-wishlist editable-text editable-section no-drop-zone" data-section="93" data-text="106">
                                    <i class="fas fa-shopping-bag"></i> Add to Cart
                                </button>
                                <button class="btn-remove-wishlist" data-product-id="1">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Wishlist Item 2 (Sample) -->
                    <div class="wishlist-item" data-category="toys" data-status="low-stock">
                        <div class="wishlist-item-image" style="background-image: url('https://images.pexels.com/photos/6963939/pexels-photo-6963939.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                        <div class="wishlist-item-info">
                            <div class="wishlist-item-category">TOYS</div>
                            <div class="wishlist-item-name">Silk Feather Wand Toy</div>
                            <div class="wishlist-item-price">$48</div>
                            <div class="wishlist-item-actions-bottom">
                                <button class="btn-add-to-cart-wishlist">
                                    <i class="fas fa-shopping-bag"></i> Add to Cart
                                </button>
                                <button class="btn-remove-wishlist" data-product-id="2">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Wishlist Item 3 (Sample) -->
                    <div class="wishlist-item" data-category="grooming" data-status="in-stock">
                        <div class="wishlist-item-image" style="background-image: url('https://images.pexels.com/photos/4060140/pexels-photo-4060140.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                        <div class="wishlist-item-info">
                            <div class="wishlist-item-category">GROOMING</div>
                            <div class="wishlist-item-name">SpaEase Grooming Kit</div>
                            <div class="wishlist-item-price">$145</div>
                            <div class="wishlist-item-actions-bottom">
                                <button class="btn-add-to-cart-wishlist">
                                    <i class="fas fa-shopping-bag"></i> Add to Cart
                                </button>
                                <button class="btn-remove-wishlist" data-product-id="3">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Wishlist Item 4 (Sample) -->
                    <div class="wishlist-item" data-category="bowls" data-status="on-sale">
                        <div class="wishlist-item-image" style="background-image: url('https://images.pexels.com/photos/5967508/pexels-photo-5967508.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                        <div class="wishlist-item-info">
                            <div class="wishlist-item-category">BOWLS</div>
                            <div class="wishlist-item-name">Artisan Stoneware Bowl</div>
                            <div class="wishlist-item-price">$68</div>
                            <div class="wishlist-item-actions-bottom">
                                <button class="btn-add-to-cart-wishlist">
                                    <i class="fas fa-shopping-bag"></i> Add to Cart
                                </button>
                                <button class="btn-remove-wishlist" data-product-id="4">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recently Viewed Section -->
    <div class="recently-viewed editable-section" data-section="179">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="180" data-text="107">Recently Viewed</h2>
            <div class="recently-viewed-grid">
                <div class="recent-product-card">
                    <div class="recent-product-img" style="background-image: url('https://images.pexels.com/photos/1121378/pexels-photo-1121378.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recent-product-info">
                        <div class="recent-product-name">Modern Cat Tree Tower</div>
                        <div class="recent-product-price">$189</div>
                    </div>
                </div>
                <div class="recent-product-card">
                    <div class="recent-product-img" style="background-image: url('https://images.pexels.com/photos/4090461/pexels-photo-4090461.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recent-product-info">
                        <div class="recent-product-name">Organic Gourmet Treats</div>
                        <div class="recent-product-price">$32</div>
                    </div>
                </div>
                <div class="recent-product-card">
                    <div class="recent-product-img" style="background-image: url('https://images.pexels.com/photos/38238/maltezer-dog-puppy-cute-38238.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recent-product-info">
                        <div class="recent-product-name">Italian Leather Collar</div>
                        <div class="recent-product-price">$79</div>
                    </div>
                </div>
                <div class="recent-product-card">
                    <div class="recent-product-img" style="background-image: url('https://images.pexels.com/photos/4537254/pexels-photo-4537254.jpeg?auto=compress&cs=tinysrgb&w=500')"></div>
                    <div class="recent-product-info">
                        <div class="recent-product-name">Smart Self-Cleaning Litter Box</div>
                        <div class="recent-product-price">$399</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Wishlist Management Functions
        let currentFilter = 'all';

        // Filter buttons
        document.querySelectorAll('.filter-btn').forEach(button => {
            button.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
                this.classList.add('active');
                currentFilter = this.getAttribute('data-filter');
                filterWishlistItems();
            });
        });

        function filterWishlistItems() {
            const wishlistItems = document.querySelectorAll('.wishlist-item');
            let visibleCount = 0;

            wishlistItems.forEach(item => {
                const category = item.getAttribute('data-category') || '';
                const status = item.getAttribute('data-status') || '';
                let shouldShow = true;

                switch(currentFilter) {
                    case 'on-sale':
                        shouldShow = status === 'on-sale';
                        break;
                    case 'in-stock':
                        shouldShow = status === 'in-stock' || status === 'low-stock';
                        break;
                    case 'new-arrivals':
                        shouldShow = item.classList.contains('new-arrival');
                        break;
                    case 'all':
                    default:
                        shouldShow = true;
                        break;
                }

                if (shouldShow) {
                    item.style.display = 'block';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Remove item from wishlist
        document.querySelectorAll('.btn-remove-wishlist').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const wishlistItem = this.closest('.wishlist-item');
                const itemName = wishlistItem.querySelector('.wishlist-item-name').textContent;
                if (confirm(`Remove "${itemName}" from your wishlist?`)) {
                    wishlistItem.remove();
                    updateWishlistStats();
                }
            });
        });

        // Clear all items
        document.querySelector('.btn-clear-wishlist')?.addEventListener('click', function() {
            const wishlistItems = document.querySelectorAll('.wishlist-item');
            if (wishlistItems.length === 0) {
                alert('Your wishlist is already empty.');
                return;
            }
            if (confirm('Are you sure you want to clear your entire wishlist?')) {
                wishlistItems.forEach(item => item.remove());
                updateWishlistStats();
            }
        });

        // Add to cart from wishlist
        document.querySelectorAll('.btn-add-to-cart-wishlist').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const originalText = this.innerHTML;
                this.innerHTML = '<i class="fas fa-check"></i> Added';
                this.style.backgroundColor = 'var(--terracotta)';
                setTimeout(() => {
                    this.innerHTML = originalText;
                    this.style.backgroundColor = 'var(--primary-warm)';
                }, 1500);
                alert('Item added to cart!');
            });
        });

        // Update Wishlist Statistics
        function updateWishlistStats() {
            const wishlistItems = document.querySelectorAll('.wishlist-item');
            const itemCount = wishlistItems.length;
            let onSaleCount = 0;
            let totalValue = 0;
            let lowStockCount = 0;

            wishlistItems.forEach(item => {
                if (item.getAttribute('data-status') === 'on-sale') {
                    onSaleCount++;
                }
                if (item.getAttribute('data-status') === 'low-stock') {
                    lowStockCount++;
                }
                const priceElement = item.querySelector('.wishlist-item-price');
                if (priceElement) {
                    const price = parseFloat(priceElement.textContent.replace('$', ''));
                    totalValue += price;
                }
            });

            const statValues = document.querySelectorAll('.stat-value');
            if (statValues.length >= 4) {
                statValues[0].textContent = itemCount;
                statValues[1].textContent = onSaleCount;
                statValues[2].textContent = `$${totalValue}`;
                statValues[3].textContent = lowStockCount;
            }
        }

        // Initialize
        filterWishlistItems();
    </script>
</body>
</html>