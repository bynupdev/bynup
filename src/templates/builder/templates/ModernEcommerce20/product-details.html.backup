<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details - LuxePaws Premium Pet Essentials</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-warm: #b87a3f;
            --secondary-warm: #c8a477;
            --terracotta: #b56422;
            --sand: #d8bca4;
            --neutral-rich: #5c544c;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fefaf5;
            color: var(--neutral-rich);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Breadcrumb */
        .breadcrumb.editable-section[data-section="54"] {
            padding: var(--spacing-sm) 0;
            margin-bottom: var(--spacing-md);
            font-size: 0.9rem;
            color: var(--neutral-rich);
            opacity: 0.8;
        }

        .breadcrumb a {
            color: var(--primary-warm);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .breadcrumb span {
            margin: 0 0.5rem;
        }

        /* Product Details Layout */
        .product-details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Product Images */
        .product-images.editable-section.no-drop-zone[data-section="55"] {
            position: relative;
        }

        .main-image {
            width: 100%;
            height: 500px;
            background-size: cover;
            background-position: center;
            border-radius: var(--border-radius);
            margin-bottom: var(--spacing-sm);
            box-shadow: 0 10px 30px rgba(92, 84, 76, 0.1);
            transition: var(--transition);
        }

        .thumbnail-container {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: calc(var(--border-radius) - 2px);
            background-size: cover;
            background-position: center;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .thumbnail:hover {
            transform: translateY(-3px);
            border-color: var(--primary-warm);
        }

        .thumbnail.active {
            border-color: var(--terracotta);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(181, 100, 34, 0.2);
        }

        /* Product Info */
        .product-info.editable-section.no-drop-zone[data-section="56"] {
            padding: var(--spacing-md) 0;
        }

        h1.product-title.editable-text.editable-section.no-drop-zone[data-section="57"] {
            font-size: 3rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: var(--spacing-sm);
        }

        .stars {
            color: var(--primary-warm);
            font-size: 1.2rem;
        }

        .rating-count.editable-section.editable-text.no-drop-zone[data-section="58"] {
            color: var(--neutral-rich);
            opacity: 0.7;
            font-size: 0.95rem;
        }

        .product-price.editable-section.no-drop-zone[data-section="59"] {
            font-size: 2.5rem;
            color: var(--primary-warm);
            margin-bottom: var(--spacing-md);
            font-weight: 500;
        }

        .product-description.editable-text.editable-section.no-drop-zone[data-section="60"] {
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-md);
            font-size: 1.1rem;
            line-height: 1.8;
        }

        /* Product Variants */
        .product-variants {
            margin-bottom: var(--spacing-md);
        }

        .variant-title {
            font-weight: 500;
            margin-bottom: 0.8rem;
            color: var(--neutral-rich);
            font-size: 1.1rem;
        }

        .variant-options {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .variant-option {
            padding: 0.8rem 1.5rem;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: var(--border-radius);
            background: white;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.95rem;
        }

        .variant-option:hover {
            border-color: var(--primary-warm);
            transform: translateY(-2px);
        }

        .variant-option.active {
            border-color: var(--terracotta);
            background: rgba(184, 122, 63, 0.05);
            color: var(--terracotta);
            font-weight: 500;
        }

        .color-option {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: var(--transition);
        }

        .color-option.active {
            border-color: var(--neutral-rich);
            transform: scale(1.1);
        }

        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 1rem;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
        }

        .btn-buy-now.editable-text.editable-section.no-drop-zone[data-section="61"] {
            flex: 2;
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: white;
            padding: 1.2rem 2rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-buy-now.editable-text.editable-section.no-drop-zone[data-section="61"]:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(92, 84, 76, 0.3);
        }

        .btn-add-to-cart-details.editable-text.editable-section.no-drop-zone[data-section="62"] {
            flex: 1;
            background: white;
            color: var(--primary-warm);
            padding: 1.2rem 2rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: 1px solid var(--primary-warm);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-add-to-cart-details.editable-text.editable-section.no-drop-zone[data-section="62"]:hover {
            background: var(--primary-warm);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(184, 122, 63, 0.2);
        }

        .btn-wishlist-details {
            width: 60px;
            background: white;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: var(--border-radius);
            color: var(--neutral-rich);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.2rem;
        }

        .btn-wishlist-details:hover {
            background: rgba(184, 122, 63, 0.1);
            color: var(--primary-warm);
            border-color: var(--primary-warm);
            transform: translateY(-3px);
        }

        /* Product Details Tabs */
        .product-tabs.editable-section[data-section="63"] {
            margin-bottom: var(--spacing-xl);
        }

        .tab-headers {
            display: flex;
            border-bottom: 1px solid rgba(92, 84, 76, 0.1);
            margin-bottom: var(--spacing-md);
        }

        .tab-header {
            padding: 1rem 2rem;
            background: none;
            border: none;
            color: var(--neutral-rich);
            font-size: 1.1rem;
            cursor: pointer;
            position: relative;
            transition: var(--transition);
        }

        .tab-header:hover {
            color: var(--primary-warm);
        }

        .tab-header.active {
            color: var(--primary-warm);
            font-weight: 500;
        }

        .tab-header.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--primary-warm);
        }

        .tab-content {
            display: none;
            padding: var(--spacing-md) 0;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Reviews Section */
        .review-form.editable-section.no-drop-zone[data-section="64"] {
            background: white;
            padding: var(--spacing-md);
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(92, 84, 76, 0.05);
            margin-bottom: var(--spacing-lg);
        }

        .review-form h3.editable-text.editable-section.no-drop-zone[data-section="65"] {
            font-size: 1.8rem;
            margin-bottom: var(--spacing-md);
            color: var(--neutral-rich);
        }

        .rating-input {
            margin-bottom: 1.5rem;
        }

        .rating-input label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--neutral-rich);
            font-weight: 500;
        }

        .star-rating-input {
            display: flex;
            gap: 0.5rem;
            font-size: 1.8rem;
            color: rgba(92, 84, 76, 0.2);
            cursor: pointer;
        }

        .star-rating-input .star:hover,
        .star-rating-input .star:hover ~ .star {
            color: var(--primary-warm);
        }

        .star-rating-input .star.selected {
            color: var(--primary-warm);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--neutral-rich);
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 1rem;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: var(--border-radius);
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            transition: var(--transition);
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-warm);
            box-shadow: 0 0 0 3px rgba(184, 122, 63, 0.1);
        }

        .btn-submit-review.editable-text.editable-section.no-drop-zone[data-section="66"] {
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: white;
            padding: 1rem 2.5rem;
            font-size: 1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-submit-review.editable-text.editable-section.no-drop-zone[data-section="66"]:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(181, 100, 34, 0.3);
        }

        /* Customer Reviews */
        .customer-reviews.editable-section.no-drop-zone[data-section="67"] {
            margin-bottom: var(--spacing-lg);
        }

        .customer-reviews h3.editable-text.editable-section.no-drop-zone[data-section="68"] {
            font-size: 1.8rem;
            margin-bottom: var(--spacing-md);
            color: var(--neutral-rich);
        }

        .review-item {
            background: white;
            padding: var(--spacing-md);
            border-radius: var(--border-radius);
            margin-bottom: var(--spacing-sm);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .reviewer-name {
            font-weight: 500;
            color: var(--neutral-rich);
        }

        .review-date {
            color: rgba(92, 84, 76, 0.6);
            font-size: 0.9rem;
        }

        .review-rating {
            color: var(--primary-warm);
            margin-bottom: 0.5rem;
        }

        .review-text {
            color: var(--neutral-rich);
            line-height: 1.7;
        }

        /* Related Products */
        .related-products.editable-section[data-section="69"] {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(92, 84, 76, 0.1);
        }

        .related-products h2.editable-text.editable-section.no-drop-zone[data-section="70"] {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .related-products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .related-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
        }

        .related-product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .related-product-img {
            height: 250px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .related-product-card:hover .related-product-img {
            transform: scale(1.05);
        }

        .related-product-info {
            padding: 1.5rem;
        }

        .related-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            color: var(--neutral-rich);
            margin-bottom: 0.5rem;
        }

        .related-product-price {
            color: var(--primary-warm);
            font-weight: 500;
        }

        .empty-related {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            margin: 2rem 0;
            grid-column: 1 / -1;
        }

        .empty-related h3 {
            color: var(--neutral-rich);
            margin-bottom: 0.5rem;
            font-size: 1.5rem;
        }

        .empty-related p {
            color: var(--neutral-rich);
            opacity: 0.7;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .related-products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            h1.product-title.editable-text.editable-section.no-drop-zone[data-section="57"] {
                font-size: 2.8rem;
            }
        }

        @media (max-width: 992px) {
            .product-details-container {
                grid-template-columns: 1fr;
                gap: var(--spacing-md);
            }
            .main-image {
                height: 400px;
            }
            .related-products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            h1.product-title.editable-text.editable-section.no-drop-zone[data-section="57"] {
                font-size: 2.3rem;
            }
            .product-price.editable-section.no-drop-zone[data-section="59"] {
                font-size: 2rem;
            }
            .product-actions {
                flex-direction: column;
            }
            .btn-buy-now.editable-text.editable-section.no-drop-zone[data-section="61"],
            .btn-add-to-cart-details.editable-text.editable-section.no-drop-zone[data-section="62"] {
                width: 100%;
            }
            .btn-wishlist-details {
                width: 100%;
                height: 50px;
            }
            .container {
                padding: 0 1.5rem;
            }
            .tab-headers {
                flex-direction: column;
            }
            .tab-header {
                text-align: left;
                border-bottom: 1px solid rgba(92, 84, 76, 0.1);
            }
            .tab-header.active::after {
                display: none;
            }
            .related-products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
        }

        @media (max-width: 576px) {
            h1.product-title.editable-text.editable-section.no-drop-zone[data-section="57"] {
                font-size: 2rem;
            }
            .main-image {
                height: 300px;
            }
            .thumbnail {
                width: 60px;
                height: 60px;
            }
            .btn-buy-now.editable-text.editable-section.no-drop-zone[data-section="61"],
            .btn-add-to-cart-details.editable-text.editable-section.no-drop-zone[data-section="62"],
            .btn-submit-review.editable-text.editable-section.no-drop-zone[data-section="66"] {
                padding: 1rem 1.5rem;
                font-size: 1rem;
            }
            .related-products h2.editable-text.editable-section.no-drop-zone[data-section="70"] {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>

    <!-- Breadcrumb -->
    <div class="breadcrumb editable-section" data-section="54">
        <div class="container">
            <a href="?page=home">Home</a> <span>/</span>
            <a href="?page=shop">Shop</a> <span>/</span>
            <span class="current-product">Product Details</span>
        </div>
    </div>

    <!-- Product Details -->
    <div class="container">
        <div class="product-details-container">
            <!-- Product Images -->
            <div class="product-images editable-section no-drop-zone" data-section="55">
                <div class="main-image editable-image" id="main-product-image" data-image="8" style="background-image: url('https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=600')"></div>
                <div class="thumbnail-container">
                    <div class="thumbnail active editable-image" data-image="8" style="background-image: url('https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=200')" data-full-image="https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=600"></div>
                    <div class="thumbnail editable-image" data-image="9" style="background-image: url('https://images.pexels.com/photos/6963939/pexels-photo-6963939.jpeg?auto=compress&cs=tinysrgb&w=200')" data-full-image="https://images.pexels.com/photos/6963939/pexels-photo-6963939.jpeg?auto=compress&cs=tinysrgb&w=600"></div>
                    <div class="thumbnail editable-image" data-image="10" style="background-image: url('https://images.pexels.com/photos/4060140/pexels-photo-4060140.jpeg?auto=compress&cs=tinysrgb&w=200')" data-full-image="https://images.pexels.com/photos/4060140/pexels-photo-4060140.jpeg?auto=compress&cs=tinysrgb&w=600"></div>
                    <div class="thumbnail editable-image" data-image="11" style="background-image: url('https://images.pexels.com/photos/5967508/pexels-photo-5967508.jpeg?auto=compress&cs=tinysrgb&w=200')" data-full-image="https://images.pexels.com/photos/5967508/pexels-photo-5967508.jpeg?auto=compress&cs=tinysrgb&w=600"></div>
                </div>
            </div>

            <!-- Product Info -->
            <div class="product-info editable-section no-drop-zone" data-section="56">
                <h1 class="product-title editable-text editable-section no-drop-zone" data-section="57" data-text="39">Heritage Velvet Dog Bed</h1>
                
                <div class="product-rating">
                    <div class="stars">
                        <i class="fas fa-star editable-icon" data-icon="14" data-default-class="fas fa-star"></i>
                        <i class="fas fa-star editable-icon" data-icon="14" data-default-class="fas fa-star"></i>
                        <i class="fas fa-star editable-icon" data-icon="14" data-default-class="fas fa-star"></i>
                        <i class="fas fa-star editable-icon" data-icon="14" data-default-class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt editable-icon" data-icon="14" data-default-class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="rating-count editable-section editable-text no-drop-zone" data-section="58" data-text="40">(128 Reviews)</span>
                </div>

                <div class="product-price editable-section no-drop-zone" data-section="59">$229</div>

                <p class="product-description editable-text editable-section no-drop-zone" data-section="60" data-text="41">Experience the pinnacle of pet comfort with our Heritage Velvet Dog Bed. Crafted with premium velvet fabric and filled with orthopedic memory foam, this bed provides exceptional support for joints and muscles. The luxurious design complements any home decor while giving your furry friend the ultimate relaxation space.</p>

                <!-- Product Color Variants -->
                <div class="product-variants">
                    <div class="variant-title">Color:</div>
                    <div class="variant-options">
                        <div class="color-option active" style="background-color: #8B4513;" title="Brown" data-color="brown"></div>
                        <div class="color-option" style="background-color: #2C3E50;" title="Charcoal" data-color="charcoal"></div>
                        <div class="color-option" style="background-color: #CD853F;" title="Tan" data-color="tan"></div>
                        <div class="color-option" style="background-color: #F5F5DC;" title="Beige" data-color="beige"></div>
                    </div>
                </div>

                <!-- Product Size Variants -->
                <div class="product-variants">
                    <div class="variant-title">Size:</div>
                    <div class="variant-options">
                        <div class="variant-option active" data-size="small">Small (20" x 16")</div>
                        <div class="variant-option" data-size="medium">Medium (30" x 24")</div>
                        <div class="variant-option" data-size="large">Large (40" x 32")</div>
                        <div class="variant-option" data-size="xlarge">X-Large (48" x 36")</div>
                    </div>
                </div>

                <!-- Product Actions -->
                <div class="product-actions">
                    <button class="btn-buy-now editable-text editable-section no-drop-zone" data-section="61" data-text="42">
                        <i class="fas fa-bolt editable-icon" data-icon="15" data-default-class="fas fa-bolt"></i> Buy Now
                    </button>
                    <button class="btn-add-to-cart-details editable-text editable-section no-drop-zone" data-section="62" data-text="43">
                        <i class="fas fa-shopping-bag editable-icon" data-icon="12" data-default-class="fas fa-shopping-bag"></i> Add to Cart
                    </button>
                    <button class="btn-wishlist-details">
                        <i class="far fa-heart editable-icon" data-icon="13" data-default-class="far fa-heart"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Product Tabs -->
        <div class="product-tabs editable-section" data-section="63">
            <div class="tab-headers">
                <button class="tab-header active" data-tab="description">Description</button>
                <button class="tab-header" data-tab="specifications">Specifications</button>
                <button class="tab-header" data-tab="shipping">Shipping & Returns</button>
