<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | Véloce Luxury Footwear</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-light: #F8CFAF;
            --primary-accent: #77B09F;
            --secondary-dark: #709078;
            --secondary-darker: #58784F;
            --text-dark: #333333;
            --text-light: #555555;
            --white: #ffffff;
            --light-bg: #f9f9f9;
            --transition: all 0.3s ease;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --shadow-subtle: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        main {
            font-family: 'Montserrat', sans-serif;
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
            background-color: var(--white);
            /* padding-top: 100px; */
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 600;
            line-height: 1.2;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Breadcrumb */
        .breadcrumb.editable-section {
            padding: 20px 0;
            background-color: var(--light-bg);
            margin-bottom: 40px;
        }

        .breadcrumb-content {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
        }

        .breadcrumb-content a {
            color: var(--text-light);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb-content a:hover {
            color: var(--primary-accent);
        }

        .breadcrumb-content span {
            color: var(--secondary-darker);
        }

        .breadcrumb-separator {
            color: var(--text-light);
            margin: 0 5px;
        }

        /* Hero Section */
        .about-hero.editable-section {
            padding: 80px 0;
            background: linear-gradient(135deg, var(--primary-light) 0%, rgba(248, 207, 175, 0.1) 100%);
            margin-bottom: 80px;
        }

        .hero-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .hero-content h1 {
            font-size: 3.8rem;
            color: var(--secondary-darker);
            margin-bottom: 25px;
            line-height: 1.1;
        }

        .hero-content p {
            font-size: 1.2rem;
            color: var(--text-light);
            margin-bottom: 35px;
            line-height: 1.8;
        }

        .hero-stats {
            display: flex;
            gap: 40px;
            margin-top: 40px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--primary-accent);
            margin-bottom: 8px;
        }

        .stat-label {
            font-size: 0.9rem;
            color: var(--secondary-dark);
            font-weight: 500;
            letter-spacing: 1px;
        }

        .hero-image {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--shadow);
            height: 500px;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hero-image img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        /* Mission Section */
        .mission-section.editable-section {
            padding: 80px 0;
            margin-bottom: 80px;
        }

        .section-title {
            text-align: center;
            font-size: 2.8rem;
            color: var(--secondary-darker);
            margin-bottom: 60px;
        }

        .mission-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }

        .mission-card {
            background-color: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: var(--shadow-subtle);
            transition: var(--transition);
            text-align: center;
        }

        .mission-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow);
        }

        .mission-icon {
            width: 80px;
            height: 80px;
            background-color: var(--primary-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 25px;
            font-size: 2rem;
            color: var(--secondary-darker);
        }

        .mission-card h3 {
            font-size: 1.5rem;
            color: var(--secondary-darker);
            margin-bottom: 20px;
        }

        .mission-card p {
            color: var(--text-light);
            line-height: 1.7;
        }

        /* Story Section */
        .story-section.editable-section {
            padding: 80px 0;
            background-color: var(--light-bg);
            margin-bottom: 80px;
        }

        .story-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .story-image {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--shadow);
            height: 500px;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .story-image img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        .story-content h2 {
            font-size: 2.5rem;
            color: var(--secondary-darker);
            margin-bottom: 25px;
        }

        .story-content p {
            color: var(--text-light);
            line-height: 1.8;
            margin-bottom: 20px;
        }

        /* Craftsmanship Section */
        .craftsmanship-section.editable-section {
            padding: 80px 0;
            margin-bottom: 80px;
        }

        .craftsmanship-header {
            text-align: center;
            max-width: 800px;
            margin: 0 auto 60px;
        }

        .craftsmanship-header h2 {
            font-size: 2.8rem;
            color: var(--secondary-darker);
            margin-bottom: 25px;
        }

        .craftsmanship-header p {
            color: var(--text-light);
            font-size: 1.1rem;
            line-height: 1.8;
        }

        .craftsmanship-steps {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .step-card {
            text-align: center;
            padding: 30px;
            position: relative;
        }

        .step-number {
            width: 60px;
            height: 60px;
            background-color: var(--primary-accent);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0 auto 25px;
        }

        .step-card h3 {
            font-size: 1.3rem;
            color: var(--secondary-darker);
            margin-bottom: 15px;
        }

        .step-card p {
            color: var(--text-light);
            line-height: 1.7;
        }

        /* Team Section */
        .team-section.editable-section {
            padding: 80px 0;
            background-color: var(--light-bg);
            margin-bottom: 80px;
        }

        .team-header {
            text-align: center;
            max-width: 800px;
            margin: 0 auto 60px;
        }

        .team-header h2 {
            font-size: 2.8rem;
            color: var(--secondary-darker);
            margin-bottom: 25px;
        }

        .team-header p {
            color: var(--text-light);
            font-size: 1.1rem;
            line-height: 1.8;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .team-card {
            background-color: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--shadow-subtle);
            transition: var(--transition);
        }

        .team-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow);
        }

        .team-image {
            height: 280px;
            background-color: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .team-image img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        .team-info {
            padding: 25px;
            text-align: center;
        }

        .team-info h3 {
            font-size: 1.4rem;
            color: var(--secondary-darker);
            margin-bottom: 8px;
        }

        .team-info p {
            color: var(--text-light);
            font-size: 0.9rem;
            margin-bottom: 15px;
        }

        .team-social {
            display: flex;
            justify-content: center;
            gap: 15px;
        }

        .team-social a {
            width: 36px;
            height: 36px;
            background-color: var(--light-bg);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--secondary-dark);
            transition: var(--transition);
        }

        .team-social a:hover {
            background-color: var(--primary-accent);
            color: white;
        }

        /* Values Section */
        .values-section.editable-section {
            padding: 80px 0;
            margin-bottom: 80px;
        }

        .values-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }

        .value-card {
            text-align: center;
            padding: 40px 30px;
            border: 2px solid transparent;
            border-radius: 12px;
            transition: var(--transition);
            background-color: white;
        }

        .value-card:hover {
            border-color: var(--primary-accent);
            box-shadow: var(--shadow);
        }

        .value-icon {
            font-size: 2.5rem;
            color: var(--primary-accent);
            margin-bottom: 25px;
        }

        .value-card h3 {
            font-size: 1.5rem;
            color: var(--secondary-darker);
            margin-bottom: 20px;
        }

        .value-card p {
            color: var(--text-light);
            line-height: 1.7;
        }

        /* CTA Section */
        .cta-section.editable-section {
            padding: 100px 0;
            background: linear-gradient(135deg, var(--secondary-darker) 0%, var(--secondary-dark) 100%);
            color: white;
            text-align: center;
            border-radius: 20px;
            margin-bottom: 80px;
        }

        .cta-content {
            max-width: 700px;
            margin: 0 auto;
        }

        .cta-content h2 {
            font-size: 3rem;
            margin-bottom: 25px;
            color: white;
        }

        .cta-content p {
            font-size: 1.2rem;
            margin-bottom: 40px;
            opacity: 0.9;
            line-height: 1.8;
        }

        .cta-buttons {
            display: flex;
            gap: 20px;
            justify-content: center;
        }

        .temp-btn-primary {
            padding: 16px 40px;
            background-color: white;
            color: var(--secondary-darker);
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            letter-spacing: 0.5px;
            transition: var(--transition);
            border: 2px solid white;
        }

        .temp-btn-primary:hover {
            background-color: transparent;
            color: white;
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        .temp-btn-secondary {
            padding: 16px 40px;
            background-color: transparent;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            letter-spacing: 0.5px;
            transition: var(--transition);
            border: 2px solid white;
        }

        .temp-btn-secondary:hover {
            background-color: white;
            color: var(--secondary-darker);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        /* Responsive Styles */
        @media screen and (max-width: 1200px) {
            .mission-container,
            .craftsmanship-steps,
            .team-grid,
            .values-container {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media screen and (max-width: 992px) {
            .hero-container,
            .story-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .hero-content h1 {
                font-size: 3rem;
            }
            
            .section-title {
                font-size: 2.5rem;
            }
            
            .cta-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .temp-btn-primary,
            .temp-btn-secondary {
                width: 100%;
                max-width: 300px;
            }
        }

        @media screen and (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            
            .hero-content h1 {
                font-size: 2.5rem;
            }
            
            .section-title {
                font-size: 2.2rem;
            }
            
            .mission-container,
            .craftsmanship-steps,
            .team-grid,
            .values-container {
                grid-template-columns: 1fr;
            }
            
            .hero-stats {
                flex-direction: column;
                gap: 20px;
            }
            
            .cta-content h2 {
                font-size: 2.5rem;
            }
        }

        @media screen and (max-width: 576px) {
            .hero-content h1 {
                font-size: 2rem;
            }
            
            .section-title {
                font-size: 1.8rem;
            }
            
            .mission-card,
            .value-card {
                padding: 30px 20px;
            }
            
            .cta-content h2 {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
   <main>
     <!-- Breadcrumb -->
    <section class="breadcrumb editable-section" data-section="203">
        <div class="container">
            <div class="breadcrumb-content">
                <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="204" data-text="143">Home</a>
                <span class="breadcrumb-separator">/</span>
                <span class="editable-text editable-section no-drop-zone" data-section="205" data-text="144">About Us</span>
            </div>
        </div>
    </section>

    <!-- Hero Section -->
    <section class="about-hero editable-section" data-section="206">
        <div class="container">
            <div class="hero-container">
                <div class="hero-content">
                    <h1 class="editable-text editable-section no-drop-zone" data-section="207" data-text="145">Crafting Timeless Elegance Since 1995</h1>
                    <p class="editable-text editable-section no-drop-zone" data-section="208" data-text="146">At Véloce, we believe luxury footwear should transcend trends. For nearly three decades, we've dedicated ourselves to creating shoes that combine exceptional craftsmanship, premium materials, and timeless design.</p>
                    
                    <div class="hero-stats">
                        <div class="stat-item editable-section no-drop-zone" data-section="209">
                            <div class="stat-number editable-text editable-section no-drop-zone" data-section="210" data-text="147">28</div>
                            <div class="stat-label editable-text editable-section no-drop-zone" data-section="211" data-text="148">Years of Excellence</div>
                        </div>
                        <div class="stat-item editable-section no-drop-zone" data-section="212">
                            <div class="stat-number editable-text editable-section no-drop-zone" data-section="213" data-text="149">50+</div>
                            <div class="stat-label editable-text editable-section no-drop-zone" data-section="214" data-text="150">Master Artisans</div>
                        </div>
                        <div class="stat-item editable-section no-drop-zone" data-section="215">
                            <div class="stat-number editable-text editable-section no-drop-zone" data-section="216" data-text="151">75+</div>
                            <div class="stat-label editable-text editable-section no-drop-zone" data-section="217" data-text="152">Countries Served</div>
                        </div>
                    </div>
                </div>
                
                <div class="hero-image editable-section no-drop-zone" data-section="218">
                    <img src="https://images.unsplash.com/photo-1579338559194-a162d19bf842?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Luxury Shoemaking" class="editable-image" data-image="18">
                </div>
            </div>
        </div>
    </section>

    <!-- Mission Section -->
    <section class="mission-section editable-section" data-section="219">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="220" data-text="153">Our Commitment to Excellence</h2>
            
            <div class="mission-container">
                <div class="mission-card editable-section no-drop-zone" data-section="221">
                    <div class="mission-icon">
                        <i class="fas fa-gem editable-icon" data-icon="32" data-default-class="fas fa-gem"></i>
                    </div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="222" data-text="154">Uncompromising Quality</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="223" data-text="155">We source only the finest materials from renowned European tanneries, ensuring every pair meets our rigorous standards for durability and beauty.</p>
                </div>
                
                <div class="mission-card editable-section no-drop-zone" data-section="224">
                    <div class="mission-icon">
                        <i class="fas fa-hand-sparkles editable-icon" data-icon="33" data-default-class="fas fa-hand-sparkles"></i>
                    </div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="225" data-text="156">Artisan Craftsmanship</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="226" data-text="157">Each pair is meticulously handcrafted by master artisans in Milan, honoring traditional techniques while incorporating modern innovations.</p>
                </div>
                
                <div class="mission-card editable-section no-drop-zone" data-section="227">
                    <div class="mission-icon">
                        <i class="fas fa-leaf editable-icon" data-icon="34" data-default-class="fas fa-leaf"></i>
                    </div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="228" data-text="158">Sustainable Luxury</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="229" data-text="159">We're committed to ethical production and sustainable practices, ensuring our luxury doesn't come at the expense of people or planet.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Story Section -->
    <section class="story-section editable-section" data-section="230">
        <div class="container">
            <div class="story-container">
                <div class="story-image editable-section no-drop-zone" data-section="231">
                    <img src="https://images.unsplash.com/photo-1525966222134-fcfa99b8ae77?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Founder Story" class="editable-image" data-image="19">
                </div>
                
                <div class="story-content">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="232" data-text="160">Our Story: From Atelier to Global Icon</h2>
                    <p class="editable-text editable-section no-drop-zone" data-section="233" data-text="161">Founded in a small Milanese atelier by master cobbler Giovanni Rossi, Véloce began as a passion project dedicated to reviving the lost art of bespoke shoemaking.</p>
                    <p class="editable-text editable-section no-drop-zone" data-section="234" data-text="162">What started with three craftsmen meticulously creating custom orders for local clients has grown into an internationally recognized luxury brand, while never losing sight of our artisanal roots.</p>
                    <p class="editable-text editable-section no-drop-zone" data-section="235" data-text="163">Today, Giovanni's grandchildren continue the legacy, blending time-honored techniques with contemporary design to create footwear that stands the test of time.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Craftsmanship Section -->
    <section class="craftsmanship-section editable-section" data-section="236">
        <div class="container">
            <div class="craftsmanship-header">
                <h2 class="editable-text editable-section no-drop-zone" data-section="237" data-text="164">The Art of Italian Craftsmanship</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="238" data-text="165">Every Véloce shoe undergoes a meticulous 8-week creation process, combining over 200 individual steps perfected through generations of shoemaking tradition.</p>
            </div>
            
            <div class="craftsmanship-steps">
                <div class="step-card editable-section no-drop-zone" data-section="239">
                    <div class="step-number editable-text editable-section no-drop-zone" data-section="240" data-text="166">1</div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="241" data-text="167">Material Selection</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="242" data-text="168">Only premium full-grain leathers and suedes from Europe's finest tanneries meet our quality standards.</p>
                </div>
                
                <div class="step-card editable-section no-drop-zone" data-section="243">
                    <div class="step-number editable-text editable-section no-drop-zone" data-section="244" data-text="169">2</div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="245" data-text="170">Pattern Cutting</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="246" data-text="171">Each pattern is hand-cut with precision, ensuring optimal fit and minimal material waste.</p>
                </div>
                
                <div class="step-card editable-section no-drop-zone" data-section="247">
                    <div class="step-number editable-text editable-section no-drop-zone" data-section="248" data-text="172">3</div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="249" data-text="173">Hand Stitching</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="250" data-text="174">Master artisans employ traditional saddle stitching for unparalleled durability and flexibility.</p>
                </div>
                
                <div class="step-card editable-section no-drop-zone" data-section="251">
                    <div class="step-number editable-text editable-section no-drop-zone" data-section="252" data-text="175">4</div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="253" data-text="176">Quality Inspection</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="254" data-text="177">Every pair undergoes 27-point quality control checks before leaving our workshop.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Section -->
    <section class="team-section editable-section" data-section="255">
        <div class="container">
            <div class="team-header">
                <h2 class="editable-text editable-section no-drop-zone" data-section="256" data-text="178">Meet Our Master Artisans</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="257" data-text="179">Our craftsmen average 25 years of experience, with skills passed down through generations. Each artisan specializes in a specific aspect of shoemaking.</p>
            </div>
            
            <div class="team-grid">
                <!-- Team Member 1 (Editable) -->
                <div class="team-card editable-section no-drop-zone" data-section="258">
                    <div class="team-image">
                        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Master Artisan" class="editable-image" data-image="20">
                    </div>
