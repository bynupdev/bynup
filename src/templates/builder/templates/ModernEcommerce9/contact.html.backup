<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Véloce Luxury Footwear</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-light: #F8CFAF;
            --primary-accent: #77B09F;
            --secondary-dark: #709078;
            --secondary-darker: #58784F;
            --text-dark: #333333;
            --text-light: #555555;
            --white: #ffffff;
            --light-bg: #f9f9f9;
            --transition: all 0.3s ease;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --shadow-subtle: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        main {
            font-family: 'Montserrat', sans-serif;
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
            background-color: var(--white);
            /* padding-top: 100px; */
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 600;
            line-height: 1.2;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Breadcrumb */
        .breadcrumb.editable-section {
            padding: 20px 0;
            background-color: var(--light-bg);
            margin-bottom: 40px;
        }

        .breadcrumb-content {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
        }

        .breadcrumb-content a {
            color: var(--text-light);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb-content a:hover {
            color: var(--primary-accent);
        }

        .breadcrumb-content span {
            color: var(--secondary-darker);
        }

        .breadcrumb-separator {
            color: var(--text-light);
            margin: 0 5px;
        }

        /* Contact Header */
        .contact-header.editable-section {
            text-align: center;
            margin-bottom: 60px;
        }

        .contact-header h1 {
            font-size: 3.5rem;
            color: var(--secondary-darker);
            margin-bottom: 20px;
        }

        .contact-header p {
            color: var(--text-light);
            max-width: 700px;
            margin: 0 auto;
            font-size: 1.1rem;
            line-height: 1.8;
        }

        /* Contact Sections Container */
        .contact-sections.editable-section {
            padding: 0 0 80px;
        }

        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            margin-bottom: 80px;
        }

        /* Contact Information */
        .contact-info.editable-section {
            padding: 40px;
            background-color: var(--light-bg);
            border-radius: 12px;
        }

        .contact-info h2 {
            font-size: 2.2rem;
            color: var(--secondary-darker);
            margin-bottom: 30px;
        }

        .contact-details {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .contact-item {
            display: flex;
            gap: 20px;
            align-items: flex-start;
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background-color: var(--primary-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--secondary-darker);
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .contact-content h3 {
            font-size: 1.3rem;
            margin-bottom: 8px;
            color: var(--secondary-dark);
        }

        .contact-content p {
            color: var(--text-light);
            line-height: 1.7;
        }

        .contact-content a {
            color: var(--primary-accent);
            text-decoration: none;
            transition: var(--transition);
        }

        .contact-content a:hover {
            color: var(--secondary-darker);
            text-decoration: underline;
        }

        .business-hours {
            margin-top: 30px;
            padding-top: 30px;
            border-top: 1px solid #ddd;
        }

        .business-hours h3 {
            font-size: 1.3rem;
            margin-bottom: 15px;
            color: var(--secondary-dark);
        }

        .hours-list {
            list-style: none;
        }

        .hours-list li {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .hours-list li:last-child {
            border-bottom: none;
        }

        .hours-list span {
            color: var(--text-light);
        }

        /* Contact Form */
        .contact-form.editable-section {
            padding: 40px;
            background-color: white;
            border-radius: 12px;
            box-shadow: var(--shadow-subtle);
        }

        .contact-form h2 {
            font-size: 2.2rem;
            color: var(--secondary-darker);
            margin-bottom: 30px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-dark);
            font-weight: 500;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 14px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-family: 'Montserrat', sans-serif;
            transition: var(--transition);
            font-size: 15px;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-accent);
            box-shadow: 0 0 0 3px rgba(119, 176, 159, 0.1);
        }

        .form-group textarea {
            min-height: 150px;
            resize: vertical;
        }

        .submit-temp-btn {
            padding: 16px 40px;
            background-color: var(--secondary-darker);
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 500;
            font-size: 16px;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .submit-temp-btn:hover {
            background-color: var(--primary-accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        /* Map Section */
        .map-section.editable-section {
            margin-bottom: 80px;
        }

        .map-container {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--shadow-subtle);
            height: 400px;
            background-color: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .map-placeholder {
            text-align: center;
            padding: 40px;
            color: var(--secondary-darker);
        }

        .map-placeholder i {
            font-size: 4rem;
            margin-bottom: 20px;
            color: var(--primary-accent);
        }

        .map-placeholder h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        .map-placeholder p {
            color: var(--text-light);
        }

        /* FAQ Section */
        .faq-section.editable-section {
            padding: 80px 0;
            background-color: var(--light-bg);
        }

        .section-title {
            font-size: 2.5rem;
            color: var(--secondary-darker);
            margin-bottom: 50px;
            text-align: center;
        }

        .faq-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .faq-item {
            background-color: white;
            border-radius: 8px;
            margin-bottom: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-subtle);
            transition: var(--transition);
        }

        .faq-item.active {
            box-shadow: var(--shadow);
        }

        .faq-question {
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .faq-question:hover {
            background-color: rgba(119, 176, 159, 0.05);
        }

        .faq-question h3 {
            font-size: 1.3rem;
            color: var(--secondary-darker);
            margin: 0;
            flex: 1;
        }

        .faq-toggle {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background-color: var(--light-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
            flex-shrink: 0;
            margin-left: 20px;
        }

        .faq-item.active .faq-toggle {
            background-color: var(--primary-accent);
            color: white;
            transform: rotate(180deg);
        }

        .faq-answer {
            padding: 0 30px;
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
            padding: 0 30px 30px;
            max-height: 500px;
        }

        .faq-item.active .faq-answer {
            padding: 0 30px 30px;
            max-height: 500px;
        }

        .faq-answer p {
            color: var(--text-light);
            line-height: 1.7;
        }

        /* Responsive Styles */
        @media screen and (max-width: 1200px) {
            .contact-container {
                gap: 40px;
            }
        }

        @media screen and (max-width: 992px) {
            .contact-header h1 {
                font-size: 3rem;
            }
            
            .contact-container {
                grid-template-columns: 1fr;
            }
            
            .section-title {
                font-size: 2.2rem;
            }
            
            .form-row {
                grid-template-columns: 1fr;
            }
        }

        @media screen and (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            
            .contact-header h1 {
                font-size: 2.5rem;
            }
            
            .section-title {
                font-size: 2rem;
            }
            
            .contact-info,
            .contact-form {
                padding: 30px;
            }
            
            .faq-question {
                padding: 20px;
            }
            
            .faq-question h3 {
                font-size: 1.1rem;
            }
        }

        @media screen and (max-width: 576px) {
            .contact-header h1 {
                font-size: 2rem;
            }
            
            .contact-item {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }
            
            .contact-icon {
                margin: 0 auto;
            }
            
            .faq-question {
                padding: 15px;
            }
            
            .faq-question h3 {
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <main>
        <!-- Breadcrumb -->
    <section class="breadcrumb editable-section" data-section="291">
        <div class="container">
            <div class="breadcrumb-content">
                <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="292" data-text="204">Home</a>
                <span class="breadcrumb-separator">/</span>
                <span class="editable-text editable-section no-drop-zone" data-section="293" data-text="205">Contact Us</span>
            </div>
        </div>
    </section>

    <!-- Contact Header -->
    <section class="contact-header editable-section" data-section="294">
        <div class="container">
            <h1 class="editable-text editable-section no-drop-zone" data-section="295" data-text="206">Get in Touch</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="296" data-text="207">We're here to assist you with any questions about our luxury footwear, orders, or personalized styling advice. Reach out to our dedicated team.</p>
        </div>
    </section>

    <!-- Contact Sections -->
    <section class="contact-sections editable-section" data-section="297">
        <div class="container">
            <div class="contact-container">
                <!-- Contact Information -->
                <div class="contact-info editable-section" data-section="298">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="299" data-text="208">Contact Information</h2>
                    
                    <div class="contact-details">
                        <!-- Address -->
                        <div class="contact-item editable-section no-drop-zone" data-section="300">
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt editable-icon" data-icon="40" data-default-class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="contact-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="301" data-text="209">Visit Our Showroom</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="302" data-text="210">123 Luxury Avenue, Fashion District<br>Milan, Italy 20121</p>
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="contact-item editable-section no-drop-zone" data-section="303">
                            <div class="contact-icon">
                                <i class="fas fa-phone editable-icon" data-icon="41" data-default-class="fas fa-phone"></i>
                            </div>
                            <div class="contact-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="304" data-text="211">Call Us</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="305" data-text="212">Main: <a href="tel:+390212345678">+39 02 1234 5678</a><br>Customer Service: <a href="tel:+390298765432">+39 02 9876 5432</a></p>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="contact-item editable-section no-drop-zone" data-section="306">
                            <div class="contact-icon">
                                <i class="fas fa-envelope editable-icon" data-icon="42" data-default-class="fas fa-envelope"></i>
                            </div>
                            <div class="contact-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="307" data-text="213">Email Us</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="308" data-text="214">General Inquiries: <a href="mailto:info@velocefootwear.com">info@velocefootwear.com</a><br>Customer Support: <a href="mailto:support@velocefootwear.com">support@velocefootwear.com</a></p>
                            </div>
                        </div>
                    </div>

                    <!-- Business Hours -->
                    <div class="business-hours editable-section no-drop-zone" data-section="309">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="310" data-text="215">Business Hours</h3>
                        <ul class="hours-list">
                            <li class="editable-section no-drop-zone" data-section="311">
                                <span class="editable-text editable-section no-drop-zone" data-section="312" data-text="216">Monday - Friday</span>
                                <span class="editable-text editable-section no-drop-zone" data-section="313" data-text="217">9:00 AM - 7:00 PM</span>
                            </li>
                            <li class="editable-section no-drop-zone" data-section="314">
                                <span class="editable-text editable-section no-drop-zone" data-section="315" data-text="218">Saturday</span>
                                <span class="editable-text editable-section no-drop-zone" data-section="316" data-text="219">10:00 AM - 6:00 PM</span>
                            </li>
                            <li class="editable-section no-drop-zone" data-section="317">
                                <span class="editable-text editable-section no-drop-zone" data-section="318" data-text="220">Sunday</span>
                                <span class="editable-text editable-section no-drop-zone" data-section="319" data-text="221">Closed</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form editable-section" data-section="320">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="321" data-text="222">Send Us a Message</h2>
                    <form id="contact-form">
                        <div class="form-row">
                            <div class="form-group editable-section no-drop-zone" data-section="322">
                                <label for="first-name" class="editable-text editable-section no-drop-zone" data-section="323" data-text="223">First Name</label>
                                <input type="text" id="first-name" placeholder="Enter your first name" required class="editable-section" data-section="324">
                            </div>
                            <div class="form-group editable-section no-drop-zone" data-section="325">
                                <label for="last-name" class="editable-text editable-section no-drop-zone" data-section="326" data-text="224">Last Name</label>
                                <input type="text" id="last-name" placeholder="Enter your last name" required class="editable-section" data-section="327">
                            </div>
                        </div>

                        <div class="form-group editable-section no-drop-zone" data-section="328">
                            <label for="email" class="editable-text editable-section no-drop-zone" data-section="329" data-text="225">Email Address</label>
                            <input type="email" id="email" placeholder="Enter your email address" required class="editable-section" data-section="330">
                        </div>

                        <div class="form-group editable-section no-drop-zone" data-section="331">
                            <label for="phone" class="editable-text editable-section no-drop-zone" data-section="332" data-text="226">Phone Number (Optional)</label>
                            <input type="tel" id="phone" placeholder="Enter your phone number" class="editable-section" data-section="333">
                        </div>

                        <div class="form-group editable-section no-drop-zone" data-section="334">
                            <label for="subject" class="editable-text editable-section no-drop-zone" data-section="335" data-text="227">Subject</label>
                            <select id="subject" required class="editable-section" data-section="336">
                                <option value="" disabled selected class="editable-text" data-text="228">Select a subject</option>
                                <option value="general" class="editable-text" data-text="229">General Inquiry</option>
                                <option value="order" class="editable-text" data-text="230">Order Questions</option>
                                <option value="product" class="editable-text" data-text="231">Product Information</option>
                                <option value="sizing" class="editable-text" data-text="232">Sizing & Fit</option>
                                <option value="returns" class="editable-text" data-text="233">Returns & Exchanges</option>
                                <option value="wholesale" class="editable-text" data-text="234">Wholesale Inquiries</option>
                            </select>
                        </div>

                        <div class="form-group editable-section no-drop-zone" data-section="337">
                            <label for="message" class="editable-text editable-section no-drop-zone" data-section="338" data-text="235">Your Message</label>
                            <textarea id="message" placeholder="Please describe your inquiry in detail..." required class="editable-section" data-section="339"></textarea>
                        </div>

                        <button type="submit" class="submit-temp-btn editable-text editable-section no-drop-zone" data-section="340" data-text="236">
                            <i class="fas fa-paper-plane editable-icon" data-icon="43" data-default-class="fas fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>

            <!-- Map Section -->
            <div class="map-section editable-section" data-section="341">
                <div class="map-container editable-section" data-section="342">
                    <div class="map-placeholder editable-section no-drop-zone" data-section="343">
                        <i class="fas fa-map-marked-alt editable-icon" data-icon="44" data-default-class="fas fa-map-marked-alt"></i>
                        <h3 class="editable-text editable-section no-drop-zone" data-section="344" data-text="237">Visit Our Milan Showroom</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="345" data-text="238">Experience luxury footwear in person at our flagship location in the heart of Milan's fashion district.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section editable-section" data-section="346">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="347" data-text="239">Frequently Asked Questions</h2>
            
            <div class="faq-container">
                <!-- FAQ Item 1 -->
                <div class="faq-item editable-section no-drop-zone" data-section="348">
                    <div class="faq-question editable-section no-drop-zone" data-section="349">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="350" data-text="240">What is your return and exchange policy?</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-chevron-down editable-icon" data-icon="45" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="351">
                        <p class="editable-text editable-section no-drop-zone" data-section="352" data-text="241">We offer a 30-day return and exchange policy for all unworn items in original condition with tags attached. Custom and personalized items are final sale. Returns are processed within 5-7 business days after we receive your item.</p>
                    </div>
                </div>

                <!-- FAQ Item 2 -->
                <div class="faq-item editable-section no-drop-zone" data-section="353">
                    <div class="faq-question editable-section no-drop-zone" data-section="354">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="355" data-text="242">How do I determine my correct shoe size?</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-chevron-down editable-icon" data-icon="45" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="356">
                        <p class="editable-text editable-section no-drop-zone" data-section="357" data-text="243">We recommend referring to our detailed sizing guide available on each product page. For the most accurate fit, measure your foot length and compare it to our size chart. Our customer service team can also provide personalized sizing recommendations based on specific styles.</p>
                    </div>
                </div>

                <!-- FAQ Item 3 -->
                <div class="faq-item editable-section no-drop-zone" data-section="358">
                    <div class="faq-question editable-section no-drop-zone" data-section="359">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="360" data-text="244">What materials are used in Véloce footwear?</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-chevron-down editable-icon" data-icon="45" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="361">
                        <p class="editable-text editable-section no-drop-zone" data-section="362" data-text="245">We exclusively use premium materials including full-grain Italian leather, suede from renowned European tanneries, and sustainable alternatives where appropriate. All materials are selected for durability, comfort, and environmental responsibility.</p>
                    </div>
                </div>

                <!-- FAQ Item 4 -->
                <div class="faq-item editable-section no-drop-zone" data-section="363">
                    <div class="faq-question editable-section no-drop-zone" data-section="364">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="365" data-text="246">Do you offer international shipping?</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-chevron-down editable-icon" data-icon="45" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="366">
                        <p class="editable-text editable-section no-drop-zone" data-section="367" data-text="247">Yes, we ship worldwide via express courier services. Shipping costs and delivery times vary by destination. All international orders include tracking and may be subject to customs duties and taxes based on the recipient's country regulations.</p>
                    </div>
                </div>

                <!-- FAQ Item 5 -->
                <div class="faq-item editable-section no-drop-zone" data-section="368">
                    <div class="faq-question editable-section no-drop-zone" data-section="369">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="370" data-text="248">How do I care for my luxury shoes?</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-chevron-down editable-icon" data-icon="45" data-default-class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="371">
                        <p class="editable-text editable-section no-drop-zone" data-section="372" data-text="249">Each pair comes with specific care instructions. Generally, we recommend using appropriate leather conditioners, suede protectors, and professional cleaning for stubborn stains. Store shoes in their original dust bags and use shoe trees to maintain shape.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    </main>

    <script>
        // FAQ Toggle Functionality
        const faqItems = document.querySelectorAll('.faq-item');
        
        faqItems.forEach(item => {
            const question = item.querySelector('.faq-question');
            
            question.addEventListener('click', () => {
                // Close all other FAQ items
                faqItems.forEach(otherItem => {
                    if (otherItem !== item && otherItem.classList.contains('active')) {
                        otherItem.classList.remove('active');
                    }
                });
                
                // Toggle current FAQ item
                item.classList.toggle('active');
            });
        });

        // Contact Form Submission
        const contactForm = document.getElementById('contact-form');
        
        contactForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Get form values
            const firstName = document.getElementById('first-name').value;
            const lastName = document.getElementById('last-name').value;
            const email = document.getElementById('email').value;
            const phone = document.getElementById('phone').value;
            const subject = document.getElementById('subject').value;
            const message = document.getElementById('message').value;
            
            // Basic validation
            if (!firstName || !lastName || !email || !subject || !message) {
                alert('Please fill in all required fields.');
                return;
            }
            
            // Email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Please enter a valid email address.');
                return;
            }
            
            // Show success message
            alert(`Thank you, ${firstName}! Your message has been sent. We'll respond within 24-48 hours.`);
            
            // Reset form
            this.reset();
            
            // Animation feedback
            const submittemp-btn = this.querySelector('.submit-temp-btn');
            submittemp-btn.style.backgroundColor = 'var(--primary-accent)';
            setTimeout(() => {
                submittemp-btn.style.backgroundColor = 'var(--secondary-darker)';
            }, 300);
        });

        // Form input validation styling
        const formInputs = document.querySelectorAll('.form-group input, .form-group select, .form-group textarea');
        
        formInputs.forEach(input => {
            // Add focus effect
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });
            
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('focused');
                
                // Validate on blur
                if (this.hasAttribute('required') && !this.value) {
                    this.style.borderColor = '#e74c3c';
                } else {
                    this.style.borderColor = '#ddd';
                }
            });
        });
    </script>
</body>
</html>