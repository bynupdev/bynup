<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | Véloce Luxury Footwear</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-light: #F8CFAF;
            --primary-accent: #77B09F;
            --secondary-dark: #709078;
            --secondary-darker: #58784F;
            --text-dark: #333333;
            --text-light: #555555;
            --white: #ffffff;
            --light-bg: #f9f9f9;
            --transition: all 0.3s ease;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --shadow-subtle: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        main {
            font-family: 'Montserrat', sans-serif;
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
            background-color: var(--white);
            /* padding-top: 100px; */
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 600;
            line-height: 1.2;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Breadcrumb */
        .breadcrumb.editable-section {
            padding: 20px 0;
            background-color: var(--light-bg);
            margin-bottom: 40px;
        }

        .breadcrumb-content {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
        }

        .breadcrumb-content a {
            color: var(--text-light);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb-content a:hover {
            color: var(--primary-accent);
        }

        .breadcrumb-content span {
            color: var(--secondary-darker);
        }

        .breadcrumb-separator {
            color: var(--text-light);
            margin: 0 5px;
        }

        /* Cart Section */
        .cart-section.editable-section {
            padding: 0 0 60px;
        }

        .cart-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .cart-header h1 {
            font-size: 3rem;
            color: var(--secondary-darker);
            margin-bottom: 15px;
        }

        .cart-header p {
            color: var(--text-light);
            max-width: 600px;
            margin: 0 auto;
        }

        .cart-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
        }

        /* Cart Items */
        .cart-items {
            background-color: white;
            border-radius: 8px;
            box-shadow: var(--shadow-subtle);
            overflow: hidden;
        }

        .cart-items-header {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            padding: 20px;
            background-color: var(--light-bg);
            border-bottom: 1px solid #eee;
            font-weight: 600;
            color: var(--secondary-dark);
        }

        .cart-item {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            padding: 25px 20px;
            border-bottom: 1px solid #eee;
            align-items: center;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-item-info {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .cart-item-image {
            width: 120px;
            height: 120px;
            background-color: var(--primary-light);
            border-radius: 4px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .cart-item-image img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        .cart-item-details h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--secondary-darker);
        }

        .cart-item-details p {
            color: var(--text-light);
            font-size: 0.9rem;
            margin-bottom: 5px;
        }

        .cart-item-color {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
        }

        .color-swatch {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: 1px solid #ddd;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .quantity-temp-btn {
            width: 32px;
            height: 32px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .quantity-temp-btn:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }

        .quantity-input {
            width: 50px;
            text-align: center;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 16px;
        }

        .cart-item-price {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--primary-accent);
        }

        .cart-item-total {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--secondary-darker);
        }

        .remove-item {
            background: none;
            border: none;
            color: var(--text-light);
            cursor: pointer;
            transition: var(--transition);
            font-size: 18px;
        }

        .remove-item:hover {
            color: #e74c3c;
        }

        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: 60px 20px;
            background-color: white;
            border-radius: 8px;
            box-shadow: var(--shadow-subtle);
        }

        .empty-cart i {
            font-size: 4rem;
            color: var(--primary-light);
            margin-bottom: 20px;
        }

        .empty-cart h3 {
            font-size: 1.8rem;
            margin-bottom: 15px;
            color: var(--secondary-dark);
        }

        .empty-cart p {
            color: var(--text-light);
            margin-bottom: 30px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-temp-btn {
            display: inline-block;
            padding: 12px 30px;
            background-color: var(--secondary-darker);
            color: white;
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 4px;
            transition: var(--transition);
            font-size: 15px;
        }

        .shop-temp-btn:hover {
            background-color: var(--primary-accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        /* Cart Summary */
        .cart-summary {
            background-color: white;
            border-radius: 8px;
            box-shadow: var(--shadow-subtle);
            padding: 30px;
            position: sticky;
            top: 120px;
            height: fit-content;
        }

        .cart-summary h2 {
            font-size: 1.8rem;
            color: var(--secondary-darker);
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 1px solid #eee;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #f5f5f5;
        }

        .summary-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .summary-label {
            color: var(--text-light);
        }

        .summary-value {
            font-weight: 500;
            color: var(--text-dark);
        }

        .summary-total {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--primary-accent);
        }

        .proceed-checkout {
            width: 100%;
            padding: 16px;
            background-color: var(--secondary-darker);
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: var(--transition);
            font-weight: 500;
            font-size: 16px;
            letter-spacing: 0.5px;
            margin-top: 20px;
        }

        .proceed-checkout:hover {
            background-color: var(--primary-accent);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        .continue-shopping {
            display: block;
            text-align: center;
            padding: 12px;
            color: var(--secondary-darker);
            text-decoration: none;
            margin-top: 15px;
            transition: var(--transition);
            border: 1px solid var(--secondary-darker);
            border-radius: 4px;
        }

        .continue-shopping:hover {
            background-color: var(--light-bg);
        }

        /* You May Also Like Section */
        .related-products.editable-section {
            padding: 60px 0;
            background-color: var(--light-bg);
            margin-top: 40px;
        }

        .section-title {
            font-size: 2.2rem;
            color: var(--secondary-darker);
            margin-bottom: 40px;
            text-align: center;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-top: 40px;
        }

        .product-card {
            background-color: white;
            border-radius: 4px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: var(--shadow-subtle);
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow);
        }

        .product-card-image {
            height: 250px;
            background-color: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-card-image img {
            max-width: 85%;
            max-height: 85%;
            object-fit: contain;
        }

        .product-card-info {
            padding: 20px;
        }

        .product-card-info h3 {
            font-size: 1.2rem;
            margin-bottom: 8px;
            color: var(--secondary-darker);
        }

        .product-card-info .product-price {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--primary-accent);
            margin-bottom: 15px;
        }

        .product-card-actions {
            display: flex;
            gap: 10px;
        }

        .temp-btn-view-details {
            flex: 1;
            padding: 8px 15px;
            background-color: var(--secondary-darker);
            color: white;
            text-decoration: none;
            border-radius: 4px;
            text-align: center;
            font-size: 14px;
            transition: var(--transition);
        }

        .temp-btn-view-details:hover {
            background-color: var(--primary-accent);
        }

        .temp-btn-add-cart-small {
            width: 40px;
            background-color: #f5f5f5;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .temp-btn-add-cart-small:hover {
            background-color: var(--primary-light);
            color: var(--primary-accent);
        }

        /* Responsive Styles */
        @media screen and (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media screen and (max-width: 992px) {
            .cart-container {
                grid-template-columns: 1fr;
            }
            
            .cart-summary {
                position: static;
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .cart-items-header {
                display: none;
            }
            
            .cart-item {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            
            .cart-item-info {
                width: 100%;
            }
        }

        @media screen and (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            
            .cart-header h1 {
                font-size: 2.2rem;
            }
            
            .section-title {
                font-size: 1.8rem;
            }
            
            .cart-item-image {
                width: 100px;
                height: 100px;
            }
        }

        @media screen and (max-width: 576px) {
            .products-grid {
                grid-template-columns: 1fr;
            }
            
            .cart-header h1 {
                font-size: 1.8rem;
            }
            
            .cart-item-info {
                flex-direction: column;
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <main>
        <!-- Breadcrumb -->
    <section class="breadcrumb editable-section" data-section="134">
        <div class="container">
            <div class="breadcrumb-content">
                <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="135" data-text="90">Home</a>
                <span class="breadcrumb-separator">/</span>
                <a href="?page=shop" class="editable-text editable-section no-drop-zone" data-section="136" data-text="91">Shop</a>
                <span class="breadcrumb-separator">/</span>
                <span class="editable-text editable-section no-drop-zone" data-section="137" data-text="92">Shopping Cart</span>
            </div>
        </div>
    </section>

    <!-- Cart Section -->
    <section class="cart-section editable-section" data-section="138">
        <div class="container">
            <div class="cart-header">
                <h1 class="editable-text editable-section no-drop-zone" data-section="139" data-text="93">Shopping Cart</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="140" data-text="94">Review your selected luxury footwear and proceed to checkout</p>
            </div>

            <!-- Cart Items -->
            <div class="cart-container">
                <!-- Cart Items -->
                <div class="cart-items editable-section no-drop-zone" data-section="141">
                    <div class="cart-items-header">
                        <div>Product</div>
                        <div>Price</div>
                        <div>Quantity</div>
                        <div>Total</div>
                        <div></div>
                    </div>

                    <!-- Sample Cart Item 1 (Editable) -->
                    <div class="cart-item editable-section no-drop-zone" data-section="142">
                        <div class="cart-item-info">
                            <div class="cart-item-image">
                                <img src="https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Classic Leather Loafers" class="editable-image" data-image="7">
                            </div>
                            <div class="cart-item-details">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="143" data-text="95">Classic Leather Loafers</h3>
                                <p>Size: <span class="editable-text editable-section no-drop-zone" data-section="144" data-text="96">9</span></p>
                                <div class="cart-item-color">
                                    <span>Color:</span>
                                    <div class="color-swatch" style="background-color: #8B4513;"></div>
                                    <span class="editable-text editable-section no-drop-zone" data-section="145" data-text="97">Chestnut Brown</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="cart-item-price editable-text editable-section no-drop-zone" data-section="146" data-text="98">$385</div>
                        
                        <div class="quantity-controls">
                            <button class="quantity-temp-btn">-</button>
                            <input type="number" class="quantity-input" value="1" min="1">
                            <button class="quantity-temp-btn">+</button>
                        </div>
                        
                        <div class="cart-item-total">$385</div>
                        
                        <div>
                            <button class="remove-item">
                                <i class="fas fa-trash-alt editable-icon" data-icon="14" data-default-class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Sample Cart Item 2 (Not editable) -->
                    <div class="cart-item">
                        <div class="cart-item-info">
                            <div class="cart-item-image">
                                <img src="https://images.unsplash.com/photo-1549298916-b41d501d3772?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Elegant Evening Heels">
                            </div>
                            <div class="cart-item-details">
                                <h3>Elegant Evening Heels</h3>
                                <p>Size: 8.5</p>
                                <div class="cart-item-color">
                                    <span>Color:</span>
                                    <div class="color-swatch" style="background-color: #2C2C2C;"></div>
                                    <span>Black</span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="cart-item-price">$450</div>
                        
                        <div class="quantity-controls">
                            <button class="quantity-temp-btn">-</button>
                            <input type="number" class="quantity-input" value="1" min="1">
                            <button class="quantity-temp-btn">+</button>
                        </div>
                        
                        <div class="cart-item-total">$450</div>
                        
                        <div>
                            <button class="remove-item">
                                <i class="fas fa-trash-alt editable-icon" data-icon="14" data-default-class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Cart Summary -->
                <div class="cart-summary editable-section no-drop-zone" data-section="147">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="148" data-text="99">Order Summary</h2>
                    
                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="149" data-text="100">Subtotal</span>
                        <span class="summary-value" id="subtotal">$835</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="150" data-text="101">Shipping</span>
                        <span class="summary-value" id="shipping">FREE</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="151" data-text="102">Tax</span>
                        <span class="summary-value" id="tax">$66.80</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="152" data-text="103">Total</span>
                        <span class="summary-value summary-total" id="total">$901.80</span>
                    </div>
                    
                    <button class="proceed-checkout editable-text editable-section no-drop-zone" data-section="153" data-text="104">
                        PROCEED TO CHECKOUT
                    </button>
                    
                    <a href="?page=shop" class="continue-shopping editable-text editable-section no-drop-zone" data-section="154" data-text="105">Continue Shopping</a>
                </div>
            </div>
        </div>
    </section>

    <!-- You May Also Like Section -->
    <section class="related-products editable-section" data-section="155">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="156" data-text="106">You May Also Like</h2>
            
            <div class="products-grid">
                <!-- Related Product 1 (Editable) -->
                <div class="product-card editable-section no-drop-zone" data-section="157">
                    <div class="product-card-image">
                        <img src="https://images.unsplash.com/photo-1608256246200-53e635b5b65f?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Designer Sneakers" class="editable-image" data-image="8">
                    </div>
                    <div class="product-card-info">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="158" data-text="107">Designer Luxury Sneakers</h3>
                        <div class="product-price editable-text editable-section no-drop-zone" data-section="159" data-text="108">$420</div>
                        <div class="product-card-actions">
                            <a href="?page=product&id=3" class="temp-btn-view-details editable-text editable-section no-drop-zone" data-section="160" data-text="109">View Details</a>
                            <button class="temp-btn-add-cart-small">
                                <i class="fas fa-cart-plus editable-icon" data-icon="15" data-default-class="fas fa-cart-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Related Product 2 (Not editable) -->
                <div class="product-card">
                    <div class="product-card-image">
                        <img src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Leather Boots">
                    </div>
                    <div class="product-card-info">
                        <h3>Leather Ankle Boots</h3>
                        <div class="product-price">$495</div>
                        <div class="product-card-actions">
                            <a href="?page=product&id=4" class="temp-btn-view-details">View Details</a>
                            <button class="temp-btn-add-cart-small">
                                <i class="fas fa-cart-plus editable-icon" data-icon="15" data-default-class="fas fa-cart-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Related Product 3 (Not editable) -->
                <div class="product-card">
                    <div class="product-card-image">
                        <img src="https://images.unsplash.com/photo-1600185365483-26d7a4cc7519?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Oxford Shoes">
                    </div>
                    <div class="product-card-info">
                        <h3>Classic Oxfords</h3>
                        <div class="product-price">$410</div>
                        <div class="product-card-actions">
                            <a href="?page=product&id=5" class="temp-btn-view-details">View Details</a>
                            <button class="temp-btn-add-cart-small">
                                <i class="fas fa-cart-plus editable-icon" data-icon="15" data-default-class="fas fa-cart-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Related Product 4 (Not editable) -->
                <div class="product-card">
                    <div class="product-card-image">
                        <img src="https://images.unsplash.com/photo-1551107696-a4b0c5a0d9a2?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Casual Loafers">
                    </div>
                    <div class="product-card-info">
                        <h3>Casual Suede Loafers</h3>
                        <div class="product-price">$365</div>
                        <div class="product-card-actions">
                            <a href="?page=product&id=6" class="temp-btn-view-details">View Details</a>
                            <button class="temp-btn-add-cart-small">
                                <i class="fas fa-cart-plus editable-icon" data-icon="15" data-default-class="fas fa-cart-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Empty Cart State (Hidden by default) -->
    <section class="empty-cart editable-section no-drop-zone" data-section="161" style="display: none;">
        <i class="fas fa-shopping-cart editable-icon" data-icon="16" data-default-class="fas fa-shopping-cart"></i>
        <h3 class="editable-text editable-section no-drop-zone" data-section="162" data-text="110">Your Cart is Empty</h3>
        <p class="editable-text editable-section no-drop-zone" data-section="163" data-text="111">Looks like you haven't added any luxury footwear to your cart yet.</p>
        <a href="?page=shop" class="shop-temp-btn editable-text editable-section no-drop-zone" data-section="164" data-text="112">CONTINUE SHOPPING</a>
    </section>
    </main>

    <script>
        // Sample cart functionality for editable template
        document.addEventListener('DOMContentLoaded', function() {
            // Quantity controls
            const quantitytemp-btns = document.querySelectorAll('.quantity-temp-btn');
            const quantityInputs = document.querySelectorAll('.quantity-input');
            
            quantitytemp-btns.forEach(temp-btn => {
                temp-btn.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('.quantity-input');
                    const isMinus = this.textContent === '-';
                    
                    let value = parseInt(input.value);
                    if (isMinus) {
                        if (value > 1) {
                            input.value = value - 1;
                        }
                    } else {
                        input.value = value + 1;
                    }
                    
                    // Update totals
                    updateItemTotal(this.closest('.cart-item'));
                    updateCartSummary();
                });
            });
            
            quantityInputs.forEach(input => {
                input.addEventListener('change', function() {
                    if (this.value < 1) this.value = 1;
                    updateItemTotal(this.closest('.cart-item'));
                    updateCartSummary();
                });
            });
            
            // Remove item buttons
            const removetemp-btns = document.querySelectorAll('.remove-item');
            removetemp-btns.forEach(temp-btn => {
                temp-btn.addEventListener('click', function() {
                    const item = this.closest('.cart-item');
                    if (confirm('Remove this item from cart?')) {
                        item.style.opacity = '0';
                        setTimeout(() => {
                            item.remove();
                            updateCartSummary();
                        }, 300);
                    }
                });
            });
            
            // Update item total
            function updateItemTotal(itemElement) {
                const priceElement = itemElement.querySelector('.cart-item-price');
                const quantityInput = itemElement.querySelector('.quantity-input');
                const totalElement = itemElement.querySelector('.cart-item-total');
                
                const price = parseFloat(priceElement.textContent.replace('$', ''));
                const quantity = parseInt(quantityInput.value);
                const total = price * quantity;
                
                totalElement.textContent = '$' + total.toFixed(0);
            }
            
            // Update cart summary
            function updateCartSummary() {
                const itemTotals = document.querySelectorAll('.cart-item-total');
                let subtotal = 0;
                
                itemTotals.forEach(totalElement => {
                    subtotal += parseFloat(totalElement.textContent.replace('$', ''));
                });
                
                const shipping = subtotal >= 100 ? 0 : 15;
                const tax = subtotal * 0.08;
                const total = subtotal + shipping + tax;
                
                document.getElementById('subtotal').textContent = '$' + subtotal.toFixed(0);
                document.getElementById('shipping').textContent = shipping === 0 ? 'FREE' : '$' + shipping.toFixed(0);
                document.getElementById('tax').textContent = '$' + tax.toFixed(2);
                document.getElementById('total').textContent = '$' + total.toFixed(2);
                
                // Update shipping color if free
                const shippingElement = document.getElementById('shipping');
                if (shipping === 0) {
                    shippingElement.style.color = 'var(--primary-accent)';
                    shippingElement.style.fontWeight = '600';
                }
            }
            
            // Proceed to checkout button
            const checkouttemp-btn = document.querySelector('.proceed-checkout');
            if (checkouttemp-btn) {
                checkouttemp-btn.addEventListener('click', function() {
                    alert('Proceeding to checkout... In a real application, this would redirect to the checkout page.');
                });
            }
            
            // Add to cart from suggestions
            const addCarttemp-btns = document.querySelectorAll('.temp-btn-add-cart-small');
            addCarttemp-btns.forEach(temp-btn => {
                temp-btn.addEventListener('click', function() {
                    alert('Product added to cart!');
                });
            });
            
            // Initialize
            updateCartSummary();
        });
    </script>
</body>
</html>