<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details | ÉLYSIUM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Product Details Hero */
        .product-details-hero.editable-section {
            padding: 160px 0 80px;
            background: linear-gradient(135deg, rgba(187, 194, 182, 0.05) 0%, rgba(239, 236, 228, 0.02) 100%);
        }
        
        .product-details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: start;
        }
        
        /* Product Images Section */
        .product-images {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .main-product-image {
            width: 100%;
            height: 600px;
            object-fit: cover;
            border-radius: 5px;
            background-color: var(--secondary-light);
        }
        
        .product-thumbnails {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding: 10px 0;
        }
        
        .product-thumbnail {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 3px;
            cursor: pointer;
            opacity: 0.7;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        
        .product-thumbnail:hover {
            opacity: 0.9;
        }
        
        .product-thumbnail.active {
            opacity: 1;
            border-color: var(--primary-accent);
        }
        
        /* Product Info Section */
        .product-info {
            padding-top: 20px;
        }
        
        .product-category.editable-text {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-accent);
            margin-bottom: 15px;
            font-weight: 400;
        }
        
        .product-title.editable-text {
            font-size: 48px;
            line-height: 1.2;
            margin-bottom: 20px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .product-price.editable-text {
            font-size: 32px;
            color: var(--primary-dark);
            margin-bottom: 25px;
            font-weight: 500;
        }
        
        .product-rating {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 30px;
        }
        
        .stars {
            display: flex;
            gap: 2px;
        }
        
        .stars i {
            color: var(--primary-accent);
            font-size: 16px;
        }
        
        .rating-count.editable-text {
            font-size: 14px;
            color: var(--primary-dark);
            opacity: 0.7;
        }
        
        .product-description.editable-text {
            font-size: 16px;
            line-height: 1.6;
            color: var(--primary-dark);
            margin-bottom: 40px;
            font-weight: 300;
        }
        
        /* Product Variants */
        .product-variants {
            margin-bottom: 40px;
        }
        
        .variant-group {
            margin-bottom: 25px;
        }
        
        .variant-label.editable-text {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-dark);
            margin-bottom: 12px;
            font-weight: 500;
            display: block;
        }
        
        .color-options {
            display: flex;
            gap: 12px;
        }
        
        .color-option {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }
        
        .color-option:hover {
            transform: scale(1.1);
        }
        
        .color-option.active {
            border-color: var(--primary-dark);
        }
        
        .size-options {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        
        .size-option {
            padding: 12px 20px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 50px;
            text-align: center;
        }
        
        .size-option:hover {
            border-color: var(--primary-accent);
        }
        
        .size-option.active {
            background-color: var(--primary-dark);
            color: var(--primary-light);
            border-color: var(--primary-dark);
        }
        
        .size-option.disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }
        
        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }
        
        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
        }
        
        .quantity-btn {
            width: 44px;
            height: 44px;
            background-color: var(--primary-light);
            color: var(--primary-dark);
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .quantity-input {
            width: 60px;
            height: 44px;
            text-align: center;
            border: none;
            background-color: var(--primary-light);
            color: var(--primary-dark);
            font-size: 16px;
            font-family: var(--font-sans);
        }
        
        .btn-add-to-cart-details {
            flex: 1;
            padding: 0 30px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 16px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            height: 44px;
        }
        
        .btn-add-to-cart-details:hover {
            background-color: var(--primary-dark);
        }
        
        .btn-wishlist-details {
            width: 44px;
            height: 44px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .btn-wishlist-details:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        .product-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            margin-top: 40px;
            padding-top: 40px;
            border-top: 1px solid rgba(187, 194, 182, 0.3);
        }
        
        .meta-item {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .meta-label.editable-text {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-dark);
            opacity: 0.7;
        }
        
        .meta-value.editable-text {
            font-size: 14px;
            color: var(--primary-dark);
        }
        
        /* Reviews Section */
        .reviews-section.editable-section {
            padding: 80px 0;
            background-color: var(--primary-light);
        }
        
        .section-title.editable-text {
            font-size: 36px;
            margin-bottom: 50px;
            color: var(--primary-dark);
            font-weight: 500;
            text-align: center;
        }
        
        .reviews-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            margin-bottom: 60px;
        }
        
        /* Review Form */
        .review-form {
            background-color: rgba(187, 194, 182, 0.05);
            padding: 40px;
            border-radius: 5px;
            border: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .review-form-title.editable-text {
            font-size: 24px;
            margin-bottom: 25px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .rating-input {
            margin-bottom: 25px;
        }
        
        .rating-input label.editable-text {
            display: block;
            margin-bottom: 10px;
            font-size: 14px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .star-rating-input {
            display: flex;
            gap: 5px;
            direction: rtl;
        }
        
        .star-rating-input input {
            display: none;
        }
        
        .star-rating-input label {
            font-size: 24px;
            color: var(--secondary-light);
            cursor: pointer;
            transition: color 0.3s ease;
        }
        
        .star-rating-input label:hover,
        .star-rating-input label:hover ~ label,
        .star-rating-input input:checked ~ label {
            color: var(--primary-accent);
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label.editable-text {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .form-control {
            width: 100%;
            padding: 12px 16px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            font-family: var(--font-sans);
            font-size: 14px;
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--primary-accent);
        }
        
        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }
        
        .btn-submit-review {
            padding: 14px 30px;
            background-color: var(--primary-dark);
            color: var(--primary-light);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            width: 100%;
        }
        
        .btn-submit-review:hover {
            background-color: var(--primary-accent);
        }
        
        /* Customer Reviews */
        .customer-reviews {
            max-height: 600px;
            overflow-y: auto;
            padding-right: 20px;
        }
        
        .customer-reviews::-webkit-scrollbar {
            width: 4px;
        }
        
        .customer-reviews::-webkit-scrollbar-track {
            background: rgba(187, 194, 182, 0.1);
        }
        
        .customer-reviews::-webkit-scrollbar-thumb {
            background: var(--secondary-light);
            border-radius: 2px;
        }
        
        .review-item {
            padding: 25px 0;
            border-bottom: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .review-item:last-child {
            border-bottom: none;
        }
        
        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }
        
        .reviewer-name.editable-text {
            font-size: 16px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .review-date.editable-text {
            font-size: 12px;
            color: var(--primary-dark);
            opacity: 0.7;
        }
        
        .review-rating {
            margin-bottom: 10px;
        }
        
        .review-content.editable-text {
            font-size: 14px;
            line-height: 1.6;
            color: var(--primary-dark);
            opacity: 0.9;
        }
        
        /* Related Products Section */
        .related-products.editable-section {
            padding: 80px 0 120px;
            background-color: var(--primary-light);
        }
        
        .related-products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }
        
        .related-product-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
        }
        
        .related-product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(98, 102, 75, 0.1);
        }
        
        .related-product-img {
            height: 250px;
            width: 100%;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .related-product-info {
            padding: 20px;
        }
        
        .related-product-name {
            font-size: 18px;
            margin-bottom: 8px;
            font-weight: 500;
            font-family: var(--font-serif);
            color: var(--primary-dark);
        }
        
        .related-product-price {
            font-size: 18px;
            font-weight: 500;
            color: var(--primary-dark);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .product-details-container {
                gap: 60px;
            }
            
            .main-product-image {
                height: 500px;
            }
            
            .related-products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        
        @media (max-width: 992px) {
            .product-details-container {
                grid-template-columns: 1fr;
                gap: 50px;
            }
            
            .product-title.editable-text {
                font-size: 40px;
            }
            
            .reviews-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .customer-reviews {
                max-height: 400px;
            }
            
            .related-products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media (max-width: 768px) {
            .product-details-hero.editable-section {
                padding: 140px 0 60px;
            }
            
            .product-title.editable-text {
                font-size: 36px;
            }
            
            .product-price.editable-text {
                font-size: 28px;
            }
            
            .product-actions {
                flex-wrap: wrap;
            }
            
            .quantity-selector {
                order: 1;
            }
            
            .btn-add-to-cart-details {
                order: 2;
                flex: 100%;
            }
            
            .btn-wishlist-details {
                order: 3;
            }
            
            .section-title.editable-text {
                font-size: 32px;
            }
            
            .main-product-image {
                height: 400px;
            }
        }
        
        @media (max-width: 576px) {
            .product-thumbnails {
                justify-content: center;
            }
            
            .product-title.editable-text {
                font-size: 32px;
            }
            
            .size-options {
                justify-content: center;
            }
            
            .review-form {
                padding: 25px;
            }
            
            .related-products-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            
            .product-meta {
                flex-direction: column;
                gap: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Product Details Hero -->
    <section class="product-details-hero editable-section" data-section="107">
        <div class="container">
            <div class="product-details-container">
                <!-- Product Images -->
                <div class="product-images">
                    <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80" alt="The Sofia Blazer" class="main-product-image" id="mainProductImage">
                    
                    <div class="product-thumbnails">
                        <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Blazer Front" class="product-thumbnail active" data-image="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80">
                        
                        <img src="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Blazer Back" class="product-thumbnail" data-image="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80">
                        
                        <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Blazer Detail" class="product-thumbnail" data-image="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80">
                        
                        <img src="https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Blazer Fabric" class="product-thumbnail" data-image="https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80">
                        
                        <img src="https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Blazer On Model" class="product-thumbnail" data-image="https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1470&q=80">
                    </div>
                </div>
                
                <!-- Product Info -->
                <div class="product-info">
                    <div class="product-category editable-text editable-section no-drop-zone" data-section="108" data-text="76">Tailored Collection</div>
                    <h1 class="product-title editable-text editable-section no-drop-zone" data-section="109" data-text="77">The Sofia Blazer</h1>
                    <div class="product-price editable-text editable-section no-drop-zone" data-section="110" data-text="78">$485</div>
                    
                    <div class="product-rating">
                        <div class="stars">
                            <i class="fas fa-star editable-icon" data-icon="44" data-default-class="fas fa-star"></i>
                            <i class="fas fa-star editable-icon" data-icon="44" data-default-class="fas fa-star"></i>
                            <i class="fas fa-star editable-icon" data-icon="44" data-default-class="fas fa-star"></i>
                            <i class="fas fa-star editable-icon" data-icon="44" data-default-class="fas fa-star"></i>
                            <i class="fas fa-star-half-alt editable-icon" data-icon="45" data-default-class="fas fa-star-half-alt"></i>
                        </div>
                        <span class="rating-count editable-text editable-section no-drop-zone" data-section="111" data-text="79">4.5 (128 Reviews)</span>
                    </div>
                    
                    <p class="product-description editable-text editable-section no-drop-zone" data-section="112" data-text="80">Expertly tailored from a premium wool-blend fabric, The Sofia Blazer features structured shoulders, peak lapels, and a silk lining for luxurious comfort. Designed for both professional settings and sophisticated evenings, this piece embodies timeless elegance with modern tailoring.</p>
                    
                    <!-- Product Variants -->
                    <div class="product-variants">
                        <div class="variant-group">
                            <span class="variant-label editable-text editable-section no-drop-zone" data-section="113" data-text="81">Color</span>
                            <div class="color-options">
                                <div class="color-option active" style="background-color: #62664B;" data-color="Sage Green"></div>
                                <div class="color-option" style="background-color: #2C2C2C;" data-color="Charcoal Black"></div>
                                <div class="color-option" style="background-color: #8B7355;" data-color="Camel Tan"></div>
                                <div class="color-option" style="background-color: #4A5D5F;" data-color="Slate Blue"></div>
                            </div>
                        </div>
                        
                        <div class="variant-group">
                            <span class="variant-label editable-text editable-section no-drop-zone" data-section="114" data-text="82">Size</span>
                            <div class="size-options">
                                <div class="size-option active" data-size="XS">XS</div>
                                <div class="size-option" data-size="S">S</div>
                                <div class="size-option" data-size="M">M</div>
                                <div class="size-option" data-size="L">L</div>
                                <div class="size-option disabled" data-size="XL">XL</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Product Actions -->
                    <div class="product-actions">
                        <div class="quantity-selector">
                            <button class="quantity-btn" id="decreaseQty">-</button>
                            <input type="text" class="quantity-input" value="1" id="quantityInput" readonly>
                            <button class="quantity-btn" id="increaseQty">+</button>
                        </div>
                        
                        <button class="btn-add-to-cart-details editable-text editable-section no-drop-zone" data-section="115" data-text="83">
                            <i class="fas fa-shopping-bag editable-icon" data-icon="46" data-default-class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                        
                        <button class="btn-wishlist-details" id="wishlistBtn">
                            <i class="far fa-heart editable-icon" data-icon="47" data-default-class="far fa-heart"></i>
                        </button>
                    </div>
                    
                    <!-- Product Meta -->
                    <div class="product-meta">
                        <div class="meta-item">
                            <span class="meta-label editable-text editable-section no-drop-zone" data-section="116" data-text="84">Material</span>
                            <span class="meta-value editable-text editable-section no-drop-zone" data-section="117" data-text="85">Wool-Blend, Silk Lining</span>
                        </div>
                        
                        <div class="meta-item">
                            <span class="meta-label editable-text editable-section no-drop-zone" data-section="118" data-text="86">Care</span>
