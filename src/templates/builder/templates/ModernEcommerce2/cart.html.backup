<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | ÉLYSIUM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Cart Hero Section */
        .cart-hero.editable-section {
            padding: 160px 0 60px;
            background: linear-gradient(135deg, rgba(187, 194, 182, 0.05) 0%, rgba(239, 236, 228, 0.02) 100%);
            text-align: center;
        }
        
        .cart-hero h1.editable-text {
            font-size: 48px;
            line-height: 1.1;
            margin-bottom: 15px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .cart-hero p.editable-text {
            font-size: 18px;
            line-height: 1.6;
            color: var(--primary-dark);
            font-weight: 300;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Cart Content */
        .cart-content.editable-section {
            padding: 60px 0 120px;
        }
        
        .cart-container {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 60px;
        }
        
        /* Cart Items Section */
        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }
        
        .cart-item {
            display: grid;
            grid-template-columns: 120px 1fr auto;
            gap: 25px;
            padding: 30px;
            background-color: var(--primary-light);
            border-radius: 5px;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
            transition: all 0.3s ease;
            position: relative;
        }
        
        .cart-item:hover {
            box-shadow: 0 10px 25px rgba(98, 102, 75, 0.1);
            transform: translateY(-2px);
        }
        
        .cart-item-image {
            width: 120px;
            height: 150px;
            object-fit: cover;
            border-radius: 3px;
            background-color: var(--secondary-light);
        }
        
        .cart-item-details {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        
        .cart-item-title.editable-text {
            font-size: 20px;
            font-family: var(--font-serif);
            color: var(--primary-dark);
            margin-bottom: 8px;
            font-weight: 500;
        }
        
        .cart-item-variant {
            font-size: 14px;
            color: var(--primary-accent);
            margin-bottom: 5px;
        }
        
        .cart-item-size, .cart-item-color {
            font-size: 14px;
            color: var(--primary-dark);
            opacity: 0.8;
            margin-bottom: 3px;
        }
        
        .cart-item-actions {
            display: flex;
            gap: 15px;
            margin-top: 15px;
        }
        
        .quantity-selector-cart {
            display: flex;
            align-items: center;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
        }
        
        .quantity-btn-cart {
            width: 36px;
            height: 36px;
            background-color: var(--primary-light);
            color: var(--primary-dark);
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .quantity-input-cart {
            width: 50px;
            height: 36px;
            text-align: center;
            border: none;
            background-color: var(--primary-light);
            color: var(--primary-dark);
            font-size: 16px;
            font-family: var(--font-sans);
        }
        
        .btn-remove-item {
            padding: 8px 16px;
            background-color: transparent;
            color: var(--primary-dark);
            font-size: 14px;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .btn-remove-item:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        .cart-item-price {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-end;
            text-align: right;
        }
        
        .item-price {
            font-size: 22px;
            color: var(--primary-dark);
            font-weight: 500;
            margin-bottom: 10px;
        }
        
        .item-subtotal {
            font-size: 14px;
            color: var(--primary-dark);
            opacity: 0.7;
        }
        
        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: 80px 20px;
            background-color: var(--primary-light);
            border-radius: 5px;
            border: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .empty-cart-icon {
            font-size: 64px;
            color: var(--secondary-light);
            margin-bottom: 25px;
        }
        
        .empty-cart-title.editable-text {
            font-size: 28px;
            color: var(--primary-dark);
            margin-bottom: 15px;
            font-weight: 500;
        }
        
        .empty-cart-message.editable-text {
            font-size: 16px;
            color: var(--primary-dark);
            opacity: 0.8;
            margin-bottom: 30px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .btn-continue-shopping {
            padding: 14px 30px;
            background-color: var(--primary-dark);
            color: var(--primary-light);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        
        .btn-continue-shopping:hover {
            background-color: var(--primary-accent);
        }
        
        /* Cart Summary */
        .cart-summary {
            background-color: var(--primary-light);
            border-radius: 5px;
            padding: 35px;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
            position: sticky;
            top: 120px;
            height: fit-content;
        }
        
        .summary-title.editable-text {
            font-size: 24px;
            color: var(--primary-dark);
            margin-bottom: 25px;
            font-weight: 500;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(187, 194, 182, 0.3);
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 16px;
            color: var(--primary-dark);
        }
        
        .summary-label {
            opacity: 0.8;
        }
        
        .summary-value {
            font-weight: 500;
        }
        
        .summary-row.total {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(187, 194, 182, 0.3);
            font-size: 20px;
            color: var(--primary-dark);
        }
        
        .summary-row.total .summary-value {
            font-weight: 600;
        }
        
        .shipping-note.editable-text {
            font-size: 14px;
            color: var(--primary-accent);
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(187, 194, 182, 0.2);
            text-align: center;
        }
        
        .btn-checkout {
            width: 100%;
            padding: 16px 30px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 16px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        
        .btn-checkout:hover {
            background-color: var(--primary-dark);
        }
        
        .btn-checkout:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .btn-checkout:disabled:hover {
            background-color: var(--primary-accent);
        }
        
        .payment-methods {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
            opacity: 0.7;
        }
        
        .payment-methods i {
            font-size: 24px;
        }
        
        /* Promo Code Section */
        .promo-code {
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .promo-title.editable-text {
            font-size: 16px;
            color: var(--primary-dark);
            margin-bottom: 12px;
            font-weight: 500;
        }
        
        .promo-form {
            display: flex;
            gap: 10px;
        }
        
        .promo-input {
            flex: 1;
            padding: 12px 16px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            font-family: var(--font-sans);
            font-size: 14px;
            border-radius: 2px;
        }
        
        .promo-input:focus {
            outline: none;
            border-color: var(--primary-accent);
        }
        
        .btn-apply-promo {
            padding: 12px 20px;
            background-color: var(--primary-dark);
            color: var(--primary-light);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            white-space: nowrap;
        }
        
        .btn-apply-promo:hover {
            background-color: var(--primary-accent);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .cart-container {
                grid-template-columns: 1fr 350px;
                gap: 40px;
            }
        }
        
        @media (max-width: 992px) {
            .cart-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .cart-summary {
                position: static;
                max-width: 500px;
                margin: 0 auto;
            }
            
            .cart-hero h1.editable-text {
                font-size: 40px;
            }
        }
        
        @media (max-width: 768px) {
            .cart-hero {
                padding: 140px 0 40px;
            }
            
            .cart-hero h1.editable-text {
                font-size: 36px;
            }
            
            .cart-hero p.editable-text {
                font-size: 16px;
            }
            
            .cart-content.editable-section {
                padding: 40px 0 80px;
            }
            
            .cart-item {
                grid-template-columns: 100px 1fr;
                gap: 20px;
                padding: 20px;
            }
            
            .cart-item-price {
                grid-column: 1 / -1;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                text-align: left;
                padding-top: 15px;
                border-top: 1px solid rgba(187, 194, 182, 0.2);
            }
            
            .item-price {
                margin-bottom: 0;
            }
            
            .cart-item-image {
                width: 100px;
                height: 120px;
            }
        }
        
        @media (max-width: 576px) {
            .cart-item {
                grid-template-columns: 1fr;
            }
            
            .cart-item-image {
                width: 100%;
                height: 200px;
            }
            
            .cart-item-price {
                grid-column: 1;
            }
            
            .cart-summary {
                padding: 25px;
            }
            
            .promo-form {
                flex-direction: column;
            }
            
            .btn-apply-promo {
                width: 100%;
            }
            
            .empty-cart {
                padding: 60px 15px;
            }
            
            .empty-cart-title.editable-text {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <!-- Cart Hero Section -->
    <section class="cart-hero editable-section" data-section="135">
        <div class="container">
            <h1 class="editable-text editable-section no-drop-zone" data-section="136" data-text="101">Your Shopping Cart</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="137" data-text="102">Review your selected items and proceed to checkout</p>
        </div>
    </section>
    
    <!-- Cart Content -->
    <section class="cart-content editable-section" data-section="138">
        <div class="container">
            <div class="cart-container">
                <!-- Cart Items -->
                <div class="cart-items">
                    <!-- Cart Item 1 -->
                    <div class="cart-item">
                        <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="The Sofia Blazer" class="cart-item-image">
                        
                        <div class="cart-item-details">
                            <h3 class="cart-item-title editable-text editable-section no-drop-zone" data-section="139" data-text="103">The Sofia Blazer</h3>
                            <div class="cart-item-variant">Tailored Collection</div>
                            <div class="cart-item-color">Color: Sage Green</div>
                            <div class="cart-item-size">Size: M</div>
                            
                            <div class="cart-item-actions">
                                <div class="quantity-selector-cart">
                                    <button class="quantity-btn-cart decrease-btn">-</button>
                                    <input type="text" class="quantity-input-cart" value="1" readonly>
                                    <button class="quantity-btn-cart increase-btn">+</button>
                                </div>
                                
                                <button class="btn-remove-item">
                                    <i class="far fa-trash-alt editable-icon" data-icon="48" data-default-class="far fa-trash-alt"></i> Remove
                                </button>
                            </div>
                        </div>
                        
                        <div class="cart-item-price">
                            <div class="item-price editable-text editable-section no-drop-zone" data-section="140" data-text="104">$485</div>
                            <div class="item-subtotal">Subtotal: $485</div>
                        </div>
                    </div>
                    
                    <!-- Cart Item 2 -->
                    <div class="cart-item">
                        <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Silk Evening Gown" class="cart-item-image">
                        
                        <div class="cart-item-details">
                            <h3 class="cart-item-title">Silk Evening Gown</h3>
                            <div class="cart-item-variant">Evening Wear</div>
                            <div class="cart-item-color">Color: Ivory</div>
                            <div class="cart-item-size">Size: S</div>
                            
                            <div class="cart-item-actions">
                                <div class="quantity-selector-cart">
                                    <button class="quantity-btn-cart decrease-btn">-</button>
                                    <input type="text" class="quantity-input-cart" value="1" readonly>
                                    <button class="quantity-btn-cart increase-btn">+</button>
                                </div>
                                
                                <button class="btn-remove-item">
                                    <i class="far fa-trash-alt"></i> Remove
                                </button>
                            </div>
                        </div>
                        
                        <div class="cart-item-price">
                            <div class="item-price">$920</div>
                            <div class="item-subtotal">Subtotal: $920</div>
                        </div>
                    </div>
                    
                    <!-- Cart Item 3 -->
                    <div class="cart-item">
                        <img src="https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" alt="Leather Tote Bag" class="cart-item-image">
                        
                        <div class="cart-item-details">
                            <h3 class="cart-item-title">Leather Tote Bag</h3>
                            <div class="cart-item-variant">Accessories</div>
                            <div class="cart-item-color">Color: Tan</div>
                            <div class="cart-item-size">Size: One Size</div>
                            
                            <div class="cart-item-actions">
                                <div class="quantity-selector-cart">
                                    <button class="quantity-btn-cart decrease-btn">-</button>
                                    <input type="text" class="quantity-input-cart" value="1" readonly>
                                    <button class="quantity-btn-cart increase-btn">+</button>
                                </div>
                                
                                <button class="btn-remove-item">
                                    <i class="far fa-trash-alt"></i> Remove
                                </button>
                            </div>
                        </div>
                        
                        <div class="cart-item-price">
                            <div class="item-price">$395</div>
                            <div class="item-subtotal">Subtotal: $395</div>
                        </div>
                    </div>
                    
                    <!-- Empty Cart State (Hidden by default) -->
                    <div class="empty-cart" style="display: none;">
                        <div class="empty-cart-icon">
                            <i class="fas fa-shopping-bag editable-icon" data-icon="49" data-default-class="fas fa-shopping-bag"></i>
                        </div>
                        <h2 class="empty-cart-title editable-text editable-section no-drop-zone" data-section="141" data-text="105">Your Cart is Empty</h2>
                        <p class="empty-cart-message editable-text editable-section no-drop-zone" data-section="142" data-text="106">Looks like you haven't added any items to your cart yet. Start shopping to discover our luxury collection.</p>
                        <a href="?page=shop" class="btn-continue-shopping editable-text editable-section no-drop-zone" data-section="143" data-text="107">
                            <i class="fas fa-arrow-left editable-icon" data-icon="50" data-default-class="fas fa-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>
                
                <!-- Cart Summary -->
                <div class="cart-summary">
                    <h2 class="summary-title editable-text editable-section no-drop-zone" data-section="144" data-text="108">Order Summary</h2>

                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="147" data-text="111">Items</span>
                        <span class="summary-value" id="tax">3</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="145" data-text="109">Subtotal</span>
                        <span class="summary-value" id="subtotal">$1,800</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="146" data-text="110">Shipping</span>
                        <span class="summary-value" id="shipping">$0.00</span>
                    </div>
                    
    
                    
                    <div class="summary-row">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="148" data-text="112">Discount</span>
                        <span class="summary-value" id="discount">-$0.00</span>
                    </div>
                    
                    <div class="summary-row total">
                        <span class="summary-label editable-text editable-section no-drop-zone" data-section="149" data-text="113">Total</span>
                        <span class="summary-value" id="total">$1,944.00</span>
                    </div>
                    
                    <p class="shipping-note editable-text editable-section no-drop-zone" data-section="150" data-text="114">Free shipping on all orders over $200</p>
                    
                    <!-- Promo Code Section -->
                    <div class="promo-code">
                        <h3 class="promo-title editable-text editable-section no-drop-zone" data-section="151" data-text="115">Promo Code</h3>
                        <div class="promo-form">
                            <input type="text" class="promo-input" placeholder="Enter code" id="promoInput">
                            <button class="btn-apply-promo editable-text editable-section no-drop-zone" data-section="152" data-text="116">Apply</button>
                        </div>
                    </div>
                    
                    <button class="btn-checkout editable-text editable-section no-drop-zone" data-section="153" data-text="117">
                        <i class="fas fa-lock editable-icon" data-icon="51" data-default-class="fas fa-lock"></i> Proceed to Checkout
                    </button>
                    
                    <div class="payment-methods">
                        <i class="fab fa-cc-visa editable-icon" data-icon="52" data-default-class="fab fa-cc-visa"></i>
                        <i class="fab fa-cc-mastercard editable-icon" data-icon="53" data-default-class="fab fa-cc-mastercard"></i>
                        <i class="fab fa-cc-amex editable-icon" data-icon="54" data-default-class="fab fa-cc-amex"></i>
                        <i class="fab fa-cc-paypal editable-icon" data-icon="55" data-default-class="fab fa-cc-paypal"></i>
                        <i class="fab fa-apple-pay editable-icon" data-icon="56" data-default-class="fab fa-apple-pay"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <script>
        // Cart Management Variables
        let cartItems = [
            {
                id: 1,
                name: "The Sofia Blazer",
                variant: "Tailored Collection",
                color: "Sage Green",
                size: "M",
                price: 485,
                quantity: 1,
                image: "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80"
            },
            {
                id: 2,
                name: "Silk Evening Gown",
                variant: "Evening Wear",
                color: "Ivory",
                size: "S",
                price: 920,
                quantity: 1,
                image: "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80"
            },
            {
                id: 3,
                name: "Leather Tote Bag",
                variant: "Accessories",
                color: "Tan",
                size: "One Size",
                price: 395,
                quantity: 1,
                image: "https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80"
            }
        ];
        
        let discountApplied = false;
        let discountAmount = 0;
        
        // Initialize cart
        updateCartDisplay();
        
        // Quantity Update Functions
        document.querySelectorAll('.increase-btn').forEach((btn, index) => {
            btn.addEventListener('click', function() {
                updateQuantity(index, 1);
            });
        });
        
        document.querySelectorAll('.decrease-btn').forEach((btn, index) => {
            btn.addEventListener('click', function() {
                updateQuantity(index, -1);
            });
        });
        
        function updateQuantity(itemIndex, change) {
            const newQuantity = cartItems[itemIndex].quantity + change;
            
            if (newQuantity < 1) {
                // Remove item if quantity becomes 0
                removeItem(itemIndex);
                return;
            }
            
            if (newQuantity > 10) {
                alert('Maximum quantity per item is 10');
                return;
            }
            
            cartItems[itemIndex].quantity = newQuantity;
            
            // Update the quantity input
            const quantityInputs = document.querySelectorAll('.quantity-input-cart');
            quantityInputs[itemIndex].value = newQuantity;
            
            // Update subtotal for this item
            const itemSubtotals = document.querySelectorAll('.item-subtotal');
            const itemPrice = cartItems[itemIndex].price;
            itemSubtotals[itemIndex].textContent = `Subtotal: $${(itemPrice * newQuantity).toFixed(2)}`;
            
            updateCartTotals();
        }
        
        // Remove Item Function
        document.querySelectorAll('.btn-remove-item').forEach((btn, index) => {
            btn.addEventListener('click', function() {
                removeItem(index);
            });
        });
        
        function removeItem(itemIndex) {
            if (confirm('Are you sure you want to remove this item from your cart?')) {
                cartItems.splice(itemIndex, 1);
                updateCartDisplay();
            }
        }
        
        // Update Cart Display
        function updateCartDisplay() {
            const cartItemsContainer = document.querySelector('.cart-items');
            const emptyCart = document.querySelector('.empty-cart');
            const regularCartItems = document.querySelectorAll('.cart-item:not(.empty-cart)');
            
            if (cartItems.length === 0) {
                // Show empty cart message
                regularCartItems.forEach(item => item.style.display = 'none');
                emptyCart.style.display = 'block';
                document.querySelector('.btn-checkout').disabled = true;
            } else {
                // Hide empty cart message
                emptyCart.style.display = 'none';
                regularCartItems.forEach(item => item.style.display = 'grid');
                document.querySelector('.btn-checkout').disabled = false;
                
                // Update item count display
                const itemCount = cartItems.reduce((total, item) => total + item.quantity, 0);
                document.querySelector('.cart-hero p').textContent = `You have ${itemCount} item${itemCount !== 1 ? 's' : ''} in your cart`;
            }
            
            updateCartTotals();
        }
        
        // Update Cart Totals
        function updateCartTotals() {
            let subtotal = 0;
            
            // Calculate subtotal
            cartItems.forEach(item => {
                subtotal += item.price * item.quantity;
            });
            
            // Calculate shipping (free over $200)
            const shipping = subtotal >= 200 ? 0 : 15;
            
            // Calculate tax (8%)
            const tax = subtotal * 0.08;
            
            // Apply discount if any
            const discount = discountApplied ? discountAmount : 0;
            
            // Calculate total
            const total = subtotal + shipping + tax - discount;
            
            // Update display
            document.getElementById('subtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('shipping').textContent = shipping === 0 ? 'FREE' : `$${shipping.toFixed(2)}`;
            document.getElementById('tax').textContent = `$${tax.toFixed(2)}`;
            document.getElementById('discount').textContent = discount === 0 ? '$0.00' : `-$${discount.toFixed(2)}`;
            document.getElementById('total').textContent = `$${total.toFixed(2)}`;
            
            // Update shipping note
            const shippingNote = document.querySelector('.shipping-note');
            if (subtotal >= 200) {
                shippingNote.textContent = '✓ Free shipping applied';
                shippingNote.style.color = 'var(--primary-accent)';
            } else {
                shippingNote.textContent = `Add $${(200 - subtotal).toFixed(2)} more for free shipping`;
                shippingNote.style.color = 'var(--primary-accent)';
            }
        }
        
        // Promo Code Application
        const applyPromoBtn = document.querySelector('.btn-apply-promo');
        const promoInput = document.getElementById('promoInput');
        
        applyPromoBtn.addEventListener('click', function() {
            const promoCode = promoInput.value.trim().toUpperCase();
            
            if (!promoCode) {
                alert('Please enter a promo code');
                return;
            }
            
            // Check promo code (in real implementation, this would be server-side)
            if (promoCode === 'ELYSIUM10') {
                discountApplied = true;
                const subtotal = cartItems.reduce((total, item) => total + (item.price * item.quantity), 0);
                discountAmount = subtotal * 0.1; // 10% discount
                
                updateCartTotals();
                alert('Promo code applied! 10% discount has been added to your order.');
                promoInput.value = '';
                promoInput.disabled = true;
                applyPromoBtn.textContent = 'Applied';
                applyPromoBtn.disabled = true;
            } else if (promoCode === 'FREESHIP') {
                // This would be handled in the shipping calculation
                alert('Free shipping code applied! Shipping will be free for this order.');
                promoInput.value = '';
                promoInput.disabled = true;
                applyPromoBtn.textContent = 'Applied';
                applyPromoBtn.disabled = true;
            } else {
                alert('Invalid promo code. Please try again.');
                promoInput.value = '';
                promoInput.focus();
            }
        });
        
        // Enter key for promo code
        promoInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                applyPromoBtn.click();
            }
        });
        
        // Proceed to Checkout
        const checkoutBtn = document.querySelector('.btn-checkout');
        
        checkoutBtn.addEventListener('click', function() {
            if (cartItems.length === 0) {
                alert('Your cart is empty. Add items to proceed to checkout.');
                return;
            }
            
            // In a real implementation, this would redirect to checkout page
            // For demo, we'll show a confirmation message
            const total = document.getElementById('total').textContent;
            const itemCount = cartItems.reduce((total, item) => total + item.quantity, 0);
            
            alert(`Proceeding to checkout with ${itemCount} item${itemCount !== 1 ? 's' : ''} totaling ${total}. In a real implementation, you would be redirected to the checkout page.`);
            
            // Simulate checkout process
            console.log('Checkout initiated with items:', cartItems);
            console.log('Total amount:', total);
        });
        
        // Continue Shopping Button (for empty cart)
        const continueShoppingBtn = document.querySelector('.btn-continue-shopping');
        
        if (continueShoppingBtn) {
            continueShoppingBtn.addEventListener('click', function(e) {
                e.preventDefault();
                // In a real implementation, this would navigate to the shop page
                console.log('Redirecting to shop page');
                // window.location.href = '?page=shop';
            });
        }
    </script>
</body>
</html>