<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About | ÉLYSIUM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* About Hero Section */
        .about-hero.editable-section {
            padding: 160px 0 100px;
            background: linear-gradient(135deg, rgba(98, 102, 75, 0.05) 0%, rgba(239, 236, 228, 0.02) 100%);
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .about-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg width='120' height='120' viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%2362664b' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.3;
            z-index: 0;
        }
        
        .about-hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .about-hero h1.editable-text {
            font-size: 56px;
            line-height: 1.1;
            margin-bottom: 20px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .about-hero p.editable-text {
            font-size: 20px;
            line-height: 1.7;
            color: var(--primary-dark);
            font-weight: 300;
            opacity: 0.9;
        }
        
        /* Story Section */
        .story-section.editable-section {
            padding: 100px 0;
            background-color: var(--primary-light);
        }
        
        .story-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }
        
        .story-content {
            padding-right: 40px;
        }
        
        .story-title.editable-text {
            font-size: 40px;
            margin-bottom: 30px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .story-text.editable-text {
            font-size: 18px;
            line-height: 1.8;
            color: var(--primary-dark);
            margin-bottom: 20px;
            opacity: 0.8;
        }
        
        .story-image-container {
            position: relative;
        }
        
        .story-image {
            width: 100%;
            height: 600px;
            object-fit: cover;
            border-radius: 5px;
            background-color: var(--secondary-light);
        }
        
        .story-year.editable-text {
            position: absolute;
            bottom: -30px;
            right: -30px;
            font-size: 120px;
            font-weight: 600;
            color: var(--primary-accent);
            opacity: 0.2;
            font-family: var(--font-serif);
            line-height: 1;
        }
        
        /* Values Section */
        .values-section.editable-section {
            padding: 100px 0;
            background-color: rgba(187, 194, 182, 0.05);
        }
        
        .values-title.editable-text {
            font-size: 40px;
            text-align: center;
            margin-bottom: 70px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .values-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 50px;
        }
        
        .value-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            padding: 40px;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.1);
            text-align: center;
        }
        
        .value-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(98, 102, 75, 0.1);
        }
        
        .value-icon {
            font-size: 48px;
            color: var(--primary-accent);
            margin-bottom: 25px;
        }
        
        .value-title.editable-text {
            font-size: 24px;
            margin-bottom: 15px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .value-description.editable-text {
            font-size: 16px;
            line-height: 1.6;
            color: var(--primary-dark);
            opacity: 0.8;
        }
        
        /* Team Section */
        .team-section.editable-section {
            padding: 100px 0;
            background-color: var(--primary-light);
        }
        
        .team-title.editable-text {
            font-size: 40px;
            text-align: center;
            margin-bottom: 70px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
        }
        
        .team-member {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
        }
        
        .team-member:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(98, 102, 75, 0.1);
        }
        
        .team-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .team-info {
            padding: 25px;
            text-align: center;
        }
        
        .team-name.editable-text {
            font-size: 22px;
            margin-bottom: 5px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .team-role.editable-text {
            font-size: 16px;
            color: var(--primary-accent);
            margin-bottom: 15px;
        }
        
        .team-bio.editable-text {
            font-size: 14px;
            line-height: 1.6;
            color: var(--primary-dark);
            opacity: 0.8;
        }
        
        /* Sustainability Section */
        .sustainability-section.editable-section {
            padding: 100px 0;
            background-color: rgba(187, 194, 182, 0.05);
        }
        
        .sustainability-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
            align-items: center;
        }
        
        .sustainability-image {
            width: 100%;
            height: 500px;
            object-fit: cover;
            border-radius: 5px;
            background-color: var(--secondary-light);
        }
        
        .sustainability-content {
            padding-left: 40px;
        }
        
        .sustainability-title.editable-text {
            font-size: 40px;
            margin-bottom: 30px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .sustainability-text.editable-text {
            font-size: 18px;
            line-height: 1.8;
            color: var(--primary-dark);
            margin-bottom: 20px;
            opacity: 0.8;
        }
        
        .sustainability-stats {
            display: flex;
            gap: 50px;
            margin-top: 40px;
        }
        
        .sustainability-stat {
            text-align: center;
        }
        
        .stat-value.editable-text {
            font-size: 36px;
            color: var(--primary-accent);
            font-weight: 500;
            margin-bottom: 5px;
            font-family: var(--font-serif);
        }
        
        .stat-label.editable-text {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-dark);
            opacity: 0.8;
        }
        
        /* Contact CTA Section */
        .contact-cta.editable-section {
            padding: 100px 0;
            background-color: var(--primary-light);
            text-align: center;
        }
        
        .contact-cta-content {
            max-width: 700px;
            margin: 0 auto;
        }
        
        .contact-cta-title.editable-text {
            font-size: 40px;
            margin-bottom: 20px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .contact-cta-text.editable-text {
            font-size: 18px;
            line-height: 1.7;
            color: var(--primary-dark);
            margin-bottom: 40px;
            opacity: 0.8;
        }
        
        .contact-cta-button {
            display: inline-block;
            padding: 18px 40px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 16px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: none;
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        
        .contact-cta-button:hover {
            background-color: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(98, 102, 75, 0.15);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .story-container,
            .sustainability-container {
                gap: 50px;
            }
            
            .team-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        
        @media (max-width: 992px) {
            .about-hero h1.editable-text {
                font-size: 48px;
            }
            
            .story-container,
            .sustainability-container {
                grid-template-columns: 1fr;
                gap: 60px;
            }
            
            .story-content,
            .sustainability-content {
                padding: 0;
            }
            
            .story-image {
                height: 500px;
            }
            
            .story-year.editable-text {
                bottom: -20px;
                right: -20px;
                font-size: 100px;
            }
            
            .values-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .team-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .sustainability-image {
                height: 400px;
            }
        }
        
        @media (max-width: 768px) {
            .about-hero {
                padding: 140px 0 80px;
            }
            
            .about-hero h1.editable-text {
                font-size: 40px;
            }
            
            .about-hero p.editable-text {
                font-size: 18px;
            }
            
            .story-section,
            .values-section,
            .team-section,
            .sustainability-section,
            .contact-cta {
                padding: 80px 0;
            }
            
            .story-title.editable-text,
            .values-title.editable-text,
            .team-title.editable-text,
            .sustainability-title.editable-text,
            .contact-cta-title.editable-text {
                font-size: 36px;
                margin-bottom: 50px;
            }
            
            .values-grid {
                grid-template-columns: 1fr;
                max-width: 500px;
                margin: 0 auto;
            }
            
            .team-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            
            .sustainability-stats {
                flex-direction: column;
                gap: 30px;
                align-items: center;
            }
            
            .story-year.editable-text {
                position: relative;
                bottom: 0;
                right: 0;
                text-align: center;
                margin-top: 20px;
            }
        }
        
        @media (max-width: 576px) {
            .about-hero h1.editable-text {
                font-size: 36px;
            }
            
            .about-hero p.editable-text {
                font-size: 16px;
            }
            
            .story-image {
                height: 400px;
            }
            
            .value-card {
                padding: 30px;
            }
            
            .value-icon {
                font-size: 40px;
            }
            
            .contact-cta-button {
                padding: 16px 30px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body>
    <!-- About Hero Section -->
    <section class="about-hero editable-section" data-section="223">
        <div class="container">
            <div class="about-hero-content">
                <h1 class="editable-text editable-section no-drop-zone" data-section="224" data-text="179">Redefining Modern Luxury Since 2010</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="225" data-text="180">At ÉLYSIUM, we believe that true luxury is timeless, sustainable, and crafted with intention. Our journey began with a simple vision: to create exceptional pieces that transcend trends and become cherished additions to your wardrobe.</p>
            </div>
        </div>
    </section>
    
    <!-- Story Section -->
    <section class="story-section editable-section" data-section="226">
        <div class="container">
            <div class="story-container">
                <div class="story-content">
                    <h2 class="story-title editable-text editable-section no-drop-zone" data-section="227" data-text="181">Our Story</h2>
                    <p class="story-text editable-text editable-section no-drop-zone" data-section="228" data-text="182">Founded by Isabelle Moreau in 2010, ÉLYSIUM began as a small atelier in Paris, dedicated to reviving the art of traditional craftsmanship. Isabelle's vision was to create clothing that celebrated slow fashion, exceptional quality, and timeless design.</p>
                    <p class="story-text editable-text editable-section no-drop-zone" data-section="229" data-text="183">Today, we continue to honor those founding principles while embracing innovation in sustainable materials and ethical production. Each collection reflects our commitment to creating pieces that are not only beautiful but also responsible.</p>
                </div>
                
                <div class="story-image-container">
                    <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80" alt="ÉLYSIUM Atelier" class="story-image editable-image" data-image="500">
                    <div class="story-year editable-text editable-section no-drop-zone" data-section="230" data-text="184">2010</div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Values Section -->
    <section class="values-section editable-section" data-section="231">
        <div class="container">
            <h2 class="values-title editable-text editable-section no-drop-zone" data-section="232" data-text="185">Our Core Values</h2>
            
            <div class="values-grid">
                <!-- Value 1 -->
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fas fa-hands editable-icon" data-icon="64" data-default-class="fas fa-hands"></i>
                    </div>
                    <h3 class="value-title editable-text editable-section no-drop-zone" data-section="233" data-text="186">Exceptional Craftsmanship</h3>
                    <p class="value-description editable-text editable-section no-drop-zone" data-section="234" data-text="187">Every piece is meticulously crafted by skilled artisans using traditional techniques and the finest materials.</p>
                </div>
                
                <!-- Value 2 - NEW -->
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fas fa-leaf editable-icon" data-icon="65" data-default-class="fas fa-leaf"></i>
                    </div>
                    <h3 class="value-title editable-text editable-section no-drop-zone" data-section="249" data-text="199">Sustainable Innovation</h3>
                    <p class="value-description editable-text editable-section no-drop-zone" data-section="250" data-text="200">We continuously pioneer eco-friendly materials and ethical production methods to minimize our environmental footprint.</p>
                </div>
                
                <!-- Value 3 - NEW -->
                <div class="value-card">
                    <div class="value-icon">
                        <i class="fas fa-heart editable-icon" data-icon="66" data-default-class="fas fa-heart"></i>
                    </div>
                    <h3 class="value-title editable-text editable-section no-drop-zone" data-section="251" data-text="201">Community First</h3>
                    <p class="value-description editable-text editable-section no-drop-zone" data-section="252" data-text="202">Building meaningful connections with our artisans, customers, and local communities is at the heart of everything we do.</p>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Team Section -->
    <section class="team-section editable-section" data-section="235">
        <div class="container">
            <h2 class="team-title editable-text editable-section no-drop-zone" data-section="236" data-text="188">Meet Our Team</h2>
            
            <div class="team-grid">
                <!-- Team Member 1 -->
                <div class="team-member">
                    <img src="https://images.unsplash.com/photo-1494790108755-2616b612b786?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Isabelle Moreau" class="team-image editable-image" data-image="501">
                    
                    <div class="team-info">
                        <h3 class="team-name editable-text editable-section no-drop-zone" data-section="237" data-text="189">Isabelle Moreau</h3>
                        <p class="team-role editable-text editable-section no-drop-zone" data-section="238" data-text="190">Founder & Creative Director</p>
                        <p class="team-bio editable-text editable-section no-drop-zone" data-section="239" data-text="191">With over 20 years in luxury fashion, Isabelle brings unparalleled vision and expertise to every collection.</p>
                    </div>
                </div>
                
                <!-- Team Member 2 - NEW -->
                <div class="team-member">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="James Chen" class="team-image editable-image" data-image="502">
                    
                    <div class="team-info">
                        <h3 class="team-name editable-text editable-section no-drop-zone" data-section="253" data-text="203">James Chen</h3>
                        <p class="team-role editable-text editable-section no-drop-zone" data-section="254" data-text="204">Head of Design</p>
                        <p class="team-bio editable-text editable-section no-drop-zone" data-section="255" data-text="205">James leads our creative vision, blending contemporary aesthetics with timeless elegance in every collection.</p>
                    </div>
                </div>
                
                <!-- Team Member 3 - NEW -->
                <div class="team-member">
                    <img src="https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Sophia Rodriguez" class="team-image editable-image" data-image="503">
                    
                    <div class="team-info">
                        <h3 class="team-name editable-text editable-section no-drop-zone" data-section="256" data-text="206">Sophia Rodriguez</h3>
                        <p class="team-role editable-text editable-section no-drop-zone" data-section="257" data-text="207">Sustainability Director</p>
                        <p class="team-bio editable-text editable-section no-drop-zone" data-section="258" data-text="208">Sophia ensures our commitment to ethical practices and sustainable innovation across all operations.</p>
                    </div>
                </div>
                
                <!-- Team Member 4 - NEW -->
                <div class="team-member">
                    <img src="https://images.unsplash.com/photo-1519085360753-af0119f7cbe7?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Marcus Williams" class="team-image editable-image" data-image="504">
                    
                    <div class="team-info">
                        <h3 class="team-name editable-text editable-section no-drop-zone" data-section="259" data-text="209">Marcus Williams</h3>
                        <p class="team-role editable-text editable-section no-drop-zone" data-section="260" data-text="210">Master Tailor</p>
                        <p class="team-bio editable-text editable-section no-drop-zone" data-section="261" data-text="211">With 30 years of experience, Marcus brings unparalleled precision and artistry to our tailored collections.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Sustainability Section -->
    <section class="sustainability-section editable-section" data-section="240">
        <div class="container">
            <div class="sustainability-container">
                <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80" alt="Sustainable Materials" class="sustainability-image editable-image" data-image="505">
                
                <div class="sustainability-content">
                    <h2 class="sustainability-title editable-text editable-section no-drop-zone" data-section="241" data-text="192">Sustainable Luxury</h2>
                    <p class="sustainability-text editable-text editable-section no-drop-zone" data-section="242" data-text="193">We believe true luxury is sustainable. That's why we carefully select eco-friendly materials and partner with ethical suppliers who share our commitment to responsible production.</p>
                    <p class="sustainability-text editable-text editable-section no-drop-zone" data-section="243" data-text="194">From organic fabrics to recycled packaging, every aspect of our business is designed with the environment in mind.</p>
                    
                    <div class="sustainability-stats">
                        <!-- Stat 1 -->
                        <div class="sustainability-stat">
                            <div class="stat-value editable-text editable-section no-drop-zone" data-section="244" data-text="195">85%</div>
                            <div class="stat-label editable-text editable-section no-drop-zone" data-section="245" data-text="196">Sustainable Materials</div>
                        </div>
                        
                        <!-- Stat 2 - NEW -->
                        <div class="sustainability-stat">
                            <div class="stat-value editable-text editable-section no-drop-zone" data-section="262" data-text="212">100%</div>
                            <div class="stat-label editable-text editable-section no-drop-zone" data-section="263" data-text="213">Ethical Production</div>
                        </div>
                        
                        <!-- Stat 3 - NEW -->
                        <div class="sustainability-stat">
                            <div class="stat-value editable-text editable-section no-drop-zone" data-section="264" data-text="214">500+</div>
                            <div class="stat-label editable-text editable-section no-drop-zone" data-section="265" data-text="215">Trees Planted</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Contact CTA Section -->
    <section class="contact-cta editable-section" data-section="246">
        <div class="container">
            <div class="contact-cta-content">
                <h2 class="contact-cta-title editable-text editable-section no-drop-zone" data-section="247" data-text="197">Join Our Journey</h2>
                <p class="contact-cta-text editable-text editable-section no-drop-zone" data-section="248" data-text="198">Experience the ÉLYSIUM difference. Explore our collections, discover our craftsmanship, and become part of our community dedicated to timeless elegance and sustainable luxury.</p>
                <a href="?page=contact" class="contact-cta-button">Get In Touch</a>
            </div>
        </div>
    </section>

    <script>
        // Initialize animation for team members
        const teamMembers = document.querySelectorAll('.team-member');
        const valueCards = document.querySelectorAll('.value-card');
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, {
            threshold: 0.1
        });
        
        // Animate team members
        teamMembers.forEach(member => {
            member.style.opacity = '0';
            member.style.transform = 'translateY(20px)';
            member.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(member);
        });
        
        // Animate value cards
        valueCards.forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(card);
        });
        
        // Counter animation for sustainability stats
        const statValues = document.querySelectorAll('.stat-value.editable-text');
        
        const statObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const statElement = entry.target;
                    const targetValue = parseInt(statElement.textContent);
                    animateCounter(statElement, targetValue);
                    statObserver.unobserve(statElement);
                }
            });
        }, {
            threshold: 0.5
        });
        
        statValues.forEach(stat => {
            statObserver.observe(stat);
        });
        
        function animateCounter(element, target) {
            let current = 0;
            const increment = target / 50;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                element.textContent = Math.floor(current) + (element.textContent.includes('%') ? '%' : '');
            }, 20);
        }
    </script>
</body>
</html>