 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact | ÉLYSIUM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Contact Hero Section */
        .contact-hero.editable-section {
            padding: 160px 0 80px;
            background: linear-gradient(135deg, rgba(98, 102, 75, 0.03) 0%, rgba(239, 236, 228, 0.01) 100%);
            text-align: center;
            position: relative;
        }
        
        .contact-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%2362664b' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.3;
            z-index: 0;
        }
        
        .contact-hero-content {
            position: relative;
            z-index: 1;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .contact-hero h1.editable-text {
            font-size: 56px;
            line-height: 1.1;
            margin-bottom: 20px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .contact-hero p.editable-text {
            font-size: 20px;
            line-height: 1.7;
            color: var(--primary-dark);
            font-weight: 300;
            opacity: 0.9;
        }
        
        /* Contact Main Section */
        .contact-main.editable-section {
            padding: 80px 0 120px;
        }
        
        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 80px;
        }
        
        /* Contact Info */
        .contact-info {
            padding-right: 40px;
        }
        
        .contact-subtitle.editable-text {
            font-size: 18px;
            color: var(--primary-accent);
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 15px;
        }
        
        .contact-title.editable-text {
            font-size: 40px;
            margin-bottom: 30px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .contact-description.editable-text {
            font-size: 18px;
            line-height: 1.7;
            color: var(--primary-dark);
            margin-bottom: 40px;
            opacity: 0.8;
        }
        
        /* Contact Details */
        .contact-details {
            display: flex;
            flex-direction: column;
            gap: 30px;
            margin-bottom: 50px;
        }
        
        .contact-detail {
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }
        
        .contact-icon {
            width: 50px;
            height: 50px;
            background-color: rgba(171, 136, 114, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        
        .contact-icon i {
            font-size: 20px;
            color: var(--primary-accent);
        }
        
        .contact-detail-content h3.editable-text {
            font-size: 18px;
            margin-bottom: 5px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .contact-detail-content p.editable-text {
            font-size: 16px;
            color: var(--primary-dark);
            opacity: 0.8;
            line-height: 1.5;
        }
        
        /* Business Hours */
        .business-hours {
            margin-top: 20px;
        }
        
        .hours-title.editable-text {
            font-size: 18px;
            margin-bottom: 15px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .hours-list {
            list-style: none;
        }
        
        .hours-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 16px;
            color: var(--primary-dark);
        }
        
        .hours-day.editable-text {
            opacity: 0.8;
        }
        
        .hours-time.editable-text {
            font-weight: 500;
            color: var(--primary-accent);
        }
        
        /* Contact Form */
        .contact-form-container {
            background-color: var(--primary-light);
            border-radius: 5px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .form-title.editable-text {
            font-size: 28px;
            margin-bottom: 30px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        
        .form-label {
            font-size: 14px;
            color: var(--primary-dark);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .form-input,
        .form-textarea {
            padding: 15px;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
            font-family: var(--font-sans);
            font-size: 16px;
            color: var(--primary-dark);
            background-color: var(--primary-light);
            transition: all 0.3s ease;
        }
        
        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: var(--primary-accent);
            box-shadow: 0 0 0 2px rgba(171, 136, 114, 0.1);
        }
        
        .form-textarea {
            min-height: 150px;
            resize: vertical;
        }
        
        .form-submit {
            padding: 18px 40px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 16px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: none;
            border-radius: 2px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
        }
        
        .form-submit:hover {
            background-color: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(98, 102, 75, 0.15);
        }
        
        /* FAQ Section */
        .faq-section.editable-section {
            padding: 80px 0;
            background-color: rgba(187, 194, 182, 0.05);
        }
        
        .faq-title.editable-text {
            font-size: 40px;
            text-align: center;
            margin-bottom: 60px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .faq-container {
            max-width: 800px;
            margin: 0 auto;
        }
        
        .faq-item {
            background-color: var(--primary-light);
            border-radius: 5px;
            margin-bottom: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.1);
        }
        
        .faq-question {
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .faq-question:hover {
            background-color: rgba(187, 194, 182, 0.05);
        }
        
        .faq-question h3.editable-text {
            font-size: 18px;
            color: var(--primary-dark);
            font-weight: 500;
            margin: 0;
        }
        
        .faq-toggle {
            font-size: 20px;
            color: var(--primary-accent);
            transition: transform 0.3s ease;
        }
        
        .faq-answer {
            padding: 0 30px;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s ease;
        }
        
        .faq-answer p.editable-text {
            font-size: 16px;
            line-height: 1.6;
            color: var(--primary-dark);
            opacity: 0.8;
            padding-bottom: 25px;
        }
        
        .faq-item.active .faq-toggle {
            transform: rotate(45deg);
        }
        
        .faq-item.active .faq-answer {
            max-height: 500px;
        }
        
        /* Store Locations */
        .locations-section.editable-section {
            padding: 80px 0;
            background-color: var(--primary-light);
        }
        
        .locations-title.editable-text {
            font-size: 40px;
            text-align: center;
            margin-bottom: 60px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .locations-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }
        
        .location-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.1);
            transition: all 0.3s ease;
        }
        
        .location-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(98, 102, 75, 0.1);
        }
        
        .location-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .location-info {
            padding: 25px;
        }
        
        .location-name.editable-text {
            font-size: 22px;
            margin-bottom: 10px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .location-details.editable-text {
            font-size: 16px;
            line-height: 1.6;
            color: var(--primary-dark);
            opacity: 0.8;
            margin-bottom: 20px;
        }
        
        .location-cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background-color: transparent;
            color: var(--primary-dark);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        
        .location-cta:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .locations-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media (max-width: 992px) {
            .contact-hero h1.editable-text {
                font-size: 48px;
            }
            
            .contact-container {
                grid-template-columns: 1fr;
                gap: 60px;
            }
            
            .contact-info {
                padding-right: 0;
            }
            
            .locations-grid {
                grid-template-columns: 1fr;
                max-width: 500px;
                margin: 0 auto;
            }
        }
        
        @media (max-width: 768px) {
            .contact-hero {
                padding: 140px 0 60px;
            }
            
            .contact-hero h1.editable-text {
                font-size: 40px;
            }
            
            .contact-hero p.editable-text {
                font-size: 18px;
            }
            
            .contact-main {
                padding: 60px 0 100px;
            }
            
            .contact-title.editable-text,
            .faq-title.editable-text,
            .locations-title.editable-text {
                font-size: 36px;
                margin-bottom: 40px;
            }
            
            .contact-form-container {
                padding: 30px;
            }
            
            .faq-section,
            .locations-section {
                padding: 60px 0;
            }
        }
        
        @media (max-width: 576px) {
            .contact-hero h1.editable-text {
                font-size: 36px;
            }
            
            .contact-hero p.editable-text {
                font-size: 16px;
            }
            
            .contact-detail {
                flex-direction: column;
                gap: 15px;
            }
            
            .contact-icon {
                width: 40px;
                height: 40px;
            }
            
            .contact-icon i {
                font-size: 18px;
            }
            
            .form-submit {
                padding: 16px 30px;
                font-size: 14px;
            }
            
            .location-card {
                text-align: center;
            }
        }
    </style>
</head>
<body>
    <!-- Contact Hero Section -->
    <section class="contact-hero editable-section" data-section="249">
        <div class="container">
            <div class="contact-hero-content">
                <h1 class="editable-text editable-section no-drop-zone" data-section="250" data-text="199">Get In Touch</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="251" data-text="200">We're here to help with any questions about our collections, sizing, or sustainability practices. Your experience with ÉLYSIUM matters to us.</p>
            </div>
        </div>
    </section>
    
    <!-- Contact Main Section -->
    <section class="contact-main editable-section" data-section="252">
        <div class="container">
            <div class="contact-container">
                <!-- Contact Info -->
                <div class="contact-info">
                    <p class="contact-subtitle editable-text editable-section no-drop-zone" data-section="253" data-text="201">CONTACT US</p>
                    <h2 class="contact-title editable-text editable-section no-drop-zone" data-section="254" data-text="202">Let's Connect</h2>
                    <p class="contact-description editable-text editable-section no-drop-zone" data-section="255" data-text="203">Whether you have questions about our collections, need assistance with an order, or want to learn more about our sustainable practices, our team is ready to help.</p>
                    
                    <div class="contact-details">
                        <!-- Contact Detail 1 -->
                        <div class="contact-detail">
                            <div class="contact-icon">
                                <i class="fas fa-phone editable-icon" data-icon="67" data-default-class="fas fa-phone"></i>
                            </div>
                            <div class="contact-detail-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="256" data-text="204">Phone</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="257" data-text="205">+1 (555) 123-4567</p>
                            </div>
                        </div>
                        
                        <!-- Contact Detail 2 -->
                        <div class="contact-detail">
                            <div class="contact-icon">
                                <i class="fas fa-envelope editable-icon" data-icon="68" data-default-class="fas fa-envelope"></i>
                            </div>
                            <div class="contact-detail-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="272" data-text="220">Email</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="273" data-text="221">hello@elysium.com</p>
                            </div>
                        </div>
                        
                        <!-- Contact Detail 3 -->
                        <div class="contact-detail">
                            <div class="contact-icon">
                                <i class="fas fa-comment editable-icon" data-icon="69" data-default-class="fas fa-comment"></i>
                            </div>
                            <div class="contact-detail-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="274" data-text="222">Live Chat</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="275" data-text="223">Mon-Fri, 9am-6pm EST</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="business-hours">
                        <h3 class="hours-title editable-text editable-section no-drop-zone" data-section="258" data-text="206">Business Hours</h3>
                        <ul class="hours-list">
                            <!-- Business Hour 1 -->
                            <li class="hours-item">
                                <span class="hours-day editable-text editable-section no-drop-zone" data-section="259" data-text="207">Monday - Friday</span>
                                <span class="hours-time editable-text editable-section no-drop-zone" data-section="260" data-text="208">9:00 AM - 6:00 PM EST</span>
                            </li>
                            <!-- Business Hour 2 -->
                            <li class="hours-item">
                                <span class="hours-day editable-text editable-section no-drop-zone" data-section="276" data-text="224">Saturday</span>
                                <span class="hours-time editable-text editable-section no-drop-zone" data-section="277" data-text="225">10:00 AM - 4:00 PM EST</span>
                            </li>
                            <!-- Business Hour 3 -->
                            <li class="hours-item">
                                <span class="hours-day editable-text editable-section no-drop-zone" data-section="278" data-text="226">Sunday</span>
                                <span class="hours-time editable-text editable-section no-drop-zone" data-section="279" data-text="227">Closed</span>
                            </li>
                        </ul>
                    </div>
                </div>
                
                <!-- Contact Form - FULLY EDITABLE CONTAINER -->
                <div class="contact-form-container editable-section" data-section="306">
                    <h2 class="form-title editable-text editable-section no-drop-zone" data-section="261" data-text="209">Send Us a Message</h2>
                    
                    <form class="contact-form" id="contactForm">
                        <!-- Name Field -->
                        <div class="form-group">
                            <label for="name" class="form-label editable-text editable-section no-drop-zone" data-section="294" data-text="242">Full Name</label>
                            <input type="text" id="name" name="name" class="form-input" placeholder="Enter your full name" required>
                        </div>
                        
                        <!-- Email Field -->
                        <div class="form-group">
                            <label for="email" class="form-label editable-text editable-section no-drop-zone" data-section="295" data-text="243">Email Address</label>
                            <input type="email" id="email" name="email" class="form-input" placeholder="Enter your email address" required>
                        </div>
                        
                        <!-- Subject Field -->
                        <div class="form-group">
                            <label for="subject" class="form-label editable-text editable-section no-drop-zone" data-section="296" data-text="244">Subject</label>
                            <select id="subject" name="subject" class="form-input" required>
                                <option value="" class="editable-text editable-section no-drop-zone" data-section="297" data-text="245">Select a subject</option>
                                <option value="general" class="editable-text editable-section no-drop-zone" data-section="298" data-text="246">General Inquiry</option>
                                <option value="order" class="editable-text editable-section no-drop-zone" data-section="299" data-text="247">Order Support</option>
                                <option value="sizing" class="editable-text editable-section no-drop-zone" data-section="300" data-text="248">Sizing Questions</option>
                                <option value="sustainability" class="editable-text editable-section no-drop-zone" data-section="301" data-text="249">Sustainability</option>
                                <option value="wholesale" class="editable-text editable-section no-drop-zone" data-section="302" data-text="250">Wholesale Inquiry</option>
                                <option value="other" class="editable-text editable-section no-drop-zone" data-section="303" data-text="251">Other</option>
                            </select>
                        </div>
                        
                        <!-- Message Field -->
                        <div class="form-group">
                            <label for="message" class="form-label editable-text editable-section no-drop-zone" data-section="304" data-text="252">Message</label>
                            <textarea id="message" name="message" class="form-textarea" placeholder="Enter your message here" required></textarea>
                        </div>
                        
                        <!-- Submit Button -->
                        <button type="submit" class="form-submit editable-text editable-section no-drop-zone" data-section="305" data-text="253">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
    
    <!-- FAQ Section -->
    <section class="faq-section editable-section" data-section="262">
        <div class="container">
            <h2 class="faq-title editable-text editable-section no-drop-zone" data-section="263" data-text="210">Frequently Asked Questions</h2>
            
            <div class="faq-container">
                <!-- FAQ Item 1 -->
                <div class="faq-item">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="264" data-text="211">What is your return policy?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="265" data-text="212">We offer a 30-day return policy for all full-priced items. Items must be in original condition with tags attached. Final sale items are not eligible for return.</p>
                    </div>
                </div>
                
                <!-- FAQ Item 2 -->
                <div class="faq-item">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="280" data-text="228">How long does shipping take?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="281" data-text="229">Standard shipping takes 3-5 business days within the continental US. Express shipping is available for 1-2 business day delivery.</p>
                    </div>
                </div>
                
                <!-- FAQ Item 3 -->
                <div class="faq-item">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="282" data-text="230">Do you offer international shipping?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="283" data-text="231">Yes, we ship to select international destinations. Shipping costs and delivery times vary by location.</p>
                    </div>
                </div>
                
                <!-- FAQ Item 4 -->
                <div class="faq-item">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="284" data-text="232">How do I find my size?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="285" data-text="233">We provide detailed size guides on each product page. You can also contact our customer service team for personalized sizing assistance.</p>
                    </div>
                </div>
                
                <!-- FAQ Item 5 -->
                <div class="faq-item">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="286" data-text="234">What sustainable practices do you follow?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="287" data-text="235">We use eco-friendly materials, ethical manufacturing partners, and recycled packaging. Our commitment to sustainability is at the core of everything we do.</p>
                    </div>
                </div>
                
                <!-- FAQ Item 6 -->
                <div class="faq-item">
                    <div class="faq-question">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="288" data-text="236">Can I modify or cancel my order?</h3>
                        <span class="faq-toggle">+</span>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="289" data-text="237">Orders can be modified or canceled within 2 hours of placement. Please contact customer service immediately for assistance.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Store Locations -->
    <section class="locations-section editable-section" data-section="266">
        <div class="container">
            <h2 class="locations-title editable-text editable-section no-drop-zone" data-section="267" data-text="213">Visit Our Stores</h2>
            
            <div class="locations-grid">
                <!-- Location 1 -->
                <div class="location-card">
                    <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="New York Store" class="location-image editable-image" data-image="506">
                    
                    <div class="location-info">
                        <h3 class="location-name editable-text editable-section no-drop-zone" data-section="268" data-text="214">New York Flagship</h3>
                        <p class="location-details editable-text editable-section no-drop-zone" data-section="269" data-text="215">123 Luxury Avenue<br>New York, NY 10001</p>
                        <a href="https://maps.google.com" target="_blank" class="location-cta">
                            <i class="fas fa-map-marker-alt editable-icon" data-icon="70" data-default-class="fas fa-map-marker-alt"></i>
                            Get Directions
                        </a>
                    </div>
                </div>
                
                <!-- Location 2 -->
                <div class="location-card">
                    <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Los Angeles Store" class="location-image editable-image" data-image="507">
                    
                    <div class="location-info">
                        <h3 class="location-name editable-text editable-section no-drop-zone" data-section="290" data-text="238">Los Angeles Boutique</h3>
                        <p class="location-details editable-text editable-section no-drop-zone" data-section="291" data-text="239">456 Rodeo Drive<br>Beverly Hills, CA 90210</p>
                        <a href="https://maps.google.com" target="_blank" class="location-cta">
                            <i class="fas fa-map-marker-alt editable-icon" data-icon="70" data-default-class="fas fa-map-marker-alt"></i>
                            Get Directions
                        </a>
                    </div>
                </div>
                
                <!-- Location 3 -->
                <div class="location-card">
                    <img src="https://images.unsplash.com/photo-1519567241046-7f570eee3ce6?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Miami Store" class="location-image editable-image" data-image="508">
                    
                    <div class="location-info">
                        <h3 class="location-name editable-text editable-section no-drop-zone" data-section="292" data-text="240">Miami Beach</h3>
                        <p class="location-details editable-text editable-section no-drop-zone" data-section="293" data-text="241">789 Collins Avenue<br>Miami Beach, FL 33139</p>
                        <a href="https://maps.google.com" target="_blank" class="location-cta">
                            <i class="fas fa-map-marker-alt editable-icon" data-icon="70" data-default-class="fas fa-map-marker-alt"></i>
                            Get Directions
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        // FAQ Toggle Functionality
        const faqItems = document.querySelectorAll('.faq-item');
        
        faqItems.forEach(item => {
            const question = item.querySelector('.faq-question');
            const toggle = item.querySelector('.faq-toggle');
            
            question.addEventListener('click', () => {
                // Close all other FAQ items
                faqItems.forEach(otherItem => {
                    if (otherItem !== item && otherItem.classList.contains('active')) {
                        otherItem.classList.remove('active');
                        const otherToggle = otherItem.querySelector('.faq-toggle');
                        otherToggle.textContent = '+';
                    }
                });
                
                // Toggle current item
                item.classList.toggle('active');
                
                // Update toggle icon
                if (item.classList.contains('active')) {
                    toggle.textContent = '×';
                } else {
                    toggle.textContent = '+';
                }
            });
        });
        
        // Contact Form Submission
        const contactForm = document.getElementById('contactForm');
        
        contactForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(contactForm);
            const submitButton = contactForm.querySelector('.form-submit');
            const originalText = submitButton.textContent;
            
            // Show loading state
            submitButton.textContent = 'Sending...';
            submitButton.disabled = true;
            
            try {
                // Simulate API call
                await new Promise(resolve => setTimeout(resolve, 1500));
                
                // Show success message
                alert('Thank you for your message! We will get back to you within 24 hours.');
                contactForm.reset();
                
            } catch (error) {
                alert('There was an error sending your message. Please try again.');
            } finally {
                // Reset button state
                submitButton.textContent = originalText;
                submitButton.disabled = false;
            }
        });
        
        // Initialize animation for location cards
        const locationCards = document.querySelectorAll('.location-card');
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, {
            threshold: 0.1
        });
        
        locationCards.forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(card);
        });
        
        // Form input animations
        const formInputs = document.querySelectorAll('.form-input, .form-textarea');
        
        formInputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });
            
            input.addEventListener('blur', function() {
                if (!this.value) {
                    this.parentElement.classList.remove('focused');
                }
            });
        });
    </script>
</body>
</html>