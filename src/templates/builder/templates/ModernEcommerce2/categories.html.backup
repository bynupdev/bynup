                <a href="?page=shop&collection=sustainable-luxury" class="collection-card">
                    <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Sustainable Luxury" class="collection-image">
                    <div class="collection-info">
                        <h3 class="collection-title editable-text editable-section no-drop-zone" data-section="216" data-text="173">Sustainable Luxury</h3>
