<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | ÉLYSIUM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Categories Hero Section */
        .categories-hero.editable-section {
            padding: 160px 0 60px;
            background: linear-gradient(135deg, rgba(187, 194, 182, 0.05) 0%, rgba(239, 236, 228, 0.02) 100%);
            text-align: center;
            position: relative;
        }
        
        .categories-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%2362664b' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.4;
            z-index: 0;
        }
        
        .categories-hero-content {
            position: relative;
            z-index: 1;
        }
        
        .categories-hero h1.editable-text {
            font-size: 48px;
            line-height: 1.1;
            margin-bottom: 15px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .categories-hero p.editable-text {
            font-size: 18px;
            line-height: 1.6;
            color: var(--primary-dark);
            font-weight: 300;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Categories Stats */
        .categories-stats.editable-section {
            padding: 40px 0;
            background-color: var(--primary-light);
            border-bottom: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .stats-container-categories {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
        }
        
        .stat-item-category {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }
        
        .stat-value-category.editable-text {
            font-size: 32px;
            color: var(--primary-accent);
            font-weight: 500;
            font-family: var(--font-serif);
        }
        
        .stat-label-category.editable-text {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-dark);
            opacity: 0.8;
        }
        
        /* Categories Content */
        .categories-content.editable-section {
            padding: 60px 0 100px;
        }
        
        .categories-container {
            display: flex;
            flex-direction: column;
            gap: 50px;
        }
        
        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }
        
        .category-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
            position: relative;
            height: 400px;
            display: flex;
            flex-direction: column;
        }
        
        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(98, 102, 75, 0.1);
        }
        
        .category-image {
            height: 250px;
            width: 100%;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .category-info {
            padding: 25px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        
        .category-title.editable-text {
            font-size: 24px;
            color: var(--primary-dark);
            margin-bottom: 10px;
            font-weight: 500;
            font-family: var(--font-serif);
        }
        
        .category-description.editable-text {
            font-size: 14px;
            line-height: 1.5;
            color: var(--primary-dark);
            opacity: 0.8;
            margin-bottom: 20px;
            flex: 1;
        }
        
        .category-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
        }
        
        .category-count.editable-text {
            font-size: 14px;
            color: var(--primary-accent);
            font-weight: 500;
        }
        
        .btn-view-category {
            padding: 8px 20px;
            background-color: transparent;
            color: var(--primary-dark);
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }
        
        .btn-view-category:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        /* Featured Collections */
        .featured-collections.editable-section {
            padding: 60px 0;
            background-color: rgba(187, 194, 182, 0.05);
            border-top: 1px solid rgba(187, 194, 182, 0.1);
        }
        
        .section-title.editable-text {
            font-size: 32px;
            margin-bottom: 40px;
            color: var(--primary-dark);
            font-weight: 500;
            text-align: center;
        }
        
        .collections-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }
        
        .collection-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
        }
        
        .collection-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(98, 102, 75, 0.1);
        }
        
        .collection-image {
            height: 200px;
            width: 100%;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .collection-info {
            padding: 20px;
        }
        
        .collection-title.editable-text {
            font-size: 18px;
            margin-bottom: 8px;
            font-weight: 500;
            font-family: var(--font-serif);
            color: var(--primary-dark);
        }
        
        .collection-subtitle.editable-text {
            font-size: 14px;
            color: var(--primary-accent);
        }
        
        /* Category Detail Modal */
        .category-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(98, 102, 75, 0.8);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .category-modal-content {
            background-color: var(--primary-light);
            border-radius: 5px;
            width: 100%;
            max-width: 1000px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        }
        
        .category-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 30px;
            border-bottom: 1px solid rgba(187, 194, 182, 0.3);
            background-color: rgba(187, 194, 182, 0.05);
        }
        
        .category-modal-title.editable-text {
            font-size: 28px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .close-category-modal {
            font-size: 24px;
            color: var(--primary-dark);
            cursor: pointer;
            transition: color 0.3s ease;
        }
        
        .close-category-modal:hover {
            color: var(--primary-accent);
        }
        
        .category-modal-body {
            padding: 30px;
        }
        
        .category-modal-description.editable-text {
            font-size: 16px;
            line-height: 1.6;
            color: var(--primary-dark);
            margin-bottom: 30px;
            opacity: 0.8;
        }
        
        .category-products-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
            margin-top: 30px;
        }
        
        .category-product-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .category-product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(98, 102, 75, 0.1);
        }
        
        .category-product-img {
            height: 180px;
            width: 100%;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .category-product-info {
            padding: 15px;
        }
        
        .category-product-name.editable-text {
            font-size: 16px;
            margin-bottom: 5px;
            font-weight: 500;
            font-family: var(--font-serif);
            color: var(--primary-dark);
        }
        
        .category-product-price.editable-text {
            font-size: 18px;
            font-weight: 500;
            color: var(--primary-dark);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .collections-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .category-products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media (max-width: 992px) {
            .categories-hero h1.editable-text {
                font-size: 40px;
            }
            
            .category-card {
                height: 380px;
            }
            
            .category-image {
                height: 220px;
            }
        }
        
        @media (max-width: 768px) {
            .categories-hero {
                padding: 140px 0 40px;
            }
            
            .categories-hero h1.editable-text {
                font-size: 36px;
            }
            
            .categories-hero p.editable-text {
                font-size: 16px;
            }
            
            .categories-content.editable-section {
                padding: 40px 0 80px;
            }
            
            .categories-grid {
                grid-template-columns: 1fr;
                max-width: 500px;
                margin: 0 auto;
            }
            
            .collections-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .section-title.editable-text {
                font-size: 28px;
            }
            
            .stat-value-category.editable-text {
                font-size: 28px;
            }
            
            .category-modal-content {
                max-height: 80vh;
            }
            
            .category-modal-header,
            .category-modal-body {
                padding: 20px;
            }
        }
        
        @media (max-width: 576px) {
            .stats-container-categories {
                gap: 20px;
            }
            
            .stat-item-category {
                min-width: calc(50% - 10px);
                align-items: center;
            }
            
            .collections-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            
            .category-products-grid {
                grid-template-columns: 1fr;
            }
            
            .category-card {
                height: 350px;
            }
            
            .category-image {
                height: 200px;
            }
            
            .category-info {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Categories Hero Section -->
    <section class="categories-hero editable-section" data-section="200">
        <div class="container">
            <div class="categories-hero-content">
                <h1 class="editable-text editable-section no-drop-zone" data-section="201" data-text="161">Shop by Category</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="202" data-text="162">Discover our curated collections, each designed with timeless elegance and exceptional craftsmanship</p>
            </div>
        </div>
    </section>
    
    <!-- Categories Stats -->
    <section class="categories-stats editable-section" data-section="203">
        <div class="container">
            <div class="stats-container-categories">
                <div class="stat-item-category">
                    <span class="stat-value-category editable-text editable-section no-drop-zone" data-section="204" data-text="163">12</span>
                    <span class="stat-label-category editable-text editable-section no-drop-zone" data-section="205" data-text="164">Categories</span>
                </div>
                
                <div class="stat-item-category">
                    <span class="stat-value-category editable-text editable-section no-drop-zone" data-section="206" data-text="165">70+</span>
                    <span class="stat-label-category editable-text editable-section no-drop-zone" data-section="207" data-text="166">Weekly Options</span>
                </div>
                
                <div class="stat-item-category">
                    <span class="stat-value-category editable-text editable-section no-drop-zone" data-section="208" data-text="167">450+</span>
                    <span class="stat-label-category editable-text editable-section no-drop-zone" data-section="209" data-text="168">Products</span>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Categories Content -->
    <section class="categories-content editable-section" data-section="210">
        <div class="container">
            <div class="categories-container">
                <!-- Categories Grid -->
                <div class="categories-grid">
                    <!-- Category 1 - Only this one is editable as template -->
                    <div class="category-card" data-category="tailored-collection">
                        <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Tailored Collection" class="category-image">
                        
                        <div class="category-info">
                            <h2 class="category-title editable-text editable-section no-drop-zone" data-section="211" data-text="169">Tailored Collection</h2>
                            <p class="category-description editable-text editable-section no-drop-zone" data-section="212" data-text="170">Expertly crafted suits, blazers, and trousers for a polished, sophisticated look that commands attention in any setting.</p>
                            
                            <div class="category-meta">
                                <span class="category-count editable-text editable-section no-drop-zone" data-section="213" data-text="171">42 Products</span>
                                <button class="btn-view-category view-category-btn" data-category="tailored-collection">
                                    Explore <i class="fas fa-arrow-right editable-icon" data-icon="63" data-default-class="fas fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <!-- Featured Collections -->
    <!-- <section class="featured-collections editable-section" data-section="214">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="215" data-text="172">Featured Collections</h2>
            
