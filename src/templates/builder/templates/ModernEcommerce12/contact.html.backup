<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Élan Noir | Luxury Fashion Support</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --text: #e2a970;
            --heading: #f1bb71;
            --heading: #fbca8a;
            --primary: #626616;
            --secondary: #ffffff;
            --accent: #f9f6f2;
            --border: #1a1a1a;
            --success: #f8f8f8;
            --warning: #333333;
            --error: #e5e5e5;
            --gray-medium: #999999;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            font-weight: 300;
            color: var(--warning);
            line-height: 1.6;
            background-color: var(--accent);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            color: var(--primary);
            letter-spacing: 0.5px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .section-padding {
            padding: 5rem 0;
        }

        .NObtn {
            display: inline-block;
            padding: 1rem 2.5rem;
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .NObtn-primary {
            background-color: var(--text);
            color: var(--secondary);
        }

        .NObtn-primary:hover {
            background-color: var(--heading);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .NObtn-secondary {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .NObtn-secondary:hover {
            background-color: var(--primary);
            color: var(--secondary);
        }

        /* Contact Page */
        .contact-page {
            padding: 8rem 0 4rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .page-header h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .page-header p {
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Contact Layout */
        .contact-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            margin-bottom: 6rem;
        }

        /* Contact Info */
        .contact-info h2 {
            font-size: 2.2rem;
            margin-bottom: 2rem;
        }

        .contact-details {
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            margin-bottom: 3rem;
        }

        .contact-item {
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background-color: var(--accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .contact-content h3 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
        }

        .contact-content p {
            color: var(--gray-medium);
            line-height: 1.6;
        }

        /* Contact Form */
        .contact-form-container {
            background-color: var(--secondary);
            padding: 3rem;
            border-radius: 10px;
            box-shadow: 0 5px 30px rgba(0, 0, 0, 0.08);
        }

        .contact-form h2 {
            font-size: 2.2rem;
            margin-bottom: 2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: var(--primary);
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 1rem;
            border: 1px solid var(--error);
            border-radius: 5px;
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            transition: border-color 0.3s ease;
            background-color: var(--secondary);
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            outline: none;
            border-color: var(--text);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        textarea {
            min-height: 150px;
            resize: vertical;
        }

        /* FAQ Section */
        .faq-section {
            padding: 5rem 0;
            background-color: var(--secondary);
        }

        .section-title {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-title h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .section-title p {
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto;
        }

        .faq-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .faq-item {
            border-bottom: 1px solid var(--error);
            margin-bottom: 1rem;
        }

        .faq-question {
            padding: 1.5rem 0;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

        .faq-question:hover {
            color: var(--text);
        }

        .faq-question h3 {
            font-size: 1.3rem;
            font-weight: 500;
            margin-right: 2rem;
        }

        .faq-toggle {
            color: var(--primary);
            font-size: 1.2rem;
            transition: transform 0.3s ease;
            flex-shrink: 0;
        }

        .faq-answer {
            padding: 0 0 1.5rem;
            color: var(--gray-medium);
            line-height: 1.7;
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .faq-answer.active {
            display: block;
        }

        .faq-item.active .faq-toggle {
            transform: rotate(45deg);
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Store Location */
        .store-location {
            padding: 5rem 0;
        }

        .location-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 3rem;
        }

        .location-card {
            background-color: var(--secondary);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease;
        }

        .location-card:hover {
            transform: translateY(-5px);
        }

        .location-image {
            height: 250px;
            overflow: hidden;
        }

        .location-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .location-card:hover .location-image img {
            transform: scale(1.05);
        }

        .location-info {
            padding: 2rem;
        }

        .location-name {
            font-size: 1.5rem;
            margin-bottom: 1rem;
        }

        .location-details {
            color: var(--gray-medium);
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .location-hours {
            font-size: 0.9rem;
            color: var(--primary);
            font-weight: 500;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .contact-layout {
                gap: 3rem;
            }
            
            .location-grid {
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                gap: 2.5rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 1.5rem;
            }
            
            .contact-page {
                padding: 6rem 0 3rem;
            }
            
            .page-header h1 {
                font-size: 2.5rem;
            }
            
            .contact-layout {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
            
            .contact-form-container {
                padding: 2rem;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
            
            .section-title h2 {
                font-size: 2rem;
            }
            
            .faq-question h3 {
                font-size: 1.2rem;
            }
            
            .location-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
        }

        @media (max-width: 480px) {
            .page-header h1 {
                font-size: 2rem;
            }
            
            .contact-info h2,
            .contact-form h2 {
                font-size: 1.8rem;
            }
            
            .section-title h2 {
                font-size: 1.8rem;
            }
            
            .contact-item {
                flex-direction: column;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Contact Page -->
    <section class="contact-page editable-section" data-section="200">
        <div class="container">
            <!-- Page Header -->
            <div class="page-header editable-section" data-section="201">
                <h1 class="editable-text editable-section no-drop-zone" data-section="202" data-text="150">Contact Élan Noir</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="203" data-text="151">Connect with our luxury fashion advisors for personalized service</p>
            </div>

            <!-- Contact Layout -->
            <div class="contact-layout">
                <!-- Contact Info -->
                <div class="contact-info editable-section" data-section="204">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="205" data-text="152">Get in Touch</h2>
                    
                    <div class="contact-details">
                        <!-- Phone Item -->
                        <div class="contact-item editable-section no-drop-zone" data-section="206">
                            <div class="contact-icon">
                                <i class="fas fa-phone editable-icon" data-icon="42" data-default-class="fas fa-phone"></i>
                            </div>
                            <div class="contact-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="207" data-text="153">Phone</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="208" data-text="154">+1 (888) 555-ELAN</p>
                                <p class="editable-text editable-section no-drop-zone" data-section="209" data-text="155">Monday - Friday: 9AM - 7PM EST</p>
                            </div>
                        </div>
                        
                        <!-- Email Item -->
                        <div class="contact-item editable-section no-drop-zone" data-section="210">
                            <div class="contact-icon">
                                <i class="fas fa-envelope editable-icon" data-icon="43" data-default-class="fas fa-envelope"></i>
                            </div>
                            <div class="contact-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="211" data-text="156">Email</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="212" data-text="157">service@elannoir.com</p>
                                <p class="editable-text editable-section no-drop-zone" data-section="213" data-text="158">Response within 24 hours</p>
                            </div>
                        </div>
                        
                        <!-- Address Item -->
                        <div class="contact-item editable-section no-drop-zone" data-section="214">
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt editable-icon" data-icon="44" data-default-class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="contact-content">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="215" data-text="159">Flagship Store</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="216" data-text="160">57 Madison Avenue, New York, NY 10022</p>
                                <p class="editable-text editable-section no-drop-zone" data-section="217" data-text="161">By appointment only</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Social Connect -->
                    <div class="social-connect editable-section no-drop-zone" data-section="218">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="219" data-text="162">Connect With Us</h3>
                        <div class="social-icons" style="display: flex; gap: 1rem; margin-top: 1rem;">
                            <!-- Instagram -->
                            <a href="#" class="social-icon editable-section no-drop-zone" data-section="220" style="width: 40px; height: 40px; background-color: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); transition: all 0.3s ease;">
                                <i class="fab fa-instagram editable-icon" data-icon="45" data-default-class="fab fa-instagram"></i>
                            </a>
                            <!-- Pinterest -->
                            <a href="#" class="social-icon editable-section no-drop-zone" data-section="221" style="width: 40px; height: 40px; background-color: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); transition: all 0.3s ease;">
                                <i class="fab fa-pinterest editable-icon" data-icon="46" data-default-class="fab fa-pinterest"></i>
                            </a>
                            <!-- Facebook -->
                            <a href="#" class="social-icon editable-section no-drop-zone" data-section="222" style="width: 40px; height: 40px; background-color: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); transition: all 0.3s ease;">
                                <i class="fab fa-facebook-f editable-icon" data-icon="47" data-default-class="fab fa-facebook-f"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form-container editable-section" data-section="223">
                    <div class="contact-form">
                        <h2 class="editable-text editable-section no-drop-zone" data-section="224" data-text="163">Send a Message</h2>
                        <form id="contactForm">
                            <div class="form-row">
                                <div class="form-group editable-section no-drop-zone" data-section="225">
                                    <label for="firstName" class="editable-text editable-section no-drop-zone" data-section="226" data-text="164">First Name</label>
                                    <input type="text" id="firstName" required class="editable-section" data-section="227">
                                </div>
                                <div class="form-group editable-section no-drop-zone" data-section="228">
                                    <label for="lastName" class="editable-text editable-section no-drop-zone" data-section="229" data-text="165">Last Name</label>
                                    <input type="text" id="lastName" required class="editable-section" data-section="230">
                                </div>
                            </div>
                            
                            <div class="form-group editable-section no-drop-zone" data-section="231">
                                <label for="email" class="editable-text editable-section no-drop-zone" data-section="232" data-text="166">Email Address</label>
                                <input type="email" id="email" required class="editable-section" data-section="233">
                            </div>
                            
                            <div class="form-group editable-section no-drop-zone" data-section="234">
                                <label for="phone" class="editable-text editable-section no-drop-zone" data-section="235" data-text="167">Phone Number</label>
                                <input type="tel" id="phone" class="editable-section" data-section="236">
                            </div>
                            
                            <div class="form-group editable-section no-drop-zone" data-section="237">
                                <label for="subject" class="editable-text editable-section no-drop-zone" data-section="238" data-text="168">Subject</label>
                                <select id="subject" class="editable-section" data-section="239">
                                    <option value="" class="editable-text" data-text="169">Select a subject</option>
                                    <option value="general" class="editable-text" data-text="170">General Inquiry</option>
                                    <option value="order" class="editable-text" data-text="171">Order Status</option>
                                    <option value="returns" class="editable-text" data-text="172">Returns & Exchanges</option>
                                    <option value="appointment" class="editable-text" data-text="173">Book Appointment</option>
                                    <option value="wholesale" class="editable-text" data-text="174">Wholesale Inquiry</option>
                                </select>
                            </div>
                            
                            <div class="form-group editable-section no-drop-zone" data-section="240">
                                <label for="message" class="editable-text editable-section no-drop-zone" data-section="241" data-text="175">Message</label>
                                <textarea id="message" placeholder="How can we assist you today?" required class="editable-section" data-section="242"></textarea>
                            </div>
                            
                            <button type="submit" class="NObtn NObtn-primary editable-text editable-section no-drop-zone" data-section="243" data-text="176">Send Message</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section editable-section" data-section="244">
        <div class="container">
            <div class="section-title editable-section" data-section="245">
                <h2 class="editable-text editable-section no-drop-zone" data-section="246" data-text="177">Frequently Asked Questions</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="247" data-text="178">Find answers to common questions about our luxury fashion services</p>
            </div>
            
            <div class="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item editable-section no-drop-zone" data-section="248">
                    <div class="faq-question editable-section no-drop-zone" data-section="249" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="250" data-text="179">What is your return and exchange policy?</h3>
                        <span class="faq-toggle editable-icon" data-icon="48" data-default-class="fas fa-plus">+</span>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="251">
                        <p class="editable-text editable-section no-drop-zone" data-section="252" data-text="180">
                            We offer a 30-day return policy for unworn items with original tags attached. Custom and made-to-order pieces are final sale. Return shipping is complimentary, and refunds are processed within 5-7 business days of receipt.
                        </p>
                    </div>
                </div>
                
                <!-- FAQ 2 -->
                <div class="faq-item editable-section no-drop-zone" data-section="253">
                    <div class="faq-question editable-section no-drop-zone" data-section="254" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="255" data-text="181">How do I care for my Élan Noir pieces?</h3>
                        <span class="faq-toggle editable-icon" data-icon="48" data-default-class="fas fa-plus">+</span>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="256">
                        <p class="editable-text editable-section no-drop-zone" data-section="257" data-text="182">
                            Each piece includes specific care instructions. Generally, we recommend dry cleaning for delicate fabrics and hand washing for knitwear. Store garments in breathable garment bags and avoid direct sunlight to preserve colors.
                        </p>
                    </div>
                </div>
                
                <!-- FAQ 3 -->
                <div class="faq-item editable-section no-drop-zone" data-section="258">
                    <div class="faq-question editable-section no-drop-zone" data-section="259" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="260" data-text="183">Do you offer alterations or custom sizing?</h3>
                        <span class="faq-toggle editable-icon" data-icon="48" data-default-class="fas fa-plus">+</span>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="261">
                        <p class="editable-text editable-section no-drop-zone" data-section="262" data-text="184">
                            Yes, we offer complimentary alterations for all ready-to-wear pieces purchased through our flagship store or personal shopping service. Custom sizing is available for select collections with an additional 4-6 week production time.
                        </p>
                    </div>
                </div>
                
                <!-- FAQ 4 -->
                <div class="faq-item editable-section no-drop-zone" data-section="263">
                    <div class="faq-question editable-section no-drop-zone" data-section="264" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="265" data-text="185">What shipping options do you offer?</h3>
                        <span class="faq-toggle editable-icon" data-icon="48" data-default-class="fas fa-plus">+</span>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="266">
                        <p class="editable-text editable-section no-drop-zone" data-section="267" data-text="186">
                            We provide complimentary express shipping worldwide with full tracking and insurance. Orders typically ship within 1-2 business days and arrive in 3-5 business days domestically, 7-10 days internationally. White-glove delivery is available for couture pieces.
                        </p>
                    </div>
                </div>
                
                <!-- FAQ 5 -->
                <div class="faq-item editable-section no-drop-zone" data-section="268">
                    <div class="faq-question editable-section no-drop-zone" data-section="269" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="270" data-text="187">How can I book a personal shopping appointment?</h3>
                        <span class="faq-toggle editable-icon" data-icon="48" data-default-class="fas fa-plus">+</span>
                    </div>
                    <div class="faq-answer editable-section no-drop-zone" data-section="271">
                        <p class="editable-text editable-section no-drop-zone" data-section="272" data-text="188">
                            Personal shopping appointments are available at our flagship stores in New York, Paris, and Milan. You can book through our website contact form, by calling our concierge line, or emailing appointments@elannoir.com. Appointments typically last 90 minutes.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Store Locations -->
    <section class="store-location editable-section" data-section="273">
        <div class="container">
            <div class="section-title editable-section" data-section="274">
                <h2 class="editable-text editable-section no-drop-zone" data-section="275" data-text="189">Our Flagship Locations</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="276" data-text="190">Experience Élan Noir in person at our curated boutiques</p>
            </div>
            
            <div class="location-grid">
                <!-- Location 1 - New York -->
                <div class="location-card editable-section no-drop-zone" data-section="277">
                    <div class="location-image editable-section" data-section="278">
                        <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="New York Flagship" class="editable-image" data-image="6">
                    </div>
                    <div class="location-info editable-section no-drop-zone" data-section="280">
                        <h3 class="location-name editable-text editable-section no-drop-zone" data-section="281" data-text="191">New York Flagship</h3>
                        <p class="location-details editable-text editable-section no-drop-zone" data-section="282" data-text="192">57 Madison Avenue, New York, NY 10022</p>
                        <p class="location-hours editable-text editable-section no-drop-zone" data-section="283" data-text="193">Monday - Saturday: 10AM - 7PM<br>Sunday: By appointment only</p>
                    </div>
                </div>
                
                <!-- Location 2 - Paris -->
                <div class="location-card editable-section no-drop-zone" data-section="284">
                    <div class="location-image editable-section" data-section="285">
                        <img src="https://images.unsplash.com/photo-1541336187922-bffa4efb5b03?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Paris Boutique" class="editable-image" data-image="7">
                    </div>
                    <div class="location-info editable-section no-drop-zone" data-section="287">
                        <h3 class="location-name editable-text editable-section no-drop-zone" data-section="288" data-text="194">Paris Boutique</h3>
                        <p class="location-details editable-text editable-section no-drop-zone" data-section="289" data-text="195">18 Rue du Faubourg Saint-Honoré, 75008 Paris</p>
                        <p class="location-hours editable-text editable-section no-drop-zone" data-section="290" data-text="196">Tuesday - Saturday: 10AM - 7PM<br>Closed Sunday & Monday</p>
                    </div>
                </div>
                
                <!-- Location 3 - Milan -->
                <div class="location-card editable-section no-drop-zone" data-section="291">
                    <div class="location-image editable-section" data-section="292">
                        <img src="https://images.unsplash.com/photo-1591261730799-ee4e6c2d16d7?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Milan Atelier" class="editable-image" data-image="8">
                    </div>
                    <div class="location-info editable-section no-drop-zone" data-section="294">
                        <h3 class="location-name editable-text editable-section no-drop-zone" data-section="295" data-text="197">Milan Atelier</h3>
                        <p class="location-details editable-text editable-section no-drop-zone" data-section="296" data-text="198">Via Monte Napoleone 21, 20121 Milano</p>
                        <p class="location-hours editable-text editable-section no-drop-zone" data-section="297" data-text="199">Monday - Friday: 9AM - 6PM<br>Saturday: By appointment only</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        // FAQ Toggle Functionality
        function toggleFAQ(questionElement) {
            const faqItem = questionElement.closest('.faq-item');
            const answer = faqItem.querySelector('.faq-answer');
            
            // Close all other FAQs
            document.querySelectorAll('.faq-item').forEach(item => {
                if (item !== faqItem) {
                    item.classList.remove('active');
                    item.querySelector('.faq-answer').classList.remove('active');
                    const toggle = item.querySelector('.faq-toggle');
                    if (toggle) toggle.textContent = '+';
                }
            });
            
            // Toggle current FAQ
            faqItem.classList.toggle('active');
            answer.classList.toggle('active');
            
            // Update toggle symbol
            const toggle = faqItem.querySelector('.faq-toggle');
            if (toggle) {
                toggle.textContent = faqItem.classList.contains('active') ? '−' : '+';
            }
        }
        
        // Contact Form Submission
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Get form values
            const firstName = document.getElementById('firstName').value;
            const lastName = document.getElementById('lastName').value;
            const email = document.getElementById('email').value;
            const subject = document.getElementById('subject').value;
            const message = document.getElementById('message').value;
            
            // Simple validation
            if (!firstName || !lastName || !email || !subject || !message) {
                alert('Please fill in all required fields');
                return;
            }
            
            // In a real implementation, this would send data to a server
            console.log('Contact form submitted:', {
                firstName,
                lastName,
                email,
                subject,
                message
            });
            
            // Show success message
            alert('Thank you for your message! Our luxury fashion advisors will contact you within 24 hours.');
            
            // Reset form
            this.reset();
        });
        
        // Social icon hover effects
        document.addEventListener('DOMContentLoaded', function() {
            const socialIcons = document.querySelectorAll('.social-icon');
            
            socialIcons.forEach(icon => {
                icon.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = 'var(--text)';
                    this.style.color = 'var(--secondary)';
                    this.style.transform = 'translateY(-3px)';
                });
                
                icon.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = '';
                    this.style.color = '';
                    this.style.transform = '';
                });
            });
        });
    </script>
</body>
</html>