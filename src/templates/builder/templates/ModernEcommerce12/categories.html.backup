<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Collections | Élan Noir</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --text: #e2a970;
            --heading: #f1bb71;
            --heading: #fbca8a;
            --primary: #626616;
            --secondary: #ffffff;
            --accent: #f9f6f2;
            --border: #1a1a1a;
            --success: #f8f8f8;
            --warning: #333333;
            --error: #e5e5e5;
            --gray-medium: #999999;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            font-weight: 300;
            color: var(--warning);
            line-height: 1.6;
            background-color: var(--accent);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            color: var(--primary);
            letter-spacing: 0.5px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .section-padding {
            padding: 5rem 0;
        }

        .NObtn {
            display: inline-block;
            padding: 1rem 2.5rem;
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .NObtn-primary {
            background-color: var(--text);
            color: var(--secondary);
        }

        .NObtn-primary:hover {
            background-color: var(--heading);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .NObtn-secondary {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .NObtn-secondary:hover {
            background-color: var(--primary);
            color: var(--secondary);
        }

        /* Categories Page */
        .categories-page {
            padding: 8rem 0 4rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .page-header h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .page-header p {
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 3rem;
            margin-bottom: 5rem;
        }

        .category-card {
            position: relative;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.4s ease;
            height: 400px;
            cursor: pointer;
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

        .category-image {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--accent);
        }

        .category-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .category-card:hover .category-image img {
            transform: scale(1.05);
        }

        .category-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%);
        }

        .category-content {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            padding: 2rem;
            color: var(--secondary);
            z-index: 2;
        }

        .category-title {
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .category-description {
            font-size: 1rem;
            margin-bottom: 1.5rem;
            opacity: 0.9;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
        }

        .category-count {
            display: inline-block;
            padding: 0.4rem 1rem;
            background-color: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        .category-link {
            position: absolute;
            top: 2rem;
            right: 2rem;
            width: 45px;
            height: 45px;
            background-color: var(--secondary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            transition: all 0.3s ease;
            opacity: 0;
            transform: translateY(10px);
        }

        .category-card:hover .category-link {
            opacity: 1;
            transform: translateY(0);
        }

        .category-link:hover {
            background-color: var(--text);
            color: var(--secondary);
        }

        /* Empty Categories */
        .empty-categories {
            text-align: center;
            padding: 4rem 2rem;
            grid-column: 1 / -1;
        }

        .empty-categories i {
            font-size: 4rem;
            color: var(--error);
            margin-bottom: 1.5rem;
        }

        .empty-categories h3 {
            margin-bottom: 1rem;
            color: var(--primary);
        }

        .empty-categories p {
            color: var(--gray-medium);
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Featured Products Section */
        .featured-products {
            padding: 4rem 0;
            background-color: var(--secondary);
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-header h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .section-header p {
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto;
        }

        .featured-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2.5rem;
            margin-bottom: 3rem;
        }

        .featured-card {
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .featured-card:hover {
            transform: translateY(-10px);
        }

        .featured-image {
            height: 350px;
            background-color: var(--accent);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .featured-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .featured-card:hover .featured-image img {
            transform: scale(1.05);
        }

        .featured-info {
            text-align: center;
        }

        .featured-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--primary);
        }

        .featured-price {
            color: var(--text);
            font-weight: 500;
        }

        .featured-category {
            display: inline-block;
            padding: 0.3rem 1rem;
            background-color: var(--accent);
            color: var(--primary);
            font-size: 0.8rem;
            letter-spacing: 1px;
            border-radius: 4px;
            margin-top: 0.5rem;
        }

        .empty-featured {
            grid-column: 1 / -1;
            text-align: center;
            padding: 3rem;
            color: var(--gray-medium);
        }

        .empty-featured i {
            font-size: 3rem;
            margin-bottom: 1.5rem;
            color: var(--error);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
                gap: 2.5rem;
            }
        }

        @media (max-width: 1024px) {
            .categories-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 2rem;
            }
            
            .featured-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 2rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 1.5rem;
            }
            
            .categories-page {
                padding: 6rem 0 3rem;
            }
            
            .page-header h1 {
                font-size: 2.5rem;
            }
            
            .categories-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 1.5rem;
            }
            
            .category-card {
                height: 350px;
            }
            
            .section-header h2 {
                font-size: 2rem;
            }
            
            .featured-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 1.5rem;
            }
        }

        @media (max-width: 480px) {
            .page-header h1 {
                font-size: 2rem;
            }
            
            .categories-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .section-header h2 {
                font-size: 1.8rem;
            }
            
            .featured-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .category-title {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
<body>
    <!-- Categories Page -->
    <section class="categories-page editable-section" data-section="138">
        <div class="container">
            <!-- Page Header -->
            <div class="page-header">
                <h1 class="editable-text editable-section no-drop-zone" data-section="139" data-text="107">Curated Collections</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="140" data-text="108">Explore our luxury fashion organized by style and occasion</p>
            </div>

            <!-- Categories Grid -->
            <div class="categories-grid">
                <!-- Category 1 (Editable - only first) -->
                <div class="category-card editable-section no-drop-zone" data-section="141" onclick="viewCategory('evening-wear')">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1595777457583-95e059d581b8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Evening Wear">
                    </div>
                    <div class="category-overlay"></div>
                    <div class="category-content">
                        <h3 class="category-title editable-text editable-section no-drop-zone" data-section="142" data-text="109">Evening Wear</h3>
                        <p class="category-description editable-text editable-section no-drop-zone" data-section="143" data-text="110">Exquisite gowns and dresses for formal occasions and special events</p>
                        <span class="category-count editable-text editable-section no-drop-zone" data-section="144" data-text="111">24 Items</span>
                    </div>
                    <div class="category-link">
                        <i class="fas fa-arrow-right editable-icon" data-icon="35" data-default-class="fas fa-arrow-right"></i>
                    </div>
                </div>
                
                <!-- Category 2 (Not editable) -->
                <div class="category-card" onclick="viewCategory('tailoring')">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1539533113205-9fcb5d3b4e47?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Tailoring">
                    </div>
                    <div class="category-overlay"></div>
                    <div class="category-content">
                        <h3 class="category-title">Tailoring</h3>
                        <p class="category-description">Precision-crafted suits, blazers, and structured pieces</p>
                        <span class="category-count">18 Items</span>
                    </div>
                    <div class="category-link">
                        <i class="fas fa-arrow-right editable-icon" data-icon="35" data-default-class="fas fa-arrow-right"></i>
                    </div>
                </div>
                
                <!-- Category 3 (Not editable) -->
                <div class="category-card" onclick="viewCategory('outerwear')">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Outerwear">
                    </div>
                    <div class="category-overlay"></div>
                    <div class="category-content">
                        <h3 class="category-title">Outerwear</h3>
                        <p class="category-description">Luxury coats, jackets, and cold-weather essentials</p>
                        <span class="category-count">15 Items</span>
                    </div>
                    <div class="category-link">
                        <i class="fas fa-arrow-right editable-icon" data-icon="35" data-default-class="fas fa-arrow-right"></i>
                    </div>
                </div>
                
                <!-- Category 4 (Not editable) -->
                <div class="category-card" onclick="viewCategory('accessories')">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Accessories">
                    </div>
                    <div class="category-overlay"></div>
                    <div class="category-content">
                        <h3 class="category-title">Accessories</h3>
                        <p class="category-description">Fine jewelry, handbags, and luxury complements</p>
                        <span class="category-count">32 Items</span>
                    </div>
                    <div class="category-link">
                        <i class="fas fa-arrow-right editable-icon" data-icon="35" data-default-class="fas fa-arrow-right"></i>
                    </div>
                </div>
                
                <!-- Category 5 (Not editable) -->
                <div class="category-card" onclick="viewCategory('couture')">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Couture">
                    </div>
                    <div class="category-overlay"></div>
                    <div class="category-content">
                        <h3 class="category-title">Couture</h3>
                        <p class="category-description">One-of-a-kind pieces and limited edition collections</p>
                        <span class="category-count">8 Items</span>
                    </div>
                    <div class="category-link">
                        <i class="fas fa-arrow-right editable-icon" data-icon="35" data-default-class="fas fa-arrow-right"></i>
                    </div>
                </div>
                
                <!-- Category 6 (Not editable) -->
                <div class="category-card" onclick="viewCategory('ready-to-wear')">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1770&q=80" alt="Ready to Wear">
                    </div>
                    <div class="category-overlay"></div>
                    <div class="category-content">
                        <h3 class="category-title">Ready to Wear</h3>
                        <p class="category-description">Everyday luxury with elevated design and comfort</p>
                        <span class="category-count">42 Items</span>
                    </div>
                    <div class="category-link">
                        <i class="fas fa-arrow-right editable-icon" data-icon="35" data-default-class="fas fa-arrow-right"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section class="featured-products editable-section" data-section="145">
        <div class="container">
            <div class="section-header">
                <h2 class="editable-text editable-section no-drop-zone" data-section="146" data-text="112">Featured Collection</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="147" data-text="113">Discover our most coveted pieces from across all categories</p>
            </div>
            
            <div class="featured-grid">
                <!-- Featured Product 1 (Editable - only first) -->
                <div class="featured-card editable-section no-drop-zone" data-section="148">
                    <a href="?page=product-details">
                        <div class="featured-image">
                            <img src="https://images.unsplash.com/photo-1595777457583-95e059d581b8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" alt="Aurelia Silk Dress">
                        </div>
                        <div class="featured-info">
                            <h3 class="featured-name editable-text editable-section no-drop-zone" data-section="149" data-text="114">Aurelia Silk Dress</h3>
                            <p class="featured-price editable-text editable-section no-drop-zone" data-section="150" data-text="115">$1,850</p>
                            <span class="featured-category editable-text editable-section no-drop-zone" data-section="151" data-text="116">Evening Wear</span>
                        </div>
                    </a>
                </div>
                
                <!-- Featured Product 2 (Not editable) -->
                <div class="featured-card">
                    <a href="?page=product-details">
                        <div class="featured-image">
                            <img src="https://images.unsplash.com/photo-1539533113205-9fcb5d3b4e47?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80" alt="Tailored Wool Blazer">
                        </div>
                        <div class="featured-info">
                            <h3 class="featured-name">Tailored Wool Blazer</h3>
                            <p class="featured-price">$1,250</p>
                            <span class="featured-category">Tailoring</span>
                        </div>
                    </a>
                </div>
                
                <!-- Featured Product 3 (Not editable) -->
                <div class="featured-card">
                    <a href="?page=product-details">
                        <div class="featured-image">
                            <img src="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80" alt="Cashmere Coat">
                        </div>
                        <div class="featured-info">
                            <h3 class="featured-name">Alpine Cashmere Coat</h3>
                            <p class="featured-price">$2,750</p>
                            <span class="featured-category">Outerwear</span>
                        </div>
                    </a>
                </div>
                
                <!-- Featured Product 4 (Not editable) -->
                <div class="featured-card">
                    <a href="?page=product-details">
                        <div class="featured-image">
                            <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" alt="Pearl Necklace">
                        </div>
                        <div class="featured-info">
                            <h3 class="featured-name">Pearl & Diamond Necklace</h3>
                            <p class="featured-price">$1,850</p>
                            <span class="featured-category">Accessories</span>
                        </div>
                    </a>
                </div>
            </div>
            
            <div style="text-align: center;">
                <a href="?page=shop" class="NObtn NObtn-secondary editable-text editable-section no-drop-zone" data-section="152" data-text="117">View All Products</a>
            </div>
        </div>
    </section>

    <script>
        // View Category
        function viewCategory(categoryId) {
            console.log(`Viewing category: ${categoryId}`);
            // In real implementation, this would filter products by category
            // For now, redirect to shop page with category filter
            window.location.href = `?page=shop&category=${categoryId}`;
        }
        
        // Category Card Hover Effect Enhancement
        document.addEventListener('DOMContentLoaded', function() {
            const categoryCards = document.querySelectorAll('.category-card');
            
            categoryCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    const link = this.querySelector('.category-link');
                    if (link) {
                        link.style.transform = 'translateY(0)';
                        link.style.opacity = '1';
                    }
                });
                
                card.addEventListener('mouseleave', function() {
                    const link = this.querySelector('.category-link');
                    if (link) {
                        link.style.transform = 'translateY(10px)';
                        link.style.opacity = '0';
                    }
                });
                
                // Make entire card clickable
                card.addEventListener('click', function(e) {
                    if (!e.target.closest('.category-link')) {
                        const categoryId = this.getAttribute('onclick').match(/'([^']+)'/)[1];
                        viewCategory(categoryId);
                    }
                });
            });
        });
    </script>
</body>
</html>