<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | Élan Noir</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --text: #e2a970;
            --heading: #f1bb71;
            --heading: #fbca8a;
            --primary: #626616;
            --secondary: #ffffff;
            --accent: #f9f6f2;
            --border: #1a1a1a;
            --success: #f8f8f8;
            --warning: #333333;
            --error: #e5e5e5;
            --gray-medium: #999999;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            font-weight: 300;
            color: var(--warning);
            line-height: 1.6;
            background-color: var(--accent);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            color: var(--primary);
            letter-spacing: 0.5px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .section-padding {
            padding: 5rem 0;
        }

        .NObtn {
            display: inline-block;
            padding: 1rem 2.5rem;
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .NObtn-primary {
            background-color: var(--text);
            color: var(--secondary);
        }

        .NObtn-primary:hover {
            background-color: var(--heading);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .NObtn-secondary {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .NObtn-secondary:hover {
            background-color: var(--primary);
            color: var(--secondary);
        }

        .NObtn-sm {
            padding: 0.7rem 1.5rem;
            font-size: 0.85rem;
        }

        /* Wishlist Page */
        .wishlist-page {
            padding: 8rem 0 4rem;
        }

        .page-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .page-header h1 {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .page-header p {
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Wishlist Content */
        .wishlist-content {
            margin-bottom: 5rem;
        }

        .wishlist-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--error);
        }

        .wishlist-count {
            font-size: 1.1rem;
            color: var(--primary);
        }

        .wishlist-actions {
            display: flex;
            gap: 1rem;
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2.5rem;
        }

        .wishlist-item {
            position: relative;
            background-color: var(--secondary);
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease;
        }

        .wishlist-item:hover {
            transform: translateY(-5px);
        }

        .item-image {
            position: relative;
            height: 300px;
            overflow: hidden;
        }

        .item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .wishlist-item:hover .item-image img {
            transform: scale(1.05);
        }

        .item-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, transparent 60%, rgba(0, 0, 0, 0.1) 100%);
        }

        .item-actions {
            position: absolute;
            top: 1rem;
            right: 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .action-NObtn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--secondary);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            color: var(--primary);
            font-size: 1rem;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        }

        .action-NObtn:hover {
            background-color: var(--text);
            color: var(--secondary);
            transform: scale(1.1);
        }

        .remove-NObtn {
            color: #ff6b6b;
        }

        .remove-NObtn:hover {
            background-color: #ff6b6b;
            color: var(--secondary);
        }

        .item-info {
            padding: 1.5rem;
        }

        .item-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--primary);
        }

        .item-category {
            font-size: 0.9rem;
            color: var(--gray-medium);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .item-price {
            font-size: 1.1rem;
            color: var(--text);
            font-weight: 500;
            margin-bottom: 1rem;
        }

        .item-status {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            background-color: var(--accent);
            color: var(--primary);
            font-size: 0.8rem;
            border-radius: 4px;
            margin-bottom: 1rem;
        }

        .item-status.in-stock {
            background-color: #e8f5e9;
            color: #2e7d32;
        }

        .item-status.low-stock {
            background-color: #fff3e0;
            color: #f57c00;
        }

        .item-status.out-of-stock {
            background-color: #ffebee;
            color: #c62828;
        }

        .item-buttons {
            display: flex;
            gap: 0.5rem;
        }

        .add-to-cart-NObtn {
            flex: 1;
            padding: 0.7rem;
            background-color: var(--primary);
            color: var(--secondary);
            border: none;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            transition: background-color 0.3s ease;
        }

        .add-to-cart-NObtn:hover {
            background-color: var(--text);
        }

        .add-to-cart-NObtn:disabled {
            background-color: var(--error);
            cursor: not-allowed;
        }

        /* Empty Wishlist */
        .empty-wishlist {
            text-align: center;
            padding: 4rem 2rem;
            grid-column: 1 / -1;
        }

        .empty-wishlist i {
            font-size: 4rem;
            color: var(--error);
            margin-bottom: 1.5rem;
        }

        .empty-wishlist h3 {
            margin-bottom: 1rem;
            color: var(--primary);
        }

        .empty-wishlist p {
            color: var(--gray-medium);
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Recently Viewed Section */
        .recently-viewed {
            padding: 4rem 0;
            background-color: var(--secondary);
        }

        .section-title {
            text-align: center;
            margin-bottom: 3rem;
        }

        .section-title h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .section-title p {
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto;
        }

        .recent-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .recent-item {
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .recent-item:hover {
            transform: translateY(-10px);
        }

        .recent-image {
            height: 300px;
            background-color: var(--accent);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }

        .recent-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .recent-item:hover .recent-image img {
            transform: scale(1.05);
        }

        .recent-info {
            text-align: center;
        }

        .recent-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--primary);
        }

        .recent-price {
            color: var(--text);
            font-weight: 500;
        }

        .empty-recent {
            grid-column: 1 / -1;
            text-align: center;
            padding: 3rem;
            color: var(--gray-medium);
        }

        .empty-recent i {
            font-size: 3rem;
            margin-bottom: 1.5rem;
            color: var(--error);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .wishlist-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 2rem;
            }
            
            .recent-grid {
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 1.5rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 1.5rem;
            }
            
            .wishlist-page {
                padding: 6rem 0 3rem;
            }
            
            .page-header h1 {
                font-size: 2.5rem;
            }
            
            .wishlist-header {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }
            
            .wishlist-actions {
                width: 100%;
                justify-content: space-between;
            }
            
            .wishlist-grid {
                grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
                gap: 1.5rem;
            }
            
            .section-title h2 {
                font-size: 2rem;
            }
            
            .recent-grid {
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 1.5rem;
            }
        }

        @media (max-width: 480px) {
            .page-header h1 {
                font-size: 2rem;
            }
            
            .wishlist-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .section-title h2 {
                font-size: 1.8rem;
            }
            
            .recent-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .item-buttons {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <!-- Wishlist Page -->
    <section class="wishlist-page editable-section" data-section="120">
        <div class="container">
            <!-- Page Header -->
            <div class="page-header">
                <h1 class="editable-text editable-section no-drop-zone" data-section="121" data-text="93">Your Wishlist</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="122" data-text="94">Save your favorite luxury pieces for later</p>
            </div>

            <!-- Wishlist Content -->
            <div class="wishlist-content">
                <div class="wishlist-header">
                    <div class="wishlist-count editable-text editable-section no-drop-zone" data-section="123" data-text="95"><span id="wishlistCount">3</span> Items</div>
                    <div class="wishlist-actions">
                        <button class="NObtn NObtn-secondary NObtn-sm editable-text editable-section no-drop-zone" data-section="124" data-text="96" onclick="clearWishlist()">Clear All</button>
                        <button class="NObtn NObtn-primary NObtn-sm editable-text editable-section no-drop-zone" data-section="125" data-text="97" onclick="addAllToCart()">Add All to Cart</button>
                    </div>
                </div>

                <!-- Wishlist Grid -->
                <div class="wishlist-grid">
                    <!-- Wishlist Item 1 (Editable - only first) -->
                    <div class="wishlist-item editable-section no-drop-zone" data-section="126">
                        <div class="item-image">
                            <img src="https://images.unsplash.com/photo-1595777457583-95e059d581b8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" alt="Aurelia Silk Dress">
                            <div class="item-overlay"></div>
                            <div class="item-actions">
                                <button class="action-NObtn remove-NObtn" onclick="removeFromWishlist(this)">
                                    <i class="fas fa-times editable-icon" data-icon="30" data-default-class="fas fa-times"></i>
                                </button>
                                <button class="action-NObtn" onclick="quickView(1)">
                                    <i class="far fa-eye editable-icon" data-icon="31" data-default-class="far fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="item-info">
                            <span class="item-category editable-text editable-section no-drop-zone" data-section="127" data-text="98">Evening Wear</span>
                            <h3 class="item-name editable-text editable-section no-drop-zone" data-section="128" data-text="99">Aurelia Silk Dress</h3>
                            <p class="item-price editable-text editable-section no-drop-zone" data-section="129" data-text="100">$1,850</p>
                            <span class="item-status in-stock editable-text editable-section no-drop-zone" data-section="130" data-text="101">In Stock</span>
                            <div class="item-buttons">
                                <button class="add-to-cart-NObtn editable-text editable-section no-drop-zone" data-section="131" data-text="102" onclick="addToCartFromWishlist(1)">Add to Cart</button>
                                <button class="action-NObtn" onclick="moveToCart(this)">
                                    <i class="fas fa-shopping-cart editable-icon" data-icon="32" data-default-class="fas fa-shopping-cart"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Wishlist Item 2 (Not editable) -->
                    <div class="wishlist-item">
                        <div class="item-image">
                            <img src="https://images.unsplash.com/photo-1539533113205-9fcb5d3b4e47?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80" alt="Tailored Wool Blazer">
                            <div class="item-overlay"></div>
                            <div class="item-actions">
                                <button class="action-NObtn remove-NObtn" onclick="removeFromWishlist(this)">
                                    <i class="fas fa-times editable-icon" data-icon="30" data-default-class="fas fa-times"></i>
                                </button>
                                <button class="action-NObtn" onclick="quickView(2)">
                                    <i class="far fa-eye editable-icon" data-icon="31" data-default-class="far fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="item-info">
                            <span class="item-category">Tailoring</span>
                            <h3 class="item-name">Tailored Wool Blazer</h3>
                            <p class="item-price">$1,250</p>
                            <span class="item-status in-stock">In Stock</span>
                            <div class="item-buttons">
                                <button class="add-to-cart-NObtn" onclick="addToCartFromWishlist(2)">Add to Cart</button>
                                <button class="action-NObtn" onclick="moveToCart(this)">
                                    <i class="fas fa-shopping-cart editable-icon" data-icon="32" data-default-class="fas fa-shopping-cart"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Wishlist Item 3 (Not editable) -->
                    <div class="wishlist-item">
                        <div class="item-image">
                            <img src="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80" alt="Cashmere Coat">
                            <div class="item-overlay"></div>
                            <div class="item-actions">
                                <button class="action-NObtn remove-NObtn" onclick="removeFromWishlist(this)">
                                    <i class="fas fa-times editable-icon" data-icon="30" data-default-class="fas fa-times"></i>
                                </button>
                                <button class="action-NObtn" onclick="quickView(3)">
                                    <i class="far fa-eye editable-icon" data-icon="31" data-default-class="far fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="item-info">
                            <span class="item-category">Outerwear</span>
                            <h3 class="item-name">Alpine Cashmere Coat</h3>
                            <p class="item-price">$2,750</p>
                            <span class="item-status low-stock">Low Stock</span>
                            <div class="item-buttons">
                                <button class="add-to-cart-NObtn" onclick="addToCartFromWishlist(3)">Add to Cart</button>
                                <button class="action-NObtn" onclick="moveToCart(this)">
                                    <i class="fas fa-shopping-cart editable-icon" data-icon="32" data-default-class="fas fa-shopping-cart"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Wishlist Item 4 (Not editable) -->
                    <div class="wishlist-item">
                        <div class="item-image">
                            <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1031&q=80" alt="Evening Gown">
                            <div class="item-overlay"></div>
                            <div class="item-actions">
                                <button class="action-NObtn remove-NObtn" onclick="removeFromWishlist(this)">
                                    <i class="fas fa-times editable-icon" data-icon="30" data-default-class="fas fa-times"></i>
                                </button>
                                <button class="action-NObtn" onclick="quickView(4)">
                                    <i class="far fa-eye editable-icon" data-icon="31" data-default-class="far fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="item-info">
                            <span class="item-category">Couture</span>
                            <h3 class="item-name">Celestial Evening Gown</h3>
                            <p class="item-price">$3,200</p>
                            <span class="item-status out-of-stock">Out of Stock</span>
                            <div class="item-buttons">
                                <button class="add-to-cart-NObtn" disabled>Out of Stock</button>
                                <button class="action-NObtn" disabled>
                                    <i class="fas fa-shopping-cart editable-icon" data-icon="32" data-default-class="fas fa-shopping-cart"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Recently Viewed Section -->
    <section class="recently-viewed editable-section" data-section="132">
        <div class="container">
            <div class="section-title">
                <h2 class="editable-text editable-section no-drop-zone" data-section="133" data-text="103">Recently Viewed</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="134" data-text="104">Continue exploring pieces you've shown interest in</p>
            </div>
            
            <div class="recent-grid">
                <!-- Recent Item 1 (Editable - only first) -->
                <div class="recent-item editable-section no-drop-zone" data-section="135">
                    <a href="?page=product-details">
                        <div class="recent-image">
                            <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1031&q=80" alt="Designer Handbag">
                        </div>
                        <div class="recent-info">
                            <h3 class="recent-name editable-text editable-section no-drop-zone" data-section="136" data-text="105">Luxe Leather Handbag</h3>
                            <p class="recent-price editable-text editable-section no-drop-zone" data-section="137" data-text="106">$950</p>
                        </div>
                    </a>
                </div>
                
                <!-- Recent Item 2 (Not editable) -->
                <div class="recent-item">
                    <a href="?page=product-details">
                        <div class="recent-image">
                            <img src="https://images.unsplash.com/photo-1592878904946-b3cd8ae243d0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" alt="Silk Scarf">
                        </div>
                        <div class="recent-info">
                            <h3 class="recent-name">Italian Silk Scarf</h3>
                            <p class="recent-price">$320</p>
                        </div>
                    </a>
                </div>
                
                <!-- Recent Item 3 (Not editable) -->
                <div class="recent-item">
                    <a href="?page=product-details">
                        <div class="recent-image">
                            <img src="https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80" alt="Leather Shoes">
                        </div>
                        <div class="recent-info">
                            <h3 class="recent-name">Leather Evening Shoes</h3>
                            <p class="recent-price">$680</p>
                        </div>
                    </a>
                </div>
                
                <!-- Recent Item 4 (Not editable) -->
                <div class="recent-item">
                    <a href="?page=product-details">
                        <div class="recent-image">
                            <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80" alt="Pearl Necklace">
                        </div>
                        <div class="recent-info">
                            <h3 class="recent-name">Pearl & Diamond Necklace</h3>
                            <p class="recent-price">$1,850</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Wishlist Management
        function removeFromWishlist(button) {
            const item = button.closest('.wishlist-item');
            item.style.opacity = '0';
            item.style.transform = 'translateX(20px)';
            
            setTimeout(() => {
                item.remove();
                updateWishlistCount();
                checkEmptyWishlist();
            }, 300);
        }
        
        function updateWishlistCount() {
            const items = document.querySelectorAll('.wishlist-item');
            const countElement = document.getElementById('wishlistCount');
            countElement.textContent = items.length;
        }
        
        function clearWishlist() {
            const items = document.querySelectorAll('.wishlist-item');
            if (items.length === 0) {
                alert('Wishlist is already empty');
                return;
            }
            
            if (confirm('Are you sure you want to clear your entire wishlist?')) {
                items.forEach(item => {
                    item.style.opacity = '0';
                    item.style.transform = 'scale(0.8)';
                });
                
                setTimeout(() => {
                    const wishlistGrid = document.querySelector('.wishlist-grid');
                    wishlistGrid.innerHTML = '';
                    updateWishlistCount();
                    checkEmptyWishlist();
                }, 300);
            }
        }
        
        function checkEmptyWishlist() {
            const wishlistGrid = document.querySelector('.wishlist-grid');
            const items = wishlistGrid.querySelectorAll('.wishlist-item');
            
            if (items.length === 0) {
                const emptyWishlistHTML = `
                    <div class="empty-wishlist">
                        <i class="far fa-heart editable-icon" data-icon="33" data-default-class="far fa-heart"></i>
                        <h3>Your wishlist is empty</h3>
                        <p>Save your favorite luxury pieces here to revisit them later. Click the heart icon on any product to add it to your wishlist.</p>
                        <a href="?page=shop" class="NObtn NObtn-primary editable-text" data-section="138" data-text="107">Browse Collection</a>
                    </div>
                `;
                wishlistGrid.innerHTML = emptyWishlistHTML;
            }
        }
        
        // Add to Cart Functions
        function addToCartFromWishlist(productId) {
            console.log(`Adding product ${productId} to cart from wishlist`);
            alert('Item added to cart!');
        }
        
        function moveToCart(button) {
            const item = button.closest('.wishlist-item');
            const productName = item.querySelector('.item-name').textContent;
            
            // Add to cart
            console.log(`Moving ${productName} to cart`);
            
            // Remove from wishlist
            item.style.opacity = '0';
            item.style.transform = 'translateX(20px)';
            
            setTimeout(() => {
                item.remove();
                updateWishlistCount();
                checkEmptyWishlist();
                alert(`${productName} moved to cart!`);
            }, 300);
        }
        
        function addAllToCart() {
            const items = document.querySelectorAll('.wishlist-item');
            if (items.length === 0) {
                alert('Wishlist is empty');
                return;
            }
            
            let count = 0;
            items.forEach(item => {
                const status = item.querySelector('.item-status');
                if (!status.classList.contains('out-of-stock')) {
                    count++;
                }
            });
            
            if (count === 0) {
                alert('All items in your wishlist are out of stock');
                return;
            }
            
            if (confirm(`Add ${count} available items to cart?`)) {
                items.forEach(item => {
                    const status = item.querySelector('.item-status');
                    if (!status.classList.contains('out-of-stock')) {
                        const productName = item.querySelector('.item-name').textContent;
                        console.log(`Adding ${productName} to cart`);
                        
                        // Visual feedback
                        const cartNObtn = item.querySelector('.add-to-cart-NObtn');
                        cartNObtn.textContent = 'Added!';
                        cartNObtn.style.backgroundColor = 'var(--text)';
                        
                        setTimeout(() => {
                            cartNObtn.textContent = 'Add to Cart';
                            cartNObtn.style.backgroundColor = '';
                        }, 1500);
                    }
                });
                
                alert(`${count} items added to cart!`);
            }
        }
        
        // Quick View
        function quickView(productId) {
            console.log(`Quick view for product ${productId}`);
            alert('Quick view feature - would open product details modal');
        }
        
        // Initialize on load
        document.addEventListener('DOMContentLoaded', function() {
            updateWishlistCount();
        });
    </script>
</body>
</html>

