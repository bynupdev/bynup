<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ÆTHERIA | Organic Architecture</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts for Surrealist Art Contrast -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=Plus+Jakarta+Sans:wght@200;300;400;500&family=DM+Mono&display=swap" rel="stylesheet">
    
    <style>
        /* ================= WELCOMING ARTISTIC PALETTE ================= */
        :root {
            --bg-canvas: #f9f6f0;
            --clay-warm: #e3dcd2;
            --terracotta: #c68a6b;
            --sage-moss: #7e8f80;
            --ink-charcoal: #1e2221;
            --pure-light: #ffffff;
            
            --font-artistic: 'Cormorant Garamond', serif;
            --font-structural: 'Plus Jakarta Sans', sans-serif;
            --font-gallery: 'DM Mono', monospace;
            
            --transition-art: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-structural);
            background-color: var(--bg-canvas);
            color: var(--ink-charcoal);
            overflow-x: hidden;
            line-height: 1.6;
        }

        .pigment-stain-1 {
            position: fixed;
            top: -5%;
            right: -5%;
            width: 45vw;
            height: 45vw;
            background: radial-gradient(circle, rgba(198,138,107,0.12) 0%, rgba(0,0,0,0) 70%);
            z-index: -1;
            pointer-events: none;
        }

        .pigment-stain-2 {
            position: fixed;
            bottom: 5%;
            left: -10%;
            width: 55vw;
            height: 55vw;
            background: radial-gradient(circle, rgba(126,143,128,0.15) 0%, rgba(0,0,0,0) 70%);
            z-index: -1;
            pointer-events: none;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg-canvas); }
        ::-webkit-scrollbar-thumb { background: var(--terracotta); border-radius: 3px; }

        .gallery-tag {
            font-family: var(--font-gallery);
            font-size: 11px;
            color: var(--terracotta);
            text-transform: uppercase;
            letter-spacing: 3px;
            display: inline-block;
            margin-bottom: 20px;
        }

        /* ================= FLOATING GLASS NAVIGATION ================= */
        .art-nav {
            position: fixed;
            top: 25px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 60px);
            max-width: 1400px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            z-index: 100;
            background: rgba(249, 246, 240, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(30, 34, 33, 0.05);
            border-radius: 50px;
        }

        .nav-brand {
            font-family: var(--font-artistic);
            font-size: 28px;
            letter-spacing: 4px;
            color: var(--ink-charcoal);
            text-decoration: none;
            font-weight: 400;
        }

        .nav-menu {
            display: flex;
            gap: 40px;
        }

        .nav-menu a {
            font-family: var(--font-structural);
            font-weight: 400;
            font-size: 13px;
            color: var(--ink-charcoal);
            text-decoration: none;
            letter-spacing: 0.5px;
            transition: var(--transition-art);
        }

        .nav-menu a:hover {
            color: var(--terracotta);
            transform: translateY(-1px);
        }

        .nav-meta-actions {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-icon-btn {
            background: none;
            border: none;
            color: var(--ink-charcoal);
            font-size: 18px;
            cursor: pointer;
            position: relative;
            transition: var(--transition-art);
        }

        .badge-dot {
            position: absolute;
            top: -2px;
            right: -3px;
            width: 7px;
            height: 7px;
            background-color: var(--terracotta);
            border-radius: 50%;
            display: none;
        }

        /* ================= ASYMMETRICAL EDITORIAL HERO ================= */
        .hero-canvas {
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            padding: 160px 60px 80px 60px;
        }

        .hero-layout {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            width: 100%;
            max-width: 1300px;
            margin: 0 auto;
            align-items: center;
            gap: 40px;
        }

        .hero-statement-box {
            z-index: 5;
            padding-right: 20px;
        }

        .hero-statement-box h1 {
            font-family: var(--font-artistic);
            font-size: 5.2vw;
            line-height: 1.1;
            font-weight: 300;
            color: var(--ink-charcoal);
            margin-bottom: 45px;
        }

        .hero-statement-box h1 em {
            font-family: var(--font-artistic);
            font-style: italic;
            font-weight: 300;
            color: var(--terracotta);
        }

        .art-cta-link {
            font-family: var(--font-gallery);
            font-size: 12px;
            color: var(--ink-charcoal);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 15px;
            border: 1px solid rgba(30, 34, 33, 0.15);
            padding: 18px 38px;
            border-radius: 40px;
            transition: var(--transition-art);
            position: relative;
            background-color: transparent;
            z-index: 1;
        }

        .art-cta-link::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-color: var(--ink-charcoal);
            border-radius: 40px;
            z-index: -1;
            transform: scale(0);
            transition: var(--transition-art);
        }

        .art-cta-link:hover {
            color: var(--bg-canvas);
            border-color: var(--ink-charcoal);
        }

        .art-cta-link:hover::before {
            transform: scale(1);
        }

        .hero-sculpture-frame {
            position: relative;
            height: 70vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .sculpture-bg-panel {
            position: absolute;
            width: 90%;
            height: 100%;
            background: var(--clay-warm);
            border-radius: 120px 40px 100px 40px;
            z-index: 1;
            transform: rotate(-2deg);
        }

        .sculpture-img {
            width: 80%;
            height: 90%;
            object-fit: cover;
            border-radius: 8px;
            z-index: 2;
            box-shadow: 0 30px 60px rgba(30, 34, 33, 0.08);
            transition: var(--transition-art);
        }

        .hero-sculpture-frame:hover .sculpture-img {
            transform: scale(1.03) rotate(1deg);
        }

        /* ================= EXHIBITION PORTFOLIO GALLERY ================= */
        .portfolio-canvas {
            padding: 140px 60px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .portfolio-intro {
            margin-bottom: 100px;
            max-width: 600px;
        }

        .portfolio-intro h2 {
            font-family: var(--font-artistic);
            font-size: 3.8rem;
            font-weight: 300;
            line-height: 1.1;
        }

        .exhibition-deck {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 60px;
        }

        .exhibition-deck .art-card:nth-child(2) {
            transform: translateY(50px);
        }
        .exhibition-deck .art-card:nth-child(3) {
            transform: translateY(-30px);
        }

        .art-card {
            background: transparent;
            display: flex;
            flex-direction: column;
        }

        .art-card-viewport {
            width: 100%;
            aspect-ratio: 3 / 4;
            background-color: var(--clay-warm);
            overflow: hidden;
            position: relative;
            border-radius: 6px;
            box-shadow: 0 15px 35px rgba(30, 34, 33, 0.03);
        }

        .art-card-viewport img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 1.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .art-card:hover .art-card-viewport img {
            transform: scale(1.06);
        }

        .art-card-overlay {
            position: absolute;
            inset: 0;
            background: rgba(243, 238, 230, 0.4);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            opacity: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            transition: var(--transition-art);
            z-index: 3;
        }

        .art-card:hover .art-card-overlay {
            opacity: 1;
        }

        .circular-action-btn {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            border: 1px solid var(--ink-charcoal);
            background: var(--pure-light);
            color: var(--ink-charcoal);
            font-size: 15px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition-art);
            box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        }

        .circular-action-btn:hover {
            background-color: var(--ink-charcoal);
            color: var(--bg-canvas);
            transform: scale(1.1);
        }

        .art-card-details {
            padding-top: 25px;
        }

        .art-card-header-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 10px;
        }

        .art-card-title {
            font-family: var(--font-artistic);
            font-size: 28px;
            font-weight: 400;
            color: var(--ink-charcoal);
            cursor: pointer;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .art-card-title:hover {
            color: var(--terracotta);
        }

        .art-card-price {
            font-family: var(--font-gallery);
            font-size: 13px;
            color: var(--sage-moss);
            font-weight: 500;
        }

        .art-card-desc {
            font-size: 13.5px;
            color: #5c6260;
            font-weight: 300;
            line-height: 1.6;
        }

        /* ================= THE POETIC MANIFESTO (ABOUT US) ================= */
        .about-canvas {
            background-color: #ede7de;
            color: var(--ink-charcoal);
            position: relative;
            padding: 160px 0;
            margin-top: 100px;
        }

        .about-split-layout {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 40px;
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 100px;
            align-items: center;
        }

        .about-manifesto-sticky h2 {
            font-family: var(--font-artistic);
            font-size: 4.5rem;
            font-weight: 300;
            line-height: 1.1;
        }

        .about-narrative-block {
            font-size: 17px;
            font-weight: 300;
            line-height: 1.9;
            color: #383d3b;
        }

        .about-narrative-block p {
            margin-bottom: 30px;
        }

        .about-narrative-block p:first-of-type::first-letter {
            font-family: var(--font-artistic);
            font-size: 90px;
            float: left;
            line-height: 60px;
            padding-top: 4px;
            padding-right: 15px;
            color: var(--terracotta);
        }

        /* ================= THE VERITIES STACK (FAQ) ================= */
        .faq-canvas {
            padding: 160px 60px;
            max-width: 1000px;
            margin: 0 auto;
        }

        .faq-accordion-stack {
            margin-top: 60px;
        }

        .faq-art-node {
            border-bottom: 1px solid rgba(30, 34, 33, 0.1);
            padding: 35px 0;
        }

        .faq-art-trigger {
            width: 100%;
            background: none;
            border: none;
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            color: var(--ink-charcoal);
            font-family: var(--font-artistic);
            font-size: 30px;
        }

        .faq-art-trigger span:first-child {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .faq-index {
            font-family: var(--font-gallery);
            font-size: 12px;
            color: var(--sage-moss);
        }

        .faq-icon-indicator {
            font-size: 15px;
            transition: transform 0.4s ease;
            color: var(--terracotta);
        }

        .faq-art-body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .faq-art-body p {
            padding: 20px 0 0 55px;
            font-size: 14.5px;
            color: #5c6260;
            max-width: 750px;
            line-height: 1.7;
        }

        /* ================= CONCIERGE LINK SYSTEM (CONTACT) ================= */
        .contact-canvas {
            padding: 100px 60px 160px 60px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .contact-card-box {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            border: 1px solid rgba(30, 34, 33, 0.08);
            background: var(--pure-light);
            border-radius: 12px;
            box-shadow: 0 40px 80px rgba(30, 34, 33, 0.03);
            overflow: hidden;
        }

        .contact-aesthetic-sidebar {
            padding: 50px;
            border-right: 1px solid rgba(30, 34, 33, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background-color: #f5f0e6;
        }

        .contact-aesthetic-sidebar h3 {
            font-family: var(--font-artistic);
            font-size: 36px;
            line-height: 1.1;
            font-weight: 400;
        }

        .studio-coordinates {
            font-family: var(--font-gallery);
            font-size: 12px;
            line-height: 2;
            color: #5c6260;
        }

        .contact-form-pane {
            padding: 60px;
        }

        .art-form-group {
            position: relative;
            margin-bottom: 45px;
        }

        .art-form-group input,
        .art-form-group select,
        .art-form-group textarea {
            width: 100%;
            background: none;
            border: none;
            border-bottom: 1px solid rgba(30, 34, 33, 0.15);
            padding: 12px 0;
            font-family: var(--font-structural);
            font-size: 14px;
            color: var(--ink-charcoal);
            outline: none;
            transition: var(--transition-art);
        }

        .art-form-group label {
            position: absolute;
            left: 0;
            top: 12px;
            font-family: var(--font-structural);
            font-size: 12px;
            color: #8a908e;
            text-transform: uppercase;
            letter-spacing: 1px;
            pointer-events: none;
            transition: var(--transition-art);
        }

        .art-form-group input:focus ~ label,
        .art-form-group input:not(:placeholder-shown) ~ label,
        .art-form-group textarea:focus ~ label,
        .art-form-group textarea:not(:placeholder-shown) ~ label {
            top: -15px;
            font-size: 10px;
            color: var(--terracotta);
        }

        .art-form-group input:focus,
        .art-form-group textarea:focus {
            border-bottom-color: var(--terracotta);
        }

        .art-submit-btn {
            background: var(--ink-charcoal);
            color: var(--bg-canvas);
            border: none;
            padding: 20px 45px;
            font-family: var(--font-gallery);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 40px;
            transition: var(--transition-art);
        }

        .art-submit-btn:hover {
            background-color: var(--terracotta);
            color: var(--pure-light);
            transform: translateY(-2px);
        }

        /* ================= SIDE PANEL DRAWERS ================= */
        .slider-backdrop {
            position: fixed;
            inset: 0;
            background-color: rgba(30, 34, 33, 0.2);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 200;
            display: none;
        }

        .art-sidebar {
            position: fixed;
            top: 0;
            right: 0;
            height: 100%;
            width: 100%;
            max-width: 480px;
            background-color: var(--bg-canvas);
            border-left: 1px solid rgba(30, 34, 33, 0.08);
            z-index: 210;
            transform: translateX(100%);
            transition: var(--transition-art);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px;
        }

        .art-sidebar.active {
            transform: translateX(0);
        }

        .sidebar-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(30, 34, 33, 0.08);
            padding-bottom: 20px;
        }

        .sidebar-top h3 {
            font-family: var(--font-artistic);
            font-size: 32px;
        }

        .close-sidebar-btn {
            background: none;
            border: none;
            color: #8a908e;
            font-size: 20px;
            cursor: pointer;
            transition: var(--transition-art);
        }

        .close-sidebar-btn:hover { color: var(--ink-charcoal); }

        .sidebar-scroll-zone {
            flex-grow: 1;
            overflow-y: auto;
            padding: 20px 0;
        }

        .basket-item {
            display: flex;
            gap: 20px;
            align-items: center;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(30, 34, 33, 0.06);
        }

        .basket-item-img {
            width: 70px;
            height: 90px;
            object-fit: cover;
            border-radius: 4px;
        }

        .basket-item-info {
            flex-grow: 1;
        }

        .basket-item-info h4 {
            font-family: var(--font-artistic);
            font-size: 22px;
        }

        .basket-item-meta {
            font-family: var(--font-gallery);
            font-size: 11px;
            color: #7a807e;
        }

        .basket-item-price {
            font-family: var(--font-gallery);
            font-size: 12px;
            color: var(--terracotta);
            margin-top: 4px;
        }

        .remove-basket-btn {
            background: none;
            border: none;
            color: #a0a6a4;
            cursor: pointer;
            transition: var(--transition-art);
        }

        .remove-basket-btn:hover { color: #b04141; }

        .sidebar-footer {
            border-top: 1px solid rgba(30, 34, 33, 0.08);
            padding-top: 25px;
        }

        .total-ledger-row {
            display: flex;
            justify-content: space-between;
            font-family: var(--font-gallery);
            font-size: 14px;
            margin-bottom: 25px;
        }

        /* ================= SENSORY EXPLORATION MODAL ================= */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background-color: rgba(30, 34, 33, 0.4);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            z-index: 300;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .art-modal-container {
            background-color: var(--bg-canvas);
            border: 1px solid rgba(30, 34, 33, 0.08);
            max-width: 1100px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-radius: 12px;
            box-shadow: 0 50px 100px rgba(0,0,0,0.1);
        }

        .modal-dismiss {
            position: absolute;
            top: 25px;
            right: 25px;
            background: none;
            border: none;
            color: var(--ink-charcoal);
            font-size: 22px;
            cursor: pointer;
            z-index: 10;
        }

        .modal-gallery-pane {
            background-color: var(--clay-warm);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px;
        }

        .modal-gallery-pane img {
            width: 100%;
            max-height: 480px;
            object-fit: cover;
            border-radius: 6px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        }

        .modal-curator-pane {
            padding: 60px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .modal-product-title {
            font-family: var(--font-artistic);
            font-size: 42px;
            line-height: 1.1;
            margin-bottom: 5px;
        }

        .modal-product-price {
            font-family: var(--font-gallery);
            font-size: 16px;
            color: var(--terracotta);
            margin-bottom: 30px;
        }

        .config-label {
            font-family: var(--font-gallery);
            font-size: 10px;
            color: #8a908e;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: block;
            letter-spacing: 1px;
        }

        .modal-variant-row {
            display: flex;
            gap: 12px;
            margin-bottom: 35px;
        }

        .art-capsule-btn {
            background: var(--pure-light);
            border: 1px solid rgba(30, 34, 33, 0.12);
            color: var(--ink-charcoal);
            padding: 10px 22px;
            font-family: var(--font-structural);
            font-size: 12px;
            border-radius: 30px;
            cursor: pointer;
            transition: var(--transition-art);
        }

        .art-capsule-btn.active {
            background-color: var(--ink-charcoal);
            color: var(--bg-canvas);
            border-color: var(--ink-charcoal);
        }

        .composition-breakdown {
            list-style: none;
            margin-bottom: 40px;
        }

        .composition-breakdown li {
            font-size: 13.5px;
            color: #434846;
            padding: 10px 0;
            border-bottom: 1px solid rgba(30, 34, 33, 0.06);
            display: flex;
            justify-content: space-between;
        }

        .composition-breakdown li span:last-child {
            font-family: var(--font-gallery);
            font-size: 12px;
            color: var(--sage-moss);
        }

        /* --- Nested Ledger Book Reviews --- */
        .notebook-reviews-container {
            border-top: 1px solid rgba(30, 34, 33, 0.08);
            padding-top: 30px;
            margin-top: 20px;
        }

        .notebook-scroll {
            max-height: 140px;
            overflow-y: auto;
            margin-bottom: 25px;
        }

        .notebook-entry {
            font-size: 12.5px;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px dashed rgba(30, 34, 33, 0.08);
        }

        .entry-meta {
            font-family: var(--font-gallery);
            font-size: 10px;
            color: var(--sage-moss);
            margin-bottom: 4px;
            display: flex;
            justify-content: space-between;
        }

        .entry-text {
            color: #434846;
            font-style: italic;
        }

        .notebook-form-box input, 
        .notebook-form-box textarea {
            background: var(--pure-light);
            border: 1px solid rgba(30, 34, 33, 0.1);
            padding: 10px;
            color: var(--ink-charcoal);
            font-size: 12px;
            outline: none;
            width: 100%;
            margin-bottom: 10px;
            border-radius: 4px;
        }

        /* ================= MONOCHROMATIC ART FOOTER ================= */
        .art-footer {
            background-color: #ede7de;
            border-top: 1px solid rgba(30, 34, 33, 0.05);
            padding: 100px 60px 40px 60px;
        }

        .footer-universe-grid {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 100px;
            margin-bottom: 80px;
        }

        .footer-quote h3 {
            font-family: var(--font-artistic);
            font-size: 38px;
            font-weight: 400;
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .footer-heading {
            font-family: var(--font-gallery);
            font-size: 11px;
            text-transform: uppercase;
            color: var(--terracotta);
            margin-bottom: 25px;
            letter-spacing: 2px;
        }

        .footer-nav-list {
            list-style: none;
        }

        .footer-nav-list li {
            margin-bottom: 14px;
        }

        .footer-nav-list a {
            font-size: 13.5px;
            color: #5c6260;
            text-decoration: none;
            transition: var(--transition-art);
        }

        .footer-nav-list a:hover {
            color: var(--ink-charcoal);
            padding-left: 4px;
        }

        .art-socials-row {
            display: flex;
            gap: 20px;
            margin-top: 25px;
        }

        .art-socials-row a {
            color: #8a908e;
            font-size: 18px;
            transition: var(--transition-art);
        }

        .art-socials-row a:hover { color: var(--ink-charcoal); }

        .footer-bottom-curator {
            max-width: 1300px;
            margin: 0 auto;
            border-top: 1px solid rgba(30, 34, 33, 0.08);
            padding-top: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: var(--font-gallery);
            font-size: 11px;
            color: #8a908e;
        }

        /* ================= RESPONSIVE ADAPTATIONS ================= */
        @media (max-width: 1024px) {
            .exhibition-deck { grid-template-columns: 1fr; gap: 60px; }
            .exhibition-deck .art-card:nth-child(2),
            .exhibition-deck .art-card:nth-child(3) { transform: translateY(0); }
            .hero-layout { grid-template-columns: 1fr; gap: 40px; }
            .hero-sculpture-frame { height: 50vh; }
            .about-split-layout { grid-template-columns: 1fr; gap: 50px; }
            .art-modal-container { grid-template-columns: 1fr; }
            .footer-universe-grid { grid-template-columns: 1fr; gap: 50px; }
        }

        @media (max-width: 768px) {
            .art-nav { padding: 0 25px; width: calc(100% - 30px); }
            .nav-menu { display: none; } 
            .hero-canvas { padding: 140px 30px 40px 30px; }
            .hero-statement-box h1 { font-size: 8vw; }
            .contact-card-box { grid-template-columns: 1fr; }
            .contact-aesthetic-sidebar { border-right: none; border-bottom: 1px solid rgba(30,34,33,0.08); }
        }
    </style>
</head>
<body>

    <!-- Light Fluid Background Stains -->
    <div class="pigment-stain-1"></div>
    <div class="pigment-stain-2"></div>

    <!-- ================= FLOATING GLASS NAVIGATION ================= -->
    <nav class="art-nav editable-section" data-section="1">
        <a href="#canvas" class="nav-brand editable-text editable-section" data-section="2" data-text="1">ÆTHERIA</a>
        
        <div class="nav-menu">
            <a href="#exhibition" class="editable-text editable-section" data-section="3" data-text="2">Exhibits</a>
            <a href="#manifesto" class="editable-text editable-section" data-section="4" data-text="3">The Philosophy</a>
            <a href="#curations" class="editable-text editable-section" data-section="5" data-text="4">Inquiries</a>
            <a href="#contact" class="editable-text editable-section" data-section="6" data-text="5">Coordinates</a>
        </div>

        <div class="nav-meta-actions">
            <button class="nav-icon-btn editable-section no-drop-zone" data-section="7" onclick="openSidebar('desires-drawer')" aria-label="View desires">
                <i class="fa-regular fa-star editable-icon" data-icon="101" data-default-class="fa-regular fa-star"></i>
                <span id="desires-dot" class="badge-dot"></span>
            </button>
            
            <button class="nav-icon-btn editable-section no-drop-zone" data-section="8" onclick="openSidebar('collector-drawer')" aria-label="View collector bag">
                <i class="fa-solid fa-fingerprint editable-icon" data-icon="120" data-default-class="fa-solid fa-fingerprint"></i>
                <span id="collector-dot" class="badge-dot"></span>
            </button>
        </div>
    </nav>

    <!-- ================= HERO LAYER ================= -->
    <header id="canvas" class="hero-canvas editable-section" data-section="9">
        <div class="hero-layout">
            <div class="hero-statement-box editable-section no-drop-zone" data-section="10">
                <span class="gallery-tag editable-text editable-section" data-section="11" data-text="6">Olfactive Anthology // Vol. I</span>
                <h1><span class="editable-text editable-section" data-section="12" data-text="7">Liquid textures mapped to construct</span> <em class="editable-text editable-section" data-section="13" data-text="8">invisible art fields</em>.</h1>
                <a href="#exhibition" class="art-cta-link editable-text editable-section" data-section="14" data-text="9">
                    <span>Explore Gallery Exhibits</span>
                    <i class="fa-solid fa-arrow-right-long"></i>
                </a>
            </div>
            
            <div class="hero-sculpture-frame">
                <div class="sculpture-bg-panel"></div>
                <img src="https://images.pexels.com/photos/9659891/pexels-photo-9659891.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Ethereal abstract sculpture" class="sculpture-img editable-image" data-image="1">
            </div>
        </div>
    </header>

    <!-- ================= ACTIVE PORTFOLIO GALLERY ================= -->
    <section id="exhibition" class="portfolio-canvas editable-section" data-section="15">
        <div class="portfolio-intro editable-section no-drop-zone" data-section="16">
            <span class="gallery-tag editable-text editable-section" data-section="17" data-text="10">Current Exhibitions</span>
            <h2 class="editable-text editable-section" data-section="18" data-text="11">Olfactive Artifacts Available for Capture.</h2>
        </div>

        <div id="exhibition-deck-target" class="exhibition-deck">
            <!-- Products rendered in HTML below -->
        </div>
    </section>

    <!-- ================= ABOUT US SECTION ================= -->
    <section id="manifesto" class="about-canvas editable-section" data-section="19">
        <div class="about-split-layout">
            <div class="about-manifesto-sticky editable-section no-drop-zone" data-section="20">
                <span class="gallery-tag editable-text editable-section" data-section="21" data-text="12">The Anthology Manifesto</span>
                <h2 class="editable-text editable-section" data-section="22" data-text="13">We are not perfumers.<br>We are chroniclers.</h2>
            </div>
            
            <div class="about-narrative-block editable-section no-drop-zone" data-section="23">
                <p class="editable-text editable-section" data-section="24" data-text="14">Ætheria was founded not in a commercial laboratory, but in the intersection of poetry and chemical expressionism. We believe that fragrance is an architectural layer worn over the human spirit—an immersive landscape that reconstructs environments, long-lost moments, and deep tactile art fields.</p>
                
                <p class="editable-text editable-section" data-section="25" data-text="15">Every single dynamic compound is gathered manually across specialized micro-climates, ensuring wild-harvested botanicals remain pure. Our glass bottles are blown by hand by Venetian masters, celebrating physical imperfections. To look at an Ætheria artifact is to look at a singular human timestamp that will never happen the exact same way again.</p>
                
                <p class="editable-text editable-section" data-section="26" data-text="16">We work outside the traditional laws of commercial styling. We collaborate directly with sculptors, painters, and composers to construct sensory definitions for concepts that cannot be parsed by sight alone. Welcome to the alternative olfactive paradigm.</p>
            </div>
        </div>
    </section>

    <!-- ================= INQUIRIES SECTION ================= -->
    <section id="curations" class="faq-canvas editable-section" data-section="27">
        <span class="gallery-tag editable-text editable-section" data-section="28" data-text="17">Curatorial Protocols</span>
        <h2 style="font-family: var(--font-artistic); font-size: 3.5rem; font-weight: 300; margin-bottom: 20px;" class="editable-text editable-section" data-section="29" data-text="18">Queries & Verities</h2>
        
        <div class="faq-accordion-stack">
            <div class="faq-art-node editable-section no-drop-zone" data-section="30">
                <button class="faq-art-trigger" onclick="toggleArtAccordion(this)">
                    <span><span class="faq-index editable-text editable-section" data-section="31" data-text="19">01//</span><span class="editable-text editable-section" data-section="32" data-text="20">Are these configurations unisexual?</span></span>
                    <i class="faq-icon-indicator fa-solid fa-plus"></i>
                </button>
                <div class="faq-art-body">
                    <p class="editable-text editable-section" data-section="33" data-text="21">Art holds no structural gender. Our compositions react uniquely to individual skin chemistry, establishing an intimate profile designed without arbitrary industrial labels.</p>
                </div>
            </div>

            <div class="faq-art-node editable-section no-drop-zone" data-section="34">
                <button class="faq-art-trigger" onclick="toggleArtAccordion(this)">
                    <span><span class="faq-index editable-text editable-section" data-section="35" data-text="22">02//</span><span class="editable-text editable-section" data-section="36" data-text="23">How does fluid aging alter the profile?</span></span>
                    <i class="faq-icon-indicator fa-solid fa-plus"></i>
                </button>
                <div class="faq-art-body">
                    <p class="editable-text editable-section" data-section="37" data-text="24">Because we implement high concentrations of live botanical extractions, our formulations evolve across time. Dark elements grow increasingly deep and ambery, altering character over decades like fine oils.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= CONCIERGE FORM INTERFACE ================= -->
    <section id="contact" class="contact-canvas editable-section" data-section="38">
        <div class="contact-card-box editable-section no-drop-zone" data-section="39">
            <div class="contact-aesthetic-sidebar editable-section no-drop-zone" data-section="40">
                <div>
                    <span class="gallery-tag editable-text editable-section" data-section="41" data-text="25">Telemetry</span>
                    <h3 class="editable-text editable-section" data-section="42" data-text="26">Establish Studio Link</h3>
                </div>
                <div class="studio-coordinates editable-text editable-section" data-section="43" data-text="27">
                    Atelier Ætheria<br>
                    Quai des Orfèvres, No. 19<br>
                    Paris Archive Branch<br>
                    <span style="color: var(--terracotta);">studio@aetheria.art</span>
                </div>
            </div>

            <div class="contact-form-pane editable-section no-drop-zone" data-section="44">
                <form id="artTelemetryForm" onsubmit="transmitTelemetryDocument(event)">
                    <div class="art-form-group">
                        <input type="text" id="senderName" class="editable-text editable-section" data-section="45" data-text="28" placeholder=" " required>
                        <label for="senderName" class="editable-text editable-section" data-section="46" data-text="29">Patron Identification Signature</label>
                    </div>

                    <div class="art-form-group">
                        <input type="email" id="senderEmail" class="editable-text editable-section" data-section="47" data-text="30" placeholder=" " required>
                        <label for="senderEmail" class="editable-text editable-section" data-section="48" data-text="31">Digital Communication Matrix</label>
                    </div>

                    <div class="art-form-group">
                        <textarea id="messageText" rows="4" class="editable-text editable-section" data-section="49" data-text="32" placeholder=" " required></textarea>
                        <label for="messageText" class="editable-text editable-section" data-section="50" data-text="33">Conceptual Transcript Manifest</label>
                    </div>

                    <button type="submit" class="art-submit-btn editable-text editable-section" data-section="51" data-text="34">Transmit Document</button>
                </form>
            </div>
        </div>
    </section>

    <!-- ================= DRAWERS OVERLAYS ================= -->
    <div id="slider-backdrop-layer" class="slider-backdrop" onclick="closeAllDrawers()"></div>

    <!-- Collection Bag Sidebar -->
    <div id="collector-drawer" class="art-sidebar">
        <div class="sidebar-top">
            <h3 class="editable-text editable-section" data-section="52" data-text="35">Your Assemblage</h3>
            <button class="close-sidebar-btn" onclick="closeAllDrawers()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="collector-items-target" class="sidebar-scroll-zone"></div>
        <div class="sidebar-footer">
            <div class="total-ledger-row">
                <span class="editable-text editable-section" data-section="53" data-text="36">Value Ledger Total</span>
                <span id="ledger-total-display">$0.00</span>
            </div>
            <button class="art-submit-btn" style="width: 100%; text-align: center;" onclick="concludeAcquisitionSequence()" class="editable-text editable-section" data-section="54" data-text="37">Acquire Matrix Collection</button>
        </div>
    </div>

    <!-- Desires Curated Sidebar -->
    <div id="desires-drawer" class="art-sidebar">
        <div class="sidebar-top">
            <h3 class="editable-text editable-section" data-section="55" data-text="38">Curated Desires</h3>
            <button class="close-sidebar-btn" onclick="closeAllDrawers()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div id="desires-items-target" class="sidebar-scroll-zone"></div>
    </div>

    <!-- ================= DETAIL MODAL OVERLAY ================= -->
    <div id="detail-focus-modal" class="modal-overlay" onclick="handleOutsideModalClick(event)">
        <div class="art-modal-container">
            <button class="modal-dismiss" onclick="closeFocusModal()"><i class="fa-solid fa-xmark"></i></button>
            
            <div class="modal-gallery-pane">
                <img id="modal-image-node" src="" alt="">
            </div>

            <div class="modal-curator-pane">
                <div>
                    <h3 id="modal-title-node" class="modal-product-title">Artifact</h3>
                    <p id="modal-price-node" class="modal-product-price">$0.00</p>
                    
                    <span class="config-label editable-text editable-section" data-section="56" data-text="39">Vessel Volume Scale</span>
                    <div id="modal-volumes-target" class="modal-variant-row"></div>

                    <span class="config-label editable-text editable-section" data-section="57" data-text="40">Elemental Note Architecture</span>
                    <ul id="modal-notes-target" class="composition-breakdown"></ul>
                </div>

                <div>
                    <button id="modal-primary-action-btn" class="art-submit-btn editable-text editable-section" data-section="58" data-text="41" style="width: 100%; margin-bottom: 25px;">Acquire Immediate Ownership</button>
                    
                    <div class="notebook-reviews-container">
                        <span class="config-label editable-text editable-section" data-section="59" data-text="42">Patron Logs & Assays</span>
                        <div id="modal-notebook-scroll-node" class="notebook-scroll"></div>

                        <form id="modal-notebook-subform" class="notebook-form-box" onsubmit="appendNotebookLog(event)">
                            <input type="text" id="log-author" class="editable-text editable-section" data-section="60" data-text="43" placeholder="Patron Initials" required>
                            <textarea id="log-text" class="editable-text editable-section" data-section="61" data-text="44" rows="2" placeholder="Record physical sensory assay response..." required></textarea>
                            <button type="submit" class="art-capsule-btn editable-text editable-section" data-section="62" data-text="45" style="font-size: 11px; padding: 6px 14px;">Seal Log Entry</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= FOOTER ================= -->
    <footer class="art-footer editable-section" data-section="63">
        <div class="footer-universe-grid">
            <div class="footer-quote editable-section no-drop-zone" data-section="64">
                <h3 style="font-family: var(--font-artistic); letter-spacing: 3px;" class="editable-text editable-section" data-section="65" data-text="46">ÆTHERIA</h3>
                <p style="color: #6c7270; font-size: 13.5px; line-height: 1.7; max-width: 320px;" class="editable-text editable-section" data-section="66" data-text="47">An unconventional landscape mapping brand built for minds that prioritize invisible aesthetics.</p>
                <div class="art-socials-row">
                    <a href="#" class="editable-icon" data-icon="102"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="editable-icon" data-icon="103"><i class="fa-brands fa-vimeo-v"></i></a>
                    <a href="#" class="editable-icon" data-icon="104"><i class="fa-brands fa-soundcloud"></i></a>
                </div>
            </div>
            <div class="editable-section no-drop-zone" data-section="67">
                <h4 class="footer-heading editable-text editable-section" data-section="68" data-text="48">Navigational Paths</h4>
                <ul class="footer-nav-list">
                    <li><a href="#canvas" class="editable-text editable-section" data-section="69" data-text="49">Top Canvas Layer</a></li>
                    <li><a href="#exhibition" class="editable-text editable-section" data-section="70" data-text="50">Active Gallery Exhibits</a></li>
                    <li><a href="#manifesto" class="editable-text editable-section" data-section="71" data-text="51">The Philosophy Creed</a></li>
                </ul>
            </div>
            <div class="editable-section no-drop-zone" data-section="72">
                <h4 class="footer-heading editable-text editable-section" data-section="73" data-text="52">Legal Memorandums</h4>
                <ul class="footer-nav-list">
                    <li><a href="#" class="editable-text editable-section" data-section="74" data-text="53" onclick="alert('Accessing Charter...')">Botanical Origin Charter</a></li>
                    <li><a href="#" class="editable-text editable-section" data-section="75" data-text="54" onclick="alert('Accessing Protocols...')">Client Isolation Protocols</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom-curator">
            <span class="editable-text editable-section" data-section="76" data-text="55">&copy; 2026 ÆTHERIA Atelier House. Constructed as organic layout architecture.</span>
            <span class="editable-text editable-section" data-section="77" data-text="56">Coordinates: 48.8566° N, 2.3522° E</span>
        </div>
    </footer>

    <script>
        const ART_CATALOGUE = [
            {
                id: 101,
                title: "Clay & Saffron",
                price: 290,
                desc: "An earthy, sun-baked opening of warm Iranian saffron, wet terra-cotta powder, and raw golden resins.",
                volumes: ["50mL Vessel", "100mL Monolith"],
                imgUrl: "https://images.pexels.com/photos/8148577/pexels-photo-8148577.jpeg?auto=compress&cs=tinysrgb&w=800",
                notes: [
                    { name: "Top Architecture", intensity: "Sun-Baked Saffron" },
                    { name: "Core Solid Mass", intensity: "Crushed Ochre & Clay" },
                    { name: "Residual Trail", intensity: "Dry Amber & Linen" }
                ],
                logs: [{ author: "L. K.", text: "It smells genuinely like warm dust and fine old book binding after an afternoon in an artist's studio." }]
            },
            {
                id: 102,
                title: "Alabaster Iris",
                price: 315,
                desc: "A fragile, translucent cloud composed of pulverized white marble dust, cool iris root, and warm almond milk.",
                volumes: ["30mL Vial", "90mL Glass Sculpture"],
                imgUrl: "https://images.pexels.com/photos/9657315/pexels-photo-9657315.jpeg?auto=compress&cs=tinysrgb&w=800",
                notes: [
                    { name: "Top Architecture", intensity: "Chalk & Cold Aldehydes" },
                    { name: "Core Solid Mass", intensity: "Iris Florentina Concrete" },
                    { name: "Residual Trail", intensity: "Sandalwood Cream" }
                ],
                logs: [{ author: "M. R.", text: "Quiet, perfectly mineral, and incredibly unique. It catches people entirely off guard." }]
            },
            {
                id: 103,
                title: "Moss Continuum",
                price: 340,
                desc: "A damp green landscape tracing fresh wild moss fields trapped inside sealed ancient limestone brick walls.",
                volumes: ["100mL Monolith"],
                imgUrl: "https://images.pexels.com/photos/6721421/pexels-photo-6721421.jpeg?auto=compress&cs=tinysrgb&w=800",
                notes: [
                    { name: "Top Architecture", intensity: "Crushed Ivy Leaf" },
                    { name: "Core Solid Mass", intensity: "Wet Limestone Slab" },
                    { name: "Residual Trail", intensity: "French Oakmoss Resin" }
                ],
                logs: [{ author: "T. S.", text: "A breathtakingly realistic crisp green imprint completely free of mainstream sweetness." }]
            }
        ];

        let ENGINE_STATE = { basket: [], desires: [], activeModalId: null, activeVolumeSelected: "" };

        function renderExhibitionDeck() {
            const targetNode = document.getElementById("exhibition-deck-target");
            targetNode.innerHTML = ART_CATALOGUE.map(art => `
                <div class="art-card">
                    <div class="art-card-viewport" onclick="triggerOpenModal(${art.id})">
                        <img src="${art.imgUrl}" alt="${art.title}">
                        <div class="art-card-overlay">
                            <button class="circular-action-btn" onclick="event.stopPropagation(); immediateBasketPush(${art.id})"><i class="fa-solid fa-plus"></i></button>
                            <button class="circular-action-btn" onclick="event.stopPropagation(); alternateDesiresToggle(${art.id})" id="desire-icon-card-${art.id}"><i class="fa-regular fa-star"></i></button>
                        </div>
                    </div>
                    <div class="art-card-details">
                        <div class="art-card-header-row">
                            <a href="#exhibition" class="art-card-title" onclick="triggerOpenModal(${art.id})">${art.title}</a>
                            <span class="art-card-price">$${art.price}</span>
                        </div>
                        <p class="art-card-desc">${art.desc}</p>
                    </div>
                </div>
            `).join('');
        }

        function openSidebar(id) {
            document.getElementById("slider-backdrop-layer").style.display = "block";
            document.getElementById(id).classList.add("active");
            document.body.style.overflow = "hidden";
        }

        function closeAllDrawers() {
            document.getElementById("slider-backdrop-layer").style.display = "none";
            document.getElementById("collector-drawer").classList.remove("active");
            document.getElementById("desires-drawer").classList.remove("active");
            document.body.style.overflow = "auto";
        }

        function immediateBasketPush(id) {
            const item = ART_CATALOGUE.find(p => p.id === id);
            const compositeHash = `${item.id}-${item.volumes[0]}`;
            const matchedDuplicate = ENGINE_STATE.basket.find(b => b.compositeHash === compositeHash);

            if(matchedDuplicate) { matchedDuplicate.qty++; } 
            else {
                ENGINE_STATE.basket.push({
                    compositeHash, id: item.id, title: item.title, price: item.price, volume: item.volumes[0], img: item.imgUrl, qty: 1
                });
            }
            synchronizeBasketInterface();
            openSidebar("collector-drawer");
        }

        function removeBasketItem(compositeHash) {
            ENGINE_STATE.basket = ENGINE_STATE.basket.filter(b => b.compositeHash !== compositeHash);
            synchronizeBasketInterface();
        }

        function alternateDesiresToggle(id) {
            const item = ART_CATALOGUE.find(p => p.id === id);
            const lookUpIdx = ENGINE_STATE.desires.findIndex(d => d.id === id);
            const cardBtn = document.getElementById(`desire-icon-card-${id}`);

            if(lookUpIdx > -1) {
                ENGINE_STATE.desires.splice(lookUpIdx, 1);
                if(cardBtn) cardBtn.innerHTML = `<i class="fa-regular fa-star"></i>`;
            } else {
                ENGINE_STATE.desires.push(item);
                if(cardBtn) cardBtn.innerHTML = `<i class="fa-solid fa-star" style="color: var(--terracotta);"></i>`;
            }
            synchronizeDesiresInterface();
        }

        function synchronizeBasketInterface() {
            const wrapper = document.getElementById("collector-items-target");
            const dotIndicator = document.getElementById("collector-dot");
            const subtotalLabel = document.getElementById("ledger-total-display");
            
            let financialLedger = 0;

            if(ENGINE_STATE.basket.length === 0) {
                wrapper.innerHTML = `<p style="text-align:center; font-family:var(--font-gallery); font-size:11px; color:#8a908e; padding:50px 0;">Collector portfolio is currently vacant.</p>`;
                dotIndicator.style.display = "none";
            } else {
                wrapper.innerHTML = ENGINE_STATE.basket.map(b => {
                    financialLedger += (b.price * b.qty);
                    return `
                        <div class="basket-item">
                            <img src="${b.img}" class="basket-item-img" alt="">
                            <div class="basket-item-info">
                                <h4>${b.title}</h4>
                                <div class="basket-item-meta">${b.volume} (x${b.qty})</div>
                                <div class="basket-item-price">$${b.price * b.qty}</div>
                            </div>
                            <button class="remove-basket-btn" onclick="removeBasketItem('${b.compositeHash}')"><i class="fa-solid fa-trash-can"></i></button>
                        </div>
                    `;
                }).join('');
                dotIndicator.style.display = "block";
            }
            subtotalLabel.textContent = `$${financialLedger.toFixed(2)}`;
        }

        function synchronizeDesiresInterface() {
            const wrapper = document.getElementById("desires-items-target");
            const dotIndicator = document.getElementById("desires-dot");

            if(ENGINE_STATE.desires.length === 0) {
                wrapper.innerHTML = `<p style="text-align:center; font-family:var(--font-gallery); font-size:11px; color:#8a908e; padding:50px 0;">No exhibition layouts yet saved.</p>`;
                dotIndicator.style.display = "none";
            } else {
                wrapper.innerHTML = ENGINE_STATE.desires.map(d => `
                    <div class="basket-item" style="justify-content: space-between;">
                        <div style="display:flex; gap:15px; align-items:center;">
                            <img src="${d.imgUrl}" class="basket-item-img" alt="">
                            <div>
                                <h4 style="font-size:20px;">${d.title}</h4>
                                <div class="basket-item-price">$${d.price}</div>
                            </div>
                        </div>
                        <button class="art-capsule-btn" style="padding:6px 12px; font-size:10px;" onclick="immediateBasketPush(${d.id}); alternateDesiresToggle(${d.id});">Capture</button>
                    </div>
                `).join('');
                dotIndicator.style.display = "block";
            }
        }

        function triggerOpenModal(id) {
            const art = ART_CATALOGUE.find(p => p.id === id);
            ENGINE_STATE.activeModalId = id;
            ENGINE_STATE.activeVolumeSelected = art.volumes[0];

            document.getElementById("modal-title-node").textContent = art.title;
            document.getElementById("modal-price-node").textContent = `$${art.price}`;
            document.getElementById("modal-image-node").src = art.imgUrl;

            const volumeContainer = document.getElementById("modal-volumes-target");
            volumeContainer.innerHTML = art.volumes.map(v => `
                <button id="vol-capsule-${v}" class="art-capsule-btn" onclick="updateModalActiveVolume('${v}')">${v}</button>
            `).join('');

            const noteContainer = document.getElementById("modal-notes-target");
            noteContainer.innerHTML = art.notes.map(n => `
                <li><span>${n.name}</span><span>${n.intensity}</span></li>
            `).join('');

            syncModalStateVisualClasses();
            renderModalNotebookEntries();

            document.getElementById("detail-focus-modal").style.display = "flex";
            document.body.style.overflow = "hidden";
        }

        function closeFocusModal() {
            document.getElementById("detail-focus-modal").style.display = "none";
            document.body.style.overflow = "auto";
            ENGINE_STATE.activeModalId = null;
        }

        function handleOutsideModalClick(e) {
            if(e.target.id === "detail-focus-modal") closeFocusModal();
        }

        function updateModalActiveVolume(v) {
            ENGINE_STATE.activeVolumeSelected = v;
            syncModalStateVisualClasses();
        }

        function syncModalStateVisualClasses() {
            const art = ART_CATALOGUE.find(p => p.id === ENGINE_STATE.activeModalId);
            art.volumes.forEach(v => {
                const node = document.getElementById(`vol-capsule-${v}`);
                if(v === ENGINE_STATE.activeVolumeSelected) node.classList.add("active");
                else node.classList.remove("active");
            });

            document.getElementById("modal-primary-action-btn").onclick = function() {
                const compositeHash = `${art.id}-${ENGINE_STATE.activeVolumeSelected}`;
                const matchedDuplicate = ENGINE_STATE.basket.find(b => b.compositeHash === compositeHash);

                if(matchedDuplicate) { matchedDuplicate.qty++; } 
                else {
                    ENGINE_STATE.basket.push({
                        compositeHash, id: art.id, title: art.title, price: art.price, volume: ENGINE_STATE.activeVolumeSelected, img: art.imgUrl, qty: 1
                    });
                }
                synchronizeBasketInterface();
                closeFocusModal();
                openSidebar("collector-drawer");
            };
        }

        function renderModalNotebookEntries() {
            const art = ART_CATALOGUE.find(p => p.id === ENGINE_STATE.activeModalId);
            const container = document.getElementById("modal-notebook-scroll-node");
            container.innerHTML = art.logs.map(l => `
                <div class="notebook-entry">
                    <div class="entry-meta"><span>Recorder: ${l.author}</span></div>
                    <p class="entry-text">"${l.text}"</p>
                </div>
            `).join('');
        }

        function appendNotebookLog(e) {
            e.preventDefault();
            const art = ART_CATALOGUE.find(p => p.id === ENGINE_STATE.activeModalId);
            const author = document.getElementById("log-author").value.trim();
            const text = document.getElementById("log-text").value.trim();

            art.logs.unshift({ author, text });
            renderModalNotebookEntries();
            document.getElementById("modal-notebook-subform").reset();
        }

        function toggleArtAccordion(btn) {
            const body = btn.nextElementSibling;
            const indicator = btn.querySelector(".faq-icon-indicator");
            if(body.style.maxHeight && body.style.maxHeight !== "0px") {
                body.style.maxHeight = "0px";
                indicator.className = "faq-icon-indicator fa-solid fa-plus";
            } else {
                body.style.maxHeight = body.scrollHeight + "px";
                indicator.className = "faq-icon-indicator fa-solid fa-minus";
            }
        }

        function transmitTelemetryDocument(e) {
            e.preventDefault();
            alert("Telemetry Document Transmission successful.");
            document.getElementById("artTelemetryForm").reset();
        }

        function concludeAcquisitionSequence() {
            alert("Acquisition sequence verified.");
            ENGINE_STATE.basket = [];
            synchronizeBasketInterface();
            closeAllDrawers();
        }

        window.addEventListener("DOMContentLoaded", () => {
            renderExhibitionDeck();
            synchronizeBasketInterface();
            synchronizeDesiresInterface();
        });
    </script>
</body>
</html>