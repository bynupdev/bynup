<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KINETIK Lab // Technical Footwear Architecture</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

    <style>
        /* --- CORE DESIGN VARIABLES (SOFT ECO-LUXURY PALETTE) --- */
        :root {
            --text: #E05A47;
            --background: #F9EBE8;
            --heading: #1A1A1E;
            --accent: #26262B;
            --primary: #FBF9F6;
            --secondary: #FFFFFF;
            --success: #7E7E86;
            --border: rgba(26, 26, 30, 0.08);
            --font-display: 'Syne', sans-serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: var(--font-body);
            scroll-behavior: smooth;
        }

        header,main,footer {
            background-color: var(--primary);
            color: var(--heading);
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            cursor: pointer;
            border: none;
            background: none;
            transition: var(--transition);
        }

        input, textarea {
            outline: none;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .section-padding {
            padding: clamp(60px, 10vw, 120px) 0;
        }

        .section-title {
            font-family: var(--font-display);
            font-size: clamp(26px, 3.8vw, 44px);
            font-weight: 800;
            text-transform: uppercase;
            line-height: 1.1;
            margin-bottom: clamp(30px, 5vw, 60px);
            letter-spacing: -0.5px;
        }

        .section-title span {
            color: var(--text);
        }

        header {
            background: rgba(251, 249, 246, 0.85);
            backdrop-filter: blur(20px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--border);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
        }

        .logo {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: clamp(18px, 2.2vw, 24px);
            letter-spacing: -0.5px;
        }

        .logo span {
            color: var(--text);
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: clamp(20px, 3vw, 45px);
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
        }

        .nav-links li a {
            position: relative;
            padding: 6px 0;
            color: var(--success);
            transition: var(--transition);
        }

        .nav-links li a:hover {
            color: var(--heading);
        }

        .nav-links li a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: var(--text);
            transition: var(--transition);
        }

        .nav-links li a:hover::after {
            width: 100%;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .action-btn {
            font-size: 18px;
            position: relative;
            color: var(--heading);
        }

        .action-btn:hover {
            color: var(--text);
        }

        .badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background: var(--text);
            color: #FFFFFF;
            font-size: 10px;
            font-weight: 700;
            width: 17px;
            height: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .panel-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(26, 26, 30, 0.3);
            backdrop-filter: blur(8px);
            z-index: 300;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
        }

        .panel-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .side-panel {
            position: fixed;
            top: 0;
            right: -520px;
            width: 100%;
            max-width: 480px;
            height: 100%;
            background: var(--secondary);
            border-left: 1px solid var(--border);
            z-index: 301;
            box-shadow: -20px 0 50px rgba(0,0,0,0.03);
            display: flex;
            flex-direction: column;
            transition: var(--transition);
        }

        .side-panel.active {
            right: 0;
        }

        .panel-header {
            padding: 30px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-header h3 {
            font-family: var(--font-display);
            font-size: 18px;
            text-transform: uppercase;
        }

        .close-panel {
            font-size: 22px;
            color: var(--success);
        }

        .close-panel:hover {
            color: var(--text);
        }

        .panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .panel-empty {
            text-align: center;
            color: var(--success);
            margin-top: 60px;
            font-size: 14px;
        }

        .panel-item {
            display: flex;
            gap: 16px;
            align-items: center;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .panel-item-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            background: var(--primary);
            border-radius: 6px;
            border: 1px solid var(--border);
        }

        .panel-item-info {
            flex: 1;
        }

        .panel-item-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--heading);
            margin-bottom: 4px;
        }

        .panel-item-variant {
            font-size: 12px;
            color: var(--success);
            margin-bottom: 6px;
        }

        .panel-item-price {
            font-weight: 700;
            color: var(--text);
        }

        .panel-item-remove {
            color: var(--success);
            font-size: 16px;
        }

        .panel-item-remove:hover {
            color: var(--text);
        }

        .panel-footer {
            padding: 24px;
            border-top: 1px solid var(--border);
            background: var(--primary);
        }

        .promo-block {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }

        .promo-input {
            flex: 1;
            padding: 14px;
            background: var(--secondary);
            border: 1px solid var(--border);
            color: var(--heading);
            border-radius: 4px;
            font-size: 13px;
        }

        .promo-input:focus {
            border-color: var(--text);
        }

        .promo-btn {
            background: var(--heading);
            color: #FFFFFF;
            padding: 0 20px;
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
            border-radius: 4px;
        }

        .promo-btn:hover {
            background: var(--text);
        }

        .promo-feedback {
            font-size: 12px;
            margin-top: -10px;
            margin-bottom: 14px;
            display: none;
        }
        .promo-feedback.valid { color: #2E7D32; display: block; }
        .promo-feedback.invalid { color: var(--text); display: block; }

        .bill-row {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            color: var(--success);
            margin-bottom: 10px;
        }

        .bill-row.grand-total {
            font-family: var(--font-display);
            font-size: 18px;
            color: var(--heading);
            font-weight: 800;
            text-transform: uppercase;
            border-top: 1px dashed var(--border);
            padding-top: 16px;
            margin-top: 16px;
        }

        .checkout-btn {
            width: 100%;
            background: var(--text);
            color: #FFFFFF;
            padding: 16px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 1px;
            border-radius: 4px;
            margin-top: 10px;
        }

        .checkout-btn:hover {
            background: var(--heading);
            transform: translateY(-2px);
        }

        .sticky-cart-bar {
            position: fixed;
            bottom: -100px;
            left: 0;
            width: 100%;
            background: var(--secondary);
            border-top: 1px solid var(--border);
            box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.04);
            padding: 16px 24px;
            z-index: 90;
            transition: var(--transition);
        }

        .sticky-cart-bar.active {
            bottom: 0;
        }

        .sticky-cart-layout {
            max-width: 1400px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .sticky-cart-summary {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .sticky-cart-icon-box {
            position: relative;
            font-size: 20px;
            color: var(--heading);
            background: var(--primary);
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .sticky-cart-meta {
            font-size: 14px;
        }

        .sticky-cart-count {
            font-weight: 700;
            color: var(--heading);
        }

        .sticky-cart-total {
            font-weight: 800;
            color: var(--text);
            font-size: 16px;
        }

        .sticky-cart-actions {
            display: flex;
            gap: 12px;
        }

        .sticky-view-bag-btn {
            border: 1px solid var(--heading);
            color: var(--heading);
            padding: 14px 24px;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            border-radius: 4px;
        }

        .sticky-view-bag-btn:hover {
            background: var(--primary);
        }

        .sticky-checkout-btn {
            background: var(--text);
            color: #FFFFFF;
            padding: 14px 32px;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            border-radius: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .sticky-checkout-btn:hover {
            background: var(--heading);
        }

        .hero {
            padding: clamp(20px, 4vw, 50px) 0 clamp(40px, 8vw, 100px) 0;
            position: relative;
        }

        .hero-layout {
            display: grid;
            grid-template-columns: 1fr 1.1fr;
            align-items: center;
            gap: clamp(30px, 6vw, 80px);
        }

        .hero-text-box {
            min-width: 0;
            position: relative;
            z-index: 2;
        }

        .hero-tag {
            background: var(--background);
            color: var(--text);
            display: inline-block;
            padding: 6px 16px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: clamp(16px, 3vw, 24px);
            letter-spacing: 1px;
            border-radius: 50px;
        }

        .hero-heading {
            font-family: var(--font-display);
            font-size: clamp(32px, 5.5vw, 64px);
            line-height: 1.05;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: -0.5px;
            margin-bottom: clamp(16px, 3vw, 30px);
        }

        .hero-heading span {
            color: var(--text);
            display: block;
        }

        .hero-description {
            color: var(--success);
            font-size: clamp(15px, 1.8vw, 17px);
            line-height: 1.6;
            max-width: 520px;
            margin-bottom: clamp(24px, 4vw, 40px);
        }

        .hero-cta {
            background: var(--heading);
            color: #FFFFFF;
            padding: 18px 40px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            border-radius: 4px;
            display: inline-block;
        }

        .hero-cta:hover {
            background: var(--text);
            transform: translateY(-3px);
        }

        .hero-showcase {
            position: relative;
            width: 100%;
        }

        .hero-showcase-img {
            width: 100%;
            height: clamp(350px, 55vh, 600px);
            object-fit: cover;
            border-radius: 12px;
            position: relative;
            z-index: 2;
            border: 1px solid var(--border);
        }

        .shop-section {
            background: var(--secondary);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .grid-layout {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 32px;
        }

        .item-card {
            position: relative;
            background: var(--primary);
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 16px;
            transition: var(--transition);
        }

        .item-card:hover {
            border-color: var(--border);
            background: var(--secondary);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        }

        .item-display {
            height: clamp(260px, 35vh, 320px);
            background: var(--secondary);
            border-radius: 6px;
            overflow: hidden;
            position: relative;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border);
        }

        .item-img {
            width: 85%;
            height: auto;
            object-fit: contain;
            transition: var(--transition);
        }

        .item-card:hover .item-img {
            transform: scale(1.06) rotate(-2deg);
        }

        .item-overlay-actions {
            position: absolute;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%) translateY(15px);
            display: flex;
            gap: 12px;
            opacity: 0;
            transition: var(--transition);
            z-index: 10;
        }

        .item-card:hover .item-overlay-actions {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .action-circle {
            background: var(--secondary);
            border: 1px solid var(--border);
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            color: var(--heading);
            font-size: 15px;
        }

        .action-circle:hover {
            background: var(--text);
            color: #FFFFFF;
            border-color: var(--text);
            transform: scale(1.1);
        }

        .item-meta {
            padding-top: 16px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
        }

        .item-title {
            font-size: 15px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            cursor: pointer;
            margin-bottom: 4px;
        }

        .item-title:hover {
            color: var(--text);
        }

        .item-tagline {
            font-size: 12px;
            color: var(--success);
        }

        .item-price {
            font-size: 15px;
            font-weight: 700;
            color: var(--heading);
        }

        .about-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: clamp(40px, 6vw, 80px);
            align-items: center;
        }

        .about-photo {
            width: 100%;
            height: clamp(350px, 45vh, 550px);
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .about-text h3 {
            font-family: var(--font-display);
            font-size: 20px;
            text-transform: uppercase;
            margin-bottom: 16px;
            color: var(--heading);
        }

        .about-text p {
            color: var(--success);
            font-size: 15px;
            line-height: 1.7;
            margin-bottom: 20px;
        }

        .faq-section {
            background: var(--secondary);
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .faq-wrapper {
            max-width: 900px;
            margin: 0 auto;
        }

        .faq-row {
            border-bottom: 1px solid var(--border);
        }

        .faq-trigger {
            width: 100%;
            padding: 26px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            text-align: left;
            font-size: 15px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--heading);
            gap: 15px;
        }

        .faq-trigger:hover {
            color: var(--text);
        }

        .faq-icon-state {
            font-size: 12px;
            transition: var(--transition);
            color: var(--success);
            flex-shrink: 0;
        }

        .faq-content {
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
            color: var(--success);
            font-size: 14px;
            line-height: 1.7;
        }

        .faq-content-inner {
            padding-bottom: 26px;
        }

        .faq-row.active .faq-content {
            max-height: 300px;
        }

        .faq-row.active .faq-icon-state {
            transform: rotate(180deg);
            color: var(--text);
        }

        .contact-layout {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: clamp(30px, 5vw, 50px);
        }

        .contact-card {
            background: var(--secondary);
            border: 1px solid var(--border);
            padding: clamp(30px, 5vw, 50px);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 32px;
        }

        .contact-card-header {
            font-family: var(--font-display);
            font-size: 16px;
            text-transform: uppercase;
            border-bottom: 2px solid var(--text);
            padding-bottom: 14px;
        }

        .contact-node i {
            color: var(--text);
            font-size: 18px;
            margin-bottom: 12px;
        }

        .contact-node h4 {
            font-size: 13px;
            text-transform: uppercase;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .contact-node p {
            color: var(--success);
            font-size: 14px;
            line-height: 1.5;
        }

        .contact-form-wrapper {
            background: var(--secondary);
            border: 1px solid var(--border);
            padding: clamp(30px, 5vw, 50px);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .input-row {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .input-row label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--success);
        }

        .field-input {
            padding: 16px;
            border: 1px solid var(--border);
            border-radius: 4px;
            font-size: 14px;
            background: var(--primary);
            color: var(--heading);
            transition: var(--transition);
        }

        .field-input:focus {
            border-color: var(--heading);
            background: var(--secondary);
        }

        .form-send {
            background: var(--heading);
            color: #FFFFFF;
            padding: 16px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            border-radius: 4px;
            margin-top: 10px;
        }

        .form-send:hover {
            background: var(--text);
        }

        .modal-mask {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(26, 26, 30, 0.2);
            backdrop-filter: blur(12px);
            z-index: 200;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
            padding: 16px;
        }

        .modal-mask.active {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-wrapper {
            background: var(--secondary);
            border: 1px solid var(--border);
            width: 100%;
            max-width: 1100px;
            max-height: 90vh;
            border-radius: 16px;
            overflow-y: auto;
            position: relative;
            padding: clamp(24px, 5vw, 48px);
            transform: scale(0.95);
            transition: var(--transition);
            box-shadow: 0 20px 60px rgba(0,0,0,0.05);
        }

        .modal-mask.active .modal-wrapper {
            transform: scale(1);
        }

        .modal-dismiss {
            position: absolute;
            top: 24px;
            right: 24px;
            font-size: 24px;
            z-index: 5;
            color: var(--success);
        }

        .modal-dismiss:hover {
            color: var(--text);
        }

        .modal-split {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: clamp(30px, 5vw, 60px);
        }

        .modal-viewport {
            background: var(--primary);
            border-radius: 12px;
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            height: clamp(300px, 45vh, 520px);
        }

        .modal-viewport img {
            width: 90%;
            height: auto;
            object-fit: contain;
            transform: rotate(-2deg);
        }

        .modal-meta-box h2 {
            font-family: var(--font-display);
            font-size: clamp(22px, 3.2vw, 30px);
            text-transform: uppercase;
            margin-bottom: 10px;
            line-height: 1.1;
        }

        .modal-price-tag {
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 20px;
        }

        .modal-summary {
            color: var(--success);
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 24px;
        }

        .spec-grid {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 24px;
            font-size: 13px;
        }

        .spec-grid td {
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }

        .spec-grid td:first-child {
            font-weight: 700;
            color: var(--success);
            width: 38%;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .selector-header {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 12px;
            color: var(--success);
            letter-spacing: 0.5px;
        }

        .swatch-row {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
        }

        .swatch-node {
            width: 65px;
            height: 55px;
            background: var(--primary);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .swatch-node.active {
            border-color: var(--text);
            background: var(--secondary);
        }

        .swatch-node img {
            width: 100%;
            height: auto;
            object-fit: contain;
        }

        .size-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 24px;
        }

        .size-node {
            border: 1px solid var(--border);
            background: var(--primary);
            color: var(--heading);
            padding: 12px 18px;
            font-size: 13px;
            font-weight: 700;
            border-radius: 4px;
        }

        .size-node.active, .size-node:hover {
            background: var(--heading);
            color: #FFFFFF;
            border-color: var(--heading);
        }

        .qty-controls {
            display: inline-flex;
            border: 1px solid var(--border);
            border-radius: 4px;
            overflow: hidden;
            align-items: center;
            margin-bottom: 28px;
            background: var(--primary);
        }

        .qty-action {
            padding: 12px 18px;
            background: transparent;
            color: var(--heading);
            font-weight: 700;
        }
        .qty-action:hover {
            color: var(--text);
        }

        .qty-view {
            width: 45px;
            text-align: center;
            border: none;
            font-weight: 700;
            color: var(--heading);
            background: transparent;
        }

        .modal-footer-btns {
            display: grid;
            grid-template-columns: 1fr 1fr 56px;
            gap: 12px;
        }

        .btn-cart-add {
            background: transparent;
            border: 2px solid var(--heading);
            color: var(--heading);
            padding: 16px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            border-radius: 4px;
        }

        .btn-cart-add:hover {
            background: var(--primary);
        }

        .btn-buy-now {
            background: var(--text);
            color: #FFFFFF;
            padding: 16px;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 0.5px;
            border-radius: 4px;
        }

        .btn-buy-now:hover {
            background: var(--heading);
        }

        .btn-wish-add {
            border: 1px solid var(--border);
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            border-radius: 4px;
            color: var(--heading);
        }

        .btn-wish-add:hover {
            border-color: var(--heading);
            color: var(--text);
        }

        /* ============================================ */
        /* REVIEW FORM MODAL                           */
        /* ============================================ */
        .review-form-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            z-index: 400;
            align-items: center;
            justify-content: center;
        }

        .review-form-modal.active {
            display: flex;
        }

        .review-form-container {
            background: var(--secondary);
            border: 1px solid var(--heading);
            width: 90%;
            max-width: 500px;
            padding: 30px;
            border-radius: 16px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .review-form-container h3 {
            font-family: var(--font-display);
            font-size: 24px;
            margin-bottom: 20px;
        }

        .review-form-group {
            margin-bottom: 16px;
        }

        .review-form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 6px;
            color: var(--success);
        }

        .review-form-group input,
        .review-form-group textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--border);
            background: #FFFFFF;
            font-family: var(--font-body);
            border-radius: 50px;
            font-size: 14px;
            outline: none;
        }

        .review-form-group textarea {
            border-radius: 12px;
            resize: none;
        }

        .review-form-group input:focus,
        .review-form-group textarea:focus {
            border-color: var(--text);
        }

        .rating-select {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }

        .rating-star-select {
            font-size: 28px;
            cursor: pointer;
            color: #ddd;
            transition: var(--transition);
        }

        .rating-star-select.active {
            color: #FFD700;
        }

        .rating-star-select:hover {
            transform: scale(1.1);
        }

        .submit-review-modal {
            width: 100%;
            background: var(--text);
            color: #FFFFFF;
            padding: 14px;
            font-weight: 600;
            text-transform: uppercase;
            border: 1px solid var(--text);
            border-radius: 50px;
            margin-top: 16px;
            cursor: pointer;
            transition: var(--transition);
        }

        .submit-review-modal:hover {
            background: var(--heading);
            border-color: var(--heading);
        }

        .submit-review-modal:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* ============================================ */
        /* REVIEW SECTION INSIDE MODAL                 */
        /* ============================================ */
        .review-section {
            margin-top: 32px;
            border-top: 1px solid var(--border);
            padding-top: 24px;
        }

        .review-title {
            font-family: var(--font-display);
            font-size: 16px;
            text-transform: uppercase;
            margin-bottom: 16px;
            letter-spacing: 0.5px;
        }

        .review-stats {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
        }

        .avg-rating {
            font-size: 28px;
            font-weight: 700;
            color: var(--heading);
        }

        .review-stars {
            color: #FFD700;
            font-size: 14px;
        }

        .review-count {
            font-size: 12px;
            color: var(--success);
        }

        .review-list {
            margin-bottom: 20px;
            max-height: 250px;
            overflow-y: auto;
        }

        .review-card-item {
            background: var(--background);
            padding: 14px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
        }

        .review-card-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .reviewer-name {
            font-weight: 700;
            font-size: 12px;
            text-transform: uppercase;
        }

        .review-date {
            font-size: 10px;
            color: var(--success);
        }

        .review-stars-small {
            color: #FFD700;
            font-size: 10px;
            margin-bottom: 6px;
        }

        .review-text {
            font-size: 13px;
            line-height: 1.4;
        }

        .write-review-btn {
            width: 100%;
            background: var(--heading);
            color: #FFFFFF;
            padding: 12px;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 12px;
            border: 1px solid var(--heading);
            border-radius: 50px;
            margin-top: 12px;
            cursor: pointer;
            transition: var(--transition);
        }

        .write-review-btn:hover {
            background: var(--text);
            color: #FFFFFF;
            border-color: var(--text);
        }

        footer {
            background: var(--secondary);
            color: var(--success);
            padding: 50px 0 120px 0;
            text-align: center;
            font-size: 13px;
            border-top: 1px solid var(--border);
            letter-spacing: 0.5px;
        }

        footer p span {
            color: var(--heading);
        }

        @media (max-width: 992px) {
            .hero-layout {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .hero-description {
                margin: 0 auto 30px auto;
            }
            .hero-showcase-img {
                height: clamp(300px, 45vh, 480px);
            }
            .about-layout, .contact-layout, .modal-split {
                grid-template-columns: 1fr;
            }
            .sticky-cart-meta {
                display: none;
            }
        }

        @media (max-width: 768px) {
            .nav-links { 
                display: none; 
            }
            .side-panel { 
                max-width: 100%; 
                right: -100%; 
            }
            .item-overlay-actions {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
            .modal-footer-btns {
                grid-template-columns: 1fr;
            }
            .btn-wish-add {
                padding: 16px;
            }
        }
    </style>
</head>
<body>

    <!-- ============================================ -->
    <!-- HEADER                                       -->
    <!-- ============================================ -->
    <header class="editable-section" data-section="1">
        <div class="container nav-container">
            <div class="logo editable-text editable-section" data-section="2" data-text="1"><a href="#"><span class="editable-text editable-section" data-section="3" data-text="2">KINETIK</span><span class="editable-text editable-section" data-section="4" data-text="3">//</span><span class="editable-text editable-section" data-section="5" data-text="4">LAB</span></a></div>
            <ul class="nav-links">
                <li><a href="#shop" class="editable-text editable-section" data-section="6" data-text="5">Catalog</a></li>
                <li><a href="#about" class="editable-text editable-section" data-section="7" data-text="6">The Lab</a></li>
                <li><a href="#faq" class="editable-text editable-section" data-section="8" data-text="7">Intel</a></li>
                <li><a href="#contact" class="editable-text editable-section" data-section="9" data-text="8">Base Station</a></li>
            </ul>
            <div class="nav-actions">
                <button class="action-btn editable-section no-drop-zone" data-section="10" id="trigger-wishlist" title="Open Wishlist">
                    <i class="fa-regular fa-heart editable-icon" data-icon="101" data-default-class="fa-regular fa-heart"></i>
                    <span class="badge" id="wishlist-indicator">0</span>
                </button>
                <button class="action-btn editable-section no-drop-zone" data-section="11" id="trigger-cart" title="Open Shopping Bag">
                    <i class="fa-solid fa-bag-shopping editable-icon" data-icon="120" data-default-class="fa-solid fa-bag-shopping"></i>
                    <span class="badge" id="cart-indicator">0</span>
                </button>
            </div>
        </div>
    </header>

   <main>
     <!-- ============================================ -->
    <!-- PANELS                                       -->
    <!-- ============================================ -->
    <div class="panel-overlay" id="panel-mask"></div>

    <div class="side-panel" id="wishlist-sidebar">
        <div class="panel-header">
            <h3 class="editable-text editable-section" data-section="12" data-text="9">Saved Hardware</h3>
            <button class="close-panel" onclick="toggleSidebar('wishlist', false)"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="panel-body" id="wishlist-node-target"></div>
    </div>

    <div class="side-panel" id="cart-sidebar">
        <div class="panel-header">
            <h3 class="editable-text editable-section" data-section="13" data-text="10">Manifest Bag</h3>
            <button class="close-panel" onclick="toggleSidebar('cart', false)"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="panel-body" id="cart-node-target"></div>
        <div class="panel-footer">
            <div class="promo-block">
                <input type="text" class="promo-input editable-text editable-section" data-section="14" data-text="11" id="coupon-field" placeholder="System Code: KINETIK20">
                <button class="promo-btn editable-text editable-section" data-section="15" data-text="12" onclick="applyPromo()">Verify</button>
            </div>
            <div id="coupon-alert" class="promo-feedback"></div>
            <div class="bill-row">
                <span class="editable-text editable-section" data-section="16" data-text="13">Subtotal Manifest</span>
                <span id="bill-subtotal">$0.00</span>
            </div>
            <div class="bill-row" id="bill-discount-row" style="display: none; color: var(--text);">
                <span class="editable-text editable-section" data-section="17" data-text="14">System Discount Applied (20%)</span>
                <span id="bill-discount">-$0.00</span>
            </div>
            <div class="bill-row grand-total">
                <span class="editable-text editable-section" data-section="18" data-text="15">Total Payload</span>
                <span id="bill-total">$0.00</span>
            </div>
            <button class="checkout-btn editable-text editable-section" data-section="19" data-text="16" onclick="executeCheckout()">Execute Dispatch Protocol</button>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- STICKY CART BAR                              -->
    <!-- ============================================ -->
    <div class="sticky-cart-bar" id="sticky-cart-tracker">
        <div class="sticky-cart-layout">
            <div class="sticky-cart-summary">
                <div class="sticky-cart-icon-box">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="badge" id="sticky-cart-badge">0</span>
                </div>
                <div class="sticky-cart-meta">
                    <div class="sticky-cart-count"><span id="sticky-items-label">0 Items</span> Selected</div>
                    <div class="sticky-cart-total" id="sticky-total-label">$0.00</div>
                </div>
            </div>
            <div class="sticky-cart-actions">
                <button class="sticky-view-bag-btn editable-text editable-section" data-section="20" data-text="17" onclick="toggleSidebar('cart', true)">View Bag</button>
                <button class="sticky-checkout-btn editable-text editable-section" data-section="21" data-text="18" onclick="executeCheckout()">
                    <span>Secure Checkout</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- HERO SECTION                                 -->
    <!-- ============================================ -->
    <section class="hero editable-section" data-section="22">
        <div class="container hero-layout">
            <div class="hero-text-box editable-section no-drop-zone" data-section="23">
                <span class="hero-tag editable-text editable-section" data-section="24" data-text="19">Drop Matrix 4.26</span>
                <h1 class="hero-heading"><span class="editable-text editable-section" data-section="25" data-text="20">Footwear</span><span class="editable-text editable-section" data-section="26" data-text="21">Engineering</span><span class="editable-text editable-section" data-section="27" data-text="22">Evolved.</span></h1>
                <p class="hero-description editable-text editable-section" data-section="28" data-text="23">Kinetic impact absorption grids combined with hyper-breathable matrix knit weaves. Forged for multi-directional velocity and structural speed performance.</p>
                <a href="#shop" class="hero-cta editable-text editable-section" data-section="29" data-text="24">Explore Hardware</a>
            </div>
            <div class="hero-showcase">
                <img src="https://images.pexels.com/photos/2529148/pexels-photo-2529148.jpeg?auto=compress&cs=tinysrgb&w=1000" alt="Kinetik Propulsion Running Unit Architecture" class="hero-showcase-img editable-image" data-image="1">
            </div>
        </div>
    </section>

    <!-- ============================================ -->
    <!-- PRODUCT COLLECTION - PURE HTML               -->
    <!-- ============================================ -->
    <section class="shop-section section-padding editable-section" id="shop" data-section="30">
        <div class="container">
            <h2 class="section-title"><span class="editable-text editable-section" data-section="31" data-text="25">Active</span> <span class="editable-text editable-section" data-section="32" data-text="26">Hardware Inventory</span></h2>
            <div class="grid-layout" id="shop-items-target">
                
                <!-- Product 1 -->
                <div class="item-card editable-section no-drop-zone" data-section="100">
                    <div class="item-display" onclick="triggerProductModal(501)">
                        <img src="https://images.pexels.com/photos/2529148/pexels-photo-2529148.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Velo-Knit Matrix Alpha" class="item-img editable-image" data-image="3">
                        <div class="item-overlay-actions">
                            <button class="action-circle" onclick="event.stopPropagation(); addToWishlistPipeline(501)" title="Save Hardware"><i class="fa-regular fa-heart"></i></button>
                            <button class="action-circle" onclick="event.stopPropagation(); instantaneousCartAdd(501)" title="Quick Add To Bag"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-meta">
                        <div>
                            <div class="item-title editable-text editable-section" data-section="101" data-text="100" onclick="triggerProductModal(501)">Velo-Knit Matrix Alpha</div>
                            <div class="item-tagline editable-text editable-section" data-section="102" data-text="101">Volt Orange Grid</div>
                        </div>
                        <div class="item-price editable-text editable-section" data-section="103" data-text="102">$160.00</div>
                    </div>
                </div>

                <!-- Product 2 -->
                <div class="item-card editable-section no-drop-zone" data-section="104">
                    <div class="item-display" onclick="triggerProductModal(502)">
                        <img src="https://images.pexels.com/photos/1598505/pexels-photo-1598505.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Apex Carbon Torsion Trainer" class="item-img editable-image" data-image="4">
                        <div class="item-overlay-actions">
                            <button class="action-circle" onclick="event.stopPropagation(); addToWishlistPipeline(502)" title="Save Hardware"><i class="fa-regular fa-heart"></i></button>
                            <button class="action-circle" onclick="event.stopPropagation(); instantaneousCartAdd(502)" title="Quick Add To Bag"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-meta">
                        <div>
                            <div class="item-title editable-text editable-section" data-section="105" data-text="103" onclick="triggerProductModal(502)">Apex Carbon Torsion Trainer</div>
                            <div class="item-tagline editable-text editable-section" data-section="106" data-text="104">Phantom Charcoal Stone</div>
                        </div>
                        <div class="item-price editable-text editable-section" data-section="107" data-text="105">$185.00</div>
                    </div>
                </div>

                <!-- Product 3 -->
                <div class="item-card editable-section no-drop-zone" data-section="108">
                    <div class="item-display" onclick="triggerProductModal(503)">
                        <img src="https://images.pexels.com/photos/1478442/pexels-photo-1478442.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Strata Element Trail Runner" class="item-img editable-image" data-image="5">
                        <div class="item-overlay-actions">
                            <button class="action-circle" onclick="event.stopPropagation(); addToWishlistPipeline(503)" title="Save Hardware"><i class="fa-regular fa-heart"></i></button>
                            <button class="action-circle" onclick="event.stopPropagation(); instantaneousCartAdd(503)" title="Quick Add To Bag"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-meta">
                        <div>
                            <div class="item-title editable-text editable-section" data-section="109" data-text="106" onclick="triggerProductModal(503)">Strata Element Trail Runner</div>
                            <div class="item-tagline editable-text editable-section" data-section="110" data-text="107">Alpine Dusk Earth</div>
                        </div>
                        <div class="item-price editable-text editable-section" data-section="111" data-text="108">$190.00</div>
                    </div>
                </div>

                <!-- Product 4 -->
                <div class="item-card editable-section no-drop-zone" data-section="112">
                    <div class="item-display" onclick="triggerProductModal(504)">
                        <img src="https://images.pexels.com/photos/1456706/pexels-photo-1456706.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Neon Flux Hyper-Light Aero" class="item-img editable-image" data-image="6">
                        <div class="item-overlay-actions">
                            <button class="action-circle" onclick="event.stopPropagation(); addToWishlistPipeline(504)" title="Save Hardware"><i class="fa-regular fa-heart"></i></button>
                            <button class="action-circle" onclick="event.stopPropagation(); instantaneousCartAdd(504)" title="Quick Add To Bag"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="item-meta">
                        <div>
                            <div class="item-title editable-text editable-section" data-section="113" data-text="109" onclick="triggerProductModal(504)">Neon Flux Hyper-Light Aero</div>
                            <div class="item-tagline editable-text editable-section" data-section="114" data-text="110">Chroma Coral Laser</div>
                        </div>
                        <div class="item-price editable-text editable-section" data-section="115" data-text="111">$155.00</div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ============================================ -->
    <!-- ABOUT SECTION                                -->
    <!-- ============================================ -->
    <section class="about-section section-padding editable-section" id="about" data-section="33">
        <div class="container about-layout">
            <img src="https://images.pexels.com/photos/3643714/pexels-photo-3643714.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Biomechanical structural outsole scanning laboratory" class="about-photo editable-image" data-image="2">
            <div class="about-text editable-section no-drop-zone" data-section="34">
                <h2 class="section-title"><span class="editable-text editable-section" data-section="35" data-text="27">The Kinetik</span> <span class="editable-text editable-section" data-section="36" data-text="28">Lab Paradigm</span></h2>
                <h3 class="editable-text editable-section" data-section="37" data-text="29">Anatomical Support. Responsive Energy.</h3>
                <p class="editable-text editable-section" data-section="38" data-text="30">We approach footwear production through a technical engineering framework. Our team completely strips down traditional shoe structures, removing unnecessary weight to deliver unmatched energy return matrix components.</p>
                <p class="editable-text editable-section" data-section="39" data-text="31">Every single arc line calculation, dual-density responsive compound foam assembly, and carbon-fiber torsion plate configuration is subjected to high-stress laboratory simulations. We build gear designed to excel under real-world performance demands.</p>
            </div>
        </div>
    </section>

    <!-- ============================================ -->
    <!-- FAQ SECTION                                  -->
    <!-- ============================================ -->
    <section class="faq-section section-padding editable-section" id="faq" data-section="40">
        <div class="container">
            <h2 class="section-title"><span class="editable-text editable-section" data-section="41" data-text="32">Technical</span> <span class="editable-text editable-section" data-section="42" data-text="33">Intel Logs</span></h2>
            <div class="faq-wrapper">
                
                <div class="faq-row editable-section no-drop-zone" data-section="43">
                    <button class="faq-trigger" onclick="handleAccordion(this)">
                        <span class="editable-text editable-section" data-section="44" data-text="34">How does the proprietary Quantum-Grid midsole function?</span>
                        <i class="fa-solid fa-chevron-down faq-icon-state"></i>
                    </button>
                    <div class="faq-content">
                        <div class="faq-content-inner editable-text editable-section" data-section="45" data-text="35">
                            Our unique Quantum-Grid setup features structural geometric hollow cells that deform on vertical impact. This smoothly converts kinetic downward pressure directly into forward propulsion force energy.
                        </div>
                    </div>
                </div>

                <div class="faq-row editable-section no-drop-zone" data-section="46">
                    <button class="faq-trigger" onclick="handleAccordion(this)">
                        <span class="editable-text editable-section" data-section="47" data-text="36">What sizing framework does KINETIK utilize?</span>
                        <i class="fa-solid fa-chevron-down faq-icon-state"></i>
                    </button>
                    <div class="faq-content">
                        <div class="faq-content-inner editable-text editable-section" data-section="48" data-text="37">
                            All model variations run true to size according to standard international performance specifications. If you have wider foot profiles, we recommend ordering a half-size larger for optimal structural comfort.
                        </div>
                    </div>
                </div>

                <div class="faq-row editable-section no-drop-zone" data-section="49">
                    <button class="faq-trigger" onclick="handleAccordion(this)">
                        <span class="editable-text editable-section" data-section="50" data-text="38">Are the technical knit components waterproof?</span>
                        <i class="fa-solid fa-chevron-down faq-icon-state"></i>
                    </button>
                    <div class="faq-content">
                        <div class="faq-content-inner editable-text editable-section" data-section="51" data-text="39">
                            The standard line maximizes airflow and ventilation. However, they are treated with a light, hydrophobic water-repellent coating that easily handles sudden weather changes or light rain conditions.
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ============================================ -->
    <!-- CONTACT SECTION                              -->
    <!-- ============================================ -->
    <section class="contact-section section-padding editable-section" id="contact" data-section="52">
        <div class="container contact-layout">
            <div class="contact-card editable-section no-drop-zone" data-section="53">
                <h3 class="contact-card-header editable-text editable-section" data-section="54" data-text="40">Lab Coordinates</h3>
                <div class="contact-node">
                    <i class="fa-solid fa-network-wired"></i>
                    <h4 class="editable-text editable-section" data-section="55" data-text="41">Main Server Facility</h4>
                    <p class="editable-text editable-section" data-section="56" data-text="42">Sector 7-A, Terminal Block 88<br>Silicon Innovation Core, CA</p>
                </div>
                <div class="contact-node">
                    <i class="fa-solid fa-terminal"></i>
                    <h4 class="editable-text editable-section" data-section="57" data-text="43">Uplink Protocol</h4>
                    <p class="editable-text editable-section" data-section="58" data-text="44">protocols@kinetiklab.io</p>
                </div>
            </div>
            <form class="contact-form-wrapper editable-section no-drop-zone" data-section="59" id="contactForm" onsubmit="submitContactForm(event)">
                {% csrf_token %}
                <div class="input-row">
                    <label class="editable-text editable-section" data-section="60" data-text="45">Operator Identity</label>
                    <input type="text" class="field-input editable-text editable-section" data-section="61" data-text="46" id="contact_name" placeholder="e.g. Marcus Vance" required>
                </div>
                <div class="input-row">
                    <label class="editable-text editable-section" data-section="62" data-text="47">Routing Email</label>
                    <input type="email" class="field-input editable-text editable-section" data-section="63" data-text="48" id="contact_email" placeholder="mvance@terminal.com" required>
                </div>
                <div class="input-row">
                    <label class="editable-text editable-section" data-section="64" data-text="49">Transmission Payload Data</label>
                    <textarea class="field-input editable-text editable-section" data-section="65" data-text="50" id="contact_message" rows="5" placeholder="Input requested item data specs, tracking query details..." required></textarea>
                </div>
                <button type="submit" class="form-send editable-text editable-section" data-section="66" data-text="51">Deploy Link Signal</button>
            </form>
        </div>
    </section>

    <!-- ============================================ -->
    <!-- PRODUCT DETAILS MODAL                        -->
    <!-- ============================================ -->
    <div class="modal-mask" id="details-modal">
        <div class="modal-wrapper">
            <button class="modal-dismiss" id="dismiss-modal" title="Terminate Module View"><i class="fa-solid fa-xmark"></i></button>
            <div class="modal-split" id="modal-injector-target"></div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- REVIEW FORM MODAL - EDITABLE                 -->
    <!-- ============================================ -->
    <div class="review-form-modal" id="review-modal">
        <div class="review-form-container">
            <h3 class="editable-text editable-section" data-section="200" data-text="200" style="font-family:var(--font-display); font-size:24px; margin-bottom:20px;">Write a Review</h3>
            <form id="review-submit-form" onsubmit="handleReviewSubmission(event)">
                
                <!-- Name Field -->
                <div class="review-form-group">
                    <label class="editable-text editable-section" data-section="201" data-text="201" style="display:block; font-size:12px; font-weight:600; text-transform:uppercase; margin-bottom:6px; color:var(--success);">Your Name</label>
                    <input type="text" id="rev-author" class="editable-text editable-section" data-section="202" data-text="202" style="width:100%; padding:12px 16px; border:1px solid var(--border); background:#FFFFFF; border-radius:50px; font-size:14px; outline:none;" placeholder="e.g. Marcus Vance" required>
                </div>
                
                <!-- Rating Field -->
                <div class="review-form-group">
                    <label class="editable-text editable-section" data-section="203" data-text="203" style="display:block; font-size:12px; font-weight:600; text-transform:uppercase; margin-bottom:6px; color:var(--success);">Rating</label>
                    <div class="rating-select" id="rating-select" style="display:flex; gap:8px; margin-top:8px;">
                        <span class="rating-star-select editable-text editable-section" data-section="204" data-text="204" data-rating="1" onclick="setRating(1)" style="font-size:28px; cursor:pointer; color:#ddd; transition:var(--transition);">★</span>
                        <span class="rating-star-select editable-text editable-section" data-section="205" data-text="205" data-rating="2" onclick="setRating(2)" style="font-size:28px; cursor:pointer; color:#ddd; transition:var(--transition);">★</span>
                        <span class="rating-star-select editable-text editable-section" data-section="206" data-text="206" data-rating="3" onclick="setRating(3)" style="font-size:28px; cursor:pointer; color:#ddd; transition:var(--transition);">★</span>
                        <span class="rating-star-select editable-text editable-section" data-section="207" data-text="207" data-rating="4" onclick="setRating(4)" style="font-size:28px; cursor:pointer; color:#ddd; transition:var(--transition);">★</span>
                        <span class="rating-star-select editable-text editable-section" data-section="208" data-text="208" data-rating="5" onclick="setRating(5)" style="font-size:28px; cursor:pointer; color:#ddd; transition:var(--transition);">★</span>
                    </div>
                    <input type="hidden" id="review-rating" value="0">
                </div>
                
                <!-- Review Title Field -->
                <div class="review-form-group">
                    <label class="editable-text editable-section" data-section="209" data-text="209" style="display:block; font-size:12px; font-weight:600; text-transform:uppercase; margin-bottom:6px; color:var(--success);">Review Title</label>
                    <input type="text" id="rev-title" class="editable-text editable-section" data-section="210" data-text="210" style="width:100%; padding:12px 16px; border:1px solid var(--border); background:#FFFFFF; border-radius:50px; font-size:14px; outline:none;" placeholder="e.g. Excellent quality!" required>
                </div>
                
                <!-- Review Comment Field -->
                <div class="review-form-group">
                    <label class="editable-text editable-section" data-section="211" data-text="211" style="display:block; font-size:12px; font-weight:600; text-transform:uppercase; margin-bottom:6px; color:var(--success);">Your Review</label>
                    <textarea id="rev-body" class="editable-text editable-section" data-section="212" data-text="212" rows="4" style="width:100%; padding:12px 16px; border:1px solid var(--border); background:#FFFFFF; border-radius:12px; font-size:14px; outline:none; resize:none;" placeholder="Share your experience with this product..." required></textarea>
                </div>
                
                <!-- Submit Button -->
                <button type="submit" class="submit-review-modal editable-text editable-section" data-section="213" data-text="213" style="width:100%; background:var(--text); color:#FFFFFF; padding:14px; font-weight:600; text-transform:uppercase; border:1px solid var(--text); border-radius:50px; margin-top:16px; cursor:pointer; transition:var(--transition);">Submit Review</button>
                
                <!-- Cancel Button -->
                <button type="button" class="submit-review-modal editable-text editable-section" data-section="214" data-text="214" style="width:100%; background:transparent; color:var(--heading); padding:14px; font-weight:600; text-transform:uppercase; border:1px solid var(--border); border-radius:50px; margin-top:8px; cursor:pointer; transition:var(--transition);" onclick="closeReviewModal()">Cancel</button>
                
            </form>
        </div>
    </div>

   </main>
    <!-- ============================================ -->
    <!-- FOOTER                                       -->
    <!-- ============================================ -->
    <footer class="editable-section" data-section="67">
        <div class="container">
            <p class="editable-text editable-section" data-section="68" data-text="52">&copy; 2026 <span>KINETIK LAB OS</span>. Structural performance hardware. All node rights reserved.</p>
        </div>
    </footer>

    <script>
        // ============================================
        // PRODUCT DATA
        // ============================================
        const sneakerInventory = [
            {
                id: 501, name: "Velo-Knit Matrix Alpha", price: 160.00,
                desc: "High-density adaptive knit system equipped with mechanical carbon energy-return plates for optimal long-range running performance.",
                specs: { "Chassis Cushion": "Quantum-Grid Midsole v2", "Upper Thread": "Matrix-Knit Monofilament", "Weight Profile": "210 grams" },
                variants: [
                    { color: "Volt Orange Grid", img: "https://images.pexels.com/photos/2529148/pexels-photo-2529148.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ], sizes: ["8", "9", "10", "11"],
                reviews: [
                    { author: "Marcus V.", rating: 5, title: "Incredible performance", comment: "Best running shoes I've ever worn.", date: "2024-12-10" }
                ]
            },
            {
                id: 502, name: "Apex Carbon Torsion Trainer", price: 185.00,
                desc: "Engineered specifically for sudden multi-directional changes, featuring robust side-locking rubber cages and dual-density stability foams.",
                specs: { "Chassis Cushion": "Dual-Density Pro Foam Core", "Upper Thread": "Ballistic TPU Shield", "Weight Profile": "245 grams" },
                variants: [
                    { color: "Phantom Charcoal Stone", img: "https://images.pexels.com/photos/1598505/pexels-photo-1598505.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ], sizes: ["8.5", "9", "9.5", "10", "10.5", "11"],
                reviews: []
            },
            {
                id: 503, name: "Strata Element Trail Runner", price: 190.00,
                desc: "Equipped with deep, rugged multi-surface outsole lugs and a light, breathable waterproof wrap layer optimized for rough outdoor environments.",
                specs: { "Chassis Cushion": "All-Terrain Cushion Compound", "Upper Thread": "Hydrophobic Ripstop Mesh", "Weight Profile": "270 grams" },
                variants: [
                    { color: "Alpine Dusk Earth", img: "https://images.pexels.com/photos/1478442/pexels-photo-1478442.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ], sizes: ["9", "10", "11"],
                reviews: []
            },
            {
                id: 504, name: "Neon Flux Hyper-Light Aero", price: 155.00,
                desc: "An incredibly lightweight speed shoe tailored for lightning-fast training loops and maximum explosive acceleration bursts.",
                specs: { "Chassis Cushion": "Aero-Cell Cushion Tech", "Upper Thread": "Translucent Mono-Mesh Wrap", "Weight Profile": "185 grams" },
                variants: [
                    { color: "Chroma Coral Laser", img: "https://images.pexels.com/photos/1456706/pexels-photo-1456706.jpeg?auto=compress&cs=tinysrgb&w=600" }
                ], sizes: ["8", "9", "10"],
                reviews: []
            }
        ];

        // ============================================
        // GLOBAL STATE
        // ============================================
        let shoppingBag = [];
        let wishlistBag = [];
        let couponPercentage = 0.0;
        let currentProductId = null;

        const shopItemsTarget = document.getElementById('shop-items-target');
        const detailsModal = document.getElementById('details-modal');
        const modalInjectorTarget = document.getElementById('modal-injector-target');
        const dismissModal = document.getElementById('dismiss-modal');
        const panelMask = document.getElementById('panel-mask');
        const stickyCartTracker = document.getElementById('sticky-cart-tracker');

        // ============================================
        // DRAWER CONTROLS
        // ============================================
        function toggleSidebar(panelType, setOpen) {
            if (setOpen) {
                panelMask.classList.add('active');
                document.getElementById(`${panelType}-sidebar`).classList.add('active');
                document.body.style.overflow = 'hidden';
            } else {
                panelMask.classList.remove('active');
                document.getElementById('cart-sidebar').classList.remove('active');
                document.getElementById('wishlist-sidebar').classList.remove('active');
                document.body.style.overflow = 'auto';
            }
        }

        document.getElementById('trigger-cart').addEventListener('click', () => toggleSidebar('cart', true));
        document.getElementById('trigger-wishlist').addEventListener('click', () => toggleSidebar('wishlist', true));
        panelMask.addEventListener('click', () => toggleSidebar('', false));

        // ============================================
        // CART FUNCTIONS
        // ============================================
        function refreshBagUI() {
            const container = document.getElementById('cart-node-target');
            const totalQtyCount = shoppingBag.reduce((sum, item) => sum + item.qty, 0);
            
            document.getElementById('cart-indicator').innerText = totalQtyCount;

            if (totalQtyCount > 0) {
                document.getElementById('sticky-cart-badge').innerText = totalQtyCount;
                document.getElementById('sticky-items-label').innerText = totalQtyCount === 1 ? "1 Item" : `${totalQtyCount} Items`;
                stickyCartTracker.classList.add('active');
            } else {
                stickyCartTracker.classList.remove('active');
            }

            if (shoppingBag.length === 0) {
                container.innerHTML = `<div class="panel-empty">Your manifest bag is empty.</div>`;
                recalcCartFinancials();
                return;
            }

            container.innerHTML = shoppingBag.map((item, index) => `
                <div class="panel-item">
                    <img src="${item.img}" class="panel-item-img">
                    <div class="panel-item-info">
                        <div class="panel-item-title">${item.title}</div>
                        <div class="panel-item-variant">Size: ${item.size} / Qty: ${item.qty}</div>
                        <div class="panel-item-price">$${(item.basePrice * item.qty).toFixed(2)}</div>
                    </div>
                    <button class="panel-item-remove" onclick="ejectBagItem(${index})"><i class="fa-regular fa-trash-can"></i></button>
                </div>
            `).join('');
            recalcCartFinancials();
        }

        function recalcCartFinancials() {
            let subtotal = shoppingBag.reduce((sum, item) => sum + (item.basePrice * item.qty), 0);
            let deduction = subtotal * couponPercentage;
            let finalTotal = subtotal - deduction;

            document.getElementById('bill-subtotal').innerText = `$${subtotal.toFixed(2)}`;
            if (couponPercentage > 0) {
                document.getElementById('bill-discount-row').style.display = 'flex';
                document.getElementById('bill-discount').innerText = `-$${deduction.toFixed(2)}`;
            } else {
                document.getElementById('bill-discount-row').style.display = 'none';
            }
            
            const totalFormatted = `$${finalTotal.toFixed(2)}`;
            document.getElementById('bill-total').innerText = totalFormatted;
            document.getElementById('sticky-total-label').innerText = totalFormatted;
        }

        function pushToBagDataArray(title, basePrice, img, color, size, qty) {
            const duplicateMatchIndex = shoppingBag.findIndex(i => i.title === title && i.color === color && i.size === size);
            if (duplicateMatchIndex > -1) {
                shoppingBag[duplicateMatchIndex].qty += qty;
            } else {
                shoppingBag.push({ title, basePrice, img, color, size, qty });
            }
            refreshBagUI();
        }

        function instantaneousCartAdd(id) {
            const productRef = sneakerInventory.find(p => p.id === id);
            pushToBagDataArray(productRef.name, productRef.price, productRef.variants[0].img, productRef.variants[0].color, productRef.sizes[0], 1);
            toggleSidebar('cart', true);
        }

        function ejectBagItem(index) {
            shoppingBag.splice(index, 1);
            refreshBagUI();
        }

        function applyPromo() {
            const codeVal = document.getElementById('coupon-field').value.trim();
            const logBox = document.getElementById('coupon-alert');

            if (codeVal === 'KINETIK20') {
                couponPercentage = 0.20;
                logBox.className = "promo-feedback valid";
                logBox.innerText = "System Code Cleared: 20% Adjustment Settled.";
            } else {
                couponPercentage = 0.0;
                logBox.className = "promo-feedback invalid";
                logBox.innerText = "Invalid secure core coupon value.";
            }
            recalcCartFinancials();
        }

        function executeCheckout() {
            if(shoppingBag.length === 0) {
                alert("Bag manifest empty: Add hardware prior to checkout routing.");
                return;
            }
            alert("Rerouting payload to secure payment gateways...");
        }

        // ============================================
        // WISHLIST FUNCTIONS
        // ============================================
        function refreshWishlistUI() {
            const targetNode = document.getElementById('wishlist-node-target');
            document.getElementById('wishlist-indicator').innerText = wishlistBag.length;

            if (wishlistBag.length === 0) {
                targetNode.innerHTML = `<div class="panel-empty">No tracked items in registry.</div>`;
                return;
            }

            targetNode.innerHTML = wishlistBag.map((item, idx) => `
                <div class="panel-item">
                    <img src="${item.img}" class="panel-item-img">
                    <div class="panel-item-info">
                        <div class="panel-item-title">${item.name}</div>
                        <div class="panel-item-price">$${item.price.toFixed(2)}</div>
                    </div>
                    <button class="panel-item-remove" onclick="ejectWishItem(${idx})"><i class="fa-solid fa-xmark"></i></button>
                </div>
            `).join('');
        }

        function addToWishlistPipeline(id) {
            const matchedObj = sneakerInventory.find(p => p.id === id);
            if (!wishlistBag.some(item => item.id === id)) {
                wishlistBag.push({ id: matchedObj.id, name: matchedObj.name, price: matchedObj.price, img: matchedObj.variants[0].img });
                refreshWishlistUI();
            }
            toggleSidebar('wishlist', true);
        }

        function ejectWishItem(index) {
            wishlistBag.splice(index, 1);
            refreshWishlistUI();
        }

        // ============================================
        // REVIEW FUNCTIONS
        // ============================================
        function setRating(rating) {
            document.getElementById('review-rating').value = rating;
            document.querySelectorAll('.rating-star-select').forEach(function(star) {
                if (parseInt(star.getAttribute('data-rating')) <= rating) {
                    star.classList.add('active');
                    star.style.color = '#FFD700';
                } else {
                    star.classList.remove('active');
                    star.style.color = '#ddd';
                }
            });
        }

        function closeReviewModal() {
            document.getElementById('review-modal').classList.remove('active');
            document.body.style.overflow = 'auto';
        }

        function openReviewModal(productId) {
            currentProductId = productId;
            document.getElementById('review-modal').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function renderModalReviews(product) {
            const reviews = product.reviews || [];
            let html = '';
            
            if (reviews.length === 0) {
                html = `<p style="color:var(--success); font-size:11px; font-style:italic; padding:12px 0;">No reviews yet. Be the first to review this product.</p>`;
            } else {
                reviews.forEach(function(r) {
                    html += `
                        <div class="review-card-item">
                            <div class="review-card-header">
                                <span class="reviewer-name">${r.author}</span>
                                <span class="review-date">${r.date || 'Recent'}</span>
                            </div>
                            <div class="review-stars-small">${getStarString(r.rating)}</div>
                            <div class="review-text"><strong>${r.title || ''}</strong><br>${r.comment}</div>
                        </div>
                    `;
                });
            }
            
            return html;
        }

        function getStarString(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                stars += i <= rating ? '★' : '☆';
            }
            return stars;
        }

        function handleReviewSubmission(e) {
            e.preventDefault();
            
            const product = sneakerInventory.find(p => p.id === currentProductId);
            if (!product) {
                alert('Please select a product first.');
                return;
            }
            
            const author = document.getElementById('rev-author').value.trim();
            const score = parseInt(document.getElementById('review-rating').value);
            const title = document.getElementById('rev-title').value.trim();
            const text = document.getElementById('rev-body').value.trim();

            if (score === 0) {
                alert('Please select a rating');
                return;
            }

            if (!author) {
                alert('Please enter your name');
                return;
            }

            if (!text) {
                alert('Please write your review');
                return;
            }

            if (!product.reviews) product.reviews = [];
            product.reviews.unshift({ 
                author: author, 
                rating: score, 
                title: title || '', 
                comment: text,
                date: new Date().toISOString().split('T')[0]
            });
            
            // Refresh the modal to show the new review
            triggerProductModal(currentProductId);
            
            document.getElementById('review-submit-form').reset();
            document.getElementById('review-rating').value = 0;
            document.querySelectorAll('.rating-star-select').forEach(star => {
                star.classList.remove('active');
                star.style.color = '#ddd';
            });
            
            closeReviewModal();
            alert('Review submitted successfully!');
        }

        // ============================================
        // MODAL FUNCTIONS
        // ============================================
        window.triggerProductModal = function(id) {
            const product = sneakerInventory.find(p => p.id === id);
            if (!product) return;
            currentProductId = id;

            let rowInjections = Object.entries(product.specs).map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('');
            let swatchInjections = product.variants.map((v, i) => `<div class="swatch-node ${i===0?'active':''}" data-img="${v.img}" data-color="${v.color}" onclick="swapModalVariant(this)"><img src="${v.img}"></div>`).join('');
            let sizeInjections = product.sizes.map((s, i) => `<button class="size-node ${i===0?'active':''}" onclick="swapModalSize(this)">US ${s}</button>`).join('');

            // Generate reviews HTML
            let reviewsHtml = renderModalReviews(product);

            modalInjectorTarget.innerHTML = `
                <div class="modal-viewport">
                    <img src="${product.variants[0].img}" id="modal-primary-view-node">
                </div>
                <div class="modal-meta-box">
                    <h2>${product.name}</h2>
                    <div class="modal-price-tag">$${product.price.toFixed(2)}</div>
                    <p class="modal-summary">${product.desc}</p>
                    <table class="spec-grid">${rowInjections}</table>
                    
                    <div class="selector-header">Color Profile Matrix:</div>
                    <div class="swatch-row">${swatchInjections}</div>
                    
                    <div class="selector-header">Anatomical Performance Sizing:</div>
                    <div class="size-row">${sizeInjections}</div>
                    
                    <div class="selector-header">Payload Units:</div>
                    <div class="qty-controls">
                        <button class="qty-action" onclick="alterModalQty(-1)">-</button>
                        <input type="text" class="qty-view" id="modal-qty-input" value="1" readonly>
                        <button class="qty-action" onclick="alterModalQty(1)">+</button>
                    </div>

                    <div class="modal-footer-btns">
                        <button class="btn-cart-add" onclick="commitModalAddToBag('${product.name}', ${product.price}, false)">Add To Bag</button>
                        <button class="btn-buy-now" onclick="commitModalAddToBag('${product.name}', ${product.price}, true)">Buy Now</button>
                        <button class="btn-wish-add" onclick="addToWishlistPipeline(${product.id})"><i class="fa-regular fa-heart"></i></button>
                    </div>
                    
                    <!-- Reviews Section inside modal -->
                    <div class="review-section">
                        <div class="review-title">Customer Feedback</div>
                        <div class="review-list">
                            ${reviewsHtml}
                        </div>
                        <button class="write-review-btn" onclick="openReviewModal(${product.id})">Write a Review</button>
                    </div>
                </div>
            `;
            detailsModal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function shutdownProductModal() {
            detailsModal.classList.remove('active');
            if(!panelMask.classList.contains('active')) document.body.style.overflow = 'auto';
        }
        dismissModal.addEventListener('click', shutdownProductModal);
        detailsModal.addEventListener('click', (e) => { if(e.target === detailsModal) shutdownProductModal(); });

        window.swapModalVariant = function(element) {
            document.querySelectorAll('.swatch-node').forEach(node => node.classList.remove('active'));
            element.classList.add('active');
            document.getElementById('modal-primary-view-node').src = element.getAttribute('data-img');
        }

        window.swapModalSize = function(element) {
            document.querySelectorAll('.size-node').forEach(node => node.classList.remove('active'));
            element.classList.add('active');
        }

        window.alterModalQty = function(value) {
            const inputField = document.getElementById('modal-qty-input');
            let updatedCalc = parseInt(inputField.value) + value;
            inputField.value = updatedCalc < 1 ? 1 : updatedCalc;
        }

        window.commitModalAddToBag = function(name, basePrice, instantCheckoutTrigger) {
            const activeImg = document.getElementById('modal-primary-view-node').src;
            const activeColor = document.querySelector('.swatch-node.active').getAttribute('data-color');
            const activeSize = document.querySelector('.size-node.active').innerText;
            const finalQty = parseInt(document.getElementById('modal-qty-input').value);

            pushToBagDataArray(name, basePrice, activeImg, activeColor, activeSize, finalQty);
            shutdownProductModal();
            
            if (instantCheckoutTrigger) {
                executeCheckout();
            } else {
                toggleSidebar('cart', true);
            }
        }

        // ============================================
        // FAQ ACCORDION
        // ============================================
        window.handleAccordion = function(triggerBtn) {
            triggerBtn.parentElement.classList.toggle('active');
        }

        // ============================================
        // CONTACT FORM
        // ============================================
        function submitContactForm(event) {
            event.preventDefault();
            
            var name = document.getElementById('contact_name').value.trim();
            var email = document.getElementById('contact_email').value.trim();
            var message = document.getElementById('contact_message').value.trim();
            
            if (!name || !email || !message) {
                alert('Please fill in all fields.');
                return;
            }
            
            var subdomain = document.body.getAttribute('data-page-subdomain');
            
            var formData = new FormData();
            formData.append('name', name);
            formData.append('email', email);
            formData.append('message', message);
            formData.append('form_name', 'contact_form');
            
            fetch('/builder/submit-form/' + subdomain + '/', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-CSRFToken': getCSRFToken()
                }
            })
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.success) {
                    alert('Transmission verified and routed.');
                    document.getElementById('contactForm').reset();
                } else {
                    alert('Error: ' + (data.error || 'Please try again.'));
                }
            })
            .catch(function(error) {
                console.error('❌ Contact form error:', error);
                alert('Network error. Please try again.');
            });
        }

        // ============================================
        // UTILITY FUNCTIONS
        // ============================================
        function getCSRFToken() {
            var csrfToken = document.querySelector('[name=csrfmiddlewaretoken]');
            return csrfToken ? csrfToken.value : '';
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>]/g, function(m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            });
        }

        // ============================================
        // INITIALIZATION
        // ============================================
        refreshBagUI();
        refreshWishlistUI();
    </script>
</body>
</html>