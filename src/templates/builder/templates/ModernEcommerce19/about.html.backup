<!-- builder/templates/ModernToyShop19/about.html -->
{%load static%}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | Nook & Nest</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary-leaf: #5c8b39;
            --terracotta: #c07436;
            --warm-clay: #bf7f4a;
            --olive-drab: #636a2f;
            --deep-forest: #212615;
            --bg-light: #fefaf5;
            --card-shadow: 0 12px 28px -8px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.02);
            --hover-shadow: 0 20px 32px -12px rgba(33,38,21,0.12);
            --border-radius-card: 28px;
            --border-radius-element: 40px;
            --transition-smooth: all 0.3s cubic-bezier(0.2,0.9,0.4,1.1);
        }
        main { background-color: var(--bg-light); font-family: 'Inter', sans-serif; color: var(--deep-forest); line-height: 1.4; overflow-x: hidden; }
        h1, h2, h3 { font-family: 'Quicksand', 'Inter', sans-serif; font-weight: 600; letter-spacing: -0.01em; }
        .container { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
        .page-header { text-align: center; padding: 2rem 0 3rem; margin-bottom: 1rem; }
        .page-header h1 { font-size: 3rem; font-weight: 600; color: var(--deep-forest); margin-bottom: 1rem; position: relative; display: inline-block; }
        .page-header h1::after { content: ''; position: absolute; bottom: -12px; left: 50%; transform: translateX(-50%); width: 80px; height: 3px; background: linear-gradient(90deg, var(--terracotta), var(--warm-clay)); border-radius: 2px; }
        .page-header p { font-size: 1.1rem; color: var(--deep-forest); opacity: 0.7; max-width: 600px; margin: 1.5rem auto 0; line-height: 1.6; }
        .about-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 4rem; align-items: center; }
        .about-hero-image { border-radius: var(--border-radius-card); overflow: hidden; box-shadow: var(--card-shadow); height: 450px; width: 100%; object-fit: cover; }
        .about-hero-content { padding: 1rem; }
        .about-hero-content h2 { font-size: 2rem; margin-bottom: 1rem; color: var(--deep-forest); }
        .about-hero-content p { color: var(--deep-forest); opacity: 0.7; line-height: 1.7; margin-bottom: 1rem; font-size: 1rem; }
        .highlight-quote { font-size: 1.1rem; font-style: italic; color: var(--terracotta); border-left: 3px solid var(--terracotta); padding-left: 1.2rem; margin: 1.5rem 0; line-height: 1.6; }
        .mission-values { background: white; border-radius: var(--border-radius-card); padding: 3rem; margin-bottom: 4rem; box-shadow: var(--card-shadow); }
        .mission-values h2 { font-size: 2rem; text-align: center; margin-bottom: 2rem; color: var(--deep-forest); }
        .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: 2rem; }
        .value-item { text-align: center; padding: 1.5rem; }
        .value-icon { font-size: 2.5rem; color: var(--terracotta); margin-bottom: 1rem; }
        .value-title { font-size: 1.2rem; margin-bottom: 0.8rem; font-weight: 600; }
        .value-description { font-size: 0.9rem; color: var(--deep-forest); opacity: 0.7; line-height: 1.6; }
        .mission-statement { text-align: center; padding: 2rem; background: rgba(192,116,54,0.05); border-radius: var(--border-radius-card); margin-top: 1rem; }
        .mission-statement h3 { font-size: 1.3rem; margin-bottom: 0.8rem; color: var(--deep-forest); }
        .mission-statement p { font-size: 1rem; color: var(--deep-forest); opacity: 0.7; line-height: 1.6; max-width: 700px; margin: 0 auto; }
        .craftsmanship { margin-bottom: 4rem; }
        .craftsmanship h2 { font-size: 2rem; text-align: center; margin-bottom: 2rem; color: var(--deep-forest); }
        .craftsmanship-content { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
        .craftsmanship-image { border-radius: var(--border-radius-card); overflow: hidden; box-shadow: var(--card-shadow); height: 400px; width: 100%; object-fit: cover; }
        .craftsmanship-text h3 { font-size: 1.5rem; margin-bottom: 1rem; color: var(--deep-forest); }
        .craftsmanship-text p { color: var(--deep-forest); opacity: 0.7; line-height: 1.7; margin-bottom: 1rem; }
        .craftsmanship-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
        .stat-item { text-align: center; padding: 1rem; background: rgba(192,116,54,0.05); border-radius: var(--border-radius-card); }
        .stat-number { font-size: 1.8rem; font-weight: 700; color: var(--terracotta); margin-bottom: 0.3rem; }
        .stat-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; color: var(--deep-forest); opacity: 0.7; }
        .timeline-section { margin-bottom: 4rem; }
        .timeline-section h2 { font-size: 2rem; text-align: center; margin-bottom: 2rem; color: var(--deep-forest); }
        .timeline { position: relative; max-width: 1000px; margin: 0 auto; }
        .timeline::before { content: ''; position: absolute; left: 50%; transform: translateX(-50%); width: 2px; height: 100%; background: linear-gradient(to bottom, var(--terracotta), var(--warm-clay)); }
        .timeline-item { margin-bottom: 2rem; position: relative; width: 45%; }
        .timeline-item:nth-child(odd) { margin-left: 0; margin-right: auto; }
        .timeline-item:nth-child(even) { margin-left: auto; margin-right: 0; }
        .timeline-content { background: white; border-radius: var(--border-radius-card); padding: 1.2rem; box-shadow: var(--card-shadow); position: relative; }
        .timeline-year { font-size: 1.2rem; font-weight: 700; color: var(--terracotta); margin-bottom: 0.5rem; }
        .timeline-title { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; }
        .timeline-description { font-size: 0.85rem; color: var(--deep-forest); opacity: 0.7; line-height: 1.5; }
        .timeline-item::before { content: ''; position: absolute; width: 12px; height: 12px; background: var(--terracotta); border-radius: 50%; top: 20px; }
        .timeline-item:nth-child(odd)::before { right: -38px; }
        .timeline-item:nth-child(even)::before { left: -38px; }
        .team-section { margin-bottom: 4rem; }
        .team-section h2 { font-size: 2rem; text-align: center; margin-bottom: 2rem; color: var(--deep-forest); }
        .team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
        .team-member { background: white; border-radius: var(--border-radius-card); overflow: hidden; text-align: center; transition: var(--transition-smooth); box-shadow: var(--card-shadow); }
        .team-member:hover { transform: translateY(-8px); box-shadow: var(--hover-shadow); }
        .team-member-image { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
        .team-member-info { padding: 1.2rem; }
        .team-member-name { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.3rem; }
        .team-member-role { font-size: 0.8rem; color: var(--terracotta); margin-bottom: 0.8rem; text-transform: uppercase; letter-spacing: 1px; }
        .team-member-bio { font-size: 0.85rem; color: var(--deep-forest); opacity: 0.7; line-height: 1.5; }
        .commitment-section { background: linear-gradient(135deg, var(--deep-forest), var(--olive-drab)); border-radius: var(--border-radius-card); padding: 3rem; text-align: center; margin-bottom: 4rem; color: white; }
        .commitment-section h2 { font-size: 2rem; margin-bottom: 1rem; color: white; }
        .commitment-section p { font-size: 1rem; opacity: 0.9; max-width: 700px; margin: 0 auto 2rem; line-height: 1.6; }
        .commitment-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 1rem; }
        .commitment-stat { text-align: center; }
        .commitment-number { font-size: 2rem; font-weight: 700; color: var(--warm-clay); margin-bottom: 0.3rem; }
        .commitment-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; }
        @media (max-width: 1200px) { .team-grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 992px) { .about-hero, .craftsmanship-content { grid-template-columns: 1fr; } .about-hero-image, .craftsmanship-image { height: 350px; } .values-grid { grid-template-columns: repeat(2, 1fr); } .team-grid { grid-template-columns: repeat(2, 1fr); } .commitment-stats { grid-template-columns: repeat(2, 1fr); } .timeline::before { left: 30px; } .timeline-item { width: calc(100% - 60px); margin-left: 60px !important; margin-right: 0 !important; } .timeline-item::before { left: -38px !important; } }
        @media (max-width: 768px) { .container { padding: 0 1.5rem; } .values-grid, .craftsmanship-stats { grid-template-columns: 1fr; } .team-grid { grid-template-columns: 1fr; max-width: 350px; margin: 0 auto; } .commitment-stats { grid-template-columns: 1fr; gap: 1.5rem; } .page-header h1 { font-size: 2rem; } .mission-values, .commitment-section { padding: 1.5rem; } }
        @media (max-width: 576px) { .about-hero-image, .craftsmanship-image { height: 250px; } .timeline-content { padding: 1rem; } }
    </style>
</head>
<body>

<main>
    <div class="container">
    <!-- Page Header - EDITABLE -->
    <div class="page-header editable-section" data-section="340">
        <h1 class="editable-text editable-section no-drop-zone" data-section="341" data-text="207">Our Story</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="342" data-text="208">Crafting timeless toys that inspire imagination, creativity, and joyful moments for families everywhere.</p>
    </div>

    <!-- Hero Section - EDITABLE -->
    <div class="about-hero editable-section" data-section="343">
        <img src="{%static 'images/Ecom19/hero.jpg'%}" class="about-hero-image editable-image" data-image="43">
        <div class="about-hero-content editable-section no-drop-zone" data-section="344">
            <h2 class="editable-text editable-section no-drop-zone" data-section="345" data-text="209">A Legacy of Play</h2>
            <p class="editable-text editable-section no-drop-zone" data-section="346" data-text="210">Founded in 2015 by childhood friends Emma and Sarah, Nook & Nest began with a simple belief: children deserve toys that are not only beautiful but also thoughtfully designed to spark creativity and imagination.</p>
            <p class="editable-text editable-section no-drop-zone" data-section="347" data-text="211">What started as a small workshop in Portland, Oregon has grown into a beloved brand trusted by families worldwide.</p>
            <p class="highlight-quote editable-text editable-section no-drop-zone" data-section="348" data-text="212">"Toys are more than just objects—they're the building blocks of childhood memories." — Emma & Sarah</p>
        </div>
    </div>

    <!-- Mission & Values - EDITABLE -->
    <div class="mission-values editable-section" data-section="349">
        <h2 class="editable-text editable-section no-drop-zone" data-section="350" data-text="213">Our Philosophy</h2>
        <div class="values-grid">
            <div class="value-item editable-section no-drop-zone" data-section="351">
                <div class="value-icon editable-icon" data-icon="37"><i class="fas fa-tree"></i></div>
                <h3 class="value-title editable-text editable-section no-drop-zone" data-section="352" data-text="214">Sustainable Materials</h3>
                <p class="value-description editable-text editable-section no-drop-zone" data-section="353" data-text="215">We source only sustainable, renewable materials. Our wood comes from responsibly managed forests.</p>
            </div>
            <div class="value-item editable-section no-drop-zone" data-section="354">
                <div class="value-icon editable-icon" data-icon="38"><i class="fas fa-hand-sparkles"></i></div>
                <h3 class="value-title editable-text editable-section no-drop-zone" data-section="355" data-text="216">Artisan Craftsmanship</h3>
                <p class="value-description editable-text editable-section no-drop-zone" data-section="356" data-text="217">Each toy is handcrafted by skilled artisans who pour their expertise and passion into every piece.</p>
            </div>
            <div class="value-item editable-section no-drop-zone" data-section="357">
                <div class="value-icon editable-icon" data-icon="39"><i class="fas fa-brain"></i></div>
                <h3 class="value-title editable-text editable-section no-drop-zone" data-section="358" data-text="218">Purposeful Design</h3>
                <p class="value-description editable-text editable-section no-drop-zone" data-section="359" data-text="219">Every toy is thoughtfully designed to support developmental milestones and encourage open-ended play.</p>
            </div>
        </div>
        <div class="mission-statement editable-section no-drop-zone" data-section="360">
            <h3 class="editable-text editable-section no-drop-zone" data-section="361" data-text="220">Our Mission</h3>
            <p class="editable-text editable-section no-drop-zone" data-section="362" data-text="221">To create timeless toys that bring joy, spark curiosity, and foster meaningful connections between children and their world—all while caring for the planet we share.</p>
        </div>
    </div>

    <!-- Craftsmanship Section - EDITABLE -->
    <div class="craftsmanship editable-section" data-section="363">
        <h2 class="editable-text editable-section no-drop-zone" data-section="364" data-text="222">The Art of Craftsmanship</h2>
        <div class="craftsmanship-content">
            <div class="craftsmanship-text editable-section no-drop-zone" data-section="365">
                <h3 class="editable-text editable-section no-drop-zone" data-section="366" data-text="223">Handcrafted with Care</h3>
                <p class="editable-text editable-section no-drop-zone" data-section="367" data-text="224">Every Nook & Nest toy begins with a sketch, brought to life by our skilled artisans. From selecting the finest maple and beech woods to hand-sanding each edge until smooth, we pour love into every detail.</p>
                <div class="craftsmanship-stats">
                    <div class="stat-item editable-section no-drop-zone" data-section="368">
                        <div class="stat-number editable-text editable-section no-drop-zone" data-section="369" data-text="225">50+</div>
                        <div class="stat-label editable-text editable-section no-drop-zone" data-section="370" data-text="226">Quality Checks</div>
                    </div>
                    <div class="stat-item editable-section no-drop-zone" data-section="371">
                        <div class="stat-number editable-text editable-section no-drop-zone" data-section="372" data-text="227">100%</div>
                        <div class="stat-label editable-text editable-section no-drop-zone" data-section="373" data-text="228">Non-Toxic</div>
                    </div>
                    <div class="stat-item editable-section no-drop-zone" data-section="374">
                        <div class="stat-number editable-text editable-section no-drop-zone" data-section="375" data-text="229">10+</div>
                        <div class="stat-label editable-text editable-section no-drop-zone" data-section="376" data-text="230">Years of Joy</div>
                    </div>
                </div>
            </div>
            <img src="{%static 'images/Ecom19/prod2.jpg'%}" class="craftsmanship-image editable-image" data-image="44">
        </div>
    </div>

    <!-- Timeline Section - EDITABLE -->
    <div class="timeline-section editable-section" data-section="377">
        <h2 class="editable-text editable-section no-drop-zone" data-section="378" data-text="231">Our Journey</h2>
        <div class="timeline">
            <div class="timeline-item editable-section no-drop-zone" data-section="379">
                <div class="timeline-content">
                    <div class="timeline-year editable-text editable-section no-drop-zone" data-section="380" data-text="232">2015</div>
                    <div class="timeline-title editable-text editable-section no-drop-zone" data-section="381" data-text="233">The Beginning</div>
                    <div class="timeline-description editable-text editable-section no-drop-zone" data-section="382" data-text="234">Emma and Sarah founded Nook & Nest in their small Portland garage.</div>
                </div>
            </div>
            <div class="timeline-item editable-section no-drop-zone" data-section="383">
                <div class="timeline-content">
                    <div class="timeline-year editable-text editable-section no-drop-zone" data-section="384" data-text="235">2017</div>
                    <div class="timeline-title editable-text editable-section no-drop-zone" data-section="385" data-text="236">First Workshop</div>
                    <div class="timeline-description editable-text editable-section no-drop-zone" data-section="386" data-text="237">Opened our first dedicated workshop, expanding our collection.</div>
                </div>
            </div>
            <div class="timeline-item editable-section no-drop-zone" data-section="387">
                <div class="timeline-content">
                    <div class="timeline-year editable-text editable-section no-drop-zone" data-section="388" data-text="238">2019</div>
                    <div class="timeline-title editable-text editable-section no-drop-zone" data-section="389" data-text="239">Sustainability Commitment</div>
                    <div class="timeline-description editable-text editable-section no-drop-zone" data-section="390" data-text="240">Transitioned to 100% sustainable materials and eco-friendly packaging.</div>
                </div>
            </div>
            <div class="timeline-item editable-section no-drop-zone" data-section="391">
                <div class="timeline-content">
                    <div class="timeline-year editable-text editable-section no-drop-zone" data-section="392" data-text="241">2022</div>
                    <div class="timeline-title editable-text editable-section no-drop-zone" data-section="393" data-text="242">Global Reach</div>
                    <div class="timeline-description editable-text editable-section no-drop-zone" data-section="394" data-text="243">Expanded to serve families in over 30 countries worldwide.</div>
                </div>
            </div>
            <div class="timeline-item editable-section no-drop-zone" data-section="395">
                <div class="timeline-content">
                    <div class="timeline-year editable-text editable-section no-drop-zone" data-section="396" data-text="244">2024</div>
                    <div class="timeline-title editable-text editable-section no-drop-zone" data-section="397" data-text="245">Today & Beyond</div>
                    <div class="timeline-description editable-text editable-section no-drop-zone" data-section="398" data-text="246">Continuing our mission to craft beautiful, sustainable toys.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Section - EDITABLE -->
    <div class="team-section editable-section" data-section="399">
        <h2 class="editable-text editable-section no-drop-zone" data-section="400" data-text="247">Meet Our Team</h2>
        <div class="team-grid">
            <div class="team-member editable-section no-drop-zone" data-section="401">
                <img src="{%static 'images/Ecom19/woman2.jpg'%}" class="team-member-image editable-image" data-image="45">
                <div class="team-member-info">
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="402" data-text="248">Emma Thompson</div>
                    <div class="team-member-role editable-text editable-section no-drop-zone" data-section="403" data-text="249">Co-Founder & Creative Director</div>
                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="404" data-text="250">Emma's passion for child development drives our creative vision.</div>
                </div>
            </div>
            <div class="team-member editable-section no-drop-zone" data-section="405">
                <img src="{%static 'images/Ecom19/woman1.jpg'%}" class="team-member-image editable-image" data-image="46">
                <div class="team-member-info">
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="406" data-text="251">Sarah Chen</div>
                    <div class="team-member-role editable-text editable-section no-drop-zone" data-section="407" data-text="252">Co-Founder & Operations Director</div>
                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="408" data-text="253">Sarah manages sustainable sourcing and production.</div>
                </div>
            </div>
            <div class="team-member editable-section no-drop-zone" data-section="409">
                <img src="{%static 'images/Ecom19/man1.jpg'%}" class="team-member-image editable-image" data-image="47">
                <div class="team-member-info">
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="410" data-text="254">Michael Rodriguez</div>
                    <div class="team-member-role editable-text editable-section no-drop-zone" data-section="411" data-text="255">Master Craftsman</div>
                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="412" data-text="256">With over 20 years of woodworking experience.</div>
                </div>
            </div>
            <div class="team-member editable-section no-drop-zone" data-section="413">
                <img src="{%static 'images/Ecom19/man2.jpg'%}" class="team-member-image editable-image" data-image="48">
                <div class="team-member-info">
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="414" data-text="257">Olivia Williams</div>
                    <div class="team-member-role editable-text editable-section no-drop-zone" data-section="415" data-text="258">Customer Experience Lead</div>
                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="416" data-text="259">Olivia ensures every family feels supported.</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Commitment Section - EDITABLE -->
    <div class="commitment-section editable-section" data-section="417">
        <h2 class="editable-text editable-section no-drop-zone" data-section="418" data-text="260">Our Commitment</h2>
        <p class="editable-text editable-section no-drop-zone" data-section="419" data-text="261">We're dedicated to creating toys that are safe, sustainable, and built to last. Every purchase supports ethical production.</p>
        <div class="commitment-stats">
            <div class="commitment-stat editable-section no-drop-zone" data-section="420">
                <div class="commitment-number editable-text editable-section no-drop-zone" data-section="421" data-text="262">100%</div>
                <div class="commitment-label editable-text editable-section no-drop-zone" data-section="422" data-text="263">Sustainable Wood</div>
            </div>
            <div class="commitment-stat editable-section no-drop-zone" data-section="423">
                <div class="commitment-number editable-text editable-section no-drop-zone" data-section="424" data-text="264">50K+</div>
                <div class="commitment-label editable-text editable-section no-drop-zone" data-section="425" data-text="265">Happy Families</div>
            </div>
            <div class="commitment-stat editable-section no-drop-zone" data-section="426">
                <div class="commitment-number editable-text editable-section no-drop-zone" data-section="427" data-text="266">10+</div>
                <div class="commitment-label editable-text editable-section no-drop-zone" data-section="428" data-text="267">Years of Craftsmanship</div>
            </div>
            <div class="commitment-stat editable-section no-drop-zone" data-section="429">
                <div class="commitment-number editable-text editable-section no-drop-zone" data-section="430" data-text="268">30+</div>
                <div class="commitment-label editable-text editable-section no-drop-zone" data-section="431" data-text="269">Countries Served</div>
            </div>
        </div>
    </div>
</div>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const timelineItems = document.querySelectorAll('.timeline-item');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, { threshold: 0.2 });
        timelineItems.forEach((item, index) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(20px)';
            item.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
            observer.observe(item);
        });
    });
</script>
</body>
</html>