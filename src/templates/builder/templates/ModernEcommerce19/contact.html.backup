<!-- builder/templates/ModernToyShop19/contact.html -->
{%load static%}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Nook & Nest</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary-leaf: #5c8b39;
            --terracotta: #c07436;
            --warm-clay: #bf7f4a;
            --olive-drab: #636a2f;
            --deep-forest: #212615;
            --bg-light: #fefaf5;
            --card-shadow: 0 12px 28px -8px rgba(0,0,0,0.08), 0 4px 12px rgba(0,0,0,0.02);
            --hover-shadow: 0 20px 32px -12px rgba(33,38,21,0.12);
            --border-radius-card: 28px;
            --border-radius-element: 40px;
            --transition-smooth: all 0.3s cubic-bezier(0.2,0.9,0.4,1.1);
        }
        main { background-color: var(--bg-light); font-family: 'Inter', sans-serif; color: var(--deep-forest); line-height: 1.4; overflow-x: hidden;  }
        h1, h2, h3 { font-family: 'Quicksand', 'Inter', sans-serif; font-weight: 600; letter-spacing: -0.01em; }
        .container { max-width: 1400px; margin: 0 auto; padding: 0 2rem; }
        .page-header { text-align: center; padding: 2rem 0 3rem; margin-bottom: 1rem; }
        .page-header h1 { font-size: 3rem; font-weight: 600; color: var(--deep-forest); margin-bottom: 1rem; position: relative; display: inline-block; }
        .page-header h1::after { content: ''; position: absolute; bottom: -12px; left: 50%; transform: translateX(-50%); width: 80px; height: 3px; background: linear-gradient(90deg, var(--terracotta), var(--warm-clay)); border-radius: 2px; }
        .page-header p { font-size: 1.1rem; color: var(--deep-forest); opacity: 0.7; max-width: 600px; margin: 1.5rem auto 0; line-height: 1.6; }
        .contact-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 4rem; }
        .contact-info { background: white; border-radius: var(--border-radius-card); padding: 2rem; box-shadow: var(--card-shadow); }
        .contact-info h2 { font-size: 1.5rem; margin-bottom: 1.5rem; color: var(--deep-forest); }
        .contact-methods { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 2rem; }
        .contact-method { display: flex; gap: 1rem; align-items: flex-start; }
        .contact-icon { width: 48px; height: 48px; background: rgba(192,116,54,0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--terracotta); font-size: 1.2rem; flex-shrink: 0; }
        .contact-details h3 { font-size: 1rem; margin-bottom: 0.3rem; font-weight: 600; }
        .contact-details p, .contact-details a { color: var(--deep-forest); opacity: 0.7; text-decoration: none; line-height: 1.5; font-size: 0.9rem; }
        .contact-details a:hover { color: var(--terracotta); }
        .business-hours { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid rgba(99,106,47,0.1); }
        .business-hours h3 { font-size: 1rem; margin-bottom: 1rem; font-weight: 600; }
        .hours-list { list-style: none; }
        .hours-list li { display: flex; justify-content: space-between; padding: 0.5rem 0; font-size: 0.9rem; border-bottom: 1px solid rgba(99,106,47,0.05); }
        .contact-form-section { background: white; border-radius: var(--border-radius-card); padding: 2rem; box-shadow: var(--card-shadow); }
        .contact-form-section h2 { font-size: 1.5rem; margin-bottom: 1.5rem; color: var(--deep-forest); }
        .form-group { margin-bottom: 1.2rem; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; font-weight: 500; font-size: 0.85rem; }
        .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.8rem 1rem; border: 1px solid rgba(99,106,47,0.2); border-radius: 12px; font-family: 'Inter', sans-serif; font-size: 0.9rem; transition: var(--transition-smooth); }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: var(--terracotta); box-shadow: 0 0 0 3px rgba(192,116,54,0.1); }
        .submit-btn { background: var(--terracotta); color: white; padding: 0.9rem 2rem; border: none; border-radius: 40px; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: var(--transition-smooth); width: 100%; margin-top: 0.5rem; }
        .submit-btn:hover { background: var(--warm-clay); transform: translateY(-2px); }

        /* Shop Locations Section */
        .shop-locations { margin-bottom: 4rem; }
        .shop-locations h2 { font-size: 2rem; text-align: center; margin-bottom: 1rem; color: var(--deep-forest); }
        .shop-locations > p { text-align: center; color: var(--deep-forest); opacity: 0.7; margin-bottom: 3rem; }
        .locations-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
        .location-card { background: white; border-radius: var(--border-radius-card); overflow: hidden; transition: var(--transition-smooth); box-shadow: var(--card-shadow); }
        .location-card:hover { transform: translateY(-8px); box-shadow: var(--hover-shadow); }
        .location-image-container { position: relative; overflow: hidden; aspect-ratio: 16 / 9; }
        .location-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .location-card:hover .location-img { transform: scale(1.05); }
        .location-badge { position: absolute; top: 1rem; left: 1rem; background: var(--terracotta); color: white; padding: 0.3rem 0.8rem; border-radius: 40px; font-size: 0.7rem; font-weight: 600; }
        .location-badge.sale { background: var(--primary-leaf); }
        .location-info { padding: 1.2rem; }
        .location-name { font-size: 1.2rem; font-weight: 600; margin-bottom: 0.8rem; color: var(--deep-forest); }
        .location-address { font-size: 0.85rem; color: var(--deep-forest); opacity: 0.7; line-height: 1.5; margin-bottom: 0.8rem; }
        .location-phone, .location-hours { font-size: 0.8rem; color: var(--deep-forest); opacity: 0.7; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
        .location-phone i, .location-hours i { color: var(--terracotta); width: 16px; }
        .location-direction { display: inline-block; margin-top: 0.8rem; color: var(--terracotta); font-size: 0.8rem; font-weight: 500; text-decoration: none; transition: var(--transition-smooth); }
        .location-direction:hover { color: var(--warm-clay); transform: translateX(4px); }

        /* FAQ Section */
        .faq-section { margin-bottom: 4rem; }
        .faq-section h2 { font-size: 2rem; text-align: center; margin-bottom: 2rem; color: var(--deep-forest); }
        .faq-container { max-width: 900px; margin: 0 auto; }
        .faq-item { background: white; border-radius: var(--border-radius-card); margin-bottom: 1rem; overflow: hidden; box-shadow: var(--card-shadow); transition: var(--transition-smooth); }
        .faq-question { width: 100%; padding: 1.2rem 1.5rem; background: white; border: none; text-align: left; font-family: 'Quicksand', sans-serif; font-weight: 600; font-size: 1rem; color: var(--deep-forest); cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: var(--transition-smooth); }
        .faq-question:hover { background: rgba(192,116,54,0.05); }
        .faq-question.active { color: var(--terracotta); }
        .faq-icon { font-size: 1rem; transition: transform 0.3s ease; color: var(--terracotta); }
        .faq-question.active .faq-icon { transform: rotate(45deg); }
        .faq-answer { max-height: 300px; overflow: hidden; transition: max-height 0.3s ease; padding: 0 1.5rem; }
        .faq-answer.active { max-height: 300px; padding: 0 1.5rem 1.2rem 1.5rem; }
        .faq-answer p { color: var(--deep-forest); opacity: 0.7; line-height: 1.6; font-size: 0.9rem; }
        .additional-support { background: white; border-radius: var(--border-radius-card); padding: 2rem; text-align: center; margin-bottom: 4rem; box-shadow: var(--card-shadow); }
        .additional-support h2 { font-size: 1.3rem; margin-bottom: 1rem; }
        .additional-support p { color: var(--deep-forest); opacity: 0.7; margin-bottom: 1.5rem; }
        .support-links { display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; }
        .support-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--terracotta); text-decoration: none; font-weight: 500; transition: var(--transition-smooth); }
        @media (max-width: 1200px) { .locations-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 992px) { .contact-layout { grid-template-columns: 1fr; gap: 2rem; } .form-row { grid-template-columns: 1fr; gap: 1rem; } }
        @media (max-width: 768px) {  .container { padding: 0 1.5rem; } .contact-info, .contact-form-section { padding: 1.5rem; } .locations-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; } .faq-question { padding: 1rem; font-size: 0.9rem; } .support-links { flex-direction: column; gap: 1rem; align-items: center; } .page-header h1 { font-size: 2rem; } .faq-section h2 { font-size: 1.5rem; } .shop-locations h2 { font-size: 1.5rem; } }
        @media (max-width: 576px) { .contact-method { flex-direction: column; align-items: flex-start; gap: 0.5rem; } .contact-icon { width: 40px; height: 40px; font-size: 1rem; } }
    </style>
</head>
<body>

<main>
    <div class="container">
    <!-- Page Header - EDITABLE -->
    <div class="page-header editable-section" data-section="450">
        <h1 class="editable-text editable-section no-drop-zone" data-section="451" data-text="270">Contact Us</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="452" data-text="271">Have questions about our toys? We'd love to hear from you. Reach out and we'll get back to you within 24 hours.</p>
    </div>

    <!-- Contact Layout -->
    <div class="contact-layout">
        <!-- Contact Information - EDITABLE -->
        <div class="contact-info editable-section no-drop-zone" data-section="453">
            <h2 class="editable-text editable-section no-drop-zone" data-section="454" data-text="272">Get in Touch</h2>
            <div class="contact-methods">
                <div class="contact-method editable-section no-drop-zone" data-section="455">
                    <div class="contact-icon editable-icon" data-icon="28"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="contact-details">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="456" data-text="273">Visit Our Store</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="457" data-text="274">123 Playful Lane<br>Portland, OR 97201<br>United States</p>
                    </div>
                </div>
                <div class="contact-method editable-section no-drop-zone" data-section="458">
                    <div class="contact-icon editable-icon" data-icon="29"><i class="fas fa-phone"></i></div>
                    <div class="contact-details">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="459" data-text="275">Call Us</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="460" data-text="276"><a href="tel:+15551234567">+1 (555) 123-4567</a><br>Monday - Friday: 9AM - 6PM EST</p>
                    </div>
                </div>
                <div class="contact-method editable-section no-drop-zone" data-section="461">
                    <div class="contact-icon editable-icon" data-icon="30"><i class="fas fa-envelope"></i></div>
                    <div class="contact-details">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="462" data-text="277">Email Us</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="463" data-text="278"><a href="mailto:hello@nookandnest.com">hello@nookandnest.com</a><br>Customer support available 24/7</p>
                    </div>
                </div>
            </div>
            <div class="business-hours editable-section no-drop-zone" data-section="464">
                <h3 class="editable-text editable-section no-drop-zone" data-section="465" data-text="279">Business Hours</h3>
                <ul class="hours-list">
                    <li class="editable-section no-drop-zone" data-section="950"><span class="hours-day editable-text"  data-text="350">Monday - Friday</span><span class="hours-time editable-text" data-text="353">9:00 AM - 6:00 PM</span></li>
                    <li class="editable-section no-drop-zone" data-section="951"><span class="hours-day editable-text"  data-text="351">Saturday</span><span class="hours-time editable-text" data-text="354">10:00 AM - 4:00 PM</span></li>
                    <li class="editable-section no-drop-zone" data-section="952"><span class="hours-day editable-text"  data-text="352">Sunday</span><span class="hours-time editable-text" data-text="355">Closed</span></li>
                </ul>
            </div>
        </div>

        <!-- Contact Form - EDITABLE -->
        <div class="contact-form-section editable-section no-drop-zone" data-section="466">
            <h2 class="editable-text editable-section no-drop-zone" data-section="467" data-text="280">Send Us a Message</h2>
            <form id="contactForm" class="contact-form">
                <div class="form-row">
                    <div class="form-group">
                        <label class="editable-text" data-text="281">First Name *</label>
                        <input type="text" id="firstName" name="firstName" class="editable-text" data-text="282" required>
                    </div>
                    <div class="form-group">
                        <label class="editable-text" data-text="283">Last Name *</label>
                        <input type="text" id="lastName" name="lastName" class="editable-text" data-text="284" required>
                    </div>
                </div>
                <div class="form-group">
                    <label class="editable-text" data-text="285">Email Address *</label>
                    <input type="email" id="email" name="email" class="editable-text" data-text="286" required>
                </div>
                <div class="form-group">
                    <label class="editable-text" data-text="287">Phone Number</label>
                    <input type="tel" id="phone" name="phone" class="editable-text" data-text="288">
                </div>
                <div class="form-group">
                    <label class="editable-text" data-text="289">Subject *</label>
                    <select id="subject" name="subject" class="editable-text" data-text="290" required>
                        <option value="">Select a subject</option>
                        <option value="general">General Inquiry</option>
                        <option value="order">Order Status</option>
                        <option value="product">Product Question</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="editable-text" data-text="291">Your Message *</label>
                    <textarea id="message" name="message" rows="5" class="editable-text" data-text="292" required></textarea>
                </div>
                <button type="submit" class="submit-btn editable-text editable-section no-drop-zone" data-section="468" data-text="293">Send Message</button>
            </form>
        </div>
    </div>

    <!-- Shop Locations Section - 4 STATIC LOCATIONS FULLY EDITABLE -->
    <div class="shop-locations editable-section" data-section="869">
        <h2 class="editable-text editable-section no-drop-zone" data-section="870" data-text="294">Our Store Locations</h2>
        <p class="editable-text editable-section no-drop-zone" data-section="871" data-text="295">Visit us at any of our four locations across the country. Each store offers the full Nook & Nest experience.</p>
        <div class="locations-grid">
            <!-- Location 1 - Portland (FLAGSHIP) -->
            <div class="location-card editable-section no-drop-zone" data-section="872">
                <div class="location-image-container editable-section no-drop-zone" data-section="873">
                    <img src="{%static 'images/Ecom19/location2.jpg'%}" class="location-img editable-image" data-image="53">
                    <div class="location-badge editable-text editable-section no-drop-zone" data-section="874" data-text="296">FLAGSHIP</div>
                </div>
                <div class="location-info editable-section no-drop-zone" data-section="875">
                    <h3 class="location-name editable-text editable-section no-drop-zone" data-section="876" data-text="297">Portland</h3>
                    <p class="location-address editable-text editable-section no-drop-zone" data-section="877" data-text="298">123 Playful Lane<br>Portland, OR 97201</p>
                    <p class="location-phone editable-text editable-section no-drop-zone" data-section="878" data-text="299"><i class="fas fa-phone"></i> (555) 123-4567</p>
                    <p class="location-hours editable-text editable-section no-drop-zone" data-section="879" data-text="300"><i class="far fa-clock"></i> Mon-Sat: 9AM-7PM, Sun: 10AM-5PM</p>
                    <a href="#" class="location-direction editable-text editable-section no-drop-zone" data-section="880" data-text="301">Get Directions <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <!-- Location 2 - Seattle -->
            <div class="location-card editable-section no-drop-zone" data-section="881">
                <div class="location-image-container editable-section no-drop-zone" data-section="882">
                    <img src="{%static 'images/Ecom19/location3.jpg'%}" alt="Seattle Store" class="location-img editable-image" data-image="54">
                </div>
                <div class="location-info editable-section no-drop-zone" data-section="883">
                    <h3 class="location-name editable-text editable-section no-drop-zone" data-section="884" data-text="302">Seattle</h3>
                    <p class="location-address editable-text editable-section no-drop-zone" data-section="885" data-text="303">456 Pike Street<br>Seattle, WA 98101</p>
                    <p class="location-phone editable-text editable-section no-drop-zone" data-section="886" data-text="304"><i class="fas fa-phone"></i> (555) 234-5678</p>
                    <p class="location-hours editable-text editable-section no-drop-zone" data-section="887" data-text="305"><i class="far fa-clock"></i> Mon-Sat: 10AM-8PM, Sun: 11AM-6PM</p>
                    <a href="#" class="location-direction editable-text editable-section no-drop-zone" data-section="888" data-text="306">Get Directions <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <!-- Location 3 - San Francisco (POP-UP) -->
            <div class="location-card editable-section no-drop-zone" data-section="889">
                <div class="location-image-container editable-section no-drop-zone" data-section="900">
                    <img src="{%static 'images/Ecom19/location1.jpg'%}" alt="San Francisco Store" class="location-img editable-image" data-image="55">
                    <div class="location-badge sale editable-text editable-section no-drop-zone" data-section="901" data-text="307">POP-UP</div>
                </div>
                <div class="location-info editable-section no-drop-zone" data-section="902">
                    <h3 class="location-name editable-text editable-section no-drop-zone" data-section="903" data-text="308">San Francisco</h3>
                    <p class="location-address editable-text editable-section no-drop-zone" data-section="904" data-text="309">789 Market Street<br>San Francisco, CA 94103</p>
                    <p class="location-phone editable-text editable-section no-drop-zone" data-section="905" data-text="310"><i class="fas fa-phone"></i> (555) 345-6789</p>
                    <p class="location-hours editable-text editable-section no-drop-zone" data-section="906" data-text="311"><i class="far fa-clock"></i> Daily: 10AM-9PM</p>
                    <a href="#" class="location-direction editable-text editable-section no-drop-zone" data-section="907" data-text="312">Get Directions <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <!-- Location 4 - New York -->
            <div class="location-card editable-section no-drop-zone" data-section="908">
                <div class="location-image-container editable-section no-drop-zone" data-section="909">
                    <img src="{%static 'images/Ecom19/location4.jpg'%}" alt="New York Store" class="location-img editable-image" data-image="56">
                </div>
                <div class="location-info editable-section no-drop-zone" data-section="910">
                    <h3 class="location-name editable-text editable-section no-drop-zone" data-section="911" data-text="313">New York</h3>
                    <p class="location-address editable-text editable-section no-drop-zone" data-section="912" data-text="314">1010 Broadway<br>New York, NY 10001</p>
                    <p class="location-phone editable-text editable-section no-drop-zone" data-section="913" data-text="315"><i class="fas fa-phone"></i> (555) 456-7890</p>
                    <p class="location-hours editable-text editable-section no-drop-zone" data-section="914" data-text="316"><i class="far fa-clock"></i> Mon-Fri: 10AM-8PM, Sat-Sun: 11AM-7PM</p>
                    <a href="#" class="location-direction editable-text editable-section no-drop-zone" data-section="915" data-text="317">Get Directions <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- FAQ Section - 5 EDITABLE QUESTIONS -->
    <div class="faq-section editable-section" data-section="916">
        <h2 class="editable-text editable-section no-drop-zone" data-section="917" data-text="318">Frequently Asked Questions</h2>
        <div class="faq-container">
            <!-- FAQ 1 -->
            <div class="faq-item editable-section no-drop-zone" data-section="918">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="919" data-text="319">What are your shipping times?</span>
                    <i class="fas fa-plus faq-icon editable-icon" data-icon="32"></i>
                </button>
                <div class="faq-answer">
                    <p class="editable-text editable-section no-drop-zone" data-section="920" data-text="320">Free shipping on orders over $50. Orders ship within 1-2 business days and arrive in 3-7 business days.</p>
                </div>
            </div>
            <!-- FAQ 2 -->
            <div class="faq-item editable-section no-drop-zone" data-section="921">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="922" data-text="321">What is your return policy?</span>
                    <i class="fas fa-plus faq-icon editable-icon" data-icon="32"></i>
                </button>
                <div class="faq-answer">
                    <p class="editable-text editable-section no-drop-zone" data-section="923" data-text="322">30-day satisfaction guarantee. Items must be in original condition with all packaging.</p>
                </div>
            </div>
            <!-- FAQ 3 -->
            <div class="faq-item editable-section no-drop-zone" data-section="924">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="925" data-text="323">Are your toys safe for children?</span>
                    <i class="fas fa-plus faq-icon editable-icon" data-icon="32"></i>
                </button>
                <div class="faq-answer">
                    <p class="editable-text editable-section no-drop-zone" data-section="926" data-text="324">Yes! All toys meet or exceed ASTM F963 safety standards with non-toxic finishes.</p>
                </div>
            </div>
            <!-- FAQ 4 -->
            <div class="faq-item editable-section no-drop-zone" data-section="927">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="928" data-text="325">Do you offer wholesale pricing?</span>
                    <i class="fas fa-plus faq-icon editable-icon" data-icon="32"></i>
                </button>
                <div class="faq-answer">
                    <p class="editable-text editable-section no-drop-zone" data-section="929" data-text="326">Yes! Contact wholesale@nookandnest.com for catalog and pricing.</p>
                </div>
            </div>
            <!-- FAQ 5 -->
            <div class="faq-item editable-section no-drop-zone" data-section="930">
                <button class="faq-question">
                    <span class="editable-text editable-section no-drop-zone" data-section="931" data-text="327">Do you offer gift wrapping?</span>
                    <i class="fas fa-plus faq-icon editable-icon" data-icon="32"></i>
                </button>
                <div class="faq-answer">
                    <p class="editable-text editable-section no-drop-zone" data-section="932" data-text="328">Yes! Select gift wrap at checkout for premium wrapping and a personalized message.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Support - EDITABLE -->
    <div class="additional-support editable-section" data-section="933">
        <h2 class="editable-text editable-section no-drop-zone" data-section="934" data-text="329">Need Additional Help?</h2>
        <p class="editable-text editable-section no-drop-zone" data-section="935" data-text="330">Our customer service team is here to assist you with any questions or concerns.</p>
        <div class="support-links">
            <a href="?page=shipping" class="support-link editable-text" data-text="331"><i class="fas fa-truck"></i> Shipping Information</a>
            <a href="?page=returns" class="support-link editable-text" data-text="332"><i class="fas fa-exchange-alt"></i> Returns & Exchanges</a>
            <a href="?page=faq" class="support-link editable-text" data-text="333"><i class="fas fa-question-circle"></i> FAQ</a>
            <a href="?page=privacy" class="support-link editable-text" data-text="334"><i class="fas fa-shield-alt"></i> Privacy Policy</a>
        </div>
    </div>
</div>
</main>

