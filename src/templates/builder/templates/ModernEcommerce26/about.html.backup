<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>LUMIÈRE | About Us</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    :root {
      --bg-soft: #F2F7F6;
      --bg-warm: #F2E7E6;
      --accent-rose: #F388A2;
      --acleaf-moss: #7F805C;
      --accent-sand: #F2DDB3;
      --border-radius: 24px;
      --transition: all 0.3s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-soft);
      font-family: 'Inter', sans-serif;
      color: #1e2a2a;
      line-height: 1.5;
    }

    h1, h2, h3, h4 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Page Header */
    .about-header {
      padding: 7rem 0 2rem;
      text-align: center;
    }

    .about-header h1.editable-text.editable-section.no-drop-zone[data-section="170"] {
      font-size: 3rem;
      color: #2c3a2f;
      margin-bottom: 0.5rem;
    }

    .about-header p.editable-text.editable-section.no-drop-zone[data-section="171"] {
      color: var(--acleaf-moss);
      font-size: 0.9rem;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Hero Section */
    .about-hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      margin-bottom: 4rem;
      align-items: center;
    }

    .hero-image {
      width: 100%;
      border-radius: var(--border-radius);
      overflow: hidden;
    }

    .hero-image img {
      width: 100%;
      height: auto;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .hero-image:hover img {
      transform: scale(1.02);
    }

    .hero-content h2.editable-text.editable-section.no-drop-zone[data-section="172"] {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: #2c3a2f;
    }

    .hero-content p.editable-text.editable-section.no-drop-zone[data-section="173"] {
      color: #5b6e55;
      margin-bottom: 1rem;
      line-height: 1.7;
    }

    .quote-text.editable-text.editable-section.no-drop-zone[data-section="174"] {
      font-size: 1.2rem;
      font-style: italic;
      color: var(--accent-rose);
      border-left: 3px solid var(--accent-rose);
      padding-left: 1.2rem;
      margin-top: 1.5rem;
    }

    /* Mission & Values Section */
    .mission-values {
      background: white;
      border-radius: var(--border-radius);
      padding: 3rem;
      margin-bottom: 4rem;
      text-align: center;
    }

    .mission-values h2.editable-text.editable-section.no-drop-zone[data-section="175"] {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: #2c3a2f;
    }

    .mission-values p.editable-text.editable-section.no-drop-zone[data-section="176"] {
      color: #5b6e55;
      max-width: 800px;
      margin: 0 auto 2rem;
      line-height: 1.7;
    }

    .values-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-top: 2rem;
    }

    .value-card {
      text-align: center;
      padding: 1.5rem;
    }

    .value-icon {
      width: 70px;
      height: 70px;
      background: var(--bg-warm);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      color: var(--accent-rose);
      font-size: 1.8rem;
    }

    .value-card h3.editable-text.editable-section.no-drop-zone[data-section="177"] {
      font-size: 1.3rem;
      margin-bottom: 0.5rem;
      color: #2c3a2f;
    }

    .value-card p.editable-text.editable-section.no-drop-zone[data-section="178"] {
      color: #5b6e55;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* Craftsmanship Section */
    .craftsmanship {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      margin-bottom: 4rem;
      align-items: center;
    }

    .craftsmanship-image {
      width: 100%;
      border-radius: var(--border-radius);
      overflow: hidden;
    }

    .craftsmanship-image img {
      width: 100%;
      height: auto;
      object-fit: cover;
    }

    .craftsmanship-content h2.editable-text.editable-section.no-drop-zone[data-section="179"] {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: #2c3a2f;
    }

    .craftsmanship-content p.editable-text.editable-section.no-drop-zone[data-section="180"] {
      color: #5b6e55;
      margin-bottom: 1rem;
      line-height: 1.7;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .stat-item {
      text-align: center;
      padding: 1rem;
      background: var(--bg-warm);
      border-radius: var(--border-radius);
    }

    .stat-number.editable-text.editable-section.no-drop-zone[data-section="181"] {
      font-size: 1.8rem;
      font-weight: 600;
      color: var(--accent-rose);
    }

    .stat-label.editable-text.editable-section.no-drop-zone[data-section="182"] {
      font-size: 0.8rem;
      color: var(--acleaf-moss);
    }

    /* Team Section */
    .team-section {
      margin-bottom: 4rem;
      text-align: center;
    }

    .team-section h2.editable-text.editable-section.no-drop-zone[data-section="183"] {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      color: #2c3a2f;
    }

    .team-section p.editable-text.editable-section.no-drop-zone[data-section="184"] {
      color: var(--acleaf-moss);
      margin-bottom: 2rem;
    }

    .team-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .team-card {
      background: white;
      border-radius: var(--border-radius);
      overflow: hidden;
      transition: var(--transition);
      text-align: center;
    }

    .team-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
    }

    .team-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }

    .team-info {
      padding: 1.2rem;
    }

    .team-name.editable-text.editable-section.no-drop-zone[data-section="185"] {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.3rem;
      color: #2c3a2f;
    }

    .team-role.editable-text.editable-section.no-drop-zone[data-section="186"] {
      font-size: 0.8rem;
      color: var(--accent-rose);
      margin-bottom: 0.5rem;
    }

    .team-bio.editable-text.editable-section.no-drop-zone[data-section="187"] {
      font-size: 0.8rem;
      color: #5b6e55;
      line-height: 1.5;
    }

    /* Timeline Section */
    .timeline-section {
      margin-bottom: 4rem;
      text-align: center;
    }

    .timeline-section h2.editable-text.editable-section.no-drop-zone[data-section="188"] {
      font-size: 2rem;
      margin-bottom: 2rem;
      color: #2c3a2f;
    }

    .timeline {
      position: relative;
      max-width: 800px;
      margin: 0 auto;
    }

    .timeline::before {
      content: '';
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 2px;
      height: 100%;
      background: var(--accent-rose);
    }

    .timeline-item {
      position: relative;
      margin-bottom: 2rem;
      width: 45%;
    }

    .timeline-item:nth-child(odd) {
      left: 0;
      text-align: right;
    }

    .timeline-item:nth-child(even) {
      left: 55%;
      text-align: left;
    }

    .timeline-dot {
      position: absolute;
      top: 0;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--accent-rose);
    }

    .timeline-item:nth-child(odd) .timeline-dot {
      right: -36px;
    }

    .timeline-item:nth-child(even) .timeline-dot {
      left: -36px;
    }

    .timeline-content {
      background: white;
      padding: 1.2rem;
      border-radius: var(--border-radius);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .timeline-year.editable-text.editable-section.no-drop-zone[data-section="189"] {
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--accent-rose);
      margin-bottom: 0.3rem;
    }

    .timeline-title.editable-text.editable-section.no-drop-zone[data-section="190"] {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #2c3a2f;
    }

    .timeline-desc.editable-text.editable-section.no-drop-zone[data-section="191"] {
      font-size: 0.85rem;
      color: #5b6e55;
      line-height: 1.5;
    }

    /* Commitment Section */
    .commitment {
      background: linear-gradient(135deg, var(--accent-rose), #d47a96);
      color: white;
      border-radius: var(--border-radius);
      padding: 3rem;
      text-align: center;
      margin-bottom: 4rem;
    }

    .commitment h2.editable-text.editable-section.no-drop-zone[data-section="192"] {
      font-size: 2rem;
      margin-bottom: 1rem;
      color: white;
    }

    .commitment p.editable-text.editable-section.no-drop-zone[data-section="193"] {
      max-width: 700px;
      margin: 0 auto 2rem;
      opacity: 0.95;
    }

    .commitment-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .commitment-stat {
      text-align: center;
    }

    .commitment-number.editable-text.editable-section.no-drop-zone[data-section="194"] {
      font-size: 2rem;
      font-weight: 600;
    }

    .commitment-label.editable-text.editable-section.no-drop-zone[data-section="195"] {
      font-size: 0.8rem;
      opacity: 0.9;
    }

    /* Responsive */
    @media (max-width: 992px) {
      .about-hero, .craftsmanship {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      .hero-image, .craftsmanship-image {
        order: -1;
      }
      .values-grid, .team-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .commitment-stats {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 1.5rem;
      }
      .about-header {
        padding: 6rem 0 1.5rem;
      }
      .about-header h1 {
        font-size: 2.2rem;
      }
      .values-grid, .team-grid {
        grid-template-columns: 1fr;
        max-width: 350px;
        margin: 0 auto;
      }
      .timeline::before {
        left: 20px;
      }
      .timeline-item {
        width: calc(100% - 40px);
        left: 40px !important;
        text-align: left !important;
      }
      .timeline-item .timeline-dot {
        left: -28px !important;
        right: auto !important;
      }
      .commitment-stats {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
    }
  </style>
</head>
<body>

<div class="container">
  <!-- About Header -->
  <div class="about-header">
    <h1 class="editable-text editable-section no-drop-zone" data-section="170" data-text="140">Our Story</h1>
    <p class="editable-text editable-section no-drop-zone" data-section="171" data-text="141">Crafting timeless jewelry with passion and precision since 2010</p>
  </div>

  <!-- Hero Section -->
  <div class="about-hero editable-section" data-section="172">
    <div class="hero-image">
      <img class="editable-image" data-image="70" src="https://images.pexels.com/photos/1443997/pexels-photo-1443997.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Jewelry craftsmanship">
    </div>
    <div class="hero-content">
      <h2 class="editable-text editable-section no-drop-zone" data-section="173" data-text="142">A Legacy of Excellence</h2>
      <p class="editable-text editable-section no-drop-zone" data-section="174" data-text="143">Founded in 2010 by master jeweler Isabella Rossi, LUMIÈRE began as a small atelier dedicated to the art of fine jewelry making. Isabella's vision was simple yet profound: to create pieces that would transcend generations, becoming family heirlooms that tell stories of love, celebration, and legacy.</p>
      <p class="editable-text editable-section no-drop-zone" data-section="175" data-text="144">Today, guided by Isabella's daughter Elena, we continue this tradition of excellence from our New York atelier, blending century-old techniques with contemporary design.</p>
      <p class="quote-text editable-text editable-section no-drop-zone" data-section="176" data-text="145">"Jewelry is not just adornment; it is a story waiting to be told, a memory waiting to be cherished." - Isabella Rossi</p>
    </div>
  </div>

  <!-- Mission & Values Section -->
  <div class="mission-values editable-section" data-section="177">
    <h2 class="editable-text editable-section no-drop-zone" data-section="178" data-text="146">Our Philosophy</h2>
    <p class="editable-text editable-section no-drop-zone" data-section="179" data-text="147">We believe that fine jewelry should be accessible, sustainable, and meaningful. Every piece we create carries the same dedication to quality and artistry.</p>
    <div class="values-grid">
      <div class="value-card editable-section no-drop-zone" data-section="180">
        <div class="value-icon">
          <i class="fas fa-gem editable-icon" data-icon="40" data-default-class="fas fa-gem"></i>
        </div>
        <h3 class="editable-text editable-section no-drop-zone" data-section="181" data-text="148">Uncompromising Quality</h3>
        <p class="editable-text editable-section no-drop-zone" data-section="182" data-text="149">We source only the finest ethically-mined gemstones and precious metals, with each piece undergoing 47 quality checks before it leaves our atelier.</p>
      </div>
      <div class="value-card editable-section no-drop-zone" data-section="183">
        <div class="value-icon">
          <i class="fas fa-hands editable-icon" data-icon="41" data-default-class="fas fa-hands"></i>
        </div>
        <h3 class="editable-text editable-section no-drop-zone" data-section="184" data-text="150">Artisan Craftsmanship</h3>
        <p class="editable-text editable-section no-drop-zone" data-section="185" data-text="151">Every piece is handcrafted by master jewelers using techniques passed down through generations, ensuring unparalleled attention to detail.</p>
      </div>
      <div class="value-card editable-section no-drop-zone" data-section="186">
        <div class="value-icon">
          <i class="fas fa-heart editable-icon" data-icon="42" data-default-class="fas fa-heart"></i>
        </div>
        <h3 class="editable-text editable-section no-drop-zone" data-section="187" data-text="152">Personal Connection</h3>
        <p class="editable-text editable-section no-drop-zone" data-section="188" data-text="153">We believe jewelry should tell your unique story. Our designers work closely with clients to create pieces that reflect personal style and significance.</p>
      </div>
    </div>
  </div>

  <!-- Craftsmanship Section -->
  <div class="craftsmanship editable-section" data-section="189">
    <div class="craftsmanship-content">
      <h2 class="editable-text editable-section no-drop-zone" data-section="190" data-text="154">The Art of Craftsmanship</h2>
      <p class="editable-text editable-section no-drop-zone" data-section="191" data-text="155">Each LUMIÈRE piece begins with a vision, translated into precise hand-drawn sketches by our design team. From these drawings, our master jewelers select the finest materials and begin the meticulous process of creation.</p>
      <p class="editable-text editable-section no-drop-zone" data-section="192" data-text="156">Our signature setting technique allows diamonds and gemstones to capture maximum light while ensuring exceptional security. This proprietary method takes three times longer than standard settings but results in unparalleled brilliance.</p>
      <div class="stats-grid">
        <div class="stat-item editable-section no-drop-zone" data-section="193">
          <div class="stat-number editable-text editable-section no-drop-zone" data-section="194" data-text="157">47</div>
          <div class="stat-label editable-text editable-section no-drop-zone" data-section="195" data-text="158">Quality Checks</div>
        </div>
        <div class="stat-item editable-section no-drop-zone" data-section="196">
          <div class="stat-number editable-text editable-section no-drop-zone" data-section="197" data-text="159">120+</div>
          <div class="stat-label editable-text editable-section no-drop-zone" data-section="198" data-text="160">Hours per Piece</div>
        </div>
        <div class="stat-item editable-section no-drop-zone" data-section="199">
          <div class="stat-number editable-text editable-section no-drop-zone" data-section="200" data-text="161">100%</div>
          <div class="stat-label editable-text editable-section no-drop-zone" data-section="201" data-text="162">Ethically Sourced</div>
        </div>
      </div>
    </div>
    <div class="craftsmanship-image">
      <img class="editable-image" data-image="71" src="https://images.pexels.com/photos/5100749/pexels-photo-5100749.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Craftsmanship process">
    </div>
  </div>

  <!-- Team Section -->
  <div class="team-section editable-section" data-section="202">
    <h2 class="editable-text editable-section no-drop-zone" data-section="203" data-text="163">Meet Our Master Artisans</h2>
    <p class="editable-text editable-section no-drop-zone" data-section="204" data-text="164">The talented individuals behind every exquisite piece</p>
    <div class="team-grid">
      <div class="team-card editable-section no-drop-zone" data-section="205">
        <img class="team-img editable-image" data-image="72" src="https://images.pexels.com/photos/1560259/pexels-photo-1560259.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team member">
        <div class="team-info">
          <div class="team-name editable-text editable-section no-drop-zone" data-section="206" data-text="165">Isabella Rossi</div>
          <div class="team-role editable-text editable-section no-drop-zone" data-section="207" data-text="166">Founder & Creative Director</div>
          <div class="team-bio editable-text editable-section no-drop-zone" data-section="208" data-text="167">With over 30 years of experience, Isabella brings her passion for artistry and innovation to every collection.</div>
        </div>
      </div>
      <div class="team-card editable-section no-drop-zone" data-section="209">
        <img class="team-img editable-image" data-image="73" src="https://images.pexels.com/photos/1542085/pexels-photo-1542085.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team member">
        <div class="team-info">
          <div class="team-name editable-text editable-section no-drop-zone" data-section="210" data-text="168">Elena Rossi</div>
          <div class="team-role editable-text editable-section no-drop-zone" data-section="211" data-text="169">CEO & Lead Designer</div>
          <div class="team-bio editable-text editable-section no-drop-zone" data-section="212" data-text="170">Carrying forward her mother's legacy, Elena combines traditional techniques with modern aesthetics.</div>
        </div>
      </div>
      <div class="team-card editable-section no-drop-zone" data-section="213">
        <img class="team-img editable-image" data-image="74" src="https://images.pexels.com/photos/2182970/pexels-photo-2182970.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team member">
        <div class="team-info">
          <div class="team-name editable-text editable-section no-drop-zone" data-section="214" data-text="171">Marcus Chen</div>
          <div class="team-role editable-text editable-section no-drop-zone" data-section="215" data-text="172">Master Goldsmith</div>
          <div class="team-bio editable-text editable-section no-drop-zone" data-section="216" data-text="173">With 25 years of experience, Marcus specializes in intricate metalwork and stone setting.</div>
        </div>
      </div>
      <div class="team-card editable-section no-drop-zone" data-section="217">
        <img class="team-img editable-image" data-image="75" src="https://images.pexels.com/photos/1516680/pexels-photo-1516680.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team member">
        <div class="team-info">
          <div class="team-name editable-text editable-section no-drop-zone" data-section="218" data-text="174">Sophie Laurent</div>
          <div class="team-role editable-text editable-section no-drop-zone" data-section="219" data-text="175">Gemologist</div>
          <div class="team-bio editable-text editable-section no-drop-zone" data-section="220" data-text="176">GIA-certified gemologist ensuring every stone meets our rigorous quality and ethical standards.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Timeline Section -->
  <div class="timeline-section editable-section" data-section="221">
    <h2 class="editable-text editable-section no-drop-zone" data-section="222" data-text="177">Our Journey</h2>
    <div class="timeline">
      <div class="timeline-item editable-section no-drop-zone" data-section="223">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year editable-text editable-section no-drop-zone" data-section="224" data-text="178">2010</div>
          <div class="timeline-title editable-text editable-section no-drop-zone" data-section="225" data-text="179">The Beginning</div>
          <div class="timeline-desc editable-text editable-section no-drop-zone" data-section="226" data-text="180">Isabella Rossi opens LUMIÈRE in a small atelier in Florence, Italy, specializing in bespoke engagement rings.</div>
        </div>
      </div>
      <div class="timeline-item editable-section no-drop-zone" data-section="227">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year editable-text editable-section no-drop-zone" data-section="228" data-text="181">2015</div>
          <div class="timeline-title editable-text editable-section no-drop-zone" data-section="229" data-text="182">Expansion to New York</div>
          <div class="timeline-desc editable-text editable-section no-drop-zone" data-section="230" data-text="183">LUMIÈRE opens its first flagship boutique on Fifth Avenue, bringing Italian craftsmanship to New York.</div>
        </div>
      </div>
      <div class="timeline-item editable-section no-drop-zone" data-section="231">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year editable-text editable-section no-drop-zone" data-section="232" data-text="184">2018</div>
          <div class="timeline-title editable-text editable-section no-drop-zone" data-section="233" data-text="185">Sustainable Commitment</div>
          <div class="timeline-desc editable-text editable-section no-drop-zone" data-section="234" data-text="186">Pioneers ethical sourcing initiatives, becoming one of the first jewelry houses to use 100% recycled gold.</div>
        </div>
      </div>
      <div class="timeline-item editable-section no-drop-zone" data-section="235">
        <div class="timeline-dot"></div>
        <div class="timeline-content">
          <div class="timeline-year editable-text editable-section no-drop-zone" data-section="236" data-text="187">2023</div>
          <div class="timeline-title editable-text editable-section no-drop-zone" data-section="237" data-text="188">Global Recognition</div>
          <div class="timeline-desc editable-text editable-section no-drop-zone" data-section="238" data-text="189">Named one of the world's most innovative jewelry brands, with boutiques in London, Paris, and Tokyo.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Commitment Section -->
  <div class="commitment editable-section" data-section="239">
    <h2 class="editable-text editable-section no-drop-zone" data-section="240" data-text="190">Our Commitment to Excellence</h2>
    <p class="editable-text editable-section no-drop-zone" data-section="241" data-text="191">For over a decade, our commitment has remained unwavering: to create jewelry that not only dazzles today but becomes tomorrow's heirlooms. Every piece we create carries this legacy forward.</p>
    <div class="commitment-stats">
      <div class="commitment-stat editable-section no-drop-zone" data-section="242">
        <div class="commitment-number editable-text editable-section no-drop-zone" data-section="243" data-text="192">15+</div>
        <div class="commitment-label editable-text editable-section no-drop-zone" data-section="244" data-text="193">Years of Excellence</div>
      </div>
      <div class="commitment-stat editable-section no-drop-zone" data-section="245">
        <div class="commitment-number editable-text editable-section no-drop-zone" data-section="246" data-text="194">10K+</div>
        <div class="commitment-label editable-text editable-section no-drop-zone" data-section="247" data-text="195">Happy Clients</div>
      </div>
      <div class="commitment-stat editable-section no-drop-zone" data-section="248">
        <div class="commitment-number editable-text editable-section no-drop-zone" data-section="249" data-text="196">100%</div>
        <div class="commitment-label editable-text editable-section no-drop-zone" data-section="250" data-text="197">Ethically Sourced</div>
      </div>
      <div class="commitment-stat editable-section no-drop-zone" data-section="251">
        <div class="commitment-number editable-text editable-section no-drop-zone" data-section="252" data-text="198">47</div>
        <div class="commitment-label editable-text editable-section no-drop-zone" data-section="253" data-text="199">Quality Checks</div>
      </div>
    </div>
  </div>
</div>

<script>
  // Animation on scroll for timeline items
  const timelineItems = document.querySelectorAll('.timeline-item');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateX(0)';
      }
    });
  }, { threshold: 0.2 });
  
  timelineItems.forEach((item, index) => {
    item.style.opacity = '0';
    if (index % 2 === 0) {
      item.style.transform = 'translateX(-30px)';
    } else {
      item.style.transform = 'translateX(30px)';
    }
    item.style.transition = `opacity 0.5s ease, transform 0.5s ease`;
    observer.observe(item);
  });
  
  // Team card hover effect
  const teamCards = document.querySelectorAll('.team-card');
  teamCards.forEach(card => {
    card.addEventListener('mouseenter', () => {
      const img = card.querySelector('.team-img');
      if (img) img.style.transform = 'scale(1.05)';
    });
    card.addEventListener('mouseleave', () => {
      const img = card.querySelector('.team-img');
      if (img) img.style.transform = 'scale(1)';
    });
  });
</script>
</body>
</html>