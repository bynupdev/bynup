<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>LUMIÈRE | Timeless Fine Jewelry</title>
  <!-- Google Fonts: refined, modern serif + neutral sans -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <!-- Font Awesome 6 (free icons) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ---------- STRICT COLOR SYSTEM :root ---------- */
    :root {
      --bg-soft: #F2F7F6;      /* primary background */
      --bg-warm: #F2E7E6;       /* subtle accents, hero overlay */
      --accent-rose: #F388A2;   /* refined CTAs, highlights */
      --acleaf-moss: #7F805C;   /* secondary text, borders, icons */
      --accent-sand: #F2DDB3;   /* soft glow, hover elements */
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-soft);
      font-family: 'Inter', sans-serif;
      color: #1e2a2a;
      line-height: 1.4;
      scroll-behavior: smooth;
    }

    /* typography hierarchy: luxury editorial */
    h1, h2, h3, .logo, .headline, .nav-link {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    h1 {
      font-size: 3.8rem;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: -0.02em;
      color: #2c3a2f;
    }

    h2 {
      font-size: 2.2rem;
      font-weight: 500;
      letter-spacing: -0.01em;
      color: #3e4d3c;
      border-left: 3px solid var(--accent-rose);
      padding-left: 1rem;
      margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
      h1 { font-size: 2.5rem; }
      h2 { font-size: 1.8rem; }
    }

    /* header / nav sticky */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(242, 247, 246, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(127, 128, 92, 0.2);
      padding: 1rem 2rem;
      transition: all 0.25s ease;
    }

    .nav-container {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.8rem;
      font-weight: 600;
      color: var(--acleaf-moss);
      letter-spacing: 1px;
      text-decoration: none;
    }

    .desktop-nav {
      display: flex;
      gap: 2.2rem;
      align-items: center;
    }

    .nav-item {
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      font-size: 0.9rem;
      text-decoration: none;
      color: #3a4a3c;
      transition: color 0.2s;
      letter-spacing: 0.3px;
      background: none;
      border: none;
      cursor: pointer;
    }

    .nav-item i {
      font-size: 1rem;
      margin-right: 4px;
      color: var(--acleaf-moss);
    }

    .nav-item:hover {
      color: var(--accent-rose);
    }

    /* account dropdown */
    .dropdown {
      position: relative;
      display: inline-block;
    }

    .dropdown-content {
      display: none;
      position: absolute;
      right: 0;
      background-color: white;
      min-width: 180px;
      box-shadow: 0 12px 28px rgba(0,0,0,0.05);
      border-radius: 12px;
      z-index: 10;
      padding: 0.6rem 0;
      border: 1px solid rgba(127,128,92,0.2);
    }

    .dropdown-content a {
      display: block;
      padding: 0.6rem 1.2rem;
      text-decoration: none;
      font-size: 0.85rem;
      color: #2c3a2f;
      font-family: 'Inter', sans-serif;
      transition: background 0.2s;
    }

    .dropdown-content a:hover {
      background-color: var(--bg-warm);
      color: var(--accent-rose);
    }

    .dropdown:hover .dropdown-content {
      display: block;
    }

    /* mobile hamburger */
    .menu-toggle {
      display: none;
      background: none;
      border: none;
      font-size: 1.6rem;
      color: var(--acleaf-moss);
      cursor: pointer;
    }

    .mobile-menu {
      position: fixed;
      top: 0;
      left: -100%;
      width: 80%;
      max-width: 320px;
      height: 100%;
      background: var(--bg-soft);
      z-index: 200;
      box-shadow: 2px 0 30px rgba(0,0,0,0.08);
      transition: left 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .mobile-menu.open {
      left: 0;
    }

    .mobile-back {
      background: none;
      border: none;
      font-size: 1rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--acleaf-moss);
      margin-bottom: 1rem;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
    }

    .mobile-nav-link {
      text-decoration: none;
      font-size: 1.2rem;
      padding: 0.5rem 0;
      color: #2c3a2f;
      font-weight: 500;
      border-bottom: 1px solid rgba(127,128,92,0.2);
    }

    .mobile-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.2);
      backdrop-filter: blur(4px);
      z-index: 150;
      display: none;
    }

    /* hero section */
    .hero {
      position: relative;
      min-height: 85vh;
      display: flex;
      align-items: center;
      background: var(--bg-soft);
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 30%;
      filter: brightness(0.98) contrast(1.02);
    }

    /* soft gradient overlay to blend seamlessly */
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(242,247,246,0.8) 0%, rgba(242,231,230,0.4) 70%);
      z-index: 1;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 620px;
      padding: 2rem;
      margin-left: 6%;
      background: rgba(242, 247, 246, 0.5);
      backdrop-filter: blur(2px);
      border-radius: 24px;
    }

    .hero-content .headline {
      font-size: 3.5rem;
      margin-bottom: 1rem;
      color: #2c3a2f;
    }

    .hero-sub {
      font-size: 1rem;
      font-weight: 400;
      line-height: 1.5;
      color: #4a5a48;
      margin-bottom: 2rem;
      max-width: 460px;
    }

    .primary-action {
      background-color: var(--accent-rose);
      border: none;
      padding: 0.9rem 2.4rem;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      font-size: 0.9rem;
      letter-spacing: 1px;
      color: white;
      border-radius: 40px;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(243,136,162,0.2);
    }

    .primary-action:hover {
      background-color: #e27a97;
      transform: translateY(-2px);
      box-shadow: 0 12px 20px rgba(243,136,162,0.3);
    }

    /* new arrivals section */
    .arrivals-section {
      max-width: 1280px;
      margin: 5rem auto;
      padding: 0 2rem;
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      margin-top: 1rem;
    }

    .product-card {
      background: white;
      border-radius: 24px;
      overflow: hidden;
      transition: all 0.35s ease;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
    }

    .product-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
      background: #fffef7;
    }

    .product-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .product-card:hover .product-img {
      transform: scale(1.02);
    }

    .product-info {
      padding: 1.2rem 1rem 1.4rem;
      text-align: center;
    }

    .product-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 500;
      color: #3a4a3c;
      margin-bottom: 0.4rem;
    }

    .product-price {
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 400;
      color: var(--accent-rose);
      letter-spacing: 0.5px;
    }

    .see-more-wrapper {
      text-align: center;
      margin-top: 3rem;
    }

    .cta-link {
      display: inline-block;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      text-decoration: none;
      color: var(--acleaf-moss);
      border-bottom: 1.5px solid var(--accent-sand);
      padding-bottom: 4px;
      transition: all 0.2s;
      font-size: 0.9rem;
    }

    .cta-link:hover {
      color: var(--accent-rose);
      border-bottom-color: var(--accent-rose);
    }

    /* footer */
    .footer {
      background-color: #f6f3ef;
      margin-top: 5rem;
      padding: 3rem 2rem 2rem;
      border-top: 1px solid rgba(127,128,92,0.2);
    }

    .footer-grid {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 2rem;
    }

    .footer-col h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--acleaf-moss);
      margin-bottom: 1rem;
    }

    .footer-col a {
      display: block;
      text-decoration: none;
      color: #5b6e55;
      font-size: 0.85rem;
      margin-bottom: 0.6rem;
      transition: color 0.2s;
    }

    .footer-col a:hover {
      color: var(--accent-rose);
    }

    .social-icons {
      display: flex;
      gap: 1.2rem;
      margin-top: 0.5rem;
    }

    .social-icons a {
      font-size: 1.2rem;
      color: var(--acleaf-moss);
    }

    .copyright {
      text-align: center;
      margin-top: 3rem;
      font-size: 0.7rem;
      color: #8c9a82;
    }

    /* responsiveness */
    @media (max-width: 1024px) {
      .product-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }
      .hero-content {
        margin-left: 4%;
        max-width: 550px;
      }
    }

    @media (max-width: 768px) {
      .desktop-nav {
        display: none;
      }
      .menu-toggle {
        display: block;
      }
      .site-header {
        padding: 0.9rem 1.2rem;
      }
      .hero {
        min-height: 70vh;
      }
      .hero-content {
        margin: 0 auto;
        text-align: center;
        background: rgba(242,247,246,0.75);
        backdrop-filter: blur(6px);
        width: 90%;
      }
      .hero-sub {
        margin-left: auto;
        margin-right: auto;
      }
      .product-grid {
        grid-template-columns: 1fr;
      }
      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 480px) {
      .footer-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .social-icons {
        justify-content: center;
      }
    }

    button, a {
      cursor: pointer;
    }

    img {
      display: block;
    }
  </style>
</head>
<body>

<header class="site-header editable-section no-drop-zone" data-section="1">
  <div class="nav-container">
    <a href="?page=home" class="logo editable-text editable-section no-drop-zone" data-section="2" data-text="1">LUMIÈRE</a>
    
    <!-- Desktop navigation -->
    <div class="desktop-nav">
      <a href="?page=home" class="nav-item editable-text editable-section no-drop-zone" data-section="3" data-text="2">Home</a>
      <a href="?page=shop" class="nav-item editable-text editable-section no-drop-zone" data-section="4" data-text="3">Shop</a>
      <a href="?page=about" class="nav-item editable-text editable-section no-drop-zone" data-section="5" data-text="4">About Us</a>
      <a href="?page=contact" class="nav-item editable-text editable-section no-drop-zone" data-section="6" data-text="5">Contact</a>
      <a href="?page=cart" class="nav-item"><i class="fas fa-shopping-bag editable-icon" data-icon="1" data-default-class="fas fa-shopping-bag"></i> Cart</a>
      <a href="?page=wishlist" class="nav-item"><i class="far fa-heart editable-icon" data-icon="2" data-default-class="far fa-heart"></i> Wishlist</a>
      <div class="dropdown">
        <button class="nav-item" style="background: none;"><i class="far fa-user editable-icon" data-icon="3" data-default-class="far fa-user"></i> Account</button>
        <div class="dropdown-content">
          <a href="?page=login" class="editable-section editable-text no-drop-zone" data-section="7" data-text="6">Sign In</a>
          <a href="?page=register" class="editable-section editable-text no-drop-zone" data-section="8" data-text="7">Sign Up</a>
          <a href="?page=orders" class="editable-section editable-text no-drop-zone" data-section="9" data-text="8">Orders</a>
          <a href="?page=wishlist" class="editable-section editable-text no-drop-zone" data-section="10" data-text="9">Wishlist</a>
          <a href="?page=account" class="editable-section editable-text no-drop-zone" data-section="11" data-text="10">Account Settings</a>
        </div>
      </div>
    </div>
    
    <button class="menu-toggle" id="menuToggle" aria-label="Menu"><i class="fas fa-bars editable-icon" data-icon="4" data-default-class="fas fa-bars"></i></button>
  </div>
</header>

<!-- Mobile Navigation Panel (Slide-in) -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-menu" id="mobileMenu">
  <button class="mobile-back" id="mobileBackBtn"><i class="fas fa-arrow-left"></i> Back</button>
  <a href="?page=home" class="mobile-nav-link">Home</a>
  <a href="?page=shop" class="mobile-nav-link">Shop</a>
  <a href="?page=about" class="mobile-nav-link">About Us</a>
  <a href="?page=contact" class="mobile-nav-link">Contact</a>
  <a href="?page=cart" class="mobile-nav-link"><i class="fas fa-shopping-bag"></i> Cart</a>
  <a href="?page=wishlist" class="mobile-nav-link"><i class="far fa-heart"></i> Wishlist</a>
  <div style="margin-top: 0.8rem; border-top: 1px solid rgba(127,128,92,0.2); padding-top: 0.8rem;">
    <a href="?page=login" class="mobile-nav-link">Sign In</a>
    <a href="?page=register" class="mobile-nav-link">Sign Up</a>
    <a href="?page=orders" class="mobile-nav-link">Orders</a>
    <a href="?page=account" class="mobile-nav-link">Account Settings</a>
  </div>
</div>

<main>
  <!-- Hero Section (editorial jewelry focus) -->
  <section class="hero editable-section" data-section="12">
    <div class="hero-bg">
      <!-- Real high-res editorial image: model wearing gold necklace + earrings (luxury focus) -->
      <img class="editable-image" data-image="1" src="https://images.pexels.com/photos/1443997/pexels-photo-1443997.jpeg?auto=compress&cs=tinysrgb&w=1600" 
           alt="Elegant model wearing fine gold necklace and earrings"
           style="object-position: 30% 20%;">
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1 class="headline editable-text editable-section no-drop-zone" data-section="13" data-text="11">Timeless Elegance,<br>Crafted to Shine</h1>
      <p class="hero-sub editable-text editable-section no-drop-zone" data-section="14" data-text="12">Discover fine jewelry designed to celebrate beauty, precision, and lasting impressions.</p>
      <a href="?page=shop" class="primary-action editable-text editable-section no-drop-zone" data-section="15" data-text="13">Explore Collection</a>
    </div>
  </section>

  <!-- New Arrivals Section (max 4 products) -->
  <section class="arrivals-section editable-section" data-section="16">
    <h2 class="editable-text editable-section no-drop-zone" data-section="17" data-text="14">New Arrivals</h2>
    <div class="product-grid">
      <!-- product 1: Gold pendant necklace - Editable -->
      <div class="product-card editable-section no-drop-zone" data-section="18">
        <img class="product-img editable-image" data-image="2" src="https://images.pexels.com/photos/2079656/pexels-photo-2079656.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Gold pendant necklace">
        <div class="product-info">
          <div class="product-name editable-section editable-text no-drop-zone" data-section="19" data-text="15">Gold Pendant Necklace</div>
          <div class="product-price editable-section editable-text no-drop-zone" data-section="20" data-text="16">$1,280</div>
        </div>
      </div>
      <!-- product 2: Diamond ring - Static Sample -->
      <div class="product-card">
        <img class="product-img" src="https://images.pexels.com/photos/948211/pexels-photo-948211.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Diamond ring">
        <div class="product-info">
          <div class="product-name">Diamond Ring</div>
          <div class="product-price">$3,950</div>
        </div>
      </div>
      <!-- product 3: Minimalist bracelet - Static Sample -->
      <div class="product-card">
        <img class="product-img" src="https://images.pexels.com/photos/1192798/pexels-photo-1192798.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Minimalist bracelet">
        <div class="product-info">
          <div class="product-name">Minimalist Bracelet</div>
          <div class="product-price">$890</div>
        </div>
      </div>
      <!-- product 4: Pearl earrings - Static Sample -->
      <div class="product-card">
        <img class="product-img" src="https://images.pexels.com/photos/2011703/pexels-photo-2011703.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Pearl earrings">
        <div class="product-info">
          <div class="product-name">Pearl Earrings</div>
          <div class="product-price">$1,450</div>
        </div>
      </div>
    </div>
    <div class="see-more-wrapper">
      <a href="?page=shop" class="cta-link editable-text editable-section no-drop-zone" data-section="21" data-text="17">See More →</a>
    </div>
  </section>
</main>

<footer class="footer editable-section" data-section="22">
  <div class="footer-grid">
    <div class="footer-col editable-section no-drop-zone" data-section="23">
      <h4 class="editable-text editable-section no-drop-zone" data-section="24" data-text="18">Quick Links</h4>
      <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="25" data-text="19">Home</a>
      <a href="?page=shop" class="editable-text editable-section no-drop-zone" data-section="26" data-text="20">Shop</a>
      <a href="?page=about" class="editable-text editable-section no-drop-zone" data-section="27" data-text="21">About Us</a>
      <a href="?page=contact" class="editable-text editable-section no-drop-zone" data-section="28" data-text="22">Contact</a>
    </div>
    <div class="footer-col editable-section no-drop-zone" data-section="29">
      <h4 class="editable-text editable-section no-drop-zone" data-section="30" data-text="23">Customer Support</h4>
      <a href="?page=help" class="editable-text editable-section no-drop-zone" data-section="31" data-text="24">Help Center</a>
      <a href="?page=shipping" class="editable-text editable-section no-drop-zone" data-section="32" data-text="25">Shipping Info</a>
      <a href="?page=returns" class="editable-text editable-section no-drop-zone" data-section="33" data-text="26">Returns</a>
    </div>
    <div class="footer-col editable-section no-drop-zone" data-section="34">
      <h4 class="editable-text editable-section no-drop-zone" data-section="35" data-text="27">Legal</h4>
      <a href="?page=privacy" class="editable-text editable-section no-drop-zone" data-section="36" data-text="28">Privacy Policy</a>
      <a href="?page=terms" class="editable-text editable-section no-drop-zone" data-section="37" data-text="29">Terms & Conditions</a>
    </div>
    <div class="footer-col editable-section no-drop-zone" data-section="38">
      <h4 class="editable-text editable-section no-drop-zone" data-section="39" data-text="30">Social</h4>
      <div class="social-icons">
        <a href="#" aria-label="Instagram" class="editable-icon" data-icon="5" data-default-class="fab fa-instagram"><i class="fab fa-instagram"></i></a>
        <a href="#" aria-label="Facebook" class="editable-icon" data-icon="6" data-default-class="fab fa-facebook-f"><i class="fab fa-facebook-f"></i></a>
        <a href="#" aria-label="Twitter" class="editable-icon" data-icon="7" data-default-class="fab fa-twitter"><i class="fab fa-twitter"></i></a>
      </div>
    </div>
  </div>
  <div class="copyright editable-section no-drop-zone" data-section="40">
    <p class="editable-text editable-section no-drop-zone" data-section="41" data-text="31">© 2025 LUMIÈRE — Timeless Craftsmanship</p>
  </div>
</footer>

<script>
  (function() {
    // Mobile navigation logic: hamburger, back button, overlay
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileOverlay = document.getElementById('mobileOverlay');
    const mobileBack = document.getElementById('mobileBackBtn');

    function openMenu() {
      mobileMenu.classList.add('open');
      mobileOverlay.style.display = 'block';
      document.body.style.overflow = 'hidden';
    }
    function closeMenu() {
      mobileMenu.classList.remove('open');
      mobileOverlay.style.display = 'none';
      document.body.style.overflow = '';
    }

    if (menuToggle) {
      menuToggle.addEventListener('click', openMenu);
    }
    if (mobileBack) {
      mobileBack.addEventListener('click', closeMenu);
    }
    if (mobileOverlay) {
      mobileOverlay.addEventListener('click', closeMenu);
    }

    // close on escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
        closeMenu();
      }
    });

    // optional: smooth dummy cta actions (non-functional but polished)
    const exploreBtn = document.querySelector('.primary-action');
    if (exploreBtn) {
      exploreBtn.addEventListener('click', () => {
        // subtle scroll to arrivals section, elegant UX
        document.querySelector('.arrivals-section')?.scrollIntoView({ behavior: 'smooth' });
      });
    }
    const seeMoreLink = document.querySelector('.cta-link');
    if (seeMoreLink) {
      seeMoreLink.addEventListener('click', (e) => {
        e.preventDefault();
        // shop page simulation (just scroll top)
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  })();
</script>
</body>
</html>