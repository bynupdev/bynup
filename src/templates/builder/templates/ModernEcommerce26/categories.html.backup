<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>LUMIÈRE | Jewelry Categories</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    :root {
      --bg-soft: #F2F7F6;
      --bg-warm: #F2E7E6;
      --accent-rose: #F388A2;
      --acleaf-moss: #7F805C;
      --accent-sand: #F2DDB3;
      --border-radius: 24px;
      --transition: all 0.3s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-soft);
      font-family: 'Inter', sans-serif;
      color: #1e2a2a;
      line-height: 1.5;
    }

    h1, h2, h3, h4 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    /* Page Header */
    .categories-header {
      padding: 7rem 0 2rem;
      text-align: center;
    }

    .categories-header h1.editable-text.editable-section.no-drop-zone[data-section="120"] {
      font-size: 3rem;
      color: #2c3a2f;
      margin-bottom: 0.5rem;
    }

    .categories-header p.editable-text.editable-section.no-drop-zone[data-section="121"] {
      color: var(--acleaf-moss);
      font-size: 0.9rem;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Categories Grid */
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .category-card {
      background: white;
      border-radius: var(--border-radius);
      overflow: hidden;
      transition: var(--transition);
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.02);
      cursor: pointer;
      text-decoration: none;
      display: block;
    }

    .category-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
    }

    .category-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .category-card:hover .category-img {
      transform: scale(1.03);
    }

    .category-info {
      padding: 1.2rem;
      text-align: center;
    }

    .category-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #2c3a2f;
      margin-bottom: 0.3rem;
    }

    .category-count {
      font-size: 0.8rem;
      color: var(--accent-rose);
      font-weight: 500;
    }

    .category-description {
      font-size: 0.8rem;
      color: var(--acleaf-moss);
      margin-top: 0.5rem;
      line-height: 1.4;
    }

    /* Empty State */
    .empty-categories {
      text-align: center;
      padding: 4rem;
      background: white;
      border-radius: var(--border-radius);
      grid-column: 1 / -1;
    }

    .empty-categories i {
      font-size: 4rem;
      color: var(--acleaf-moss);
      margin-bottom: 1rem;
    }

    .empty-categories h3 {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }

    .empty-categories p {
      color: #5b6e55;
      margin-bottom: 1.5rem;
    }

    .add-category-btn {
      display: inline-block;
      background: var(--accent-rose);
      color: white;
      padding: 0.8rem 2rem;
      border-radius: 40px;
      text-decoration: none;
      transition: var(--transition);
    }

    .add-category-btn:hover {
      background: #e27a97;
      transform: translateY(-2px);
    }

    /* Responsive */
    @media (max-width: 1200px) {
      .categories-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 992px) {
      .categories-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .categories-header h1 {
        font-size: 2.5rem;
      }
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 1.5rem;
      }
      .categories-header {
        padding: 6rem 0 1.5rem;
      }
      .categories-header h1 {
        font-size: 2.2rem;
      }
      .categories-grid {
        grid-template-columns: 1fr;
        max-width: 350px;
        margin: 0 auto 3rem;
      }
    }
  </style>
</head>
<body>

<div class="container">
  <!-- Categories Header -->
  <div class="categories-header">
    <h1 class="editable-text editable-section no-drop-zone" data-section="120" data-text="100">Shop by Category</h1>
    <p class="editable-text editable-section no-drop-zone" data-section="121" data-text="101">Explore our curated collections of fine jewelry</p>
  </div>

  <!-- Categories Grid -->
  <div class="categories-grid" id="categoriesGrid">
    <!-- Category 1 - Editable -->
    <div class="category-card editable-section no-drop-zone" data-section="122" data-category-slug="necklaces">
      <img class="category-img editable-image" data-image="60" src="https://images.pexels.com/photos/2079656/pexels-photo-2079656.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Necklaces">
      <div class="category-info">
        <div class="category-name editable-text editable-section no-drop-zone" data-section="123" data-text="102">Necklaces</div>
        <div class="category-count editable-text editable-section no-drop-zone" data-section="124" data-text="103">12 Products</div>
        <div class="category-description editable-text editable-section no-drop-zone" data-section="125" data-text="104">Elegant pendants and chains for every occasion</div>
      </div>
    </div>

    <!-- Category 2 - Static Sample -->
    <div class="category-card" data-category-slug="rings">
      <img class="category-img" src="https://images.pexels.com/photos/948211/pexels-photo-948211.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Rings">
      <div class="category-info">
        <div class="category-name">Rings</div>
        <div class="category-count">8 Products</div>
        <div class="category-description">Diamond solitaires and vintage designs</div>
      </div>
    </div>

    <!-- Category 3 - Static Sample -->
    <div class="category-card" data-category-slug="earrings">
      <img class="category-img" src="https://images.pexels.com/photos/2011703/pexels-photo-2011703.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Earrings">
      <div class="category-info">
        <div class="category-name">Earrings</div>
        <div class="category-count">15 Products</div>
        <div class="category-description">Pearl, diamond, and gold earrings</div>
      </div>
    </div>

    <!-- Category 4 - Static Sample -->
    <div class="category-card" data-category-slug="bracelets">
      <img class="category-img" src="https://images.pexels.com/photos/1192798/pexels-photo-1192798.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Bracelets">
      <div class="category-info">
        <div class="category-name">Bracelets</div>
        <div class="category-count">10 Products</div>
        <div class="category-description">Minimalist chains and tennis bracelets</div>
      </div>
    </div>

    <!-- Category 5 - Static Sample -->
    <div class="category-card" data-category-slug="pendants">
      <img class="category-img" src="https://images.pexels.com/photos/2478729/pexels-photo-2478729.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Pendants">
      <div class="category-info">
        <div class="category-name">Pendants</div>
        <div class="category-count">6 Products</div>
        <div class="category-description">Meaningful symbols and gemstone pendants</div>
      </div>
    </div>

    <!-- Category 6 - Static Sample -->
    <div class="category-card" data-category-slug="wedding">
      <img class="category-img" src="https://images.pexels.com/photos/1443997/pexels-photo-1443997.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Wedding Jewelry">
      <div class="category-info">
        <div class="category-name">Wedding Collection</div>
        <div class="category-count">7 Products</div>
        <div class="category-description">Engagement rings and bridal sets</div>
      </div>
    </div>
  </div>
</div>

<script>
  // Category card click to navigate to shop with category filter
  const categoryCards = document.querySelectorAll('.category-card');
  
  categoryCards.forEach(card => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      const categorySlug = card.getAttribute('data-category-slug');
      const categoryName = card.querySelector('.category-name').textContent;
      
      if (categorySlug) {
        window.location.href = `?page=shop&category=${categorySlug}`;
      } else {
        alert(`Browse ${categoryName} collection`);
      }
    });
  });
  
  // Animation on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, { threshold: 0.1 });
  
  categoryCards.forEach((card, index) => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(20px)';
    card.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
    observer.observe(card);
    
    setTimeout(() => {
      card.style.opacity = '1';
      card.style.transform = 'translateY(0)';
    }, 300 + (index * 100));
  });
</script>
</body>
</html>