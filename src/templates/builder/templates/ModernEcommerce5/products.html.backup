<!-- templates/builder/editable_templates/ModernEcommerce16/products_editable.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - Luminae</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
<style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-charcoal: #2A2A34;
            --color-stone-teal: #5596AA;
            --color-mist-blue: #AABFD4;
            --color-lavender-frost: #E6E8F5;
            --color-dusty-lilac: #DCD7DD;
            --bg-primary: #E6E8F5;
            --text-primary: #2A2A34;
            --accent-soft: #5596AA;
            --border-light: rgba(42, 42, 52, 0.1);
            --transition: all 0.3s ease;
        }

        main {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.5;
            padding-top: 90px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Shop Header */
        .shop-header.editable-section[data-section="51"] {
            text-align: center;
            padding: 2rem 0 3rem;
            margin-bottom: 1rem;
        }

        h1 {
            font-size: 3rem;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: var(--color-deep-charcoal);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--color-stone-teal), var(--color-mist-blue));
        }

        p {
            color: #6a6a78;
            font-size: 1.125rem;
            max-width: 700px;
            margin: 1rem auto 0;
        }

        /* Shop Controls */
        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .search-container {
            flex: 1;
            max-width: 400px;
        }

        .search-input {
            width: 100%;
            padding: 0.875rem 1.25rem;
            border: 1px solid var(--border-light);
            border-radius: 50px;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            background: white;
            transition: var(--transition);
        }

        .search-input:focus {
            outline: none;
            border-color: var(--color-stone-teal);
            box-shadow: 0 0 0 3px rgba(85,150,170,0.1);
        }

        .controls-right {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .sort-select {
            padding: 0.875rem 1.25rem;
            border: 1px solid var(--border-light);
            border-radius: 50px;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            background: white;
            cursor: pointer;
            transition: var(--transition);
        }

        .sort-select:hover {
            border-color: var(--color-stone-teal);
        }

        .categories-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: transparent;
            border: 1px solid var(--color-stone-teal);
            color: var(--color-stone-teal);
            padding: 0.875rem 1.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.875rem;
            transition: var(--transition);
        }

        .categories-btn:hover {
            background: var(--color-stone-teal);
            color: white;
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: 4rem;
        }

        div.product-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            position: relative;
        }

        div.product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        div.product-card:hover .product-img {
            transform: scale(1.03);
        }

        .product-info {
            padding: 1.25rem;
        }

        .product-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-stone-teal);
            margin-bottom: 0.5rem;
        }

        .product-name {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--color-deep-charcoal);
        }

        .product-price {
            font-size: 1rem;
            font-weight: 500;
            color: var(--color-stone-teal);
            margin-bottom: 1rem;
        }

        .product-actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .btn-add-to-cart {
            flex: 1;
            background: var(--color-stone-teal);
            color: white;
            padding: 0.75rem;
            font-size: 0.875rem;
            font-weight: 500;
            border-radius: 40px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-add-to-cart:hover {
            background: #3f7688;
            transform: translateY(-2px);
        }

        .btn-wishlist {
            width: 42px;
            height: 42px;
            background: white;
            border: 1px solid var(--border-light);
            border-radius: 40px;
            color: var(--color-deep-charcoal);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-wishlist:hover {
            background: rgba(85,150,170,0.1);
            color: var(--color-stone-teal);
            border-color: var(--color-stone-teal);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 20px;
            box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
            margin: 2rem 0;
            grid-column: 1 / -1;
        }

        .empty-state h3 {
            color: var(--color-deep-charcoal);
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .empty-state p {
            color: #6a6a78;
            margin-bottom: 1.5rem;
        }

        .empty-state a {
            color: var(--color-stone-teal);
            text-decoration: none;
            font-weight: 500;
        }

        .empty-state a:hover {
            text-decoration: underline;
        }

        /* No Results State */
        .no-results {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 20px;
            margin: 2rem 0;
            grid-column: 1 / -1;
            display: none;
        }

        .no-results.active {
            display: block;
        }

        .no-results h3 {
            color: var(--color-deep-charcoal);
            margin-bottom: 0.5rem;
        }

        .no-results p {
            color: #6a6a78;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }
        }

        @media (max-width: 992px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1 {
                font-size: 2.5rem;
            }
        }

        @media (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            .shop-controls {
                flex-direction: column;
                align-items: stretch;
            }
            .search-container {
                max-width: 100%;
            }
            .controls-right {
                justify-content: space-between;
            }
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            h1 {
                font-size: 2rem;
            }
            p {
                font-size: 1rem;
            }
            .container {
                padding: 0 1.25rem;
            }
        }

        @media (max-width: 576px) {
            .controls-right {
                flex-direction: column;
                gap: 0.75rem;
            }
            .sort-select, .categories-btn {
                width: 100%;
                text-align: center;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <main>
        <!-- Shop Header -->
    <div class="shop-header editable-section" data-section="51">
        <div class="container">
            <h1 class="editable-text editable-section no-drop-zone" data-section="52" data-text="40">Our Collection</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="53" data-text="41">Discover thoughtfully curated pieces that bring warmth and elegance to your home</p>
        </div>
    </div>

    <!-- Shop Controls -->
    <div class="container">
        <div class="shop-controls">
            <div class="search-container">
                <input type="text" class="search-input" id="searchInput" placeholder="Search products...">
            </div>
            <div class="controls-right">
                <select class="sort-select" id="sortSelect">
                    <option value="default">Sort by: Featured</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                    <option value="newest">Newest First</option>
                </select>
                <a href="#" class="categories-btn editable-text editable-section no-drop-zone" data-section="54" data-text="42">
                    <i class="fas fa-th-large"></i> Browse Categories
                </a>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="container">
        <div class="products-grid" id="productsGrid">
            <!-- Product 1 (Editable) -->
            <div class="product-card editable-section no-drop-zone" data-section="55" data-product-name="Artisan Ceramic Vase" data-product-price="89" data-product-category="ACCESSORIES">
                <img src="https://images.pexels.com/photos/1571459/pexels-photo-1571459.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Artisan Ceramic Vase" class="product-img editable-image" data-image="10">
                <div class="product-info">
                    <div class="product-category editable-section no-drop-zone" data-section="56" data-text="43">ACCESSORIES</div>
                    <div class="product-name editable-section no-drop-zone" data-section="57" data-text="44">Artisan Ceramic Vase</div>
                    <div class="product-price editable-section no-drop-zone" data-section="58" data-text="45">$89</div>
                    <div class="product-actions">
                        <button class="btn-add-to-cart editable-text editable-section no-drop-zone" data-section="59" data-text="46">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                        <button class="btn-wishlist">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Product 2 -->
            <div class="product-card" data-product-name="Modern Arc Lamp" data-product-price="149" data-product-category="LIGHTING">
                <img src="https://images.pexels.com/photos/2103509/pexels-photo-2103509.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Modern Arc Lamp" class="product-img">
                <div class="product-info">
                    <div class="product-category">LIGHTING</div>
                    <div class="product-name">Modern Arc Lamp</div>
                    <div class="product-price">$149</div>
                    <div class="product-actions">
                        <button class="btn-add-to-cart"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="btn-wishlist"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>

            <!-- Product 3 -->
            <div class="product-card" data-product-name="Textured Lumbar Pillow" data-product-price="59" data-product-category="TEXTILES">
                <img src="https://images.pexels.com/photos/5882287/pexels-photo-5882287.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Textured Lumbar Pillow" class="product-img">
                <div class="product-info">
                    <div class="product-category">TEXTILES</div>
                    <div class="product-name">Textured Lumbar Pillow</div>
                    <div class="product-price">$59</div>
                    <div class="product-actions">
                        <button class="btn-add-to-cart"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="btn-wishlist"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>

            <!-- Product 4 -->
            <div class="product-card" data-product-name="Abstract Framed Print" data-product-price="199" data-product-category="WALL ART">
                <img src="https://images.pexels.com/photos/1746830/pexels-photo-1746830.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Abstract Framed Print" class="product-img">
                <div class="product-info">
                    <div class="product-category">WALL ART</div>
                    <div class="product-name">Abstract Framed Print</div>
                    <div class="product-price">$199</div>
                    <div class="product-actions">
                        <button class="btn-add-to-cart"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="btn-wishlist"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- No Results State -->
        <div class="no-results" id="noResults">
            <h3>No products found</h3>
            <p>Try adjusting your search or browse our collections</p>
        </div>

        <!-- Empty State -->
        <div class="empty-state" id="emptyState" style="display: none;">
            <h3>No Products Yet</h3>
            <p>You haven't added any products to your collection yet. <a href="/admin/add-product">Add your first product</a> to get started.</p>
        </div>
    </div>
    </main>

    <script>
        // Search and Filter Functionality
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const productsGrid = document.getElementById('productsGrid');
        const noResults = document.getElementById('noResults');
        const emptyState = document.getElementById('emptyState');

        let currentProducts = [];

        function getProducts() {
            return Array.from(document.querySelectorAll('.product-card'));
        }

        function filterProducts() {
            const searchTerm = searchInput.value.toLowerCase();
            const products = getProducts();
            let visibleCount = 0;

            products.forEach(product => {
                const productName = product.getAttribute('data-product-name') || 
                                   product.querySelector('.product-name')?.textContent || '';
                const productCategory = product.getAttribute('data-product-category') ||
                                       product.querySelector('.product-category')?.textContent || '';
                
                const matchesSearch = productName.toLowerCase().includes(searchTerm) ||
                                     productCategory.toLowerCase().includes(searchTerm);
                
                if (matchesSearch) {
                    product.style.display = 'block';
                    visibleCount++;
                } else {
                    product.style.display = 'none';
                }
            });

            if (visibleCount === 0 && products.length > 0) {
                noResults.classList.add('active');
                productsGrid.style.display = 'none';
            } else {
                noResults.classList.remove('active');
                productsGrid.style.display = 'grid';
            }

            return visibleCount;
        }

        function sortProducts() {
            const sortValue = sortSelect.value;
            const products = getProducts();
            const visibleProducts = products.filter(p => p.style.display !== 'none');

            visibleProducts.sort((a, b) => {
                const priceA = parseFloat(a.getAttribute('data-product-price')) || 
                              parseFloat(a.querySelector('.product-price')?.textContent.replace('$', '')) || 0;
                const priceB = parseFloat(b.getAttribute('data-product-price')) || 
                              parseFloat(b.querySelector('.product-price')?.textContent.replace('$', '')) || 0;
                
                if (sortValue === 'price-low') {
                    return priceA - priceB;
                } else if (sortValue === 'price-high') {
                    return priceB - priceA;
                }
                return 0;
            });

            visibleProducts.forEach(product => {
                productsGrid.appendChild(product);
            });
        }

        searchInput.addEventListener('input', () => {
            filterProducts();
            sortProducts();
        });

        sortSelect.addEventListener('change', () => {
            sortProducts();
        });

        // Add to Cart functionality
        document.querySelectorAll('.btn-add-to-cart').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const productCard = this.closest('.product-card');
                const productName = productCard.querySelector('.product-name')?.textContent || 'Product';
                alert(`${productName} added to cart!`);
            });
        });

        // Wishlist functionality
        document.querySelectorAll('.btn-wishlist').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const productCard = this.closest('.product-card');
                const productName = productCard.querySelector('.product-name')?.textContent || 'Product';
                alert(`${productName} added to wishlist!`);
            });
        });

        // Check if products exist
        const productCount = document.querySelectorAll('.product-card').length;
        if (productCount === 0) {
            emptyState.style.display = 'block';
            productsGrid.style.display = 'none';
        }
    </script>
</body>
</html>