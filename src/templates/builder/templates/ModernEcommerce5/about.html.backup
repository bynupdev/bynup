<!-- templates/builder/editable_templates/ModernEcommerce16/about_editable.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - Luminae</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-charcoal: #2A2A34;
            --color-stone-teal: #5596AA;
            --color-mist-blue: #AABFD4;
            --color-lavender-frost: #E6E8F5;
            --color-dusty-lilac: #DCD7DD;
            --bg-primary: #E6E8F5;
            --text-primary: #2A2A34;
            --accent-soft: #5596AA;
            --border-light: rgba(42, 42, 52, 0.1);
            --transition: all 0.3s ease;
        }

        main {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.5;
            padding-top: 90px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: 2rem 0 3rem;
        }

        h1.editable-text.editable-section.no-drop-zone[data-section="129"] {
            font-size: 2.5rem;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: var(--color-deep-charcoal);
            margin-bottom: 0.5rem;
            position: relative;
            display: inline-block;
        }

        h1.editable-text.editable-section.no-drop-zone[data-section="129"]::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, var(--color-stone-teal), var(--color-mist-blue));
        }

        p.editable-text.editable-section.no-drop-zone[data-section="130"] {
            color: #6a6a78;
            margin-top: 1.5rem;
            font-size: 1rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Hero Section */
        .about-hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
            margin-bottom: 4rem;
            align-items: center;
        }

        .hero-image {
            width: 100%;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .hero-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .hero-content h2 {
            font-size: 2rem;
            font-family: 'Playfair Display', serif;
            margin-bottom: 1rem;
        }

        .hero-content p {
            color: #6a6a78;
            line-height: 1.7;
            margin-bottom: 1rem;
        }

        .hero-content .highlight {
            font-size: 1.125rem;
            font-style: italic;
            color: var(--color-stone-teal);
            border-left: 3px solid var(--color-stone-teal);
            padding-left: 1rem;
            margin: 1.5rem 0;
        }

        /* Mission & Vision */
        .mission-vision {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .mission-card, .vision-card {
            background: white;
            border-radius: 24px;
            padding: 2rem;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            transition: var(--transition);
        }

        .mission-card:hover, .vision-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .mission-card i, .vision-card i {
            font-size: 2.5rem;
            color: var(--color-stone-teal);
            margin-bottom: 1rem;
        }

        .mission-card h3, .vision-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            font-family: 'Playfair Display', serif;
        }

        .mission-card p, .vision-card p {
            color: #6a6a78;
            line-height: 1.6;
        }

        /* Values Section */
        .values-section {
            margin-bottom: 4rem;
        }

        .values-section h2 {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 2rem;
            font-family: 'Playfair Display', serif;
        }

        .values-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }

        .value-card {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: var(--transition);
        }

        .value-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .value-icon {
            width: 70px;
            height: 70px;
            background: var(--color-lavender-frost);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

        .value-icon i {
            font-size: 1.75rem;
            color: var(--color-stone-teal);
        }

        .value-card h3 {
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
        }

        .value-card p {
            color: #6a6a78;
            font-size: 0.875rem;
            line-height: 1.6;
        }

        /* Story Timeline */
        .story-timeline {
            margin-bottom: 4rem;
        }

        .story-timeline h2 {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 2rem;
            font-family: 'Playfair Display', serif;
        }

        .timeline {
            position: relative;
            max-width: 800px;
            margin: 0 auto;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 100%;
            background: var(--color-stone-teal);
        }

        .timeline-item {
            position: relative;
            margin-bottom: 2rem;
            width: 50%;
        }

        .timeline-item:nth-child(odd) {
            left: 0;
            padding-right: 2rem;
        }

        .timeline-item:nth-child(even) {
            left: 50%;
            padding-left: 2rem;
        }

        .timeline-content {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            position: relative;
        }

        .timeline-year {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--color-stone-teal);
            margin-bottom: 0.5rem;
        }

        .timeline-title {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .timeline-description {
            color: #6a6a78;
            font-size: 0.875rem;
            line-height: 1.6;
        }

        .timeline-dot {
            position: absolute;
            width: 12px;
            height: 12px;
            background: var(--color-stone-teal);
            border-radius: 50%;
            top: 1.5rem;
        }

        .timeline-item:nth-child(odd) .timeline-dot {
            right: -6px;
        }

        .timeline-item:nth-child(even) .timeline-dot {
            left: -6px;
        }

        /* Team Section */
        .team-section {
            margin-bottom: 4rem;
        }

        .team-section h2 {
            text-align: center;
            font-size: 2rem;
            margin-bottom: 2rem;
            font-family: 'Playfair Display', serif;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .team-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: var(--transition);
            text-align: center;
        }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .team-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .team-info {
            padding: 1.25rem;
        }

        .team-name {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .team-role {
            font-size: 0.75rem;
            color: var(--color-stone-teal);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .team-bio {
            font-size: 0.875rem;
            color: #6a6a78;
            line-height: 1.5;
        }

        /* Stats Section */
        .stats-section {
            background: white;
            border-radius: 24px;
            padding: 3rem;
            margin-bottom: 4rem;
            text-align: center;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .stat-item h3 {
            font-size: 2rem;
            color: var(--color-stone-teal);
            margin-bottom: 0.25rem;
        }

        .stat-item p {
            font-size: 0.875rem;
            color: #6a6a78;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .team-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .values-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 992px) {
            .about-hero {
                grid-template-columns: 1fr;
            }
            .hero-image {
                order: -1;
            }
            .mission-vision {
                grid-template-columns: 1fr;
            }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .timeline::before {
                left: 20px;
            }
            .timeline-item {
                width: 100%;
                left: 0 !important;
                padding-left: 3rem !important;
                padding-right: 0 !important;
            }
            .timeline-item .timeline-dot {
                left: 10px !important;
                right: auto !important;
            }
        }

        @media (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            .container {
                padding: 0 1.25rem;
            }
            .team-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            .values-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            .stats-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            h1.editable-text.editable-section.no-drop-zone[data-section="129"] {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>

    <main>
        <!-- Page Header -->
    <div class="container">
        <div class="page-header editable-section" data-section="331">
            <h1 class="editable-text editable-section no-drop-zone" data-section="332" data-text="213">Our Story</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="333" data-text="214">Crafting timeless pieces that transform houses into homes since 2015</p>
        </div>
    </div>

    <!-- Hero Section -->
    <div class="container">
        <div class="about-hero editable-section" data-section="334">
            <div class="hero-image">
                <img src="https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Our Studio" class="editable-image" data-image="33">
            </div>
            <div class="hero-content editable-section" data-section="335">
                <h2 class="editable-text editable-section no-drop-zone" data-section="336" data-text="215">Design Meets Purpose</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="337" data-text="216">Luminae was born from a simple idea: that the spaces we inhabit should be a reflection of who we are. We believe that thoughtful design has the power to transform not just rooms, but lives.</p>
                <p class="editable-text editable-section no-drop-zone" data-section="338" data-text="217">What started as a small studio with a passion for ceramics and textiles has grown into a curated collection of home décor that celebrates craftsmanship, sustainability, and timeless elegance.</p>
                <p class="highlight editable-text editable-section no-drop-zone" data-section="339" data-text="218">"Every piece tells a story. Every space deserves to feel like home."</p>
            </div>
        </div>
    </div>

    <!-- Mission & Vision -->
    <div class="container">
        <div class="mission-vision editable-section" data-section="340">
            <div class="mission-card editable-section" data-section="341">
                <i class="fas fa-bullseye editable-icon" data-icon="30" data-default-class="fas fa-bullseye"></i>
                <h3 class="editable-text editable-section no-drop-zone" data-section="342" data-text="219">Our Mission</h3>
                <p class="editable-text editable-section no-drop-zone" data-section="343" data-text="220">To create beautifully crafted home décor that inspires warmth, fosters connection, and brings joy to everyday living through thoughtful design and sustainable practices.</p>
            </div>
            <div class="vision-card editable-section" data-section="344">
                <i class="fas fa-eye editable-icon" data-icon="31" data-default-class="fas fa-eye"></i>
                <h3 class="editable-text editable-section no-drop-zone" data-section="345" data-text="221">Our Vision</h3>
                <p class="editable-text editable-section no-drop-zone" data-section="346" data-text="222">To become a beloved destination for design-conscious individuals seeking pieces that blend artistry with functionality, creating spaces that feel authentically their own.</p>
            </div>
        </div>
    </div>

    <!-- Values Section -->
    <div class="container">
        <div class="values-section editable-section" data-section="347">
            <h2 class="editable-text editable-section no-drop-zone" data-section="348" data-text="223">Our Core Values</h2>
            <div class="values-grid">
                <div class="value-card editable-section" data-section="349">
                    <div class="value-icon">
                        <i class="fas fa-heart editable-icon" data-icon="32" data-default-class="fas fa-heart"></i>
                    </div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="350" data-text="224">Authenticity</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="351" data-text="225">We create pieces with genuine craftsmanship and honest materials, staying true to our design philosophy.</p>
                </div>
                <div class="value-card editable-section" data-section="352">
                    <div class="value-icon">
                        <i class="fas fa-leaf editable-icon" data-icon="33" data-default-class="fas fa-leaf"></i>
                    </div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="353" data-text="226">Sustainability</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="354" data-text="227">We're committed to ethical sourcing, eco-friendly materials, and responsible production practices.</p>
                </div>
                <div class="value-card editable-section" data-section="355">
                    <div class="value-icon">
                        <i class="fas fa-hand-sparkles editable-icon" data-icon="34" data-default-class="fas fa-hand-sparkles"></i>
                    </div>
                    <h3 class="editable-text editable-section no-drop-zone" data-section="356" data-text="228">Craftsmanship</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="357" data-text="229">Every piece is thoughtfully designed and carefully made by skilled artisans who take pride in their work.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Story Timeline -->
    <div class="container">
        <div class="story-timeline editable-section" data-section="358">
            <h2 class="editable-text editable-section no-drop-zone" data-section="359" data-text="230">Our Journey</h2>
            <div class="timeline">
                <div class="timeline-item editable-section" data-section="360">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year editable-text editable-section no-drop-zone" data-section="361" data-text="231">2015</div>
                        <div class="timeline-title editable-text editable-section no-drop-zone" data-section="362" data-text="232">The Beginning</div>
                        <div class="timeline-description editable-text editable-section no-drop-zone" data-section="363" data-text="233">Luminae was founded in a small Brooklyn studio with a passion for ceramics and a dream to create beautiful home décor.</div>
                    </div>
                </div>
                <div class="timeline-item editable-section" data-section="364">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year editable-text editable-section no-drop-zone" data-section="365" data-text="234">2017</div>
                        <div class="timeline-title editable-text editable-section no-drop-zone" data-section="366" data-text="235">First Collection</div>
                        <div class="timeline-description editable-text editable-section no-drop-zone" data-section="367" data-text="236">Launched our first curated collection of handcrafted ceramics and textiles, receiving overwhelming support from the local community.</div>
                    </div>
                </div>
                <div class="timeline-item editable-section" data-section="368">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year editable-text editable-section no-drop-zone" data-section="369" data-text="237">2019</div>
                        <div class="timeline-title editable-text editable-section no-drop-zone" data-section="370" data-text="238">Sustainable Commitment</div>
                        <div class="timeline-description editable-text editable-section no-drop-zone" data-section="371" data-text="239">Transitioned to 100% sustainable packaging and partnered with ethical manufacturers committed to fair labor practices.</div>
                    </div>
                </div>
                <div class="timeline-item editable-section" data-section="372">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year editable-text editable-section no-drop-zone" data-section="373" data-text="240">2021</div>
                        <div class="timeline-title editable-text editable-section no-drop-zone" data-section="374" data-text="241">Flagship Studio</div>
                        <div class="timeline-description editable-text editable-section no-drop-zone" data-section="375" data-text="242">Opened our first flagship studio in Manhattan, creating a space where customers could experience our collections in person.</div>
                    </div>
                </div>
                <div class="timeline-item editable-section" data-section="376">
                    <div class="timeline-dot"></div>
                    <div class="timeline-content">
                        <div class="timeline-year editable-text editable-section no-drop-zone" data-section="377" data-text="243">2024</div>
                        <div class="timeline-title editable-text editable-section no-drop-zone" data-section="378" data-text="244">Global Reach</div>
                        <div class="timeline-description editable-text editable-section no-drop-zone" data-section="379" data-text="245">Expanded to serve customers worldwide, bringing our curated collections to homes across the globe.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Section -->
    <div class="container">
        <div class="team-section editable-section" data-section="380">
            <h2 class="editable-text editable-section no-drop-zone" data-section="381" data-text="246">Meet Our Team</h2>
            <div class="team-grid">
                <div class="team-card editable-section" data-section="382">
                    <img src="https://images.pexels.com/photos/1181686/pexels-photo-1181686.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team Member" class="team-image editable-image" data-image="34">
                    <div class="team-info">
                        <div class="team-name editable-text editable-section no-drop-zone" data-section="383" data-text="247">Emma Richardson</div>
                        <div class="team-role editable-text editable-section no-drop-zone" data-section="384" data-text="248">Founder & Creative Director</div>
                        <div class="team-bio editable-text editable-section no-drop-zone" data-section="385" data-text="249">With a background in textile design and a passion for sustainable craftsmanship, Emma leads our creative vision.</div>
                    </div>
                </div>
                <div class="team-card editable-section" data-section="386">
                    <img src="https://images.pexels.com/photos/2379004/pexels-photo-2379004.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team Member" class="team-image editable-image" data-image="35">
                    <div class="team-info">
                        <div class="team-name editable-text editable-section no-drop-zone" data-section="387" data-text="250">David Chen</div>
                        <div class="team-role editable-text editable-section no-drop-zone" data-section="388" data-text="251">Head of Product Design</div>
                        <div class="team-bio editable-text editable-section no-drop-zone" data-section="389" data-text="252">David brings over a decade of experience in furniture and product design, blending form with function.</div>
                    </div>
                </div>
                <div class="team-card editable-section" data-section="390">
                    <img src="https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team Member" class="team-image editable-image" data-image="36">
                    <div class="team-info">
                        <div class="team-name editable-text editable-section no-drop-zone" data-section="391" data-text="253">Sophia Martinez</div>
                        <div class="team-role editable-text editable-section no-drop-zone" data-section="392" data-text="254">Sustainability Director</div>
                        <div class="team-bio editable-text editable-section no-drop-zone" data-section="393" data-text="255">Sophia ensures every material and process meets our rigorous sustainability standards.</div>
                    </div>
                </div>
                <div class="team-card editable-section" data-section="394">
                    <img src="https://images.pexels.com/photos/2379005/pexels-photo-2379005.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Team Member" class="team-image editable-image" data-image="37">
                    <div class="team-info">
                        <div class="team-name editable-text editable-section no-drop-zone" data-section="395" data-text="256">Marcus Williams</div>
                        <div class="team-role editable-text editable-section no-drop-zone" data-section="396" data-text="257">Operations Manager</div>
                        <div class="team-bio editable-text editable-section no-drop-zone" data-section="397" data-text="258">Marcus ensures that every order reaches our customers with care and efficiency.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="container">
        <div class="stats-section editable-section" data-section="398">
            <div class="stats-grid">
                <div class="stat-item editable-section" data-section="399">
                    <h3 class="editable-text editable-section no-drop-zone" data-section="400" data-text="259">10K+</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="401" data-text="260">Happy Customers</p>
                </div>
                <div class="stat-item editable-section" data-section="402">
                    <h3 class="editable-text editable-section no-drop-zone" data-section="403" data-text="261">50+</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="404" data-text="262">Artisan Partners</p>
                </div>
                <div class="stat-item editable-section" data-section="405">
                    <h3 class="editable-text editable-section no-drop-zone" data-section="406" data-text="263">100%</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="407" data-text="264">Sustainable Packaging</p>
                </div>
                <div class="stat-item editable-section" data-section="408">
                    <h3 class="editable-text editable-section no-drop-zone" data-section="409" data-text="265">24/7</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="410" data-text="266">Customer Support</p>
                </div>
            </div>
        </div>
    </div>
    </main>

    <script>
        // Add scroll animations for timeline items, value cards, and team cards
        const observerOptions = { threshold: 0.1, rootMargin: '0px 0px -50px 0px' };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);
        
        document.querySelectorAll('.value-card, .team-card, .timeline-item, .stat-item').forEach((el, index) => {
            el.style.opacity = '0';
            el.style.transform = 'translateY(20px)';
            el.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
            observer.observe(el);
        });
    </script>
</body>
</html>



