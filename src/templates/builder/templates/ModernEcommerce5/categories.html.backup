<!-- templates/builder/editable_templates/ModernEcommerce16/categories_editable.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop by Category - Luminae</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-charcoal: #2A2A34;
            --color-stone-teal: #5596AA;
            --color-mist-blue: #AABFD4;
            --color-lavender-frost: #E6E8F5;
            --color-dusty-lilac: #DCD7DD;
            --bg-primary: #E6E8F5;
            --text-primary: #2A2A34;
            --accent-soft: #5596AA;
            --border-light: rgba(42, 42, 52, 0.1);
            --transition: all 0.3s ease;
        }

        main {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.5;
            padding-top: 90px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: 2rem 0 3rem;
        }

        h1 {
            font-size: 2.5rem;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: var(--color-deep-charcoal);
            margin-bottom: 0.5rem;
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, var(--color-stone-teal), var(--color-mist-blue));
        }

        p {
            color: #6a6a78;
            margin-top: 1.5rem;
            font-size: 1rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .category-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            text-decoration: none;
            display: block;
            position: relative;
        }

        .category-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .category-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .category-card:hover .category-image {
            transform: scale(1.05);
        }

        .category-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
            padding: 1.5rem;
            color: white;
        }

        .category-name {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
        }

        .category-count {
            font-size: 0.875rem;
            opacity: 0.9;
        }

        .category-info {
            padding: 1.25rem;
            text-align: center;
        }

        .category-description {
            color: #6a6a78;
            font-size: 0.875rem;
            line-height: 1.6;
            margin-top: 0.5rem;
        }

        /* Category Stats */
        .category-stats {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 3rem;
            flex-wrap: wrap;
        }

        .stat-card {
            background: white;
            border-radius: 20px;
            padding: 1rem 2rem;
            text-align: center;
            min-width: 150px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        }

        .stat-number {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--color-stone-teal);
        }

        .stat-label {
            font-size: 0.75rem;
            color: #6a6a78;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 0.25rem;
        }

        /* Empty State */
        .empty-categories {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 24px;
            margin-bottom: 2rem;
        }

        .empty-categories-icon {
            font-size: 4rem;
            color: var(--color-mist-blue);
            margin-bottom: 1rem;
        }

        .empty-categories h2 {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .empty-categories p {
            color: #6a6a78;
            margin-bottom: 1.5rem;
        }

        .btn-add-category {
            display: inline-block;
            background: var(--color-stone-teal);
            color: white;
            padding: 0.875rem 2rem;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
        }

        .btn-add-category:hover {
            background: #3f7688;
            transform: translateY(-2px);
        }

        /* Responsive */
        @media (max-width: 992px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            .container {
                padding: 0 1.25rem;
            }
            .categories-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            h1 {
                font-size: 2rem;
            }
            .category-stats {
                gap: 1rem;
            }
            .stat-card {
                min-width: 120px;
                padding: 0.75rem 1rem;
            }
            .stat-number {
                font-size: 1.25rem;
            }
        }

        @media (max-width: 576px) {
            .category-stats {
                flex-direction: column;
                align-items: center;
            }
            .stat-card {
                width: 100%;
                max-width: 200px;
            }
        }
    </style>
</head>
<body>

    <main>
        <!-- Page Header -->
    <div class="container">
        <div class="page-header editable-section" data-section="231">
            <h1 class="editable-text editable-section no-drop-zone" data-section="232" data-text="145">Shop by Category</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="233" data-text="146">Explore our curated collections designed to elevate every corner of your home</p>
        </div>
    </div>

    <!-- Category Stats -->
    <div class="container">
        <div class="category-stats editable-section" data-section="234">
            <div class="stat-card editable-section" data-section="235">
                <div class="stat-number editable-text editable-section no-drop-zone" data-section="236" data-text="147" id="totalCategories">6</div>
                <div class="stat-label editable-text editable-section no-drop-zone" data-section="237" data-text="148">Categories</div>
            </div>
            <div class="stat-card editable-section" data-section="238">
                <div class="stat-number editable-text editable-section no-drop-zone" data-section="239" data-text="149" id="totalProducts">24</div>
                <div class="stat-label editable-text editable-section no-drop-zone" data-section="240" data-text="150">Products</div>
            </div>
            <div class="stat-card editable-section" data-section="241">
                <div class="stat-number editable-text editable-section no-drop-zone" data-section="242" data-text="151" id="newArrivals">8</div>
                <div class="stat-label editable-text editable-section no-drop-zone" data-section="243" data-text="152">New Arrivals</div>
            </div>
        </div>
    </div>

    <!-- Categories Grid -->
    <div class="container">
        <div class="categories-grid" id="categoriesGrid">
            <!-- Category 1 (Editable) -->
            <a href="#" class="category-card editable-section" data-section="244">
                <img src="https://images.pexels.com/photos/1571459/pexels-photo-1571459.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Accessories" class="category-image editable-image" data-image="21">
                <div class="category-overlay">
                    <div class="category-name editable-text editable-section no-drop-zone" data-section="245" data-text="153">Accessories</div>
                    <div class="category-count editable-text editable-section no-drop-zone" data-section="246" data-text="154">12 Products</div>
                </div>
                <div class="category-info">
                    <div class="category-description editable-text editable-section no-drop-zone" data-section="247" data-text="155">Decorative accents that add character and charm to any space</div>
                </div>
            </a>

            <!-- Category 2 -->
            <a href="#" class="category-card">
                <img src="https://images.pexels.com/photos/2103509/pexels-photo-2103509.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Lighting" class="category-image">
                <div class="category-overlay">
                    <div class="category-name">Lighting</div>
                    <div class="category-count">8 Products</div>
                </div>
                <div class="category-info">
                    <div class="category-description">Illuminate your home with elegant and functional lighting solutions</div>
                </div>
            </a>

            <!-- Category 3 -->
            <a href="#" class="category-card">
                <img src="https://images.pexels.com/photos/5882287/pexels-photo-5882287.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Textiles" class="category-image">
                <div class="category-overlay">
                    <div class="category-name">Textiles</div>
                    <div class="category-count">6 Products</div>
                </div>
                <div class="category-info">
                    <div class="category-description">Luxurious fabrics and soft furnishings for comfort and style</div>
                </div>
            </a>

            <!-- Category 4 -->
            <a href="#" class="category-card">
                <img src="https://images.pexels.com/photos/1746830/pexels-photo-1746830.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Wall Art" class="category-image">
                <div class="category-overlay">
                    <div class="category-name">Wall Art</div>
                    <div class="category-count">10 Products</div>
                </div>
                <div class="category-info">
                    <div class="category-description">Statement pieces that transform blank walls into galleries</div>
                </div>
            </a>

            <!-- Category 5 -->
            <a href="#" class="category-card">
                <img src="https://images.pexels.com/photos/1192676/pexels-photo-1192676.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Tableware" class="category-image">
                <div class="category-overlay">
                    <div class="category-name">Tableware</div>
                    <div class="category-count">15 Products</div>
                </div>
                <div class="category-info">
                    <div class="category-description">Beautiful ceramics and glassware for memorable dining experiences</div>
                </div>
            </a>

            <!-- Category 6 -->
            <a href="#" class="category-card">
                <img src="https://images.pexels.com/photos/1767482/pexels-photo-1767482.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Furniture" class="category-image">
                <div class="category-overlay">
                    <div class="category-name">Furniture</div>
                    <div class="category-count">5 Products</div>
                </div>
                <div class="category-info">
                    <div class="category-description">Timeless pieces that combine form and function</div>
                </div>
            </a>
        </div>
    </div>

    </main>
    <script>
        function updateCategoryStats() {
            const categories = document.querySelectorAll('.category-card');
            const totalCategories = categories.length;
            let totalProducts = 0;
            let newArrivals = 0;
            
            categories.forEach(category => {
                const countText = category.querySelector('.category-count')?.textContent || '';
                const countMatch = countText.match(/\d+/);
                if (countMatch) totalProducts += parseInt(countMatch[0]);
                if (Math.random() > 0.7) newArrivals++;
            });
            
            document.getElementById('totalCategories').textContent = totalCategories;
            document.getElementById('totalProducts').textContent = totalProducts;
            document.getElementById('newArrivals').textContent = newArrivals;
        }
        
        updateCategoryStats();
    </script>
</body>
</html>