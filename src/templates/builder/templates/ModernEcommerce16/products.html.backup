<!-- builder/templates/ModernEcommerce16/products.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - Éclat Lumière Luxury Skincare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --soft-blush: #FAEEE9;
            --champagne-glow: #F5D69B;
            --mauve-rose: #A77A95;
            --lavender-mist: #C3C3D5;
            --plum-brown: #735366;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        main {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
            
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Shop Header */
        .shop-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1 {
            font-size: 3rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--mauve-rose), var(--champagne-glow));
        }

        p {
            color: var(--plum-brown);
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto;
            opacity: 0.8;
        }

        /* Shop Controls */
        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .controls-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        /* Search Bar */
        .search-container {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 40px;
            padding: 0.3rem 0.3rem 0.3rem 1rem;
            transition: var(--transition);
        }

        .search-container:focus-within {
            border-color: var(--mauve-rose);
            box-shadow: 0 0 0 2px rgba(167, 122, 149, 0.1);
        }

        .search-input {
            border: none;
            outline: none;
            padding: 0.5rem;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            background: transparent;
            color: var(--plum-brown);
            min-width: 200px;
        }

        .search-input::placeholder {
            color: rgba(115, 83, 102, 0.5);
        }

        .search-btn {
            background: var(--plum-brown);
            border: none;
            border-radius: 40px;
            padding: 0.5rem 1.2rem;
            color: var(--soft-blush);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.85rem;
        }

        .search-btn:hover {
            background: var(--mauve-rose);
            transform: translateY(-2px);
        }

        .filter-btn {
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            padding: 0.7rem 1.5rem;
            border-radius: 40px;
            color: var(--plum-brown);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .filter-btn:hover {
            border-color: var(--mauve-rose);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
        }

        .sort-select {
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            padding: 0.7rem 1.5rem;
            border-radius: 40px;
            color: var(--plum-brown);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition);
            min-width: 170px;
        }

        .sort-select:hover {
            border-color: var(--mauve-rose);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
        }

        .browse-categories-btn {
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 0.8rem 2rem;
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .browse-categories-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-xl);
        }

        .product-card {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(2px);
            border-radius: 24px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            border: 1px solid rgba(195, 195, 213, 0.2);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px rgba(115, 83, 102, 0.12);
            background: #fffcf9;
            border-color: var(--champagne-glow);
        }

        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-img {
            transform: scale(1.05);
        }

        .product-info {
            padding: 1.5rem;
            text-align: left;
        }

        .product-category {
            color: var(--mauve-rose);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.5rem;
            min-height: 3rem;
        }

        .product-price {
            color: var(--mauve-rose);
            font-weight: 500;
            font-size: 1.1rem;
            margin-bottom: 1rem;
        }

        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 0.8rem;
            margin-top: 1rem;
        }

        .add-to-cart-btn {
            flex: 1;
            background: var(--plum-brown);
            color: var(--soft-blush);
            padding: 0.7rem;
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 0.5px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-to-cart-btn:hover {
            background: var(--mauve-rose);
            transform: translateY(-2px);
        }

        .wishlist-btn {
            width: 40px;
            height: 40px;
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 50%;
            color: var(--plum-brown);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .wishlist-btn:hover {
            background: rgba(167, 122, 149, 0.1);
            color: var(--mauve-rose);
            border-color: var(--mauve-rose);
            transform: scale(1.05);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
        }

        .empty-state h3 {
            color: var(--plum-brown);
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }

        .empty-state p {
            color: var(--plum-brown);
            opacity: 0.8;
            margin-bottom: 1.5rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .add-first-product {
            display: inline-block;
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 0.9rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            margin-top: 1rem;
        }

        .add-first-product:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* No Search Results */
        .no-results {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            grid-column: 1 / -1;
        }

        .no-results p {
            color: var(--plum-brown);
            opacity: 0.7;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }
            h1 {
                font-size: 2.5rem;
            }
        }

        @media (max-width: 992px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .shop-controls {
                flex-direction: column;
                align-items: stretch;
            }
            .controls-left {
                flex-direction: column;
                align-items: stretch;
            }
            .search-container {
                width: 100%;
            }
            .search-input {
                flex: 1;
            }
            .filter-btn, .sort-select {
                width: 100%;
                justify-content: center;
            }
        }

        @media (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            .products-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            h1 {
                font-size: 2rem;
            }
            p {
                font-size: 1rem;
            }
            .container {
                padding: 0 1.5rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 1.8rem;
            }
            .browse-categories-btn {
                padding: 0.8rem 1.5rem;
                font-size: 0.85rem;
                justify-content: center;
            }
            .add-to-cart-btn {
                padding: 0.6rem;
                font-size: 0.8rem;
            }
        }
    </style>
</head>
<body>

<main>
    <!-- Shop Header -->
<div class="shop-header editable-section" data-section="100">
    <div class="container">
        <h1 class="editable-text editable-section no-drop-zone" data-section="101" data-text="200">Our Collection</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="102" data-text="201">Discover our curated selection of luxury skincare, crafted for radiant, healthy skin.</p>
        
        <div class="shop-controls">
            <div class="controls-left">
                <!-- Search Bar - Editable -->
                <div class="search-container">
                    <input type="text" class="search-input editable-text editable-section no-drop-zone" data-section="103" data-text="202" placeholder="Search products...">
                    <button class="search-btn editable-text editable-section no-drop-zone" data-section="104" data-text="203">
                        <i class="fas fa-search editable-icon" data-icon="50" data-default-class="fas fa-search"></i> Search
                    </button>
                </div>
                <!-- Filter Button - Editable -->
                <button class="filter-btn editable-text editable-section no-drop-zone" data-section="105" data-text="204">
                    <i class="fas fa-sliders-h editable-icon" data-icon="51" data-default-class="fas fa-sliders-h"></i> Filter
                </button>
                <!-- Sort Select - Options Editable -->
                <select class="sort-select editable-section no-drop-zone" data-section="106">
                    <option class="editable-text" data-section="107" data-text="205" value="newest">Newest First</option>
                    <option class="editable-text" data-section="108" data-text="206" value="price-low">Price: Low to High</option>
                    <option class="editable-text" data-section="109" data-text="207" value="price-high">Price: High to Low</option>
                    <option class="editable-text" data-section="110" data-text="208" value="popular">Most Popular</option>
                </select>
            </div>
            <a href="?page=categories" class="browse-categories-btn editable-text editable-section no-drop-zone" data-section="111" data-text="209">
                <i class="fas fa-th-large editable-icon" data-icon="52" data-default-class="fas fa-th-large"></i> Browse Categories
            </a>
        </div>
    </div>
</div>

<!-- Products Section -->
<div class="container">
    <div class="products-grid" id="productsGrid">
        <!-- Product 1 (Editable - applies to all products in public template) -->
        <div class="product-card editable-section no-drop-zone" data-section="112">
            <img src="https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=500&auto=format" alt="Luxury radiance serum" class="product-img editable-image" data-image="50">
            <div class="product-info">
                <div class="product-category editable-section no-drop-zone" data-section="113" data-text="210">SERUM</div>
                <div class="product-name editable-section no-drop-zone" data-section="114" data-text="211">Lumière Radiance Serum</div>
                <div class="product-price editable-section no-drop-zone" data-section="115" data-text="212">$128</div>
                <div class="product-actions">
                    <button class="add-to-cart-btn editable-text editable-section no-drop-zone" data-section="116" data-text="213">
                        <i class="fas fa-shopping-bag editable-icon" data-icon="53" data-default-class="fas fa-shopping-bag"></i> Add to Cart
                    </button>
                    <button class="wishlist-btn">
                        <i class="far fa-heart editable-icon" data-icon="54" data-default-class="far fa-heart"></i>
                    </button>
                </div>
            </div>
        </div>
        <!-- Product 2 (Non-editable sample - will be replaced by loop in public) -->
        <div class="product-card">
            <img src="https://images.unsplash.com/photo-1596462502278-27bfdc5e29f2?w=500&auto=format" alt="Silk velvet cream" class="product-img">
            <div class="product-info">
                <div class="product-category">MOISTURIZER</div>
                <div class="product-name">Silk Velvet Crème</div>
                <div class="product-price">$96</div>
                <div class="product-actions">
                    <button class="add-to-cart-btn"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                    <button class="wishlist-btn"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
        <!-- Product 3 (Non-editable sample - will be replaced by loop in public) -->
        <div class="product-card">
            <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=500&auto=format" alt="Gentle milk cleanser" class="product-img">
            <div class="product-info">
                <div class="product-category">CLEANSER</div>
                <div class="product-name">Nectar Milk Cleanser</div>
                <div class="product-price">$54</div>
                <div class="product-actions">
                    <button class="add-to-cart-btn"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                    <button class="wishlist-btn"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
        <!-- Product 4 (Non-editable sample - will be replaced by loop in public) -->
        <div class="product-card">
            <img src="https://images.unsplash.com/photo-1611085583191-a3b181a66901?w=500&auto=format" alt="Golden overnight mask" class="product-img">
            <div class="product-info">
                <div class="product-category">MASK</div>
                <div class="product-name">Midnight Gold Mask</div>
                <div class="product-price">$142</div>
                <div class="product-actions">
                    <button class="add-to-cart-btn"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                    <button class="wishlist-btn"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Empty State Message (for when no products exist) -->
<div class="empty-state" style="display: none;">
    <h3 class="editable-text editable-section no-drop-zone" data-section="117" data-text="214">No Products Available</h3>
    <p class="editable-text editable-section no-drop-zone" data-section="118" data-text="215">Your shop doesn't have any products yet. Start by adding your first skincare product to showcase your collection.</p>
    <a href="/admin/add-product" class="add-first-product editable-text editable-section no-drop-zone" data-section="119" data-text="216">Add Your First Product →</a>
</div>
</main>

<script>
    // Search functionality
    const searchInput = document.querySelector('.search-input');
    const searchBtn = document.querySelector('.search-btn');
    const productCards = document.querySelectorAll('.product-card');
    const productsGrid = document.getElementById('productsGrid');

    function performSearch() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        let hasResults = false;

        productCards.forEach(card => {
            const productName = card.querySelector('.product-name')?.textContent.toLowerCase() || '';
            const productCategory = card.querySelector('.product-category')?.textContent.toLowerCase() || '';
            
            if (searchTerm === '' || productName.includes(searchTerm) || productCategory.includes(searchTerm)) {
                card.style.display = 'block';
                hasResults = true;
            } else {
                card.style.display = 'none';
            }
        });

        // Show/hide no results message
        let noResultsMsg = document.querySelector('.no-results');
        if (!hasResults && productCards.length > 0) {
            if (!noResultsMsg) {
                const msg = document.createElement('div');
                msg.className = 'no-results';
                msg.innerHTML = '<p class="editable-text editable-section no-drop-zone" data-section="120" data-text="217">No products found matching your search.</p>';
                productsGrid.appendChild(msg);
            } else {
                noResultsMsg.style.display = 'block';
            }
        } else if (noResultsMsg) {
            noResultsMsg.style.display = 'none';
        }
    }

    if (searchBtn) {
        searchBtn.addEventListener('click', performSearch);
    }
    if (searchInput) {
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });
    }

    // Filter and sort functionality
    const filterBtn = document.querySelector('.filter-btn');
    const sortSelect = document.querySelector('.sort-select');

    if (filterBtn) {
        filterBtn.addEventListener('click', function() {
            alert('Filter functionality will be available in the live store.');
        });
    }

    if (sortSelect) {
        sortSelect.addEventListener('change', function() {
            alert('Sorting functionality will be available in the live store.');
        });
    }

    // Add to cart buttons
    const addToCartBtns = document.querySelectorAll('.add-to-cart-btn');
    addToCartBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            alert('Item added to cart!');
        });
    });

    // Wishlist buttons
    const wishlistBtns = document.querySelectorAll('.wishlist-btn');
    wishlistBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            alert('Item added to wishlist!');
        });
    });
</script>

</body>
</html>