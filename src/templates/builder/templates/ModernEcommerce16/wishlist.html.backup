<!-- builder/templates/ModernEcommerce16/wishlist.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist - Éclat Lumière Luxury Skincare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --soft-blush: #FAEEE9;
            --champagne-glow: #F5D69B;
            --mauve-rose: #A77A95;
            --lavender-mist: #C3C3D5;
            --plum-brown: #735366;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        main {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
            /* padding-top: 100px; */
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Wishlist Hero Section */
        .wishlist-hero {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1 {
            font-size: 3rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--mauve-rose), var(--champagne-glow));
        }

        p {
            color: var(--plum-brown);
            font-size: 1rem;
            max-width: 600px;
            margin: 1rem auto 0;
            opacity: 0.8;
        }

        /* Wishlist Stats */
        .wishlist-stats {
            padding: 2rem 0;
            background-color: var(--soft-blush);
            border-bottom: 1px solid rgba(115, 83, 102, 0.1);
        }

        .stats-container {
            display: flex;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
        }

        .stat-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .stat-value {
            font-size: 2rem;
            color: var(--mauve-rose);
            font-weight: 500;
            font-family: 'Cormorant Garamond', serif;
        }

        .stat-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--plum-brown);
            opacity: 0.7;
        }

        /* Wishlist Content */
        .wishlist-content {
            padding: 3rem 0 4rem;
        }

        .wishlist-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .wishlist-filters {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 0.6rem 1.5rem;
            background: transparent;
            color: var(--plum-brown);
            font-size: 0.85rem;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 40px;
            cursor: pointer;
            transition: var(--transition);
            font-family: 'Montserrat', sans-serif;
        }

        .filter-btn:hover {
            border-color: var(--mauve-rose);
            color: var(--mauve-rose);
        }

        .filter-btn.active {
            background: var(--plum-brown);
            color: var(--soft-blush);
            border-color: var(--plum-brown);
        }

        .filter-all {
            font-size: 0.85rem;
        }

        .filter-sale {
            font-size: 0.85rem;
        }

        .filter-stock {
            font-size: 0.85rem;
        }

        .clear-wishlist-btn {
            padding: 0.6rem 1.5rem;
            background: transparent;
            color: var(--plum-brown);
            font-size: 0.85rem;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 40px;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .clear-wishlist-btn:hover {
            border-color: var(--mauve-rose);
            color: var(--mauve-rose);
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .wishlist-item {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            border: 1px solid rgba(195, 195, 213, 0.2);
            position: relative;
        }

        .wishlist-item:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px rgba(115, 83, 102, 0.12);
            border-color: var(--champagne-glow);
        }

        .wishlist-item-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .wishlist-item:hover .wishlist-item-image {
            transform: scale(1.05);
        }

        .wishlist-item-info {
            padding: 1.2rem;
            text-align: left;
        }

        .wishlist-item-category {
            color: var(--mauve-rose);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .wishlist-item-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.5rem;
            min-height: 2.8rem;
        }

        .wishlist-item-price {
            color: var(--mauve-rose);
            font-weight: 500;
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        .wishlist-item-actions {
            display: flex;
            gap: 0.8rem;
            margin-top: 1rem;
        }

        .add-to-cart-wishlist {
            flex: 1;
            background: var(--plum-brown);
            color: var(--soft-blush);
            padding: 0.6rem;
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 40px;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-to-cart-wishlist:hover {
            background: var(--mauve-rose);
            transform: translateY(-2px);
        }

        .remove-wishlist-btn {
            width: 38px;
            height: 38px;
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 50%;
            color: var(--plum-brown);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .remove-wishlist-btn:hover {
            background: rgba(167, 122, 149, 0.1);
            color: var(--mauve-rose);
            border-color: var(--mauve-rose);
            transform: scale(1.05);
        }

        /* Wishlist Item Badge */
        .wishlist-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: var(--champagne-glow);
            color: var(--plum-brown);
            padding: 0.3rem 0.8rem;
            font-size: 0.7rem;
            font-weight: 600;
            border-radius: 20px;
            z-index: 2;
            letter-spacing: 0.5px;
        }

        /* Empty Wishlist State */
        .empty-wishlist {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
            grid-column: 1 / -1;
        }

        .empty-wishlist-icon {
            font-size: 4rem;
            color: var(--champagne-glow);
            margin-bottom: 1.5rem;
        }

        .empty-wishlist h2 {
            font-size: 2rem;
            color: var(--plum-brown);
            margin-bottom: 1rem;
        }

        .empty-wishlist p {
            color: var(--plum-brown);
            opacity: 0.8;
            margin-bottom: 1.5rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .start-shopping-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 0.9rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
        }

        .start-shopping-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* Recently Viewed Section */
        .recently-viewed {
            margin-top: 3rem;
            padding-top: 3rem;
            border-top: 1px solid rgba(115, 83, 102, 0.1);
        }

        .recently-viewed h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: 2rem;
            color: var(--plum-brown);
        }

        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .recent-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .recent-product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(115, 83, 102, 0.1);
        }

        .recent-product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .recent-product-card:hover .recent-product-img {
            transform: scale(1.05);
        }

        .recent-product-info {
            padding: 1rem;
            text-align: center;
        }

        .recent-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.3rem;
        }

        .recent-product-price {
            color: var(--mauve-rose);
            font-weight: 500;
            font-size: 0.9rem;
        }

        /* Empty Recently Viewed State */
        .empty-recently-viewed {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            grid-column: 1 / -1;
        }

        .empty-recently-viewed p {
            color: var(--plum-brown);
            opacity: 0.8;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .wishlist-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .wishlist-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .stats-container {
                gap: 2rem;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            h1 {
                font-size: 2rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .wishlist-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            .recently-viewed-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            .wishlist-actions {
                flex-direction: column;
                align-items: stretch;
            }
            .wishlist-filters {
                justify-content: center;
            }
            .stats-container {
                gap: 1.5rem;
            }
            .stat-value {
                font-size: 1.5rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 1.8rem;
            }
            .stats-container {
                gap: 1rem;
            }
            .stat-value {
                font-size: 1.2rem;
            }
            .stat-label {
                font-size: 0.7rem;
            }
        }
    </style>
</head>
<body>

<main>
    <!-- Wishlist Hero Section -->
<div class="wishlist-hero editable-section" data-section="340">
    <div class="container">
        <h1 class="editable-text editable-section no-drop-zone" data-section="341" data-text="600">Your Wishlist</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="342" data-text="601">Save your favorite skincare treasures for later. Your wishlist is always here when you're ready to make them yours.</p>
    </div>
</div>

<!-- Wishlist Stats -->
<div class="wishlist-stats editable-section" data-section="343">
    <div class="container">
        <div class="stats-container">
            <div class="stat-item">
                <span class="stat-value editable-text editable-section no-drop-zone" data-section="344" data-text="602">4</span>
                <span class="stat-label editable-text editable-section no-drop-zone" data-section="345" data-text="603">Items Saved</span>
            </div>
            <div class="stat-item">
                <span class="stat-value editable-text editable-section no-drop-zone" data-section="344" data-text="604">1</span>
                <span class="stat-label editable-text editable-section no-drop-zone" data-section="345" data-text="605">On Sale</span>
            </div>
            <div class="stat-item">
                <span class="stat-value editable-text editable-section no-drop-zone" data-section="344" data-text="606">$470</span>
                <span class="stat-label editable-text editable-section no-drop-zone" data-section="345" data-text="607">Total Value</span>
            </div>
            <div class="stat-item">
                <span class="stat-value editable-text editable-section no-drop-zone" data-section="344" data-text="608">0</span>
                <span class="stat-label editable-text editable-section no-drop-zone" data-section="345" data-text="609">Low in Stock</span>
            </div>
        </div>
    </div>
</div>

<!-- Wishlist Content -->
<div class="container">
    <div class="wishlist-content">
        <div class="wishlist-actions">
            <div class="wishlist-filters">
                <button class="filter-btn active" data-filter="all">
                    <span class="editable-text editable-section no-drop-zone" data-section="346" data-text="610">All Items</span>
                </button>
                <button class="filter-btn" data-filter="on-sale">
                    <span class="editable-text editable-section no-drop-zone" data-section="347" data-text="611">On Sale</span>
                </button>
                <button class="filter-btn" data-filter="in-stock">
                    <span class="editable-text editable-section no-drop-zone" data-section="348" data-text="612">In Stock</span>
                </button>
            </div>
            <button class="clear-wishlist-btn editable-text editable-section no-drop-zone" data-section="349" data-text="613" id="clearWishlistBtn">
                <i class="fas fa-trash-alt editable-icon" data-icon="400"></i> Clear All
            </button>
        </div>

        <div class="wishlist-grid">
            <!-- Wishlist Item 1 (Editable - applies to all wishlist items in public template) -->
            <div class="wishlist-item editable-section no-drop-zone" data-section="350" data-category="serum" data-stock="in-stock">
                <img src="https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=300&auto=format" alt="Lumière Radiance Serum" class="wishlist-item-image editable-image" data-image="400">
                <div class="wishlist-badge editable-text editable-section no-drop-zone" data-section="355" data-text="614">BESTSELLER</div>
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category editable-section no-drop-zone" data-section="351" data-text="615">SERUM</div>
                    <div class="wishlist-item-name editable-section no-drop-zone" data-section="352" data-text="616">Lumière Radiance Serum</div>
                    <div class="wishlist-item-price editable-section no-drop-zone" data-section="353" data-text="617">$128</div>
                    <div class="wishlist-item-actions">
                        <button class="add-to-cart-wishlist editable-text editable-section no-drop-zone" data-section="354" data-text="618">
                            <i class="fas fa-shopping-bag editable-icon" data-icon="401"></i> Add to Cart
                        </button>
                        <button class="remove-wishlist-btn">
                            <i class="fas fa-times editable-icon" data-icon="402"></i>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Wishlist Item 2 (Non-editable sample) -->
            <div class="wishlist-item" data-category="moisturizer" data-stock="in-stock">
                <img src="https://images.unsplash.com/photo-1596462502278-27bfdc5e29f2?w=300&auto=format" alt="Silk Velvet Crème" class="wishlist-item-image">
                <div class="wishlist-badge" style="background: var(--mauve-rose);">NEW</div>
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category">MOISTURIZER</div>
                    <div class="wishlist-item-name">Silk Velvet Crème</div>
                    <div class="wishlist-item-price">$96</div>
                    <div class="wishlist-item-actions">
                        <button class="add-to-cart-wishlist"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="remove-wishlist-btn"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>
            <!-- Wishlist Item 3 (Non-editable sample) -->
            <div class="wishlist-item" data-category="cleanser" data-stock="low-stock">
                <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=300&auto=format" alt="Nectar Milk Cleanser" class="wishlist-item-image">
                <div class="wishlist-badge" style="background: #dc3545;">LOW STOCK</div>
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category">CLEANSER</div>
                    <div class="wishlist-item-name">Nectar Milk Cleanser</div>
                    <div class="wishlist-item-price">$54</div>
                    <div class="wishlist-item-actions">
                        <button class="add-to-cart-wishlist"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="remove-wishlist-btn"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>
            <!-- Wishlist Item 4 (Non-editable sample) -->
            <div class="wishlist-item" data-category="mask" data-stock="in-stock" data-sale="true">
                <img src="https://images.unsplash.com/photo-1611085583191-a3b181a66901?w=300&auto=format" alt="Midnight Gold Mask" class="wishlist-item-image">
                <div class="wishlist-badge" style="background: #28a745;">SALE</div>
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category">MASK</div>
                    <div class="wishlist-item-name">Midnight Gold Mask</div>
                    <div class="wishlist-item-price"><span style="text-decoration: line-through; font-size: 0.8rem;">$142</span> $128</div>
                    <div class="wishlist-item-actions">
                        <button class="add-to-cart-wishlist"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="remove-wishlist-btn"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recently Viewed Section -->
    <div class="recently-viewed editable-section" data-section="359">
        <h2 class="editable-text editable-section no-drop-zone" data-section="360" data-text="619">Recently Viewed</h2>
        <div class="recently-viewed-grid">
            <!-- Recent Product 1 (Editable) -->
            <div class="recent-product-card">
                <img src="https://images.unsplash.com/photo-1596462502278-27bfdc5e29f2?w=300&auto=format" alt="Silk Velvet Crème" class="recent-product-img editable-image" data-image="401">
                <div class="recent-product-info">
                    <div class="recent-product-name editable-text editable-section no-drop-zone" data-section="361" data-text="620">Silk Velvet Crème</div>
                    <div class="recent-product-price editable-text editable-section no-drop-zone" data-section="362" data-text="621">$96</div>
                </div>
            </div>
            <!-- Recent Product 2 (Non-editable) -->
            <div class="recent-product-card">
                <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=300&auto=format" alt="Nectar Milk Cleanser" class="recent-product-img">
                <div class="recent-product-info">
                    <div class="recent-product-name">Nectar Milk Cleanser</div>
                    <div class="recent-product-price">$54</div>
                </div>
            </div>
            <!-- Recent Product 3 (Non-editable) -->
            <div class="recent-product-card">
                <img src="https://images.unsplash.com/photo-1611085583191-a3b181a66901?w=300&auto=format" alt="Midnight Gold Mask" class="recent-product-img">
                <div class="recent-product-info">
                    <div class="recent-product-name">Midnight Gold Mask</div>
                    <div class="recent-product-price">$142</div>
                </div>
            </div>
            <!-- Recent Product 4 (Non-editable) -->
            <div class="recent-product-card">
                <img src="https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=300&auto=format" alt="Radiance Eye Cream" class="recent-product-img">
                <div class="recent-product-info">
                    <div class="recent-product-name">Radiance Eye Cream</div>
                    <div class="recent-product-price">$78</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Empty Wishlist State (hidden by default) -->
<div class="empty-wishlist" style="display: none;">
    <div class="empty-wishlist-icon">
        <i class="far fa-heart editable-icon" data-icon="403"></i>
    </div>
    <h2 class="editable-text editable-section no-drop-zone" data-section="356" data-text="622">Your Wishlist is Empty</h2>
    <p class="editable-text editable-section no-drop-zone" data-section="357" data-text="623">Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready.</p>
    <a href="?page=products" class="start-shopping-btn editable-text editable-section no-drop-zone" data-section="358" data-text="624">Start Shopping →</a>
</div>

<!-- Empty Recently Viewed State (hidden by default) -->
<div class="empty-recently-viewed" style="display: none;">
    <p class="editable-text editable-section no-drop-zone" data-section="363" data-text="625">Products you view will appear here. Start exploring our collection!</p>
</div>

</main>
<script>
    // Wishlist Filtering
    const filterBtns = document.querySelectorAll('.filter-btn');
    const wishlistItems = document.querySelectorAll('.wishlist-item');
    
    filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            filterBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const filter = this.getAttribute('data-filter');
            
            wishlistItems.forEach(item => {
                const category = item.getAttribute('data-category');
                const stock = item.getAttribute('data-stock');
                const onSale = item.hasAttribute('data-sale');
                
                let show = false;
                if (filter === 'all') {
                    show = true;
                } else if (filter === 'on-sale') {
                    show = onSale;
                } else if (filter === 'in-stock') {
                    show = stock === 'in-stock';
                }
                
                item.style.display = show ? 'block' : 'none';
            });
        });
    });
    
    // Remove wishlist items
    document.querySelectorAll('.remove-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const wishlistItem = this.closest('.wishlist-item');
            if (wishlistItem) {
                wishlistItem.remove();
                updateWishlistStats();
            }
        });
    });
    
    // Clear all wishlist items
    const clearWishlistBtn = document.getElementById('clearWishlistBtn');
    if (clearWishlistBtn) {
        clearWishlistBtn.addEventListener('click', function() {
            if (confirm('Are you sure you want to clear your entire wishlist?')) {
                document.querySelectorAll('.wishlist-item').forEach(item => item.remove());
                updateWishlistStats();
                document.querySelector('.empty-wishlist').style.display = 'block';
                document.querySelector('.wishlist-grid').style.display = 'none';
            }
        });
    }
    
    // Update wishlist stats
    function updateWishlistStats() {
        const items = document.querySelectorAll('.wishlist-item');
        const itemCount = items.length;
        let totalValue = 0;
        let onSaleCount = 0;
        let lowStockCount = 0;
        
        items.forEach(item => {
            const priceText = item.querySelector('.wishlist-item-price').textContent;
            const priceMatch = priceText.match(/\$(\d+)/);
            if (priceMatch) {
                totalValue += parseInt(priceMatch[1]);
            }
            if (item.hasAttribute('data-sale')) {
                onSaleCount++;
            }
            if (item.getAttribute('data-stock') === 'low-stock') {
                lowStockCount++;
            }
        });
        
        const statValues = document.querySelectorAll('.stat-value');
        if (statValues.length >= 4) {
            statValues[0].textContent = itemCount;
            statValues[1].textContent = onSaleCount;
            statValues[2].textContent = `$${totalValue}`;
            statValues[3].textContent = lowStockCount;
        }
        
        if (itemCount === 0) {
            document.querySelector('.empty-wishlist').style.display = 'block';
            document.querySelector('.wishlist-grid').style.display = 'none';
        }
    }
    
    // Add to cart from wishlist
    document.querySelectorAll('.add-to-cart-wishlist').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            alert('Item added to cart!');
        });
    });
    
    // Initialize stats
    updateWishlistStats();
</script>

</body>
</html>