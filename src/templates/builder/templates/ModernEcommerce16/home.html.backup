<!-- builder/templates/ModernEcommerce16/home.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Éclat Lumière - Luxury Skincare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
:root {
    /* Index 0: Background */
    --soft-blush: #FAEEE9;
    
    /* Index 1: Text */
    --plum-brown: #735366;
    
    /* Index 2: Heading */
    --plum-brown: #735366;
    
    /* Index 3: Primary */
    --plum-brown: #735366;
    
    /* Index 4: Secondary */
    --mauve-rose: #A77A95;
    
    /* Index 5: Accent */
    --champagne-glow: #F5D69B;
    
    /* Index 6: Border */
    --lavender-mist: #C3C3D5;
    
    /* Index 7: Success */
    --mauve-rose: #A77A95;
    
    /* Index 8: Warning */
    --champagne-glow: #F5D69B;
    
    /* Index 9: Error */
    --mauve-rose: #A77A95;
    
    /* Remaining variables (keep as-is after index 9) */
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4, .logo a, .hero-headline {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Header / Navigation */
        header{
            position: sticky;
            top: 0;
            width: 100%;
            z-index: 1000;
            padding: 1.2rem 0;
            background-color: rgba(250, 238, 233, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(167, 122, 149, 0.15);
            transition: var(--transition);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo a {
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--plum-brown);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span {
            font-weight: 300;
            font-size: 0.9rem;
            letter-spacing: 2px;
            color: var(--mauve-rose);
            margin-left: 6px;
        }

        .desktop-nav {
            display: flex;
            gap: 2.5rem;
            list-style: none;
        }

        .desktop-nav a {
            text-decoration: none;
            color: var(--plum-brown);
            font-weight: 400;
            font-size: 0.95rem;
            transition: var(--transition);
            letter-spacing: 0.5px;
        }

        .desktop-nav a:hover {
            color: var(--mauve-rose);
        }

        .nav-icons {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .icon-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 1.2rem;
            color: var(--plum-brown);
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }

        .icon-btn:hover {
            color: var(--mauve-rose);
        }

        .cart-counter, .wishlist-counter {
            position: absolute;
            top: -8px;
            right: -12px;
            background-color: var(--mauve-rose);
            color: var(--soft-blush);
            padding: 0.2rem 0.5rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
        }

        /* Account Dropdown */
        .account-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--soft-blush);
            min-width: 200px;
            box-shadow: 0 8px 25px rgba(115, 83, 102, 0.1);
            z-index: 1;
            border-radius: var(--border-radius);
            overflow: hidden;
            margin-top: 10px;
            border: 1px solid rgba(167, 122, 149, 0.2);
        }

        .dropdown-content a {
            color: var(--plum-brown);
            padding: 0.8rem 1.5rem;
            text-decoration: none;
            display: block;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .dropdown-content a:hover {
            background-color: rgba(245, 214, 155, 0.3);
            color: var(--mauve-rose);
        }

        .account-dropdown:hover .dropdown-content {
            display: block;
        }

        /* Hamburger Menu */
        .hamburger {
            display: none;
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--plum-brown);
            background: none;
            border: none;
        }

        .mobile-nav {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--soft-blush);
            z-index: 9999;
            padding: 2rem;
            transform: translateX(-100%);
            transition: transform 0.4s ease;
        }

        .mobile-nav.active {
            transform: translateX(0);
        }

        .mobile-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(115, 83, 102, 0.1);
        }

        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-nav-links a {
            text-decoration: none;
            color: var(--plum-brown);
            font-size: 1.2rem;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(115, 83, 102, 0.05);
        }

        .back-button {
            background: none;
            border: none;
            font-size: 1rem;
            color: var(--plum-brown);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'Montserrat', sans-serif;
        }

        /* Hero Section */
        section.hero {
            position: relative;
            min-height: 85vh;
            display: flex;
            align-items: center;
            overflow: hidden;
           
        }
        .hero{
width: 100%;
    height: 100%;
    background-image: url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1600&auto=format');
    background-size: cover;
    background-position: center 30%;
    z-index: 1;
}

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: 70% 20%;
            z-index: 1;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, rgba(250, 238, 233, 0.85) 0%, rgba(250, 238, 233, 0.4) 70%);
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            max-width: 600px;
            padding: 2rem 0;
        }

        h1 {
            font-size: 3.5rem;
            font-weight: 500;
            color: var(--plum-brown);
            line-height: 1.2;
            margin-bottom: 1rem;
        }

        p {
            font-size: 1rem;
            line-height: 1.6;
            color: var(--plum-brown);
            margin-bottom: 2rem;
            font-weight: 400;
            max-width: 450px;
        }

        a.cta-btn {
            display: inline-block;
            background-color: var(--plum-brown);
            color: var(--soft-blush);
            padding: 0.9rem 2.4rem;
            font-weight: 500;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            font-size: 0.9rem;
            letter-spacing: 1px;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(115, 83, 102, 0.15);
        }

        a.cta-btn:hover {
            background-color: var(--mauve-rose);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* New Arrivals Section */
        section.new-arrivals {
            padding: var(--spacing-xl) 0;
            text-align: center;
        }

        .section-header {
            margin-bottom: var(--spacing-lg);
        }

        h2 {
            font-size: 2.5rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.5rem;
        }

        p {
            color: var(--plum-brown);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
            opacity: 0.8;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        div.product-card {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(2px);
            border-radius: 24px;
            padding: 1.2rem 1rem 1.5rem;
            transition: var(--transition);
            text-align: center;
            box-shadow: 0 4px 12px rgba(115, 83, 102, 0.03);
            border: 1px solid rgba(195, 195, 213, 0.2);
        }

        div.product-card:hover {
            transform: scale(1.02);
            box-shadow: 0 20px 30px -12px rgba(115, 83, 102, 0.12);
            background: #fffcf9;
            border-color: var(--champagne-glow);
        }

        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            border-radius: 20px;
            margin-bottom: 1rem;
            box-shadow: 0 6px 12px rgba(0,0,0,0.02);
        }

        .product-category {
            color: var(--mauve-rose);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            margin: 0.5rem 0 0.25rem;
            color: var(--plum-brown);
        }

        .product-price {
            font-weight: 500;
            font-size: 1rem;
            color: var(--mauve-rose);
        }

        .see-more {
            display: inline-block;
            background-color: transparent;
            color: var(--mauve-rose);
            padding: 0.8rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            border: 1px solid var(--mauve-rose);
        }

        .see-more:hover {
            background-color: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Footer Section */
        footer.editable-section[data-section="25"] {
            background-color: var(--plum-brown);
            color: var(--soft-blush);
            padding: 4rem 0 2rem;
            margin-top: 4rem;
        }

        .footer-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .footer-column {
            min-width: 0;
        }

        .footer-column h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            color: var(--champagne-glow);
            position: relative;
            display: inline-block;
        }

        .footer-column h3::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 40px;
            height: 2px;
            background: var(--champagne-glow);
        }

        .footer-column p {
            color: rgba(250, 238, 233, 0.8);
            line-height: 1.6;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }

        .footer-column ul {
            list-style: none;
            padding: 0;
        }

        .footer-column ul li {
            margin-bottom: 0.8rem;
        }

        .footer-column ul li a {
            color: rgba(250, 238, 233, 0.8);
            text-decoration: none;
            transition: var(--transition);
            font-size: 0.9rem;
        }

        .footer-column ul li a:hover {
            color: var(--champagne-glow);
            transform: translateX(5px);
            display: inline-block;
        }

        /* Social Media Section */
        .footer-social {
            margin-top: 1.5rem;
        }

        .footer-social h4 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            color: var(--champagne-glow);
        }

        .social-links {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .social-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(250, 238, 233, 0.1);
            color: var(--soft-blush);
            text-decoration: none;
            transition: all 0.3s ease;
            border: 1px solid rgba(250, 238, 233, 0.2);
        }

        .social-link:hover {
            transform: translateY(-3px);
            background: var(--champagne-glow);
            color: var(--plum-brown);
            border-color: var(--champagne-glow);
        }

        .social-link i {
            font-size: 1.1rem;
        }

        /* Newsletter Section */
        .footer-newsletter {
            margin-top: 1.5rem;
        }

        .footer-newsletter h4 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            color: var(--champagne-glow);
        }

        .newsletter-form {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .newsletter-input {
            flex: 1;
            padding: 0.8rem 1rem;
            background: rgba(250, 238, 233, 0.1);
            border: 1px solid rgba(250, 238, 233, 0.2);
            border-radius: 40px;
            color: var(--soft-blush);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
        }

        .newsletter-input::placeholder {
            color: rgba(250, 238, 233, 0.5);
        }

        .newsletter-btn {
            padding: 0.8rem 1.5rem;
            background: var(--champagne-glow);
            color: var(--plum-brown);
            border: none;
            border-radius: 40px;
            cursor: pointer;
            transition: var(--transition);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .newsletter-btn:hover {
            background: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Contact Info */
        .contact-info {
            margin-top: 1rem;
        }

        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 1rem;
            color: rgba(250, 238, 233, 0.8);
            font-size: 0.9rem;
        }

        .contact-info-item i {
            width: 20px;
            color: var(--champagne-glow);
        }

        .contact-info-item a {
            color: rgba(250, 238, 233, 0.8);
            text-decoration: none;
        }

        .contact-info-item a:hover {
            color: var(--champagne-glow);
        }

        /* Footer Bottom */
        .footer-bottom {
            text-align: center;
            padding-top: 2rem;
            border-top: 1px solid rgba(250, 238, 233, 0.1);
            font-size: 0.8rem;
            color: rgba(250, 238, 233, 0.6);
        }

        .footer-bottom-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .footer-bottom-links a {
            color: rgba(250, 238, 233, 0.8);
            text-decoration: none;
        }

        .footer-bottom-links a:hover {
            color: var(--champagne-glow);
        }

        .copyright-text {
            font-size: 0.8rem;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
        }

        .empty-state h3 {
            color: var(--plum-brown);
            margin-bottom: 1rem;
        }

        .empty-state a {
            color: var(--mauve-rose);
            text-decoration: none;
            font-weight: 500;
        }

        .empty-state a:hover {
            text-decoration: underline;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }
            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
            }
            h1 {
                font-size: 3rem;
            }
        }

        @media (max-width: 992px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1 {
                font-size: 2.8rem;
            }
            .desktop-nav {
                display: none;
            }
            .hamburger {
                display: block;
            }
        }

        @media (max-width: 768px) {
            section.hero {
                min-height: 70vh;
                justify-content: center;
                text-align: center;
            }
            .hero-content {
                text-align: center;
                margin: 0 auto;
                padding: 0 1rem;
            }
            p {
                margin-left: auto;
                margin-right: auto;
            }
            .hero-overlay {
                background: linear-gradient(0deg, rgba(250, 238, 233, 0.85) 0%, rgba(250, 238, 233, 0.5) 100%);
            }
            .products-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .footer-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            h2 {
                font-size: 2rem;
            }
            .container, .footer-container {
                padding: 0 1.5rem;
            }
            .newsletter-form {
                flex-direction: column;
            }
            .newsletter-btn {
                width: 100%;
            }
            .footer-bottom-links {
                flex-direction: column;
                gap: 0.5rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 2rem;
            }
            a.cta-btn,
            .see-more {
                padding: 0.7rem 1.8rem;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>

<!-- Header -->
<header class="editable-section no-drop-zone" data-section="1">
    <div class="container header-container">
        <div class="logo">
            <a href="?page=home">
                <i class="fas fa-spa editable-icon" data-icon="1" data-default-class="fas fa-spa"></i>
                <span class="editable-text editable-section no-drop-zone" data-section="2" data-text="1">Éclat<span>Lumière</span></span>
            </a>
        </div>
        <nav class="desktop-nav">
            <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="3" data-text="2">Home</a>
            <a href="?page=products" class="editable-text editable-section no-drop-zone" data-section="4" data-text="3">Shop</a>
            <a href="?page=about" class="editable-text editable-section no-drop-zone" data-section="5" data-text="4">About Us</a>
            <a href="?page=contact" class="editable-text editable-section no-drop-zone" data-section="6" data-text="5">Contact</a>
        </nav>
        <div class="nav-icons">
            <a href="?page=cart" class="icon-btn">
                <span class="cart-counter">0</span>
                <i class="fas fa-shopping-bag editable-icon" data-icon="2" data-default-class="fas fa-shopping-bag"></i>
            </a>
            <a href="?page=wishlist" class="icon-btn">
                <span class="wishlist-counter">0</span>
                <i class="far fa-heart editable-icon" data-icon="3" data-default-class="far fa-heart"></i>
            </a>
            <div class="account-dropdown">
                <i class="far fa-user editable-icon" data-icon="4" data-default-class="far fa-user"></i>
                <div class="dropdown-content">
                    <a href="?page=login" class="editable-section editable-text no-drop-zone" data-section="7" data-text="6">Sign In</a>
                    <a href="?page=register" class="editable-section editable-text no-drop-zone" data-section="8" data-text="7">Sign Up</a>
                    <a href="?page=orders" class="editable-section editable-text no-drop-zone" data-section="9" data-text="8">Orders</a>
                    <a href="?page=wishlist" class="editable-section editable-text no-drop-zone" data-section="10" data-text="9">Wishlist</a>
                    <a href="?page=logout" class="editable-section editable-text no-drop-zone" data-section="11" data-text="10">Logout</a>
                </div>
            </div>
            <button class="hamburger" id="hamburgerBtn">
                <i class="fas fa-bars editable-icon" data-icon="5" data-default-class="fas fa-bars"></i>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Navigation -->
<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="?page=home" class="logo">Éclat<span>Lumière</span></a>
        <button class="back-button" id="closeNav">
            <i class="fas fa-times editable-icon" data-icon="6" data-default-class="fas fa-times"></i>
        </button>
    </div>
    <div class="mobile-nav-links">
        <a href="?page=home">Home</a>
        <a href="?page=products">Shop</a>
        <a href="?page=about">About Us</a>
        <a href="?page=contact">Contact</a>
        <a href="?page=cart"><i class="fas fa-shopping-bag editable-icon" data-icon="2" data-default-class="fas fa-shopping-bag"></i> Cart</a>
        <a href="?page=wishlist"><i class="far fa-heart editable-icon" data-icon="3" data-default-class="far fa-heart"></i> Wishlist</a>
        <a href="?page=account"><i class="far fa-user editable-icon" data-icon="4" data-default-class="far fa-user"></i> Account</a>
    </div>
</div>

<!-- Hero Section -->
<section class="hero editable-section" data-section="13">
