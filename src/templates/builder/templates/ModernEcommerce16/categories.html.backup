<!-- builder/templates/ModernEcommerce16/categories.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - Éclat Lumière Luxury Skincare</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --soft-blush: #FAEEE9;
            --champagne-glow: #F5D69B;
            --mauve-rose: #A77A95;
            --lavender-mist: #C3C3D5;
            --plum-brown: #735366;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        main {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1 {
            font-size: 3rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 2px;
            background: linear-gradient(90deg, var(--mauve-rose), var(--champagne-glow));
        }

        p {
            color: var(--plum-brown);
            font-size: 1.1rem;
            max-width: 700px;
            margin: 1rem auto 0;
            opacity: 0.8;
        }

        /* Categories Filter */
        .categories-filter {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
        }

        .filter-cat-btn {
            padding: 0.7rem 1.8rem;
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 40px;
            color: var(--plum-brown);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-cat-btn:hover {
            border-color: var(--mauve-rose);
            color: var(--mauve-rose);
            transform: translateY(-2px);
        }

        .filter-cat-btn.active {
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            border-color: transparent;
        }

        .filter-all {
            font-size: 0.9rem;
        }

        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-xl);
        }

        .category-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            border: 1px solid rgba(195, 195, 213, 0.2);
            position: relative;
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 30px rgba(115, 83, 102, 0.12);
            border-color: var(--champagne-glow);
        }

        .category-image-container {
            position: relative;
            overflow: hidden;
            aspect-ratio: 1 / 1;
        }

        .category-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .category-card:hover .category-image {
            transform: scale(1.1);
        }

        .category-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(115, 83, 102, 0.8), transparent);
            padding: 1.5rem;
            color: var(--soft-blush);
        }

        .category-overlay h3 {
            font-size: 1.3rem;
            margin-bottom: 0.3rem;
            color: var(--soft-blush);
        }

        .category-overlay .product-count {
            font-size: 0.8rem;
            opacity: 0.9;
        }

        .category-info {
            padding: 1.2rem;
            text-align: center;
        }

        .category-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.3rem;
        }

        .category-description {
            color: var(--plum-brown);
            font-size: 0.85rem;
            line-height: 1.5;
            margin-bottom: 1rem;
            opacity: 0.7;
        }

        .explore-btn {
            display: inline-block;
            background: transparent;
            color: var(--mauve-rose);
            border: 1px solid var(--mauve-rose);
            padding: 0.5rem 1.2rem;
            font-size: 0.8rem;
            border-radius: 40px;
            transition: var(--transition);
            cursor: pointer;
            text-decoration: none;
        }

        .explore-btn:hover {
            background: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Featured Collections Section */
        .featured-collections {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(115, 83, 102, 0.1);
        }

        .featured-collections h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--plum-brown);
        }

        .collections-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .collection-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
            cursor: pointer;
        }

        .collection-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(115, 83, 102, 0.1);
        }

        .collection-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .collection-card:hover .collection-image {
            transform: scale(1.05);
        }

        .collection-info {
            padding: 1.2rem;
            text-align: center;
        }

        .collection-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.5rem;
        }

        .collection-description {
            color: var(--plum-brown);
            font-size: 0.85rem;
            line-height: 1.5;
            margin-bottom: 1rem;
            opacity: 0.7;
        }

        .view-collection-btn {
            display: inline-block;
            background: transparent;
            color: var(--mauve-rose);
            border: 1px solid var(--mauve-rose);
            padding: 0.5rem 1.2rem;
            font-size: 0.8rem;
            border-radius: 40px;
            transition: var(--transition);
        }

        .view-collection-btn:hover {
            background: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Empty State */
        .empty-categories {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
            grid-column: 1 / -1;
        }

        .empty-categories-icon {
            font-size: 4rem;
            color: var(--champagne-glow);
            margin-bottom: 1.5rem;
        }

        .empty-categories h2 {
            font-size: 2rem;
            color: var(--plum-brown);
            margin-bottom: 1rem;
        }

        .empty-categories p {
            color: var(--plum-brown);
            opacity: 0.8;
            margin-bottom: 1.5rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .add-category-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 0.9rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
        }

        .add-category-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .collections-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .collections-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            main{
                padding-top: 80px;
            }
            h1 {
                font-size: 2rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .categories-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            .collections-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            .categories-filter {
                gap: 0.8rem;
            }
            .filter-cat-btn {
                padding: 0.6rem 1.2rem;
                font-size: 0.8rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 1.8rem;
            }
            p {
                font-size: 1rem;
            }
            .categories-filter {
                flex-direction: column;
                align-items: stretch;
            }
            .filter-cat-btn {
                text-align: center;
            }
        }
    </style>
</head>
<body>

<main>
    <!-- Page Header -->
<div class="page-header editable-section" data-section="375">
    <div class="container">
        <h1 class="editable-text editable-section no-drop-zone" data-section="376" data-text="700">Shop by Category</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="377" data-text="701">Explore our curated skincare collections designed for every skin type and concern.</p>
    </div>
</div>

<!-- Categories Filter -->
<div class="container">
    <div class="categories-filter" id="categoriesFilter">
        <button class="filter-cat-btn active" data-filter="all">
            <span class="editable-text editable-section no-drop-zone" data-section="378" data-text="702">All Categories</span>
        </button>
        <button class="filter-cat-btn" data-filter="serum">Serums</button>
        <button class="filter-cat-btn" data-filter="moisturizer">Moisturizers</button>
        <button class="filter-cat-btn" data-filter="cleanser">Cleansers</button>
        <button class="filter-cat-btn" data-filter="mask">Masks</button>
        <button class="filter-cat-btn" data-filter="eye-care">Eye Care</button>
    </div>
</div>

<!-- Categories Grid -->
<div class="container">
    <div class="categories-grid">
        <!-- Category 1 (Editable - applies to all categories in public template) -->
        <div class="category-card editable-section no-drop-zone" data-section="379" data-category="serum">
            <div class="category-image-container">
                <img src="https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=400&auto=format" alt="Serums" class="category-image editable-image" data-image="500">
                <div class="category-overlay">
                    <h3>Serums</h3>
                    <div class="product-count">8 Products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-name editable-section editable-text no-drop-zone" data-section="380" data-text="703">Potent Serums</div>
                <div class="category-description editable-section editable-text no-drop-zone" data-section="381" data-text="704">Targeted treatments for radiant, youthful skin</div>
                <a href="?page=products&category=serum" class="explore-btn editable-text editable-section no-drop-zone" data-section="382" data-text="705">Explore →</a>
            </div>
        </div>
        <!-- Category 2 (Non-editable sample) -->
        <div class="category-card" data-category="moisturizer">
            <div class="category-image-container">
                <img src="https://images.unsplash.com/photo-1596462502278-27bfdc5e29f2?w=400&auto=format" alt="Moisturizers" class="category-image">
                <div class="category-overlay">
                    <h3>Moisturizers</h3>
                    <div class="product-count">6 Products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-name">Silky Moisturizers</div>
                <div class="category-description">Deep hydration for all-day comfort</div>
                <a href="?page=products&category=moisturizer" class="explore-btn">Explore →</a>
            </div>
        </div>
        <!-- Category 3 (Non-editable sample) -->
        <div class="category-card" data-category="cleanser">
            <div class="category-image-container">
                <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=400&auto=format" alt="Cleansers" class="category-image">
                <div class="category-overlay">
                    <h3>Cleansers</h3>
                    <div class="product-count">5 Products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-name">Gentle Cleansers</div>
                <div class="category-description">Purify without stripping natural oils</div>
                <a href="?page=products&category=cleanser" class="explore-btn">Explore →</a>
            </div>
        </div>
        <!-- Category 4 (Non-editable sample) -->
        <div class="category-card" data-category="mask">
            <div class="category-image-container">
                <img src="https://images.unsplash.com/photo-1611085583191-a3b181a66901?w=400&auto=format" alt="Masks" class="category-image">
                <div class="category-overlay">
                    <h3>Masks</h3>
                    <div class="product-count">4 Products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-name">Luxury Masks</div>
                <div class="category-description">Intensive treatments for glowing skin</div>
                <a href="?page=products&category=mask" class="explore-btn">Explore →</a>
            </div>
        </div>
        <!-- Category 5 (Non-editable sample) -->
        <div class="category-card" data-category="eye-care">
            <div class="category-image-container">
                <img src="https://images.unsplash.com/photo-1616671034383-4b13da6ffcc4?w=400&auto=format" alt="Eye Care" class="category-image">
                <div class="category-overlay">
                    <h3>Eye Care</h3>
                    <div class="product-count">3 Products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-name">Revitalizing Eye Creams</div>
                <div class="category-description">Brighten and smooth the delicate eye area</div>
                <a href="?page=products&category=eye-care" class="explore-btn">Explore →</a>
            </div>
        </div>
        <!-- Category 6 (Non-editable sample) -->
        <div class="category-card" data-category="toner">
            <div class="category-image-container">
                <img src="https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?w=400&auto=format" alt="Toners" class="category-image">
                <div class="category-overlay">
                    <h3>Toners</h3>
                    <div class="product-count">4 Products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-name">Balancing Toners</div>
                <div class="category-description">Prep skin for optimal absorption</div>
                <a href="?page=products&category=toner" class="explore-btn">Explore →</a>
            </div>
        </div>
    </div>

    <!-- Featured Collections Section -->
    <div class="featured-collections editable-section" data-section="383">
        <h2 class="editable-text editable-section no-drop-zone" data-section="384" data-text="706">Featured Collections</h2>
        <div class="collections-grid">
            <!-- Collection 1 (Editable) -->
            <div class="collection-card">
                <img src="https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=400&auto=format" alt="Radiance Collection" class="collection-image editable-image" data-image="501">
                <div class="collection-info">
                    <div class="collection-name editable-text editable-section no-drop-zone" data-section="385" data-text="707">Radiance Collection</div>
                    <div class="collection-description editable-text editable-section no-drop-zone" data-section="386" data-text="708">Brightening essentials for luminous skin</div>
                    <span class="view-collection-btn editable-text editable-section no-drop-zone" data-section="387" data-text="709">View Collection →</span>
                </div>
            </div>
            <!-- Collection 2 (Non-editable) -->
            <div class="collection-card">
                <img src="https://images.unsplash.com/photo-1596462502278-27bfdc5e29f2?w=400&auto=format" alt="Hydration Collection" class="collection-image">
                <div class="collection-info">
                    <div class="collection-name">Hydration Collection</div>
                    <div class="collection-description">Deep moisture for supple, plump skin</div>
                    <span class="view-collection-btn">View Collection →</span>
                </div>
            </div>
            <!-- Collection 3 (Non-editable) -->
            <div class="collection-card">
                <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=400&auto=format" alt="Anti-Aging Collection" class="collection-image">
                <div class="collection-info">
                    <div class="collection-name">Anti-Aging Collection</div>
                    <div class="collection-description">Youth-boosting formulas for mature skin</div>
                    <span class="view-collection-btn">View Collection →</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Empty Categories State (hidden by default) -->
<div class="empty-categories" style="display: none;">
    <div class="empty-categories-icon">
        <i class="fas fa-gem editable-icon" data-icon="500"></i>
    </div>
    <h2 class="editable-text editable-section no-drop-zone" data-section="388" data-text="710">No Categories Available</h2>
    <p class="editable-text editable-section no-drop-zone" data-section="389" data-text="711">There are no skincare categories to display at the moment. Categories will appear here once they are added to your store.</p>
    <a href="/admin/add-category" class="add-category-btn editable-text editable-section no-drop-zone" data-section="390" data-text="712">Add Your First Category →</a>
</div>

</main>
<script>
    // Category Filtering
    const filterButtons = document.querySelectorAll('.filter-cat-btn');
    const categoryCards = document.querySelectorAll('.category-card');
    
    if (filterButtons.length > 0 && categoryCards.length > 0) {
        filterButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                filterButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const filter = this.getAttribute('data-filter');
                
                categoryCards.forEach(card => {
                    const category = card.getAttribute('data-category');
                    if (filter === 'all' || category === filter) {
                        card.style.display = 'block';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    }
    
    // Collection card click
    const collectionCards = document.querySelectorAll('.collection-card');
    collectionCards.forEach(card => {
        card.addEventListener('click', function() {
            const collectionName = this.querySelector('.collection-name')?.textContent || 'Unknown';
            alert(`Exploring ${collectionName}`);
        });
    });
    
    // Explore buttons
    const exploreBtns = document.querySelectorAll('.explore-btn');
    exploreBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const categoryName = this.closest('.category-card')?.querySelector('.category-name')?.textContent || 'Unknown';
            alert(`Browsing ${categoryName}`);
        });
    });
</script>

</body>
</html>