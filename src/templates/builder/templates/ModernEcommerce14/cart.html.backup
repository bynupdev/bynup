<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - Timeless Elegance Jewelry</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-luxury: #fbf9e2;
            --accent-rich: #965123;
            --metallic-gold: #bf8039;
            --deep-elegance: #462415;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 8px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        main {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-luxury);
            color: var(--deep-elegance);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* main {
            padding-top: 100px;
        } */

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1.cart-title {
            font-size: 3.5rem;
            color: var(--deep-elegance);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1.cart-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--metallic-gold), var(--accent-rich));
        }

        /* Cart Content Layout */
        .cart-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Cart Items Section */
        .cart-items {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(70, 36, 21, 0.05);
            padding: var(--spacing-md);
        }

        .cart-items-header {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(70, 36, 21, 0.1);
            font-weight: 500;
            color: var(--deep-elegance);
            margin-bottom: var(--spacing-md);
        }

        .cart-items-header {
            font-weight: 500;
        }

        .cart-item {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            align-items: center;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid rgba(70, 36, 21, 0.05);
            transition: var(--transition);
        }

        .cart-item:hover {
            background: rgba(251, 249, 226, 0.2);
        }

        /* Non-editable cart items (for backend population) */
        .cart-item:not([class*="editable-section"]) {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            align-items: center;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid rgba(70, 36, 21, 0.05);
            transition: var(--transition);
        }

        .cart-item:not([class*="editable-section"]):hover {
            background: rgba(251, 249, 226, 0.2);
        }

        /* Product Info in Cart */
        .cart-product-info {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }

        .cart-product-image {
            width: 100px;
            height: 100px;
            border-radius: calc(var(--border-radius) - 2px);
            background-size: cover;
            background-position: center;
            flex-shrink: 0;
        }

        .cart-product-details {
            flex: 1;
        }

        .cart-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            color: var(--deep-elegance);
            margin-bottom: 0.3rem;
        }

        .cart-product-category {
            color: var(--metallic-gold);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .cart-product-variant {
            font-size: 0.9rem;
            color: rgba(70, 36, 21, 0.7);
        }

        .cart-product-price {
            font-size: 1.3rem;
            color: var(--accent-rich);
            font-weight: 500;
        }

        /* Quantity Controls */
        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .quantity-btn {
            width: 32px;
            height: 32px;
            background: white;
            border: 1px solid rgba(70, 36, 21, 0.2);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.1rem;
            color: var(--deep-elegance);
        }

        .quantity-btn:hover {
            background: var(--bg-luxury);
            border-color: var(--metallic-gold);
            color: var(--accent-rich);
        }

        .quantity-input {
            width: 50px;
            height: 32px;
            text-align: center;
            border: 1px solid rgba(70, 36, 21, 0.2);
            border-radius: 4px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
        }

        .quantity-input:focus {
            outline: none;
            border-color: var(--metallic-gold);
        }

        .item-total {
            font-size: 1.3rem;
            color: var(--accent-rich);
            font-weight: 500;
        }

        /* Remove Button */
        .remove-btn {
            background: none;
            border: none;
            color: rgba(70, 36, 21, 0.5);
            cursor: pointer;
            font-size: 1.2rem;
            transition: var(--transition);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
        }

        .remove-btn:hover {
            color: var(--accent-rich);
            background: rgba(150, 81, 35, 0.1);
        }

        /* Cart Summary */
        .cart-summary {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(70, 36, 21, 0.05);
            padding: var(--spacing-md);
            height: fit-content;
            position: sticky;
            top: 120px;
        }

        .cart-summary h2 {
            font-size: 1.8rem;
            margin-bottom: var(--spacing-md);
            color: var(--deep-elegance);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(70, 36, 21, 0.1);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            color: var(--deep-elegance);
        }

        .summary-row.total {
            font-size: 1.3rem;
            font-weight: 500;
            color: var(--accent-rich);
            margin-top: var(--spacing-sm);
            padding-top: var(--spacing-sm);
            border-top: 1px solid rgba(70, 36, 21, 0.1);
        }

        /* Promo Code */
        .promo-code {
            margin: var(--spacing-md) 0;
        }

        .promo-code h3 {
            font-size: 1.1rem;
            margin-bottom: 0.8rem;
            color: var(--deep-elegance);
        }

        .promo-input-group {
            display: flex;
            gap: 0.5rem;
        }

        .promo-input {
            flex: 1;
            padding: 0.8rem 1rem;
            border: 1px solid rgba(70, 36, 21, 0.2);
            border-radius: var(--border-radius);
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
        }

        .promo-input:focus {
            outline: none;
            border-color: var(--metallic-gold);
        }

        .apply-promo-btn {
            background: var(--metallic-gold);
            color: white;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: var(--border-radius);
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.95rem;
        }

        .apply-promo-btn:hover {
            background: var(--accent-rich);
            transform: translateY(-2px);
        }

        /* Checkout Button */
        .checkout-btn {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, var(--accent-rich), var(--deep-elegance));
            color: white;
            padding: 1.2rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: none;
            cursor: pointer;
            transition: var(--transition);
            margin-top: var(--spacing-md);
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .checkout-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(70, 36, 21, 0.3);
        }

        /* Continue Shopping */
        .continue-shopping {
            text-align: center;
            margin-top: var(--spacing-sm);
        }

        .continue-shopping a {
            color: var(--accent-rich);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .continue-shopping a:hover {
            text-decoration: underline;
        }

        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            grid-column: 1 / -1;
        }

        .empty-cart-icon {
            font-size: 4rem;
            color: var(--metallic-gold);
            margin-bottom: var(--spacing-md);
        }

        .empty-cart h2 {
            font-size: 2.2rem;
            color: var(--deep-elegance);
            margin-bottom: var(--spacing-sm);
        }

        .empty-cart p {
            color: var(--deep-elegance);
            opacity: 0.8;
            margin-bottom: var(--spacing-md);
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-now-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent-rich), var(--metallic-gold));
            color: white;
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

        .shop-now-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(150, 81, 35, 0.3);
        }

        /* You May Also Like Section */
        .you-may-also-like.editable-section[data-section="158"] {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(70, 36, 21, 0.1);
        }

        .you-may-also-like h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--deep-elegance);
        }

        .recommended-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .recommended-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
        }

        .recommended-product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(70, 36, 21, 0.1);
        }

        /* Non-editable recommended products */
        .recommended-product-card:not([class*="editable-section"]) {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
        }

        .recommended-product-card:not([class*="editable-section"]):hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(70, 36, 21, 0.1);
        }

        .recommended-product-img {
            height: 250px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .recommended-product-card:hover .recommended-product-img {
            transform: scale(1.05);
        }

        .recommended-product-info {
            padding: 1.5rem;
        }

        .recommended-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            color: var(--deep-elegance);
            margin-bottom: 0.5rem;
        }

        .recommended-product-price {
            color: var(--accent-rich);
            font-weight: 500;
            margin-bottom: 1rem;
        }

        .add-to-cart-small {
            width: 100%;
            background: var(--bg-luxury);
            color: var(--accent-rich);
            padding: 0.7rem;
            font-size: 0.9rem;
            font-weight: 300;
            border-radius: var(--border-radius);
            border: 1px solid var(--accent-rich);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-to-cart-small:hover {
            background: var(--accent-rich);
            color: white;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .recommended-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            h1.cart-title {
                font-size: 3.2rem;
            }
        }

        @media (max-width: 992px) {
            .cart-content {
                grid-template-columns: 1fr;
            }
            .cart-summary {
                position: static;
                order: -1;
            }
            .recommended-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .cart-items-header {
                display: none;
            }
            .cart-item,
            .cart-item:not([class*="editable-section"]) {
                grid-template-columns: 1fr;
                gap: var(--spacing-sm);
                padding: var(--spacing-md) 0;
                position: relative;
            }
            .cart-product-price {
                position: absolute;
                top: var(--spacing-md);
                right: 0;
            }
            .remove-btn {
                position: absolute;
                top: var(--spacing-md);
                right: 0;
            }
            .quantity-controls {
                justify-content: flex-start;
            }
        }

        @media (max-width: 768px) {
            main {
                padding-top: 80px;
            }
            h1.cart-title {
                font-size: 2.5rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .cart-items,
            .cart-summary {
                padding: var(--spacing-sm);
            }
            .cart-product-image {
                width: 80px;
                height: 80px;
            }
            .recommended-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .you-may-also-like h2 {
                font-size: 2rem;
            }
        }

        @media (max-width: 576px) {
            h1.cart-title {
                font-size: 2.2rem;
            }
            .promo-input-group {
                flex-direction: column;
            }
            .apply-promo-btn,
            .checkout-btn,
            .shop-now-btn {
                padding: 0.8rem 1.5rem;
                font-size: 1rem;
            }
            .empty-cart h2 {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>
    <main>
        <!-- Page Header -->
        <div class="page-header editable-section no-drop-zone" data-section="139">
            <div class="container">
                <h1 class="cart-title editable-text editable-section no-drop-zone" data-section="140" data-text="300">Your Shopping Cart</h1>
            </div>
        </div>

        <!-- Cart Content -->
        <div class="container">
            <div class="cart-content">
                <!-- Cart Items -->
                <div class="cart-items editable-section no-drop-zone" data-section="141">
                    <div class="cart-items-header">
                        <div class="editable-text editable-section no-drop-zone" data-section="164" data-text="301">Product</div>
                        <div class="editable-text editable-section no-drop-zone" data-section="165" data-text="302">Price</div>
                        <div class="editable-text editable-section no-drop-zone" data-section="166" data-text="303">Quantity</div>
                        <div class="editable-text editable-section no-drop-zone" data-section="167" data-text="304">Total</div>
                        <div></div>
                    </div>
                    
                    <!-- Cart Item 1 (Editable - template for all cart items) -->
                    <div class="cart-item editable-section no-drop-zone" data-section="142" data-cart-item-id="1" data-product-id="1">
                        <div class="cart-product-info">
                            <div class="cart-product-image editable-image" data-image="50" style="background-image: url('https://images.unsplash.com/photo-1602173574767-37ac01994b2a?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80')"></div>
                            <div class="cart-product-details">
                                <div class="cart-product-name editable-section no-drop-zone" data-section="143" data-text="305">Celestial Diamond Necklace</div>
                                <div class="cart-product-category editable-section no-drop-zone" data-section="144" data-text="306">NECKLACES</div>
                                <div class="cart-product-variant editable-section no-drop-zone" data-section="145" data-text="307">Color: Gold | Size: 18"</div>
                            </div>
                        </div>
                        <div class="cart-product-price editable-section no-drop-zone" data-section="146" data-price="3850" data-text="308">$3,850</div>
                        <div class="quantity-controls">
                            <button class="quantity-btn minus" data-action="decrement" data-product-id="1">-</button>
                            <input type="number" class="quantity-input" value="1" min="1" max="10" data-product-id="1">
                            <button class="quantity-btn plus" data-action="increment" data-product-id="1">+</button>
                        </div>
                        <div class="item-total" data-product-id="1">$3,850</div>
                        <button class="remove-btn" data-action="remove" data-product-id="1">
                            <i class="fas fa-times editable-icon" data-icon="50" data-default-class="fas fa-times"></i>
                        </button>
                    </div>
                    
                    <!-- Cart Item 2 (Non-editable sample - will be replaced by backend data) -->
                    <div class="cart-item" data-cart-item-id="2" data-product-id="2">
                        <div class="cart-product-info">
                            <div class="cart-product-image" style="background-image: url('https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80')"></div>
                            <div class="cart-product-details">
                                <div class="cart-product-name">Gold & Emerald Bracelet</div>
                                <div class="cart-product-category">BRACELETS</div>
                                <div class="cart-product-variant">Color: Gold | Size: Medium</div>
                            </div>
                        </div>
                        <div class="cart-product-price" data-price="2950">$2,950</div>
                        <div class="quantity-controls">
                            <button class="quantity-btn minus" data-action="decrement" data-product-id="2">-</button>
                            <input type="number" class="quantity-input" value="1" min="1" max="10" data-product-id="2">
                            <button class="quantity-btn plus" data-action="increment" data-product-id="2">+</button>
                        </div>
                        <div class="item-total" data-product-id="2">$2,950</div>
                        <button class="remove-btn" data-action="remove" data-product-id="2">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                
                <!-- Cart Summary -->
                <div class="cart-summary editable-section no-drop-zone" data-section="147">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="148" data-text="309">Order Summary</h2>
                    
                    <div class="summary-row">
                        <span class="editable-text editable-section no-drop-zone" data-section="168" data-text="310">Subtotal</span>
                        <span id="cart-subtotal" class="editable-text editable-section no-drop-zone" data-section="169" data-text="311">$6,800</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="editable-text editable-section no-drop-zone" data-section="170" data-text="312">Shipping</span>
                        <span id="cart-shipping" class="editable-text editable-section no-drop-zone" data-section="171" data-text="313">FREE</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="editable-text editable-section no-drop-zone" data-section="172" data-text="314">Tax</span>
                        <span id="cart-tax" class="editable-text editable-section no-drop-zone" data-section="173" data-text="315">$0.00</span>
                    </div>
                    
                    <div class="summary-row total">
                        <span class="editable-text editable-section no-drop-zone" data-section="174" data-text="316">Total</span>
                        <span id="cart-total" class="editable-text editable-section no-drop-zone" data-section="175" data-text="317">$6,800</span>
                    </div>
                    
                    <!-- Promo Code -->
                    <div class="promo-code editable-section no-drop-zone" data-section="149">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="150" data-text="318">Promo Code</h3>
                        <div class="promo-input-group">
                            <input type="text" class="promo-input editable-text" data-text="319" placeholder="Enter code" id="promo-code-input">
                            <button class="apply-promo-btn editable-text editable-section no-drop-zone" data-section="151" data-text="320" id="applyPromoBtn">Apply</button>
                        </div>
                    </div>
                    
                    <!-- Checkout Button -->
                    <button class="checkout-btn editable-text editable-section no-drop-zone" data-section="152" data-text="321" id="checkoutBtn" onclick="proceedToCheckout()">
                        <i class="fas fa-lock editable-icon" data-icon="51" data-default-class="fas fa-lock"></i> Proceed to Checkout
                    </button>
                    
                    <!-- Continue Shopping -->
                    <div class="continue-shopping">
                        <a href="?page=shop" class="editable-text editable-section no-drop-zone" data-section="153" data-text="322">
                            <i class="fas fa-arrow-left editable-icon" data-icon="52" data-default-class="fas fa-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- You May Also Like -->
            <div class="you-may-also-like editable-section" data-section="158">
                <h2 class="editable-text editable-section no-drop-zone" data-section="159" data-text="323">You May Also Like</h2>
                <div class="recommended-grid">
                    <!-- Recommended Product 1 (Editable - template for recommended products) -->
                    <div class="recommended-product-card editable-section no-drop-zone" data-section="160" data-product-id="3">
                        <div class="recommended-product-img editable-image" data-image="53" style="background-image: url('https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80')"></div>
                        <div class="recommended-product-info">
                            <div class="recommended-product-name editable-text editable-section no-drop-zone" data-section="161" data-text="324">Pearl & Diamond Earrings</div>
                            <div class="recommended-product-price editable-text editable-section no-drop-zone" data-section="162" data-text="325">$1,850</div>
                            <button class="add-to-cart-small editable-text editable-section no-drop-zone" data-section="163" data-text="326" data-product-id="3">
                                <i class="fas fa-cart-plus editable-icon" data-icon="54" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                    
                    <!-- Recommended Product 2 (Non-editable sample) -->
                    <div class="recommended-product-card" data-product-id="4">
                        <div class="recommended-product-img" style="background-image: url('https://images.unsplash.com/photo-1600721391689-2564bb8055de?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80')"></div>
                        <div class="recommended-product-info">
                            <div class="recommended-product-name">Vintage Sapphire Ring</div>
                            <div class="recommended-product-price">$4,250</div>
                            <button class="add-to-cart-small" data-product-id="4">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                    
                    <!-- Recommended Product 3 (Non-editable sample) -->
                    <div class="recommended-product-card" data-product-id="5">
                        <div class="recommended-product-img" style="background-image: url('https://images.unsplash.com/photo-1605100804763-247f67b3557e?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80')"></div>
                        <div class="recommended-product-info">
                            <div class="recommended-product-name">Diamond Tennis Bracelet</div>
                            <div class="recommended-product-price">$3,200</div>
                            <button class="add-to-cart-small" data-product-id="5">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                    
                    <!-- Recommended Product 4 (Non-editable sample) -->
                    <div class="recommended-product-card" data-product-id="6">
                        <div class="recommended-product-img" style="background-image: url('https://images.unsplash.com/photo-1602173574767-37ac01994b2a?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80')"></div>
                        <div class="recommended-product-info">
                            <div class="recommended-product-name">Sapphire Pendant</div>
                            <div class="recommended-product-price">$2,450</div>
                            <button class="add-to-cart-small" data-product-id="6">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Empty Cart State -->
            <div class="empty-cart editable-section no-drop-zone" data-section="154" style="display: none;">
                <div class="empty-cart-icon">
                    <i class="fas fa-shopping-cart editable-icon" data-icon="12" data-default-class="fas fa-shopping-cart"></i>
                </div>
                <h2 class="editable-text editable-section no-drop-zone" data-section="155" data-text="327">Your Cart is Empty</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="156" data-text="328">Looks like you haven't added any jewelry to your cart yet. Explore our collection to find the perfect piece.</p>
                <a href="?page=shop" class="shop-now-btn editable-text editable-section no-drop-zone" data-section="157" data-text="329">Start Shopping</a>
            </div>
        </div>
    </main>

    <script>
        // Cart Data for calculations
        let cartData = {
            items: [],
            subtotal: 0,
            shipping_amount: 0,
            tax_amount: 0,
            total_amount: 0,
            promo_code: null,
            discount_amount: 0
        };
        
        // Initialize Cart Data from Page
        function initializeCartData() {
            const cartItems = document.querySelectorAll('.cart-item');
            cartData.items = [];
            cartData.subtotal = 0;
            
            cartItems.forEach(item => {
                const productId = item.getAttribute('data-product-id');
                const priceElement = item.querySelector('.cart-product-price');
                const price = parseFloat(priceElement.getAttribute('data-price')) || 
                             parseFloat(priceElement.textContent.replace('$', '')) || 0;
                const quantity = parseInt(item.querySelector('.quantity-input').value) || 1;
                const itemTotal = price * quantity;
                
                cartData.items.push({
                    id: productId,
                    title: item.querySelector('.cart-product-name')?.textContent || 'Product',
                    price: price,
                    quantity: quantity,
                    total_price: itemTotal
                });
                cartData.subtotal += itemTotal;
            });
            
            cartData.shipping_amount = cartData.subtotal > 100 ? 0 : 5.00;
            cartData.tax_amount = cartData.subtotal * 0.08;
            cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;
            
            updateCartSummary();
        }
        
        function updateCartSummary() {
            const currencySymbol = '$';
            document.getElementById('cart-subtotal').textContent = currencySymbol + cartData.subtotal.toFixed(2);
            
            const shippingElement = document.getElementById('cart-shipping');
            if (cartData.shipping_amount === 0) {
                shippingElement.textContent = 'FREE';
            } else {
                shippingElement.textContent = currencySymbol + cartData.shipping_amount.toFixed(2);
            }
            
            document.getElementById('cart-tax').textContent = currencySymbol + cartData.tax_amount.toFixed(2);
            document.getElementById('cart-total').textContent = currencySymbol + cartData.total_amount.toFixed(2);
        }
        
        function updateItemTotal(productId, quantity) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return;
            
            const priceElement = itemElement.querySelector('.cart-product-price');
            const price = parseFloat(priceElement.getAttribute('data-price')) || 
                         parseFloat(priceElement.textContent.replace('$', '')) || 0;
            const itemTotal = price * quantity;
            
            const itemTotalElement = itemElement.querySelector('.item-total');
            if (itemTotalElement) {
                itemTotalElement.textContent = '$' + itemTotal.toFixed(2);
            }
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            initializeCartData();
            
            document.querySelectorAll('.quantity-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const action = this.getAttribute('data-action');
                    const productId = this.getAttribute('data-product-id');
                    const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                    if (!input) return;
                    
                    let currentValue = parseInt(input.value);
                    
                    if (action === 'increment' && currentValue < 10) {
                        input.value = currentValue + 1;
                        if (window.cartManager) {
                            window.cartManager.incrementCartItem(productId, 1);
                        }
                    } else if (action === 'decrement' && currentValue > 1) {
                        input.value = currentValue - 1;
                        if (window.cartManager) {
                            window.cartManager.decrementCartItem(productId, 1);
                        }
                    }
                    updateItemTotal(productId, parseInt(input.value));
                    initializeCartData();
                });
            });
            
            document.querySelectorAll('.quantity-input').forEach(input => {
                input.addEventListener('change', function() {
                    const productId = this.getAttribute('data-product-id');
                    let value = parseInt(this.value);
                    
                    if (value < 1) {
                        value = 1;
                        this.value = 1;
                    } else if (value > 10) {
                        value = 10;
                        this.value = 10;
                    }
                    
                    if (window.cartManager) {
                        window.cartManager.updateCartItemQuantity(productId, value);
                    }
                    updateItemTotal(productId, value);
                    initializeCartData();
                });
            });
            
            document.querySelectorAll('.remove-btn[data-action="remove"]').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    if (window.cartManager) {
                        window.cartManager.removeFromCart(productId);
                    }
                    const cartItem = this.closest('.cart-item');
                    if (cartItem) {
                        cartItem.remove();
                        initializeCartData();
                    }
                });
            });
            
            document.querySelectorAll('.add-to-cart-small').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const productId = this.getAttribute('data-product-id');
                    if (window.cartManager) {
                        window.cartManager.addToCart(productId, 1);
                    } else {
                        alert('Item added to cart!');
                    }
                });
            });
            
            const applyPromoBtn = document.getElementById('applyPromoBtn');
            if (applyPromoBtn) {
                applyPromoBtn.addEventListener('click', applyPromoCode);
            }
            
            const promoInput = document.querySelector('.promo-input');
            if (promoInput) {
                promoInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        applyPromoCode();
                    }
                });
            }
            
            document.addEventListener('cartUpdated', function() {
                setTimeout(() => {
                    location.reload();
                }, 500);
            });
        });
        
        function applyPromoCode() {
            const promoInput = document.querySelector('.promo-input');
            const promoCode = promoInput ? promoInput.value.trim() : '';
            
            if (!promoCode) {
                alert('Please enter a promo code');
                return;
            }
            
            const validPromoCodes = {
                'ELEGANCE10': 0.10,
                'JEWELRY15': 0.15,
                'FREE_SHIP': 'free_shipping'
            };
            
            if (validPromoCodes[promoCode]) {
                const discount = validPromoCodes[promoCode];
                if (discount === 'free_shipping') {
                    cartData.shipping_amount = 0;
                    cartData.promo_code = promoCode;
                    cartData.discount_amount = 0;
                    alert('Free shipping applied!');
                } else {
                    cartData.discount_amount = cartData.subtotal * discount;
                    cartData.promo_code = promoCode;
                    alert(`Promo code applied! ${discount * 100}% discount added.`);
                }
                cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;
                updateCartSummary();
            } else {
                alert('Invalid promo code');
            }
        }
        
        function proceedToCheckout() {
            if (cartData.items.length === 0) {
                alert('Your cart is empty. Please add items before checkout.');
                return;
            }
            
            const hostname = window.location.hostname;
            const pageDomain = document.body.getAttribute('data-page-subdomain') || 'default';
            const subdomain = hostname.includes('localhost') ? pageDomain : hostname.split('.')[0];
            
            const checkoutData = {
                ...cartData,
                items: cartData.items.map(item => ({
                    ...item,
                    selected_color: getSelectedColor(item.id) || '',
                    selected_size: getSelectedSize(item.id) || ''
                }))
            };
            
            window.location.href = `/payments/select-payment/${subdomain}/?type=cart&cart=${encodeURIComponent(JSON.stringify(checkoutData))}`;
        }
        
        function getSelectedColor(productId) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return '';
            const variantText = itemElement.querySelector('.cart-product-variant')?.textContent || '';
            const colorMatch = variantText.match(/Color:\s*([^|]+)/);
            return colorMatch ? colorMatch[1].trim() : '';
        }
        
        function getSelectedSize(productId) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return '';
            const variantText = itemElement.querySelector('.cart-product-variant')?.textContent || '';
            const sizeMatch = variantText.match(/Size:\s*([^|]+)/);
            return sizeMatch ? sizeMatch[1].trim() : '';
        }
    </script>
</body>
</html>