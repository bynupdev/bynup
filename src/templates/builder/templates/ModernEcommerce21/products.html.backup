<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | NEXUS Gaming Gear</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-teal: #273b40;
            --color-mist: #cae9ea;
            --color-charcoal: #1d1d1d;
            --color-slate: #3c4748;
            --color-emerald-teal: #208c8c;
        }

        body {
            background-color: var(--color-charcoal);
            color: #eef2f3;
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            scroll-behavior: smooth;
            overflow-x: hidden;
            padding-top: 90px;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            margin-bottom: 48px;
            padding: 40px 0 20px;
        }

        .page-title {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--color-mist) 0%, var(--color-emerald-teal) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .page-description {
            font-size: 1.1rem;
            color: rgba(202, 233, 234, 0.7);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Shop Controls */
        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 48px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(60, 71, 72, 0.5);
        }

        .categories-action {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .categories-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(32, 140, 140, 0.15);
            border: 1px solid var(--color-emerald-teal);
            color: var(--color-emerald-teal);
            padding: 10px 24px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .categories-button:hover {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(32, 140, 140, 0.3);
        }

        .filter-sort {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .filter-btn, .sort-select {
            background: rgba(60, 71, 72, 0.3);
            border: 1px solid rgba(60, 71, 72, 0.5);
            padding: 10px 20px;
            border-radius: 40px;
            color: var(--color-mist);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn:hover, .sort-select:hover {
            border-color: var(--color-emerald-teal);
            color: var(--color-emerald-teal);
        }

        .sort-select {
            background: rgba(60, 71, 72, 0.3);
            min-width: 160px;
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            margin-bottom: 60px;
        }

        .product-card {
            background: rgba(60, 71, 72, 0.2);
            backdrop-filter: blur(2px);
            border-radius: 28px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            border: 1px solid rgba(32, 140, 140, 0.2);
            text-decoration: none;
            display: block;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(32, 140, 140, 0.4);
            background: rgba(39, 59, 64, 0.5);
        }

        .product-image {
            width: 100%;
            aspect-ratio: 1 / 0.9;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .product-card:hover .product-image {
            transform: scale(1.02);
        }

        .product-info {
            padding: 20px;
        }

        .product-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-emerald-teal);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .product-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #ffffff;
            line-height: 1.3;
        }

        .product-price {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--color-emerald-teal);
            margin-bottom: 16px;
        }

        .product-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

        .add-to-cart-btn {
            flex: 1;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border: none;
            padding: 10px 16px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .add-to-cart-btn:hover {
            background: #1e7a7a;
            transform: translateY(-2px);
        }

        .wishlist-btn {
            background: rgba(60, 71, 72, 0.5);
            border: 1px solid rgba(32, 140, 140, 0.3);
            color: var(--color-mist);
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .wishlist-btn:hover {
            background: rgba(32, 140, 140, 0.3);
            color: var(--color-emerald-teal);
            transform: translateY(-2px);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 40px;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            grid-column: 1 / -1;
        }

        .empty-state-icon {
            font-size: 4rem;
            color: var(--color-emerald-teal);
            margin-bottom: 24px;
            opacity: 0.5;
        }

        .empty-state h3 {
            font-size: 1.8rem;
            color: var(--color-mist);
            margin-bottom: 16px;
        }

        .empty-state p {
            color: rgba(202, 233, 234, 0.7);
            margin-bottom: 24px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .empty-state a {
            display: inline-block;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            padding: 12px 32px;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .empty-state a:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(32, 140, 140, 0.3);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 24px;
            }
        }

        @media (max-width: 992px) {
            .page-title { font-size: 2.5rem; }
            .products-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            body { padding-top: 80px; }
            .container { padding: 0 24px; }
            .shop-controls { flex-direction: column; align-items: stretch; }
            .categories-action { justify-content: center; }
            .filter-sort { justify-content: center; }
            .products-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto 60px; }
            .page-title { font-size: 2rem; }
        }

        @media (max-width: 576px) {
            .filter-sort { flex-direction: column; width: 100%; }
            .filter-btn, .sort-select { width: 100%; text-align: center; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header editable-section" data-section="44">
            <h1 class="page-title editable-text editable-section no-drop-zone" data-section="45" data-text="35">Shop Gaming Gear</h1>
            <p class="page-description editable-text editable-section no-drop-zone" data-section="46" data-text="36">Discover precision-crafted peripherals designed for competitive edge and immersive gameplay.</p>
        </div>

        <!-- Shop Controls -->
        <div class="shop-controls editable-section" data-section="47">
            <div class="categories-action">
                <a href="?page=categories" class="categories-button editable-text editable-section no-drop-zone" data-section="48" data-text="37">
                    <i class="fas fa-th-large"></i> Browse Categories
                </a>
            </div>
            <div class="filter-sort">
                <button class="filter-btn editable-text editable-section no-drop-zone" data-section="49" data-text="38">
                    <i class="fas fa-filter"></i> Filter
                </button>
                <select class="sort-select editable-text editable-section no-drop-zone" data-section="50" data-text="39">
                    <option value="newest">Newest First</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                </select>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="products-grid" id="products-grid">
            <!-- Product 1 - Editable sample -->
            <div class="product-card editable-section no-drop-zone" data-section="51" data-product-id="1">
                <img class="product-image editable-image" data-image="4" src="https://images.pexels.com/photos/2115257/pexels-photo-2115257.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Phantom Mech Keyboard">
                <div class="product-info">
                    <div class="product-category editable-text editable-section no-drop-zone" data-section="52" data-text="40">KEYBOARDS</div>
                    <div class="product-name editable-text editable-section no-drop-zone" data-section="53" data-text="41">Phantom Mech Keyboard</div>
                    <div class="product-price editable-text editable-section no-drop-zone" data-section="54" data-text="42">$149</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn editable-text editable-section no-drop-zone" data-section="55" data-text="43" data-add-to-cart="1">
                            <i class="fas fa-shopping-cart"></i> Add to Cart
                        </button>
                        <button class="wishlist-btn" data-add-to-wishlist="1">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Product 2 - Sample -->
            <div class="product-card">
                <img class="product-image" src="https://images.pexels.com/photos/16131636/pexels-photo-16131636/free-photo-of-gaming-mouse-on-desk.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Aether X Mouse">
                <div class="product-info">
                    <div class="product-category">MICE</div>
                    <div class="product-name">Aether X Wireless Mouse</div>
                    <div class="product-price">$79</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn" data-add-to-cart="2"><i class="fas fa-shopping-cart"></i> Add to Cart</button>
                        <button class="wishlist-btn" data-add-to-wishlist="2"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>
            <!-- Product 3 - Sample -->
            <div class="product-card">
                <img class="product-image" src="https://images.pexels.com/photos/577769/pexels-photo-577769.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Spectra Wireless Headset">
                <div class="product-info">
                    <div class="product-category">HEADSETS</div>
                    <div class="product-name">Spectra Wireless Headset</div>
                    <div class="product-price">$189</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn" data-add-to-cart="3"><i class="fas fa-shopping-cart"></i> Add to Cart</button>
                        <button class="wishlist-btn" data-add-to-wishlist="3"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>
            <!-- Product 4 - Sample -->
            <div class="product-card">
                <img class="product-image" src="https://images.pexels.com/photos/2114012/pexels-photo-2114012.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Fusion Pro Controller">
                <div class="product-info">
                    <div class="product-category">CONTROLLERS</div>
                    <div class="product-name">Fusion Pro Controller</div>
                    <div class="product-price">$99</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn" data-add-to-cart="4"><i class="fas fa-shopping-cart"></i> Add to Cart</button>
                        <button class="wishlist-btn" data-add-to-wishlist="4"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>