<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXUS - Precision Gaming Gear</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-teal: #273b40;
            --color-mist: #cae9ea;
            --color-charcoal: #1d1d1d;
            --color-slate: #3c4748;
            --color-emerald-teal: #208c8c;
        }

        body {
            background-color: var(--color-charcoal);
            color: #eef2f3;
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            scroll-behavior: smooth;
            overflow-x: hidden;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Header Styles */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(29, 29, 29, 0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(60, 71, 72, 0.4);
            padding: 16px 0;
        }

        .header-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .logo {
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, var(--color-mist) 0%, var(--color-emerald-teal) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .nav-list {
            display: flex;
            gap: 2rem;
            align-items: center;
            list-style: none;
        }

        .nav-item {
            color: var(--color-mist);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            letter-spacing: 0.3px;
            position: relative;
            padding: 6px 0;
        }

        .nav-item:hover {
            color: var(--color-emerald-teal);
        }

        .account-dropdown {
            position: relative;
            cursor: pointer;
        }

        .account-dropdown-trigger {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--color-mist);
            font-weight: 500;
        }

        .account-dropdown-trigger i {
            font-size: 1.2rem;
        }

        .dropdown-menu {
            position: absolute;
            top: 40px;
            right: 0;
            background: var(--color-deep-teal);
            backdrop-filter: blur(8px);
            background-color: rgba(39, 59, 64, 0.98);
            border-radius: 14px;
            width: 200px;
            padding: 12px 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: all 0.2s;
            box-shadow: 0 12px 28px rgba(0,0,0,0.3);
            border: 1px solid rgba(32, 140, 140, 0.3);
            z-index: 110;
        }

        .account-dropdown:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-menu a {
            display: block;
            padding: 10px 20px;
            color: var(--color-mist);
            text-decoration: none;
            font-size: 0.85rem;
            transition: 0.2s;
        }

        .dropdown-menu a:hover {
            background: rgba(32, 140, 140, 0.2);
            color: var(--color-emerald-teal);
        }

        .icon-link {
            font-size: 1.2rem;
        }

        .hamburger, .mobile-nav {
            display: none;
        }

        /* Hero Section */
        .hero-section {
            position: relative;
            min-height: 85vh;
            display: flex;
            align-items: center;
            background: linear-gradient(105deg, rgba(29,29,29,0.85) 0%, rgba(39,59,64,0.7) 100%), url('https://images.pexels.com/photos/442576/pexels-photo-442576.jpeg?auto=compress&cs=tinysrgb&w=1600') center/cover no-repeat;
            background-blend-mode: overlay;
        }

        .hero-content {
            max-width: 620px;
            padding: 2rem;
            position: relative;
            z-index: 2;
        }

        .hero-headline {
            font-size: 4rem;
            font-weight: 700;
            line-height: 1.2;
            background: linear-gradient(to right, var(--color-mist), #ffffff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 1.25rem;
            letter-spacing: -1px;
        }

        .hero-subtext {
            font-size: 1.2rem;
            color: #cfdfe0;
            margin-bottom: 2rem;
            font-weight: 400;
            max-width: 500px;
        }

        .primary-action {
            display: inline-flex;
            background-color: var(--color-emerald-teal);
            color: var(--color-charcoal);
            font-weight: 700;
            padding: 14px 38px;
            border-radius: 40px;
            text-decoration: none;
            font-size: 1rem;
            letter-spacing: 0.5px;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 12px rgba(32, 140, 140, 0.3);
        }

        .primary-action:hover {
            background-color: #1e7a7a;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(32, 140, 140, 0.4);
        }

        /* New Arrivals Section */
        .section {
            padding: 80px 0;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            flex-wrap: wrap;
            margin-bottom: 48px;
            border-bottom: 1px solid rgba(60, 71, 72, 0.5);
            padding-bottom: 12px;
        }

        .section-title {
            font-size: 2rem;
            font-weight: 600;
            letter-spacing: -0.3px;
            color: var(--color-mist);
        }

        .cta-link {
            color: var(--color-emerald-teal);
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: gap 0.2s;
        }

        .cta-link i {
            font-size: 0.8rem;
        }

        .cta-link:hover {
            gap: 12px;
            color: #b3e2e2;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
        }

        .product-card {
            background: rgba(60, 71, 72, 0.2);
            backdrop-filter: blur(2px);
            border-radius: 28px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            border: 1px solid rgba(32, 140, 140, 0.2);
            padding: 20px 16px 24px;
            text-align: center;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(32, 140, 140, 0.4);
            background: rgba(39, 59, 64, 0.5);
        }

        .product-img {
            width: 100%;
            aspect-ratio: 1 / 0.9;
            object-fit: cover;
            border-radius: 20px;
            margin-bottom: 20px;
            transition: transform 0.3s;
        }

        .product-card:hover .product-img {
            transform: scale(1.02);
        }

        .product-name {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #ffffff;
        }

        .product-price {
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--color-emerald-teal);
            letter-spacing: -0.2px;
        }

        .empty-state {
            text-align: center;
            padding: 4rem;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            grid-column: 1 / -1;
        }

        .empty-state h3 {
            color: var(--color-mist);
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }

        .empty-state p {
            color: rgba(202, 233, 234, 0.7);
            margin-bottom: 1.5rem;
        }

        .empty-state a {
            color: var(--color-emerald-teal);
            text-decoration: none;
            font-weight: 500;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .products-grid { gap: 24px; }
            .hero-headline { font-size: 3.2rem; }
        }

        @media (max-width: 860px) {
            .products-grid { grid-template-columns: repeat(2, 1fr); }
            .nav-list { display: none; }
            .hamburger {
                display: block;
                background: none;
                border: none;
                color: var(--color-mist);
                font-size: 1.8rem;
                cursor: pointer;
            }
            .mobile-nav {
                display: block;
                position: fixed;
                top: 0;
                right: -100%;
                width: 280px;
                height: 100%;
                background: var(--color-deep-teal);
                backdrop-filter: blur(20px);
                background-color: rgba(29, 29, 29, 0.98);
                z-index: 2000;
                padding: 28px 20px;
                box-shadow: -5px 0 30px rgba(0,0,0,0.5);
                transition: right 0.3s ease;
                border-left: 1px solid var(--color-emerald-teal);
            }
            .mobile-nav.active { right: 0; }
            .mobile-nav-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 40px;
            }
            .mobile-back-btn {
                display: flex;
                align-items: center;
                gap: 8px;
                background: none;
                border: none;
                color: var(--color-mist);
                font-size: 1rem;
                font-weight: 500;
                cursor: pointer;
            }
            .mobile-nav-links {
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 28px;
            }
            .mobile-nav-links a {
                color: var(--color-mist);
                text-decoration: none;
                font-size: 1.2rem;
                font-weight: 500;
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .mobile-dropdown-group {
                margin-top: 20px;
                padding-left: 20px;
                border-left: 2px solid var(--color-emerald-teal);
            }
            .mobile-dropdown-group a {
                font-size: 0.95rem;
                padding: 8px 0;
                display: block;
            }
            .overlay-blur {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.5);
                backdrop-filter: blur(4px);
                z-index: 1999;
                opacity: 0;
                visibility: hidden;
                transition: 0.2s;
            }
            .overlay-blur.active {
                opacity: 1;
                visibility: visible;
            }
            .container { padding: 0 24px; }
        }

        @media (max-width: 640px) {
            .hero-headline { font-size: 2.5rem; }
            .hero-subtext { font-size: 1rem; }
            .products-grid { grid-template-columns: 1fr; gap: 32px; }
            .section { padding: 56px 0; }
            .primary-action { padding: 12px 28px; }
        }
    </style>
</head>
<body>
    <header class="site-header editable-section no-drop-zone" data-section="1">
        <div class="container header-inner">
            <div class="logo">
                <a href="?page=home">
                    <i class="fas fa-gamepad editable-icon" data-icon="1" data-default-class="fas fa-gamepad"></i>
                    <span class="editable-text editable-section no-drop-zone" data-section="2" data-text="1">NEXUS</span>
                </a>
            </div>
            <ul class="nav-list">
                <li><a href="?page=home" class="nav-item editable-text editable-section no-drop-zone" data-section="3" data-text="2">Home</a></li>
                <li><a href="?page=products" class="nav-item editable-text editable-section no-drop-zone" data-section="4" data-text="3">Shop</a></li>
                <li><a href="?page=about" class="nav-item editable-text editable-section no-drop-zone" data-section="5" data-text="4">About Us</a></li>
                <li><a href="?page=contact" class="nav-item editable-text editable-section no-drop-zone" data-section="6" data-text="5">Contact</a></li>
                <li><a href="?page=cart" class="nav-item icon-link editable-text editable-section no-drop-zone" data-section="7" data-text="6"><i class="fas fa-shopping-cart"></i> Cart</a></li>
                <li><a href="?page=wishlist" class="nav-item icon-link editable-text editable-section no-drop-zone" data-section="8" data-text="7"><i class="fas fa-heart"></i> Wishlist</a></li>
                <li class="account-dropdown">
                    <div class="account-dropdown-trigger">
                        <i class="fas fa-user-circle"></i> Account <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                    </div>
                    <div class="dropdown-menu">
                        <a href="?page=login" class="editable-text editable-section no-drop-zone" data-section="9" data-text="8">Sign In</a>
                        <a href="?page=register" class="editable-text editable-section no-drop-zone" data-section="10" data-text="9">Sign Up</a>
                        <a href="?page=orders" class="editable-text editable-section no-drop-zone" data-section="11" data-text="10">Orders</a>
                        <a href="?page=wishlist" class="editable-text editable-section no-drop-zone" data-section="12" data-text="11">Wishlist</a>
                        <a href="?page=account-settings" class="editable-text editable-section no-drop-zone" data-section="13" data-text="12">Account Settings</a>
                    </div>
                </li>
            </ul>
            <button class="hamburger" id="hamburgerBtn" aria-label="Menu"><i class="fas fa-bars"></i></button>
        </div>
    </header>

    <div class="mobile-nav" id="mobileNav">
        <div class="mobile-nav-header">
            <button class="mobile-back-btn" id="closeMobileNav"><i class="fas fa-arrow-left"></i> Back</button>
            <i class="fas fa-times" id="closeMobileIcon" style="font-size: 1.4rem; cursor: pointer;"></i>
        </div>
        <ul class="mobile-nav-links">
            <li><a href="?page=home"><i class="fas fa-home"></i> Home</a></li>
            <li><a href="?page=products"><i class="fas fa-store"></i> Shop</a></li>
            <li><a href="?page=about"><i class="fas fa-info-circle"></i> About Us</a></li>
            <li><a href="?page=contact"><i class="fas fa-envelope"></i> Contact</a></li>
            <li><a href="?page=cart"><i class="fas fa-shopping-cart"></i> Cart</a></li>
            <li><a href="?page=wishlist"><i class="fas fa-heart"></i> Wishlist</a></li>
            <li>
                <div style="margin-top: 10px;"><i class="fas fa-user"></i> Account</div>
                <div class="mobile-dropdown-group">
                    <a href="?page=login">Sign In</a>
                    <a href="?page=register">Sign Up</a>
                    <a href="?page=orders">Orders</a>
                    <a href="?page=wishlist">Wishlist</a>
                    <a href="?page=account-settings">Account Settings</a>
                </div>
            </li>
        </ul>
    </div>
    <div class="overlay-blur" id="overlayBlur"></div>

    <!-- Hero Section -->
    <section class="hero-section editable-section" data-section="14">
        <div class="container hero-content">
            <h1 class="hero-headline editable-text editable-section no-drop-zone" data-section="15" data-text="13">Play Without Limits</h1>
            <p class="hero-subtext editable-text editable-section no-drop-zone" data-section="16" data-text="14">Precision gear designed for performance, speed, and immersive gameplay.</p>
            <a href="?page=products" class="primary-action editable-text editable-section no-drop-zone" data-section="17" data-text="15">Shop Gear</a>
        </div>
    </section>

    <!-- New Arrivals Section -->
    <section class="section new-arrivals editable-section" data-section="18">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title editable-text editable-section no-drop-zone" data-section="19" data-text="16">New Arrivals</h2>
                <a href="?page=products" class="cta-link editable-text editable-section no-drop-zone" data-section="20" data-text="17">See More <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="products-grid">
                <!-- Product 1 - Editable sample -->
                <div class="product-card editable-section no-drop-zone" data-section="21">
                    <img class="product-img editable-image" data-image="2" src="https://images.pexels.com/photos/2115257/pexels-photo-2115257.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Mechanical Keyboard">
                    <div class="product-name editable-text editable-section no-drop-zone" data-section="22" data-text="18">Phantom Mech Keyboard</div>
                    <div class="product-price editable-text editable-section no-drop-zone" data-section="23" data-text="19">$149</div>
                </div>
                <!-- Product 2 - Sample -->
                <div class="product-card">
                    <img class="product-img" src="https://images.pexels.com/photos/16131636/pexels-photo-16131636/free-photo-of-gaming-mouse-on-desk.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Gaming Mouse">
                    <div class="product-name">Aether X Mouse</div>
                    <div class="product-price">$79</div>
                </div>
                <!-- Product 3 - Sample -->
                <div class="product-card">
                    <img class="product-img" src="https://images.pexels.com/photos/577769/pexels-photo-577769.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Wireless Headset">
                    <div class="product-name">Spectra Wireless Headset</div>
                    <div class="product-price">$189</div>
                </div>
                <!-- Product 4 - Sample -->
                <div class="product-card">
                    <img class="product-img" src="https://images.pexels.com/photos/2114012/pexels-photo-2114012.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Game Controller">
                    <div class="product-name">Fusion Pro Controller</div>
                    <div class="product-price">$99</div>
                </div>
            </div>
        </div>
    </section>
</body>
</html>