<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | NEXUS Gaming Gear</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-teal: #273b40;
            --color-mist: #cae9ea;
            --color-charcoal: #1d1d1d;
            --color-slate: #3c4748;
            --color-emerald-teal: #208c8c;
        }

        body {
            background-color: var(--color-charcoal);
            color: #eef2f3;
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            scroll-behavior: smooth;
            overflow-x: hidden;
            padding-top: 90px;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            margin-bottom: 48px;
            padding: 40px 0 20px;
        }

        .page-title {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--color-mist) 0%, var(--color-emerald-teal) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .wishlist-subtitle {
            font-size: 1rem;
            color: rgba(202, 233, 234, 0.6);
        }

        /* Wishlist Stats */
        .wishlist-stats {
            display: flex;
            justify-content: center;
            gap: 48px;
            margin-bottom: 48px;
            flex-wrap: wrap;
        }

        .stat-card {
            background: rgba(60, 71, 72, 0.2);
            border: 1px solid rgba(32, 140, 140, 0.2);
            border-radius: 20px;
            padding: 20px 32px;
            text-align: center;
            min-width: 150px;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-emerald-teal);
        }

        .stat-label {
            font-size: 0.85rem;
            color: rgba(202, 233, 234, 0.7);
            margin-top: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Wishlist Controls */
        .wishlist-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(60, 71, 72, 0.5);
        }

        .filter-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 8px 20px;
            background: rgba(60, 71, 72, 0.3);
            border: 1px solid rgba(32, 140, 140, 0.3);
            border-radius: 40px;
            color: var(--color-mist);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.85rem;
        }

        .filter-btn:hover, .filter-btn.active {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border-color: var(--color-emerald-teal);
        }

        .clear-wishlist-btn {
            padding: 8px 24px;
            background: rgba(60, 71, 72, 0.3);
            border: 1px solid rgba(255, 107, 107, 0.3);
            border-radius: 40px;
            color: #ff6b6b;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
        }

        .clear-wishlist-btn:hover {
            background: rgba(255, 107, 107, 0.2);
            border-color: #ff6b6b;
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            margin-bottom: 64px;
        }

        .wishlist-card {
            background: rgba(60, 71, 72, 0.2);
            backdrop-filter: blur(2px);
            border-radius: 28px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            border: 1px solid rgba(32, 140, 140, 0.2);
            position: relative;
        }

        .wishlist-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(32, 140, 140, 0.4);
            background: rgba(39, 59, 64, 0.5);
        }

        .wishlist-image {
            width: 100%;
            aspect-ratio: 1 / 0.9;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .wishlist-card:hover .wishlist-image {
            transform: scale(1.02);
        }

        .wishlist-badge {
            position: absolute;
            top: 16px;
            right: 16px;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
            z-index: 2;
        }

        .wishlist-info {
            padding: 20px;
        }

        .wishlist-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-emerald-teal);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .wishlist-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #ffffff;
            line-height: 1.3;
        }

        .wishlist-price {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--color-emerald-teal);
            margin-bottom: 16px;
        }

        .wishlist-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

        .add-to-cart-wishlist {
            flex: 1;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border: none;
            padding: 10px 16px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .add-to-cart-wishlist:hover {
            background: #1e7a7a;
            transform: translateY(-2px);
        }

        .remove-wishlist {
            background: rgba(60, 71, 72, 0.5);
            border: 1px solid rgba(255, 107, 107, 0.3);
            color: #ff6b6b;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .remove-wishlist:hover {
            background: rgba(255, 107, 107, 0.2);
            transform: translateY(-2px);
        }

        /* Empty Wishlist */
        .empty-wishlist {
            text-align: center;
            padding: 80px 40px;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            margin-bottom: 64px;
        }

        .empty-wishlist-icon {
            font-size: 5rem;
            color: var(--color-emerald-teal);
            opacity: 0.5;
            margin-bottom: 24px;
        }

        .empty-wishlist h2 {
            font-size: 1.8rem;
            color: var(--color-mist);
            margin-bottom: 16px;
        }

        .empty-wishlist p {
            color: rgba(202, 233, 234, 0.7);
            margin-bottom: 32px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-now-wishlist {
            display: inline-block;
            padding: 14px 40px;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            text-decoration: none;
            border-radius: 40px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .shop-now-wishlist:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(32, 140, 140, 0.3);
        }

        /* Recently Viewed Section */
        .recently-viewed {
            margin-top: 64px;
            padding-top: 48px;
            border-top: 1px solid rgba(60, 71, 72, 0.5);
        }

        .recently-viewed h2 {
            font-size: 1.8rem;
            margin-bottom: 32px;
            color: var(--color-mist);
            text-align: center;
        }

        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .recent-product {
            background: rgba(60, 71, 72, 0.2);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid rgba(32, 140, 140, 0.2);
            text-decoration: none;
            display: block;
        }

        .recent-product:hover {
            transform: translateY(-4px);
            border-color: var(--color-emerald-teal);
        }

        .recent-product-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .recent-product-info {
            padding: 16px;
        }

        .recent-product-name {
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .recent-product-price {
            color: var(--color-emerald-teal);
            font-weight: 600;
            font-size: 1rem;
        }

        .empty-recent {
            text-align: center;
            padding: 60px;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            grid-column: 1 / -1;
        }

        .empty-recent i {
            font-size: 3rem;
            color: var(--color-emerald-teal);
            opacity: 0.5;
            margin-bottom: 16px;
        }

        .empty-recent p {
            color: rgba(202, 233, 234, 0.7);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .wishlist-grid, .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .wishlist-grid, .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .page-title { font-size: 2.5rem; }
        }

        @media (max-width: 768px) {
            body { padding-top: 80px; }
            .container { padding: 0 24px; }
            .wishlist-controls { flex-direction: column; align-items: stretch; }
            .filter-buttons { justify-content: center; }
            .clear-wishlist-btn { justify-content: center; }
            .wishlist-grid, .recently-viewed-grid { grid-template-columns: 1fr; max-width: 380px; margin: 0 auto; }
            .page-title { font-size: 2rem; }
            .wishlist-stats { gap: 16px; }
            .stat-card { padding: 16px 24px; min-width: 120px; }
            .stat-number { font-size: 1.5rem; }
        }

        @media (max-width: 576px) {
            .wishlist-stats { gap: 12px; }
            .stat-card { padding: 12px 16px; min-width: 100px; }
            .stat-number { font-size: 1.2rem; }
            .stat-label { font-size: 0.7rem; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header editable-section" data-section="110">
            <h1 class="page-title editable-text editable-section no-drop-zone" data-section="111" data-text="78">Your Wishlist</h1>
            <p class="wishlist-subtitle editable-text editable-section no-drop-zone" data-section="112" data-text="79">Save your favorite gaming gear for later</p>
        </div>

        <!-- Wishlist Stats -->
        <div class="wishlist-stats editable-section" data-section="113">
            <div class="stat-card editable-section no-drop-zone" data-section="114">
                <div class="stat-number editable-text editable-section no-drop-zone" data-section="115" data-text="80">4</div>
                <div class="stat-label editable-text editable-section no-drop-zone" data-section="116" data-text="81">Items Saved</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">1</div>
                <div class="stat-label">On Sale</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">$516</div>
                <div class="stat-label">Total Value</div>
            </div>
        </div>

        <!-- Wishlist Controls -->
        <div class="wishlist-controls editable-section" data-section="117">
            <div class="filter-buttons">
                <button class="filter-btn active editable-text editable-section no-drop-zone" data-section="118" data-text="82">All Items</button>
                <button class="filter-btn editable-text editable-section no-drop-zone" data-section="119" data-text="83">On Sale</button>
                <button class="filter-btn editable-text editable-section no-drop-zone" data-section="120" data-text="84">In Stock</button>
                <button class="filter-btn editable-text editable-section no-drop-zone" data-section="121" data-text="85">New Arrivals</button>
            </div>
            <button class="clear-wishlist-btn editable-text editable-section no-drop-zone" data-section="122" data-text="86">
                <i class="fas fa-trash-alt"></i> Clear All
            </button>
        </div>

        <!-- Wishlist Grid -->
        <div class="wishlist-grid" id="wishlistGrid">
            <!-- Wishlist Item 1 - Editable -->
            <div class="wishlist-card editable-section no-drop-zone" data-section="123" data-category="keyboard" data-stock="in-stock">
                <img class="wishlist-image editable-image" data-image="10" src="https://images.pexels.com/photos/2115257/pexels-photo-2115257.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Phantom Mech Keyboard">
                <div class="wishlist-badge">Best Seller</div>
                <div class="wishlist-info">
                    <div class="wishlist-category editable-text editable-section no-drop-zone" data-section="124" data-text="87">KEYBOARDS</div>
                    <div class="wishlist-name editable-text editable-section no-drop-zone" data-section="125" data-text="88">Phantom Mech Keyboard</div>
                    <div class="wishlist-price editable-text editable-section no-drop-zone" data-section="126" data-text="89">$149</div>
                    <div class="wishlist-actions">
                        <button class="add-to-cart-wishlist editable-text editable-section no-drop-zone" data-section="127" data-text="90">
                            <i class="fas fa-shopping-cart"></i> Add to Cart
                        </button>
                        <button class="remove-wishlist">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Wishlist Item 2 - Sample -->
            <div class="wishlist-card" data-category="mouse" data-stock="in-stock">
                <img class="wishlist-image" src="https://images.pexels.com/photos/16131636/pexels-photo-16131636/free-photo-of-gaming-mouse-on-desk.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Aether X Mouse">
                <div class="wishlist-info">
                    <div class="wishlist-category">MICE</div>
                    <div class="wishlist-name">Aether X Wireless Mouse</div>
                    <div class="wishlist-price">$79</div>
                    <div class="wishlist-actions">
                        <button class="add-to-cart-wishlist"><i class="fas fa-shopping-cart"></i> Add to Cart</button>
                        <button class="remove-wishlist"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>
            
            <!-- Wishlist Item 3 - Sample (On Sale) -->
            <div class="wishlist-card" data-category="headset" data-stock="in-stock" data-sale="true">
                <img class="wishlist-image" src="https://images.pexels.com/photos/577769/pexels-photo-577769.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Spectra Headset">
                <div class="wishlist-badge">Sale -20%</div>
                <div class="wishlist-info">
                    <div class="wishlist-category">HEADSETS</div>
                    <div class="wishlist-name">Spectra Wireless Headset</div>
                    <div class="wishlist-price"><span style="text-decoration: line-through; font-size: 0.9rem;">$189</span> $151</div>
                    <div class="wishlist-actions">
                        <button class="add-to-cart-wishlist"><i class="fas fa-shopping-cart"></i> Add to Cart</button>
                        <button class="remove-wishlist"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>
            
            <!-- Wishlist Item 4 - Sample (New Arrival) -->
            <div class="wishlist-card" data-category="controller" data-stock="in-stock" data-new="true">
                <img class="wishlist-image" src="https://images.pexels.com/photos/2114012/pexels-photo-2114012.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Fusion Controller">
                <div class="wishlist-badge">New</div>
                <div class="wishlist-info">
                    <div class="wishlist-category">CONTROLLERS</div>
                    <div class="wishlist-name">Fusion Pro Controller</div>
                    <div class="wishlist-price">$99</div>
                    <div class="wishlist-actions">
                        <button class="add-to-cart-wishlist"><i class="fas fa-shopping-cart"></i> Add to Cart</button>
                        <button class="remove-wishlist"><i class="fas fa-times"></i></button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recently Viewed Section -->
        <div class="recently-viewed editable-section" data-section="128">
            <h2 class="editable-text editable-section no-drop-zone" data-section="129" data-text="91">Recently Viewed</h2>
            <div class="recently-viewed-grid">
                <!-- Recent Product 1 - Editable -->
                <div class="recent-product editable-section no-drop-zone" data-section="130">
                    <img class="recent-product-image editable-image" data-image="11" src="https://images.pexels.com/photos/2115258/pexels-photo-2115258.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Gaming Mouse Pad">
                    <div class="recent-product-info">
                        <div class="recent-product-name editable-text editable-section no-drop-zone" data-section="131" data-text="92">Phantom XL Mouse Pad</div>
                        <div class="recent-product-price editable-text editable-section no-drop-zone" data-section="132" data-text="93">$29</div>
                    </div>
                </div>
                <!-- Recent Product 2 - Sample -->
                <div class="recent-product">
                    <img class="recent-product-image" src="https://images.pexels.com/photos/2115256/pexels-photo-2115256.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Gaming Chair">
                    <div class="recent-product-info">
                        <div class="recent-product-name">Nexus Gaming Chair</div>
                        <div class="recent-product-price">$349</div>
                    </div>
                </div>
                <!-- Recent Product 3 - Sample -->
                <div class="recent-product">
                    <img class="recent-product-image" src="https://images.pexels.com/photos/16131636/pexels-photo-16131636/free-photo-of-gaming-mouse-on-desk.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Gaming Mouse">
                    <div class="recent-product-info">
                        <div class="recent-product-name">Aether X Wireless Mouse</div>
                        <div class="recent-product-price">$79</div>
                    </div>
                </div>
                <!-- Recent Product 4 - Sample -->
                <div class="recent-product">
                    <img class="recent-product-image" src="https://images.pexels.com/photos/577769/pexels-photo-577769.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Headset">
                    <div class="recent-product-info">
                        <div class="recent-product-name">Spectra Wireless Headset</div>
                        <div class="recent-product-price">$189</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Wishlist Filtering
        let currentFilter = 'all';
        
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentFilter = this.textContent.toLowerCase().replace(' ', '-');
                filterWishlistItems();
            });
        });
        
        function filterWishlistItems() {
            const items = document.querySelectorAll('.wishlist-card');
            let visibleCount = 0;
            
            items.forEach(item => {
                let shouldShow = true;
                const isOnSale = item.hasAttribute('data-sale');
                const isNew = item.hasAttribute('data-new');
                const stockStatus = item.getAttribute('data-stock');
                
                switch(currentFilter) {
                    case 'on-sale':
                        shouldShow = isOnSale;
                        break;
                    case 'in-stock':
                        shouldShow = stockStatus === 'in-stock';
                        break;
                    case 'new-arrivals':
                        shouldShow = isNew;
                        break;
                    case 'all-items':
                    default:
                        shouldShow = true;
                }
                
                if (shouldShow) {
                    item.style.display = 'block';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });
            
            // Update empty state
            const wishlistGrid = document.getElementById('wishlistGrid');
            const existingEmpty = wishlistGrid.querySelector('.empty-filter-message');
            
            if (visibleCount === 0 && items.length > 0) {
                if (!existingEmpty) {
                    const emptyMsg = document.createElement('div');
                    emptyMsg.className = 'empty-filter-message';
                    emptyMsg.style.cssText = 'text-align: center; padding: 60px; background: rgba(60, 71, 72, 0.2); border-radius: 28px; grid-column: 1 / -1;';
                    emptyMsg.innerHTML = `
                        <i class="fas fa-filter" style="font-size: 3rem; color: var(--color-emerald-teal); opacity: 0.5; margin-bottom: 16px;"></i>
                        <p style="color: rgba(202, 233, 234, 0.7);">No items match your filter. Try selecting a different category.</p>
                    `;
                    wishlistGrid.appendChild(emptyMsg);
                }
            } else if (existingEmpty) {
                existingEmpty.remove();
            }
        }
        
        // Remove from Wishlist
        document.querySelectorAll('.remove-wishlist').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const wishlistCard = this.closest('.wishlist-card');
                const productName = wishlistCard.querySelector('.wishlist-name').textContent;
                
                if (confirm(`Remove "${productName}" from your wishlist?`)) {
                    wishlistCard.remove();
                    updateWishlistStats();
                    
                    if (document.querySelectorAll('.wishlist-card').length === 0) {
                        showEmptyWishlist();
                    }
                }
            });
        });
        
        // Clear All Wishlist
        document.querySelector('.clear-wishlist-btn').addEventListener('click', function() {
            const items = document.querySelectorAll('.wishlist-card');
            if (items.length === 0) {
                alert('Your wishlist is already empty.');
                return;
            }
            
            if (confirm('Are you sure you want to clear your entire wishlist? This action cannot be undone.')) {
                items.forEach(item => item.remove());
                updateWishlistStats();
                showEmptyWishlist();
            }
        });
        
        function updateWishlistStats() {
            const items = document.querySelectorAll('.wishlist-card');
            const itemCount = items.length;
            let onSaleCount = 0;
            let totalValue = 0;
            
            items.forEach(item => {
                const priceText = item.querySelector('.wishlist-price').textContent;
                const priceMatch = priceText.match(/\$(\d+)/);
                if (priceMatch) {
                    totalValue += parseInt(priceMatch[1]);
                }
                if (item.hasAttribute('data-sale')) {
                    onSaleCount++;
                }
            });
            
            const statNumbers = document.querySelectorAll('.stat-number');
            if (statNumbers.length >= 3) {
                statNumbers[0].textContent = itemCount;
                statNumbers[1].textContent = onSaleCount;
                statNumbers[2].textContent = `$${totalValue}`;
            }
        }
        
        function showEmptyWishlist() {
            const wishlistGrid = document.getElementById('wishlistGrid');
            const controls = document.querySelector('.wishlist-controls');
            const stats = document.querySelector('.wishlist-stats');
            
            if (stats) stats.style.display = 'none';
            if (controls) controls.style.display = 'none';
            
            wishlistGrid.innerHTML = `
                <div class="empty-wishlist" style="grid-column: 1 / -1;">
                    <div class="empty-wishlist-icon">
                        <i class="far fa-heart"></i>
                    </div>
                    <h2>Your Wishlist is Empty</h2>
                    <p>Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready.</p>
                    <a href="?page=products" class="shop-now-wishlist">Start Shopping</a>
                </div>
            `;
        }
        
        // Add to Cart from Wishlist
        document.querySelectorAll('.add-to-cart-wishlist').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const productName = this.closest('.wishlist-card').querySelector('.wishlist-name').textContent;
                alert(`${productName} added to cart!`);
            });
        });
        
        // Initialize filters
        filterWishlistItems();
    </script>
</body>
</html>