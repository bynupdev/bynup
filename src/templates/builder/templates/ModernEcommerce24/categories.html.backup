<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ÆTHER | Categories</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --charcoal: #2A3330;
            --sage: #74B267;
            --soft-chartreuse: #EBEA8E;
            --misted-stone: #C6CBD1;
            --dusty-rose: #CB7A81;
            --bg-white: #FFFFFF;
            --text-dark: #2A3330;
            --text-light: #5A6B66;
            --border-light: rgba(42, 51, 48, 0.1);
            --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-white);
            color: var(--text-dark);
            line-height: 1.5;
            overflow-x: hidden;
        }

        .categories-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 3rem 2rem;
        }

        /* Page Header */
        .categories-header {
            text-align: center;
            margin-bottom: 3rem;
        }

        .categories-header h1 {
            font-size: 3rem;
            font-weight: 600;
            font-family: 'Cormorant Garamond', serif;
            color: var(--charcoal);
            margin-bottom: 1rem;
        }

        .categories-header p {
            color: var(--text-light);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Category Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .category-card {
            background: var(--bg-white);
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border-light);
            transition: var(--transition);
            text-decoration: none;
            color: inherit;
            position: relative;
        }

        .category-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-md);
        }

        .category-image-container {
            position: relative;
            overflow: hidden;
            aspect-ratio: 4 / 3;
        }

        .category-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .category-card:hover .category-image {
            transform: scale(1.05);
        }

        .category-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
            padding: 2rem 1.5rem 1rem;
            color: white;
        }

        .category-name {
            font-size: 1.5rem;
            font-weight: 600;
            font-family: 'Cormorant Garamond', serif;
            margin-bottom: 0.25rem;
        }

        .category-count {
            font-size: 0.85rem;
            opacity: 0.9;
        }

        .category-info {
            padding: 1.25rem;
            text-align: center;
        }

        .category-description {
            color: var(--text-light);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 1rem;
        }

        .explore-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--sage);
            font-size: 0.85rem;
            font-weight: 500;
            text-decoration: none;
            transition: var(--transition);
        }

        .explore-link:hover {
            gap: 0.75rem;
            color: var(--charcoal);
        }

        /* Featured Collections Section */
        .featured-collections {
            margin-bottom: 4rem;
            padding: 3rem 0;
            background: linear-gradient(135deg, rgba(42, 51, 48, 0.02) 0%, rgba(116, 178, 103, 0.02) 100%);
            border-radius: 24px;
        }

        .featured-collections h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: 2rem;
            font-family: 'Cormorant Garamond', serif;
            color: var(--charcoal);
        }

        .collections-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            padding: 0 1rem;
        }

        .collection-card {
            text-align: center;
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
        }

        .collection-card:hover {
            transform: translateY(-5px);
        }

        .collection-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1rem;
            background: var(--bg-white);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: var(--sage);
            border: 1px solid var(--border-light);
            transition: var(--transition);
        }

        .collection-card:hover .collection-icon {
            background: var(--sage);
            color: white;
            border-color: var(--sage);
        }

        .collection-name {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .collection-count {
            font-size: 0.8rem;
            color: var(--text-light);
        }

        /* Category Highlights */
        .category-highlights {
            margin-bottom: 4rem;
        }

        .category-highlights h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: 2rem;
            font-family: 'Cormorant Garamond', serif;
        }

        .highlights-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
        }

        .highlight-card {
            display: flex;
            background: var(--bg-white);
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid var(--border-light);
            transition: var(--transition);
        }

        .highlight-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
        }

        .highlight-image {
            width: 40%;
            object-fit: cover;
        }

        .highlight-content {
            padding: 1.5rem;
            flex: 1;
        }

        .highlight-category {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--sage);
            margin-bottom: 0.5rem;
        }

        .highlight-title {
            font-size: 1.25rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .highlight-description {
            color: var(--text-light);
            font-size: 0.85rem;
            margin-bottom: 1rem;
            line-height: 1.5;
        }

        .highlight-link {
            color: var(--dusty-rose);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .highlight-link:hover {
            gap: 0.75rem;
        }

        /* Empty State */
        .empty-categories {
            text-align: center;
            padding: 4rem 2rem;
            background: var(--bg-white);
            border-radius: 16px;
            border: 1px solid var(--border-light);
            margin-bottom: 3rem;
        }

        .empty-categories-icon {
            font-size: 4rem;
            color: var(--misted-stone);
            margin-bottom: 1.5rem;
        }

        .empty-categories h2 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            color: var(--charcoal);
        }

        .empty-categories p {
            color: var(--text-light);
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .add-category-btn {
            display: inline-block;
            padding: 1rem 2rem;
            background: var(--charcoal);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            transition: var(--transition);
        }

        .add-category-btn:hover {
            background: var(--sage);
            transform: translateY(-2px);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .collections-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .highlights-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .categories-container {
                padding: 2rem 1.5rem;
            }
            .categories-header h1 {
                font-size: 2.2rem;
            }
            .categories-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto 2rem;
            }
            .collections-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
            }
            .highlight-card {
                flex-direction: column;
            }
            .highlight-image {
                width: 100%;
                aspect-ratio: 16 / 9;
            }
            .featured-collections {
                padding: 2rem 0;
            }
        }

        @media (max-width: 576px) {
            .collections-grid {
                grid-template-columns: 1fr;
                max-width: 250px;
                margin: 0 auto;
            }
            .category-name {
                font-size: 1.25rem;
            }
        }
    </style>
</head>
<body>

<div class="categories-container">
    
    <!-- Categories Header -->
    <div class="categories-header editable-section" data-section="500">
        <h1 class="editable-text editable-section no-drop-zone" data-section="501" data-text="500">Shop by Category</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="502" data-text="501">Discover our curated collections, each thoughtfully designed to elevate your living space</p>
    </div>

    <!-- Categories Grid -->
    <div class="categories-grid" id="categoriesGrid">
        <!-- Category 1 (Editable) - Vases -->
        <div class="category-card editable-section no-drop-zone" data-section="503">
            <div class="category-image-container">
                <img class="category-image editable-image" data-image="70" src="https://images.pexels.com/photos/8557242/pexels-photo-8557242.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Vases Collection">
                <div class="category-overlay">
                    <div class="category-name editable-text editable-section no-drop-zone" data-section="504" data-text="502">Vases & Vessels</div>
                    <div class="category-count">12 products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-description editable-text editable-section no-drop-zone" data-section="505" data-text="503">Sculptural forms that celebrate the beauty of both fresh and dried arrangements</div>
                <a href="?page=shop&category=vases" class="explore-link editable-text editable-section no-drop-zone" data-section="506" data-text="504">Explore Collection <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>

        <!-- Category 2 - Lighting -->
        <div class="category-card">
            <div class="category-image-container">
                <img class="category-image" src="https://images.pexels.com/photos/10248444/pexels-photo-10248444.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Lighting Collection">
                <div class="category-overlay">
                    <div class="category-name">Lighting</div>
                    <div class="category-count">8 products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-description">Illuminate your space with our curated selection of ambient, task, and statement lighting</div>
                <a href="?page=shop&category=lighting" class="explore-link">Explore Collection <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>

        <!-- Category 3 - Textiles -->
        <div class="category-card">
            <div class="category-image-container">
                <img class="category-image" src="https://images.pexels.com/photos/6707215/pexels-photo-6707215.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Textiles Collection">
                <div class="category-overlay">
                    <div class="category-name">Textiles</div>
                    <div class="category-count">15 products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-description">Luxurious fabrics and weaves that add warmth, texture, and comfort to any room</div>
                <a href="?page=shop&category=textiles" class="explore-link">Explore Collection <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>

        <!-- Category 4 - Wall Art -->
        <div class="category-card">
            <div class="category-image-container">
                <img class="category-image" src="https://images.pexels.com/photos/5506791/pexels-photo-5506791.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Wall Art Collection">
                <div class="category-overlay">
                    <div class="category-name">Wall Art</div>
                    <div class="category-count">10 products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-description">Curated artworks that transform blank walls into captivating focal points</div>
                <a href="?page=shop&category=wall-art" class="explore-link">Explore Collection <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>

        <!-- Category 5 - Furniture -->
        <div class="category-card">
            <div class="category-image-container">
                <img class="category-image" src="https://images.pexels.com/photos/1169104/pexels-photo-1169104.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Furniture Collection">
                <div class="category-overlay">
                    <div class="category-name">Furniture</div>
                    <div class="category-count">6 products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-description">Timeless pieces that blend form and function for modern living</div>
                <a href="?page=shop&category=furniture" class="explore-link">Explore Collection <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>

        <!-- Category 6 - Decor -->
        <div class="category-card">
            <div class="category-image-container">
                <img class="category-image" src="https://images.pexels.com/photos/4145195/pexels-photo-4145195.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop" alt="Decorative Accents">
                <div class="category-overlay">
                    <div class="category-name">Decorative Accents</div>
                    <div class="category-count">14 products</div>
                </div>
            </div>
            <div class="category-info">
                <div class="category-description">Curated accents that add personality and charm to your space</div>
                <a href="?page=shop&category=decor" class="explore-link">Explore Collection <i class="fas fa-arrow-right"></i></a>
            </div>
        </div>
    </div>

    <!-- Featured Collections Section -->
    <div class="featured-collections editable-section" data-section="507">
        <h2 class="editable-text editable-section no-drop-zone" data-section="508" data-text="505">Featured Collections</h2>
        <div class="collections-grid">
            <a href="?page=shop&collection=timeless" class="collection-card">
                <div class="collection-icon">
                    <i class="fas fa-hourglass-half"></i>
                </div>
                <div class="collection-name">Timeless Classics</div>
                <div class="collection-count">24 pieces</div>
            </a>
            <a href="?page=shop&collection=modern" class="collection-card">
                <div class="collection-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="collection-name">Modern Minimalist</div>
                <div class="collection-count">18 pieces</div>
            </a>
            <a href="?page=shop&collection=organic" class="collection-card">
                <div class="collection-icon">
                    <i class="fas fa-leaf"></i>
                </div>
                <div class="collection-name">Organic Forms</div>
                <div class="collection-count">15 pieces</div>
            </a>
            <a href="?page=shop&collection=statement" class="collection-card">
                <div class="collection-icon">
                    <i class="fas fa-star"></i>
                </div>
                <div class="collection-name">Statement Pieces</div>
                <div class="collection-count">12 pieces</div>
            </a>
        </div>
    </div>

    <!-- Category Highlights -->
    <div class="category-highlights editable-section" data-section="509">
        <h2 class="editable-text editable-section no-drop-zone" data-section="510" data-text="506">Curated Highlights</h2>
        <div class="highlights-grid">
            <div class="highlight-card">
                <img class="highlight-image" src="https://images.pexels.com/photos/8557242/pexels-photo-8557242.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" alt="Featured Vase">
                <div class="highlight-content">
                    <div class="highlight-category">VASES</div>
                    <div class="highlight-title">Hand-Thrown Ceramic Collection</div>
                    <div class="highlight-description">Each piece is uniquely crafted by artisans, celebrating imperfections and organic beauty.</div>
                    <a href="?page=shop&category=vases" class="highlight-link">Shop Now <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
            <div class="highlight-card">
                <img class="highlight-image" src="https://images.pexels.com/photos/949589/pexels-photo-949589.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" alt="Featured Lamp">
                <div class="highlight-content">
                    <div class="highlight-category">LIGHTING</div>
                    <div class="highlight-title">Sculptural Lighting Collection</div>
                    <div class="highlight-description">Where form meets function—lighting that serves as both illumination and art.</div>
                    <a href="?page=shop&category=lighting" class="highlight-link">Shop Now <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>

    <!-- Empty Categories State (hidden by default, shown when no categories) -->
    <div class="empty-categories" id="emptyCategories" style="display: none;">
        <div class="empty-categories-icon">
            <i class="fas fa-tags"></i>
        </div>
        <h2>No Categories Available</h2>
        <p>There are no product categories to display at the moment. Categories will appear here once they are added to your store.</p>
        <a href="/admin/add-category" class="add-category-btn">Add Your First Category</a>
    </div>
</div>

<script>
    // Toggle empty state if no categories
    const categoriesGrid = document.getElementById('categoriesGrid');
    const emptyCategories = document.getElementById('emptyCategories');
    
    if (categoriesGrid && categoriesGrid.children.length === 0) {
        categoriesGrid.style.display = 'none';
        if (emptyCategories) emptyCategories.style.display = 'block';
    }
    
    // Animate category cards on scroll
    const categoryCards = document.querySelectorAll('.category-card');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.1 });
    
    categoryCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(20px)';
        card.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
        observer.observe(card);
    });
    
    // Collection cards hover effect
    const collectionCards = document.querySelectorAll('.collection-card');
    collectionCards.forEach(card => {
        card.addEventListener('mouseenter', function() {
            const icon = this.querySelector('.collection-icon i');
            if (icon) {
                icon.style.transform = 'scale(1.1)';
                icon.style.transition = 'transform 0.3s ease';
            }
        });
        
        card.addEventListener('mouseleave', function() {
            const icon = this.querySelector('.collection-icon i');
            if (icon) {
                icon.style.transform = 'scale(1)';
            }
        });
    });
</script>
</body>
</html>