            </div>
            <div class="team-member editable-section no-drop-zone" data-section="773">
                <img class="team-member-image editable-image" data-image="85" src="https://images.pexels.com/photos/1181695/pexels-photo-1181695.jpeg?auto=compress&cs=tinysrgb&w=400&h=400&fit=crop" alt="David Kim">
