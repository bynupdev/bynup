            </div>
        </div>

        <!-- Team Section -->
        <div class="team-section editable-section" data-section="181">
            <h2 class="editable-text editable-section no-drop-zone" data-section="182" data-text="146">Meet the Team</h2>
            <div class="team-grid">
                <div class="team-member">
                    <div class="team-member-image" style="background-image: url('https://images.pexels.com/photos/415829/pexels-photo-415829.jpeg?auto=compress&cs=tinysrgb&w=300')"></div>
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="183" data-text="147">Elena Vasquez</div>
