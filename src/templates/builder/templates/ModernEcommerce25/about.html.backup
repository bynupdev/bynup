                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="185" data-text="149">With a background in architecture and a passion for light, Elena leads our creative vision with unwavering dedication to beauty and function.</div>
                </div>
                <div class="team-member">
                    <div class="team-member-image" style="background-image: url('https://images.pexels.com/photos/2182970/pexels-photo-2182970.jpeg?auto=compress&cs=tinysrgb&w=300')"></div>
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="186" data-text="150">Marcus Chen</div>
                    <div class="team-member-role editable-text editable-section no-drop-zone" data-section="187" data-text="151">Head of Design</div>
                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="188" data-text="152">Marcus brings over 15 years of experience in industrial design, specializing in the intersection of form and function.</div>
                </div>
                <div class="team-member">
                    <div class="team-member-image" style="background-image: url('https://images.pexels.com/photos/2380794/pexels-photo-2380794.jpeg?auto=compress&cs=tinysrgb&w=300')"></div>
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="189" data-text="153">Sarah Williams</div>
                    <div class="team-member-role editable-text editable-section no-drop-zone" data-section="190" data-text="154">Master Glass Artist</div>
                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="191" data-text="155">Sarah's expertise in glass blowing brings our most intricate designs to life, each piece uniquely beautiful.</div>
                </div>
                <div class="team-member">
                    <div class="team-member-image" style="background-image: url('https://images.pexels.com/photos/3769023/pexels-photo-3769023.jpeg?auto=compress&cs=tinysrgb&w=300')"></div>
                    <div class="team-member-name editable-text editable-section no-drop-zone" data-section="192" data-text="156">David Okonkwo</div>
                    <div class="team-member-role editable-text editable-section no-drop-zone" data-section="193" data-text="157">Engineering Lead</div>
                    <div class="team-member-bio editable-text editable-section no-drop-zone" data-section="194" data-text="158">David ensures every fixture meets rigorous safety and performance standards while pushing technological boundaries.</div>
                </div>
            </div>
        </div>

        <!-- Commitment Section -->
        <div class="commitment editable-section" data-section="195">
            <h2 class="editable-text editable-section no-drop-zone" data-section="196" data-text="159">Our Commitment</h2>
            <p class="editable-text editable-section no-drop-zone" data-section="197" data-text="160">We believe in creating lighting that lasts—not just in durability, but in timeless design. Our commitment extends beyond beautiful products to sustainable practices, ethical manufacturing, and a dedication to our community.</p>
            <div class="commitment-stats">
                <div class="commitment-stat">
                    <div class="commitment-number editable-text editable-section no-drop-zone" data-section="198" data-text="161">100%</div>
                    <div class="commitment-label editable-text editable-section no-drop-zone" data-section="199" data-text="162">LED Efficient</div>
                </div>
                <div class="commitment-stat">
                    <div class="commitment-number editable-text editable-section no-drop-zone" data-section="200" data-text="163">50K+</div>
                    <div class="commitment-label editable-text editable-section no-drop-zone" data-section="201" data-text="164">Happy Customers</div>
                </div>
                <div class="commitment-stat">
                    <div class="commitment-number editable-text editable-section no-drop-zone" data-section="202" data-text="165">30+</div>
                    <div class="commitment-label editable-text editable-section no-drop-zone" data-section="203" data-text="166">Countries Served</div>
                </div>
                <div class="commitment-stat">
                    <div class="commitment-number editable-text editable-section no-drop-zone" data-section="204" data-text="167">5 Year</div>
                    <div class="commitment-label editable-text editable-section no-drop-zone" data-section="205" data-text="168">Warranty</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Timeline animation on scroll
        const timelineItems = document.querySelectorAll('.timeline-item');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '0';
                    entry.target.style.transform = 'translateY(30px)';
                    setTimeout(() => {
                        entry.target.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }, 100);
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.2 });

        timelineItems.forEach(item => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(30px)';
            observer.observe(item);
        });

        // Team member hover effect
        const teamMembers = document.querySelectorAll('.team-member');
        teamMembers.forEach(member => {
            member.addEventListener('mouseenter', function() {
                const image = this.querySelector('.team-member-image');
                if (image) {
                    image.style.transform = 'scale(1.05)';
                    image.style.transition = 'transform 0.3s ease';
                }
            });
            member.addEventListener('mouseleave', function() {
                const image = this.querySelector('.team-member-image');
                if (image) {
                    image.style.transform = 'scale(1)';
                }
            });
        });

        // Value items animation
        const valueItems = document.querySelectorAll('.value-item');
        valueItems.forEach((item, index) => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(20px)';
            item.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
            setTimeout(() => {
                item.style.opacity = '1';
                item.style.transform = 'translateY(0)';
            }, 300 + (index * 100));
        });
    </script>
</body>
</html>