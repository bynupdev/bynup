<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details | NEXUS GEAR - Precision Gaming Equipment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --teal-primary: #02ABB0;
            --teal-deep: #035A69;
            --teal-darker: #024E5B;
            --cyan-accent: #01A4BD;
            --gray-soft: #DCDADE;
            --bg-dark: #0A0F12;
            --bg-card: rgba(16, 24, 28, 0.85);
            --text-light: #F0F2F4;
            --text-muted: #9CA3AF;
            --border-subtle: rgba(220, 218, 222, 0.12);
            --glow-teal: rgba(2, 171, 176, 0.3);
            --warning: #ffc107;
            --danger: #dc3545;
            --success: #28a745;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
            padding-top: 80px;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Space Grotesk', monospace;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Breadcrumb */
        .breadcrumb {
            padding: 20px 0;
            margin-bottom: 30px;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .breadcrumb a {
            color: var(--teal-primary);
            text-decoration: none;
            transition: color 0.2s;
        }

        .breadcrumb a:hover {
            color: var(--cyan-accent);
        }

        .breadcrumb span {
            margin: 0 8px;
            color: var(--text-muted);
        }

        /* Product Details Layout */
        .product-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            margin-bottom: 80px;
        }

        /* Product Gallery */
        .product-gallery {
            position: sticky;
            top: 100px;
        }

        .main-image-container {
            background: var(--bg-card);
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid var(--border-subtle);
            margin-bottom: 20px;
            aspect-ratio: 1 / 1;
        }

        .main-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .thumbnail-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .thumbnail {
            background: var(--bg-card);
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            aspect-ratio: 1 / 1;
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .thumbnail.active {
            border-color: var(--teal-primary);
            transform: scale(1.02);
        }

        .thumbnail:hover {
            border-color: var(--cyan-accent);
            transform: scale(1.02);
        }

        /* Product Info */
        .product-info {
            padding: 20px 0;
        }

        .product-category {
            color: var(--teal-primary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 12px;
        }

        .product-title {
            font-size: 2.5rem;
            margin-bottom: 16px;
            line-height: 1.2;
        }

        /* Rating */
        .product-rating {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .stars {
            display: flex;
            gap: 4px;
            color: var(--warning);
        }

        .stars i {
            font-size: 1rem;
        }

        .rating-value {
            font-weight: 600;
            color: var(--text-light);
        }

        .review-count {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Price */
        .product-price {
            margin-bottom: 20px;
        }

        .current-price {
            font-size: 2rem;
            font-weight: 700;
            color: var(--teal-primary);
        }

        .original-price {
            font-size: 1.2rem;
            color: var(--text-muted);
            text-decoration: line-through;
            margin-left: 12px;
        }

        .discount-badge {
            display: inline-block;
            background: var(--danger);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-left: 12px;
        }

        /* Description */
        .product-description {
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 30px;
            font-size: 1rem;
        }

        /* Variants */
        .variant-section {
            margin-bottom: 30px;
        }

        .variant-title {
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--text-light);
        }

        .color-options {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .color-option {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            position: relative;
        }

        .color-option:hover {
            transform: scale(1.05);
        }

        .color-option.active {
            border-color: var(--teal-primary);
            box-shadow: 0 0 0 2px var(--glow-teal);
        }

        .color-option input {
            display: none;
        }

        .size-options {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .size-option {
            padding: 10px 24px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .size-option:hover {
            border-color: var(--teal-primary);
            color: var(--teal-primary);
        }

        .size-option.active {
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            border-color: transparent;
            color: var(--bg-dark);
            font-weight: 600;
        }

        /* Quantity */
        .quantity-section {
            margin-bottom: 30px;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 15px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 50px;
            width: fit-content;
            padding: 5px;
        }

        .qty-btn {
            width: 40px;
            height: 40px;
            background: rgba(220, 218, 222, 0.1);
            border: none;
            border-radius: 50%;
            color: var(--text-light);
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .qty-btn:hover {
            background: var(--teal-primary);
            color: var(--bg-dark);
        }

        .quantity-input {
            width: 60px;
            text-align: center;
            background: none;
            border: none;
            color: var(--text-light);
            font-size: 1.1rem;
            font-weight: 600;
        }

        .quantity-input:focus {
            outline: none;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .buy-now-btn {
            flex: 1;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            border: none;
            padding: 16px 32px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .buy-now-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px var(--glow-teal);
        }

        .add-to-cart-btn {
            flex: 1;
            background: transparent;
            border: 2px solid var(--teal-primary);
            color: var(--teal-primary);
            padding: 16px 32px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .add-to-cart-btn:hover {
            background: var(--teal-primary);
            color: var(--bg-dark);
            transform: translateY(-2px);
        }

        .wishlist-btn {
            width: 60px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 50px;
            color: var(--text-light);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .wishlist-btn:hover {
            border-color: var(--teal-primary);
            color: var(--teal-primary);
        }

        /* Product Meta */
        .product-meta {
            padding-top: 20px;
            border-top: 1px solid var(--border-subtle);
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .meta-item i {
            width: 20px;
            color: var(--teal-primary);
        }

        /* Tabs Section */
        .tabs-section {
            margin-bottom: 80px;
        }

        .tab-headers {
            display: flex;
            gap: 10px;
            border-bottom: 1px solid var(--border-subtle);
            margin-bottom: 30px;
            flex-wrap: wrap;
        }

        .tab-btn {
            padding: 12px 28px;
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
        }

        .tab-btn:hover {
            color: var(--teal-primary);
        }

        .tab-btn.active {
            color: var(--teal-primary);
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, var(--teal-primary), var(--cyan-accent));
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Description Content */
        .description-content {
            color: var(--text-muted);
            line-height: 1.8;
        }

        .description-content p {
            margin-bottom: 16px;
        }

        /* Specifications */
        .specs-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .spec-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-subtle);
        }

        .spec-label {
            font-weight: 600;
            color: var(--text-light);
        }

        .spec-value {
            color: var(--text-muted);
        }

        /* Reviews Section */
        .reviews-summary {
            display: flex;
            gap: 40px;
            margin-bottom: 40px;
            padding: 30px;
            background: var(--bg-card);
            border-radius: 20px;
            flex-wrap: wrap;
        }

        .rating-summary {
            text-align: center;
        }

        .average-rating {
            font-size: 3rem;
            font-weight: 700;
            color: var(--teal-primary);
        }

        .rating-stars {
            margin: 10px 0;
        }

        .rating-bars {
            flex: 1;
            min-width: 250px;
        }

        .rating-bar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .rating-star-label {
            width: 60px;
            font-size: 0.9rem;
        }

        .rating-bar {
            flex: 1;
            height: 8px;
            background: rgba(220, 218, 222, 0.2);
            border-radius: 4px;
            overflow: hidden;
        }

        .rating-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--teal-primary), var(--cyan-accent));
            border-radius: 4px;
            transition: width 0.3s ease;
        }

        .rating-percent {
            width: 50px;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* Review Form */
        .review-form {
            background: var(--bg-card);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 40px;
        }

        .review-form h3 {
            margin-bottom: 20px;
        }

        .star-rating-input {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 20px;
        }

        .star-rating-input input {
            display: none;
        }

        .star-rating-input label {
            font-size: 1.8rem;
            color: var(--text-muted);
            cursor: pointer;
            transition: color 0.2s;
        }

        .star-rating-input label:hover,
        .star-rating-input label:hover ~ label,
        .star-rating-input input:checked ~ label {
            color: var(--warning);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 12px 16px;
            background: rgba(220, 218, 222, 0.1);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            color: var(--text-light);
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--teal-primary);
            box-shadow: 0 0 0 3px var(--glow-teal);
        }

        .submit-review-btn {
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            border: none;
            padding: 14px 32px;
            border-radius: 50px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .submit-review-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px var(--glow-teal);
        }

        /* Customer Reviews List */
        .reviews-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .review-card {
            background: var(--bg-card);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid var(--border-subtle);
            transition: all 0.3s ease;
        }

        .review-card:hover {
            border-color: var(--teal-primary);
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .reviewer-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .reviewer-avatar {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 1.2rem;
        }

        .reviewer-name {
            font-weight: 600;
        }

        .review-date {
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .review-rating {
            margin-bottom: 12px;
        }

        .review-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .review-comment {
            color: var(--text-muted);
            line-height: 1.7;
        }

        /* Related Products */
        .related-products {
            margin-top: 80px;
            padding-top: 40px;
            border-top: 1px solid var(--border-subtle);
        }

        .related-products h2 {
            font-size: 2rem;
            margin-bottom: 40px;
            text-align: center;
        }

        .related-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .related-card {
            background: var(--bg-card);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid var(--border-subtle);
            text-decoration: none;
            display: block;
        }

        .related-card:hover {
            transform: translateY(-5px);
            border-color: var(--teal-primary);
            box-shadow: 0 10px 30px rgba(2, 171, 176, 0.2);
        }

        .related-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .related-info {
            padding: 16px;
        }

        .related-name {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-light);
        }

        .related-price {
            color: var(--teal-primary);
            font-weight: 700;
        }

        .empty-related {
            text-align: center;
            padding: 60px;
            background: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-subtle);
            grid-column: 1 / -1;
        }

        .empty-related i {
            font-size: 3rem;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .empty-related p {
            color: var(--text-muted);
        }

        /* Responsive */
        @media (max-width: 992px) {
            .product-details {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            .product-gallery {
                position: static;
            }
            .related-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .specs-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 70px;
            }
            .container {
                padding: 0 20px;
            }
            .product-title {
                font-size: 1.8rem;
            }
            .related-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            .action-buttons {
                flex-direction: column;
            }
            .wishlist-btn {
                width: 100%;
                padding: 16px;
            }
            .thumbnail-grid {
                gap: 10px;
            }
        }
    </style>
</head>
<body>

<!-- Breadcrumb -->
<div class="container">
    <div class="breadcrumb editable-section no-drop-zone" data-section="64">
        <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="65" data-text="49">Home</a>
        <span>/</span>
        <a href="?page=shop" class="editable-text editable-section no-drop-zone" data-section="66" data-text="50">Shop</a>
        <span>/</span>
        <span class="editable-text editable-section no-drop-zone" data-section="67" data-text="51">Product Details</span>
    </div>
</div>

<!-- Product Details -->
<div class="container">
    <div class="product-details">
        <!-- Product Gallery -->
        <div class="product-gallery editable-section no-drop-zone" data-section="68">
            <div class="main-image-container">
                <img id="mainImage" src="https://images.pexels.com/photos/2115256/pexels-photo-2115256.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Main Product" class="main-image editable-image" data-image="4">
            </div>
            <div class="thumbnail-grid" id="thumbnailGrid">
                <div class="thumbnail active" data-image="https://images.pexels.com/photos/2115256/pexels-photo-2115256.jpeg?auto=compress&cs=tinysrgb&w=800">
                    <img src="https://images.pexels.com/photos/2115256/pexels-photo-2115256.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Thumbnail 1">
                </div>
                <div class="thumbnail" data-image="https://images.pexels.com/photos/2115257/pexels-photo-2115257.jpeg?auto=compress&cs=tinysrgb&w=800">
                    <img src="https://images.pexels.com/photos/2115257/pexels-photo-2115257.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Thumbnail 2">
                </div>
                <div class="thumbnail" data-image="https://images.pexels.com/photos/2115258/pexels-photo-2115258.jpeg?auto=compress&cs=tinysrgb&w=800">
                    <img src="https://images.pexels.com/photos/2115258/pexels-photo-2115258.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Thumbnail 3">
                </div>
                <div class="thumbnail" data-image="https://images.pexels.com/photos/4425760/pexels-photo-4425760.jpeg?auto=compress&cs=tinysrgb&w=800">
                    <img src="https://images.pexels.com/photos/4425760/pexels-photo-4425760.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Thumbnail 4">
                </div>
            </div>
        </div>

        <!-- Product Info -->
        <div class="product-info editable-section no-drop-zone" data-section="69">
            <div class="product-category editable-text editable-section no-drop-zone" data-section="70" data-text="52">GAMING KEYBOARD</div>
            <h1 class="product-title editable-text editable-section no-drop-zone" data-section="71" data-text="53">NEXUS MECHANICAL K95</h1>
            
            <div class="product-rating">
                <div class="stars" id="ratingStars">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star-half-alt"></i>
                </div>
                <span class="rating-value editable-text editable-section no-drop-zone" data-section="72" data-text="54">4.7</span>
                <span class="review-count editable-text editable-section no-drop-zone" data-section="73" data-text="55">(128 reviews)</span>
            </div>
            
            <div class="product-price">
                <span class="current-price editable-text editable-section no-drop-zone" data-section="74" data-text="56">$149.99</span>
                <span class="original-price editable-text editable-section no-drop-zone" data-section="75" data-text="57">$199.99</span>
                <span class="discount-badge editable-text editable-section no-drop-zone" data-section="76" data-text="58">-25%</span>
            </div>
            
            <p class="product-description editable-text editable-section no-drop-zone" data-section="77" data-text="59">
                Experience precision gaming with the NEXUS MECHANICAL K95. Featuring ultra-responsive mechanical switches, customizable RGB lighting, and durable construction. Perfect for competitive gaming and long gaming sessions.
            </p>
            
            <!-- Color Variants -->
            <div class="variant-section editable-section no-drop-zone" data-section="78">
                <div class="variant-title editable-text editable-section no-drop-zone" data-section="79" data-text="60">Color</div>
                <div class="color-options" id="colorOptions">
                    <div class="color-option active" style="background-color: #1a1a2e;" data-color="black"></div>
                    <div class="color-option" style="background-color: #4a4e69;" data-color="gray"></div>
                    <div class="color-option" style="background-color: #9a8c98;" data-color="silver"></div>
                    <div class="color-option" style="background-color: #c9ada7;" data-color="white"></div>
                </div>
            </div>
            
            <!-- Size Variants -->
            <div class="variant-section editable-section no-drop-zone" data-section="80">
                <div class="variant-title editable-text editable-section no-drop-zone" data-section="81" data-text="61">Switch Type</div>
                <div class="size-options" id="sizeOptions">
                    <div class="size-option active" data-size="red">Red (Linear)</div>
                    <div class="size-option" data-size="blue">Blue (Clicky)</div>
                    <div class="size-option" data-size="brown">Brown (Tactile)</div>
                </div>
            </div>
            
            <!-- Quantity -->
            <div class="quantity-section">
                <div class="variant-title">Quantity</div>
                <div class="quantity-selector">
                    <button class="qty-btn" id="qtyMinus">-</button>
                    <input type="number" id="quantity" class="quantity-input" value="1" min="1" max="10">
                    <button class="qty-btn" id="qtyPlus">+</button>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="buy-now-btn" id="buyNowBtn">
                    <i class="fas fa-bolt"></i> Buy Now
                </button>
                <button class="add-to-cart-btn" id="addToCartBtn">
                    <i class="fas fa-cart-plus"></i> Add to Cart
                </button>
                <button class="wishlist-btn" id="wishlistBtn">
                    <i class="far fa-heart"></i>
                </button>
            </div>
            
            <!-- Product Meta -->
