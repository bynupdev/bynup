                <div class="meta-item">
                    <i class="fas fa-truck"></i>
                    <span class="editable-text editable-section no-drop-zone" data-section="82" data-text="62">Free Shipping Worldwide</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-undo-alt"></i>
                    <span class="editable-text editable-section no-drop-zone" data-section="83" data-text="63">30-Day Money-Back Guarantee</span>
                </div>
                <div class="meta-item">
                    <i class="fas fa-shield-alt"></i>
                    <span class="editable-text editable-section no-drop-zone" data-section="84" data-text="64">2-Year Warranty</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs Section -->
    <div class="tabs-section editable-section no-drop-zone" data-section="85">
        <div class="tab-headers">
            <button class="tab-btn active" data-tab="description">Description</button>
            <button class="tab-btn" data-tab="specifications">Specifications</button>
            <button class="tab-btn" data-tab="reviews">Reviews</button>
