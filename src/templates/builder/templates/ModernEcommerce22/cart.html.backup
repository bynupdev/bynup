<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | NEXUS GEAR - Precision Gaming Equipment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --teal-primary: #02ABB0;
            --teal-deep: #035A69;
            --teal-darker: #024E5B;
            --cyan-accent: #01A4BD;
            --gray-soft: #DCDADE;
            --bg-dark: #0A0F12;
            --bg-card: rgba(16, 24, 28, 0.85);
            --text-light: #F0F2F4;
            --text-muted: #9CA3AF;
            --border-subtle: rgba(220, 218, 222, 0.12);
            --glow-teal: rgba(2, 171, 176, 0.3);
            --success: #28a745;
            --danger: #dc3545;
            --warning: #ffc107;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
            padding-top: 80px;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Space Grotesk', monospace;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: 40px 0 30px;
            background: radial-gradient(circle at 50% 0%, rgba(2, 171, 176, 0.08), transparent);
            margin-bottom: 40px;
        }

        .page-header h1 {
            font-size: 3rem;
            margin-bottom: 12px;
            position: relative;
            display: inline-block;
        }

        .page-header h1::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, var(--teal-primary), var(--cyan-accent));
            border-radius: 3px;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 1rem;
            margin-top: 20px;
        }

        /* Cart Layout */
        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 40px;
            margin-bottom: 80px;
        }

        /* Cart Items Table */
        .cart-items-section {
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid var(--border-subtle);
            overflow: hidden;
        }

        .cart-header {
            display: grid;
            grid-template-columns: 3fr 1fr 1fr 0.5fr;
            padding: 20px 24px;
            background: rgba(2, 171, 176, 0.1);
            border-bottom: 1px solid var(--border-subtle);
            font-weight: 600;
            color: var(--text-light);
        }

        .cart-item {
            display: grid;
            grid-template-columns: 3fr 1fr 1fr 0.5fr;
            padding: 24px;
            border-bottom: 1px solid var(--border-subtle);
            transition: all 0.3s ease;
            align-items: center;
        }

        .cart-item:hover {
            background: rgba(2, 171, 176, 0.05);
        }

        /* Product Info */
        .product-info-cart {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .product-image-cart {
            width: 100px;
            height: 100px;
            background: var(--bg-dark);
            border-radius: 16px;
            overflow: hidden;
            flex-shrink: 0;
        }

        .product-image-cart img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-details-cart h3 {
            font-size: 1.1rem;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .product-variant-cart {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        .product-stock-status {
            font-size: 0.75rem;
            color: var(--success);
        }

        .product-stock-status.out-of-stock {
            color: var(--danger);
        }

        /* Quantity Controls */
        .quantity-controls-cart {
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--bg-dark);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            width: fit-content;
            padding: 4px;
        }

        .qty-btn-cart {
            width: 32px;
            height: 32px;
            background: rgba(220, 218, 222, 0.1);
            border: none;
            border-radius: 50%;
            color: var(--text-light);
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .qty-btn-cart:hover {
            background: var(--teal-primary);
            color: var(--bg-dark);
        }

        .quantity-input-cart {
            width: 50px;
            text-align: center;
            background: none;
            border: none;
            color: var(--text-light);
            font-size: 1rem;
            font-weight: 500;
        }

        .quantity-input-cart:focus {
            outline: none;
        }

        /* Price and Total */
        .product-price-cart {
            font-weight: 600;
            color: var(--teal-primary);
        }

        .product-total-cart {
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--text-light);
        }

        .remove-item-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1.2rem;
            transition: all 0.3s ease;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .remove-item-btn:hover {
            background: rgba(220, 53, 69, 0.2);
            color: var(--danger);
        }

        /* Cart Summary */
        .cart-summary {
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid var(--border-subtle);
            padding: 28px;
            position: sticky;
            top: 100px;
        }

        .cart-summary h2 {
            font-size: 1.5rem;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border-subtle);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            color: var(--text-muted);
        }

        .summary-row.total {
            border-top: 1px solid var(--border-subtle);
            margin-top: 12px;
            padding-top: 20px;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-light);
        }

        .summary-row.total .amount {
            color: var(--teal-primary);
            font-size: 1.4rem;
        }

        /* Promo Code */
        .promo-section {
            margin: 24px 0;
            padding: 20px 0;
            border-top: 1px solid var(--border-subtle);
            border-bottom: 1px solid var(--border-subtle);
        }

        .promo-input-group {
            display: flex;
            gap: 12px;
        }

        .promo-input {
            flex: 1;
            padding: 12px 16px;
            background: var(--bg-dark);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            color: var(--text-light);
            font-size: 0.9rem;
        }

        .promo-input:focus {
            outline: none;
            border-color: var(--teal-primary);
        }

        .apply-promo-btn {
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            border: none;
            padding: 12px 24px;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .apply-promo-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px var(--glow-teal);
        }

        .promo-message {
            margin-top: 12px;
            font-size: 0.8rem;
            color: var(--success);
        }

        .promo-message.error {
            color: var(--danger);
        }

        /* Checkout Button */
        .checkout-btn {
            width: 100%;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            border: none;
            padding: 18px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 24px;
        }

        .checkout-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px var(--glow-teal);
        }

        .continue-shopping {
            text-align: center;
            margin-top: 20px;
        }

        .continue-shopping a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .continue-shopping a:hover {
            color: var(--teal-primary);
        }

        /* Empty Cart */
        .empty-cart {
            text-align: center;
            padding: 80px 20px;
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid var(--border-subtle);
            grid-column: 1 / -1;
        }

        .empty-cart-icon {
            font-size: 5rem;
            color: var(--text-muted);
            margin-bottom: 24px;
        }

        .empty-cart h2 {
            font-size: 2rem;
            margin-bottom: 16px;
        }

        .empty-cart p {
            color: var(--text-muted);
            margin-bottom: 32px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-now-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            padding: 14px 40px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .shop-now-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px var(--glow-teal);
        }

        /* You May Also Like Section */
        .you-may-also-like {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 1px solid var(--border-subtle);
        }

        .you-may-also-like h2 {
            font-size: 2rem;
            margin-bottom: 40px;
            text-align: center;
        }

        .recommended-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 40px;
        }

        .recommended-card {
            background: var(--bg-card);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid var(--border-subtle);
            text-decoration: none;
            display: block;
        }

        .recommended-card:hover {
            transform: translateY(-5px);
            border-color: var(--teal-primary);
            box-shadow: 0 10px 30px rgba(2, 171, 176, 0.2);
        }

        .recommended-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .recommended-info {
            padding: 16px;
        }

        .recommended-name {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-light);
        }

        .recommended-price {
            color: var(--teal-primary);
            font-weight: 700;
            margin-bottom: 12px;
        }

        .add-to-cart-recommended {
            width: 100%;
            background: transparent;
            border: 1px solid var(--teal-primary);
            color: var(--teal-primary);
            padding: 10px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .add-to-cart-recommended:hover {
            background: var(--teal-primary);
            color: var(--bg-dark);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }
            .cart-summary {
                position: static;
            }
            .recommended-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 70px;
            }
            .container {
                padding: 0 20px;
            }
            .cart-header {
                display: none;
            }
            .cart-item {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .product-info-cart {
                flex-direction: column;
                text-align: center;
            }
            .quantity-controls-cart {
                margin: 0 auto;
            }
            .product-price-cart,
            .product-total-cart {
                text-align: center;
            }
            .remove-item-btn {
                position: absolute;
                top: 20px;
                right: 20px;
            }
            .cart-item {
                position: relative;
            }
            .recommended-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .page-header h1 {
                font-size: 2.2rem;
            }
        }

        @media (max-width: 480px) {
            .recommended-grid {
                grid-template-columns: 1fr;
                max-width: 320px;
                margin-left: auto;
                margin-right: auto;
            }
            .promo-input-group {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>

<!-- Page Header -->
<div class="page-header editable-section no-drop-zone" data-section="92">
    <div class="container">
        <h1 class="editable-text editable-section no-drop-zone" data-section="93" data-text="68">Shopping Cart</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="94" data-text="69">Review your items and proceed to checkout</p>
    </div>
</div>

<div class="container">
    <div class="cart-layout">
        <!-- Cart Items Section -->
        <div class="cart-items-section editable-section no-drop-zone" data-section="95">
            <div class="cart-header">
                <div>Product</div>
                <div>Price</div>
                <div>Quantity</div>
                <div>Total</div>
            </div>
            
            <!-- Cart Item 1 - Editable -->
            <div class="cart-item editable-section no-drop-zone" data-section="96" data-product-id="1" data-product-price="149.99">
                <div class="product-info-cart">
                    <div class="product-image-cart">
                        <img src="https://images.pexels.com/photos/2115256/pexels-photo-2115256.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Product" class="editable-image" data-image="5">
                    </div>
                    <div class="product-details-cart">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="97" data-text="70">NEXUS MECHANICAL K95</h3>
                        <div class="product-variant-cart editable-text editable-section no-drop-zone" data-section="98" data-text="71">Color: Black | Switch: Red</div>
                        <div class="product-stock-status">In Stock</div>
                    </div>
                </div>
                <div class="product-price-cart editable-text editable-section no-drop-zone" data-section="99" data-text="72">$149.99</div>
                <div class="quantity-controls-cart">
                    <button class="qty-btn-cart qty-minus" data-product-id="1">-</button>
                    <input type="text" class="quantity-input-cart qty-input" value="1" data-product-id="1">
                    <button class="qty-btn-cart qty-plus" data-product-id="1">+</button>
                </div>
                <div class="product-total-cart item-total" data-product-id="1">$149.99</div>
                <button class="remove-item-btn remove-item" data-product-id="1">
                    <i class="fas fa-trash-alt"></i>
                </button>
            </div>
            
            <!-- Cart Item 2 - Non-editable -->
            <div class="cart-item" data-product-id="2" data-product-price="79.99">
                <div class="product-info-cart">
                    <div class="product-image-cart">
                        <img src="https://images.pexels.com/photos/2115258/pexels-photo-2115258.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Product">
                    </div>
                    <div class="product-details-cart">
                        <h3>OMEGA PRO WIRELESS Mouse</h3>
                        <div class="product-variant-cart">Color: Black</div>
                        <div class="product-stock-status">In Stock</div>
                    </div>
                </div>
                <div class="product-price-cart">$79.99</div>
                <div class="quantity-controls-cart">
                    <button class="qty-btn-cart qty-minus" data-product-id="2">-</button>
                    <input type="text" class="quantity-input-cart qty-input" value="1" data-product-id="2">
                    <button class="qty-btn-cart qty-plus" data-product-id="2">+</button>
                </div>
                <div class="product-total-cart item-total" data-product-id="2">$79.99</div>
                <button class="remove-item-btn remove-item" data-product-id="2">
                    <i class="fas fa-trash-alt"></i>
                </button>
            </div>
            
            <!-- Cart Item 3 - Non-editable -->
            <div class="cart-item" data-product-id="3" data-product-price="129.99">
                <div class="product-info-cart">
                    <div class="product-image-cart">
                        <img src="https://images.pexels.com/photos/577769/pexels-photo-577769.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Product">
                    </div>
                    <div class="product-details-cart">
                        <h3>AETHER 7.1 HEADSET</h3>
                        <div class="product-variant-cart">Color: Black</div>
                        <div class="product-stock-status">In Stock</div>
                    </div>
                </div>
                <div class="product-price-cart">$129.99</div>
                <div class="quantity-controls-cart">
                    <button class="qty-btn-cart qty-minus" data-product-id="3">-</button>
                    <input type="text" class="quantity-input-cart qty-input" value="1" data-product-id="3">
                    <button class="qty-btn-cart qty-plus" data-product-id="3">+</button>
                </div>
                <div class="product-total-cart item-total" data-product-id="3">$129.99</div>
                <button class="remove-item-btn remove-item" data-product-id="3">
                    <i class="fas fa-trash-alt"></i>
                </button>
            </div>
        </div>
        
        <!-- Cart Summary -->
        <div class="cart-summary editable-section no-drop-zone" data-section="100">
            <h2 class="editable-text editable-section no-drop-zone" data-section="101" data-text="73">Order Summary</h2>
            
            <div class="summary-row">
                <span>Subtotal</span>
                <span id="cartSubtotal">$359.97</span>
            </div>
            <div class="summary-row">
                <span>Shipping</span>
                <span id="cartShipping">Free</span>
            </div>
            <div class="summary-row">
                <span>Tax (8%)</span>
                <span id="cartTax">$28.80</span>
            </div>
            
            <div class="promo-section">
                <div class="promo-input-group">
                    <input type="text" id="promoCode" class="promo-input editable-text editable-section no-drop-zone" data-section="102" data-text="74" placeholder="Enter promo code">
                    <button class="apply-promo-btn" id="applyPromoBtn">Apply</button>
                </div>
                <div id="promoMessage" class="promo-message"></div>
            </div>
            
            <div class="summary-row total">
                <span>Total</span>
                <span class="amount" id="cartTotal">$388.77</span>
            </div>
            
            <button class="checkout-btn" id="checkoutBtn">
                <i class="fas fa-lock"></i> Proceed to Checkout
            </button>
            
            <div class="continue-shopping">
                <a href="?page=shop">
                    <i class="fas fa-arrow-left"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
    
    <!-- You May Also Like Section -->
    <div class="you-may-also-like editable-section no-drop-zone" data-section="103">
        <h2 class="editable-text editable-section no-drop-zone" data-section="104" data-text="75">You May Also Like</h2>
        <div class="recommended-grid">
            <div class="recommended-card">
                <img src="https://images.pexels.com/photos/4425760/pexels-photo-4425760.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Recommended" class="recommended-img">
                <div class="recommended-info">
                    <div class="recommended-name">VECTOR ELITE Controller</div>
                    <div class="recommended-price">$69.99</div>
                    <button class="add-to-cart-recommended" data-product-id="4">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
            <div class="recommended-card">
                <img src="https://images.pexels.com/photos/2115259/pexels-photo-2115259.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Recommended" class="recommended-img">
                <div class="recommended-info">
                    <div class="recommended-name">NEXUS Gaming Mouse Pad</div>
                    <div class="recommended-price">$29.99</div>
                    <button class="add-to-cart-recommended" data-product-id="5">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
            <div class="recommended-card">
                <img src="https://images.pexels.com/photos/4425760/pexels-photo-4425760.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Recommended" class="recommended-img">
                <div class="recommended-info">
                    <div class="recommended-name">NEXUS Gaming Desk Mat</div>
                    <div class="recommended-price">$49.99</div>
                    <button class="add-to-cart-recommended" data-product-id="6">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
            <div class="recommended-card">
                <img src="https://images.pexels.com/photos/2115257/pexels-photo-2115257.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Recommended" class="recommended-img">
                <div class="recommended-info">
                    <div class="recommended-name">NEXUS RGB Headset Stand</div>
                    <div class="recommended-price">$39.99</div>
                    <button class="add-to-cart-recommended" data-product-id="7">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Cart Data
    let cartItems = [
        { id: 1, name: "NEXUS MECHANICAL K95", price: 149.99, quantity: 1, variant: "Color: Black | Switch: Red" },
        { id: 2, name: "OMEGA PRO WIRELESS Mouse", price: 79.99, quantity: 1, variant: "Color: Black" },
        { id: 3, name: "AETHER 7.1 HEADSET", price: 129.99, quantity: 1, variant: "Color: Black" }
    ];
    
    let appliedPromo = null;
    const validPromos = {
        'SAVE10': { type: 'percentage', value: 10, message: '10% discount applied!' },
        'SAVE20': { type: 'percentage', value: 20, message: '20% discount applied!' },
        'FREESHIP': { type: 'free_shipping', message: 'Free shipping applied!' }
    };
    
    // Update Cart Display
    function updateCartDisplay() {
        let subtotal = 0;
        
        cartItems.forEach(item => {
            const itemTotal = item.price * item.quantity;
            subtotal += itemTotal;
            
            // Update quantity input
            const qtyInput = document.querySelector(`.qty-input[data-product-id="${item.id}"]`);
            if (qtyInput) qtyInput.value = item.quantity;
            
            // Update item total
            const itemTotalElement = document.querySelector(`.item-total[data-product-id="${item.id}"]`);
            if (itemTotalElement) itemTotalElement.textContent = `$${itemTotal.toFixed(2)}`;
        });
        
        // Update subtotal
        document.getElementById('cartSubtotal').textContent = `$${subtotal.toFixed(2)}`;
        
        // Calculate shipping
        let shipping = 0;
        let shippingText = 'Free';
        if (subtotal < 50) {
            shipping = 5.99;
            shippingText = '$5.99';
        } else if (subtotal < 100) {
            shipping = 3.99;
            shippingText = '$3.99';
        }
        document.getElementById('cartShipping').textContent = shippingText;
        
        // Calculate tax
        const tax = subtotal * 0.08;
        document.getElementById('cartTax').textContent = `$${tax.toFixed(2)}`;
        
        // Calculate total with promo
        let total = subtotal + shipping + tax;
        let discountAmount = 0;
        
        if (appliedPromo) {
            if (appliedPromo.type === 'percentage') {
                discountAmount = subtotal * (appliedPromo.value / 100);
                total = total - discountAmount;
            } else if (appliedPromo.type === 'free_shipping') {
                total = subtotal + tax;
            }
        }
        
        document.getElementById('cartTotal').textContent = `$${total.toFixed(2)}`;
    }
    
    // Update individual item total
    function updateItemTotal(productId) {
        const item = cartItems.find(i => i.id == productId);
        if (item) {
            const total = item.price * item.quantity;
            const totalElement = document.querySelector(`.item-total[data-product-id="${productId}"]`);
            if (totalElement) totalElement.textContent = `$${total.toFixed(2)}`;
        }
        updateCartDisplay();
    }
    
    // Quantity Controls
    document.querySelectorAll('.qty-plus').forEach(btn => {
        btn.addEventListener('click', function() {
            const productId = parseInt(this.dataset.productId);
            const item = cartItems.find(i => i.id === productId);
            if (item && item.quantity < 10) {
                item.quantity++;
                updateItemTotal(productId);
                showNotification('Quantity updated', 'success');
            }
        });
    });
    
    document.querySelectorAll('.qty-minus').forEach(btn => {
        btn.addEventListener('click', function() {
            const productId = parseInt(this.dataset.productId);
            const item = cartItems.find(i => i.id === productId);
            if (item && item.quantity > 1) {
                item.quantity--;
                updateItemTotal(productId);
                showNotification('Quantity updated', 'success');
            }
        });
    });
    
    document.querySelectorAll('.qty-input').forEach(input => {
        input.addEventListener('change', function() {
            const productId = parseInt(this.dataset.productId);
            let newQty = parseInt(this.value);
            if (isNaN(newQty) || newQty < 1) newQty = 1;
            if (newQty > 10) newQty = 10;
            
            const item = cartItems.find(i => i.id === productId);
            if (item) {
                item.quantity = newQty;
                updateItemTotal(productId);
            }
        });
    });
    
    // Remove Item
    document.querySelectorAll('.remove-item').forEach(btn => {
        btn.addEventListener('click', function() {
            const productId = parseInt(this.dataset.productId);
            const itemIndex = cartItems.findIndex(i => i.id === productId);
            if (itemIndex !== -1) {
                cartItems.splice(itemIndex, 1);
                const cartItemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                if (cartItemElement) cartItemElement.remove();
                updateCartDisplay();
                showNotification('Item removed from cart', 'success');
                
                // Show empty cart state if no items
                if (cartItems.length === 0) {
                    showEmptyCartState();
                }
            }
        });
    });
    
    // Apply Promo Code
    const applyPromoBtn = document.getElementById('applyPromoBtn');
    const promoInput = document.getElementById('promoCode');
    const promoMessage = document.getElementById('promoMessage');
    
    applyPromoBtn.addEventListener('click', function() {
        const code = promoInput.value.trim().toUpperCase();
        
        if (validPromos[code]) {
            appliedPromo = validPromos[code];
            promoMessage.textContent = appliedPromo.message;
            promoMessage.classList.remove('error');
            promoMessage.classList.add('success');
            updateCartDisplay();
            showNotification(appliedPromo.message, 'success');
        } else {
            promoMessage.textContent = 'Invalid promo code';
            promoMessage.classList.add('error');
            promoMessage.classList.remove('success');
        }
    });
    
    // Checkout Button
    const checkoutBtn = document.getElementById('checkoutBtn');
    checkoutBtn.addEventListener('click', function() {
        if (cartItems.length === 0) {
            showNotification('Your cart is empty', 'error');
            return;
        }
        showNotification('Redirecting to checkout...', 'success');
        setTimeout(() => {
            // window.location.href = '?page=checkout';
        }, 1500);
    });
    
    // Add to Cart from Recommended
    document.querySelectorAll('.add-to-cart-recommended').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const productId = parseInt(this.dataset.productId);
            const productName = this.closest('.recommended-card')?.querySelector('.recommended-name')?.textContent || 'Product';
            const productPrice = parseFloat(this.closest('.recommended-card')?.querySelector('.recommended-price')?.textContent.replace('$', '') || '0');
            
            const existingItem = cartItems.find(i => i.id === productId);
            if (existingItem) {
                existingItem.quantity++;
                updateCartDisplay();
            } else {
                cartItems.push({
                    id: productId,
                    name: productName,
                    price: productPrice,
                    quantity: 1,
                    variant: 'Standard'
                });
                
                // Add new cart item to DOM
                const cartSection = document.querySelector('.cart-items-section');
                const cartHeader = cartSection.querySelector('.cart-header');
                const newItemHtml = `
                    <div class="cart-item" data-product-id="${productId}" data-product-price="${productPrice}">
                        <div class="product-info-cart">
                            <div class="product-image-cart">
                                <img src="https://images.pexels.com/photos/2115258/pexels-photo-2115258.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Product">
                            </div>
                            <div class="product-details-cart">
                                <h3>${productName}</h3>
                                <div class="product-variant-cart">Standard</div>
                                <div class="product-stock-status">In Stock</div>
                            </div>
                        </div>
                        <div class="product-price-cart">$${productPrice.toFixed(2)}</div>
                        <div class="quantity-controls-cart">
                            <button class="qty-btn-cart qty-minus" data-product-id="${productId}">-</button>
                            <input type="text" class="quantity-input-cart qty-input" value="1" data-product-id="${productId}">
                            <button class="qty-btn-cart qty-plus" data-product-id="${productId}">+</button>
                        </div>
                        <div class="product-total-cart item-total" data-product-id="${productId}">$${productPrice.toFixed(2)}</div>
                        <button class="remove-item-btn remove-item" data-product-id="${productId}">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `;
                cartHeader.insertAdjacentHTML('afterend', newItemHtml);
                
                // Add event listeners for new item
                attachItemEventListeners(productId);
            }
            
            updateCartDisplay();
            showNotification(`${productName} added to cart!`, 'success');
        });
    });
    
    function attachItemEventListeners(productId) {
        const newQtyMinus = document.querySelector(`.qty-minus[data-product-id="${productId}"]`);
        const newQtyPlus = document.querySelector(`.qty-plus[data-product-id="${productId}"]`);
        const newQtyInput = document.querySelector(`.qty-input[data-product-id="${productId}"]`);
        const newRemoveBtn = document.querySelector(`.remove-item[data-product-id="${productId}"]`);
        
        if (newQtyMinus) {
            newQtyMinus.addEventListener('click', function() {
                const item = cartItems.find(i => i.id === productId);
                if (item && item.quantity > 1) {
                    item.quantity--;
                    updateItemTotal(productId);
                    showNotification('Quantity updated', 'success');
                }
            });
        }
        
        if (newQtyPlus) {
            newQtyPlus.addEventListener('click', function() {
                const item = cartItems.find(i => i.id === productId);
                if (item && item.quantity < 10) {
                    item.quantity++;
                    updateItemTotal(productId);
                    showNotification('Quantity updated', 'success');
                }
            });
        }
        
        if (newQtyInput) {
            newQtyInput.addEventListener('change', function() {
                let newQty = parseInt(this.value);
                if (isNaN(newQty) || newQty < 1) newQty = 1;
                if (newQty > 10) newQty = 10;
                
                const item = cartItems.find(i => i.id === productId);
                if (item) {
                    item.quantity = newQty;
                    updateItemTotal(productId);
                }
            });
        }
        
        if (newRemoveBtn) {
            newRemoveBtn.addEventListener('click', function() {
                const itemIndex = cartItems.findIndex(i => i.id === productId);
                if (itemIndex !== -1) {
                    cartItems.splice(itemIndex, 1);
                    const cartItemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                    if (cartItemElement) cartItemElement.remove();
                    updateCartDisplay();
                    showNotification('Item removed from cart', 'success');
                    
                    if (cartItems.length === 0) {
                        showEmptyCartState();
                    }
                }
            });
        }
    }
    
    function showEmptyCartState() {
        const cartLayout = document.querySelector('.cart-layout');
        const youMayAlsoLike = document.querySelector('.you-may-also-like');
        
        if (cartLayout && !document.querySelector('.empty-cart')) {
            const emptyCartHtml = `
                <div class="empty-cart">
                    <div class="empty-cart-icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                    <h2>Your Cart is Empty</h2>
                    <p>Looks like you haven't added any gaming gear to your cart yet. Explore our collection to find the perfect equipment for your setup.</p>
                    <a href="?page=shop" class="shop-now-btn">Start Shopping</a>
                </div>
            `;
            cartLayout.innerHTML = emptyCartHtml;
            if (youMayAlsoLike) youMayAlsoLike.style.display = 'block';
        }
    }
    
    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 100px;
            right: 20px;
            background: ${type === 'success' ? 'var(--teal-primary)' : 'var(--danger)'};
            color: ${type === 'success' ? 'var(--bg-dark)' : 'white'};
            padding: 14px 24px;
            border-radius: 50px;
            font-weight: 500;
            z-index: 10000;
            animation: slideIn 0.3s ease;
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        `;
        notification.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}"></i> ${message}`;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }
    
    // Add animation styles
    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes slideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }
    `;
    document.head.appendChild(style);
    
    // Initialize cart display
    updateCartDisplay();
</script>
</body>
</html>