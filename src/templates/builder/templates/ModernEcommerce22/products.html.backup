<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | NEXUS GEAR - Precision Gaming Equipment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --teal-primary: #02ABB0;
            --teal-deep: #035A69;
            --teal-darker: #024E5B;
            --cyan-accent: #01A4BD;
            --gray-soft: #DCDADE;
            --bg-dark: #0A0F12;
            --bg-card: rgba(16, 24, 28, 0.85);
            --text-light: #F0F2F4;
            --text-muted: #9CA3AF;
            --border-subtle: rgba(220, 218, 222, 0.12);
            --glow-teal: rgba(2, 171, 176, 0.3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
            padding-top: 80px;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Space Grotesk', monospace;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Shop Header */
        .shop-header {
            text-align: center;
            padding: 60px 0 40px;
            background: radial-gradient(circle at 50% 0%, rgba(2, 171, 176, 0.08), transparent);
        }

        .shop-header h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        .shop-header h1::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: linear-gradient(90deg, var(--teal-primary), var(--cyan-accent));
            border-radius: 3px;
        }

        .shop-header p {
            color: var(--text-muted);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 1.5rem auto 0;
        }

        /* Shop Controls */
        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 50px;
            padding: 20px 0;
            border-bottom: 1px solid var(--border-subtle);
        }

        .search-container {
            flex: 1;
            max-width: 400px;
        }

        .search-wrapper {
            position: relative;
            width: 100%;
        }

        .search-input {
            width: 100%;
            padding: 14px 20px 14px 48px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 50px;
            color: var(--text-light);
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--teal-primary);
            box-shadow: 0 0 0 3px var(--glow-teal);
        }

        .search-icon {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .clear-search {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            display: none;
        }

        .filter-container {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .categories-btn {
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            padding: 12px 28px;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .categories-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px var(--glow-teal);
        }

        .filter-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-chip {
            padding: 8px 20px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            color: var(--text-light);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .filter-chip:hover {
            border-color: var(--teal-primary);
            color: var(--teal-primary);
        }

        .filter-chip.active {
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            border-color: transparent;
            color: var(--bg-dark);
        }

        .sort-container select {
            padding: 10px 20px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            color: var(--text-light);
            font-size: 0.9rem;
            cursor: pointer;
        }

        .sort-container select:focus {
            outline: none;
            border-color: var(--teal-primary);
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .product-card {
            background: var(--bg-card);
            backdrop-filter: blur(8px);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            border: 1px solid rgba(220, 218, 222, 0.08);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-8px);
            border-color: rgba(2, 171, 176, 0.4);
            box-shadow: 0 20px 35px -12px rgba(2, 171, 176, 0.2);
        }

        .product-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.03);
        }

        .product-info {
            padding: 20px 18px 24px;
        }

        .product-category {
            color: var(--teal-primary);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .product-name {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 8px;
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
        }

        .product-price {
            color: var(--teal-primary);
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 15px;
        }

        .product-actions {
            display: flex;
            gap: 12px;
        }

        .add-to-cart {
            flex: 1;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            border: none;
            padding: 10px 0;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .add-to-cart:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px var(--glow-teal);
        }

        .wishlist-btn {
            width: 42px;
            background: rgba(220, 218, 222, 0.1);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            color: var(--text-light);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .wishlist-btn:hover {
            border-color: var(--teal-primary);
            color: var(--teal-primary);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-subtle);
            grid-column: 1 / -1;
        }

        .empty-state-icon {
            font-size: 4rem;
            color: var(--teal-primary);
            margin-bottom: 20px;
        }

        .empty-state h3 {
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .empty-state p {
            color: var(--text-muted);
            margin-bottom: 25px;
        }

        .empty-state a {
            color: var(--teal-primary);
            text-decoration: none;
            font-weight: 500;
        }

        /* Results Count */
        .results-count {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .shop-controls {
                flex-direction: column;
                align-items: stretch;
            }
            .search-container {
                max-width: 100%;
            }
            .filter-container {
                justify-content: space-between;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 70px;
            }
            .container {
                padding: 0 20px;
            }
            .shop-header h1 {
                font-size: 2.5rem;
            }
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .filter-container {
                flex-direction: column;
                align-items: stretch;
            }
            .filter-buttons {
                justify-content: center;
            }
            .categories-btn {
                text-align: center;
                justify-content: center;
            }
        }
    </style>
</head>
<body>

<!-- Shop Header -->
<div class="shop-header editable-section no-drop-zone" data-section="36">
    <div class="container">
        <h1 class="editable-text editable-section no-drop-zone" data-section="37" data-text="27">Gaming Arsenal</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="38" data-text="28">Precision-engineered gear for the modern warrior. Browse our collection of professional gaming equipment.</p>
    </div>
</div>

<!-- Shop Controls -->
<div class="container">
    <div class="shop-controls editable-section no-drop-zone" data-section="39">
        <!-- Search Field -->
        <div class="search-container">
            <div class="search-wrapper">
                <i class="fas fa-search search-icon editable-icon" data-icon="9" data-default-class="fas fa-search"></i>
                <input type="text" id="searchInput" class="search-input editable-text editable-section no-drop-zone" data-section="40" data-text="29" placeholder="Search products...">
                <button class="clear-search" id="clearSearch"><i class="fas fa-times"></i></button>
            </div>
        </div>
        
        <div class="filter-container">
            <!-- Categories Button -->
            <a href="?page=categories" class="categories-btn editable-text editable-section no-drop-zone" data-section="41" data-text="30">
                <i class="fas fa-th-large editable-icon" data-icon="10" data-default-class="fas fa-th-large"></i> Browse Categories
            </a>
            
            <!-- Filter Chips -->
            <div class="filter-buttons">
                <button class="filter-chip active" data-filter="all">All</button>
                <button class="filter-chip" data-filter="keyboard">Keyboards</button>
                <button class="filter-chip" data-filter="mouse">Mice</button>
                <button class="filter-chip" data-filter="headset">Headsets</button>
                <button class="filter-chip" data-filter="controller">Controllers</button>
            </div>
            
            <!-- Sort Dropdown -->
            <div class="sort-container">
                <select id="sortSelect" class="editable-section no-drop-zone" data-section="42">
                    <option value="newest">Newest First</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                    <option value="popular">Most Popular</option>
                </select>
            </div>
        </div>
    </div>
    
    <!-- Results Count -->
    <div class="results-count" id="resultsCount">Showing 0 products</div>
</div>

<!-- Products Grid -->
<div class="container">
    <div class="products-grid" id="productsGrid">
        <!-- Product 1 - Editable -->
        <div class="product-card editable-section no-drop-zone" data-section="43" data-category="keyboard" data-product-id="1" data-product-title="NEXUS MECHANICAL K95" data-product-price="149.99" data-product-created="1700000000" data-product-views="1250">
            <img src="https://images.pexels.com/photos/2115256/pexels-photo-2115256.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Gaming Keyboard" class="product-image editable-image" data-image="3">
            <div class="product-info">
                <div class="product-category editable-text editable-section no-drop-zone" data-section="44" data-text="31">KEYBOARD</div>
                <div class="product-name editable-text editable-section no-drop-zone" data-section="45" data-text="32">NEXUS MECHANICAL K95</div>
                <div class="product-price editable-text editable-section no-drop-zone" data-section="46" data-text="33">$149.99</div>
                <div class="product-actions">
                    <button class="add-to-cart" data-add-to-cart="1"><i class="fas fa-cart-plus"></i> Add to Cart</button>
                    <button class="wishlist-btn" data-add-to-wishlist="1"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
        
        <!-- Product 2 - Non-editable -->
        <div class="product-card" data-category="mouse" data-product-id="2" data-product-title="OMEGA PRO WIRELESS" data-product-price="79.99" data-product-created="1699000000" data-product-views="2340">
            <img src="https://images.pexels.com/photos/2115258/pexels-photo-2115258.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Gaming Mouse" class="product-image">
            <div class="product-info">
                <div class="product-category">MOUSE</div>
                <div class="product-name">OMEGA PRO WIRELESS</div>
                <div class="product-price">$79.99</div>
                <div class="product-actions">
                    <button class="add-to-cart" data-add-to-cart="2"><i class="fas fa-cart-plus"></i> Add to Cart</button>
                    <button class="wishlist-btn" data-add-to-wishlist="2"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
        
        <!-- Product 3 - Non-editable -->
        <div class="product-card" data-category="headset" data-product-id="3" data-product-title="AETHER 7.1 HEADSET" data-product-price="129.99" data-product-created="1698000000" data-product-views="890">
            <img src="https://images.pexels.com/photos/577769/pexels-photo-577769.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Gaming Headset" class="product-image">
            <div class="product-info">
                <div class="product-category">HEADSET</div>
                <div class="product-name">AETHER 7.1 HEADSET</div>
                <div class="product-price">$129.99</div>
                <div class="product-actions">
                    <button class="add-to-cart" data-add-to-cart="3"><i class="fas fa-cart-plus"></i> Add to Cart</button>
                    <button class="wishlist-btn" data-add-to-wishlist="3"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
        
        <!-- Product 4 - Non-editable -->
        <div class="product-card" data-category="controller" data-product-id="4" data-product-title="VECTOR ELITE CONTROLLER" data-product-price="69.99" data-product-created="1697000000" data-product-views="3420">
            <img src="https://images.pexels.com/photos/4425760/pexels-photo-4425760.jpeg?auto=compress&cs=tinysrgb&w=600" alt="Game Controller" class="product-image">
            <div class="product-info">
                <div class="product-category">CONTROLLER</div>
                <div class="product-name">VECTOR ELITE CONTROLLER</div>
                <div class="product-price">$69.99</div>
                <div class="product-actions">
                    <button class="add-to-cart" data-add-to-cart="4"><i class="fas fa-cart-plus"></i> Add to Cart</button>
                    <button class="wishlist-btn" data-add-to-wishlist="4"><i class="far fa-heart"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const productsData = [
        { id: 1, title: "NEXUS MECHANICAL K95", category: "keyboard", price: 149.99, created: 1700000000, views: 1250 },
        { id: 2, title: "OMEGA PRO WIRELESS", category: "mouse", price: 79.99, created: 1699000000, views: 2340 },
        { id: 3, title: "AETHER 7.1 HEADSET", category: "headset", price: 129.99, created: 1698000000, views: 890 },
        { id: 4, title: "VECTOR ELITE CONTROLLER", category: "controller", price: 69.99, created: 1697000000, views: 3420 }
    ];
    
    let currentFilter = 'all';
    let currentSearch = '';
    let currentSort = 'newest';
    
    const productsGrid = document.getElementById('productsGrid');
    const searchInput = document.getElementById('searchInput');
    const clearSearch = document.getElementById('clearSearch');
    const sortSelect = document.getElementById('sortSelect');
    const resultsCount = document.getElementById('resultsCount');
    
    document.querySelectorAll('.filter-chip').forEach(chip => {
        chip.addEventListener('click', function() {
            document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
            this.classList.add('active');
            currentFilter = this.dataset.filter;
            filterAndDisplayProducts();
        });
    });
    
    searchInput.addEventListener('input', function() {
        currentSearch = this.value.toLowerCase();
        clearSearch.style.display = currentSearch ? 'block' : 'none';
        filterAndDisplayProducts();
    });
    
    clearSearch.addEventListener('click', function() {
        searchInput.value = '';
        currentSearch = '';
        clearSearch.style.display = 'none';
        filterAndDisplayProducts();
    });
    
    sortSelect.addEventListener('change', function() {
        currentSort = this.value;
        filterAndDisplayProducts();
    });
    
    function filterAndDisplayProducts() {
        let filtered = [...productsData];
        
        if (currentFilter !== 'all') {
            filtered = filtered.filter(p => p.category === currentFilter);
        }
        
        if (currentSearch) {
            filtered = filtered.filter(p => p.title.toLowerCase().includes(currentSearch));
        }
        
        filtered.sort((a, b) => {
            switch(currentSort) {
                case 'price-low': return a.price - b.price;
                case 'price-high': return b.price - a.price;
                case 'popular': return b.views - a.views;
                default: return b.created - a.created;
            }
        });
        
        resultsCount.textContent = `Showing ${filtered.length} product${filtered.length !== 1 ? 's' : ''}`;
        
        const productCards = document.querySelectorAll('.product-card');
        productCards.forEach((card, index) => {
            const productId = parseInt(card.dataset.productId);
            const isVisible = filtered.some(p => p.id === productId);
            card.style.display = isVisible ? 'block' : 'none';
        });
        
        if (filtered.length === 0) showEmptyState();
        else removeEmptyState();
    }
    
    function showEmptyState() {
        if (!document.querySelector('.empty-state-shop')) {
            const emptyDiv = document.createElement('div');
            emptyDiv.className = 'empty-state empty-state-shop';
            emptyDiv.innerHTML = `
                <div class="empty-state-icon"><i class="fas fa-search"></i></div>
                <h3>No Products Found</h3>
                <p>We couldn't find any products matching your criteria.</p>
                <button onclick="resetFilters()" style="background: var(--teal-primary); border: none; padding: 12px 28px; border-radius: 40px; color: var(--bg-dark); font-weight: 600; cursor: pointer;">Clear Filters</button>
            `;
            productsGrid.appendChild(emptyDiv);
        }
        const emptyState = document.querySelector('.empty-state-shop');
        if (emptyState) emptyState.style.display = 'block';
    }
    
    function removeEmptyState() {
        const emptyState = document.querySelector('.empty-state-shop');
        if (emptyState) emptyState.style.display = 'none';
    }
    
    function resetFilters() {
        currentFilter = 'all';
        currentSearch = '';
        currentSort = 'newest';
        searchInput.value = '';
        clearSearch.style.display = 'none';
        sortSelect.value = 'newest';
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        document.querySelector('.filter-chip[data-filter="all"]').classList.add('active');
        filterAndDisplayProducts();
    }
    
    document.querySelectorAll('.add-to-cart').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = this.dataset.addToCart;
            console.log('Added product ' + productId + ' to cart');
            showNotification('Item added to cart!', 'success');
        });
    });
    
    document.querySelectorAll('.wishlist-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = this.dataset.addToWishlist;
            console.log('Added product ' + productId + ' to wishlist');
            showNotification('Item added to wishlist!', 'success');
        });
    });
    
    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 100px;
            right: 20px;
            background: var(--teal-primary);
            color: var(--bg-dark);
            padding: 14px 24px;
            border-radius: 50px;
            font-weight: 500;
            z-index: 10000;
            animation: slideIn 0.3s ease;
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        `;
        notification.innerHTML = `<i class="fas fa-check-circle"></i> ${message}`;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }
    
    const style = document.createElement('style');
    style.textContent = `
        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        @keyframes slideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }
    `;
    document.head.appendChild(style);
    
    filterAndDisplayProducts();
</script>
</body>
</html>