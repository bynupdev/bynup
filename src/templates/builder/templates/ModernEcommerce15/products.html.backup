<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - KRUX</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ---------- :root strict color system ---------- */
        :root {
            --color-bg-primary: #F0EFE6;
            --color-bg-secondary: #EAEAEA;
            --color-stone: #C6C9D2;
            --color-warm: #DCCFC1;
            --color-taupe: #BBAEA8;
            --color-charcoal: #393831;
            --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.03), 0 2px 4px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 12px 28px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(0, 0, 0, 0.01);
            --shadow-hover: 0 20px 32px -12px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02);
            --transition-smooth: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--color-bg-primary);
            color: var(--color-charcoal);
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            overflow-x: hidden;
        }

        h1, h2, h3, .section-title, .product-name, .btn-text {
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header.editable-section[data-section="47"] {
            text-align: center;
            padding: 40px 0 32px;
            margin-bottom: 16px;
        }
        h1.editable-text.editable-section.no-drop-zone[data-section="48"] {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--color-charcoal);
            position: relative;
            display: inline-block;
        }
        h1.editable-text.editable-section.no-drop-zone[data-section="48"]::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: var(--color-charcoal);
        }
        p.editable-text.editable-section.no-drop-zone[data-section="49"] {
            font-size: 1rem;
            color: var(--color-charcoal);
            opacity: 0.7;
            max-width: 600px;
            margin: 1rem auto 0;
            font-weight: 400;
        }

        /* Shop Controls */
        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 40px 0 48px;
            flex-wrap: wrap;
            gap: 20px;
        }
        .categories-btn.editable-text.editable-section.no-drop-zone[data-section="50"] {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: transparent;
            border: 1px solid var(--color-charcoal);
            color: var(--color-charcoal);
            padding: 12px 28px;
            border-radius: 40px;
            font-family: 'Syne', sans-serif;
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            transition: var(--transition-smooth);
            cursor: pointer;
        }
        .categories-btn:hover {
            background: var(--color-charcoal);
            color: var(--color-bg-primary);
            transform: translateY(-2px);
        }
        .sort-select {
            background: var(--color-bg-secondary);
            border: 1px solid var(--color-stone);
            padding: 12px 20px;
            border-radius: 40px;
            color: var(--color-charcoal);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            cursor: pointer;
            transition: var(--transition-smooth);
        }
        .sort-select:hover {
            border-color: var(--color-taupe);
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            margin-bottom: 64px;
        }
        .product-card.editable-section.no-drop-zone[data-section="51"] {
            background: var(--color-bg-secondary);
            border-radius: 24px;
            overflow: hidden;
            transition: var(--transition-smooth);
            box-shadow: var(--shadow-sm);
            position: relative;
        }
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
        }
        .product-image {
            width: 100%;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            display: block;
            transition: transform 0.5s ease;
        }
        .product-card:hover .product-image {
            transform: scale(1.03);
        }
        .product-info {
            padding: 1.2rem 1rem 1.2rem;
        }
        .product-name {
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: var(--color-charcoal);
        }
        .product-price {
            font-weight: 500;
            font-size: 1rem;
            color: #5a5650;
            margin-bottom: 1rem;
        }
        .product-actions {
            display: flex;
            gap: 12px;
            margin-top: 8px;
        }
        .add-to-cart-btn {
            flex: 1;
            background: var(--color-charcoal);
            color: var(--color-bg-primary);
            border: none;
            padding: 10px 16px;
            border-radius: 40px;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .add-to-cart-btn:hover {
            background: #4f4c45;
            transform: translateY(-2px);
        }
        .wishlist-btn {
            width: 42px;
            background: transparent;
            border: 1px solid var(--color-stone);
            border-radius: 40px;
            color: var(--color-charcoal);
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .wishlist-btn:hover {
            border-color: var(--color-charcoal);
            color: #d43f31;
            transform: translateY(-2px);
        }
        .wishlist-btn i {
            font-size: 1rem;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            background: var(--color-bg-secondary);
            border-radius: 24px;
            margin: 2rem 0;
            grid-column: 1 / -1;
        }
        .empty-state h3 {
            color: var(--color-charcoal);
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }
        .empty-state p {
            color: var(--color-charcoal);
            opacity: 0.7;
            margin-bottom: 1.5rem;
        }
        .empty-state a {
            display: inline-block;
            background: var(--color-charcoal);
            color: var(--color-bg-primary);
            padding: 12px 28px;
            border-radius: 40px;
            text-decoration: none;
            font-family: 'Syne', sans-serif;
            font-weight: 500;
            transition: var(--transition-smooth);
        }
        .empty-state a:hover {
            background: #4f4c45;
            transform: translateY(-2px);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 28px;
            }
        }
        @media (max-width: 992px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 24px;
            }
            h1 { font-size: 2.5rem; }
            .shop-controls {
                flex-direction: column;
                align-items: flex-start;
            }
            .sort-select {
                width: 100%;
            }
        }
        @media (max-width: 768px) {
            .container { padding: 0 24px; }
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            h1 { font-size: 2rem; }
            .page-header { padding: 30px 0 20px; }
        }
        @media (max-width: 480px) {
            .container { padding: 0 20px; }
            h1 { font-size: 1.8rem; }
        }
    </style>
</head>
<body>

<main>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header editable-section" data-section="47">
            <h1 class="editable-text editable-section no-drop-zone" data-section="48" data-text="35">Shop the Collection</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="49" data-text="36">Discover refined streetwear pieces designed for the modern individual.</p>
        </div>

        <!-- Shop Controls -->
        <div class="shop-controls">
            <a href="?page=categories" class="categories-btn editable-text editable-section no-drop-zone" data-section="50" data-text="37">
                <i class="fas fa-th-large editable-icon" data-icon="10" data-default-class="fas fa-th-large"></i>
                Browse Categories
            </a>
            <select class="sort-select" id="sortProducts">
                <option value="newest">Newest First</option>
                <option value="price-low">Price: Low to High</option>
                <option value="price-high">Price: High to Low</option>
            </select>
        </div>

        <!-- Products Grid -->
        <div class="products-grid" id="productsGrid">
            <!-- Product 1 (Editable) -->
            <div class="product-card editable-section no-drop-zone" data-section="51">
                <img class="product-image editable-image" data-image="8" src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=600&auto=format" alt="Ash Technical Hoodie">
                <div class="product-info">
                    <div class="product-name editable-text editable-section no-drop-zone" data-section="52" data-text="38">Ash Technical Hoodie</div>
                    <div class="product-price editable-text editable-section no-drop-zone" data-section="53" data-text="39">$189</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn editable-text editable-section no-drop-zone" data-section="54" data-text="40" data-product-id="1">
                            <i class="fas fa-shopping-bag editable-icon" data-icon="11" data-default-class="fas fa-shopping-bag"></i>
                            Add to Cart
                        </button>
                        <button class="wishlist-btn" data-product-id="1">
                            <i class="far fa-heart editable-icon" data-icon="12" data-default-class="far fa-heart"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Product 2 (Non-editable sample) -->
            <div class="product-card">
                <img class="product-image" src="https://images.unsplash.com/photo-1590080875515-8a3a8dc5735e?w=600&auto=format" alt="Structure Cargo Pants">
                <div class="product-info">
                    <div class="product-name">Structure Cargo Pants</div>
                    <div class="product-price">$245</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn" data-product-id="2"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="wishlist-btn" data-product-id="2"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>

            <!-- Product 3 (Non-editable sample) -->
            <div class="product-card">
                <img class="product-image" src="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=600&auto=format" alt="Siena Knit Jacket">
                <div class="product-info">
                    <div class="product-name">Siena Knit Jacket</div>
                    <div class="product-price">$310</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn" data-product-id="3"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="wishlist-btn" data-product-id="3"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>

            <!-- Product 4 (Non-editable sample) -->
            <div class="product-card">
                <img class="product-image" src="https://images.unsplash.com/photo-1549298916-b41d501d3772?w=600&auto=format" alt="Svelte Leather Sneakers">
                <div class="product-info">
                    <div class="product-name">Svelte Leather Sneakers</div>
                    <div class="product-price">$275</div>
                    <div class="product-actions">
                        <button class="add-to-cart-btn" data-product-id="4"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                        <button class="wishlist-btn" data-product-id="4"><i class="far fa-heart"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // Simple sort functionality for demo
    const sortSelect = document.getElementById('sortProducts');
    const productsGrid = document.getElementById('productsGrid');
    
    if(sortSelect && productsGrid) {
        sortSelect.addEventListener('change', function() {
            const products = Array.from(productsGrid.children);
            const sortBy = this.value;
            
            products.sort((a, b) => {
                const priceA = parseFloat(a.querySelector('.product-price')?.textContent.replace('$', '') || 0);
                const priceB = parseFloat(b.querySelector('.product-price')?.textContent.replace('$', '') || 0);
                
                if(sortBy === 'price-low') return priceA - priceB;
                if(sortBy === 'price-high') return priceB - priceA;
                return 0;
            });
            
            products.forEach(product => productsGrid.appendChild(product));
        });
    }
    
    // Add to cart and wishlist button handlers
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const productId = btn.dataset.productId;
            console.log('Added to cart:', productId);
            alert('Item added to cart!');
        });
    });
    
    document.querySelectorAll('.wishlist-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const productId = btn.dataset.productId;
            console.log('Added to wishlist:', productId);
            alert('Item added to wishlist!');
        });
    });
</script>
</body>
</html>