<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist - KRUX</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ---------- :root strict color system ---------- */
        :root {
            --color-bg-primary: #F0EFE6;
            --color-bg-secondary: #EAEAEA;
            --color-stone: #C6C9D2;
            --color-warm: #DCCFC1;
            --color-taupe: #BBAEA8;
            --color-charcoal: #393831;
            --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.03), 0 2px 4px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 12px 28px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(0, 0, 0, 0.01);
            --shadow-hover: 0 20px 32px -12px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02);
            --transition-smooth: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--color-bg-primary);
            color: var(--color-charcoal);
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            overflow-x: hidden;
        }

        h1, h2, h3, .section-title {
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header.editable-section[data-section="77"] {
            text-align: center;
            padding: 40px 0 32px;
            margin-bottom: 16px;
        }
        h1.editable-text.editable-section.no-drop-zone[data-section="78"] {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--color-charcoal);
            position: relative;
            display: inline-block;
        }
        h1.editable-text.editable-section.no-drop-zone[data-section="78"]::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: var(--color-charcoal);
        }
        p.editable-text.editable-section.no-drop-zone[data-section="79"] {
            font-size: 1rem;
            color: var(--color-charcoal);
            opacity: 0.7;
            max-width: 600px;
            margin: 1rem auto 0;
        }

        /* Wishlist Stats */
        .wishlist-stats.editable-section[data-section="80"] {
            display: flex;
            justify-content: center;
            gap: 48px;
            margin: 32px 0 48px;
            flex-wrap: wrap;
        }
        .stat-card {
            text-align: center;
            background: var(--color-bg-secondary);
            padding: 20px 32px;
            border-radius: 24px;
            min-width: 150px;
        }
        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            font-family: 'Syne', sans-serif;
            color: var(--color-charcoal);
        }
        .stat-label {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.6;
            margin-top: 8px;
        }

        /* Wishlist Actions */
        .wishlist-actions {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 32px;
        }
        .clear-wishlist-btn.editable-text.editable-section.no-drop-zone[data-section="81"] {
            background: transparent;
            border: 1px solid var(--color-stone);
            color: var(--color-charcoal);
            padding: 10px 24px;
            border-radius: 40px;
            font-family: 'Inter', sans-serif;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .clear-wishlist-btn:hover {
            border-color: var(--color-charcoal);
            background: var(--color-charcoal);
            color: var(--color-bg-primary);
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            margin-bottom: 64px;
        }
        .wishlist-card.editable-section.no-drop-zone[data-section="82"] {
            background: var(--color-bg-secondary);
            border-radius: 24px;
            overflow: hidden;
            transition: var(--transition-smooth);
            box-shadow: var(--shadow-sm);
            position: relative;
        }
        .wishlist-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-hover);
        }
        .wishlist-image {
            width: 100%;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            display: block;
            transition: transform 0.5s ease;
        }
        .wishlist-card:hover .wishlist-image {
            transform: scale(1.03);
        }
        .wishlist-info {
            padding: 1.2rem 1rem 1.2rem;
        }
        .wishlist-name {
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            color: var(--color-charcoal);
        }
        .wishlist-price {
            font-weight: 500;
            font-size: 1rem;
            color: #5a5650;
            margin-bottom: 1rem;
        }
        .wishlist-actions-buttons {
            display: flex;
            gap: 12px;
        }
        .add-to-cart-wishlist {
            flex: 1;
            background: var(--color-charcoal);
            color: var(--color-bg-primary);
            border: none;
            padding: 10px 16px;
            border-radius: 40px;
            font-family: 'Inter', sans-serif;
            font-weight: 500;
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        .add-to-cart-wishlist:hover {
            background: #4f4c45;
            transform: translateY(-2px);
        }
        .remove-wishlist-btn {
            width: 42px;
            background: transparent;
            border: 1px solid var(--color-stone);
            border-radius: 40px;
            color: var(--color-charcoal);
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .remove-wishlist-btn:hover {
            border-color: #d43f31;
            color: #d43f31;
            transform: translateY(-2px);
        }

        /* Empty Wishlist */
        .empty-wishlist {
            text-align: center;
            padding: 80px 20px;
            background: var(--color-bg-secondary);
            border-radius: 24px;
            margin: 32px 0;
        }
        .empty-wishlist-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.5;
        }
        .empty-wishlist h2 {
            font-size: 1.8rem;
            margin-bottom: 12px;
        }
        .empty-wishlist p {
            opacity: 0.7;
            margin-bottom: 24px;
        }
        .shop-now-wishlist-btn.editable-text.editable-section.no-drop-zone[data-section="83"] {
            display: inline-block;
            background: var(--color-charcoal);
            color: var(--color-bg-primary);
            padding: 14px 32px;
            border-radius: 40px;
            text-decoration: none;
            font-family: 'Syne', sans-serif;
            font-weight: 500;
            transition: var(--transition-smooth);
        }
        .shop-now-wishlist-btn:hover {
            background: #4f4c45;
            transform: translateY(-2px);
        }

        /* Recently Viewed Section */
        .recently-viewed.editable-section[data-section="84"] {
            margin: 64px 0 48px;
        }
        .recently-viewed h2.editable-text.editable-section.no-drop-zone[data-section="85"] {
            font-size: 1.8rem;
            margin-bottom: 32px;
            text-align: center;
        }
        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }
        .recent-card {
            background: var(--color-bg-secondary);
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition-smooth);
            text-decoration: none;
            color: inherit;
        }
        .recent-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-hover);
        }
        .recent-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }
        .recent-info {
            padding: 16px;
        }
        .recent-name {
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 6px;
        }
        .recent-price {
            font-size: 0.9rem;
            font-weight: 500;
            color: #5a5650;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .wishlist-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 28px;
            }
            .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        @media (max-width: 992px) {
            .wishlist-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 24px;
            }
            .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1 { font-size: 2.5rem; }
            .wishlist-stats { gap: 24px; }
            .stat-card { padding: 16px 24px; min-width: 120px; }
        }
        @media (max-width: 768px) {
            .container { padding: 0 24px; }
            .wishlist-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto 64px;
            }
            .recently-viewed-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            h1 { font-size: 2rem; }
            .wishlist-stats { flex-direction: column; align-items: center; gap: 16px; }
            .stat-card { width: 100%; max-width: 250px; }
            .wishlist-actions { justify-content: center; }
        }
        @media (max-width: 480px) {
            .container { padding: 0 20px; }
            h1 { font-size: 1.8rem; }
        }
    </style>
</head>
<body>

<main>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header editable-section" data-section="77">
            <h1 class="editable-text editable-section no-drop-zone" data-section="78" data-text="56">Your Wishlist</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="79" data-text="57">Save your favorite pieces for later</p>
        </div>

        <!-- Wishlist Stats -->
        <div class="wishlist-stats editable-section" data-section="80">
            <div class="stat-card">
                <div class="stat-number" id="wishlistCount">4</div>
                <div class="stat-label">Items Saved</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="wishlistValue">$1,019</div>
                <div class="stat-label">Total Value</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="wishlistLowStock">1</div>
                <div class="stat-label">Low in Stock</div>
            </div>
        </div>

        <!-- Wishlist Actions -->
        <div class="wishlist-actions">
            <button class="clear-wishlist-btn editable-text editable-section no-drop-zone" data-section="81" data-text="58" id="clearWishlistBtn">
                <i class="fas fa-trash-alt editable-icon" data-icon="40" data-default-class="fas fa-trash-alt"></i>
                Clear Wishlist
            </button>
        </div>

        <!-- Wishlist Grid -->
        <div id="wishlistWithItems" style="display: block;">
            <div class="wishlist-grid" id="wishlistGrid">
                <!-- Wishlist Item 1 (Editable) -->
                <div class="wishlist-card editable-section no-drop-zone" data-section="82" data-product-id="1">
                    <img class="wishlist-image editable-image" data-image="30" src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=600&auto=format" alt="Ash Technical Hoodie">
                    <div class="wishlist-info">
                        <div class="wishlist-name editable-text editable-section no-drop-zone" data-section="86" data-text="59">Ash Technical Hoodie</div>
                        <div class="wishlist-price editable-text editable-section no-drop-zone" data-section="87" data-text="60">$189</div>
                        <div class="wishlist-actions-buttons">
                            <button class="add-to-cart-wishlist" data-product-id="1">
                                <i class="fas fa-shopping-bag editable-icon" data-icon="41" data-default-class="fas fa-shopping-bag"></i>
                                Add to Cart
                            </button>
                            <button class="remove-wishlist-btn" data-product-id="1">
                                <i class="fas fa-times editable-icon" data-icon="42" data-default-class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Wishlist Item 2 (Non-editable sample) -->
                <div class="wishlist-card" data-product-id="2">
                    <img class="wishlist-image" src="https://images.unsplash.com/photo-1590080875515-8a3a8dc5735e?w=600&auto=format" alt="Structure Cargo Pants">
                    <div class="wishlist-info">
                        <div class="wishlist-name">Structure Cargo Pants</div>
                        <div class="wishlist-price">$245</div>
                        <div class="wishlist-actions-buttons">
                            <button class="add-to-cart-wishlist" data-product-id="2"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                            <button class="remove-wishlist-btn" data-product-id="2"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                </div>

                <!-- Wishlist Item 3 (Non-editable sample) -->
                <div class="wishlist-card" data-product-id="3">
                    <img class="wishlist-image" src="https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=600&auto=format" alt="Siena Knit Jacket">
                    <div class="wishlist-info">
                        <div class="wishlist-name">Siena Knit Jacket</div>
                        <div class="wishlist-price">$310</div>
                        <div class="wishlist-actions-buttons">
                            <button class="add-to-cart-wishlist" data-product-id="3"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                            <button class="remove-wishlist-btn" data-product-id="3"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                </div>

                <!-- Wishlist Item 4 (Non-editable sample) -->
                <div class="wishlist-card" data-product-id="4">
                    <img class="wishlist-image" src="https://images.unsplash.com/photo-1549298916-b41d501d3772?w=600&auto=format" alt="Svelte Leather Sneakers">
                    <div class="wishlist-info">
                        <div class="wishlist-name">Svelte Leather Sneakers</div>
                        <div class="wishlist-price">$275</div>
                        <div class="wishlist-actions-buttons">
                            <button class="add-to-cart-wishlist" data-product-id="4"><i class="fas fa-shopping-bag"></i> Add to Cart</button>
                            <button class="remove-wishlist-btn" data-product-id="4"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty Wishlist State (Hidden by default) -->
        <div id="emptyWishlistState" style="display: none;">
            <div class="empty-wishlist">
                <div class="empty-wishlist-icon">
                    <i class="far fa-heart"></i>
                </div>
                <h2>Your Wishlist is Empty</h2>
                <p>Start adding items you love to your wishlist. They'll appear here for easy access.</p>
                <a href="?page=products" class="shop-now-wishlist-btn editable-text editable-section no-drop-zone" data-section="83" data-text="61">Start Shopping</a>
            </div>
        </div>

        <!-- Recently Viewed Section -->
        <div class="recently-viewed editable-section" data-section="84">
            <h2 class="editable-text editable-section no-drop-zone" data-section="85" data-text="62">Recently Viewed</h2>
            <div class="recently-viewed-grid" id="recentlyViewedGrid">
                <!-- Recently Viewed Item 1 (Editable) -->
                <a href="#" class="recent-card">
                    <img class="recent-img editable-image" data-image="31" src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=400&auto=format" alt="Oversized Wool Blazer">
                    <div class="recent-info">
                        <div class="recent-name">Oversized Wool Blazer</div>
                        <div class="recent-price">$425</div>
                    </div>
                </a>
                <!-- Recently Viewed Item 2 -->
                <a href="#" class="recent-card">
                    <img class="recent-img" src="https://images.unsplash.com/photo-1584278860047-22db4c9ecccd?w=400&auto=format" alt="Relaxed Fit Trousers">
                    <div class="recent-info">
                        <div class="recent-name">Relaxed Fit Trousers</div>
                        <div class="recent-price">$195</div>
                    </div>
                </a>
                <!-- Recently Viewed Item 3 -->
                <a href="#" class="recent-card">
                    <img class="recent-img" src="https://images.unsplash.com/photo-1554568218-0f1715e72254?w=400&auto=format" alt="Merino Wool Sweater">
                    <div class="recent-info">
                        <div class="recent-name">Merino Wool Sweater</div>
                        <div class="recent-price">$165</div>
                    </div>
                </a>
                <!-- Recently Viewed Item 4 -->
                <a href="#" class="recent-card">
                    <img class="recent-img" src="https://images.unsplash.com/photo-1582418702059-97ebafb35d09?w=400&auto=format" alt="Leather Crossbody Bag">
                    <div class="recent-info">
                        <div class="recent-name">Leather Crossbody Bag</div>
                        <div class="recent-price">$295</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</main>

<script>
    // Update wishlist stats
    function updateWishlistStats() {
        const wishlistItems = document.querySelectorAll('#wishlistGrid .wishlist-card');
        const itemCount = wishlistItems.length;
        let totalValue = 0;
        let lowStockCount = 0;
        
        wishlistItems.forEach(item => {
            const priceText = item.querySelector('.wishlist-price').textContent.replace('$', '');
            const price = parseFloat(priceText);
            totalValue += price;
            
            // Random low stock for demo (in real implementation, check product stock)
            if(item.dataset.productId === '2') {
                lowStockCount++;
            }
        });
        
        document.getElementById('wishlistCount').textContent = itemCount;
        document.getElementById('wishlistValue').textContent = '$' + totalValue.toFixed(0);
        document.getElementById('wishlistLowStock').textContent = lowStockCount;
        
        // Show/hide empty state
        const wishlistWithItems = document.getElementById('wishlistWithItems');
        const emptyWishlistState = document.getElementById('emptyWishlistState');
        
        if(itemCount === 0) {
            wishlistWithItems.style.display = 'none';
            emptyWishlistState.style.display = 'block';
        } else {
            wishlistWithItems.style.display = 'block';
            emptyWishlistState.style.display = 'none';
        }
    }
    
    // Add to cart from wishlist
    document.querySelectorAll('.add-to-cart-wishlist').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const productId = btn.dataset.productId;
            alert(`Item added to cart! (Product ID: ${productId})`);
        });
    });
    
    // Remove from wishlist
    document.querySelectorAll('.remove-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const wishlistItem = btn.closest('.wishlist-card');
            const productName = wishlistItem.querySelector('.wishlist-name').textContent;
            
            if(confirm(`Remove "${productName}" from your wishlist?`)) {
                wishlistItem.remove();
                updateWishlistStats();
            }
        });
    });
    
    // Clear wishlist
    document.getElementById('clearWishlistBtn')?.addEventListener('click', () => {
        const wishlistItems = document.querySelectorAll('#wishlistGrid .wishlist-card');
        if(wishlistItems.length === 0) {
            alert('Your wishlist is already empty.');
            return;
        }
        
        if(confirm('Are you sure you want to clear your entire wishlist? This action cannot be undone.')) {
            wishlistItems.forEach(item => item.remove());
            updateWishlistStats();
        }
    });
    
    // Initial stats calculation
    updateWishlistStats();
</script>
</body>
</html>