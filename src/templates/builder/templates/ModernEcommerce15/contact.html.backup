<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - KRUX</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ---------- :root strict color system ---------- */
        :root {
            --color-bg-primary: #F0EFE6;
            --color-bg-secondary: #EAEAEA;
            --color-stone: #C6C9D2;
            --color-warm: #DCCFC1;
            --color-taupe: #BBAEA8;
            --color-charcoal: #393831;
            --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.03), 0 2px 4px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 12px 28px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(0, 0, 0, 0.01);
            --shadow-hover: 0 20px 32px -12px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02);
            --transition-smooth: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--color-bg-primary);
            color: var(--color-charcoal);
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            overflow-x: hidden;
        }

        h1, h2, h3, .section-title {
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header.editable-section[data-section="98"] {
            text-align: center;
            padding: 40px 0 32px;
            margin-bottom: 16px;
        }
        h1.editable-text.editable-section.no-drop-zone[data-section="99"] {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--color-charcoal);
            position: relative;
            display: inline-block;
        }
        h1.editable-text.editable-section.no-drop-zone[data-section="99"]::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: var(--color-charcoal);
        }
        p.editable-text.editable-section.no-drop-zone[data-section="100"] {
            font-size: 1rem;
            color: var(--color-charcoal);
            opacity: 0.7;
            max-width: 600px;
            margin: 1rem auto 0;
        }

        /* Contact Layout */
        .contact-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 48px;
            margin: 48px 0 64px;
        }

        /* Contact Information */
        .contact-info.editable-section.no-drop-zone[data-section="101"] {
            background: var(--color-bg-secondary);
            border-radius: 24px;
            padding: 32px;
            height: fit-content;
        }
        .contact-info h2.editable-text.editable-section.no-drop-zone[data-section="102"] {
            font-size: 1.5rem;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--color-stone);
        }
        .contact-methods {
            display: flex;
            flex-direction: column;
            gap: 24px;
            margin-bottom: 32px;
        }
        .contact-method {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }
        .contact-icon {
            width: 48px;
            height: 48px;
            background: var(--color-bg-primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: var(--color-charcoal);
        }
        .contact-details h3 {
            font-size: 1rem;
            margin-bottom: 4px;
        }
        .contact-details p, .contact-details a {
            font-size: 0.9rem;
            color: var(--color-charcoal);
            opacity: 0.7;
            text-decoration: none;
            transition: opacity 0.2s;
        }
        .contact-details a:hover {
            opacity: 1;
        }
        .business-hours {
            margin-top: 24px;
            padding-top: 24px;
            border-top: 1px solid var(--color-stone);
        }
        .business-hours h3 {
            font-size: 1rem;
            margin-bottom: 16px;
        }
        .hours-list {
            list-style: none;
        }
        .hours-list li {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--color-stone);
        }
        .hours-list li:last-child {
            border-bottom: none;
        }
        .hours-day {
            font-weight: 500;
        }
        .hours-time {
            opacity: 0.7;
        }

        /* Contact Form */
        .contact-form-section.editable-section.no-drop-zone[data-section="103"] {
            background: var(--color-bg-secondary);
            border-radius: 24px;
            padding: 32px;
        }
        .contact-form-section h2.editable-text.editable-section.no-drop-zone[data-section="104"] {
            font-size: 1.5rem;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--color-stone);
        }
        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .form-group label {
            font-size: 0.85rem;
            font-weight: 500;
        }
        .form-group input, .form-group select, .form-group textarea {
            padding: 12px 16px;
            border: 1px solid var(--color-stone);
            border-radius: 16px;
            background: var(--color-bg-primary);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            transition: var(--transition-smooth);
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            outline: none;
            border-color: var(--color-charcoal);
        }
        .form-group textarea {
            resize: vertical;
            min-height: 120px;
        }
        .submit-btn.editable-text.editable-section.no-drop-zone[data-section="105"] {
            background: var(--color-charcoal);
            color: var(--color-bg-primary);
            border: none;
            padding: 14px 28px;
            border-radius: 40px;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: var(--transition-smooth);
            align-self: flex-start;
            margin-top: 8px;
        }
        .submit-btn:hover {
            background: #4f4c45;
            transform: translateY(-2px);
        }

        /* FAQ Section */
        .faq-section.editable-section[data-section="106"] {
            margin: 64px 0;
        }
        .faq-section h2.editable-text.editable-section.no-drop-zone[data-section="107"] {
            font-size: 1.8rem;
            margin-bottom: 32px;
            text-align: center;
        }
        .faq-container {
            max-width: 900px;
            margin: 0 auto;
        }
        .faq-item.editable-section.no-drop-zone[data-section="108"] {
            background: var(--color-bg-secondary);
            border-radius: 20px;
            margin-bottom: 16px;
            overflow: hidden;
            transition: var(--transition-smooth);
        }
        .faq-item:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }
        .faq-question {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 24px;
            background: var(--color-bg-secondary);
            border: none;
            cursor: pointer;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            font-size: 1rem;
            color: var(--color-charcoal);
            text-align: left;
            transition: var(--transition-smooth);
        }
        .faq-question:hover {
            background: var(--color-warm);
        }
        .faq-icon {
            font-size: 1.2rem;
            transition: transform 0.3s ease;
        }
        .faq-item.active .faq-icon {
            transform: rotate(45deg);
        }
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
            padding: 0 24px;
            color: var(--color-charcoal);
            opacity: 0.8;
            line-height: 1.6;
            font-size: 0.9rem;
        }
        .faq-item.active .faq-answer {
            max-height: 500px;
            padding: 0 24px 20px 24px;
        }

        /* Map Section */
        .map-section.editable-section[data-section="113"] {
            margin: 64px 0;
        }
        .map-section h2.editable-text.editable-section.no-drop-zone[data-section="114"] {
            font-size: 1.5rem;
            margin-bottom: 24px;
            text-align: center;
        }
        .map-container {
            width: 100%;
            height: 400px;
            background: var(--color-bg-secondary);
            border-radius: 24px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .map-placeholder {
            text-align: center;
            color: var(--color-charcoal);
            opacity: 0.6;
        }
        .map-placeholder i {
            font-size: 3rem;
            margin-bottom: 16px;
            display: block;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .contact-layout {
                grid-template-columns: 1fr;
                gap: 32px;
            }
            .form-row {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            h1 { font-size: 2.5rem; }
        }
        @media (max-width: 768px) {
            .container { padding: 0 24px; }
            .contact-info, .contact-form-section { padding: 24px; }
            h1 { font-size: 2rem; }
            .faq-question { padding: 16px 20px; font-size: 0.9rem; }
            .map-container { height: 300px; }
        }
        @media (max-width: 480px) {
            .container { padding: 0 20px; }
            h1 { font-size: 1.8rem; }
            .contact-method { gap: 12px; }
            .contact-icon { width: 40px; height: 40px; font-size: 1rem; }
        }
    </style>
</head>
<body>

<main>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header editable-section" data-section="98">
            <h1 class="editable-text editable-section no-drop-zone" data-section="99" data-text="70">Contact Us</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="100" data-text="71">We'd love to hear from you. Reach out with any questions or feedback.</p>
        </div>

        <!-- Contact Layout -->
        <div class="contact-layout">
            <!-- Contact Information -->
            <div class="contact-info editable-section no-drop-zone" data-section="101">
                <h2 class="editable-text editable-section no-drop-zone" data-section="102" data-text="72">Get in Touch</h2>
                <div class="contact-methods">
                    <div class="contact-method">
                        <div class="contact-icon">
                            <i class="fas fa-map-marker-alt editable-icon" data-icon="60" data-default-class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-details">
                            <h3>Visit Us</h3>
                            <p class="editable-text editable-section no-drop-zone" data-section="109" data-text="73">123 Fashion Avenue<br>New York, NY 10001<br>United States</p>
                        </div>
                    </div>
                    <div class="contact-method">
                        <div class="contact-icon">
                            <i class="fas fa-phone editable-icon" data-icon="61" data-default-class="fas fa-phone"></i>
                        </div>
                        <div class="contact-details">
                            <h3>Call Us</h3>
                            <p class="editable-text editable-section no-drop-zone" data-section="110" data-text="74">+1 (555) 123-4567</p>
                            <p class="editable-text editable-section no-drop-zone" data-section="111" data-text="75">Mon-Fri: 9AM - 6PM EST</p>
                        </div>
                    </div>
                    <div class="contact-method">
                        <div class="contact-icon">
                            <i class="fas fa-envelope editable-icon" data-icon="62" data-default-class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-details">
                            <h3>Email Us</h3>
                            <p><a href="mailto:hello@krux.com" class="editable-text editable-section no-drop-zone" data-section="112" data-text="76">hello@krux.com</a></p>
                            <p class="editable-text editable-section no-drop-zone" data-section="113" data-text="77">For customer support: support@krux.com</p>
                        </div>
                    </div>
                </div>
                <div class="business-hours">
                    <h3>Business Hours</h3>
                    <ul class="hours-list">
                        <li><span class="hours-day">Monday - Friday</span><span class="hours-time">9:00 AM - 6:00 PM</span></li>
                        <li><span class="hours-day">Saturday</span><span class="hours-time">10:00 AM - 4:00 PM</span></li>
                        <li><span class="hours-day">Sunday</span><span class="hours-time">Closed</span></li>
                    </ul>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="contact-form-section editable-section no-drop-zone" data-section="114">
                <h2 class="editable-text editable-section no-drop-zone" data-section="115" data-text="78">Send a Message</h2>
                <form class="contact-form" id="contactForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label>First Name *</label>
                            <input type="text" name="first_name" placeholder="Enter your first name" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name *</label>
                            <input type="text" name="last_name" placeholder="Enter your last name" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Email Address *</label>
                        <input type="email" name="email" placeholder="Enter your email address" required>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" name="phone" placeholder="Enter your phone number">
                    </div>
                    <div class="form-group">
                        <label>Subject *</label>
                        <select name="subject" required>
                            <option value="">Select a subject</option>
                            <option value="general">General Inquiry</option>
                            <option value="order">Order Status</option>
                            <option value="returns">Returns & Exchanges</option>
                            <option value="wholesale">Wholesale Inquiry</option>
                            <option value="press">Press & Media</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Message *</label>
                        <textarea name="message" placeholder="Tell us how we can help..." required></textarea>
                    </div>
                    <button type="submit" class="submit-btn editable-text editable-section no-drop-zone" data-section="116" data-text="79">Send Message</button>
                </form>
            </div>
        </div>

        <!-- FAQ Section - 5 Editable Questions -->
        <div class="faq-section editable-section" data-section="117">
            <h2 class="editable-text editable-section no-drop-zone" data-section="118" data-text="80">Frequently Asked Questions</h2>
            <div class="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item editable-section no-drop-zone" data-section="119">
                    <button class="faq-question">
                        <span class="editable-text editable-section no-drop-zone" data-section="120" data-text="81">What are your shipping options and delivery times?</span>
                        <i class="fas fa-plus faq-icon editable-icon" data-icon="63" data-default-class="fas fa-plus"></i>
                    </button>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="121" data-text="82">
                        We offer free standard shipping on all orders within the US. Standard delivery takes 3-5 business days. Express shipping (2-3 business days) is available for $15. International shipping rates vary by location and take 7-14 business days.
                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="faq-item editable-section no-drop-zone" data-section="122">
                    <button class="faq-question">
                        <span class="editable-text editable-section no-drop-zone" data-section="123" data-text="83">What is your return and exchange policy?</span>
                        <i class="fas fa-plus faq-icon editable-icon" data-icon="63" data-default-class="fas fa-plus"></i>
                    </button>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="124" data-text="84">
                        We accept returns within 30 days of purchase. Items must be unworn, unwashed, and with original tags attached. Returns are free for domestic orders. Exchanges can be processed through our returns portal. Refunds are issued to the original payment method within 5-7 business days.
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="faq-item editable-section no-drop-zone" data-section="125">
                    <button class="faq-question">
                        <span class="editable-text editable-section no-drop-zone" data-section="126" data-text="85">How do I determine my size?</span>
                        <i class="fas fa-plus faq-icon editable-icon" data-icon="63" data-default-class="fas fa-plus"></i>
                    </button>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="127" data-text="86">
                        We provide detailed size charts on each product page. For the most accurate fit, we recommend measuring a similar item you own and comparing it to our size guide. If you're between sizes, we suggest sizing up for a relaxed fit. Our customer service team is also available to assist with sizing questions.
                    </div>
                </div>

                <!-- FAQ 4 -->
                <div class="faq-item editable-section no-drop-zone" data-section="128">
                    <button class="faq-question">
                        <span class="editable-text editable-section no-drop-zone" data-section="129" data-text="87">Do you offer international shipping?</span>
                        <i class="fas fa-plus faq-icon editable-icon" data-icon="63" data-default-class="fas fa-plus"></i>
                    </button>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="130" data-text="88">
                        Yes, we ship to over 50 countries worldwide. International shipping rates are calculated at checkout based on destination. Please note that international orders may be subject to customs duties and taxes, which are the responsibility of the customer. Delivery times vary by location but typically range from 7-14 business days.
                    </div>
                </div>

                <!-- FAQ 5 -->
                <div class="faq-item editable-section no-drop-zone" data-section="131">
                    <button class="faq-question">
                        <span class="editable-text editable-section no-drop-zone" data-section="132" data-text="89">How do I care for my KRUX garments?</span>
                        <i class="fas fa-plus faq-icon editable-icon" data-icon="63" data-default-class="fas fa-plus"></i>
                    </button>
                    <div class="faq-answer editable-text editable-section no-drop-zone" data-section="133" data-text="90">
                        To maintain the quality of your KRUX pieces, we recommend machine washing cold with like colors and tumble drying low. For items with technical finishes, air drying is preferred. Avoid using bleach or fabric softeners. Each product also includes specific care instructions on the label.
                    </div>
                </div>
            </div>
        </div>

        <!-- Map Section -->
        <div class="map-section editable-section" data-section="134">
            <h2 class="editable-text editable-section no-drop-zone" data-section="135" data-text="91">Visit Our Flagship Store</h2>
            <div class="map-container">
                <div class="map-placeholder">
                    <i class="fas fa-map-marked-alt editable-icon" data-icon="64" data-default-class="fas fa-map-marked-alt"></i>
                    <p>123 Fashion Avenue, New York, NY 10001</p>
                    <p style="font-size: 0.8rem; margin-top: 8px;">Interactive map would display here</p>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    // FAQ Accordion Functionality
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
        const questionBtn = item.querySelector('.faq-question');
        
        questionBtn.addEventListener('click', () => {
            // Close all other FAQs
            faqItems.forEach(otherItem => {
                if (otherItem !== item && otherItem.classList.contains('active')) {
                    otherItem.classList.remove('active');
                }
            });
            
            // Toggle current FAQ
            item.classList.toggle('active');
        });
    });
    
    // Contact Form Submission
    const contactForm = document.getElementById('contactForm');
    
    if(contactForm) {
        contactForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            // Get form data
            const firstName = contactForm.querySelector('[name="first_name"]').value;
            const lastName = contactForm.querySelector('[name="last_name"]').value;
            const email = contactForm.querySelector('[name="email"]').value;
            const subject = contactForm.querySelector('[name="subject"]').value;
            const message = contactForm.querySelector('[name="message"]').value;
            
            // Simple validation
            if(!firstName || !lastName || !email || !subject || !message) {
                alert('Please fill in all required fields.');
                return;
            }
            
            // Simulate form submission
            alert('Thank you for your message! We will get back to you within 24 hours.');
            contactForm.reset();
        });
    }
    
    // Open first FAQ by default for better UX
    if(faqItems.length > 0) {
        // Optional: uncomment to open first FAQ by default
        // faqItems[0].classList.add('active');
    }
</script>
</body>
</html>