<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | Lullaby Luxe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --primary-brown: #B0988B;
            --primary-teal: #4D8581;
            --light-teal: #ABDED7;
            --light-beige: #DBCBBE;
            --background-cream: #EEE7DF;
            --text-dark: #333333;
            --text-light: #555555;
            --white: #FFFFFF;
            --shadow: rgba(0, 0, 0, 0.05);
        }

        /* Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--background-cream);
            color: var(--text-dark);
            line-height: 1.6;
            padding-top: 100px; /* For fixed header */
        }

        h1, h2, h3, h4 {
            font-weight: 300;
            letter-spacing: 0.5px;
        }

        p {
            color: var(--text-light);
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .temp-btn {
            display: inline-block;
            background-color: var(--primary-teal);
            color: var(--white);
            border: none;
            padding: 14px 32px;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 2px;
            text-decoration: none;
        }

        .temp-btn:hover {
            background-color: var(--primary-brown);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px var(--shadow);
        }

        .temp-btn-secondary {
            background-color: transparent;
            color: var(--primary-teal);
            border: 1px solid var(--primary-teal);
        }

        .temp-btn-secondary:hover {
            background-color: rgba(77, 133, 129, 0.1);
        }

        section {
            padding: 80px 0;
        }

        /* Wishlist Header */
        .wishlist-header {
            padding: 40px 0 20px;
            border-bottom: 1px solid var(--light-beige);
            margin-bottom: 40px;
        }

        .wishlist-header h1 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 10px;
            font-weight: 300;
        }

        /* Wishlist Section */
        .wishlist-section {
            padding: 40px 0;
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .wishlist-item {
            background-color: var(--white);
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px var(--shadow);
            position: relative;
        }

        .wishlist-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .wishlist-item-image {
            height: 250px;
            width: 100%;
            object-fit: cover;
            background-color: var(--light-beige);
        }

        .wishlist-remove {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: var(--white);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px var(--shadow);
            z-index: 2;
        }

        .wishlist-remove:hover {
            background-color: var(--primary-brown);
            color: var(--white);
            transform: scale(1.1);
        }

        .wishlist-item-info {
            padding: 20px;
        }

        .wishlist-item-title {
            font-size: 16px;
            color: var(--text-dark);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .wishlist-item-price {
            font-size: 18px;
            color: var(--primary-teal);
            font-weight: 500;
            margin-bottom: 15px;
        }

        .wishlist-item-actions {
            display: flex;
            gap: 10px;
        }

        .temp-btn-add-cart {
            flex: 1;
            background-color: var(--primary-teal);
            color: white;
            border: none;
            padding: 10px;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .temp-btn-add-cart:hover {
            background-color: var(--primary-brown);
        }

        .temp-btn-move-cart {
            background-color: transparent;
            border: 1px solid var(--light-beige);
            color: var(--primary-brown);
            width: 40px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .temp-btn-move-cart:hover {
            background-color: var(--light-beige);
        }

        /* Empty Wishlist */
        .empty-wishlist {
            text-align: center;
            padding: 80px 20px;
            background-color: var(--white);
            border-radius: 12px;
            box-shadow: 0 5px 20px var(--shadow);
            margin: 40px 0;
        }

        .empty-wishlist i {
            font-size: 72px;
            color: var(--light-teal);
            margin-bottom: 25px;
        }

        .empty-wishlist h2 {
            font-size: 28px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 300;
        }

        .empty-wishlist p {
            margin-bottom: 30px;
            font-size: 16px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .empty-wishlist-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Share Wishlist */
        .share-wishlist {
            background-color: var(--light-teal);
            padding: 30px;
            border-radius: 8px;
            text-align: center;
            margin: 40px 0;
        }

        .share-wishlist h3 {
            font-size: 20px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 400;
        }

        .share-wishlist p {
            margin-bottom: 20px;
            color: var(--text-dark);
        }

        .share-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .share-temp-btn {
            padding: 10px 20px;
            background-color: var(--white);
            color: var(--primary-teal);
            border-radius: 4px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .share-temp-btn:hover {
            background-color: var(--primary-teal);
            color: var(--white);
            transform: translateY(-2px);
        }

        /* Recently Viewed Section */
        .recently-viewed-section {
            padding: 60px 0;
            background-color: var(--white);
            margin-top: 60px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 300;
        }

        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .product-card {
            background-color: var(--white);
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px var(--shadow);
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .product-image {
            height: 250px;
            width: 100%;
            object-fit: cover;
            background-color: var(--light-beige);
        }

        .product-card .product-info {
            padding: 20px;
        }

        .product-card h3 {
            font-size: 16px;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .product-card .price {
            font-size: 18px;
            color: var(--primary-teal);
            font-weight: 400;
            margin-bottom: 15px;
        }

        .product-card .product-actions {
            display: flex;
            gap: 10px;
        }

        .product-card .temp-btn-primary {
            flex: 1;
            background-color: var(--primary-teal);
            color: white;
            border: none;
            padding: 10px;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s ease;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .product-card .temp-btn-primary:hover {
            background-color: var(--primary-brown);
        }

        .product-card .temp-btn-wishlist {
            background-color: transparent;
            border: 1px solid var(--light-beige);
            color: var(--primary-brown);
            width: 40px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-card .temp-btn-wishlist:hover {
            background-color: var(--light-beige);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .wishlist-header h1 {
                font-size: 30px;
            }
        }

        @media (max-width: 768px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto 40px;
            }
            
            .empty-wishlist-actions {
                flex-direction: column;
                align-items: center;
            }
            
            .empty-wishlist-actions .temp-btn {
                width: 100%;
                max-width: 250px;
            }
            
            .share-buttons {
                flex-direction: column;
                align-items: center;
            }
            
            .share-temp-btn {
                width: 100%;
                max-width: 250px;
                justify-content: center;
            }
            
            section {
                padding: 60px 0;
            }
            
            .section-title h2 {
                font-size: 28px;
            }
        }

        @media (max-width: 576px) {
            .wishlist-header h1 {
                font-size: 28px;
            }
            
            .temp-btn {
                padding: 12px 24px;
                font-size: 15px;
            }
            
            .wishlist-item-image {
                height: 200px;
            }
            
            .product-image {
                height: 200px;
            }
        }
    </style>
</head>
<body>
    <!-- Wishlist Header -->
    <section class="wishlist-header editable-section" data-section="176">
        <div class="container">
            <h1 class="editable-text editable-section no-drop-zone" data-section="177" data-text="132">My Wishlist</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="178" data-text="133">Save your favorite items for later</p>
        </div>
    </section>

    <!-- Wishlist Section -->
    <section class="wishlist-section editable-section" data-section="179">
        <div class="container">
            <div class="wishlist-grid">
                <!-- Wishlist Item 1 -->
                <div class="wishlist-item editable-section no-drop-zone" data-section="180">
                    <div class="wishlist-remove" onclick="removeFromWishlist(1)" title="Remove from wishlist">
                        <i class="fas fa-times editable-icon" data-icon="25" data-default-class="fas fa-times"></i>
                    </div>
                    <img src="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Organic Cotton Romper" class="wishlist-item-image">
                    <div class="wishlist-item-info">
                        <h3 class="wishlist-item-title editable-text editable-section no-drop-zone" data-section="181" data-text="134">Organic Cotton Romper</h3>
                        <div class="wishlist-item-price editable-text editable-section no-drop-zone" data-section="182" data-text="135">$48.00</div>
                        <div class="wishlist-item-actions">
                            <button class="temp-btn-add-cart editable-text editable-section no-drop-zone" data-section="183" data-text="136">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-move-cart" onclick="moveToCart(1)" title="Move to cart">
                                <i class="fas fa-arrow-right editable-icon" data-icon="26" data-default-class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Wishlist Item 2 -->
                <div class="wishlist-item">
                    <div class="wishlist-remove" onclick="removeFromWishlist(2)" title="Remove from wishlist">
                        <i class="fas fa-times editable-icon" data-icon="25" data-default-class="fas fa-times"></i>
                    </div>
                    <img src="https://images.unsplash.com/photo-1589878614012-db51690e73e9?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Cashmere Baby Set" class="wishlist-item-image">
                    <div class="wishlist-item-info">
                        <h3 class="wishlist-item-title">Cashmere Baby Set</h3>
                        <div class="wishlist-item-price">$89.00</div>
                        <div class="wishlist-item-actions">
                            <button class="temp-btn-add-cart">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-move-cart" onclick="moveToCart(2)" title="Move to cart">
                                <i class="fas fa-arrow-right editable-icon" data-icon="26" data-default-class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Wishlist Item 3 -->
                <div class="wishlist-item">
                    <div class="wishlist-remove" onclick="removeFromWishlist(3)" title="Remove from wishlist">
                        <i class="fas fa-times editable-icon" data-icon="25" data-default-class="fas fa-times"></i>
                    </div>
                    <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Linen Baby Dress" class="wishlist-item-image">
                    <div class="wishlist-item-info">
                        <h3 class="wishlist-item-title">Linen Baby Dress</h3>
                        <div class="wishlist-item-price">$65.00</div>
                        <div class="wishlist-item-actions">
                            <button class="temp-btn-add-cart">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-move-cart" onclick="moveToCart(3)" title="Move to cart">
                                <i class="fas fa-arrow-right editable-icon" data-icon="26" data-default-class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Wishlist Item 4 -->
                <div class="wishlist-item">
                    <div class="wishlist-remove" onclick="removeFromWishlist(4)" title="Remove from wishlist">
                        <i class="fas fa-times editable-icon" data-icon="25" data-default-class="fas fa-times"></i>
                    </div>
                    <img src="https://images.unsplash.com/photo-1577900230376-81d5278e7e6e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Swaddle Set" class="wishlist-item-image">
                    <div class="wishlist-item-info">
                        <h3 class="wishlist-item-title">Premium Swaddle Set</h3>
                        <div class="wishlist-item-price">$72.00</div>
                        <div class="wishlist-item-actions">
                            <button class="temp-btn-add-cart">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-move-cart" onclick="moveToCart(4)" title="Move to cart">
                                <i class="fas fa-arrow-right editable-icon" data-icon="26" data-default-class="fas fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Share Wishlist -->
            <div class="share-wishlist editable-section" data-section="184">
                <h3 class="editable-text editable-section no-drop-zone" data-section="185" data-text="137">Share Your Wishlist</h3>
                <p class="editable-text editable-section no-drop-zone" data-section="186" data-text="138">Let friends and family know what you're loving!</p>
                <div class="share-buttons">
                    <a href="#" class="share-temp-btn">
                        <i class="fas fa-link editable-icon" data-icon="27" data-default-class="fas fa-link"></i>
                        <span class="editable-text editable-section no-drop-zone" data-section="187" data-text="139">Copy Link</span>
                    </a>
                    <a href="#" class="share-temp-btn">
                        <i class="fab fa-facebook editable-icon" data-icon="28" data-default-class="fab fa-facebook"></i>
                        <span class="editable-text editable-section no-drop-zone" data-section="188" data-text="140">Share on Facebook</span>
                    </a>
                    <a href="#" class="share-temp-btn">
                        <i class="fab fa-pinterest editable-icon" data-icon="29" data-default-class="fab fa-pinterest"></i>
                        <span class="editable-text editable-section no-drop-zone" data-section="189" data-text="141">Pin on Pinterest</span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Recently Viewed Section -->
    <section class="recently-viewed-section editable-section" data-section="190">
        <div class="container">
            <div class="section-title">
                <h2 class="editable-text editable-section no-drop-zone" data-section="191" data-text="142">Recently Viewed</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="192" data-text="143">Products you've recently browsed</p>
            </div>
            
            <div class="recently-viewed-grid">
                <!-- Recently Viewed Product 1 -->
                <div class="product-card editable-section no-drop-zone" data-section="193">
                    <img src="https://images.unsplash.com/photo-1595272563575-3d1c5ba2d4c9?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Bodysuit Set" class="product-image">
                    <div class="product-info">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="194" data-text="144">3-Pack Bodysuits</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="195" data-text="145">Essential cotton for everyday wear</p>
                        <div class="price editable-text editable-section no-drop-zone" data-section="196" data-text="146">$36.00</div>
                        <div class="product-actions">
                            <button class="temp-btn-primary editable-text editable-section no-drop-zone" data-section="197" data-text="147">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-wishlist">
                                <i class="fas fa-heart editable-icon" data-icon="7" data-default-class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Recently Viewed Product 2 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1566305977571-5666677c6e98?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Sleep Sack" class="product-image">
                    <div class="product-info">
                        <h3>Organic Sleep Sack</h3>
                        <p>Safe and comfortable wearable blanket</p>
                        <div class="price">$42.00</div>
                        <div class="product-actions">
                            <button class="temp-btn-primary">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-wishlist">
                                <i class="fas fa-heart editable-icon" data-icon="7" data-default-class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Recently Viewed Product 3 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1595456977772-7d6b6f66f5a2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Knit Cardigan" class="product-image">
                    <div class="product-info">
                        <h3>Baby Knit Cardigan</h3>
                        <p>Hand-knit wool blend for chilly days</p>
                        <div class="price">$55.00</div>
                        <div class="product-actions">
                            <button class="temp-btn-primary">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-wishlist">
                                <i class="fas fa-heart editable-icon" data-icon="7" data-default-class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Recently Viewed Product 4 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1558769366-6a6b4f6f3c7d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=600&q=80" alt="Outfit Set" class="product-image">
                    <div class="product-info">
                        <h3>Special Occasion Set</h3>
                        <p>Complete outfit with matching accessories</p>
                        <div class="price">$78.00</div>
                        <div class="product-actions">
                            <button class="temp-btn-primary">
                                <i class="fas fa-cart-plus editable-icon" data-icon="6" data-default-class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="temp-btn-wishlist">
                                <i class="fas fa-heart editable-icon" data-icon="7" data-default-class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Remove from Wishlist
        function removeFromWishlist(itemId) {
            if (confirm('Are you sure you want to remove this item from your wishlist?')) {
                const item = document.querySelector(`.wishlist-item:nth-child(${itemId})`);
                if (item) {
                    item.style.opacity = '0';
                    item.style.transform = 'scale(0.9)';
                    
                    setTimeout(() => {
                        item.remove();
                        checkEmptyWishlist();
                        updateWishlistBadge();
                    }, 300);
                }
                console.log(`Removed item ${itemId} from wishlist`);
                // In real implementation, this would make an AJAX call
            }
        }

        // Move to Cart
        function moveToCart(itemId) {
            const item = document.querySelector(`.wishlist-item:nth-child(${itemId})`);
            if (item) {
                item.style.opacity = '0';
                item.style.transform = 'translateX(100px)';
                
                setTimeout(() => {
                    item.remove();
                    checkEmptyWishlist();
                    updateWishlistBadge();
                    
                    // Update cart badge
                    const cartBadge = document.querySelector('.header-actions .fa-shopping-cart')?.nextElementSibling;
                    if(cartBadge) {
                        const currentCount = parseInt(cartBadge.textContent);
                        cartBadge.textContent = currentCount + 1;
                    }
                    
                    alert('Item moved to cart!');
                }, 300);
            }
            console.log(`Moved item ${itemId} to cart`);
            // In real implementation, this would make an AJAX call
        }

        // Add to Cart from Wishlist
        document.querySelectorAll('.temp-btn-add-cart').forEach(button => {
            button.addEventListener('click', function() {
                const wishlistItem = this.closest('.wishlist-item');
                const productName = wishlistItem.querySelector('.wishlist-item-title').textContent;
                
                alert(`Added ${productName} to cart!`);
                // In real implementation, this would add item to cart via AJAX
                
                // Update cart badge
                const cartBadge = document.querySelector('.header-actions .fa-shopping-cart')?.nextElementSibling;
                if(cartBadge) {
                    const currentCount = parseInt(cartBadge.textContent);
                    cartBadge.textContent = currentCount + 1;
                }
            });
        });

        // Check Empty Wishlist
        function checkEmptyWishlist() {
            const wishlistGrid = document.querySelector('.wishlist-grid');
            if (wishlistGrid && wishlistGrid.children.length === 0) {
                showEmptyWishlist();
            }
        }

        // Show Empty Wishlist
        function showEmptyWishlist() {
            const wishlistSection = document.querySelector('.wishlist-section .container');
            if (wishlistSection) {
                wishlistSection.innerHTML = `
                    <div class="empty-wishlist">
                        <i class="fas fa-heart editable-icon" data-icon="30" data-default-class="fas fa-heart"></i>
                        <h2>Your wishlist is empty</h2>
                        <p>Looks like you haven't added any items to your wishlist yet. Start exploring our collection!</p>
                        <div class="empty-wishlist-actions">
                            <a href="?page=shop" class="temp-btn">Start Shopping</a>
                            <a href="?page=home" class="temp-btn temp-btn-secondary">Return to Home</a>
                        </div>
                    </div>
                    <div class="share-wishlist" style="display: none;"></div>
                `;
            }
        }

        // Update Wishlist Badge
        function updateWishlistBadge() {
            const wishlistCount = document.querySelectorAll('.wishlist-item').length;
            const badge = document.querySelector('.header-actions .fa-heart')?.nextElementSibling;
            if(badge) {
                badge.textContent = wishlistCount;
            }
        }

        // Share Wishlist - Copy Link
        document.querySelector('.share-temp-btn:nth-child(1)').addEventListener('click', function(e) {
            e.preventDefault();
            const shareLink = window.location.href;
            
            // Copy to clipboard
            navigator.clipboard.writeText(shareLink).then(() => {
                const originalText = this.querySelector('span').textContent;
                this.querySelector('span').textContent = 'Link Copied!';
                
                setTimeout(() => {
                    this.querySelector('span').textContent = originalText;
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy: ', err);
            });
        });

        // Add to Cart from Recently Viewed
        document.querySelectorAll('.recently-viewed-grid .temp-btn-primary').forEach(button => {
            button.addEventListener('click', function() {
                const productCard = this.closest('.product-card');
                const productName = productCard.querySelector('h3').textContent;
                
                alert(`Added ${productName} to cart!`);
                // In real implementation, this would add item to cart via AJAX
                
                // Update cart badge
                const cartBadge = document.querySelector('.header-actions .fa-shopping-cart')?.nextElementSibling;
                if(cartBadge) {
                    const currentCount = parseInt(cartBadge.textContent);
                    cartBadge.textContent = currentCount + 1;
                }
            });
        });

        // Add to Wishlist from Recently Viewed
        document.querySelectorAll('.recently-viewed-grid .temp-btn-wishlist').forEach(button => {
            button.addEventListener('click', function() {
                const productCard = this.closest('.product-card');
                const productName = productCard.querySelector('h3').textContent;
                
                alert(`Added ${productName} to wishlist!`);
                // In real implementation, this would add item to wishlist via AJAX
                
                // Update wishlist badge
                const wishlistBadge = document.querySelector('.header-actions .fa-heart')?.nextElementSibling;
                if(wishlistBadge) {
                    const currentCount = parseInt(wishlistBadge.textContent);
                    wishlistBadge.textContent = currentCount + 1;
                }
            });
        });

        // Initialize wishlist badge
        updateWishlistBadge();
    </script>
</body>
</html>


