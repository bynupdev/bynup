<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Lullaby Luxe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --primary-brown: #B0988B;
            --primary-teal: #4D8581;
            --light-teal: #ABDED7;
            --light-beige: #DBCBBE;
            --background-cream: #EEE7DF;
            --text-dark: #333333;
            --text-light: #555555;
            --white: #FFFFFF;
            --shadow: rgba(0, 0, 0, 0.05);
        }

        /* Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--background-cream);
            color: var(--text-dark);
            line-height: 1.6;
            padding-top: 100px; /* For fixed header */
        }

        h1, h2, h3, h4 {
            font-weight: 300;
            letter-spacing: 0.5px;
        }

        p {
            color: var(--text-light);
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .temp-btn {
            display: inline-block;
            background-color: var(--primary-teal);
            color: var(--white);
            border: none;
            padding: 14px 32px;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 2px;
            text-decoration: none;
        }

        .temp-btn:hover {
            background-color: var(--primary-brown);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px var(--shadow);
        }

        .temp-btn-secondary {
            background-color: transparent;
            color: var(--primary-teal);
            border: 1px solid var(--primary-teal);
        }

        .temp-btn-secondary:hover {
            background-color: rgba(77, 133, 129, 0.1);
        }

        section {
            padding: 80px 0;
        }

        /* Contact Header */
        .contact-header {
            padding: 40px 0 20px;
            border-bottom: 1px solid var(--light-beige);
            margin-bottom: 40px;
        }

        .contact-header h1 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 10px;
            font-weight: 300;
        }

        /* Contact Section */
        .contact-section {
            padding: 40px 0;
        }

        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        /* Contact Info */
        .contact-info {
            background-color: var(--white);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 5px 20px var(--shadow);
        }

        .contact-info h2 {
            font-size: 28px;
            color: var(--primary-teal);
            margin-bottom: 30px;
            font-weight: 400;
        }

        .contact-methods {
            display: flex;
            flex-direction: column;
            gap: 30px;
            margin-bottom: 40px;
        }

        .contact-method {
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background-color: var(--light-teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-teal);
            font-size: 20px;
            flex-shrink: 0;
        }

        .contact-details h3 {
            font-size: 18px;
            color: var(--primary-teal);
            margin-bottom: 5px;
            font-weight: 500;
        }

        .contact-details p {
            margin-bottom: 5px;
        }

        .business-hours {
            background-color: var(--background-cream);
            padding: 25px;
            border-radius: 8px;
            margin-top: 20px;
        }

        .business-hours h3 {
            font-size: 18px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 500;
        }

        .hours-list {
            list-style: none;
        }

        .hours-list li {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--light-beige);
        }

        .hours-list li:last-child {
            border-bottom: none;
        }

        /* Contact Form */
        .contact-form-container {
            background-color: var(--white);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 5px 20px var(--shadow);
        }

        .contact-form-container h2 {
            font-size: 28px;
            color: var(--primary-teal);
            margin-bottom: 30px;
            font-weight: 400;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--text-dark);
        }

        .form-control {
            width: 100%;
            padding: 14px;
            border: 1px solid var(--light-beige);
            border-radius: 6px;
            font-size: 16px;
            transition: all 0.3s ease;
            background-color: var(--background-cream);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-teal);
            box-shadow: 0 0 0 3px rgba(77, 133, 129, 0.1);
            background-color: var(--white);
        }

        textarea.form-control {
            min-height: 150px;
            resize: vertical;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-check input {
            width: 18px;
            height: 18px;
        }

        .form-check label {
            margin-bottom: 0;
            font-size: 14px;
        }

        /* FAQ Section */
        .faq-section {
            padding: 60px 0;
            background-color: var(--light-teal);
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 300;
        }

        .faq-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .faq-item {
            background-color: var(--white);
            border-radius: 8px;
            margin-bottom: 15px;
            overflow: hidden;
            box-shadow: 0 3px 10px var(--shadow);
        }

        .faq-question {
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .faq-question:hover {
            background-color: rgba(77, 133, 129, 0.05);
        }

        .faq-question h3 {
            font-size: 18px;
            color: var(--primary-teal);
            font-weight: 500;
            margin: 0;
        }

        .faq-icon {
            color: var(--primary-teal);
            font-size: 20px;
            transition: transform 0.3s ease;
        }

        .faq-answer {
            padding: 0 30px;
            max-height: 500px;
            overflow: hidden;
            transition: all 0.3s ease;
            background-color: rgba(255, 255, 255, 0.9);
        }

        .faq-answer p {
            padding: 20px 0;
            margin: 0;
            border-top: 1px solid var(--light-beige);
        }

        .faq-item.active .faq-answer {
            max-height: 500px;
        }

        .faq-item.active .faq-icon {
            transform: rotate(45deg);
        }

        /* Map Section */
        .map-section {
            padding: 60px 0;
            background-color: var(--white);
        }

        .map-container {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px var(--shadow);
            height: 400px;
            background-color: var(--light-beige);
        }

        /* Contact CTA */
        .contact-cta {
            padding: 60px 0;
            background-color: var(--light-teal);
            text-align: center;
        }

        .contact-cta h2 {
            font-size: 32px;
            color: var(--primary-teal);
            margin-bottom: 20px;
            font-weight: 300;
        }

        .contact-cta p {
            margin-bottom: 30px;
            font-size: 18px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .contact-container {
                gap: 40px;
            }
        }

        @media (max-width: 992px) {
            .contact-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .contact-header h1 {
                font-size: 32px;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
            
            .section-title h2 {
                font-size: 28px;
            }
        }

        @media (max-width: 768px) {
            .contact-info,
            .contact-form-container {
                padding: 30px;
            }
            
            .contact-method {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .faq-question {
                padding: 20px;
            }
            
            .faq-question h3 {
                font-size: 16px;
            }
            
            .faq-answer {
                padding: 0 20px;
            }
            
            section {
                padding: 60px 0;
            }
            
            .contact-cta h2 {
                font-size: 28px;
            }
        }

        @media (max-width: 576px) {
            .contact-header h1 {
                font-size: 28px;
            }
            
            .temp-btn {
                padding: 12px 24px;
                font-size: 15px;
            }
            
            .contact-icon {
                width: 40px;
                height: 40px;
                font-size: 18px;
            }
            
            .map-container {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <!-- Contact Header -->
    <section class="contact-header editable-section" data-section="231">
        <div class="container">
            <h1 class="editable-text editable-section no-drop-zone" data-section="232" data-text="168">Contact Us</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="233" data-text="169">We're here to help with any questions about our premium baby clothing</p>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact-section editable-section" data-section="234">
        <div class="container">
            <div class="contact-container">
                <!-- Contact Info -->
                <div class="contact-info editable-section no-drop-zone" data-section="235">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="236" data-text="170">Get in Touch</h2>
                    
                    <div class="contact-methods">
                        <!-- Contact Method 1 -->
                        <div class="contact-method editable-section no-drop-zone" data-section="237">
                            <div class="contact-icon">
                                <i class="fas fa-phone-alt editable-icon" data-icon="50" data-default-class="fas fa-phone-alt"></i>
                            </div>
                            <div class="contact-details">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="238" data-text="171">Phone</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="239" data-text="172">+1 (555) 123-4567</p>
                                <p class="editable-text editable-section no-drop-zone" data-section="240" data-text="173">Mon-Fri 9am-6pm EST</p>
                            </div>
                        </div>
                        
                        <!-- Contact Method 2 -->
                        <div class="contact-method editable-section no-drop-zone" data-section="241">
                            <div class="contact-icon">
                                <i class="fas fa-envelope editable-icon" data-icon="51" data-default-class="fas fa-envelope"></i>
                            </div>
                            <div class="contact-details">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="242" data-text="174">Email</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="243" data-text="175">hello@lullabyluxe.com</p>
                                <p class="editable-text editable-section no-drop-zone" data-section="244" data-text="176">We respond within 24 hours</p>
                            </div>
                        </div>
                        
                        <!-- Contact Method 3 -->
                        <div class="contact-method editable-section no-drop-zone" data-section="245">
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt editable-icon" data-icon="52" data-default-class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="contact-details">
                                <h3 class="editable-text editable-section no-drop-zone" data-section="246" data-text="177">Visit Our Studio</h3>
                                <p class="editable-text editable-section no-drop-zone" data-section="247" data-text="178">123 Luxury Lane</p>
                                <p class="editable-text editable-section no-drop-zone" data-section="248" data-text="179">New York, NY 10001</p>
                                <p class="editable-text editable-section no-drop-zone" data-section="249" data-text="180">By appointment only</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Business Hours -->
                    <div class="business-hours editable-section no-drop-zone" data-section="250">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="251" data-text="181">Business Hours</h3>
                        <ul class="hours-list">
                            <li>
                                <span class="editable-text editable-section no-drop-zone" data-section="252" data-text="182">Monday - Friday</span>
                                <span class="editable-text editable-section no-drop-zone" data-section="253" data-text="183">9:00 AM - 6:00 PM</span>
                            </li>
                            <li>
                                <span class="editable-text editable-section no-drop-zone" data-section="254" data-text="184">Saturday</span>
                                <span class="editable-text editable-section no-drop-zone" data-section="255" data-text="185">10:00 AM - 4:00 PM</span>
                            </li>
                            <li>
                                <span class="editable-text editable-section no-drop-zone" data-section="256" data-text="186">Sunday</span>
                                <span class="editable-text editable-section no-drop-zone" data-section="257" data-text="187">Closed</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form-container editable-section no-drop-zone" data-section="258">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="259" data-text="188">Send Us a Message</h2>
                    
                    <form id="contact-form" class="editable-section no-drop-zone" data-section="260">
                        <div class="form-row">
                            <div class="form-group editable-section no-drop-zone" data-section="261">
                                <label for="first-name" class="editable-text editable-section no-drop-zone" data-section="262" data-text="189">First Name</label>
                                <input type="text" id="first-name" class="form-control" placeholder="Enter your first name" required>
                            </div>
                            <div class="form-group editable-section no-drop-zone" data-section="263">
                                <label for="last-name" class="editable-text editable-section no-drop-zone" data-section="264" data-text="190">Last Name</label>
                                <input type="text" id="last-name" class="form-control" placeholder="Enter your last name" required>
                            </div>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="265">
                            <label for="email" class="editable-text editable-section no-drop-zone" data-section="266" data-text="191">Email Address</label>
                            <input type="email" id="email" class="form-control" placeholder="Enter your email address" required>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="267">
                            <label for="phone" class="editable-text editable-section no-drop-zone" data-section="268" data-text="192">Phone Number (Optional)</label>
                            <input type="tel" id="phone" class="form-control" placeholder="Enter your phone number">
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="269">
                            <label for="subject" class="editable-text editable-section no-drop-zone" data-section="270" data-text="193">Subject</label>
                            <select id="subject" class="form-control" required>
                                <option value="" disabled selected class="editable-text editable-section no-drop-zone" data-section="271" data-text="194">Select a subject</option>
                                <option value="order" class="editable-text editable-section no-drop-zone" data-section="272" data-text="195">Order Inquiry</option>
                                <option value="shipping" class="editable-text editable-section no-drop-zone" data-section="273" data-text="196">Shipping & Delivery</option>
                                <option value="returns" class="editable-text editable-section no-drop-zone" data-section="274" data-text="197">Returns & Exchanges</option>
                                <option value="product" class="editable-text editable-section no-drop-zone" data-section="275" data-text="198">Product Questions</option>
                                <option value="other" class="editable-text editable-section no-drop-zone" data-section="276" data-text="199">Other Inquiry</option>
                            </select>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="277">
                            <label for="message" class="editable-text editable-section no-drop-zone" data-section="278" data-text="200">Your Message</label>
                            <textarea id="message" class="form-control" placeholder="How can we help you today?" required></textarea>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="279">
                            <div class="form-check">
                                <input type="checkbox" id="newsletter" name="newsletter">
                                <label for="newsletter" class="editable-text editable-section no-drop-zone" data-section="280" data-text="201">Subscribe to our newsletter for updates and special offers</label>
                            </div>
                        </div>
                        
                        <button type="submit" class="temp-btn editable-text editable-section no-drop-zone" data-section="281" data-text="202">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section editable-section" data-section="282">
        <div class="container">
            <div class="section-title">
                <h2 class="editable-text editable-section no-drop-zone" data-section="283" data-text="203">Frequently Asked Questions</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="284" data-text="204">Find quick answers to common questions about our products and services</p>
            </div>
            
            <div class="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item editable-section no-drop-zone" data-section="285">
                    <div class="faq-question" onclick="toggleFAQ(1)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="286" data-text="205">What materials are used in your baby clothing?</h3>
                        <div class="faq-icon editable-icon" data-icon="53" data-default-class="fas fa-plus">+</div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="287" data-text="206">We use only the finest materials including GOTS-certified organic cotton, premium cashmere blends, and breathable linen. All fabrics are carefully selected for their softness, durability, and suitability for delicate baby skin.</p>
                    </div>
                </div>
                
                <!-- FAQ 2 -->
                <div class="faq-item editable-section no-drop-zone" data-section="288">
                    <div class="faq-question" onclick="toggleFAQ(2)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="289" data-text="207">What is your return and exchange policy?</h3>
                        <div class="faq-icon editable-icon" data-icon="53" data-default-class="fas fa-plus">+</div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="290" data-text="208">We offer a 30-day return policy for unworn items with tags attached. Exchanges are free within the U.S. for a different size or color. International returns are subject to shipping fees. All returns are processed within 3-5 business days of receipt.</p>
                    </div>
                </div>
                
                <!-- FAQ 3 -->
                <div class="faq-item editable-section no-drop-zone" data-section="291">
                    <div class="faq-question" onclick="toggleFAQ(3)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="292" data-text="209">How do I care for the baby clothing?</h3>
                        <div class="faq-icon editable-icon" data-icon="53" data-default-class="fas fa-plus">+</div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="293" data-text="210">Most items are machine washable in cold water with mild detergent. We recommend tumble drying on low heat or line drying to preserve fabric quality. Specific care instructions are included with each garment and available on the product page.</p>
                    </div>
                </div>
                
                <!-- FAQ 4 -->
                <div class="faq-item editable-section no-drop-zone" data-section="294">
                    <div class="faq-question" onclick="toggleFAQ(4)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="295" data-text="211">Do you offer international shipping?</h3>
                        <div class="faq-icon editable-icon" data-icon="53" data-default-class="fas fa-plus">+</div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="296" data-text="212">Yes, we ship to over 50 countries worldwide. Shipping costs and delivery times vary by destination. Customs duties and taxes may apply and are the responsibility of the customer. Please allow 7-14 business days for international delivery.</p>
                    </div>
                </div>
                
                <!-- FAQ 5 -->
                <div class="faq-item editable-section no-drop-zone" data-section="297">
                    <div class="faq-question" onclick="toggleFAQ(5)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="298" data-text="213">Are your products suitable for sensitive skin?</h3>
                        <div class="faq-icon editable-icon" data-icon="53" data-default-class="fas fa-plus">+</div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="299" data-text="214">Absolutely! Our organic collection is specifically designed for sensitive skin. All fabrics are OEKO-TEX certified, meaning they're free from harmful substances. We use hypoallergenic dyes and avoid harsh chemicals in our production process.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Map Section -->
    <section class="map-section editable-section" data-section="300">
        <div class="container">
            <div class="section-title">
                <h2 class="editable-text editable-section no-drop-zone" data-section="301" data-text="215">Visit Our Studio</h2>
                <p class="editable-text editable-section no-drop-zone" data-section="302" data-text="216">Schedule an appointment to see our collections in person</p>
            </div>
            
            <div class="map-container editable-section no-drop-zone" data-section="303">
                <!-- Map Placeholder - In real implementation, this would be a Google Maps embed -->
                <div style="width: 100%; height: 100%; background-color: var(--light-beige); display: flex; align-items: center; justify-content: center; color: var(--primary-teal);">
                    <div style="text-align: center; padding: 40px;">
                        <i class="fas fa-map-marker-alt editable-icon" data-icon="52" data-default-class="fas fa-map-marker-alt" style="font-size: 60px; margin-bottom: 20px;"></i>
                        <h3 style="margin-bottom: 10px;" class="editable-text editable-section no-drop-zone" data-section="304" data-text="217">Lullaby Luxe Studio</h3>
                        <p class="editable-text editable-section no-drop-zone" data-section="305" data-text="218">123 Luxury Lane, New York, NY 10001</p>
                        <p class="editable-text editable-section no-drop-zone" data-section="306" data-text="219">By appointment only</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact CTA -->
    <section class="contact-cta editable-section" data-section="307">
        <div class="container">
            <h2 class="editable-text editable-section no-drop-zone" data-section="308" data-text="220">Still Have Questions?</h2>
            <p class="editable-text editable-section no-drop-zone" data-section="309" data-text="221">Our customer service team is here to help you find the perfect items for your little one.</p>
            <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
                <a href="#contact-form" class="temp-btn editable-text editable-section no-drop-zone" data-section="310" data-text="222">Send Us a Message</a>
                <a href="tel:+15551234567" class="temp-btn temp-btn-secondary editable-text editable-section no-drop-zone" data-section="311" data-text="223">Call Now</a>
            </div>
        </div>
    </section>

    <script>
        // FAQ Toggle Functionality
        function toggleFAQ(faqNumber) {
            const faqItem = document.querySelector(`.faq-item:nth-child(${faqNumber})`);
            const isActive = faqItem.classList.contains('active');
            
            // Close all FAQs
            document.querySelectorAll('.faq-item').forEach(item => {
                item.classList.remove('active');
                const icon = item.querySelector('.faq-icon');
                if (icon) icon.textContent = '+';
            });
            
            // Open clicked FAQ if it wasn't already active
            if (!isActive) {
                faqItem.classList.add('active');
                const icon = faqItem.querySelector('.faq-icon');
                if (icon) icon.textContent = '−';
            }
        }

        // Form Submission
        document.getElementById('contact-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Get form data
            const formData = {
                firstName: document.getElementById('first-name').value,
                lastName: document.getElementById('last-name').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value,
                subject: document.getElementById('subject').value,
                message: document.getElementById('message').value,
                newsletter: document.getElementById('newsletter').checked
            };
            
            // Validate form
            if (!formData.firstName || !formData.lastName || !formData.email || !formData.subject || !formData.message) {
                alert('Please fill in all required fields.');
                return;
            }
            
            // Email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(formData.email)) {
                alert('Please enter a valid email address.');
                return;
            }
            
            // Show success message
            alert('Thank you for your message! We will get back to you within 24 hours.');
            
            // Reset form
            this.reset();
            
            // In real implementation, this would send data to server
            console.log('Form submitted:', formData);
        });

        // Auto-open first FAQ on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Open first FAQ by default
            const firstFAQ = document.querySelector('.faq-item');
            if (firstFAQ) {
                firstFAQ.classList.add('active');
                const icon = firstFAQ.querySelector('.faq-icon');
                if (icon) icon.textContent = '−';
            }
            
            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;
                    
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 120,
                            behavior: 'smooth'
                        });
                    }
                });
            });
        });

        // Phone number formatting
        document.getElementById('phone').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 3 && value.length <= 6) {
                value = value.replace(/(\d{3})(\d{0,3})/, '($1) $2');
            } else if (value.length > 6) {
                value = value.replace(/(\d{3})(\d{3})(\d{0,4})/, '($1) $2-$3');
            }
            e.target.value = value;
        });
    </script>
</body>
</html>



