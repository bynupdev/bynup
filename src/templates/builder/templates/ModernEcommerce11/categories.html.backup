<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | Lullaby Luxe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --primary-brown: #B0988B;
            --primary-teal: #4D8581;
            --light-teal: #ABDED7;
            --light-beige: #DBCBBE;
            --background-cream: #EEE7DF;
            --text-dark: #333333;
            --text-light: #555555;
            --white: #FFFFFF;
            --shadow: rgba(0, 0, 0, 0.05);
        }

        /* Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--background-cream);
            color: var(--text-dark);
            line-height: 1.6;
            padding-top: 100px; /* For fixed header */
        }

        h1, h2, h3, h4 {
            font-weight: 300;
            letter-spacing: 0.5px;
        }

        p {
            color: var(--text-light);
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .temp-btn {
            display: inline-block;
            background-color: var(--primary-teal);
            color: var(--white);
            border: none;
            padding: 14px 32px;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 2px;
            text-decoration: none;
        }

        .temp-btn:hover {
            background-color: var(--primary-brown);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px var(--shadow);
        }

        .temp-btn-secondary {
            background-color: transparent;
            color: var(--primary-teal);
            border: 1px solid var(--primary-teal);
        }

        .temp-btn-secondary:hover {
            background-color: rgba(77, 133, 129, 0.1);
        }

        section {
            padding: 80px 0;
        }

        /* Categories Header */
        .categories-header {
            padding: 40px 0 20px;
            border-bottom: 1px solid var(--light-beige);
            margin-bottom: 40px;
        }

        .categories-header h1 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 10px;
            font-weight: 300;
        }

        /* Categories Grid Section */
        .categories-section {
            padding: 40px 0;
        }

        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .category-card {
            background-color: var(--white);
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px var(--shadow);
            position: relative;
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .category-image {
            height: 300px;
            width: 100%;
            object-fit: cover;
            background-color: var(--light-beige);
            transition: transform 0.5s ease;
        }

        .category-card:hover .category-image {
            transform: scale(1.05);
        }

        .category-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.3) 100%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 30px;
            color: var(--white);
        }

        .category-content {
            position: relative;
            z-index: 2;
        }

        .category-title {
            font-size: 28px;
            color: var(--white);
            margin-bottom: 10px;
            font-weight: 400;
        }

        .category-count {
            font-size: 16px;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 20px;
        }

        .category-temp-btn {
            background-color: var(--white);
            color: var(--primary-teal);
            padding: 10px 20px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .category-temp-btn:hover {
            background-color: var(--primary-teal);
            color: var(--white);
            transform: translateY(-2px);
        }

        /* Featured Categories */
        .featured-categories-section {
            padding: 60px 0;
            background-color: var(--light-teal);
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 300;
        }

        .featured-categories-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .featured-category {
            background-color: var(--white);
            border-radius: 8px;
            padding: 30px;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px var(--shadow);
        }

        .featured-category:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .featured-category-icon {
            font-size: 40px;
            color: var(--primary-teal);
            margin-bottom: 20px;
            height: 80px;
            width: 80px;
            background-color: var(--light-beige);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .featured-category h3 {
            font-size: 18px;
            color: var(--primary-teal);
            margin-bottom: 10px;
            font-weight: 500;
        }

        .featured-category p {
            font-size: 14px;
            margin-bottom: 20px;
            color: var(--text-light);
        }

        .featured-category-link {
            color: var(--primary-brown);
            text-decoration: none;
            font-weight: 500;
            display: inline-block;
            transition: all 0.3s ease;
        }

        .featured-category-link:hover {
            color: var(--primary-teal);
            transform: translateX(5px);
        }

        /* Age Categories */
        .age-categories-section {
            padding: 60px 0;
            background-color: var(--white);
        }

        .age-categories-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }

        .age-category {
            text-align: center;
            padding: 30px 20px;
            background-color: var(--background-cream);
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .age-category:hover {
            background-color: var(--light-teal);
            transform: translateY(-5px);
        }

        .age-category-icon {
            font-size: 32px;
            color: var(--primary-teal);
            margin-bottom: 15px;
        }

        .age-category h3 {
            font-size: 20px;
            color: var(--primary-teal);
            margin-bottom: 10px;
            font-weight: 500;
        }

        .age-category p {
            font-size: 14px;
            margin-bottom: 20px;
        }

        .age-category-link {
            color: var(--primary-brown);
            text-decoration: none;
            font-weight: 500;
            font-size: 14px;
        }

        .age-category-link:hover {
            color: var(--primary-teal);
            text-decoration: underline;
        }

        /* Shop by Occasion */
        .occasion-section {
            padding: 60px 0;
            background-color: var(--light-teal);
        }

        .occasion-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .occasion-card {
            background-color: var(--white);
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px var(--shadow);
        }

        .occasion-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .occasion-image {
            height: 200px;
            width: 100%;
            object-fit: cover;
        }

        .occasion-content {
            padding: 25px;
            text-align: center;
        }

        .occasion-content h3 {
            font-size: 20px;
            color: var(--primary-teal);
            margin-bottom: 10px;
            font-weight: 500;
        }

        .occasion-content p {
            font-size: 14px;
            margin-bottom: 20px;
            color: var(--text-light);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
            background-color: var(--white);
            border-radius: 12px;
            box-shadow: 0 5px 20px var(--shadow);
            margin: 40px 0;
        }

        .empty-state i {
            font-size: 72px;
            color: var(--light-teal);
            margin-bottom: 25px;
        }

        .empty-state h3 {
            font-size: 28px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 300;
        }

        .empty-state p {
            margin-bottom: 30px;
            color: var(--text-light);
            font-size: 16px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .featured-categories-grid,
            .age-categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .categories-header h1 {
                font-size: 32px;
            }
            
            .occasion-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .category-title {
                font-size: 24px;
            }
        }

        @media (max-width: 768px) {
            .categories-grid,
            .featured-categories-grid,
            .age-categories-grid,
            .occasion-grid {
                grid-template-columns: 1fr;
                max-width: 500px;
                margin: 0 auto;
            }
            
            .category-image {
                height: 250px;
            }
            
            .section-title h2 {
                font-size: 28px;
            }
            
            .categories-header h1 {
                font-size: 28px;
            }
            
            section {
                padding: 60px 0;
            }
        }

        @media (max-width: 576px) {
            .temp-btn {
                padding: 12px 24px;
                font-size: 15px;
            }
            
            .category-overlay {
                padding: 20px;
            }
            
            .category-title {
                font-size: 22px;
            }
            
            .featured-category {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Categories Header -->
    <section class="categories-header editable-section" data-section="201">
        <div class="container">
            <h1 class="editable-text editable-section no-drop-zone" data-section="202" data-text="148">Browse Categories</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="203" data-text="149">Discover our premium baby clothing collections by category</p>
        </div>
    </section>

    <!-- Main Categories Grid -->
    <section class="categories-section editable-section" data-section="204">
        <div class="container">
            <div class="categories-grid">
                <!-- Category 1 -->
                <div class="category-card editable-section no-drop-zone" data-section="205">
                    <img src="https://images.unsplash.com/photo-1591369822096-ffd140ec948f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="New Arrivals" class="category-image editable-image" data-image="9">
                    <div class="category-overlay">
                        <div class="category-content">
                            <h2 class="category-title editable-text editable-section no-drop-zone" data-section="206" data-text="150">New Arrivals</h2>
                            <p class="category-count editable-text editable-section no-drop-zone" data-section="207" data-text="151">24+ New Items</p>
                            <a href="?page=shop&category=new-arrivals" class="category-temp-btn editable-text editable-section no-drop-zone" data-section="208" data-text="152">Shop Now</a>
                        </div>
                    </div>
                </div>
                
                <!-- Category 2 -->
                <div class="category-card">
                    <img src="https://images.unsplash.com/photo-1589878614012-db51690e73e9?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Premium Basics" class="category-image">
                    <div class="category-overlay">
                        <div class="category-content">
                            <h2 class="category-title">Premium Basics</h2>
                            <p class="category-count">45+ Essential Items</p>
                            <a href="?page=shop&category=basics" class="category-temp-btn">Shop Now</a>
                        </div>
                    </div>
                </div>
                
                <!-- Category 3 -->
                <div class="category-card">
                    <img src="https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Special Occasion" class="category-image">
                    <div class="category-overlay">
                        <div class="category-content">
                            <h2 class="category-title">Special Occasion</h2>
                            <p class="category-count">32+ Celebration Outfits</p>
                            <a href="?page=shop&category=occasion" class="category-temp-btn">Shop Now</a>
                        </div>
                    </div>
                </div>
                
                <!-- Category 4 -->
                <div class="category-card">
                    <img src="https://images.unsplash.com/photo-1577900230376-81d5278e7e6e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Sleepwear" class="category-image">
                    <div class="category-overlay">
                        <div class="category-content">
                            <h2 class="category-title">Sleepwear</h2>
                            <p class="category-count">18+ Cozy Items</p>
                            <a href="?page=shop&category=sleepwear" class="category-temp-btn">Shop Now</a>
                        </div>
                    </div>
                </div>
                
                <!-- Category 5 -->
                <div class="category-card">
                    <img src="https://images.unsplash.com/photo-1566305977571-5666677c6e98?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Outerwear" class="category-image">
                    <div class="category-overlay">
                        <div class="category-content">
                            <h2 class="category-title">Outerwear</h2>
                            <p class="category-count">22+ Warm Layers</p>
                            <a href="?page=shop&category=outerwear" class="category-temp-btn">Shop Now</a>
                        </div>
                    </div>
                </div>
                
                <!-- Category 6 -->
                <div class="category-card">
                    <img src="https://images.unsplash.com/photo-1595456977772-7d6b6f66f5a2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Gift Sets" class="category-image">
                    <div class="category-overlay">
                        <div class="category-content">
                            <h2 class="category-title">Gift Sets</h2>
                            <p class="category-count">15+ Curated Sets</p>
                            <a href="?page=shop&category=gifts" class="category-temp-btn">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    

    <script>
        // Category Card Hover Effects
        document.querySelectorAll('.category-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                const image = this.querySelector('.category-image');
                image.style.transform = 'scale(1.05)';
            });
            
            card.addEventListener('mouseleave', function() {
                const image = this.querySelector('.category-image');
                image.style.transform = 'scale(1)';
            });
        });

        // Featured Category Hover Effects
        document.querySelectorAll('.featured-category').forEach(category => {
            category.addEventListener('mouseenter', function() {
                const icon = this.querySelector('.featured-category-icon');
                icon.style.backgroundColor = 'var(--primary-teal)';
                icon.style.color = 'var(--white)';
                icon.style.transform = 'rotate(5deg)';
            });
            
            category.addEventListener('mouseleave', function() {
                const icon = this.querySelector('.featured-category-icon');
                icon.style.backgroundColor = 'var(--light-beige)';
                icon.style.color = 'var(--primary-teal)';
                icon.style.transform = 'rotate(0deg)';
            });
        });

        // Age Category Hover Effects
        document.querySelectorAll('.age-category').forEach(category => {
            category.addEventListener('mouseenter', function() {
                const icon = this.querySelector('.age-category-icon');
                icon.style.transform = 'scale(1.2)';
                icon.style.color = 'var(--primary-brown)';
            });
            
            category.addEventListener('mouseleave', function() {
                const icon = this.querySelector('.age-category-icon');
                icon.style.transform = 'scale(1)';
                icon.style.color = 'var(--primary-teal)';
            });
        });

        // Category Click Tracking
        document.querySelectorAll('.category-temp-btn, .featured-category-link, .age-category-link').forEach(link => {
            link.addEventListener('click', function(e) {
                const categoryName = this.textContent.replace('→', '').trim();
                console.log(`Category clicked: ${categoryName}`);
                // In real implementation, this would track category views
            });
        });
    </script>
</body>
</html>