<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>PAWS & CO. — Premium Pet Care</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
  <style>
    /* ----------------------------------------------
       CSS VARIABLES — Warm Pet Brand Palette
    ------------------------------------------------ */
    :root {
      --background: #fdf8f3;
      --heading: #ffffff;
      --text: #2d1f14;
      --secondary: #6b5a4a;
      --accent: #f0e8df;
      --border: #ffffff;
      --primary: #c4956a;
      --success: #8b6b4a;
      --warning: #f5ede4;
      --error: #b5b8a3;
      --color-brand-terracotta: #d4a373;
      /* --success: #d68c5c; */
      /* --primary: #bf7a4d; */
      /* --accent: #f8ede4; */
      /* --heading: #ffffff;
      --success: #7baa7a; */
      --color-warm-shadow: rgba(150, 120, 90, 0.1);
      --font-display: 'Playfair Display', serif;
      --font-body: 'Nunito', -apple-system, BlinkMacSystemFont, sans-serif;
      --space-xs: 0.5rem;
      --space-sm: 1rem;
      --space-md: 2rem;
      --space-lg: 4rem;
      --space-xl: 6rem;
      --radius-sm: 12px;
      --radius-md: 24px;
      --radius-lg: 48px;
      --radius-full: 999px;
      --ease-organic: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-soft: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* ----------------------------------------------
       RESET & BASE
    ------------------------------------------------ */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }
    body {
      font-family: var(--font-body);
      background-color: var(--background);
      color: var(--text);
      line-height: 1.6;
      overflow-x: hidden;
    }
    img { max-width: 100%; display: block; height: auto; }
    a { text-decoration: none; color: inherit; }
    button { cursor: pointer; border: none; background: none; font: inherit; color: inherit; }
    :focus-visible { outline: 2px solid var(--success); outline-offset: 2px; }

    .container { max-width: 1200px; margin: 0 auto; padding: 0 var(--space-md); }
    .section-padding { padding: var(--space-xl) 0; }

    /* ----------------------------------------------
       SCROLL ANIMATIONS — REVEAL ON SCROLL
    ------------------------------------------------ */
    .reveal {
      opacity: 0;
      transform: translateY(60px);
      transition: all 0.8s var(--ease-organic);
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .reveal-left {
      opacity: 0;
      transform: translateX(-60px);
      transition: all 0.8s var(--ease-organic);
    }
    .reveal-left.visible {
      opacity: 1;
      transform: translateX(0);
    }
    .reveal-right {
      opacity: 0;
      transform: translateX(60px);
      transition: all 0.8s var(--ease-organic);
    }
    .reveal-right.visible {
      opacity: 1;
      transform: translateX(0);
    }
    .reveal-scale {
      opacity: 0;
      transform: scale(0.9);
      transition: all 0.8s var(--ease-organic);
    }
    .reveal-scale.visible {
      opacity: 1;
      transform: scale(1);
    }

    /* Stagger children */
    .stagger-children > * {
      opacity: 0;
      transform: translateY(40px);
      transition: all 0.6s var(--ease-organic);
    }
    .stagger-children.visible > *:nth-child(1) { transition-delay: 0.05s; opacity: 1; transform: translateY(0); }
    .stagger-children.visible > *:nth-child(2) { transition-delay: 0.15s; opacity: 1; transform: translateY(0); }
    .stagger-children.visible > *:nth-child(3) { transition-delay: 0.25s; opacity: 1; transform: translateY(0); }
    .stagger-children.visible > *:nth-child(4) { transition-delay: 0.35s; opacity: 1; transform: translateY(0); }
    .stagger-children.visible > *:nth-child(5) { transition-delay: 0.45s; opacity: 1; transform: translateY(0); }
    .stagger-children.visible > *:nth-child(6) { transition-delay: 0.55s; opacity: 1; transform: translateY(0); }

    /* Parallax containers */
    .parallax-section {
      position: relative;
      overflow: hidden;
    }
    .parallax-bg {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 0;
      will-change: transform;
    }
    .parallax-content {
      position: relative;
      z-index: 1;
    }

    /* Floating animations */
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-16px) rotate(6deg); }
    }
    @keyframes float-slow {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(-4deg); }
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    @keyframes shimmer {
      0% { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    @keyframes drift {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(10px, -15px); }
      50% { transform: translate(-5px, -25px); }
      75% { transform: translate(15px, -10px); }
    }

    .float-anim { animation: float 5s ease-in-out infinite; }
    .float-slow-anim { animation: float-slow 7s ease-in-out infinite; }
    .pulse-anim { animation: pulse 3s ease-in-out infinite; }

    /* ----------------------------------------------
       TYPOGRAPHY
    ------------------------------------------------ */
    .eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--secondary);
      margin-bottom: var(--space-xs);
      font-weight: 700;
      background: var(--accent);
      display: inline-block;
      padding: 0.3rem 1rem;
      border-radius: var(--radius-full);
    }
    .heading-xl {
      font-family: var(--font-display);
      font-size: clamp(3rem, 10vw, 5.5rem);
      line-height: 1.05;
      font-weight: 700;
      color: var(--text);
    }
    .heading-xl .highlight {
      color: var(--success);
      font-style: italic;
      position: relative;
    }
    .heading-xl .highlight::after {
      content: '';
      position: absolute;
      bottom: 4px;
      left: 0;
      right: 0;
      height: 6px;
      background: var(--accent);
      border-radius: 4px;
      z-index: -1;
    }
    .heading-lg {
      font-family: var(--font-display);
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      line-height: 1.15;
      font-weight: 700;
    }
    .heading-md {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      line-height: 1.25;
      font-weight: 700;
    }
    .body-large {
      font-size: 1.15rem;
      line-height: 1.7;
      color: var(--secondary);
      font-weight: 400;
    }

    /* ----------------------------------------------
       BUTTONS
    ------------------------------------------------ */
    .primary-action {
      background: var(--success);
      color: var(--heading);
      padding: 0.9rem 2.8rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 1rem;
      transition: all 0.3s var(--ease-organic);
      letter-spacing: 0.02em;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 30px rgba(214, 140, 92, 0.3);
    }
    .primary-action:hover {
      background: var(--primary);
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 12px 40px rgba(214, 140, 92, 0.4);
    }
    .secondary-action {
      color: var(--text);
      font-weight: 600;
      padding: 0.8rem 2rem;
      border: 2px solid var(--accent);
      border-radius: var(--radius-full);
      transition: all 0.3s var(--ease-soft);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--heading);
    }
    .secondary-action:hover {
      border-color: var(--success);
      color: var(--success);
      transform: translateY(-2px);
    }

    /* ----------------------------------------------
       NAVIGATION
    ------------------------------------------------ */
    .site-header {
      /* position: fixed;
      top: 0;
      left: 0;
      right: 0; */
      z-index: 1000;
      background: rgba(253, 248, 243, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--accent);
      transition: all 0.3s ease;
    }
    .site-header.scrolled {
      box-shadow: 0 4px 30px rgba(0,0,0,0.04);
    }
    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
      padding: 0 var(--space-md);
      max-width: 1200px;
      margin: 0 auto;
    }
    .logo {
      font-family: var(--font-display);
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text);
      letter-spacing: -0.02em;
    }
    .logo span { color: var(--success); font-style: italic; }
    .logo i { color: var(--success); margin-right: 6px; }

    .nav-links-desktop {
      display: none;
      align-items: center;
      gap: var(--space-md);
    }
    .nav-links-desktop a {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--secondary);
      transition: color 0.3s;
      position: relative;
    }
    .nav-links-desktop a::after {
      content: '';
      position: absolute;
      bottom: -4px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--success);
      transition: width 0.3s var(--ease-soft);
    }
    .nav-links-desktop a:hover::after { width: 100%; }
    .nav-links-desktop a:hover { color: var(--text); }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
    }
    .nav-actions .cart-icon-btn {
      font-size: 1.2rem;
      padding: 0.3rem 0.5rem;
      color: var(--secondary);
      transition: color 0.3s;
      position: relative;
    }
    .nav-actions .cart-icon-btn:hover { color: var(--text); }
    .nav-actions .cart-badge {
      position: absolute;
      top: -4px;
      right: -4px;
      background: var(--success);
      color: var(--heading);
      border-radius: 50%;
      font-size: 0.6rem;
      font-weight: 700;
      min-width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 4px;
    }
    .nav-actions .primary-action-small {
      background: var(--success);
      color: var(--heading);
      padding: 0.5rem 1.4rem;
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 700;
      transition: all 0.3s var(--ease-organic);
      display: none;
      align-items: center;
      gap: 6px;
    }
    .nav-actions .primary-action-small:hover {
      background: var(--primary);
      transform: scale(1.04);
    }
    .hamburger {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 0.4rem;
    }
    .hamburger span {
      display: block;
      width: 24px;
      height: 2.5px;
      background: var(--text);
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    /* Mobile Nav */
    .mobile-nav-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background: rgba(45, 31, 20, 0.4);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0s 0.3s;
      z-index: 1100;
    }
    .mobile-nav-overlay.open { opacity: 1; visibility: visible; transition: opacity 0.3s ease, visibility 0s 0s; }
    .mobile-nav-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 320px;
      max-width: 80vw;
      height: 100vh;
      background: var(--heading);
      z-index: 1200;
      padding: var(--space-md);
      box-shadow: -8px 0 40px rgba(0,0,0,0.06);
      transition: right 0.4s var(--ease-organic);
      display: flex;
      flex-direction: column;
    }
    .mobile-nav-drawer.open { right: 0; }
    .mobile-nav-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--accent);
    }
    .mobile-nav-close {
      font-size: 1.6rem;
      padding: 0.2rem 0.6rem;
      color: var(--secondary);
    }
    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
      margin-top: var(--space-md);
      flex: 1;
    }
    .mobile-nav-links a {
      font-size: 1.1rem;
      font-weight: 600;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--accent);
      color: var(--text);
    }
    .mobile-nav-actions {
      margin-top: auto;
      padding-top: var(--space-md);
      border-top: 1px solid var(--accent);
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }
    .mobile-nav-actions .mobile-cart-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.5rem 0;
      font-size: 1rem;
      font-weight: 600;
    }
    .mobile-nav-actions .cart-badge-mobile {
      background: var(--success);
      color: var(--heading);
      border-radius: 50%;
      padding: 0 8px;
      font-size: 0.7rem;
      min-width: 20px;
      height: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .mobile-nav-actions .primary-action-full {
      background: var(--success);
      color: var(--heading);
      padding: 0.9rem;
      text-align: center;
      border-radius: var(--radius-full);
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    /* ----------------------------------------------
       HERO — Parallax & Animations
    ------------------------------------------------ */
    #hero {
      padding-top: 72px;
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      background: linear-gradient(180deg, var(--background) 0%, #f8efe6 100%);
    }
    #hero::before {
      content: '';
      position: absolute;
      top: -30%;
      right: -20%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(214, 140, 92, 0.08) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      animation: drift 20s ease-in-out infinite;
    }
    #hero::after {
      content: '';
      position: absolute;
      bottom: -20%;
      left: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(181, 184, 163, 0.1) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
      animation: drift 25s ease-in-out infinite reverse;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      width: 100%;
      padding: var(--space-md) 0;
      position: relative;
      z-index: 1;
    }

    .hero-image {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: var(--warning);
      box-shadow: 0 20px 60px rgba(150, 120, 90, 0.15);
    }
    .hero-image img {
      width: 100%;
      height: auto;
      max-height: 65vh;
      object-fit: cover;
      display: block;
      transition: transform 8s ease;
    }
    .hero-image:hover img {
      transform: scale(1.03);
    }
    .hero-image .badge-paw {
      position: absolute;
      bottom: 20px;
      right: 20px;
      background: rgba(255,255,255,0.9);
      backdrop-filter: blur(8px);
      padding: 0.6rem 1.2rem;
      border-radius: var(--radius-full);
      font-weight: 600;
      font-size: 0.8rem;
      color: var(--text);
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .hero-image .badge-paw i { color: var(--success); }
    .hero-image .floating-bone {
      position: absolute;
      top: 20px;
      left: 20px;
      font-size: 2.4rem;
      opacity: 0.6;
      animation: float 5s ease-in-out infinite;
    }
    .hero-image .floating-paw {
      position: absolute;
      bottom: 80px;
      left: 30px;
      font-size: 2rem;
      opacity: 0.4;
      animation: float-slow 7s ease-in-out infinite;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }
    .hero-content .heading-xl .highlight {
      display: inline-block;
      animation: pulse 4s ease-in-out infinite;
    }

    .hero-rating {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
      font-size: 0.9rem;
      color: var(--secondary);
    }
    .hero-rating i { color: #f4b942; letter-spacing: 2px; }

    .hero-cta-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-sm);
      margin-top: var(--space-xs);
    }

    .hero-reassurance {
      display: flex;
      gap: var(--space-md);
      flex-wrap: wrap;
      font-size: 0.85rem;
      color: var(--secondary);
      margin-top: var(--space-xs);
      background: var(--heading);
      padding: var(--space-sm) var(--space-md);
      border-radius: var(--radius-full);
      box-shadow: 0 4px 20px var(--color-warm-shadow);
    }
    .hero-reassurance span { display: flex; align-items: center; gap: 6px; }
    .hero-reassurance i { color: var(--success); }

    /* ----------------------------------------------
       TRUST BAR — Animated
    ------------------------------------------------ */
    .trust-bar {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-sm);
      padding: var(--space-md) 0;
      background: var(--heading);
      border-radius: var(--radius-lg);
      margin: var(--space-md) 0;
      box-shadow: 0 4px 30px var(--color-warm-shadow);
    }
    .trust-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 4px;
      padding: var(--space-xs);
    }
    .trust-item .icon-wrap {
      width: 56px;
      height: 56px;
      background: var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      color: var(--success);
      margin-bottom: 4px;
      transition: all 0.5s var(--ease-organic);
    }
    .trust-item:hover .icon-wrap {
      transform: scale(1.1) rotate(8deg);
      background: var(--success);
      color: var(--heading);
    }
    .trust-item strong { font-size: 0.9rem; font-weight: 700; }
    .trust-item span { font-size: 0.8rem; color: var(--secondary); }

    /* ----------------------------------------------
       PRODUCT SECTION
    ------------------------------------------------ */
    #product {
      padding: var(--space-xl) 0;
      background: var(--background);
    }

    .product-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      align-items: start;
    }

    .product-gallery {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background: var(--warning);
      box-shadow: 0 8px 40px var(--color-warm-shadow);
    }
    .product-gallery #mainProductImage {
      width: 100%;
      height: auto;
      max-height: 60vh;
      object-fit: cover;
      display: block;
      transition: opacity 0.4s ease, transform 8s ease;
    }
    .product-gallery:hover #mainProductImage {
      transform: scale(1.02);
    }

    .thumbnail-strip {
      display: flex;
      gap: var(--space-xs);
      margin-top: var(--space-xs);
      overflow-x: auto;
      padding: 4px;
    }
    .thumbnail-strip img {
      width: 64px;
      height: 64px;
      object-fit: cover;
      border-radius: var(--radius-sm);
      border: 3px solid transparent;
      cursor: pointer;
      transition: all 0.3s ease;
      flex-shrink: 0;
    }
    .thumbnail-strip img.active {
      border-color: var(--success);
      box-shadow: 0 0 0 4px var(--accent);
    }
    .thumbnail-strip img:hover { transform: scale(1.05); }

    .product-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }
    .product-info .product-title {
      font-family: var(--font-display);
      font-size: 2rem;
      font-weight: 700;
    }
    .product-info .product-price {
      font-family: var(--font-display);
      font-size: 2.2rem;
      color: var(--success);
    }

    .purchase-card {
      background: var(--heading);
      padding: var(--space-md);
      border-radius: var(--radius-md);
      border: 1px solid var(--accent);
      box-shadow: 0 8px 30px var(--color-warm-shadow);
      margin-top: var(--space-xs);
      transition: all 0.3s var(--ease-organic);
    }
    .purchase-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px var(--color-warm-shadow);
    }

    .purchase-options {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
      margin: var(--space-sm) 0;
    }
    .option-group label {
      display: block;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--secondary);
    }

    .size-selector {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .size-selector button {
      padding: 0.4rem 1rem;
      border: 2px solid var(--accent);
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 600;
      transition: all 0.3s ease;
      background: var(--heading);
    }
    .size-selector button.active {
      background: var(--success);
      color: var(--heading);
      border-color: var(--success);
      transform: scale(1.05);
    }
    .size-selector button:hover { border-color: var(--success); transform: scale(1.02); }

    .flavor-selector {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .flavor-selector button {
      padding: 0.4rem 1.2rem;
      border: 2px solid var(--accent);
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 600;
      transition: all 0.3s ease;
      background: var(--heading);
    }
    .flavor-selector button.active {
      background: var(--success);
      color: var(--heading);
      border-color: var(--success);
      transform: scale(1.05);
    }
    .flavor-selector button:hover { border-color: var(--success); transform: scale(1.02); }

    .action-row {
      display: flex;
      gap: var(--space-sm);
      margin-top: var(--space-sm);
      flex-wrap: wrap;
    }
    .quantity-selector {
      display: flex;
      align-items: center;
      border: 2px solid var(--accent);
      border-radius: var(--radius-full);
      overflow: hidden;
    }
    .quantity-selector button {
      padding: 0.4rem 1.2rem;
      font-size: 1.2rem;
      background: transparent;
      transition: background 0.3s;
      font-weight: 600;
    }
    .quantity-selector button:hover { background: var(--accent); }
    .quantity-selector span {
      padding: 0.4rem 1.2rem;
      min-width: 40px;
      text-align: center;
      font-weight: 700;
    }

    .btn-add-to-cart {
      background: var(--text);
      color: var(--heading);
      padding: 0.7rem 2rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      transition: all 0.3s var(--ease-organic);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex: 1;
    }
    .btn-add-to-cart:hover { background: var(--success); transform: scale(1.02) translateY(-2px); }

    .btn-buy-now {
      background: var(--success);
      color: var(--heading);
      padding: 0.7rem 2rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      transition: all 0.3s var(--ease-organic);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex: 1;
    }
    .btn-buy-now:hover { background: var(--primary); transform: scale(1.02) translateY(-2px); }

    /* ----------------------------------------------
       STORY SECTION — Parallax
    ------------------------------------------------ */
    #story {
      padding: var(--space-xl) 0;
      background: var(--heading);
      position: relative;
      overflow: hidden;
    }
    #story::before {
      content: '🐾';
      position: absolute;
      top: 20px;
      right: 40px;
      font-size: 8rem;
      opacity: 0.05;
      transform: rotate(20deg);
      animation: float-slow 10s ease-in-out infinite;
    }
    .story-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      align-items: center;
    }
    .story-image {
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 12px 50px var(--color-warm-shadow);
      position: relative;
    }
    .story-image img {
      width: 100%;
      height: auto;
      display: block;
      transition: transform 8s ease;
    }
    .story-image:hover img { transform: scale(1.03); }
    .story-image .heart-overlay {
      position: absolute;
      bottom: 20px;
      left: 20px;
      background: rgba(255,255,255,0.92);
      backdrop-filter: blur(8px);
      padding: 0.6rem 1.2rem;
      border-radius: var(--radius-full);
      font-weight: 600;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
      animation: pulse 3s ease-in-out infinite;
    }
    .story-image .heart-overlay i { color: #e74c6f; }

    .story-text .story-quote {
      font-family: var(--font-display);
      font-size: 1.8rem;
      font-style: italic;
      color: var(--text);
      line-height: 1.4;
      padding-left: var(--space-md);
      border-left: 4px solid var(--success);
    }

    /* ----------------------------------------------
       FEATURES
    ------------------------------------------------ */
    #features {
      padding: var(--space-xl) 0;
      background: var(--background);
    }
    .features-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }
    .feature-card {
      background: var(--heading);
      padding: var(--space-md);
      border-radius: var(--radius-md);
      border: 1px solid var(--accent);
      text-align: center;
      transition: all 0.3s var(--ease-organic);
      box-shadow: 0 4px 20px var(--color-warm-shadow);
    }
    .feature-card:hover {
      transform: translateY(-8px) scale(1.02);
      box-shadow: 0 16px 50px var(--color-warm-shadow);
    }
    .feature-card .feature-icon {
      font-size: 2.8rem;
      margin-bottom: var(--space-xs);
      display: block;
      transition: transform 0.5s var(--ease-organic);
    }
    .feature-card:hover .feature-icon { transform: scale(1.2) rotate(8deg); }
    .feature-card h4 { font-weight: 700; margin-bottom: 4px; }
    .feature-card p { font-size: 0.85rem; color: var(--secondary); }

    /* ----------------------------------------------
       COMMUNITY
    ------------------------------------------------ */
    #community {
      padding: var(--space-xl) 0;
      background: var(--heading);
    }
    .community-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
      margin-top: var(--space-md);
    }
    .community-card {
      border-radius: var(--radius-md);
      overflow: hidden;
      position: relative;
      aspect-ratio: 1/1;
      background: var(--warning);
      box-shadow: 0 4px 20px var(--color-warm-shadow);
      transition: all 0.4s var(--ease-organic);
    }
    .community-card:hover {
      transform: scale(1.03) translateY(-4px);
      box-shadow: 0 12px 40px var(--color-warm-shadow);
    }
    .community-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 6s ease;
    }
    .community-card:hover img { transform: scale(1.05); }
    .community-card .community-overlay {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: var(--space-sm);
      background: linear-gradient(transparent, rgba(0,0,0,0.5));
      color: white;
    }
    .community-card .community-overlay .verified { color: #7bed9f; font-weight: 600; }
    .community-card .community-overlay .username { font-weight: 600; }
    .community-card:nth-child(1) { grid-column: span 2; aspect-ratio: 2/1; }

    /* ----------------------------------------------
       REVIEWS
    ------------------------------------------------ */
    #reviews {
      padding: var(--space-xl) 0;
      background: var(--background);
    }
    .review-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-md);
      margin-top: var(--space-md);
    }
    .review-card {
      background: var(--heading);
      padding: var(--space-md);
      border-radius: var(--radius-md);
      border: 1px solid var(--accent);
      box-shadow: 0 4px 20px var(--color-warm-shadow);
      transition: all 0.4s var(--ease-organic);
    }
    .review-card:hover {
      transform: translateY(-6px) scale(1.01);
      box-shadow: 0 12px 40px var(--color-warm-shadow);
    }
    .review-card .stars { color: #f4b942; letter-spacing: 2px; }
    .review-card .review-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--secondary);
      margin-top: 6px;
    }
    .review-card .review-emoji { font-size: 1.8rem; margin-right: 8px; float: left; }

    /* ----------------------------------------------
       FAQ
    ------------------------------------------------ */
    #faq {
      padding: var(--space-xl) 0;
      background: var(--heading);
    }
    .faq-item {
      border-bottom: 1px solid var(--accent);
      padding: var(--space-sm) 0;
    }
    .faq-question {
      display: flex;
      justify-content: space-between;
      font-weight: 700;
      cursor: pointer;
      padding: 6px 0;
      font-size: 1.05rem;
      transition: color 0.3s;
    }
    .faq-question:hover { color: var(--success); }
    .faq-question i { transition: transform 0.4s var(--ease-soft); }
    .faq-question.open i { transform: rotate(180deg); }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease, padding 0.3s ease;
      padding: 0;
      color: var(--secondary);
      font-size: 0.95rem;
    }
    .faq-answer.open { max-height: 200px; padding-top: var(--space-xs); }

    /* ----------------------------------------------
       FINAL CTA
    ------------------------------------------------ */
    .final-cta {
      background: var(--text);
      color: var(--heading);
      padding: var(--space-xl) var(--space-md);
      text-align: center;
      border-radius: var(--radius-lg);
      margin-top: var(--space-lg);
      position: relative;
      overflow: hidden;
    }
    .final-cta::before {
      content: '🐶🐱🐾';
      position: absolute;
      top: -20px;
      right: -20px;
      font-size: 8rem;
      opacity: 0.05;
      animation: float-slow 12s ease-in-out infinite;
    }
    .final-cta .heading-lg { color: var(--heading); }
    .final-cta .primary-action {
      background: var(--heading);
      color: var(--text);
      margin-top: var(--space-sm);
      display: inline-flex;
      box-shadow: 0 8px 30px rgba(255,255,255,0.2);
    }
    .final-cta .primary-action:hover {
      background: var(--accent);
      color: var(--text);
    }

    /* ----------------------------------------------
       CONTACT
    ------------------------------------------------ */
    #contact {
      padding: var(--space-xl) 0;
      background: var(--background);
    }
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .contact-form-wrapper {
      background: var(--heading);
      padding: var(--space-md);
      border-radius: var(--radius-md);
      border: 1px solid var(--accent);
      box-shadow: 0 8px 30px var(--color-warm-shadow);
    }
    .contact-form-wrapper .form-group { margin-bottom: var(--space-sm); }
    .contact-form-wrapper label {
      display: block;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 4px;
      color: var(--secondary);
    }
    .contact-form-wrapper input,
    .contact-form-wrapper textarea {
      width: 100%;
      padding: 0.8rem 1.2rem;
      border: 2px solid var(--accent);
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: 0.95rem;
      background: var(--background);
      transition: all 0.3s ease;
    }
    .contact-form-wrapper input:focus,
    .contact-form-wrapper textarea:focus {
      outline: none;
      border-color: var(--success);
      box-shadow: 0 0 0 4px var(--accent);
      transform: scale(1.01);
    }
    .contact-form-wrapper textarea { min-height: 120px; resize: vertical; }
    .contact-form-wrapper .form-row {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
    .contact-form-wrapper .submit-action {
      background: var(--success);
      color: var(--heading);
      padding: 0.9rem 2.4rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 1rem;
      transition: all 0.3s var(--ease-organic);
      width: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .contact-form-wrapper .submit-action:hover {
      background: var(--primary);
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(214, 140, 92, 0.3);
    }

    .contact-info {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }
    .contact-info .contact-detail {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      font-size: 0.95rem;
      color: var(--secondary);
    }
    .contact-info .contact-detail i {
      width: 28px;
      color: var(--success);
      font-size: 1.2rem;
    }

    /* ----------------------------------------------
       FOOTER
    ------------------------------------------------ */
    .site-footer {
      padding: var(--space-lg) 0 var(--space-md);
      background: var(--text);
      color: var(--heading);
    }
    .site-footer .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }
    .site-footer .footer-col h4 {
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: var(--space-xs);
      color: var(--heading);
    }
    .site-footer .footer-col a {
      display: block;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.6);
      padding: 4px 0;
      transition: color 0.3s;
    }
    .site-footer .footer-col a:hover { color: var(--heading); transform: translateX(4px); }
    .site-footer .footer-bottom {
      text-align: center;
      margin-top: var(--space-lg);
      font-size: 0.8rem;
      color: rgba(255,255,255,0.4);
      border-top: 1px solid rgba(255,255,255,0.06);
      padding-top: var(--space-md);
    }
    .site-footer .logo-footer {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 700;
    }
    .site-footer .logo-footer span { color: var(--success); font-style: italic; }

    /* ----------------------------------------------
       STICKY BAR
    ------------------------------------------------ */
    .sticky-purchase {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--heading);
      border-top: 1px solid var(--accent);
      padding: 0.6rem var(--space-md);
      display: flex;
      align-items: center;
      justify-content: space-between;
      z-index: 900;
      transform: translateY(100%);
      transition: transform 0.4s var(--ease-organic);
      box-shadow: 0 -4px 30px rgba(0,0,0,0.06);
    }
    .sticky-purchase.visible { transform: translateY(0); }
    .sticky-purchase .sticky-info {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      font-size: 0.9rem;
    }
    .sticky-purchase .sticky-info strong { font-weight: 700; }
    .sticky-purchase .sticky-actions { display: flex; gap: var(--space-xs); }
    .sticky-purchase .sticky-btn-cart {
      background: var(--text);
      color: var(--heading);
      padding: 0.5rem 1.2rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.8rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .sticky-purchase .sticky-btn-buy {
      background: var(--success);
      color: var(--heading);
      padding: 0.5rem 1.2rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.8rem;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* ----------------------------------------------
       MODALS
    ------------------------------------------------ */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.6);
      backdrop-filter: blur(8px);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s, visibility 0s 0.3s;
      padding: var(--space-md);
    }
    .modal-overlay.open {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.3s, visibility 0s 0s;
    }
    .modal-content {
      position: relative;
      width: 100%;
      max-width: 800px;
      background: var(--heading);
      border-radius: var(--radius-md);
      overflow: hidden;
      aspect-ratio: 16/9;
      transform: scale(0.9);
      transition: transform 0.4s var(--ease-organic);
    }
    .modal-overlay.open .modal-content { transform: scale(1); }
    .modal-content iframe { width: 100%; height: 100%; border: none; }
    .modal-close {
      position: absolute;
      top: 12px;
      right: 16px;
      font-size: 2rem;
      color: white;
      background: rgba(0,0,0,0.5);
      border: none;
      border-radius: 50%;
      width: 44px;
      height: 44px;
      cursor: pointer;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.3s, transform 0.3s;
    }
    .modal-close:hover { background: rgba(0,0,0,0.7); transform: scale(1.1); }

    /* Image viewer */
    #imageViewer .modal-content {
      background: transparent;
      aspect-ratio: auto;
      max-width: 90vw;
      max-height: 90vh;
    }
    #imageViewer img {
      width: auto;
      height: auto;
      max-width: 90vw;
      max-height: 90vh;
      border-radius: var(--radius-md);
      object-fit: contain;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }

    /* ----------------------------------------------
       TOAST
    ------------------------------------------------ */
    .toast {
      position: fixed;
      bottom: 80px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--text);
      color: white;
      padding: 0.8rem 2rem;
      border-radius: var(--radius-full);
      font-weight: 600;
      opacity: 0;
      transition: opacity 0.4s ease, transform 0.4s ease;
      z-index: 1800;
      pointer-events: none;
      box-shadow: 0 8px 30px rgba(0,0,0,0.2);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
    .toast i { color: var(--success); }

    /* ----------------------------------------------
       CART DRAWER
    ------------------------------------------------ */
    .cart-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.25);
      z-index: 1500;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s, visibility 0s 0.3s;
    }
    .cart-overlay.open {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.3s, visibility 0s 0s;
    }
    .cart-drawer {
      position: fixed;
      top: 0;
      right: -420px;
      width: 380px;
      max-width: 90vw;
      height: 100%;
      background: var(--heading);
      z-index: 1600;
      padding: var(--space-md);
      box-shadow: -8px 0 40px rgba(0,0,0,0.06);
      transition: right 0.4s var(--ease-organic);
      display: flex;
      flex-direction: column;
    }
    .cart-drawer.open { right: 0; }
    .cart-drawer-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--accent);
      padding-bottom: var(--space-sm);
    }
    .cart-drawer-items {
      flex: 1;
      overflow-y: auto;
      padding: var(--space-sm) 0;
    }
    .cart-empty-state {
      text-align: center;
      padding: var(--space-lg) 0;
      color: var(--secondary);
    }
    .cart-empty-state i {
      font-size: 3rem;
      color: var(--accent);
      margin-bottom: var(--space-sm);
    }
    .cart-item {
      display: flex;
      gap: var(--space-sm);
      padding: var(--space-sm) 0;
      border-bottom: 1px solid var(--accent);
    }
    .cart-item img {
      width: 60px;
      height: 60px;
      object-fit: cover;
      border-radius: var(--radius-sm);
    }
    .cart-item-details { flex: 1; }
    .cart-item-details h4 { font-weight: 700; font-size: 0.95rem; }
    .cart-item-details p { font-size: 0.8rem; color: var(--secondary); }
    .cart-item-remove { color: var(--secondary); align-self: center; padding: 4px 8px; }
    .cart-item-remove:hover { color: var(--success); transform: scale(1.2); }
    .cart-drawer-footer {
      border-top: 1px solid var(--accent);
      padding-top: var(--space-sm);
    }
    .cart-total-row {
      display: flex;
      justify-content: space-between;
      font-weight: 700;
      margin: var(--space-xs) 0;
    }
    .checkout-action {
      width: 100%;
      background: var(--success);
      color: white;
      padding: 0.9rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      margin-top: var(--space-xs);
      text-align: center;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.3s;
    }
    .checkout-action:hover { background: var(--primary); transform: scale(1.02); }

    /* ----------------------------------------------
       RESPONSIVE
    ------------------------------------------------ */
    @media (min-width: 768px) {
      .hero-grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); align-items: center; }
      .product-grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
      .story-grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
      .contact-grid { grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
      .contact-form-wrapper .form-row { grid-template-columns: 1fr 1fr; }
      .features-grid { grid-template-columns: repeat(4, 1fr); }
      .community-grid { grid-template-columns: 1fr 1fr 1fr; }
      .community-card:nth-child(1) { grid-column: span 2; aspect-ratio: 2/1; }
      .review-grid { grid-template-columns: 1fr 1fr 1fr; }
      .trust-bar { grid-template-columns: repeat(4, 1fr); }
      .nav-links-desktop { display: flex; }
      .nav-actions .primary-action-small { display: inline-flex; }
      .hamburger { display: none; }
      .site-footer .footer-grid { grid-template-columns: repeat(4, 1fr); }
    }

    @media (max-width: 480px) {
      .hero-content .heading-xl { font-size: 2.6rem; }
      .purchase-options { flex-direction: column; }
      .action-row { flex-direction: column; }
      .btn-add-to-cart, .btn-buy-now { width: 100%; }
      .sticky-purchase .sticky-info span { display: none; }
      .features-grid { grid-template-columns: 1fr 1fr; }
      .community-grid { grid-template-columns: 1fr 1fr; }
      .community-card:nth-child(1) { grid-column: span 2; aspect-ratio: 1/1; }
    }
  </style>
</head>
<body>

  <!-- Toast -->
  <div id="toast" class="toast"><i class="fas fa-heart"></i> Added to your cart! 🐾</div>

  <!-- Video Modal -->
  <div id="videoModal" class="modal-overlay">
    <div class="modal-content">
      <button class="modal-close" id="closeVideo">&times;</button>
