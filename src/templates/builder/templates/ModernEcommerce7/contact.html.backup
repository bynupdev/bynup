<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Luxe Essence</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #1A3D63;
            --secondary: #4A7FA7;
            --accent: #B3CFE5;
            --highlight: #6A1931;
            --light: #F6FAFD;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--primary);
            background-color: var(--light);
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Contact Header */
        .contact-header {
            padding: 100px 0 60px;
            background: linear-gradient(135deg, var(--light) 0%, rgba(179, 207, 229, 0.1) 100%);
            text-align: center;
        }

        .contact-title {
            font-size: 42px;
            color: var(--primary);
            margin-bottom: 20px;
        }

        .contact-subtitle {
            font-size: 18px;
            color: var(--secondary);
            max-width: 700px;
            margin: 0 auto;
        }

        /* Contact Content */
        .contact-content {
            padding: 60px 0 80px;
        }

        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: start;
        }

        /* Contact Info */
        .contact-info {
            background: white;
            border-radius: 10px;
            padding: 40px;
            box-shadow: 0 5px 20px rgba(26, 61, 99, 0.08);
        }

        .info-title {
            font-size: 28px;
            color: var(--primary);
            margin-bottom: 30px;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid rgba(179, 207, 229, 0.5);
        }

        .info-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .info-icon {
            width: 50px;
            height: 50px;
            background: var(--light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 20px;
            flex-shrink: 0;
        }

        .info-icon i {
            font-size: 20px;
            color: var(--highlight);
        }

        .info-content h4 {
            font-size: 18px;
            color: var(--primary);
            margin-bottom: 8px;
        }

        .info-content p {
            color: var(--secondary);
            line-height: 1.7;
        }

        /* Business Hours */
        .business-hours {
            margin-top: 40px;
            padding-top: 30px;
            border-top: 1px solid rgba(179, 207, 229, 0.5);
        }

        .hours-title {
            font-size: 20px;
            color: var(--primary);
            margin-bottom: 20px;
        }

        .hours-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px dashed rgba(179, 207, 229, 0.3);
        }

        .hours-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .day {
            color: var(--primary);
            font-weight: 500;
        }

        .time {
            color: var(--secondary);
        }

        /* Contact Form */
        .contact-form {
            background: white;
            border-radius: 10px;
            padding: 40px;
            box-shadow: 0 5px 20px rgba(26, 61, 99, 0.08);
        }

        .form-title {
            font-size: 28px;
            color: var(--primary);
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--primary);
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid var(--accent);
            border-radius: 8px;
            font-family: 'Montserrat', sans-serif;
            font-size: 16px;
            color: var(--primary);
            transition: border-color 0.3s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--secondary);
        }

        textarea.form-control {
            min-height: 150px;
            resize: vertical;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .submit-btn {
            background-color: var(--highlight);
            color: white;
            border: none;
            padding: 14px 35px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .submit-btn:hover {
            background-color: #4A0A20;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(106, 25, 49, 0.3);
        }

        /* FAQ Section */
        .faq-section {
            padding: 80px 0;
            background-color: white;
        }

        .section-title {
            font-size: 32px;
            text-align: center;
            color: var(--primary);
            margin-bottom: 50px;
        }

        .faq-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .faq-item {
            margin-bottom: 20px;
            border: 1px solid rgba(179, 207, 229, 0.5);
            border-radius: 10px;
            overflow: hidden;
            transition: all 0.3s;
        }

        .faq-item.active {
            box-shadow: 0 5px 15px rgba(26, 61, 99, 0.08);
        }

        .faq-question {
            padding: 25px 30px;
            background: var(--light);
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .faq-question:hover {
            background-color: rgba(179, 207, 229, 0.2);
        }

        .faq-question h3 {
            font-size: 18px;
            color: var(--primary);
            font-weight: 500;
        }

        .faq-icon {
            color: var(--highlight);
            font-size: 18px;
            transition: transform 0.3s;
        }

        .faq-item.active .faq-icon {
            transform: rotate(45deg);
        }

        .faq-answer {
            padding: 0 30px 25px 30px;
            max-height: 500px;
            overflow: hidden;
            transition: max-height 0.3s ease, padding 0.3s ease;
        }

        .faq-item.active .faq-answer {
            padding: 0 30px 25px 30px;
            max-height: 500px;
        }

        .faq-answer p {
            color: var(--secondary);
            line-height: 1.7;
        }

        /* Store Locations */
        .store-locations {
            padding: 80px 0;
        }

        .locations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .location-card {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(26, 61, 99, 0.08);
            transition: all 0.3s;
        }

        .location-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(26, 61, 99, 0.15);
        }

        .location-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .location-info {
            padding: 30px;
        }

        .location-name {
            font-size: 22px;
            color: var(--primary);
            margin-bottom: 15px;
        }

        .location-details {
            color: var(--secondary);
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .location-contact {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(179, 207, 229, 0.5);
        }

        .contact-detail {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            color: var(--secondary);
        }

        .contact-detail i {
            color: var(--highlight);
            margin-right: 10px;
            width: 20px;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .contact-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .locations-grid {
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }

        @media (max-width: 768px) {
            .contact-title {
                font-size: 36px;
            }
            
            .section-title {
                font-size: 28px;
            }
            
            .contact-info,
            .contact-form {
                padding: 30px;
            }
            
            .locations-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 576px) {
            .contact-header {
                padding: 80px 0 40px;
            }
            
            .contact-content,
            .faq-section,
            .store-locations {
                padding: 60px 0;
            }
            
            .info-item {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .info-icon {
                margin-bottom: 15px;
            }
            
            .faq-question {
                padding: 20px;
            }
            
            .faq-answer {
                padding: 0 20px;
            }
            
            .faq-item.active .faq-answer {
                padding: 0 20px 20px 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Contact Header -->
    <section class="contact-header editable-section" data-section="278">
        <div class="container">
            <h1 class="contact-title editable-text editable-section no-drop-zone" data-section="279" data-text="199">Get in Touch</h1>
            <p class="contact-subtitle editable-text editable-section no-drop-zone" data-section="280" data-text="200">We're here to help you with any questions about our luxury products, orders, or collaborations</p>
        </div>
    </section>

    <!-- Contact Content -->
    <section class="contact-content editable-section" data-section="281">
        <div class="container">
            <div class="contact-container">
                <!-- Contact Info -->
                <div class="contact-info editable-section no-drop-zone" data-section="282">
                    <h2 class="info-title editable-text editable-section no-drop-zone" data-section="283" data-text="201">Contact Information</h2>
                    
                    <div class="info-item editable-section no-drop-zone" data-section="284">
                        <div class="info-icon">
                            <i class="fas fa-map-marker-alt editable-icon" data-icon="78" data-default-class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="info-content">
                            <h4 class="editable-text editable-section no-drop-zone" data-section="285" data-text="202">Visit Our Flagship Store</h4>
                            <p class="editable-text editable-section no-drop-zone" data-section="286" data-text="203">123 Rue de la Paix, 75002 Paris, France</p>
                        </div>
                    </div>

                    <div class="info-item editable-section no-drop-zone" data-section="287">
                        <div class="info-icon">
                            <i class="fas fa-phone editable-icon" data-icon="79" data-default-class="fas fa-phone"></i>
                        </div>
                        <div class="info-content">
                            <h4 class="editable-text editable-section no-drop-zone" data-section="288" data-text="204">Call Us</h4>
                            <p class="editable-text editable-section no-drop-zone" data-section="289" data-text="205">+33 1 23 45 67 89 (International)<br>1-800-LUXE-ESS (Toll-free)</p>
                        </div>
                    </div>

                    <div class="info-item editable-section no-drop-zone" data-section="290">
                        <div class="info-icon">
                            <i class="fas fa-envelope editable-icon" data-icon="80" data-default-class="fas fa-envelope"></i>
                        </div>
                        <div class="info-content">
                            <h4 class="editable-text editable-section no-drop-zone" data-section="291" data-text="206">Email Us</h4>
                            <p class="editable-text editable-section no-drop-zone" data-section="292" data-text="207">hello@luxeessence.com (General Inquiries)<br>support@luxeessence.com (Customer Service)</p>
                        </div>
                    </div>

                    <!-- Business Hours -->
                    <div class="business-hours editable-section no-drop-zone" data-section="293">
                        <h3 class="hours-title editable-text editable-section no-drop-zone" data-section="294" data-text="208">Business Hours</h3>
                        
                        <div class="hours-item editable-section no-drop-zone" data-section="295">
                            <span class="day editable-text editable-section no-drop-zone" data-section="296" data-text="209">Monday - Friday</span>
                            <span class="time editable-text editable-section no-drop-zone" data-section="297" data-text="210">9:00 AM - 8:00 PM</span>
                        </div>
                        
                        <div class="hours-item editable-section no-drop-zone" data-section="298">
                            <span class="day editable-text editable-section no-drop-zone" data-section="299" data-text="211">Saturday</span>
                            <span class="time editable-text editable-section no-drop-zone" data-section="300" data-text="212">10:00 AM - 6:00 PM</span>
                        </div>
                        
                        <div class="hours-item editable-section no-drop-zone" data-section="301">
                            <span class="day editable-text editable-section no-drop-zone" data-section="302" data-text="213">Sunday</span>
                            <span class="time editable-text editable-section no-drop-zone" data-section="303" data-text="214">11:00 AM - 5:00 PM</span>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form editable-section no-drop-zone" data-section="304">
                    <h2 class="form-title editable-text editable-section no-drop-zone" data-section="305" data-text="215">Send Us a Message</h2>
                    
                    <form id="contactForm">
                        <div class="form-row">
                            <div class="form-group editable-section no-drop-zone" data-section="306">
                                <label class="editable-text editable-section no-drop-zone" data-section="307" data-text="216">First Name</label>
                                <input type="text" class="form-control editable-section no-drop-zone" data-section="308" placeholder="Enter your first name" required>
                            </div>
                            
                            <div class="form-group editable-section no-drop-zone" data-section="309">
                                <label class="editable-text editable-section no-drop-zone" data-section="310" data-text="217">Last Name</label>
                                <input type="text" class="form-control editable-section no-drop-zone" data-section="311" placeholder="Enter your last name" required>
                            </div>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="312">
                            <label class="editable-text editable-section no-drop-zone" data-section="313" data-text="218">Email Address</label>
                            <input type="email" class="form-control editable-section no-drop-zone" data-section="314" placeholder="Enter your email address" required>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="315">
                            <label class="editable-text editable-section no-drop-zone" data-section="316" data-text="219">Phone Number</label>
                            <input type="tel" class="form-control editable-section no-drop-zone" data-section="317" placeholder="Enter your phone number">
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="318">
                            <label class="editable-text editable-section no-drop-zone" data-section="319" data-text="220">Subject</label>
                            <select class="form-control editable-section no-drop-zone" data-section="320">
                                <option>General Inquiry</option>
                                <option>Product Questions</option>
                                <option>Order Support</option>
                                <option>Wholesale Inquiry</option>
                                <option>Press & Media</option>
                                <option>Other</option>
                            </select>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="321">
                            <label class="editable-text editable-section no-drop-zone" data-section="322" data-text="221">Message</label>
                            <textarea class="form-control editable-section no-drop-zone" data-section="323" placeholder="How can we help you today?" rows="5" required></textarea>
                        </div>
                        
                        <button type="submit" class="submit-btn editable-text editable-section no-drop-zone" data-section="324" data-text="222">
                            <i class="fas fa-paper-plane editable-icon" data-icon="81" data-default-class="fas fa-paper-plane"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section editable-section" data-section="325">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="326" data-text="223">Frequently Asked Questions</h2>
            
            <div class="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item editable-section no-drop-zone" data-section="327">
                    <div class="faq-question" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="328" data-text="224">What is your return and exchange policy?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-plus editable-icon" data-icon="82" data-default-class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="329" data-text="225">We offer a 30-day return policy for all unused and unopened products in their original packaging. For exchanges, we provide free return shipping within 60 days of purchase. Personalized items and limited edition collections may have different return conditions.</p>
                    </div>
                </div>

                <!-- FAQ 2 -->
                <div class="faq-item editable-section no-drop-zone" data-section="330">
                    <div class="faq-question" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="331" data-text="226">How long does shipping take?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-plus editable-icon" data-icon="82" data-default-class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="332" data-text="227">Standard shipping takes 5-7 business days within the US and 10-14 business days internationally. Express shipping is available for 2-3 business days domestically and 5-7 business days internationally. All orders are processed within 1-2 business days.</p>
                    </div>
                </div>

                <!-- FAQ 3 -->
                <div class="faq-item editable-section no-drop-zone" data-section="333">
                    <div class="faq-question" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="334" data-text="228">Are your products cruelty-free and vegan?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-plus editable-icon" data-icon="82" data-default-class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="335" data-text="229">Yes, all Luxe Essence products are cruelty-free and never tested on animals. While most of our products are vegan, some may contain beeswax or honey-derived ingredients. Vegan options are clearly marked on product pages and packaging.</p>
                    </div>
                </div>

                <!-- FAQ 4 -->
                <div class="faq-item editable-section no-drop-zone" data-section="336">
                    <div class="faq-question" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="337" data-text="230">Do you offer international shipping?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-plus editable-icon" data-icon="82" data-default-class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="338" data-text="231">Yes, we ship to over 50 countries worldwide. International shipping costs and delivery times vary by destination. Customs duties and taxes may apply depending on your country's regulations and are the responsibility of the recipient.</p>
                    </div>
                </div>

                <!-- FAQ 5 -->
                <div class="faq-item editable-section no-drop-zone" data-section="339">
                    <div class="faq-question" onclick="toggleFAQ(this)">
                        <h3 class="editable-text editable-section no-drop-zone" data-section="340" data-text="232">How can I track my order?</h3>
                        <div class="faq-icon">
                            <i class="fas fa-plus editable-icon" data-icon="82" data-default-class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer">
                        <p class="editable-text editable-section no-drop-zone" data-section="341" data-text="233">Once your order ships, you'll receive a tracking number via email. You can also track your order by logging into your account on our website. For international orders, tracking may be available through our shipping partners' websites.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Store Locations -->
    <section class="store-locations editable-section" data-section="342">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="343" data-text="234">Visit Our Stores</h2>
            
            <div class="locations-grid">
                <!-- Location 1 - Paris -->
                <div class="location-card editable-section no-drop-zone" data-section="344">
                    <div class="location-image-container editable-section no-drop-zone" data-section="345">
                        <img src="https://images.unsplash.com/photo-1545235617-9465d2a55698?w=600&h=400&fit=crop" 
                             alt="Paris Flagship Store" 
                             class="location-image editable-image" 
                             data-image="84">
                    </div>
                    <div class="location-info">
                        <h3 class="location-name editable-text editable-section no-drop-zone" data-section="346" data-text="235">Paris Flagship</h3>
                        <p class="location-details editable-text editable-section no-drop-zone" data-section="347" data-text="236">Experience luxury at our flagship store in the heart of Paris, featuring our complete collection, personalized consultations, and exclusive in-store events.</p>
                        
                        <div class="location-contact">
                            <div class="contact-detail editable-text editable-section no-drop-zone" data-section="348" data-text="237">
                                <i class="fas fa-map-marker-alt editable-icon" data-icon="78" data-default-class="fas fa-map-marker-alt"></i> 123 Rue de la Paix, 75002 Paris
                            </div>
                            <div class="contact-detail editable-text editable-section no-drop-zone" data-section="349" data-text="238">
                                <i class="fas fa-phone editable-icon" data-icon="79" data-default-class="fas fa-phone"></i> +33 1 23 45 67 89
                            </div>
                            <div class="contact-detail editable-text editable-section no-drop-zone" data-section="350" data-text="239">
                                <i class="fas fa-clock editable-icon" data-icon="83" data-default-class="fas fa-clock"></i> Mon-Sat: 10AM-8PM, Sun: 11AM-6PM
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Location 2 - New York -->
                <div class="location-card editable-section no-drop-zone" data-section="351">
                    <div class="location-image-container editable-section no-drop-zone" data-section="352">
                        <img src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=600&h=400&fit=crop" 
                             alt="New York Boutique" 
                             class="location-image editable-image" 
                             data-image="85">
                    </div>
                    <div class="location-info">
