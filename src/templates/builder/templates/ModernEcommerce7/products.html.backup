<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | Luxe Essence</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #1A3D63;
            --secondary: #4A7FA7;
            --accent: #B3CFE5;
            --highlight: #6A1931;
            --light: #F6FAFD;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--primary);
            background-color: var(--light);
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Shop Header */
        .shop-header {
            padding: 120px 0 40px;
            background: linear-gradient(135deg, var(--light) 0%, rgba(179, 207, 229, 0.1) 100%);
        }

        .shop-title {
            font-size: 42px;
            color: var(--primary);
            text-align: center;
            margin-bottom: 20px;
        }

        .shop-subtitle {
            font-size: 18px;
            color: var(--secondary);
            text-align: center;
            max-width: 600px;
            margin: 0 auto 40px;
        }

        .categories-btn {
            display: block;
            width: 200px;
            margin: 30px auto 0;
            text-align: center;
            background-color: transparent;
            color: var(--primary);
            padding: 12px 30px;
            border-radius: 30px;
            text-decoration: none;
            border: 2px solid var(--primary);
            transition: all 0.3s;
            font-weight: 500;
        }

        .categories-btn:hover {
            background-color: var(--primary);
            color: white;
            transform: translateY(-3px);
        }

        /* Filter Section */
        .filter-section {
            padding: 30px 0;
            border-bottom: 1px solid rgba(26, 61, 99, 0.1);
        }

        .filter-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .filter-title {
            font-size: 18px;
            color: var(--primary);
        }

        .filter-group {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .filter-select {
            padding: 10px 20px;
            border: 1px solid var(--accent);
            border-radius: 25px;
            background-color: white;
            color: var(--primary);
            font-family: 'Montserrat', sans-serif;
            cursor: pointer;
            transition: all 0.3s;
        }

        .filter-select:hover {
            border-color: var(--secondary);
        }

        .search-box {
            padding: 10px 20px;
            border: 1px solid var(--accent);
            border-radius: 25px;
            background-color: white;
            color: var(--primary);
            width: 250px;
            font-family: 'Montserrat', sans-serif;
        }

        /* Products Grid */
        .products-section {
            padding: 60px 0 100px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }

        .product-card {
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(26, 61, 99, 0.08);
            transition: all 0.3s ease;
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(26, 61, 99, 0.15);
        }

        .product-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: var(--highlight);
            color: white;
            padding: 5px 12px;
            border-radius: 15px;
            font-size: 12px;
            font-weight: 500;
            z-index: 1;
        }

        .product-image {
            width: 100%;
            height: 300px;
            object-fit: cover;
        }

        .product-info {
            padding: 20px;
        }

        .product-category {
            font-size: 14px;
            color: var(--secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-name {
            font-size: 18px;
            color: var(--primary);
            margin-bottom: 10px;
            min-height: 50px;
        }

        .product-description {
            font-size: 14px;
            color: var(--secondary);
            margin-bottom: 15px;
            line-height: 1.5;
        }

        .product-price {
            font-size: 20px;
            color: var(--highlight);
            font-weight: 600;
            margin-bottom: 15px;
        }

        .product-actions {
            display: flex;
            gap: 10px;
        }

        .add-to-cart-btn {
            flex: 1;
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .add-to-cart-btn:hover {
            background-color: var(--highlight);
        }

        .wishlist-btn {
            background-color: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
            padding: 10px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .wishlist-btn:hover {
            background-color: var(--primary);
            color: white;
        }

        .product-rating {
            display: flex;
            align-items: center;
            margin-top: 10px;
        }

        .rating-stars {
            color: #FFD700;
            margin-right: 5px;
        }

        .rating-count {
            font-size: 14px;
            color: var(--secondary);
        }

        /* Responsive */
        @media (max-width: 768px) {
            .shop-title {
                font-size: 36px;
            }
            
            .filter-container {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .search-box {
                width: 100%;
            }
            
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            }
        }

        @media (max-width: 576px) {
            .products-grid {
                grid-template-columns: 1fr;
            }
            
            .shop-header {
                padding: 100px 0 30px;
            }
        }
    </style>
</head>
<body>
    <!-- Shop Header -->
    <section class="shop-header editable-section" data-section="41">
        <div class="container">
            <h1 class="shop-title editable-text editable-section no-drop-zone" data-section="42" data-text="31">Shop Our Collection</h1>
            <p class="shop-subtitle editable-text editable-section no-drop-zone" data-section="43" data-text="32">Discover luxury fragrances and cosmetics crafted with precision and passion</p>
            <a href="?page=categories" class="categories-btn editable-text editable-section no-drop-zone" data-section="44" data-text="33">BROWSE CATEGORIES</a>
        </div>
    </section>

    <!-- Filter Section -->
    <section class="filter-section editable-section" data-section="45">
        <div class="container">
            <div class="filter-container">
                <div class="filter-left">
                    <h3 class="filter-title editable-text editable-section no-drop-zone" data-section="46" data-text="34">Filter Products</h3>
                </div>
                <div class="filter-group">
                    <select class="filter-select editable-section no-drop-zone" data-section="47">
                        <option>All Categories</option>
                        <option>Fragrances</option>
                        <option>Cosmetics</option>
                        <option>Skincare</option>
                    </select>
                    <select class="filter-select editable-section no-drop-zone" data-section="48">
                        <option>Sort by: Featured</option>
                        <option>Price: Low to High</option>
                        <option>Price: High to Low</option>
                        <option>Newest Arrivals</option>
                    </select>
                    <input type="text" class="search-box editable-section no-drop-zone" data-section="49" placeholder="Search products..." data-text="35">
                </div>
            </div>
        </div>
    </section>

    <!-- Products Section -->
    <section class="products-section editable-section" data-section="50">
        <div class="container">
            <div class="products-grid">
                <!-- Product 1 (Editable) -->
                <div class="product-card editable-section no-drop-zone" data-section="51">
                    <div class="product-badge editable-text editable-section no-drop-zone" data-section="52" data-text="36">NEW</div>
                    <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=400&h=500&fit=crop" alt="Velvet Noir Perfume" class="product-image">
                    <div class="product-info">
                        <div class="product-category editable-section no-drop-zone" data-section="53" data-text="37">EAU DE PARFUM</div>
                        <div class="product-name editable-section no-drop-zone" data-section="54" data-text="38">Velvet Noir - 100ml</div>
                        <p class="product-description editable-section no-drop-zone" data-section="55" data-text="39">A captivating blend of dark rose, amber, and oud for an unforgettable presence.</p>
                        <div class="product-price editable-section no-drop-zone" data-section="56" data-text="40">$189.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star editable-icon" data-icon="49" data-default-class="fas fa-star"></i>
                                <i class="fas fa-star editable-icon" data-icon="49" data-default-class="fas fa-star"></i>
                                <i class="fas fa-star editable-icon" data-icon="49" data-default-class="fas fa-star"></i>
                                <i class="fas fa-star editable-icon" data-icon="49" data-default-class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt editable-icon" data-icon="49" data-default-class="fas fa-star-half-alt"></i>
                            </div>
                            <span class="rating-count">(124)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn editable-text editable-section no-drop-zone" data-section="57" data-text="41" onclick="addToCart(1)">
                                <i class="fas fa-shopping-bag editable-icon" data-icon="4" data-default-class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(1)">
                                <i class="fas fa-heart editable-icon" data-icon="3" data-default-class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Product 2 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1522338242990-c0f7938f8b6e?w=400&h=500&fit=crop" alt="Golden Hour Lipstick" class="product-image">
                    <div class="product-info">
                        <div class="product-category">LUXURY COSMETICS</div>
                        <div class="product-name">Golden Hour Lipstick</div>
                        <p class="product-description">Richly pigmented lipstick with nourishing ingredients for a perfect pout.</p>
                        <div class="product-price">$65.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="far fa-star"></i>
                            </div>
                            <span class="rating-count">(89)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(2)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(2)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Product 3 -->
                <div class="product-card">
                    <div class="product-badge">BEST SELLER</div>
                    <img src="https://images.unsplash.com/photo-1591085686350-798c0f9faa7f?w=400&h=500&fit=crop" alt="Ocean Breeze Cologne" class="product-image">
                    <div class="product-info">
                        <div class="product-category">EAU DE COLOGNE</div>
                        <div class="product-name">Ocean Breeze - 150ml</div>
                        <p class="product-description">Fresh citrus and marine notes for a clean, invigorating scent.</p>
                        <div class="product-price">$145.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                            <span class="rating-count">(156)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(3)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(3)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Product 4 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1531214159280-079b95d26139?w=400&h=500&fit=crop" alt="Luminous Foundation" class="product-image">
                    <div class="product-info">
                        <div class="product-category">LUXURY COSMETICS</div>
                        <div class="product-name">Luminous Foundation</div>
                        <p class="product-description">Weightless foundation with buildable coverage and radiant finish.</p>
                        <div class="product-price">$95.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                            </div>
                            <span class="rating-count">(203)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(4)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(4)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Product 5 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1548438294-1ad5d5f4f063?w=400&h=500&fit=crop" alt="Amber Musk" class="product-image">
                    <div class="product-info">
                        <div class="product-category">EAU DE PARFUM</div>
                        <div class="product-name">Amber Musk - 75ml</div>
                        <p class="product-description">Warm amber blended with soft musk for a cozy, intimate fragrance.</p>
                        <div class="product-price">$165.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="far fa-star"></i>
                            </div>
                            <span class="rating-count">(97)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(5)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(5)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Product 6 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=400&h=500&fit=crop" alt="Midnight Rose" class="product-image">
                    <div class="product-info">
                        <div class="product-category">EAU DE PARFUM</div>
                        <div class="product-name">Midnight Rose</div>
                        <p class="product-description">Dark rose and patchouli create a mysterious, romantic scent.</p>
                        <div class="product-price">$175.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                            <span class="rating-count">(142)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(6)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(6)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Product 7 -->
                <div class="product-card">
                    <div class="product-badge">LIMITED EDITION</div>
                    <img src="https://images.unsplash.com/photo-1596703923538-b6d4bb0a44ea?w=400&h=500&fit=crop" alt="Golden Elixir Serum" class="product-image">
                    <div class="product-info">
                        <div class="product-category">SKINCARE</div>
                        <div class="product-name">Golden Elixir Serum</div>
                        <p class="product-description">Anti-aging serum with 24K gold particles for radiant skin.</p>
                        <div class="product-price">$220.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                            </div>
                            <span class="rating-count">(67)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(7)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(7)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Product 8 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=400&h=500&fit=crop" alt="Rose Quartz Palette" class="product-image">
                    <div class="product-info">
                        <div class="product-category">LUXURY COSMETICS</div>
                        <div class="product-name">Rose Quartz Eyeshadow Palette</div>
                        <p class="product-description">12 shimmering shades inspired by rose quartz crystals.</p>
                        <div class="product-price">$78.00</div>
                        <div class="product-rating">
                            <div class="rating-stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="far fa-star"></i>
                            </div>
                            <span class="rating-count">(113)</span>
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(8)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(8)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        function addToCart(productId) {
            alert('Added to cart: Product ' + productId);
            // In production, this would make an API call
        }

        function addToWishlist(productId) {
            alert('Added to wishlist: Product ' + productId);
            // In production, this would make an API call
        }

        // Filter functionality
        document.querySelector('.search-box').addEventListener('keyup', function(e) {
            if (e.key === 'Enter') {
                alert('Searching for: ' + this.value);
            }
        });

        document.querySelectorAll('.filter-select').forEach(select => {
            select.addEventListener('change', function() {
                // Filter products based on selection
                console.log('Filter changed:', this.value);
            });
        });
    </script>
</body>
</html>







