<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luxe Essence | Luxury Cosmetics & Fragrances</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
    /* Index 0: Background */
    --light: #F6FAFD;
    
    /* Index 1: Text */
    --primary: #1A3D63;
    
    /* Index 2: Heading */
    --primary: #1A3D63;
    
    /* Index 3: Primary */
    --primary: #1A3D63;
    
    /* Index 4: Secondary */
    --secondary: #4A7FA7;
    
    /* Index 5: Accent */
    --accent: #B3CFE5;
    
    /* Index 6: Border */
    --accent: #B3CFE5;
    
    /* Index 7: Success */
    --secondary: #4A7FA7;
    
    /* Index 8: Warning */
    --highlight: #6A1931;
    
    /* Index 9: Error */
    --highlight: #6A1931;
}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--primary);
            background-color: var(--light);
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 600;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header Styles */
        header {
            background-color: var(--light);
            position: fixed;
            width: 100%;
            z-index: 1000;
            padding: 15px 0;
            box-shadow: 0 2px 15px rgba(26, 61, 99, 0.05);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo a {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .logo span {
            color: var(--highlight);
        }

        .nav-desktop ul {
            display: flex;
            list-style: none;
        }

        .nav-desktop li {
            margin-left: 30px;
        }

        .nav-desktop a {
            text-decoration: none;
            color: var(--primary);
            font-weight: 500;
            transition: color 0.3s;
        }

        .nav-desktop a:hover {
            color: var(--highlight);
        }

        .header-actions {
            display: flex;
            align-items: center;
        }

        .icon-btn {
            margin-left: 20px;
            color: var(--primary);
            position: relative;
        }

        .badge {
            background-color: var(--highlight);
            color: white;
            font-size: 10px;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: -8px;
            right: -8px;
        }

        .sign-in-btn {
            background-color: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
            padding: 8px 20px;
            border-radius: 30px;
            text-decoration: none;
            margin-left: 20px;
            transition: all 0.3s;
        }

        .sign-in-btn:hover {
            background-color: var(--primary);
            color: white;
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            color: var(--primary);
            cursor: pointer;
        }

        /* Hero Section */
        .hero {
            padding: 150px 0 80px;
            background: linear-gradient(135deg, var(--light) 0%, rgba(179, 207, 229, 0.2) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .hero-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .hero-image-container {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 500px;
        }

        .hero-image {
            max-width: 100%;
            height: auto;
            filter: drop-shadow(0 10px 20px rgba(26, 61, 99, 0.15));
        }

        .hero-content {
            padding-right: 20px;
        }

        .hero-title {
            font-size: 48px;
            color: var(--primary);
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .hero-subtitle {
            font-size: 20px;
            color: var(--secondary);
            margin-bottom: 30px;
            font-weight: 300;
        }

        .cta-btn {
            display: inline-block;
            background-color: var(--highlight);
            color: white;
            padding: 15px 35px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 500;
            font-size: 16px;
            transition: all 0.3s;
            border: 2px solid var(--highlight);
        }

        .cta-btn:hover {
            background-color: transparent;
            color: var(--highlight);
            transform: translateY(-3px);
        }

        /* New Arrivals */
        .new-arrivals {
            padding: 100px 0;
            background-color: white;
        }

        .section-title {
            text-align: center;
            font-size: 36px;
            color: var(--primary);
            margin-bottom: 60px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 30px;
            margin-bottom: 50px;
        }

        .product-card {
            background-color: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(26, 61, 99, 0.08);
            transition: all 0.3s;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(26, 61, 99, 0.15);
        }

        .product-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .product-info {
            padding: 20px;
        }

        .product-category {
            font-size: 14px;
            color: var(--secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-name {
            font-size: 18px;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .product-price {
            font-size: 20px;
            color: var(--highlight);
            font-weight: 600;
            margin-bottom: 15px;
        }

        .product-actions {
            display: flex;
            gap: 10px;
        }

        .add-to-cart-btn {
            flex: 1;
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .add-to-cart-btn:hover {
            background-color: var(--highlight);
        }

        .wishlist-btn {
            background-color: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
            padding: 10px;
            border-radius: 50%;
            cursor: pointer;
            transition: all 0.3s;
        }

        .wishlist-btn:hover {
            background-color: var(--primary);
            color: white;
        }

        .see-more-btn {
            display: block;
            width: 200px;
            margin: 0 auto;
            text-align: center;
            background-color: transparent;
            color: var(--primary);
            padding: 12px 30px;
            border-radius: 30px;
            text-decoration: none;
            border: 2px solid var(--primary);
            transition: all 0.3s;
        }

        .see-more-btn:hover {
            background-color: var(--primary);
            color: white;
        }

        /* Footer */
        footer {
            background-color: var(--primary);
            color: var(--accent);
            padding: 60px 0 30px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-section h3 {
            font-size: 20px;
            color: white;
            margin-bottom: 25px;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section li {
            margin-bottom: 12px;
        }

        .footer-section a {
            color: var(--accent);
            text-decoration: none;
        }

        .footer-section a:hover {
            color: white;
        }

        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(179, 207, 229, 0.2);
            font-size: 14px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: block;
            }
            
            .nav-desktop {
                display: none;
            }
            
            .hero-container {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 40px;
            }
            
            .hero-content {
                padding-right: 0;
            }
            
            .hero-title {
                font-size: 36px;
            }
            
            .section-title {
                font-size: 30px;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="editable-section no-drop-zone" data-section="1">
        <div class="container header-container">
            <div class="logo">
                <a>
                    <i class="fas fa-gem editable-icon" data-icon="1" data-default-class="fas fa-gem"></i>
                    <span class="editable-text editable-section no-drop-zone" data-section="2" data-text="1">Luxe</span>
                    <span class="editable-text editable-section no-drop-zone" data-section="3" data-text="2">Essence</span>
                </a>
            </div>
            
            <button class="mobile-menu-btn" id="mobile-menu-toggle">
                <i class="fas fa-bars editable-icon" data-icon="2" data-default-class="fas fa-bars"></i>
            </button>
            
            <nav class="nav-desktop">
                <ul id="main-nav">
                    <li class="editable-text editable-section no-drop-zone" data-section="4" data-text="3"><a class="active">HOME</a></li>
                    <li class="editable-text editable-section no-drop-zone" data-section="5" data-text="4"><a>SHOP</a></li>
                    <li class="editable-text editable-section no-drop-zone" data-section="6" data-text="5"><a>COLLECTIONS</a></li>
                    <li class="editable-text editable-section no-drop-zone" data-section="7" data-text="6"><a>ABOUT US</a></li>
                    <li class="editable-text editable-section no-drop-zone" data-section="8" data-text="7"><a>CONTACT</a></li>
                </ul>
            </nav>
            
            <div class="header-actions">
                <a class="icon-btn">
                    <i class="fas fa-heart editable-icon" data-icon="3" data-default-class="fas fa-heart"></i>
                    <span class="badge">0</span>
                </a>
                <a class="icon-btn">
                    <i class="fas fa-shopping-bag editable-icon" data-icon="4" data-default-class="fas fa-shopping-bag"></i>
                    <span class="badge">0</span>
                </a>
                <a class="sign-in-btn editable-section no-drop-zone" data-section="9" data-text="8">ACCOUNT</a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero editable-section" data-section="10">
        <div class="container hero-container">
            <div class="hero-image-container editable-section no-drop-zone" data-section="11">
                <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=1000&h=800&fit=crop" 
                     alt="Luxe Essence Perfume" 
                     class="hero-image editable-image" 
                     data-image="5">
            </div>
            
            <div class="hero-content">
                <h1 class="editable-text editable-section no-drop-zone" data-section="12" data-text="9">Essence of Timeless Beauty</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="13" data-text="10">Indulge in luxurious fragrances and cosmetics crafted to elevate every moment.</p>
                <a class="cta-btn editable-text editable-section no-drop-zone" data-section="14" data-text="11">DISCOVER COLLECTION</a>
            </div>
        </div>
    </section>

    <!-- New Arrivals Section -->
    <section class="new-arrivals editable-section" data-section="15">
        <div class="container">
            <h2 class="section-title editable-text editable-section no-drop-zone" data-section="16" data-text="12">New Arrivals</h2>
            
            <div class="products-grid">
                <!-- Product 1 (Editable) -->
                <div class="product-card editable-section no-drop-zone" data-section="17">
                    <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?w=400&h=400&fit=crop" 
                         alt="Velvet Noir Perfume" 
                         class="product-image editable-image" 
                         data-image="6">
                    <div class="product-info">
                        <div class="product-category editable-section no-drop-zone" data-section="18" data-text="13">EAU DE PARFUM</div>
                        <div class="product-name editable-section no-drop-zone" data-section="19" data-text="14">Velvet Noir</div>
                        <div class="product-price editable-section no-drop-zone" data-section="20" data-text="15">$189</div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn editable-text editable-section no-drop-zone" data-section="21" data-text="16" onclick="addToCart(1)">
                                <i class="fas fa-shopping-bag editable-icon" data-icon="4" data-default-class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(1)">
                                <i class="fas fa-heart editable-icon" data-icon="3" data-default-class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Product 2 (Not Editable - Will be populated from backend) -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1522338242990-c0f7938f8b6e?w=400&h=400&fit=crop" alt="Golden Hour Lipstick" class="product-image">
                    <div class="product-info">
                        <div class="product-category">LUXURY COSMETICS</div>
                        <div class="product-name">Golden Hour Lipstick</div>
                        <div class="product-price">$65</div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(2)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(2)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Product 3 (Not Editable) -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1591085686350-798c0f9faa7f?w=400&h=400&fit=crop" alt="Ocean Breeze Cologne" class="product-image">
                    <div class="product-info">
                        <div class="product-category">EAU DE COLOGNE</div>
                        <div class="product-name">Ocean Breeze</div>
                        <div class="product-price">$145</div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(3)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(3)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Product 4 (Not Editable) -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1531214159280-079b95d26139?w=400&h=400&fit=crop" alt="Luminous Foundation" class="product-image">
                    <div class="product-info">
                        <div class="product-category">LUXURY COSMETICS</div>
                        <div class="product-name">Luminous Foundation</div>
                        <div class="product-price">$95</div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" onclick="addToCart(4)">
                                <i class="fas fa-shopping-bag"></i> Add to Bag
                            </button>
                            <button class="wishlist-btn" onclick="addToWishlist(4)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <a class="see-more-btn editable-text editable-section no-drop-zone" data-section="22" data-text="17">SEE MORE</a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="editable-section" data-section="23">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section editable-section no-drop-zone" data-section="24">
                    <h3 class="editable-text editable-section no-drop-zone" data-section="25" data-text="18">Luxe Essence</h3>
                    <p class="editable-text editable-section no-drop-zone" data-section="26" data-text="19">Creating luxurious fragrances and cosmetics that celebrate individuality and timeless beauty.</p>
                </div>
                
                <div class="footer-section editable-section no-drop-zone" data-section="27">
                    <h3 class="editable-text editable-section no-drop-zone" data-section="28" data-text="20">Quick Links</h3>
                    <ul>
                        <li><a  class="editable-text editable-section no-drop-zone" data-section="29" data-text="21">Home</a></li>
                        <li><a class="editable-text editable-section no-drop-zone" data-section="30" data-text="22">Shop</a></li>
                        <li><a  class="editable-text editable-section no-drop-zone" data-section="31" data-text="23">Collections</a></li>
                        <li><a  class="editable-text editable-section no-drop-zone" data-section="32" data-text="24">About Us</a></li>
                    </ul>
                </div>
                
                <div class="footer-section editable-section no-drop-zone" data-section="33">
                    <h3 class="editable-text editable-section no-drop-zone" data-section="34" data-text="25">Customer Service</h3>
                    <ul>
                        <li><a  class="editable-text editable-section no-drop-zone" data-section="35" data-text="26">Contact Us</a></li>
                        <li><a  class="editable-text editable-section no-drop-zone" data-section="36" data-text="27">Shipping</a></li>
                        <li><a  class="editable-text editable-section no-drop-zone" data-section="37" data-text="28">Returns</a></li>
                        <li><a  class="editable-text editable-section no-drop-zone" data-section="38" data-text="29">Privacy Policy</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="copyright editable-section no-drop-zone" data-section="39">
                <p class="editable-text editable-section no-drop-zone" data-section="40" data-text="30">&copy; 2023 Luxe Essence. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // Mobile menu toggle
        document.getElementById('mobile-menu-toggle').addEventListener('click', function() {
            const nav = document.querySelector('.nav-desktop');
            nav.style.display = nav.style.display === 'block' ? 'none' : 'block';
        });

        function addToCart(productId) {
            alert('Added to cart: Product ' + productId);
        }

        function addToWishlist(productId) {
            alert('Added to wishlist: Product ' + productId);
        }
    </script>
</body>
</html>









