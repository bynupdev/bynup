                </a>
            </div>

            <!-- Craft Category -->
            <div class="category-card">
                <div class="category-header" style="background: #4ECDC4">
                    <div class="category-icon">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <div class="category-title">Craft</div>
                    <div class="category-description">Artisanal and handcrafted</div>
                </div>
                <div class="category-products">
                    <div class="product-item">
                        <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&h=300&fit=crop" alt="Craft Burgers" class="product-image">
                        <div class="product-details">
                            <div class="product-name">Craft Burgers</div>
                            <div class="product-price">$12.99</div>
                        </div>
                        <button class="add-to-cart-btn" onclick="addToCart(1)">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <div class="product-item">
                        <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?w=400&h=300&fit=crop" alt="Artisan Pizza" class="product-image">
                        <div class="product-details">
                            <div class="product-name">Artisan Pizza</div>
                            <div class="product-price">$15.99</div>
                        </div>
                        <button class="add-to-cart-btn" onclick="addToCart(18)">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                    <div class="product-item">
                        <img src="https://images.unsplash.com/photo-1589647363585-f4a7d3877b10?w=400&h=300&fit=crop" alt="Handmade Dumplings" class="product-image">
                        <div class="product-details">
                            <div class="product-name">Handmade Dumplings</div>
                            <div class="product-price">$13.49</div>
                        </div>
                        <button class="add-to-cart-btn" onclick="addToCart(19)">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                <a href="products.html?category=craft" class="view-all-btn">
                    View All Craft Meals
                </a>
            </div>
        </div>
