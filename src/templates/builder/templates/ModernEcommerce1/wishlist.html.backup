<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wishlist - FreshPlate</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #FF6B6B;
            --primary-dark: #E55A5A;
            --secondary: #4ECDC4;
            --accent: #FFD166;
            --dark: #1A1F2B;
            --light: #F7F9FC;
            --text: #2D3748;
            --text-light: #718096;
            --success: #06D6A0;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            --radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: var(--text);
            background-color: var(--light);
        }

        /* Header Styles */
        header {
            background: white;
            padding: 1rem 5%;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--dark);
        }

        .logo a {
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo i {
            color: var(--primary);
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        nav a {
            text-decoration: none;
            color: var(--text);
            font-weight: 500;
            transition: var(--transition);
            position: relative;
        }

        nav a:after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -5px;
            left: 0;
            background: var(--primary);
            transition: var(--transition);
        }

        nav a:hover {
            color: var(--primary);
        }

        nav a:hover:after {
            width: 100%;
        }

        .header-actions {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .icon-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 1.3rem;
            color: var(--text);
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }

        .icon-btn:hover {
            color: var(--primary);
        }

        .badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sign-in-btn {
            background: var(--primary);
            color: white;
            padding: 0.6rem 1.5rem;
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            box-shadow: 0 4px 10px rgba(255, 107, 107, 0.3);
            text-decoration: none;
            display: inline-block;
        }

        .sign-in-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            padding: 3rem 5%;
            color: white;
            text-align: center;
        }

        .page-header h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .page-header p {
            font-size: 1.1rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Wishlist Section */
        .wishlist-section {
            padding: 3rem 5%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .wishlist-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--light);
        }

        .wishlist-header h2 {
            font-size: 1.5rem;
            color: var(--dark);
            font-weight: 700;
        }

        .clear-wishlist-btn {
            background: none;
            border: none;
            color: var(--primary);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .clear-wishlist-btn:hover {
            color: var(--primary-dark);
        }

        .wishlist-items {
            background: white;
            border-radius: var(--radius);
            padding: 2rem;
            box-shadow: var(--shadow);
        }

        .wishlist-item {
            display: grid;
            grid-template-columns: 150px 1fr auto;
            gap: 1.5rem;
            padding: 1.5rem 0;
            border-bottom: 1px solid var(--light);
            align-items: center;
        }

        .wishlist-item:last-child {
            border-bottom: none;
        }

        .wishlist-item-image {
            width: 150px;
            height: 120px;
            object-fit: cover;
            border-radius: var(--radius);
            cursor: pointer;
            transition: var(--transition);
        }

        .wishlist-item-image:hover {
            transform: scale(1.05);
        }

        .wishlist-item-details {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .wishlist-item-name {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--dark);
            cursor: pointer;
            transition: var(--transition);
        }

        .wishlist-item-name:hover {
            color: var(--primary);
        }

        .wishlist-item-category {
            font-size: 0.8rem;
            color: var(--secondary);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .wishlist-item-price {
            font-size: 1.2rem;
            color: var(--success);
            font-weight: bold;
            margin: 0.5rem 0;
        }

        .wishlist-item-description {
            color: var(--text-light);
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .wishlist-item-actions {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
            min-width: 150px;
        }

        .add-to-cart-btn {
            background: var(--primary);
            color: white;
            padding: 0.8rem 1rem;
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-to-cart-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .remove-from-wishlist-btn {
            background: none;
            border: 2px solid var(--primary);
            color: var(--primary);
            padding: 0.8rem 1rem;
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .remove-from-wishlist-btn:hover {
            background: var(--primary);
            color: white;
        }

        /* Empty Wishlist */
        .empty-wishlist {
            text-align: center;
            padding: 4rem;
            color: var(--text-light);
        }

        .empty-wishlist i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: var(--text-light);
            opacity: 0.5;
        }

        .empty-wishlist h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--text);
        }

        .empty-wishlist p {
            margin-bottom: 2rem;
            color: var(--text-light);
        }

        .browse-products-btn {
            background: var(--primary);
            color: white;
            padding: 1rem 2rem;
            border: none;
            border-radius: var(--radius);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            display: inline-block;
        }

        .browse-products-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        /* Recommendations Section */
        .recommendations-section {
            margin-top: 4rem;
        }

        .recommendations-title {
            text-align: center;
            font-size: 2rem;
            color: var(--dark);
            margin-bottom: 2rem;
            font-weight: 700;
        }

        .recommendations-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .product-card {
            background: white;
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
            cursor: pointer;
            transition: var(--transition);
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .product-card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .product-info {
            padding: 1.5rem;
        }

        .product-category {
            font-size: 0.8rem;
            color: var(--secondary);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0.5rem 0;
            color: var(--dark);
        }

        .product-price {
            font-size: 1.3rem;
            color: var(--success);
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .product-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn {
            flex: 1;
            padding: 0.6rem;
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            font-size: 0.9rem;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .btn-wishlist {
            background: var(--light);
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .btn-wishlist:hover {
            background: var(--primary);
            color: white;
        }

        /* Footer */
        footer {
            background: var(--dark);
            color: white;
            padding: 4rem 5%;
            margin-top: 5rem;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .footer-section h3 {
            margin-bottom: 1.5rem;
            color: var(--accent);
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section a {
            color: #aaa;
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: var(--transition);
        }

        .footer-section a:hover {
            color: white;
            transform: translateX(5px);
        }

        /* Responsive */
        @media (max-width: 968px) {
            .wishlist-item {
                grid-template-columns: 120px 1fr;
                gap: 1rem;
            }
            
            .wishlist-item-actions {
                grid-column: 1 / -1;
                flex-direction: row;
                justify-content: space-between;
                margin-top: 1rem;
            }
        }

        @media (max-width: 768px) {
            .wishlist-item {
                grid-template-columns: 1fr;
                text-align: center;
            }
            
            .wishlist-item-image {
                justify-self: center;
            }
            
            .wishlist-item-actions {
                flex-direction: column;
            }
            
            nav ul {
                display: none;
            }
            
            .page-header h1 {
                font-size: 2rem;
            }
        }

        /* Mobile Menu */
        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text);
            cursor: pointer;
        }

        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: block;
            }

            nav ul {
                position: fixed;
                top: 70px;
                left: 0;
                width: 100%;
                background: white;
                flex-direction: column;
                padding: 1rem;
                box-shadow: var(--shadow);
                transform: translateY(-100%);
                opacity: 0;
                transition: var(--transition);
                z-index: 999;
            }

            nav ul.active {
                transform: translateY(0);
                opacity: 1;
                display: flex;
            }

            nav ul li {
                width: 100%;
                text-align: center;
                padding: 0.5rem 0;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="header-container">
            <div class="logo">
                <a href="index.html">
                    <i class="fas fa-utensils"></i>
                    <span>FreshPlate</span>
                </a>
            </div>
            <button class="mobile-menu-btn" id="mobile-menu-toggle">
                <i class="fas fa-bars"></i>
            </button>
            <nav>
                <ul id="main-nav">
                    <li><a href="index.html">HOME</a></li>
                    <li><a href="products.html">PRODUCTS</a></li>
                    <li><a href="categories.html">CATEGORIES</a></li>
                    <li><a href="about.html">ABOUT US</a></li>
                    <li><a href="contact.html">CONTACT</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <a href="wishlist.html" class="icon-btn">
                    <i class="fas fa-heart"></i>
                    <span class="badge">4</span>
                </a>
                <a href="cart.html" class="icon-btn">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="badge">3</span>
                </a>
                <a href="login.html" class="sign-in-btn">SIGN IN</a>
            </div>
        </div>
    </header>

    <!-- Page Header -->
    <section class="page-header">
        <h1>My Wishlist</h1>
        <p>Save your favorite meals for later and never miss out on delicious options</p>
    </section>

    <!-- Wishlist Section -->
    <section class="wishlist-section">
        <div class="wishlist-header">
            <h2>Saved Items (4)</h2>
            <button class="clear-wishlist-btn" onclick="clearWishlist()">
                <i class="fas fa-trash"></i> Clear Wishlist
            </button>
        </div>

        <div class="wishlist-items">
            <!-- Wishlist Item 1 -->
            <div class="wishlist-item">
                <img src="https://images.unsplash.com/photo-1600891964092-4316c288032e?w=400&h=300&fit=crop" alt="Premium Steak Dinner" class="wishlist-item-image" onclick="viewProduct(6)">
                <div class="wishlist-item-details">
                    <div class="wishlist-item-name" onclick="viewProduct(6)">Premium Steak Dinner</div>
                    <div class="wishlist-item-category">PREMIUM</div>
                    <div class="wishlist-item-price">$22.99</div>
                    <div class="wishlist-item-description">
                        Premium grass-fed steak with garlic butter, seasonal vegetables, and herb-roasted potatoes.
                    </div>
                </div>
                <div class="wishlist-item-actions">
                    <button class="add-to-cart-btn" onclick="addToCartFromWishlist(6)">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                    <button class="remove-from-wishlist-btn" onclick="removeFromWishlist(6)">
                        <i class="fas fa-trash"></i> Remove
                    </button>
                </div>
            </div>

            <!-- Wishlist Item 2 -->
            <div class="wishlist-item">
                <img src="https://images.unsplash.com/photo-1467003909585-2f8a72700288?w=400&h=300&fit=crop" alt="Grilled Salmon" class="wishlist-item-image" onclick="viewProduct(11)">
                <div class="wishlist-item-details">
                    <div class="wishlist-item-name" onclick="viewProduct(11)">Grilled Salmon</div>
                    <div class="wishlist-item-category">PREMIUM</div>
                    <div class="wishlist-item-price">$19.99</div>
                    <div class="wishlist-item-description">
                        Fresh Atlantic salmon grilled to perfection with lemon butter sauce and asparagus.
                    </div>
                </div>
                <div class="wishlist-item-actions">
                    <button class="add-to-cart-btn" onclick="addToCartFromWishlist(11)">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                    <button class="remove-from-wishlist-btn" onclick="removeFromWishlist(11)">
                        <i class="fas fa-trash"></i> Remove
                    </button>
                </div>
            </div>

            <!-- Wishlist Item 3 -->
            <div class="wishlist-item">
                <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=400&h=300&fit=crop" alt="Chocolate Cake" class="wishlist-item-image" onclick="viewProduct(10)">
                <div class="wishlist-item-details">
                    <div class="wishlist-item-name" onclick="viewProduct(10)">Chocolate Cake</div>
                    <div class="wishlist-item-category">DESSERTS</div>
                    <div class="wishlist-item-price">$8.99</div>
                    <div class="wishlist-item-description">
                        Rich and decadent chocolate cake with layers of chocolate ganache and fresh berries.
                    </div>
                </div>
                <div class="wishlist-item-actions">
                    <button class="add-to-cart-btn" onclick="addToCartFromWishlist(10)">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                    <button class="remove-from-wishlist-btn" onclick="removeFromWishlist(10)">
                        <i class="fas fa-trash"></i> Remove
                    </button>
                </div>
            </div>

            <!-- Wishlist Item 4 -->
            <div class="wishlist-item">
                <img src="https://images.unsplash.com/photo-1574894709929-1276877dc8aa?w=400&h=300&fit=crop" alt="Mushroom Risotto" class="wishlist-item-image" onclick="viewProduct(14)">
                <div class="wishlist-item-details">
                    <div class="wishlist-item-name" onclick="viewProduct(14)">Mushroom Risotto</div>
                    <div class="wishlist-item-category">VEGETARIAN</div>
                    <div class="wishlist-item-price">$14.99</div>
                    <div class="wishlist-item-description">
                        Creamy arborio rice with wild mushrooms, parmesan cheese, and fresh herbs.
                    </div>
                </div>
                <div class="wishlist-item-actions">
                    <button class="add-to-cart-btn" onclick="addToCartFromWishlist(14)">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                    <button class="remove-from-wishlist-btn" onclick="removeFromWishlist(14)">
                        <i class="fas fa-trash"></i> Remove
                    </button>
                </div>
            </div>
        </div>

        <!-- Recommendations Section -->
        <section class="recommendations-section">
            <h2 class="recommendations-title">You Might Also Like</h2>
            <div class="recommendations-grid">
                <!-- Recommendation 1 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1559847844-5315695dadae?w=400&h=300&fit=crop" alt="Artisan Pizza">
                    <div class="product-info">
                        <div class="product-category">CRAFT</div>
                        <div class="product-name">Artisan Pizza</div>
                        <div class="product-price">$15.99</div>
                        <div class="product-actions">
                            <button class="btn btn-primary" onclick="addToCart(18)">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="btn btn-wishlist" onclick="addToWishlist(18)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Recommendation 2 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1589647363585-f4a7d3877b10?w=400&h=300&fit=crop" alt="Handmade Dumplings">
                    <div class="product-info">
                        <div class="product-category">CRAFT</div>
                        <div class="product-name">Handmade Dumplings</div>
                        <div class="product-price">$13.49</div>
                        <div class="product-actions">
                            <button class="btn btn-primary" onclick="addToCart(19)">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="btn btn-wishlist" onclick="addToWishlist(19)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Recommendation 3 -->
                <div class="product-card">
                    <img src="https://images.unsplash.com/photo-1512058564366-18510be2db19?w=400&h=300&fit=crop" alt="Veggie Stir Fry">
                    <div class="product-info">
                        <div class="product-category">VEGETARIAN</div>
                        <div class="product-name">Veggie Stir Fry</div>
                        <div class="product-price">$12.99</div>
                        <div class="product-actions">
                            <button class="btn btn-primary" onclick="addToCart(15)">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                            <button class="btn btn-wishlist" onclick="addToWishlist(15)">
                                <i class="fas fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>On The Menu</h3>
                <ul>
                    <li><a href="#">Pricing</a></li>
                    <li><a href="#">Recipes</a></li>
                    <li><a href="#">Wine</a></li>
                    <li><a href="#">Market</a></li>
                    <li><a href="#">Gift Cards</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Support</h3>
                <ul>
                    <li><a href="#">Help Center</a></li>
                    <li><a href="#">Careers</a></li>
                    <li><a href="contact.html">Contact</a></li>
                    <li><a href="about.html">Our Team</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Privacy & Terms</h3>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Service</a></li>
                    <li><a href="#">Cookie Policy</a></li>
                    <li><a href="#">Accessibility</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Follow Us</h3>
                <ul>
                    <li><a href="#"><i class="fab fa-facebook"></i> Facebook</a></li>
                    <li><a href="#"><i class="fab fa-twitter"></i> Twitter</a></li>
                    <li><a href="#"><i class="fab fa-instagram"></i> Instagram</a></li>
                    <li><a href="#"><i class="fab fa-pinterest"></i> Pinterest</a></li>
                </ul>
            </div>
        </div>
        <div style="text-align: center; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #333;">
