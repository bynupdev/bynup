<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - FreshPlate</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #FF6B6B;
            --primary-dark: #E55A5A;
            --secondary: #4ECDC4;
            --accent: #FFD166;
            --dark: #1A1F2B;
            --light: #F7F9FC;
            --text: #2D3748;
            --text-light: #718096;
            --success: #06D6A0;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            --radius: 12px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: var(--text);
            background-color: var(--light);
        }

        /* Header Styles */
        header {
            background: white;
            padding: 1rem 5%;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--dark);
        }

        .logo a {
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo i {
            color: var(--primary);
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        nav a {
            text-decoration: none;
            color: var(--text);
            font-weight: 500;
            transition: var(--transition);
            position: relative;
        }

        nav a:after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -5px;
            left: 0;
            background: var(--primary);
            transition: var(--transition);
        }

        nav a:hover {
            color: var(--primary);
        }

        nav a:hover:after {
            width: 100%;
        }

        .header-actions {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .icon-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 1.3rem;
            color: var(--text);
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }

        .icon-btn:hover {
            color: var(--primary);
        }

        .badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--primary);
            color: white;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sign-in-btn {
            background: var(--primary);
            color: white;
            padding: 0.6rem 1.5rem;
            border: none;
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            box-shadow: 0 4px 10px rgba(255, 107, 107, 0.3);
            text-decoration: none;
            display: inline-block;
        }

        .sign-in-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            padding: 3rem 5%;
            color: white;
            text-align: center;
        }

        .page-header h1 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .page-header p {
            font-size: 1.1rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Cart Section */
        .cart-section {
            padding: 3rem 5%;
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 3rem;
        }

        .cart-items {
            background: white;
            border-radius: var(--radius);
            padding: 2rem;
            box-shadow: var(--shadow);
        }

        .cart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--light);
        }

        .cart-header h2 {
            font-size: 1.5rem;
            color: var(--dark);
            font-weight: 700;
        }

        .clear-cart-btn {
            background: none;
            border: none;
            color: var(--primary);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .clear-cart-btn:hover {
            color: var(--primary-dark);
        }

        .cart-item {
            display: grid;
            grid-template-columns: 120px 1fr auto;
            gap: 1.5rem;
            padding: 1.5rem 0;
            border-bottom: 1px solid var(--light);
            align-items: center;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-item-image {
            width: 120px;
            height: 100px;
            object-fit: cover;
            border-radius: var(--radius);
        }

        .cart-item-details {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .cart-item-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--dark);
        }

        .cart-item-category {
            font-size: 0.8rem;
            color: var(--secondary);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .cart-item-price {
            font-size: 1.1rem;
            color: var(--success);
            font-weight: bold;
        }

        .cart-item-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-top: 0.5rem;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 2px solid var(--light);
            border-radius: var(--radius);
            padding: 0.3rem;
        }

        .quantity-btn {
            background: none;
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .quantity-btn:hover {
            background: var(--light);
        }

        .quantity {
            font-weight: 600;
            min-width: 30px;
            text-align: center;
        }

        .remove-btn {
            background: none;
            border: none;
            color: var(--primary);
            cursor: pointer;
            font-weight: 600;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .remove-btn:hover {
            color: var(--primary-dark);
        }

        .cart-item-total {
            text-align: right;
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--dark);
        }

        /* Empty Cart */
        .empty-cart {
            text-align: center;
            padding: 3rem;
            color: var(--text-light);
        }

        .empty-cart i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: var(--text-light);
            opacity: 0.5;
        }

        .empty-cart h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--text);
        }

        .empty-cart p {
            margin-bottom: 2rem;
            color: var(--text-light);
        }

        .continue-shopping-btn {
            background: var(--primary);
            color: white;
            padding: 1rem 2rem;
            border: none;
            border-radius: var(--radius);
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            display: inline-block;
        }

        .continue-shopping-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        /* Cart Summary */
        .cart-summary {
            background: white;
            border-radius: var(--radius);
            padding: 2rem;
            box-shadow: var(--shadow);
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .summary-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--light);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            padding: 0.5rem 0;
        }

        .summary-label {
            color: var(--text-light);
        }

        .summary-value {
            font-weight: 600;
            color: var(--dark);
        }

        .summary-total {
            border-top: 2px solid var(--light);
            padding-top: 1rem;
            margin-top: 1rem;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--dark);
        }

        .discount-code {
            margin: 1.5rem 0;
        }

        .discount-input {
            width: 100%;
            padding: 0.8rem 1rem;
            border: 2px solid var(--light);
            border-radius: var(--radius);
            font-size: 1rem;
            transition: var(--transition);
        }

        .discount-input:focus {
            border-color: var(--primary);
            outline: none;
        }

        .apply-discount-btn {
            width: 100%;
            background: var(--secondary);
            color: white;
            padding: 0.8rem;
            border: none;
            border-radius: var(--radius);
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 0.5rem;
        }

        .apply-discount-btn:hover {
            background: #3db8af;
        }

        .checkout-btn {
            width: 100%;
            background: var(--primary);
            color: white;
            padding: 1rem;
            border: none;
            border-radius: var(--radius);
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 1rem;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
        }

        .checkout-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .security-notice {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 1rem;
            padding: 1rem;
            background: var(--light);
            border-radius: var(--radius);
            font-size: 0.9rem;
            color: var(--text-light);
        }

        .security-notice i {
            color: var(--success);
        }

        /* Footer */
        footer {
            background: var(--dark);
            color: white;
            padding: 4rem 5%;
            margin-top: 5rem;
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .footer-section h3 {
            margin-bottom: 1.5rem;
            color: var(--accent);
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section a {
            color: #aaa;
            text-decoration: none;
            display: block;
            margin-bottom: 0.8rem;
            transition: var(--transition);
        }

        .footer-section a:hover {
            color: white;
            transform: translateX(5px);
        }

        /* Responsive */
        @media (max-width: 968px) {
            .cart-section {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            
            .cart-summary {
                position: static;
            }
        }

        @media (max-width: 768px) {
            .cart-item {
                grid-template-columns: 100px 1fr;
                gap: 1rem;
            }
            
            .cart-item-total {
                grid-column: 1 / -1;
                text-align: left;
                margin-top: 1rem;
                padding-top: 1rem;
                border-top: 1px solid var(--light);
            }
            
            nav ul {
                display: none;
            }
            
            .page-header h1 {
                font-size: 2rem;
            }
        }

        @media (max-width: 480px) {
            .cart-item {
                grid-template-columns: 1fr;
                text-align: center;
            }
            
            .cart-item-image {
                justify-self: center;
            }
            
            .cart-item-controls {
                justify-content: center;
            }
        }

        /* Mobile Menu */
        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            color: var(--text);
            cursor: pointer;
        }

        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: block;
            }

            nav ul {
                position: fixed;
                top: 70px;
                left: 0;
                width: 100%;
                background: white;
                flex-direction: column;
                padding: 1rem;
                box-shadow: var(--shadow);
                transform: translateY(-100%);
                opacity: 0;
                transition: var(--transition);
                z-index: 999;
            }

            nav ul.active {
                transform: translateY(0);
                opacity: 1;
                display: flex;
            }

            nav ul li {
                width: 100%;
                text-align: center;
                padding: 0.5rem 0;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="header-container">
            <div class="logo">
                <a href="index.html">
                    <i class="fas fa-utensils"></i>
                    <span>FreshPlate</span>
                </a>
            </div>
            <button class="mobile-menu-btn" id="mobile-menu-toggle">
                <i class="fas fa-bars"></i>
            </button>
            <nav>
                <ul id="main-nav">
                    <li><a href="index.html">HOME</a></li>
                    <li><a href="products.html">PRODUCTS</a></li>
                    <li><a href="categories.html">CATEGORIES</a></li>
                    <li><a href="about.html">ABOUT US</a></li>
                    <li><a href="contact.html">CONTACT</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <a href="wishlist.html" class="icon-btn">
                    <i class="fas fa-heart"></i>
                    <span class="badge">0</span>
                </a>
                <a href="cart.html" class="icon-btn">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="badge">3</span>
                </a>
                <a href="login.html" class="sign-in-btn">SIGN IN</a>
            </div>
        </div>
    </header>

    <!-- Page Header -->
    <section class="page-header">
        <h1>Your Shopping Cart</h1>
        <p>Review your items and proceed to checkout</p>
    </section>

    <!-- Cart Section -->
    <section class="cart-section">
        <div class="cart-items">
            <div class="cart-header">
                <h2>Your Items (3)</h2>
                <button class="clear-cart-btn" onclick="clearCart()">
                    <i class="fas fa-trash"></i> Clear Cart
                </button>
            </div>

            <!-- Cart Item 1 -->
            <div class="cart-item">
                <img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=400&h=300&fit=crop" alt="Craft Burgers" class="cart-item-image">
                <div class="cart-item-details">
                    <div class="cart-item-name">Craft Burgers</div>
                    <div class="cart-item-category">CRAFT</div>
                    <div class="cart-item-price">$12.99 each</div>
                    <div class="cart-item-controls">
                        <div class="quantity-controls">
                            <button class="quantity-btn" onclick="updateQuantity(1, -1)">
                                <i class="fas fa-minus"></i>
                            </button>
                            <span class="quantity">2</span>
                            <button class="quantity-btn" onclick="updateQuantity(1, 1)">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <button class="remove-btn" onclick="removeFromCart(1)">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
                <div class="cart-item-total">
                    $25.98
                </div>
            </div>

            <!-- Cart Item 2 -->
            <div class="cart-item">
                <img src="https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&h=300&fit=crop" alt="Mediterranean Salad" class="cart-item-image">
                <div class="cart-item-details">
                    <div class="cart-item-name">Mediterranean Salad</div>
                    <div class="cart-item-category">WELLNESS</div>
                    <div class="cart-item-price">$14.99 each</div>
                    <div class="cart-item-controls">
                        <div class="quantity-controls">
                            <button class="quantity-btn" onclick="updateQuantity(2, -1)">
                                <i class="fas fa-minus"></i>
                            </button>
                            <span class="quantity">1</span>
                            <button class="quantity-btn" onclick="updateQuantity(2, 1)">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <button class="remove-btn" onclick="removeFromCart(2)">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
                <div class="cart-item-total">
                    $14.99
                </div>
            </div>

            <!-- Cart Item 3 -->
            <div class="cart-item">
                <img src="https://images.unsplash.com/photo-1574484284002-952d92456975?w=400&h=300&fit=crop" alt="Sheet Pan Dinner" class="cart-item-image">
                <div class="cart-item-details">
                    <div class="cart-item-name">Sheet Pan Dinner</div>
                    <div class="cart-item-category">FAST & EASY</div>
                    <div class="cart-item-price">$13.99 each</div>
                    <div class="cart-item-controls">
                        <div class="quantity-controls">
                            <button class="quantity-btn" onclick="updateQuantity(4, -1)">
                                <i class="fas fa-minus"></i>
                            </button>
                            <span class="quantity">1</span>
                            <button class="quantity-btn" onclick="updateQuantity(4, 1)">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                        <button class="remove-btn" onclick="removeFromCart(4)">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                </div>
                <div class="cart-item-total">
                    $13.99
                </div>
            </div>
        </div>

        <div class="cart-summary">
            <div class="summary-title">Order Summary</div>
            <div class="summary-row">
                <span class="summary-label">Subtotal (4 items)</span>
                <span class="summary-value">$54.96</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Shipping</span>
                <span class="summary-value">FREE</span>
            </div>
            <div class="summary-row">
                <span class="summary-label">Tax</span>
                <span class="summary-value">$4.40</span>
            </div>
            <div class="summary-row summary-total">
                <span>Total</span>
                <span>$59.36</span>
            </div>
            
            <div class="discount-code">
                <input type="text" class="discount-input" placeholder="Discount code">
                <button class="apply-discount-btn">Apply Discount</button>
            </div>
            
            <button class="checkout-btn" onclick="proceedToCheckout()">
                <i class="fas fa-lock"></i> Proceed to Checkout
            </button>
            
            <div class="security-notice">
                <i class="fas fa-shield-alt"></i>
                <span>Secure checkout guaranteed</span>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>On The Menu</h3>
                <ul>
                    <li><a href="#">Pricing</a></li>
                    <li><a href="#">Recipes</a></li>
                    <li><a href="#">Wine</a></li>
                    <li><a href="#">Market</a></li>
                    <li><a href="#">Gift Cards</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Support</h3>
                <ul>
                    <li><a href="#">Help Center</a></li>
                    <li><a href="#">Careers</a></li>
                    <li><a href="contact.html">Contact</a></li>
                    <li><a href="about.html">Our Team</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Privacy & Terms</h3>
                <ul>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Service</a></li>
                    <li><a href="#">Cookie Policy</a></li>
                    <li><a href="#">Accessibility</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3>Follow Us</h3>
                <ul>
                    <li><a href="#"><i class="fab fa-facebook"></i> Facebook</a></li>
                    <li><a href="#"><i class="fab fa-twitter"></i> Twitter</a></li>
                    <li><a href="#"><i class="fab fa-instagram"></i> Instagram</a></li>
                    <li><a href="#"><i class="fab fa-pinterest"></i> Pinterest</a></li>
                </ul>
            </div>
        </div>
        <div style="text-align: center; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #333;">
            <p>&copy; 2023 FreshPlate, LLC. All rights reserved.</p>
        </div>
    </footer>

    <script>
        // Mobile menu functionality
        document.getElementById('mobile-menu-toggle').addEventListener('click', function() {
            document.getElementById('main-nav').classList.toggle('active');
        });

        // Placeholder functions for cart operations (to be handled by Django)
        function updateQuantity(productId, change) {
            // This will be handled by Django AJAX
            console.log('Update quantity:', productId, change);
        }

        function removeFromCart(productId) {
            // This will be handled by Django AJAX
            console.log('Remove from cart:', productId);
        }

        function clearCart() {
            // This will be handled by Django AJAX
            if (confirm('Are you sure you want to clear your cart?')) {
                console.log('Clear cart');
            }
        }

        function proceedToCheckout() {
            // This will be handled by Django
            console.log('Proceed to checkout');
        }
    </script>
</body>
</html>