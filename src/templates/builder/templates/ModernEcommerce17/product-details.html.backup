<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details - Pure Beauty, Refined</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --color-bg-primary: #F2E7E2;
            --color-bg-soft: #F4E6CB;
            --color-accent-warm: #F9D0BE;
            --color-lavender: #E1C6D6;
            --color-text-dark: #2c2a2a;
            --color-text-soft: #5e5a5a;
            --color-star: #FFB6C1;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 24px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--color-bg-primary);
            color: var(--color-text-dark);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 90px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Breadcrumb */
        .breadcrumb.editable-section[data-section="54"] {
            padding: var(--spacing-sm) 0;
            margin-bottom: var(--spacing-md);
            font-size: 0.85rem;
            color: var(--color-text-soft);
        }

        .breadcrumb a {
            color: var(--color-text-dark);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb a:hover {
            color: #b27d6a;
        }

        .breadcrumb span {
            margin: 0 0.5rem;
            color: var(--color-text-soft);
        }

        /* Product Details Layout */
        .product-details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Product Images Section */
        .product-images.editable-section.no-drop-zone[data-section="55"] {
            position: relative;
        }

        .main-image-container {
            width: 100%;
            border-radius: 28px;
            overflow: hidden;
            margin-bottom: var(--spacing-sm);
            background-color: #fffbf8;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        .main-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.3s ease;
            cursor: pointer;
        }

        .main-image:hover {
            transform: scale(1.02);
        }

        .thumbnail-container {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: 16px;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
            background-color: #fffbf8;
        }

        .thumbnail:hover {
            transform: translateY(-3px);
            border-color: var(--color-accent-warm);
        }

        .thumbnail.active {
            border-color: #b27d6a;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        /* Product Info Section */
        .product-info.editable-section.no-drop-zone[data-section="56"] {
            padding: var(--spacing-sm) 0;
        }

        h1.product-title.editable-text.editable-section.no-drop-zone[data-section="57"] {
            font-size: 2.5rem;
            color: var(--color-text-dark);
            margin-bottom: 1rem;
            line-height: 1.2;
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: var(--spacing-sm);
        }

        .stars {
            display: flex;
            gap: 0.2rem;
            color: var(--color-star);
            font-size: 1.1rem;
        }

        .stars i {
            cursor: pointer;
            transition: var(--transition);
        }

        .stars i:hover {
            transform: scale(1.1);
        }

        .rating-count {
            color: var(--color-text-soft);
            font-size: 0.9rem;
        }

        .product-price.editable-section.no-drop-zone[data-section="59"] {
            font-size: 2rem;
            color: #b27d6a;
            font-weight: 500;
            margin-bottom: var(--spacing-md);
        }

        .product-description.editable-text.editable-section.no-drop-zone[data-section="60"] {
            color: var(--color-text-soft);
            margin-bottom: var(--spacing-md);
            font-size: 1rem;
            line-height: 1.7;
        }

        /* Product Variants */
        .product-variants {
            margin-bottom: var(--spacing-md);
        }

        .variant-title {
            font-weight: 500;
            margin-bottom: 0.8rem;
            color: var(--color-text-dark);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .variant-options {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .variant-option {
            padding: 0.7rem 1.5rem;
            border: 1px solid rgba(44, 42, 42, 0.2);
            border-radius: 50px;
            background: white;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.9rem;
            font-family: 'Montserrat', sans-serif;
        }

        .variant-option:hover {
            border-color: #b27d6a;
            transform: translateY(-2px);
        }

        .variant-option.active {
            border-color: #b27d6a;
            background: rgba(249, 208, 190, 0.2);
            color: #b27d6a;
            font-weight: 500;
        }

        .color-option {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: var(--transition);
        }

        .color-option:hover {
            transform: scale(1.1);
        }

        .color-option.active {
            border-color: var(--color-text-dark);
            box-shadow: 0 0 0 2px var(--color-accent-warm);
        }

        /* Quantity Selector */
        .quantity-selector {
            margin-bottom: var(--spacing-md);
        }

        .quantity-title {
            font-weight: 500;
            margin-bottom: 0.8rem;
            color: var(--color-text-dark);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .quantity-btn {
            width: 40px;
            height: 40px;
            border: 1px solid rgba(44, 42, 42, 0.2);
            background: white;
            border-radius: 50px;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quantity-btn:hover {
            border-color: #b27d6a;
            background: rgba(249, 208, 190, 0.1);
        }

        .quantity-input {
            width: 60px;
            height: 40px;
            text-align: center;
            border: 1px solid rgba(44, 42, 42, 0.2);
            border-radius: 50px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
        }

        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 1rem;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
        }

        .btn-buy-now.editable-text.editable-section.no-drop-zone[data-section="61"] {
            flex: 2;
            background: linear-gradient(135deg, #2c2a2a, #4a3b35);
            color: white;
            padding: 1rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-buy-now:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .btn-add-to-cart.editable-text.editable-section.no-drop-zone[data-section="62"] {
            flex: 1;
            background: white;
            color: #b27d6a;
            padding: 1rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 50px;
            border: 1px solid #b27d6a;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-add-to-cart:hover {
            background: #b27d6a;
            color: white;
            transform: translateY(-3px);
        }

        .btn-wishlist {
            width: 50px;
            background: white;
            border: 1px solid rgba(44, 42, 42, 0.2);
            border-radius: 50px;
            color: var(--color-text-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.2rem;
        }

        .btn-wishlist:hover {
            background: rgba(249, 208, 190, 0.2);
            color: #b27d6a;
            border-color: #b27d6a;
        }

        /* Product Tabs */
        .product-tabs.editable-section[data-section="63"] {
            margin-bottom: var(--spacing-xl);
        }

        .tab-headers {
            display: flex;
            border-bottom: 1px solid rgba(44, 42, 42, 0.1);
            margin-bottom: var(--spacing-md);
            gap: 2rem;
        }

        .tab-header {
            padding: 1rem 0;
            background: none;
            border: none;
            color: var(--color-text-soft);
            font-size: 1rem;
            cursor: pointer;
            position: relative;
            transition: var(--transition);
            font-family: 'Montserrat', sans-serif;
        }

        .tab-header:hover {
            color: #b27d6a;
        }

        .tab-header.active {
            color: #b27d6a;
            font-weight: 500;
        }

        .tab-header.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: #b27d6a;
        }

        .tab-content {
            display: none;
            padding: var(--spacing-md) 0;
            animation: fadeIn 0.3s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Reviews Section */
        .review-form {
            background: white;
            padding: var(--spacing-md);
            border-radius: 28px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
            margin-bottom: var(--spacing-lg);
        }

        .review-form h3 {
            font-size: 1.5rem;
            margin-bottom: var(--spacing-md);
            color: var(--color-text-dark);
        }

        .rating-input {
            margin-bottom: 1.5rem;
        }

        .rating-input label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--color-text-dark);
            font-weight: 500;
        }

        .star-rating-input {
            display: flex;
            gap: 0.5rem;
            font-size: 1.8rem;
            color: rgba(44, 42, 42, 0.2);
            cursor: pointer;
        }

        .star-rating-input .star {
            cursor: pointer;
            transition: var(--transition);
        }

        .star-rating-input .star:hover,
        .star-rating-input .star:hover ~ .star {
            color: var(--color-star);
        }

        .star-rating-input .star.selected {
            color: var(--color-star);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--color-text-dark);
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 1rem;
            border: 1px solid rgba(44, 42, 42, 0.2);
            border-radius: 16px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #b27d6a;
            box-shadow: 0 0 0 3px rgba(249, 208, 190, 0.2);
        }

        .btn-submit-review {
            background: linear-gradient(135deg, var(--color-accent-warm), var(--color-lavender));
            color: var(--color-text-dark);
            padding: 1rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-submit-review:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(249, 208, 190, 0.4);
        }

        /* Customer Reviews */
        .customer-reviews {
            margin-bottom: var(--spacing-lg);
        }

        .customer-reviews h3 {
            font-size: 1.5rem;
            margin-bottom: var(--spacing-md);
            color: var(--color-text-dark);
        }

        .review-item {
            background: white;
            padding: var(--spacing-md);
            border-radius: 24px;
            margin-bottom: var(--spacing-sm);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
            transition: var(--transition);
        }

        .review-item:hover {
            transform: translateX(5px);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .reviewer-name {
            font-weight: 600;
            color: var(--color-text-dark);
        }

        .review-date {
            color: var(--color-text-soft);
            font-size: 0.85rem;
        }

        .review-rating {
            color: var(--color-star);
            margin-bottom: 0.8rem;
        }

        .review-title {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--color-text-dark);
        }

        .review-text {
            color: var(--color-text-soft);
            line-height: 1.7;
        }

        /* Related Products */
        .related-products {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(44, 42, 42, 0.1);
        }

        .related-products h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--color-text-dark);
        }

        .related-products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .related-product-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
            text-decoration: none;
            color: inherit;
        }

        .related-product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
        }

        .related-product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .related-product-card:hover .related-product-img {
            transform: scale(1.02);
        }

        .related-product-info {
            padding: 1rem;
        }

        .related-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 500;
            margin-bottom: 0.3rem;
        }

        .related-product-price {
            color: #b27d6a;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .empty-related {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: 28px;
            color: var(--color-text-soft);
        }

        /* Responsive Styles */
        @media (max-width: 1024px) {
            .product-details-container {
                gap: var(--spacing-md);
            }
            .related-products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 768px) {
            .product-details-container {
                grid-template-columns: 1fr;
            }
            .related-products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .tab-headers {
                gap: 1rem;
                flex-wrap: wrap;
            }
            .thumbnail {
                width: 60px;
                height: 60px;
            }
        }

        @media (max-width: 576px) {
            .related-products-grid {
                grid-template-columns: 1fr;
                max-width: 300px;
                margin: 0 auto;
            }
            .product-actions {
                flex-direction: column;
            }
            .btn-buy-now, .btn-add-to-cart, .btn-wishlist {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    
    <!-- Breadcrumb -->
    <div class="breadcrumb editable-section" data-section="54">
        <div class="container">
            <a href="?page=home">Home</a> <span>/</span>
            <a href="?page=shop">Shop</a> <span>/</span>
            <span class="current-product">Radiance Renewal Serum</span>
        </div>
    </div>

    <!-- Product Details -->
    <div class="container">
        <div class="product-details-container">
            <!-- Product Images -->
            <div class="product-images editable-section no-drop-zone" data-section="55">
                <div class="main-image-container">
                    <img src="https://images.unsplash.com/photo-1620916566390-2f2e2c6e6b0f?w=600&auto=format" alt="Main product" class="main-image editable-image" id="mainImage" data-image="8">
                </div>
                <div class="thumbnail-container">
                    <img src="https://images.unsplash.com/photo-1620916566390-2f2e2c6e6b0f?w=100&auto=format" alt="Thumbnail 1" class="thumbnail active" data-image="https://images.unsplash.com/photo-1620916566390-2f2e2c6e6b0f?w=600&auto=format">
                    <img src="https://images.unsplash.com/photo-1570197579656-5b4b8e9b2c5f?w=100&auto=format" alt="Thumbnail 2" class="thumbnail" data-image="https://images.unsplash.com/photo-1570197579656-5b4b8e9b2c5f?w=600&auto=format">
                    <img src="https://images.unsplash.com/photo-1625772452859-3c03d5e2f5a1?w=100&auto=format" alt="Thumbnail 3" class="thumbnail" data-image="https://images.unsplash.com/photo-1625772452859-3c03d5e2f5a1?w=600&auto=format">
                    <img src="https://images.unsplash.com/photo-1616671331185-3c5f2d9a5b5e?w=100&auto=format" alt="Thumbnail 4" class="thumbnail" data-image="https://images.unsplash.com/photo-1616671331185-3c5f2d9a5b5e?w=600&auto=format">
                </div>
            </div>

            <!-- Product Info -->
            <div class="product-info editable-section no-drop-zone" data-section="56">
                <h1 class="product-title editable-text editable-section no-drop-zone" data-section="57" data-text="38">Radiance Renewal Serum</h1>
                
                <div class="product-rating">
                    <div class="stars">
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star"></i>
                        <i class="fas fa-star-half-alt"></i>
                    </div>
                    <span class="rating-count">(128 Reviews)</span>
                </div>

                <div class="product-price editable-section no-drop-zone" data-section="59">$78</div>
                
                <p class="product-description editable-text editable-section no-drop-zone" data-section="60" data-text="39">
                    A potent yet gentle serum formulated with hyaluronic acid, vitamin C, and botanical extracts. 
                    This lightweight formula absorbs quickly to hydrate, brighten, and smooth the skin's texture, 
                    revealing a radiant, youthful glow with consistent use.
                </p>

                <!-- Color Variants -->
                <div class="product-variants">
                    <div class="variant-title">Color</div>
                    <div class="variant-options">
                        <div class="color-option active" style="background-color: #F9D0BE;" data-color="blush"></div>
                        <div class="color-option" style="background-color: #E1C6D6;" data-color="lavender"></div>
                        <div class="color-option" style="background-color: #F4E6CB;" data-color="cream"></div>
                    </div>
                </div>

                <!-- Size Variants -->
                <div class="product-variants">
                    <div class="variant-title">Size</div>
                    <div class="variant-options">
                        <div class="variant-option active" data-size="30ml">30ml</div>
                        <div class="variant-option" data-size="50ml">50ml</div>
                        <div class="variant-option" data-size="100ml">100ml</div>
                    </div>
                </div>

                <!-- Quantity Selector -->
                <div class="quantity-selector">
                    <div class="quantity-title">Quantity</div>
                    <div class="quantity-control">
                        <button class="quantity-btn" id="decrementQty">-</button>
                        <input type="number" class="quantity-input" id="quantity" value="1" min="1" max="10">
                        <button class="quantity-btn" id="incrementQty">+</button>
                    </div>
                </div>

                <!-- Product Actions -->
                <div class="product-actions">
                    <button class="btn-buy-now editable-text editable-section no-drop-zone" data-section="61" data-text="40">
                        <i class="fas fa-bolt"></i> Buy Now
                    </button>
                    <button class="btn-add-to-cart editable-text editable-section no-drop-zone" data-section="62" data-text="41">
                        <i class="fas fa-shopping-bag"></i> Add to Cart
                    </button>
                    <button class="btn-wishlist">
                        <i class="far fa-heart"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Product Tabs -->
        <div class="product-tabs editable-section" data-section="63">
            <div class="tab-headers">
                <button class="tab-header active" data-tab="description">Description</button>
                <button class="tab-header" data-tab="ingredients">Ingredients</button>
                <button class="tab-header" data-tab="how-to-use">How to Use</button>
                <button class="tab-header" data-tab="reviews">Reviews</button>
            </div>

            <div class="tab-content active" id="description-tab">
                <h3>Product Description</h3>
                <p>Our Radiance Renewal Serum is a powerhouse formula designed to transform dull, tired skin into a luminous, youthful complexion. Formulated with the highest concentration of active ingredients, this serum delivers visible results in just 14 days.</p>
                <br>
                <p><strong>Key Benefits:</strong></p>
                <ul style="margin-left: 1.5rem; margin-top: 0.5rem;">
                    <li>Brightens and evens skin tone</li>
                    <li>Deeply hydrates for plump, dewy skin</li>
                    <li>Reduces appearance of fine lines and wrinkles</li>
                    <li>Strengthens skin barrier</li>
                    <li>Protects against environmental stressors</li>
                </ul>
            </div>

            <div class="tab-content" id="ingredients-tab">
                <h3>Ingredients</h3>
                <p>Water (Aqua), Glycerin, Hyaluronic Acid, Vitamin C (Ascorbic Acid), Niacinamide, Ferulic Acid, Jojoba Oil, Shea Butter, Vitamin E, Green Tea Extract, Aloe Vera, Rosemary Extract.</p>
                <br>
                <p><strong>Free From:</strong> Parabens, Sulfates, Phthalates, Synthetic Fragrance, Mineral Oil, Animal Testing</p>
            </div>

            <div class="tab-content" id="how-to-use-tab">
                <h3>How to Use</h3>
                <p>Apply 2-3 drops to clean, dry skin morning and night. Gently massage into face, neck, and décolletage until fully absorbed. Follow with moisturizer. For best results, use consistently and always wear SPF during the day.</p>
                <br>
                <p><strong>Pro Tip:</strong> For enhanced results, apply while skin is slightly damp from your toner to lock in maximum hydration.</p>
            </div>

            <div class="tab-content" id="reviews-tab">
                <!-- Review Form -->
                <div class="review-form">
                    <h3>Write a Review</h3>
                    <form id="reviewForm">
                        <div class="rating-input">
                            <label>Your Rating</label>
                            <div class="star-rating-input" id="starRating">
                                <span class="star" data-rating="1">★</span>
                                <span class="star" data-rating="2">★</span>
                                <span class="star" data-rating="3">★</span>
                                <span class="star" data-rating="4">★</span>
                                <span class="star" data-rating="5">★</span>
                            </div>
                            <input type="hidden" id="ratingValue" name="rating" value="0">
                        </div>
                        <div class="form-group">
                            <label for="reviewerName">Your Name</label>
                            <input type="text" id="reviewerName" name="name" required>
                        </div>
                        <div class="form-group">
                            <label for="reviewTitle">Review Title</label>
                            <input type="text" id="reviewTitle" name="title" required>
                        </div>
                        <div class="form-group">
                            <label for="reviewText">Your Review</label>
                            <textarea id="reviewText" name="review" rows="4" required></textarea>
                        </div>
                        <button type="submit" class="btn-submit-review">Submit Review</button>
                    </form>
                </div>

                <!-- Customer Reviews -->
                <div class="customer-reviews">
                    <h3>Customer Reviews</h3>
                    <div class="review-item">
                        <div class="review-header">
                            <span class="reviewer-name">Sarah M.</span>
                            <span class="review-date">March 15, 2024</span>
                        </div>
                        <div class="review-rating">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="review-title">Absolutely obsessed!</div>
                        <div class="review-text">This serum has transformed my skin! After just two weeks, my complexion is brighter, more even, and so hydrated. Definitely a holy grail product.</div>
                    </div>
                    <div class="review-item">
                        <div class="review-header">
                            <span class="reviewer-name">Jennifer K.</span>
                            <span class="review-date">March 10, 2024</span>
                        </div>
                        <div class="review-rating">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="far fa-star"></i>
                        </div>
                        <div class="review-title">Lovely texture, great results</div>
                        <div class="review-text">Love how lightweight this serum is. It absorbs quickly and doesn't feel sticky. My skin feels so soft and looks glowy!</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <div class="related-products">
            <h2>You May Also Like</h2>
            <div class="related-products-grid">
                <div class="related-product-card">
                    <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=300&auto=format" alt="Milky Hydra Cleanser" class="related-product-img">
                    <div class="related-product-info">
                        <div class="related-product-name">Milky Hydra Cleanser</div>
                        <div class="related-product-price">$42</div>
                    </div>
                </div>
                <div class="related-product-card">
                    <img src="https://images.unsplash.com/photo-1570554886111-e80fcca6a029?w=300&auto=format" alt="Dewy Barrier Moisturizer" class="related-product-img">
                    <div class="related-product-info">
                        <div class="related-product-name">Dewy Barrier Moisturizer</div>
                        <div class="related-product-price">$64</div>
                    </div>
                </div>
                <div class="related-product-card">
                    <img src="https://images.unsplash.com/photo-1617897903246-71924e6b2e6c?w=300&auto=format" alt="Overnight Recovery Mask" class="related-product-img">
                    <div class="related-product-info">
                        <div class="related-product-name">Overnight Recovery Mask</div>
                        <div class="related-product-price">$58</div>
                    </div>
                </div>
                <div class="related-product-card">
                    <img src="https://images.unsplash.com/photo-1625772452859-3c03d5e2f5a1?w=300&auto=format" alt="Vitamin C Brightening Cream" class="related-product-img">
                    <div class="related-product-info">
                        <div class="related-product-name">Vitamin C Brightening Cream</div>
                        <div class="related-product-price">$52</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Image Thumbnail Switcher
        const thumbnails = document.querySelectorAll('.thumbnail');
        const mainImage = document.getElementById('mainImage');

        thumbnails.forEach(thumb => {
            thumb.addEventListener('click', function() {
                thumbnails.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                const newImage = this.getAttribute('data-image');
                if (newImage) {
                    mainImage.src = newImage;
                }
            });
        });

        // Color Variant Selection
        const colorOptions = document.querySelectorAll('.color-option');
        colorOptions.forEach(option => {
            option.addEventListener('click', function() {
                colorOptions.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                console.log('Selected color:', this.getAttribute('data-color'));
            });
        });

        // Size Variant Selection
        const sizeOptions = document.querySelectorAll('.variant-option[data-size]');
        sizeOptions.forEach(option => {
            option.addEventListener('click', function() {
                sizeOptions.forEach(s => s.classList.remove('active'));
                this.classList.add('active');
                console.log('Selected size:', this.getAttribute('data-size'));
            });
        });

        // Quantity Controls
        const quantityInput = document.getElementById('quantity');
        const decrementBtn = document.getElementById('decrementQty');
        const incrementBtn = document.getElementById('incrementQty');

        decrementBtn.addEventListener('click', () => {
            let value = parseInt(quantityInput.value);
            if (value > 1) {
                quantityInput.value = value - 1;
            }
        });

        incrementBtn.addEventListener('click', () => {
            let value = parseInt(quantityInput.value);
            if (value < 10) {
                quantityInput.value = value + 1;
            }
        });

        quantityInput.addEventListener('change', () => {
            let value = parseInt(quantityInput.value);
            if (isNaN(value) || value < 1) quantityInput.value = 1;
            if (value > 10) quantityInput.value = 10;
        });

        // Tab Switching
        const tabHeaders = document.querySelectorAll('.tab-header');
        const tabContents = document.querySelectorAll('.tab-content');

        tabHeaders.forEach(header => {
            header.addEventListener('click', function() {
                const tabId = this.getAttribute('data-tab');
                tabHeaders.forEach(h => h.classList.remove('active'));
                tabContents.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                document.getElementById(`${tabId}-tab`).classList.add('active');
            });
        });

        // Star Rating System
        const stars = document.querySelectorAll('.star-rating-input .star');
        const ratingValue = document.getElementById('ratingValue');

        stars.forEach(star => {
            star.addEventListener('click', function() {
                const rating = parseInt(this.getAttribute('data-rating'));
                ratingValue.value = rating;
                stars.forEach((s, index) => {
                    if (index < rating) {
                        s.classList.add('selected');
                    } else {
                        s.classList.remove('selected');
                    }
                });
            });
        });

        // Review Form Submission
        const reviewForm = document.getElementById('reviewForm');
        if (reviewForm) {
            reviewForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const name = document.getElementById('reviewerName').value;
                const title = document.getElementById('reviewTitle').value;
                const review = document.getElementById('reviewText').value;
                const rating = ratingValue.value;

                if (rating === '0') {
                    alert('Please select a rating');
                    return;
                }

                console.log('Review submitted:', { name, title, review, rating });
                alert('Thank you for your review!');
                reviewForm.reset();
                stars.forEach(s => s.classList.remove('selected'));
                ratingValue.value = '0';
            });
        }

        // Add to Cart Button
        document.querySelector('.btn-add-to-cart').addEventListener('click', function() {
            const quantity = document.getElementById('quantity').value;
            const selectedColor = document.querySelector('.color-option.active')?.getAttribute('data-color') || 'default';
            const selectedSize = document.querySelector('.variant-option.active')?.getAttribute('data-size') || 'default';
            console.log('Added to cart:', { quantity, color: selectedColor, size: selectedSize });
            alert('Item added to cart!');
        });

        // Buy Now Button
        document.querySelector('.btn-buy-now').addEventListener('click', function() {
            const quantity = document.getElementById('quantity').value;
            const selectedColor = document.querySelector('.color-option.active')?.getAttribute('data-color') || 'default';
            const selectedSize = document.querySelector('.variant-option.active')?.getAttribute('data-size') || 'default';
            console.log('Buy Now:', { quantity, color: selectedColor, size: selectedSize });
            alert('Proceeding to checkout...');
        });

        // Wishlist Button
        document.querySelector('.btn-wishlist').addEventListener('click', function() {
            this.classList.toggle('active');
            const icon = this.querySelector('i');
            if (icon.classList.contains('far')) {
                icon.classList.remove('far');
                icon.classList.add('fas');
                icon.style.color = '#b27d6a';
                alert('Added to wishlist!');
            } else {
                icon.classList.remove('fas');
                icon.classList.add('far');
                icon.style.color = '';
                alert('Removed from wishlist!');
            }
        });
    </script>
</body>
</html>