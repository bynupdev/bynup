<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist - Pure Beauty, Refined</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --color-bg-primary: #F2E7E2;
            --color-bg-soft: #F4E6CB;
            --color-accent-warm: #F9D0BE;
            --color-lavender: #E1C6D6;
            --color-text-dark: #2c2a2a;
            --color-text-soft: #5e5a5a;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 24px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--color-bg-primary);
            color: var(--color-text-dark);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 90px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header.editable-section[data-section="85"] {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1.wishlist-title.editable-text.editable-section.no-drop-zone[data-section="86"] {
            font-size: 3rem;
            color: var(--color-text-dark);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1.wishlist-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--color-accent-warm), var(--color-lavender));
        }

        .wishlist-subtitle.editable-text.editable-section.no-drop-zone[data-section="87"] {
            color: var(--color-text-soft);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Wishlist Stats */
        .wishlist-stats {
            padding: 2rem 0;
            margin-bottom: var(--spacing-lg);
        }

        .stats-container {
            display: flex;
            justify-content: center;
            gap: 3rem;
            flex-wrap: wrap;
        }

        .stat-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
        }

        .stat-value {
            font-size: 2rem;
            color: #b27d6a;
            font-weight: 500;
            font-family: 'Cormorant Garamond', serif;
        }

        .stat-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-text-soft);
        }

        /* Wishlist Actions */
        .wishlist-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .wishlist-filters {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 0.6rem 1.2rem;
            background: white;
            border: 1px solid rgba(44, 42, 42, 0.2);
            border-radius: 50px;
            color: var(--color-text-dark);
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-btn:hover {
            border-color: #b27d6a;
            color: #b27d6a;
        }

        .filter-btn.active {
            background: var(--color-accent-warm);
            border-color: var(--color-accent-warm);
            color: var(--color-text-dark);
        }

        .btn-clear-wishlist {
            padding: 0.6rem 1.2rem;
            background: transparent;
            border: 1px solid rgba(44, 42, 42, 0.2);
            border-radius: 50px;
            color: var(--color-text-soft);
            font-size: 0.85rem;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-clear-wishlist:hover {
            border-color: #dc3545;
            color: #dc3545;
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-xl);
        }

        .wishlist-item.editable-section.no-drop-zone[data-section="88"] {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
            position: relative;
        }

        .wishlist-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
        }

        .wishlist-item-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .wishlist-item:hover .wishlist-item-image {
            transform: scale(1.02);
        }

        .wishlist-item-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: var(--color-accent-warm);
            color: var(--color-text-dark);
            padding: 0.3rem 0.8rem;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 500;
            z-index: 2;
        }

        .wishlist-item-actions {
            position: absolute;
            top: 1rem;
            left: 1rem;
            display: flex;
            gap: 0.5rem;
            opacity: 0;
            transition: var(--transition);
            z-index: 2;
        }

        .wishlist-item:hover .wishlist-item-actions {
            opacity: 1;
        }

        .wishlist-action-btn {
            width: 32px;
            height: 32px;
            background: white;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            color: var(--color-text-dark);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .wishlist-action-btn:hover {
            background: #b27d6a;
            color: white;
            transform: scale(1.1);
        }

        .wishlist-item-info {
            padding: 1rem;
        }

        .wishlist-item-category.editable-section.no-drop-zone[data-section="89"] {
            color: var(--color-accent-warm);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.3rem;
        }

        .wishlist-item-name.editable-section.no-drop-zone[data-section="90"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        .wishlist-item-price.editable-section.no-drop-zone[data-section="91"] {
            color: #b27d6a;
            font-weight: 500;
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        .wishlist-item-actions-bottom {
            display: flex;
            gap: 0.8rem;
        }

        .btn-add-to-cart-wishlist {
            flex: 1;
            background: linear-gradient(135deg, var(--color-accent-warm), var(--color-lavender));
            color: var(--color-text-dark);
            padding: 0.6rem;
            font-size: 0.8rem;
            font-weight: 500;
            border-radius: 50px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-add-to-cart-wishlist:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(249, 208, 190, 0.4);
        }

        .btn-view-details {
            width: 36px;
            background: white;
            border: 1px solid rgba(44, 42, 42, 0.2);
            border-radius: 50px;
            color: var(--color-text-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }

        .btn-view-details:hover {
            background: rgba(249, 208, 190, 0.2);
            color: #b27d6a;
            border-color: #b27d6a;
        }

        /* Empty Wishlist State */
        .empty-wishlist {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            background: white;
            border-radius: 28px;
            margin: var(--spacing-lg) 0;
        }

        .empty-wishlist-icon {
            font-size: 4rem;
            color: var(--color-accent-warm);
            margin-bottom: var(--spacing-md);
        }

        .empty-wishlist h2 {
            font-size: 1.8rem;
            color: var(--color-text-dark);
            margin-bottom: var(--spacing-sm);
        }

        .empty-wishlist p {
            color: var(--color-text-soft);
            margin-bottom: var(--spacing-md);
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .browse-collections-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--color-accent-warm), var(--color-lavender));
            color: var(--color-text-dark);
            padding: 1rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            text-decoration: none;
            border-radius: 50px;
            transition: var(--transition);
        }

        .browse-collections-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(249, 208, 190, 0.4);
        }

        /* Recently Viewed Section */
        .recently-viewed {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(44, 42, 42, 0.1);
        }

        .recently-viewed h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--color-text-dark);
        }

        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .recent-product-card {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
            text-decoration: none;
            color: inherit;
        }

        .recent-product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
        }

        .recent-product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .recent-product-card:hover .recent-product-img {
            transform: scale(1.02);
        }

        .recent-product-info {
            padding: 1rem;
        }

        .recent-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 500;
            margin-bottom: 0.3rem;
        }

        .recent-product-price {
            color: #b27d6a;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .empty-recent {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: 28px;
            color: var(--color-text-soft);
            grid-column: 1 / -1;
        }

        /* Responsive Styles */
        @media (max-width: 1024px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 768px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .stats-container {
                gap: 1.5rem;
            }
            .wishlist-actions {
                flex-direction: column;
                align-items: stretch;
            }
            .wishlist-filters {
                justify-content: center;
            }
            .btn-clear-wishlist {
                justify-content: center;
            }
        }

        @media (max-width: 576px) {
            .wishlist-grid,
            .recently-viewed-grid {
                grid-template-columns: 1fr;
                max-width: 300px;
                margin: 0 auto;
            }
            .stats-container {
                gap: 1rem;
            }
            .stat-value {
                font-size: 1.5rem;
            }
            .wishlist-item-actions {
                opacity: 1;
            }
        }

       
    </style>
</head>
<body>
    
    <!-- Page Header -->
    <div class="page-header editable-section" data-section="85">
        <div class="container">
            <h1 class="wishlist-title editable-text editable-section no-drop-zone" data-section="86" data-text="50">My Wishlist</h1>
            <p class="wishlist-subtitle editable-text editable-section no-drop-zone" data-section="87" data-text="51">Save your favorite skincare products and purchase them when you're ready</p>
        </div>
    </div>

    <!-- Wishlist Stats -->
    <div class="wishlist-stats">
        <div class="container">
            <div class="stats-container">
                <div class="stat-item">
                    <span class="stat-value" id="items-count">4</span>
                    <span class="stat-label">Items Saved</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value" id="sale-count">2</span>
                    <span class="stat-label">On Sale</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value" id="total-value">$242</span>
                    <span class="stat-label">Total Value</span>
                </div>
                <div class="stat-item">
                    <span class="stat-value" id="low-stock-count">1</span>
                    <span class="stat-label">Low in Stock</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Wishlist Content -->
    <div class="container">
        <div class="wishlist-actions">
            <div class="wishlist-filters">
                <button class="filter-btn active" data-filter="all">All Items</button>
                <button class="filter-btn" data-filter="on-sale">On Sale</button>
                <button class="filter-btn" data-filter="in-stock">In Stock</button>
                <button class="filter-btn" data-filter="new-arrivals">New Arrivals</button>
            </div>
            <button class="btn-clear-wishlist" id="clear-wishlist-btn">
                <i class="fas fa-trash-alt"></i> Clear Wishlist
            </button>
        </div>

        <div class="wishlist-grid" id="wishlist-grid">
            <!-- Wishlist Item 1 (Editable) -->
            <div class="wishlist-item editable-section no-drop-zone" data-section="88" data-category="serum" data-status="in-stock" data-badge="sale">
                <div class="wishlist-item-badge">SALE</div>
                <div class="wishlist-item-actions">
                    <button class="wishlist-action-btn remove-wishlist" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>
                    <button class="wishlist-action-btn move-to-cart" title="Move to Cart">
                        <i class="fas fa-shopping-bag"></i>
                    </button>
                </div>
                <img src="https://images.unsplash.com/photo-1620916566390-2f2e2c6e6b0f?w=300&auto=format" alt="Radiance Renewal Serum" class="wishlist-item-image editable-image" data-image="10">
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category editable-section no-drop-zone" data-section="89" data-text="52">SERUM</div>
                    <div class="wishlist-item-name editable-section no-drop-zone" data-section="90" data-text="53">Radiance Renewal Serum</div>
                    <div class="wishlist-item-price editable-section no-drop-zone" data-section="91" data-text="54">$78</div>
                    <div class="wishlist-item-actions-bottom">
                        <button class="btn-add-to-cart-wishlist" data-product-id="1">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                        <a href="?page=product-details&id=1" class="btn-view-details">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Wishlist Item 2 (Non-editable sample) -->
            <div class="wishlist-item" data-category="cleanser" data-status="in-stock" data-badge="">
                <div class="wishlist-item-actions">
                    <button class="wishlist-action-btn remove-wishlist" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>
                    <button class="wishlist-action-btn move-to-cart" title="Move to Cart">
                        <i class="fas fa-shopping-bag"></i>
                    </button>
                </div>
                <img src="https://images.unsplash.com/photo-1556228720-195a672e8a03?w=300&auto=format" alt="Milky Hydra Cleanser" class="wishlist-item-image">
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category">CLEANSER</div>
                    <div class="wishlist-item-name">Milky Hydra Cleanser</div>
                    <div class="wishlist-item-price">$42</div>
                    <div class="wishlist-item-actions-bottom">
                        <button class="btn-add-to-cart-wishlist" data-product-id="2">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                        <a href="?page=product-details&id=2" class="btn-view-details">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Wishlist Item 3 (Non-editable sample) -->
            <div class="wishlist-item" data-category="moisturizer" data-status="low-stock" data-badge="low-stock">
                <div class="wishlist-item-badge">LOW STOCK</div>
                <div class="wishlist-item-actions">
                    <button class="wishlist-action-btn remove-wishlist" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>
                    <button class="wishlist-action-btn move-to-cart" title="Move to Cart">
                        <i class="fas fa-shopping-bag"></i>
                    </button>
                </div>
                <img src="https://images.unsplash.com/photo-1570554886111-e80fcca6a029?w=300&auto=format" alt="Dewy Barrier Moisturizer" class="wishlist-item-image">
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category">MOISTURIZER</div>
                    <div class="wishlist-item-name">Dewy Barrier Moisturizer</div>
                    <div class="wishlist-item-price">$64</div>
                    <div class="wishlist-item-actions-bottom">
                        <button class="btn-add-to-cart-wishlist" data-product-id="3">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                        <a href="?page=product-details&id=3" class="btn-view-details">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Wishlist Item 4 (Non-editable sample) -->
            <div class="wishlist-item" data-category="mask" data-status="in-stock" data-badge="new">
                <div class="wishlist-item-badge">NEW</div>
                <div class="wishlist-item-actions">
                    <button class="wishlist-action-btn remove-wishlist" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>
                    <button class="wishlist-action-btn move-to-cart" title="Move to Cart">
                        <i class="fas fa-shopping-bag"></i>
                    </button>
                </div>
                <img src="https://images.unsplash.com/photo-1617897903246-71924e6b2e6c?w=300&auto=format" alt="Overnight Recovery Mask" class="wishlist-item-image">
                <div class="wishlist-item-info">
                    <div class="wishlist-item-category">MASK</div>
                    <div class="wishlist-item-name">Overnight Recovery Mask</div>
                    <div class="wishlist-item-price">$58</div>
                    <div class="wishlist-item-actions-bottom">
                        <button class="btn-add-to-cart-wishlist" data-product-id="4">
                            <i class="fas fa-shopping-bag"></i> Add to Cart
                        </button>
                        <a href="?page=product-details&id=4" class="btn-view-details">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recently Viewed Section -->
        <div class="recently-viewed">
            <h2>Recently Viewed</h2>
            <div class="recently-viewed-grid">
                <a href="?page=product-details&id=5" class="recent-product-card">
                    <img src="https://images.unsplash.com/photo-1625772452859-3c03d5e2f5a1?w=300&auto=format" alt="Vitamin C Brightening Cream" class="recent-product-img">
                    <div class="recent-product-info">
                        <div class="recent-product-name">Vitamin C Brightening Cream</div>
                        <div class="recent-product-price">$52</div>
                    </div>
                </a>
                <a href="?page=product-details&id=6" class="recent-product-card">
                    <img src="https://images.unsplash.com/photo-1616671331185-3c5f2d9a5b5e?w=300&auto=format" alt="Hydrating Eye Cream" class="recent-product-img">
                    <div class="recent-product-info">
                        <div class="recent-product-name">Hydrating Eye Cream</div>
                        <div class="recent-product-price">$48</div>
                    </div>
                </a>
                <a href="?page=product-details&id=7" class="recent-product-card">
                    <img src="https://images.unsplash.com/photo-1625772452859-3c03d5e2f5a1?w=300&auto=format" alt="Niacinamide Serum" class="recent-product-img">
                    <div class="recent-product-info">
                        <div class="recent-product-name">Niacinamide 10% Serum</div>
                        <div class="recent-product-price">$45</div>
                    </div>
                </a>
                <a href="?page=product-details&id=8" class="recent-product-card">
                    <img src="https://images.unsplash.com/photo-1616671331185-3c5f2d9a5b5e?w=300&auto=format" alt="Gentle Exfoliating Toner" class="recent-product-img">
                    <div class="recent-product-info">
                        <div class="recent-product-name">Gentle Exfoliating Toner</div>
                        <div class="recent-product-price">$38</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <script>
        // Wishlist Management
        let currentFilter = 'all';

        // Update stats
        function updateWishlistStats() {
            const items = document.querySelectorAll('.wishlist-item');
            const itemCount = items.length;
            let onSaleCount = 0;
            let totalValue = 0;
            let lowStockCount = 0;

            items.forEach(item => {
                const badge = item.querySelector('.wishlist-item-badge');
                if (badge && (badge.textContent.includes('SALE') || badge.textContent.includes('sale'))) {
                    onSaleCount++;
                }
                
                const priceText = item.querySelector('.wishlist-item-price').textContent;
                const price = parseFloat(priceText.replace('$', ''));
                totalValue += price;
                
                if (badge && badge.textContent.includes('LOW STOCK')) {
                    lowStockCount++;
                }
            });

            document.getElementById('items-count').textContent = itemCount;
            document.getElementById('sale-count').textContent = onSaleCount;
            document.getElementById('total-value').textContent = `$${totalValue}`;
            document.getElementById('low-stock-count').textContent = lowStockCount;
        }

        // Filter wishlist items
        function filterWishlistItems() {
            const items = document.querySelectorAll('.wishlist-item');
            let visibleCount = 0;

            items.forEach(item => {
                const category = item.getAttribute('data-category');
                const status = item.getAttribute('data-status');
                const badge = item.getAttribute('data-badge');
                let shouldShow = true;

                switch(currentFilter) {
                    case 'on-sale':
                        shouldShow = badge === 'sale';
                        break;
                    case 'in-stock':
                        shouldShow = status === 'in-stock';
                        break;
                    case 'new-arrivals':
                        shouldShow = badge === 'new';
                        break;
                    case 'all':
                    default:
                        shouldShow = true;
                        break;
                }

                if (shouldShow) {
                    item.style.display = 'block';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Update filter buttons
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.getAttribute('data-filter') === currentFilter) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
        }

        // Remove item from wishlist
        function removeWishlistItem(button) {
            const item = button.closest('.wishlist-item');
            if (item) {
                item.remove();
                updateWishlistStats();
                filterWishlistItems();
                
                // Check if wishlist is empty
                const remainingItems = document.querySelectorAll('.wishlist-item');
                if (remainingItems.length === 0) {
                    showEmptyWishlistState();
                }
            }
        }

        // Move item to cart
        function moveToCart(button) {
            const item = button.closest('.wishlist-item');
            if (item) {
                const productName = item.querySelector('.wishlist-item-name').textContent;
                console.log(`Moved ${productName} to cart`);
                alert(`${productName} added to cart!`);
                item.remove();
                updateWishlistStats();
                filterWishlistItems();
            }
        }

        // Clear entire wishlist
        function clearWishlist() {
            if (confirm('Are you sure you want to clear your entire wishlist?')) {
                const wishlistGrid = document.getElementById('wishlist-grid');
                if (wishlistGrid) {
                    wishlistGrid.innerHTML = '';
                    showEmptyWishlistState();
                    updateWishlistStats();
                }
            }
        }

        // Show empty wishlist state
        function showEmptyWishlistState() {
            const wishlistGrid = document.getElementById('wishlist-grid');
            if (wishlistGrid && wishlistGrid.children.length === 0) {
                wishlistGrid.innerHTML = `
                    <div class="empty-wishlist" style="grid-column: 1 / -1;">
                        <div class="empty-wishlist-icon">
                            <i class="far fa-heart"></i>
                        </div>
                        <h2>Your Wishlist is Empty</h2>
                        <p>Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready.</p>
                        <a href="?page=shop" class="browse-collections-btn">Start Shopping</a>
                    </div>
                `;
            }
        }

        // Event Listeners
        document.addEventListener('DOMContentLoaded', function() {
            updateWishlistStats();

            // Filter buttons
            document.querySelectorAll('.filter-btn').forEach(button => {
                button.addEventListener('click', function() {
                    currentFilter = this.getAttribute('data-filter');
                    filterWishlistItems();
                });
            });

            // Remove buttons
            document.querySelectorAll('.remove-wishlist').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    removeWishlistItem(this);
                });
            });

            // Move to cart buttons
            document.querySelectorAll('.move-to-cart').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    moveToCart(this);
                });
            });

            // Add to cart buttons
            document.querySelectorAll('.btn-add-to-cart-wishlist').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const productId = this.getAttribute('data-product-id');
                    console.log(`Added product ${productId} to cart`);
                    alert('Item added to cart!');
                });
            });

            // Clear wishlist button
            const clearBtn = document.getElementById('clear-wishlist-btn');
            if (clearBtn) {
                clearBtn.addEventListener('click', clearWishlist);
            }

            // Initialize filter
            filterWishlistItems();
        });
    </script>
</body>
</html>