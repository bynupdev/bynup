<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | TechSphere</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-brown: #B0988B;
            --primary-teal: #4D8581;
            --primary-aqua: #ABDED7;
            --dark-gray: #333333;
            --light-gray: #f8f9fa;
            --medium-gray: #e9ecef;
            --white: #ffffff;
            --black: #222222;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            color: var(--dark-gray);
            background-color: var(--white);
            overflow-x: hidden;
        }

        h1, h2, h3, h4 {
            font-family: 'Roboto', sans-serif;
            font-weight: 600;
            line-height: 1.3;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .action-primary {
            display: inline-block;
            padding: 14px 32px;
            background-color: var(--primary-teal);
            color: var(--white);
            border: none;
            border-radius: 4px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
        }

        .action-primary:hover {
            background-color: var(--primary-brown);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        .action-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-teal);
            color: var(--primary-teal);
            padding: 12px 28px;
            font-weight: 600;
            font-size: 1rem;
            border-radius: 4px;
            cursor: pointer;
            transition: var(--transition);
        }

        .action-secondary:hover {
            background-color: var(--primary-teal);
            color: var(--white);
        }

        .action-accent {
            display: inline-block;
            padding: 14px 32px;
            background-color: var(--primary-brown);
            color: var(--white);
            border: none;
            border-radius: 4px;
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
            text-align: center;
        }

        .action-accent:hover {
            background-color: var(--primary-teal);
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }

        /* Cart Header */
        .cart-header {
            padding: 100px 0 40px;
            background-color: var(--light-gray);
            margin-top: 70px;
        }

        .page-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        /* Cart Layout */
        .cart-layout {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
            padding: 40px 0 80px;
        }

        /* Cart Items */
        .cart-items {
            background-color: var(--white);
            border-radius: 12px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .cart-item {
            display: grid;
            grid-template-columns: 120px 1fr auto;
            gap: 20px;
            padding: 25px;
            border-bottom: 1px solid var(--medium-gray);
            align-items: center;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-item-image {
            width: 120px;
            height: 120px;
            border-radius: 8px;
            overflow: hidden;
            background-color: var(--medium-gray);
        }

        .cart-item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cart-item-details {
            flex: 1;
        }

        .cart-item-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .cart-item-variant {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .cart-item-price {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--primary-teal);
            margin-bottom: 15px;
        }

        .cart-item-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            border: 2px solid var(--medium-gray);
            border-radius: 6px;
            overflow: hidden;
        }

        .quantity-btn {
            width: 36px;
            height: 36px;
            background-color: var(--light-gray);
            border: none;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .quantity-btn:hover {
            background-color: var(--medium-gray);
        }

        .quantity-input {
            width: 50px;
            height: 36px;
            text-align: center;
            border: none;
            font-size: 1rem;
            font-weight: 600;
        }

        .remove-item {
            color: #ff4444;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 0.9rem;
            transition: var(--transition);
            padding: 8px 15px;
            border-radius: 4px;
        }

        .remove-item:hover {
            background-color: #fff5f5;
        }

        .cart-item-total {
            text-align: right;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--dark-gray);
            min-width: 100px;
        }

        /* Cart Summary */
        .cart-summary {
            background-color: var(--white);
            border-radius: 12px;
            box-shadow: var(--shadow);
            padding: 30px;
            position: sticky;
            top: 100px;
            height: fit-content;
        }

        .summary-title {
            font-size: 1.5rem;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid var(--medium-gray);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 1rem;
        }

        .summary-row.total {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary-teal);
            margin-top: 20px;
            padding-top: 20px;
            border-top: 2px solid var(--medium-gray);
        }

        .coupon-section {
            margin: 25px 0;
            padding: 20px;
            background-color: var(--light-gray);
            border-radius: 8px;
        }

        .coupon-input {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .coupon-input input {
            flex: 1;
            padding: 12px 15px;
            border: 2px solid var(--medium-gray);
            border-radius: 6px;
            font-family: 'Inter', sans-serif;
        }

        .coupon-input button {
            padding: 12px 20px;
            background-color: var(--primary-teal);
            color: var(--white);
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: var(--transition);
        }

        .coupon-input button:hover {
            background-color: var(--primary-brown);
        }

        /* Empty Cart */
        .empty-cart {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-cart-icon {
            font-size: 4rem;
            color: var(--medium-gray);
            margin-bottom: 20px;
        }

        /* You May Also Like */
        .you-may-also-like {
            padding: 60px 0;
            background-color: var(--light-gray);
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .product-card {
            background-color: var(--white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .product-img {
            height: 200px;
            overflow: hidden;
            background-color: var(--medium-gray);
        }

        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }

        .product-card:hover .product-img img {
            transform: scale(1.05);
        }

        .product-info {
            padding: 20px;
        }

        .product-info h3 {
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .product-price {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary-teal);
            margin-bottom: 15px;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .cart-layout {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .cart-summary {
                position: static;
            }
        }

        @media (max-width: 768px) {
            .cart-header {
                padding: 80px 0 30px;
            }
            
            .cart-item {
                grid-template-columns: 100px 1fr;
                grid-template-rows: auto auto;
                gap: 15px;
            }
            
            .cart-item-total {
                grid-column: 2;
                text-align: left;
                margin-top: 10px;
            }
            
            .cart-item-image {
                width: 100px;
                height: 100px;
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }
            
            .page-title {
                flex-direction: column;
                align-items: flex-start;
                gap: 20px;
            }
        }

        @media (max-width: 576px) {
            .cart-item {
                grid-template-columns: 1fr;
                text-align: center;
            }
            
            .cart-item-image {
                margin: 0 auto;
            }
            
            .cart-item-total {
                grid-column: 1;
                text-align: center;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
            }
            
            .cart-item-actions {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <main>
        <!-- Cart Header -->
        <div class="cart-header editable-section no-drop-zone" data-section="155">
            <div class="container">
                <div class="page-title">
                    <h1 class="editable-text editable-section no-drop-zone" data-section="156" data-text="133">Shopping Cart</h1>
                    <a href="?page=products" class="action-secondary editable-text editable-section no-drop-zone" data-section="157" data-text="134">Continue Shopping</a>
                </div>
            </div>
        </div>

        <!-- Cart Content -->
        <section class="cart-content editable-section" data-section="158">
            <div class="container">
                <div class="cart-layout">
                    <!-- Cart Items -->
                    <div class="cart-items">
                        <!-- Cart Item 1 (Editable) -->
                        <div class="cart-item editable-section no-drop-zone" data-section="159">
                            <div class="cart-item-image">
                                <img class="editable-image" data-image="30" src="https://images.unsplash.com/photo-1546868871-7041f2a55e12?ixlib=rb-4.0.3&auto=format&fit=crop&w=1064&q=80" alt="Smart Watch Pro">
                            </div>
                            <div class="cart-item-details">
                                <h3 class="cart-item-name editable-text editable-section no-drop-zone" data-section="160" data-text="135">Smart Watch Pro</h3>
                                <div class="cart-item-variant editable-text editable-section no-drop-zone" data-section="161" data-text="136">Color: Black | Size: 44mm</div>
                                <div class="cart-item-price editable-text editable-section no-drop-zone" data-section="162" data-text="137">$249.99</div>
                                <div class="cart-item-actions">
                                    <div class="quantity-control">
                                        <button class="quantity-btn" onclick="updateQuantity(this, -1)">-</button>
                                        <input type="text" class="quantity-input" value="1" readonly>
                                        <button class="quantity-btn" onclick="updateQuantity(this, 1)">+</button>
                                    </div>
                                    <button class="remove-item editable-text editable-section no-drop-zone" data-section="163" data-text="138" onclick="removeCartItem(this)">Remove</button>
                                </div>
                            </div>
                            <div class="cart-item-total">$249.99</div>
                        </div>
                        
                        <!-- Cart Item 2 (Non-editable - backend populated) -->
                        <div class="cart-item" data-product-id="2">
                            <div class="cart-item-image">
                                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?ixlib=rb-4.0.3&auto=format&fit=crop&w=1170&q=80" alt="Noise-Cancelling Headphones">
                            </div>
                            <div class="cart-item-details">
                                <h3 class="cart-item-name">Noise-Cancelling Headphones</h3>
                                <div class="cart-item-variant">Color: Black</div>
                                <div class="cart-item-price">$189.99</div>
                                <div class="cart-item-actions">
                                    <div class="quantity-control">
                                        <button class="quantity-btn" onclick="updateQuantity(this, -1)">-</button>
                                        <input type="text" class="quantity-input" value="2" readonly>
                                        <button class="quantity-btn" onclick="updateQuantity(this, 1)">+</button>
                                    </div>
                                    <button class="remove-item" onclick="removeCartItem(this)">Remove</button>
                                </div>
                            </div>
                            <div class="cart-item-total">$379.98</div>
                        </div>
                        
                        <!-- Cart Item 3 (Non-editable - backend populated) -->
                        <div class="cart-item" data-product-id="3">
                            <div class="cart-item-image">
                                <img src="https://images.unsplash.com/photo-1545235617-9465d2a55698?ixlib=rb-4.0.3&auto=format&fit=crop&w=1180&q=80" alt="Fast Wireless Charger">
                            </div>
                            <div class="cart-item-details">
                                <h3 class="cart-item-name">Fast Wireless Charger</h3>
                                <div class="cart-item-variant">Color: White</div>
                                <div class="cart-item-price">$39.99</div>
                                <div class="cart-item-actions">
                                    <div class="quantity-control">
                                        <button class="quantity-btn" onclick="updateQuantity(this, -1)">-</button>
                                        <input type="text" class="quantity-input" value="1" readonly>
                                        <button class="quantity-btn" onclick="updateQuantity(this, 1)">+</button>
                                    </div>
                                    <button class="remove-item" onclick="removeCartItem(this)">Remove</button>
                                </div>
                            </div>
                            <div class="cart-item-total">$39.99</div>
                        </div>
                    </div>

                    <!-- Cart Summary -->
                    <div class="cart-summary editable-section no-drop-zone" data-section="164">
                        <h3 class="summary-title editable-text editable-section no-drop-zone" data-section="165" data-text="139">Order Summary</h3>
                        
                        <div class="summary-row">
                            <span class="editable-text editable-section no-drop-zone" data-section="166" data-text="140">Subtotal</span>
                            <span id="subtotal">$669.96</span>
                        </div>
                        <div class="summary-row">
                            <span class="editable-text editable-section no-drop-zone" data-section="167" data-text="141">Shipping</span>
                            <span id="shipping">$9.99</span>
                        </div>
                        <div class="summary-row">
                            <span class="editable-text editable-section no-drop-zone" data-section="168" data-text="142">Tax</span>
                            <span id="tax">$53.60</span>
                        </div>
                        
                        <div class="coupon-section">
                            <div class="editable-text editable-section no-drop-zone" data-section="169" data-text="143">Have a coupon?</div>
                            <div class="coupon-input">
                                <input type="text" placeholder="Enter coupon code" id="coupon-code">
                                <button type="button" onclick="applyCoupon()" class="editable-text editable-section no-drop-zone" data-section="170" data-text="144">Apply</button>
                            </div>
                            <div id="coupon-message" style="display: none; color: var(--primary-teal); margin-top: 10px;"></div>
                        </div>
                        
                        <div class="summary-row total">
                            <span class="editable-text editable-section no-drop-zone" data-section="171" data-text="145">Total</span>
                            <span id="total">$733.55</span>
                        </div>
                        
                        <button class="action-accent" style="width: 100%; margin-top: 30px;" onclick="proceedToCheckout()">
                            <i class="fas fa-lock editable-icon" data-icon="30" data-default-class="fas fa-lock"></i> 
                            <span class="editable-text editable-section no-drop-zone" data-section="172" data-text="146">Proceed to Checkout</span>
                        </button>
                        
                        <div style="text-align: center; margin-top: 20px; color: #666; font-size: 0.9rem;">
                            <i class="fas fa-shield-alt editable-icon" data-icon="31" data-default-class="fas fa-shield-alt"></i> 
                            <span class="editable-text editable-section no-drop-zone" data-section="173" data-text="147">Secure checkout guaranteed</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- You May Also Like -->
        <section class="you-may-also-like editable-section" data-section="174">
            <div class="container">
                <div class="section-header">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="175" data-text="148">You May Also Like</h2>
                    <p class="editable-text editable-section no-drop-zone" data-section="176" data-text="149">Complete your setup with these popular accessories</p>
                </div>
                
                <div class="products-grid" id="related-products-grid">
                    <!-- Related Product 1 (Editable) -->
                    <div class="product-card editable-section no-drop-zone" data-section="177">
                        <div class="product-img">
                            <img class="editable-image" data-image="32" src="https://images.unsplash.com/photo-1530893609608-727a05c4013d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1064&q=80" alt="Adjustable Laptop Stand">
                        </div>
                        <div class="product-info">
                            <h3 class="editable-text editable-section no-drop-zone" data-section="178" data-text="150">Adjustable Laptop Stand</h3>
                            <p class="product-price editable-text editable-section no-drop-zone" data-section="179" data-text="151">$49.99</p>
                            <button class="action-primary editable-text editable-section no-drop-zone" data-section="180" data-text="152" style="width: 100%; margin-top: 15px;" onclick="addToCartFromRelated(1)">Add to Cart</button>
                        </div>
                    </div>
                    
                    <!-- Related Product 2 (Non-editable - backend populated) -->
                    <div class="product-card">
                        <div class="product-img">
                            <img src="https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1170&q=80" alt="Portable Bluetooth Speaker">
                        </div>
                        <div class="product-info">
                            <h3>Portable Bluetooth Speaker</h3>
                            <p class="product-price">$79.99</p>
                            <button class="action-primary" style="width: 100%; margin-top: 15px;" onclick="addToCartFromRelated(2)">Add to Cart</button>
                        </div>
                    </div>
                    
                    <!-- Related Product 3 (Non-editable - backend populated) -->
                    <div class="product-card">
                        <div class="product-img">
                            <img src="https://images.unsplash.com/photo-1586950012036-b957f2c7cbf3?ixlib=rb-4.0.3&auto=format&fit=crop&w=1064&q=80" alt="Smartphone Gimbal Stabilizer">
                        </div>
                        <div class="product-info">
                            <h3>Smartphone Gimbal Stabilizer</h3>
                            <p class="product-price">$89.99</p>
                            <button class="action-primary" style="width: 100%; margin-top: 15px;" onclick="addToCartFromRelated(3)">Add to Cart</button>
                        </div>
                    </div>
                    
                    <!-- Related Product 4 (Non-editable - backend populated) -->
                    <div class="product-card">
                        <div class="product-img">
                            <img src="https://images.unsplash.com/photo-1560769629-975ec94e6a86?ixlib=rb-4.0.3&auto=format&fit=crop&w=1064&q=80" alt="Wireless Gaming Mouse">
                        </div>
                        <div class="product-info">
                            <h3>Wireless Gaming Mouse</h3>
                            <p class="product-price">$69.99</p>
                            <button class="action-primary" style="width: 100%; margin-top: 15px;" onclick="addToCartFromRelated(4)">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script>
        // Update quantity function
        function updateQuantity(button, change) {
            const quantityControl = button.closest('.quantity-control');
            const input = quantityControl.querySelector('.quantity-input');
            let currentValue = parseInt(input.value);
            currentValue += change;
            
            if (currentValue < 1) currentValue = 1;
            if (currentValue > 10) currentValue = 10;
            
            input.value = currentValue;
            updateCartItemTotal(quantityControl.closest('.cart-item'));
            updateCartSummary();
        }
        
        // Update cart item total
        function updateCartItemTotal(cartItem) {
            const priceElement = cartItem.querySelector('.cart-item-price');
            const quantityInput = cartItem.querySelector('.quantity-input');
            const totalElement = cartItem.querySelector('.cart-item-total');
            
            const price = parseFloat(priceElement.textContent.replace('$', ''));
            const quantity = parseInt(quantityInput.value);
            const total = (price * quantity).toFixed(2);
            
            totalElement.textContent = `$${total}`;
        }
        
        // Remove cart item
        function removeCartItem(button) {
            const cartItem = button.closest('.cart-item');
            if (confirm('Are you sure you want to remove this item from your cart?')) {
                cartItem.style.opacity = '0';
                cartItem.style.transform = 'translateX(-20px)';
                
                setTimeout(() => {
                    cartItem.remove();
                    updateCartSummary();
                    checkEmptyCart();
                }, 300);
            }
        }
        
        // Apply coupon
        function applyCoupon() {
            const couponCode = document.getElementById('coupon-code').value.trim();
            const messageElement = document.getElementById('coupon-message');
            
            if (!couponCode) {
                messageElement.textContent = 'Please enter a coupon code';
                messageElement.style.color = '#ff4444';
                messageElement.style.display = 'block';
                return;
            }
            
            // Simulate coupon validation
            const validCoupons = {
                'TECH10': 0.10,
                'WELCOME15': 0.15,
                'SAVE20': 0.20
            };
            
            if (validCoupons[couponCode.toUpperCase()]) {
                const discount = validCoupons[couponCode.toUpperCase()];
                messageElement.textContent = `Coupon applied! You got ${discount * 100}% off`;
                messageElement.style.color = 'var(--primary-teal)';
                messageElement.style.display = 'block';
                applyDiscount(discount);
            } else {
                messageElement.textContent = 'Invalid coupon code';
                messageElement.style.color = '#ff4444';
                messageElement.style.display = 'block';
            }
        }
        
        // Apply discount
        function applyDiscount(discount) {
            const subtotal = parseFloat(document.getElementById('subtotal').textContent.replace('$', ''));
            const discountAmount = subtotal * discount;
            const totalElement = document.getElementById('total');
            const currentTotal = parseFloat(totalElement.textContent.replace('$', ''));
            const newTotal = (currentTotal - discountAmount).toFixed(2);
            
            let discountRow = document.querySelector('.discount-row');
            
            if (!discountRow) {
                discountRow = document.createElement('div');
                discountRow.className = 'summary-row discount-row';
                discountRow.innerHTML = `<span>Discount</span> <span>-$${discountAmount.toFixed(2)}</span>`;
                
                const totalRow = document.querySelector('.summary-row.total');
                totalRow.parentNode.insertBefore(discountRow, totalRow);
            } else {
                discountRow.innerHTML = `<span>Discount</span> <span>-$${discountAmount.toFixed(2)}</span>`;
            }
            
            totalElement.textContent = `$${newTotal}`;
        }
        
        // Update cart summary
        function updateCartSummary() {
            let subtotal = 0;
            const cartItems = document.querySelectorAll('.cart-item');
            
            cartItems.forEach(item => {
                const totalText = item.querySelector('.cart-item-total').textContent;
                subtotal += parseFloat(totalText.replace('$', ''));
            });
            
            const shipping = 9.99;
            const tax = subtotal * 0.08;
            
            document.getElementById('subtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('tax').textContent = `$${tax.toFixed(2)}`;
            
            let total = subtotal + shipping + tax;
            
            const discountRow = document.querySelector('.discount-row');
            if (discountRow) {
                const discountText = discountRow.querySelector('span:last-child').textContent;
                const discount = parseFloat(discountText.replace('-$', ''));
                total -= discount;
            }
            
            document.getElementById('total').textContent = `$${total.toFixed(2)}`;
        }
        
        // Check if cart is empty
        function checkEmptyCart() {
            const cartItems = document.querySelectorAll('.cart-item');
            const cartContent = document.querySelector('.cart-content .container');
            
            if (cartItems.length === 0) {
                const emptyCartHTML = `
                    <div class="empty-cart">
                        <div class="empty-cart-icon">
                            <i class="fas fa-shopping-cart"></i>
                        </div>
                        <h2>Your cart is empty</h2>
                        <p>Looks like you haven't added any items to your cart yet.</p>
                        <a href="?page=products" class="action-primary" style="margin-top: 20px; display: inline-block;">Start Shopping</a>
                    </div>
                `;
                
                cartContent.innerHTML = emptyCartHTML;
            }
        }
        
        // Proceed to checkout
        function proceedToCheckout() {
            const cartItems = document.querySelectorAll('.cart-item');
            
            if (cartItems.length === 0) {
                alert('Your cart is empty. Add some items before proceeding to checkout.');
                return;
            }
            
            // In real implementation, this would redirect to checkout page
            window.location.href = '?page=checkout';
        }
        
        // Add to cart from related products
        function addToCartFromRelated(productId) {
            alert('Product added to cart!');
            
            const cartBadge = document.querySelector('.cart-counter');
            if (cartBadge) {
                const currentCount = parseInt(cartBadge.textContent);
                cartBadge.textContent = currentCount + 1;
            }
        }
        
        // Initialize cart calculations
        document.addEventListener('DOMContentLoaded', function() {
            updateCartSummary();
        });
    </script>
</body>
</html>