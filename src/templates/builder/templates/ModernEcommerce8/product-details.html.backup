<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details | Élégance Luxury Home Décor</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --color-soft-pink: #F7DAE7;
            --color-warm-pink: #E2B4C1;
            --color-dusty-rose: #D38C9D;
            --color-deep-rose: #A55166;
            --color-white: #FFFFFF;
            --color-off-white: #FDF9FB;
            --color-dark-text: #333333;
            --color-light-text: #666666;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--color-dark-text);
            background-color: var(--color-off-white);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Product Details Hero */
        .product-hero {
            padding: 140px 0 40px;
            background: linear-gradient(135deg, var(--color-soft-pink) 0%, var(--color-warm-pink) 100%);
        }

        .product-breadcrumb {
            margin-bottom: 30px;
        }

        .breadcrumb-link {
            color: var(--color-dark-text);
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s ease;
        }

        .breadcrumb-link:hover {
            color: var(--color-deep-rose);
        }

        .breadcrumb-separator {
            margin: 0 10px;
            color: var(--color-dusty-rose);
        }

        .product-details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            padding: 40px 0;
        }

        /* Product Images Section */
        .product-images {
            position: sticky;
            top: 120px;
        }

        .main-product-image {
            width: 100%;
            height: 500px;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 20px;
            background-color: var(--color-white);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .main-product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-thumbnails {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding: 10px 0;
        }

        .thumbnail {
            width: 100px;
            height: 100px;
            border-radius: 4px;
            overflow: hidden;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            flex-shrink: 0;
            background-color: var(--color-white);
        }

        .thumbnail:hover {
            border-color: var(--color-dusty-rose);
            transform: translateY(-3px);
        }

        .thumbnail.active {
            border-color: var(--color-deep-rose);
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Product Info Section */
        .product-info {
            padding-right: 20px;
        }

        .product-category {
            font-size: 12px;
            color: var(--color-dusty-rose);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .product-name {
            font-size: 42px;
            color: var(--color-deep-rose);
            margin-bottom: 15px;
            font-weight: 500;
            line-height: 1.2;
        }

        .product-price {
            font-size: 28px;
            color: var(--color-deep-rose);
            font-weight: 500;
            margin-bottom: 20px;
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 25px;
        }

        .stars {
            color: #FFD700;
            font-size: 18px;
        }

        .stars .far {
            color: #E0E0E0;
        }

        .rating-count {
            color: var(--color-light-text);
            font-size: 14px;
        }

        .product-description {
            font-size: 16px;
            color: var(--color-dark-text);
            margin-bottom: 30px;
            line-height: 1.8;
        }

        /* Product Variations */
        .product-variations {
            margin-bottom: 30px;
        }

        .variation-title {
            font-size: 16px;
            font-weight: 500;
            margin-bottom: 12px;
            color: var(--color-dark-text);
        }

        .color-variants,
        .size-variants {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .color-variant {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
            position: relative;
        }

        .color-variant:hover {
            transform: scale(1.1);
        }

        .color-variant.active {
            border-color: var(--color-deep-rose);
        }

        .color-variant::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 32px;
            height: 32px;
            border-radius: 50%;
        }

        .size-variant {
            padding: 10px 20px;
            border: 1px solid var(--color-warm-pink);
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
            background-color: white;
            font-size: 14px;
            font-weight: 500;
        }

        .size-variant:hover {
            background-color: var(--color-soft-pink);
            border-color: var(--color-dusty-rose);
        }

        .size-variant.active {
            background-color: var(--color-deep-rose);
            color: white;
            border-color: var(--color-deep-rose);
        }

        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 15px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .action-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 40px;
            background-color: var(--color-deep-rose);
            color: white;
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(165, 81, 102, 0.3);
            position: relative;
            z-index: 1;
            overflow: hidden;
            border: none;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            flex: 1;
            min-width: 200px;
        }

        .action-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
            z-index: -1;
        }

        .action-primary:hover::before {
            left: 100%;
        }

        .action-primary:hover {
            background-color: #8a4257;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(165, 81, 102, 0.4);
        }

        .action-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 40px;
            background-color: transparent;
            color: var(--color-deep-rose);
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 2px;
            transition: all 0.3s ease;
            border: 1px solid var(--color-deep-rose);
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            flex: 1;
            min-width: 200px;
        }

        .action-secondary:hover {
            background-color: var(--color-deep-rose);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(165, 81, 102, 0.2);
        }

        .wishlist-button {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background-color: var(--color-soft-pink);
            border: none;
            color: var(--color-deep-rose);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            font-size: 20px;
        }

        .wishlist-button:hover {
            background-color: var(--color-dusty-rose);
            color: white;
            transform: scale(1.1);
        }

        .wishlist-button.active {
            background-color: var(--color-deep-rose);
            color: white;
        }

        /* Product Details Tabs */
        .product-tabs {
            margin: 60px 0;
        }

        .tabs-header {
            display: flex;
            border-bottom: 1px solid var(--color-warm-pink);
            margin-bottom: 30px;
        }

        .tab-button {
            padding: 15px 30px;
            background: none;
            border: none;
            font-size: 16px;
            font-weight: 500;
            color: var(--color-light-text);
            cursor: pointer;
            position: relative;
            transition: color 0.3s ease;
        }

        .tab-button:hover {
            color: var(--color-deep-rose);
        }

        .tab-button.active {
            color: var(--color-deep-rose);
        }

        .tab-button.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--color-deep-rose);
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Reviews Section */
        .reviews-container {
            padding: 30px 0;
        }

        .review-form {
            background-color: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            margin-bottom: 40px;
        }

        .review-form h3 {
            font-size: 24px;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
        }

        .rating-input {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 20px;
        }

        .rating-stars {
            display: flex;
            gap: 5px;
            font-size: 24px;
            color: #E0E0E0;
            cursor: pointer;
        }

        .rating-stars i:hover,
        .rating-stars i.active {
            color: #FFD700;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--color-dark-text);
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--color-warm-pink);
            border-radius: 4px;
            font-family: 'Montserrat', sans-serif;
            font-size: 14px;
            transition: border-color 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--color-deep-rose);
        }

        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        .customer-reviews {
            margin-top: 40px;
        }

        .review-item {
            background-color: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
            margin-bottom: 20px;
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .reviewer-info h4 {
            font-size: 16px;
            font-weight: 500;
            color: var(--color-dark-text);
            margin-bottom: 5px;
        }

        .review-date {
            font-size: 12px;
            color: var(--color-light-text);
        }

        .review-rating {
            color: #FFD700;
        }

        .review-content {
            color: var(--color-dark-text);
            line-height: 1.6;
        }

        /* Related Products */
        .related-products {
            padding: 60px 0;
            background-color: rgba(247, 218, 231, 0.1);
        }

        .section-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .section-header h2 {
            font-size: 36px;
            color: var(--color-deep-rose);
            margin-bottom: 15px;
            font-weight: 500;
        }

        .section-header p {
            color: var(--color-light-text);
            max-width: 600px;
            margin: 0 auto;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 50px;
        }

        .product-card {
            background-color: white;
            border-radius: 4px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .product-image {
            height: 250px;
            overflow: hidden;
            background-color: var(--color-soft-pink);
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-image img {
            transform: scale(1.05);
        }

        .product-info {
            padding: 20px;
        }

        .product-category-small {
            font-size: 11px;
            color: var(--color-dusty-rose);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .product-name-small {
            font-family: 'Cormorant Garamond', serif;
            font-size: 20px;
            color: var(--color-dark-text);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .product-price-small {
            font-size: 16px;
            color: var(--color-deep-rose);
            font-weight: 500;
        }

        .product-actions-small {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .action-primary-small {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            background-color: var(--color-deep-rose);
            color: white;
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 3px 10px rgba(165, 81, 102, 0.2);
            position: relative;
            z-index: 1;
            overflow: hidden;
            border: none;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            flex: 1;
            font-size: 14px;
        }

        .action-primary-small:hover {
            background-color: #8a4257;
            transform: translateY(-2px);
        }

        .wishlist-button-small {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--color-soft-pink);
            border: none;
            color: var(--color-deep-rose);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            font-size: 16px;
        }

        .wishlist-button-small:hover {
            background-color: var(--color-dusty-rose);
            color: white;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .product-details-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .product-images {
                position: static;
            }
            
            .main-product-image {
                height: 400px;
            }
            
            .product-info {
                padding-right: 0;
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .product-name {
                font-size: 36px;
            }
        }

        @media (max-width: 768px) {
            .product-hero {
                padding: 120px 0 20px;
            }
            
            .main-product-image {
                height: 350px;
            }
            
            .product-name {
                font-size: 30px;
            }
            
            .product-price {
                font-size: 24px;
            }
            
            .product-actions {
                flex-direction: column;
            }
            
            .action-primary,
            .action-secondary {
                min-width: 100%;
            }
            
            .wishlist-button {
                width: 100%;
                border-radius: 4px;
            }
            
            .tabs-header {
                flex-direction: column;
            }
            
            .tab-button {
                text-align: left;
                border-bottom: 1px solid var(--color-warm-pink);
            }
            
            .products-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 576px) {
            .main-product-image {
                height: 300px;
            }
            
            .thumbnail {
                width: 80px;
                height: 80px;
            }
            
            .section-header h2 {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
    <!-- Product Details -->
    <section class="product-hero editable-section" data-section="117">
        <div class="container">
            <div class="product-breadcrumb editable-text editable-section no-drop-zone" data-section="118" data-text="74">
                <a href="?page=home" class="breadcrumb-link">Home</a>
                <span class="breadcrumb-separator">/</span>
                <a href="?page=shop" class="breadcrumb-link">Shop</a>
                <span class="breadcrumb-separator">/</span>
                <a href="?page=categories" class="breadcrumb-link">Vases</a>
                <span class="breadcrumb-separator">/</span>
                <span>Artisanal Ceramic Vase</span>
            </div>

            <div class="product-details-container">
                <!-- Product Images -->
                <div class="product-images">
                    <div class="main-product-image">
                        <img id="main-product-image" src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Artisanal Ceramic Vase" class="editable-image" data-image="10">
                    </div>
                    
                    <div class="product-thumbnails">
                        <div class="thumbnail active editable-section no-drop-zone" data-section="119" onclick="changeImage('https://images.unsplash.com/photo-1555041469-a586c61ea9bc?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80')">
                            <img src="https://images.unsplash.com/photo-1555041469-a586c61ea9bc?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=200&q=80" alt="Vase Front View">
                        </div>
                        <div class="thumbnail editable-section no-drop-zone" data-section="120" onclick="changeImage('https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80')">
                            <img src="https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=200&q=80" alt="Vase Side View">
                        </div>
                        <div class="thumbnail editable-section no-drop-zone" data-section="121" onclick="changeImage('https://images.unsplash.com/photo-1545243421-89e5c9b6d12c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80')">
                            <img src="https://images.unsplash.com/photo-1545243421-89e5c9b6d12c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=200&q=80" alt="Vase with Flowers">
                        </div>
                        <div class="thumbnail editable-section no-drop-zone" data-section="122" onclick="changeImage('https://images.unsplash.com/photo-1578500494198-246f612d3b3d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80')">
                            <img src="https://images.unsplash.com/photo-1578500494198-246f612d3b3d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=200&q=80" alt="Vase Details">
                        </div>
                    </div>
                </div>

                <!-- Product Info -->
                <div class="product-info">
                    <div class="product-category editable-section no-drop-zone" data-section="123">VASES & VESSELS</div>
                    <h1 class="product-name editable-text editable-section no-drop-zone" data-section="124" data-text="75">Artisanal Ceramic Vase</h1>
                    
                    <div class="product-price editable-section no-drop-zone" data-section="125">$245</div>
                    
                    <div class="product-rating editable-section no-drop-zone" data-section="126">
                        <div class="stars">
                            <i class="fas fa-star editable-icon" data-icon="9" data-default-class="fas fa-star"></i>
                            <i class="fas fa-star editable-icon" data-icon="9" data-default-class="fas fa-star"></i>
                            <i class="fas fa-star editable-icon" data-icon="9" data-default-class="fas fa-star"></i>
                            <i class="fas fa-star editable-icon" data-icon="9" data-default-class="fas fa-star"></i>
                            <i class="far fa-star editable-icon" data-icon="9" data-default-class="far fa-star"></i>
                        </div>
                        <span class="rating-count editable-text editable-section no-drop-zone" data-section="127" data-text="76">(4.2/5 based on 42 reviews)</span>
                    </div>
                    
                    <div class="product-description editable-text editable-section no-drop-zone" data-section="128" data-text="77">
