 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | Élégance Luxury Home Décor</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --color-soft-pink: #F7DAE7;
            --color-warm-pink: #E2B4C1;
            --color-dusty-rose: #D38C9D;
            --color-deep-rose: #A55166;
            --color-white: #FFFFFF;
            --color-off-white: #FDF9FB;
            --color-dark-text: #333333;
            --color-light-text: #666666;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--color-dark-text);
            background-color: var(--color-off-white);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Categories Hero */
        .categories-hero {
            padding: 140px 0 40px;
            background: linear-gradient(135deg, var(--color-soft-pink) 0%, var(--color-warm-pink) 100%);
        }

        .categories-hero-content {
            text-align: center;
        }

        .categories-hero h1 {
            font-size: 56px;
            line-height: 1.1;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
            text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.5);
        }

        .categories-hero p {
            font-size: 18px;
            color: var(--color-dark-text);
            max-width: 700px;
            margin: 0 auto;
            background-color: rgba(255, 255, 255, 0.7);
            padding: 20px;
            border-radius: 4px;
            backdrop-filter: blur(5px);
        }

        /* Categories Content */
        .categories-content {
            padding: 60px 0;
        }

        .categories-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .categories-title h2 {
            font-size: 32px;
            color: var(--color-deep-rose);
            font-weight: 500;
        }

        .categories-title p {
            color: var(--color-light-text);
            margin-top: 10px;
        }

        .categories-count {
            font-size: 16px;
            color: var(--color-dusty-rose);
            font-weight: 500;
            padding: 10px 20px;
            background-color: var(--color-soft-pink);
            border-radius: 4px;
        }

        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .category-card {
            background-color: white;
            border-radius: 8px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            position: relative;
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .category-image {
            height: 280px;
            overflow: hidden;
            background-color: var(--color-soft-pink);
            position: relative;
        }

        .category-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .category-card:hover .category-image img {
            transform: scale(1.05);
        }

        .category-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.1) 100%);
        }

        .category-info {
            padding: 25px;
            position: relative;
        }

        .category-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 26px;
            color: var(--color-deep-rose);
            margin-bottom: 10px;
            font-weight: 500;
        }

        .category-description {
            font-size: 14px;
            color: var(--color-light-text);
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .category-stats {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid var(--color-warm-pink);
        }

        .product-count {
            font-size: 14px;
            color: var(--color-dusty-rose);
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .view-category {
            font-size: 14px;
            color: var(--color-deep-rose);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: gap 0.3s ease;
        }

        .category-card:hover .view-category {
            gap: 10px;
        }

        /* Featured Products Section */
        .featured-products {
            padding: 60px 0;
            background-color: rgba(247, 218, 231, 0.1);
            border-radius: 8px;
            margin-top: 40px;
        }

        .section-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .section-header h2 {
            font-size: 36px;
            color: var(--color-deep-rose);
            margin-bottom: 15px;
            font-weight: 500;
        }

        .section-header p {
            color: var(--color-light-text);
            max-width: 600px;
            margin: 0 auto;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 50px;
        }

        .product-card {
            background-color: white;
            border-radius: 4px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .product-image {
            height: 220px;
            overflow: hidden;
            background-color: var(--color-soft-pink);
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-image img {
            transform: scale(1.05);
        }

        .product-info {
            padding: 20px;
        }

        .product-category-small {
            font-size: 11px;
            color: var(--color-dusty-rose);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .product-name-small {
            font-family: 'Cormorant Garamond', serif;
            font-size: 18px;
            color: var(--color-dark-text);
            margin-bottom: 8px;
            font-weight: 500;
            line-height: 1.3;
        }

        .product-price-small {
            font-size: 16px;
            color: var(--color-deep-rose);
            font-weight: 500;
        }

        .product-actions-small {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .action-primary-small {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            background-color: var(--color-deep-rose);
            color: white;
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 0.5px;
            border-radius: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 3px 10px rgba(165, 81, 102, 0.2);
            position: relative;
            z-index: 1;
            overflow: hidden;
            border: none;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            flex: 1;
            font-size: 14px;
        }

        .action-primary-small:hover {
            background-color: #8a4257;
            transform: translateY(-2px);
        }

        .wishlist-button-small {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--color-soft-pink);
            border: none;
            color: var(--color-deep-rose);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            font-size: 16px;
        }

        .wishlist-button-small:hover {
            background-color: var(--color-dusty-rose);
            color: white;
        }

        .wishlist-button-small.active {
            background-color: var(--color-deep-rose);
            color: white;
        }

        /* Category Filter */
        .category-filter {
            background-color: white;
            border-radius: 8px;
            padding: 30px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            margin-bottom: 40px;
        }

        .filter-header {
            font-size: 20px;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
            padding-bottom: 15px;
            border-bottom: 1px solid var(--color-warm-pink);
        }

        .filter-group {
            margin-bottom: 25px;
        }

        .filter-group:last-child {
            margin-bottom: 0;
        }

        .filter-title {
            font-size: 16px;
            font-weight: 500;
            color: var(--color-dark-text);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .filter-reset {
            font-size: 13px;
            color: var(--color-dusty-rose);
            background: none;
            border: none;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .filter-reset:hover {
            color: var(--color-deep-rose);
        }

        .filter-options {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .filter-option {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
        }

        .filter-checkbox {
            width: 18px;
            height: 18px;
            border: 1px solid var(--color-warm-pink);
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .filter-checkbox.checked {
            background-color: var(--color-deep-rose);
            border-color: var(--color-deep-rose);
        }

        .filter-checkbox.checked::after {
            content: '✓';
            color: white;
            font-size: 12px;
        }

        .filter-label {
            font-size: 14px;
            color: var(--color-dark-text);
            transition: color 0.3s ease;
        }

        .filter-option:hover .filter-label {
            color: var(--color-deep-rose);
        }

        .filter-count {
            font-size: 12px;
            color: var(--color-light-text);
            margin-left: auto;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .categories-hero h1 {
                font-size: 46px;
            }
            
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .category-image {
                height: 240px;
            }
        }

        @media (max-width: 768px) {
            .categories-hero {
                padding: 120px 0 20px;
            }
            
            .categories-hero h1 {
                font-size: 36px;
            }
            
            .categories-hero p {
                font-size: 16px;
            }
            
            .section-header h2 {
                font-size: 28px;
            }
            
            .categories-title h2 {
                font-size: 28px;
            }
            
            .categories-header {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .category-image {
                height: 220px;
            }
            
            .category-name {
                font-size: 22px;
            }
        }

        @media (max-width: 576px) {
            .categories-grid {
                grid-template-columns: 1fr;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
            }
            
            .category-image {
                height: 250px;
            }
            
            .category-filter {
                padding: 20px;
            }
        }
    </style>
</head>
<body>
    <!-- Categories Hero -->
    <section class="categories-hero editable-section" data-section="225">
        <div class="container">
            <div class="categories-hero-content">
                <h1 class="editable-text editable-section no-drop-zone" data-section="226" data-text="134">Shop by Category</h1>
                <p class="editable-text editable-section no-drop-zone" data-section="227" data-text="135">Explore our curated collections of luxury home décor, organized to help you find exactly what you need for your space</p>
            </div>
        </div>
    </section>

    <!-- Categories Content -->
    <section class="categories-content editable-section" data-section="228">
        <div class="container">
            <div class="categories-header">
                <div class="categories-title">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="229" data-text="136">All Categories</h2>
                    <p class="editable-text editable-section no-drop-zone" data-section="230" data-text="137">Browse our complete collection of luxury home décor categories</p>
                </div>
                <div class="categories-count editable-text editable-section no-drop-zone" data-section="231" data-text="138">8 Categories</div>
            </div>

            <!-- Category Filter -->
            <div class="category-filter editable-section no-drop-zone" data-section="232">
                <div class="filter-header editable-text editable-section no-drop-zone" data-section="233" data-text="139">Filter Categories</div>
                
                <div class="filter-group">
                    <div class="filter-title">
                        <span class="editable-text editable-section no-drop-zone" data-section="234" data-text="140">Product Type</span>
                        <button class="filter-reset editable-text editable-section no-drop-zone" data-section="235" data-text="141" onclick="resetRoomFilters()">Reset</button>
                    </div>
                    <div class="filter-options">
                        <div class="filter-option" onclick="toggleFilter(this, 'living-room')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label editable-text editable-section no-drop-zone" data-section="236" data-text="142">Living Room</span>
                            <span class="filter-count editable-section no-drop-zone" data-section="237">24</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, 'bedroom')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">Bedroom</span>
                            <span class="filter-count">18</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, 'dining')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">Dining</span>
                            <span class="filter-count">15</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, 'kitchen')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">Kitchen</span>
                            <span class="filter-count">12</span>
                        </div>
                    </div>
                </div>

                <div style="display: None;"  class="filter-group">
                    <div class="filter-title">
                        <span class="editable-text editable-section no-drop-zone" data-section="238" data-text="143">Product Type</span>
                        <button class="filter-reset editable-text editable-section no-drop-zone" data-section="239" data-text="144" onclick="resetProductFilters()">Reset</button>
                    </div>
                    <div class="filter-options">
                        <div class="filter-option" onclick="toggleFilter(this, 'furniture')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label editable-text editable-section no-drop-zone" data-section="240" data-text="145">Furniture</span>
                            <span class="filter-count editable-section no-drop-zone" data-section="241">32</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, 'lighting')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">Lighting</span>
                            <span class="filter-count">28</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, 'decor')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">Home Decor</span>
                            <span class="filter-count">45</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, 'textiles')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">Textiles</span>
                            <span class="filter-count">22</span>
                        </div>
                    </div>
                </div>

                <div class="filter-group">
                    <div class="filter-title">
                        <span class="editable-text editable-section no-drop-zone" data-section="242" data-text="146">Price Range</span>
                        <button class="filter-reset editable-text editable-section no-drop-zone" data-section="243" data-text="147" onclick="resetPriceFilters()">Reset</button>
                    </div>
                    <div class="filter-options">
                        <div class="filter-option" onclick="toggleFilter(this, 'under-100')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label editable-text editable-section no-drop-zone" data-section="244" data-text="148">Under $100</span>
                            <span class="filter-count editable-section no-drop-zone" data-section="245">18</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, '100-500')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">$100 - $500</span>
                            <span class="filter-count">42</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, '500-1000')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">$500 - $1,000</span>
                            <span class="filter-count">25</span>
                        </div>
                        <div class="filter-option" onclick="toggleFilter(this, 'over-1000')">
                            <div class="filter-checkbox"></div>
                            <span class="filter-label">Over $1,000</span>
                            <span class="filter-count">15</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories Grid -->
            <div class="categories-grid">
                <!-- Category 1 -->
                <a href="?page=category&id=living-room" class="category-card editable-section no-drop-zone" data-section="246">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1586023492125-27b2c045efd7?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Living Room Decor" class="editable-image" data-image="16">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-info">
                        <h3 class="category-name editable-text editable-section no-drop-zone" data-section="247" data-text="149">Living Room</h3>
                        <p class="category-description editable-text editable-section no-drop-zone" data-section="248" data-text="150">Transform your living space with curated furniture, lighting, and decorative pieces that create a warm and inviting atmosphere.</p>
                        <div class="category-stats">
                            <span class="product-count editable-section no-drop-zone" data-section="249">
                                <i class="fas fa-box editable-icon" data-icon="26" data-default-class="fas fa-box"></i> 24 Products
                            </span>
                            <span class="view-category editable-text editable-section no-drop-zone" data-section="250" data-text="151">
                                Explore <i class="fas fa-arrow-right editable-icon" data-icon="27" data-default-class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

                <!-- Category 2 -->
                <a href="?page=category&id=bedroom" class="category-card">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Bedroom Decor">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-info">
                        <h3 class="category-name">Bedroom</h3>
                        <p class="category-description">Create your personal sanctuary with luxurious bedding, elegant furniture, and calming decorative elements for restful nights.</p>
                        <div class="category-stats">
                            <span class="product-count">
                                <i class="fas fa-box editable-icon" data-icon="26" data-default-class="fas fa-box"></i> 18 Products
                            </span>
                            <span class="view-category">
                                Explore <i class="fas fa-arrow-right editable-icon" data-icon="27" data-default-class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

                <!-- Category 3 -->
                <a href="?page=category&id=dining" class="category-card">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1587846818252-93e2a6e1f0ee?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Dining Room Decor">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-info">
                        <h3 class="category-name">Dining Room</h3>
                        <p class="category-description">Elevate your dining experience with exquisite tableware, elegant furniture, and ambient lighting for memorable gatherings.</p>
                        <div class="category-stats">
                            <span class="product-count">
                                <i class="fas fa-box editable-icon" data-icon="26" data-default-class="fas fa-box"></i> 15 Products
                            </span>
                            <span class="view-category">
                                Explore <i class="fas fa-arrow-right editable-icon" data-icon="27" data-default-class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

                <!-- Category 4 -->
                <a href="?page=category&id=lighting" class="category-card">
                    <div class="category-image">
                        <img src="https://images.unsplash.com/photo-1556228453-efd6c1ff04f6?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80" alt="Lighting">
                        <div class="category-overlay"></div>
                    </div>
                    <div class="category-info">
                        <h3 class="category-name">Lighting</h3>
                        <p class="category-description">Illuminate your space with designer lighting fixtures that combine functionality with artistic expression and ambient warmth.</p>
                        <div class="category-stats">
                            <span class="product-count">
                                <i class="fas fa-box editable-icon" data-icon="26" data-default-class="fas fa-box"></i> 28 Products
                            </span>
                            <span class="view-category">
                                Explore <i class="fas fa-arrow-right editable-icon" data-icon="27" data-default-class="fas fa-arrow-right"></i>
                            </span>
                        </div>
                    </div>
                </a>

                <!-- Category 5 -->
                <a href="?page=category&id=home-decor" class="category-card">
                    <div class="category-image">
