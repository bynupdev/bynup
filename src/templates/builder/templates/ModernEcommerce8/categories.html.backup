    <script>
        // Filter Functions
        function toggleFilter(element, filterType) {
            const checkbox = element.querySelector('.filter-checkbox');
            checkbox.classList.toggle('checked');
            
            // Update active filters count and UI
            updateActiveFilters();
            filterCategories();
        }

        function resetRoomFilters() {
            document.querySelectorAll('.filter-group:nth-child(1) .filter-checkbox').forEach(checkbox => {
                checkbox.classList.remove('checked');
            });
            updateActiveFilters();
            filterCategories();
        }

        function resetProductFilters() {
            document.querySelectorAll('.filter-group:nth-child(2) .filter-checkbox').forEach(checkbox => {
                checkbox.classList.remove('checked');
            });
            updateActiveFilters();
            filterCategories();
        }

        function resetPriceFilters() {
            document.querySelectorAll('.filter-group:nth-child(3) .filter-checkbox').forEach(checkbox => {
                checkbox.classList.remove('checked');
            });
            updateActiveFilters();
            filterCategories();
        }

        function updateActiveFilters() {
            const activeFilters = document.querySelectorAll('.filter-checkbox.checked').length;
            const countElement = document.querySelector('[data-section="231"]');
            if (countElement && activeFilters > 0) {
                countElement.textContent = `${8 - activeFilters} Categories (${activeFilters} filters active)`;
            } else if (countElement) {
                countElement.textContent = "8 Categories";
            }
        }

        function filterCategories() {
            // In a real implementation, this would filter categories based on selected filters
            // For this demo, we'll just show a message
            const activeFilters = document.querySelectorAll('.filter-checkbox.checked').length;
            if (activeFilters > 0) {
                console.log(`Filtering categories with ${activeFilters} active filters`);
            }
        }

        // Wishlist Functions
        function toggleWishlist(button) {
            button.classList.toggle('active');
            const icon = button.querySelector('i');
            
            if (button.classList.contains('active')) {
                icon.classList.remove('far');
                icon.classList.add('fas');
                alert('Added to wishlist!');
            } else {
                icon.classList.remove('fas');
                icon.classList.add('far');
                alert('Removed from wishlist!');
            }
        }

        // Cart Functions
        function addToCart(productId) {
            alert(`Added product ${productId} to cart!`);
            // In real implementation, this would add item to cart
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Add any initialization code here
        });
    </script>
