 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Élégance Luxury Home Décor</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --color-soft-pink: #F7DAE7;
            --color-warm-pink: #E2B4C1;
            --color-dusty-rose: #D38C9D;
            --color-deep-rose: #A55166;
            --color-white: #FFFFFF;
            --color-off-white: #FDF9FB;
            --color-dark-text: #333333;
            --color-light-text: #666666;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--color-dark-text);
            background-color: var(--color-off-white);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Contact Hero */
        .contact-hero {
            padding: 140px 0 60px;
            background: linear-gradient(135deg, var(--color-soft-pink) 0%, var(--color-warm-pink) 100%);
            text-align: center;
        }

        .contact-hero h1 {
            font-size: 56px;
            line-height: 1.1;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
            text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.5);
        }

        .contact-hero p {
            font-size: 18px;
            color: var(--color-dark-text);
            max-width: 700px;
            margin: 0 auto;
            background-color: rgba(255, 255, 255, 0.7);
            padding: 20px;
            border-radius: 4px;
            backdrop-filter: blur(5px);
        }

        /* Contact Content */
        .contact-content {
            padding: 60px 0 80px;
        }

        .contact-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        /* Contact Info Section */
        .contact-info {
            background-color: white;
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .contact-info h2 {
            font-size: 32px;
            color: var(--color-deep-rose);
            margin-bottom: 30px;
            font-weight: 500;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--color-soft-pink);
        }

        .info-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .info-icon {
            width: 50px;
            height: 50px;
            background-color: var(--color-soft-pink);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-deep-rose);
            font-size: 20px;
            flex-shrink: 0;
        }

        .info-content h3 {
            font-size: 20px;
            color: var(--color-deep-rose);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .info-content p {
            color: var(--color-light-text);
            margin-bottom: 5px;
            font-size: 15px;
        }

        .info-link {
            color: var(--color-deep-rose);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .info-link:hover {
            color: var(--color-dusty-rose);
            text-decoration: underline;
        }

        /* Contact Form */
        .contact-form {
            background-color: white;
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .contact-form h2 {
            font-size: 32px;
            color: var(--color-deep-rose);
            margin-bottom: 30px;
            font-weight: 500;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            color: var(--color-dark-text);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-input,
        .form-textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--color-warm-pink);
            border-radius: 4px;
            font-family: 'Montserrat', sans-serif;
            font-size: 15px;
            color: var(--color-dark-text);
            background-color: var(--color-off-white);
            transition: all 0.3s ease;
        }

        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: var(--color-deep-rose);
            background-color: white;
            box-shadow: 0 0 0 3px rgba(165, 81, 102, 0.1);
        }

        .form-textarea {
            min-height: 150px;
            resize: vertical;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .submit-button {
            display: inline-block;
            padding: 16px 40px;
            background-color: var(--color-deep-rose);
            color: white;
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(165, 81, 102, 0.3);
            position: relative;
            z-index: 1;
            overflow: hidden;
            border: none;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-size: 16px;
            width: 100%;
        }

        .submit-button:hover {
            background-color: #8a4257;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(165, 81, 102, 0.4);
        }

        .submit-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
            z-index: -1;
        }

        .submit-button:hover::before {
            left: 100%;
        }

        /* FAQ Section */
        .faq-section {
            padding: 80px 0;
            background-color: rgba(247, 218, 231, 0.1);
            border-radius: 8px;
            margin-top: 40px;
        }

        .faq-section h2 {
            font-size: 36px;
            color: var(--color-deep-rose);
            margin-bottom: 40px;
            font-weight: 500;
            text-align: center;
        }

        .faq-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .faq-item {
            background-color: white;
            border-radius: 8px;
            margin-bottom: 20px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .faq-item.active {
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
        }

        .faq-question {
            padding: 25px 30px;
            font-size: 18px;
            color: var(--color-deep-rose);
            font-weight: 500;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background-color 0.3s ease;
        }

        .faq-question:hover {
            background-color: var(--color-soft-pink);
        }

        .faq-icon {
            font-size: 14px;
            color: var(--color-dusty-rose);
            transition: transform 0.3s ease;
        }

        .faq-item.active .faq-icon {
            transform: rotate(180deg);
        }

        .faq-answer {
            padding: 0 30px;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s ease;
            color: var(--color-light-text);
            line-height: 1.7;
        }

        .faq-item.active .faq-answer {
            padding: 0 30px 25px;
            max-height: 500px;
        }

        /* Hours Section */
        .hours-section {
            padding: 40px 0;
            text-align: center;
        }

        .hours-section h3 {
            font-size: 24px;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
        }

        .hours-table {
            display: inline-block;
            text-align: left;
        }

        .hours-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 20px;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--color-soft-pink);
        }

        .hours-row:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .hours-day {
            font-weight: 500;
            color: var(--color-dark-text);
        }

        .hours-time {
            color: var(--color-light-text);
        }

        /* Map Section */
        .map-section {
            margin-top: 40px;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            height: 400px;
            background-color: var(--color-soft-pink);
        }

        .map-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--color-deep-rose);
            font-size: 18px;
            background: linear-gradient(135deg, var(--color-soft-pink) 0%, var(--color-warm-pink) 100%);
        }

        .map-placeholder i {
            font-size: 48px;
            margin-bottom: 20px;
        }

        /* Responsive Styles */
        @media (max-width: 992px) {
            .contact-wrapper {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .contact-hero h1 {
                font-size: 46px;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }

        @media (max-width: 768px) {
            .contact-hero {
                padding: 120px 0 40px;
            }
            
            .contact-hero h1 {
                font-size: 36px;
            }
            
            .contact-hero p {
                font-size: 16px;
            }
            
            .contact-info,
            .contact-form {
                padding: 30px 25px;
            }
            
            .info-item {
                flex-direction: column;
                gap: 15px;
            }
            
            .faq-section h2 {
                font-size: 28px;
            }
            
            .faq-question {
                padding: 20px 25px;
                font-size: 16px;
            }
            
            .faq-answer {
                padding: 0 25px;
            }
            
            .faq-item.active .faq-answer {
                padding: 0 25px 20px;
            }
        }

        @media (max-width: 576px) {
            .contact-hero h1 {
                font-size: 32px;
            }
            
            .contact-info h2,
            .contact-form h2 {
                font-size: 28px;
            }
            
            .hours-row {
                grid-template-columns: 1fr;
                gap: 5px;
            }
            
            .map-section {
                height: 300px;
            }
        }
    </style>
</head>
<body>
    <!-- Contact Hero -->
    <section class="contact-hero editable-section" data-section="301">
        <div class="container">
            <h1 class="editable-text editable-section no-drop-zone" data-section="302" data-text="201">Get in Touch</h1>
            <p class="editable-text editable-section no-drop-zone" data-section="303" data-text="202">We're here to help with any questions about our luxury home décor collections or your order</p>
        </div>
    </section>

    <!-- Contact Content -->
    <section class="contact-content editable-section" data-section="304">
        <div class="container">
            <div class="contact-wrapper">
                <!-- Contact Information -->
                <div class="contact-info editable-section no-drop-zone" data-section="305">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="306" data-text="203">Contact Information</h2>
                    
                    <!-- Info Item 1 - Location (Fully Editable) -->
                    <div class="info-item editable-section no-drop-zone" data-section="307">
                        <div class="info-icon editable-section no-drop-zone" data-section="308">
                            <i class="fas fa-map-marker-alt editable-icon" data-icon="44" data-default-class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="info-content">
                            <h3 class="editable-text editable-section no-drop-zone" data-section="309" data-text="204">Visit Our Showroom</h3>
                            <p class="editable-text editable-section no-drop-zone" data-section="310" data-text="205">123 Luxury Lane, Design District</p>
                            <p class="editable-text editable-section no-drop-zone" data-section="311" data-text="206">New York, NY 10001</p>
                            <a href="#" class="info-link editable-text editable-section no-drop-zone" data-section="312" data-text="207">Get Directions →</a>
                        </div>
                    </div>
                    
                    <!-- Info Item 2 - Phone (Fully Editable) -->
                    <div class="info-item editable-section no-drop-zone" data-section="313">
                        <div class="info-icon editable-section no-drop-zone" data-section="314">
                            <i class="fas fa-phone editable-icon" data-icon="45" data-default-class="fas fa-phone"></i>
                        </div>
                        <div class="info-content">
                            <h3 class="editable-text editable-section no-drop-zone" data-section="315" data-text="208">Phone Support</h3>
                            <p class="editable-text editable-section no-drop-zone" data-section="316" data-text="209">Monday - Friday: 9AM - 6PM EST</p>
                            <p class="editable-text editable-section no-drop-zone" data-section="317" data-text="210">Saturday: 10AM - 4PM EST</p>
                            <a href="tel:+18885551234" class="info-link editable-text editable-section no-drop-zone" data-section="318" data-text="211">(888) 555-1234</a>
                        </div>
                    </div>
                    
                    <!-- Info Item 3 - Email (Fully Editable) -->
                    <div class="info-item editable-section no-drop-zone" data-section="319">
                        <div class="info-icon editable-section no-drop-zone" data-section="320">
                            <i class="fas fa-envelope editable-icon" data-icon="46" data-default-class="fas fa-envelope"></i>
                        </div>
                        <div class="info-content">
                            <h3 class="editable-text editable-section no-drop-zone" data-section="321" data-text="212">Email Us</h3>
                            <p class="editable-text editable-section no-drop-zone" data-section="322" data-text="213">For general inquiries:</p>
                            <a href="mailto:info@elegance-decor.com" class="info-link editable-text editable-section no-drop-zone" data-section="323" data-text="214">info@elegance-decor.com</a>
                            <p class="editable-text editable-section no-drop-zone" data-section="324" data-text="215">For order support:</p>
                            <a href="mailto:support@elegance-decor.com" class="info-link editable-text editable-section no-drop-zone" data-section="325" data-text="216">support@elegance-decor.com</a>
                        </div>
                    </div>
                </div>

                <!-- Contact Form (Fully Editable) -->
                <div class="contact-form editable-section no-drop-zone" data-section="326">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="327" data-text="217">Send Us a Message</h2>
                    
                    <form id="contact-form">
                        <div class="form-row">
                            <div class="form-group editable-section no-drop-zone" data-section="328">
                                <label class="form-label editable-text editable-section no-drop-zone" data-section="329" data-text="218">First Name</label>
                                <input type="text" class="form-input" placeholder="Enter your first name" required>
                            </div>
                            <div class="form-group editable-section no-drop-zone" data-section="330">
                                <label class="form-label editable-text editable-section no-drop-zone" data-section="331" data-text="219">Last Name</label>
                                <input type="text" class="form-input" placeholder="Enter your last name" required>
                            </div>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="332">
                            <label class="form-label editable-text editable-section no-drop-zone" data-section="333" data-text="220">Email Address</label>
                            <input type="email" class="form-input" placeholder="Enter your email address" required>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="334">
                            <label class="form-label editable-text editable-section no-drop-zone" data-section="335" data-text="221">Phone Number</label>
                            <input type="tel" class="form-input" placeholder="Enter your phone number (optional)">
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="336">
                            <label class="form-label editable-text editable-section no-drop-zone" data-section="337" data-text="222">Subject</label>
                            <select class="form-input">
                                <option value="" class="editable-text" data-text="223">Select a subject</option>
                                <option value="order" class="editable-text" data-text="224">Order Inquiry</option>
                                <option value="product" class="editable-text" data-text="225">Product Information</option>
                                <option value="shipping" class="editable-text" data-text="226">Shipping & Delivery</option>
                                <option value="returns" class="editable-text" data-text="227">Returns & Exchanges</option>
                                <option value="wholesale" class="editable-text" data-text="228">Wholesale Inquiry</option>
                                <option value="other" class="editable-text" data-text="229">Other</option>
                            </select>
                        </div>
                        
                        <div class="form-group editable-section no-drop-zone" data-section="338">
                            <label class="form-label editable-text editable-section no-drop-zone" data-section="339" data-text="230">Message</label>
                            <textarea class="form-textarea" placeholder="Tell us how we can help..." rows="6" required></textarea>
                        </div>
                        
                        <button type="submit" class="submit-button editable-text editable-section no-drop-zone" data-section="340" data-text="231">
                            Send Message
                        </button>
                    </form>
                </div>
            </div>

            <!-- Business Hours (Fully Editable) -->
            <div class="hours-section editable-section no-drop-zone" data-section="341">
                <h3 class="editable-text editable-section no-drop-zone" data-section="342" data-text="232">Business Hours</h3>
                <div class="hours-table">
                    <!-- Hours Row 1 -->
                    <div class="hours-row editable-section no-drop-zone" data-section="343">
                        <div class="hours-day editable-text editable-section no-drop-zone" data-section="344" data-text="233">Monday - Friday</div>
                        <div class="hours-time editable-text editable-section no-drop-zone" data-section="345" data-text="234">9:00 AM - 6:00 PM EST</div>
                    </div>
                    
                    <!-- Hours Row 2 -->
                    <div class="hours-row editable-section no-drop-zone" data-section="346">
                        <div class="hours-day editable-text editable-section no-drop-zone" data-section="347" data-text="235">Saturday</div>
                        <div class="hours-time editable-text editable-section no-drop-zone" data-section="348" data-text="236">10:00 AM - 4:00 PM EST</div>
                    </div>
                    
                    <!-- Hours Row 3 -->
                    <div class="hours-row editable-section no-drop-zone" data-section="349">
                        <div class="hours-day editable-text editable-section no-drop-zone" data-section="350" data-text="237">Sunday</div>
                        <div class="hours-time editable-text editable-section no-drop-zone" data-section="351" data-text="238">Closed</div>
                    </div>
                    
                    <!-- Hours Row 4 -->
                    <div class="hours-row editable-section no-drop-zone" data-section="352">
                        <div class="hours-day editable-text editable-section no-drop-zone" data-section="353" data-text="239">Holidays</div>
                        <div class="hours-time editable-text editable-section no-drop-zone" data-section="354" data-text="240">Special hours may apply</div>
                    </div>
                </div>
            </div>

            <!-- Map Section (Fully Editable) -->
            <div class="map-section editable-section no-drop-zone" data-section="355">
                <div class="map-placeholder">
                    <i class="fas fa-map-marked-alt editable-icon" data-icon="47" data-default-class="fas fa-map-marked-alt"></i>
                    <p class="editable-text editable-section no-drop-zone" data-section="356" data-text="241">Interactive Map Location</p>
                    <p class="editable-text editable-section no-drop-zone" data-section="357" data-text="242">Our showroom at 123 Luxury Lane, Design District, NY</p>
                </div>
            </div>

            <!-- FAQ Section (Fully Editable) -->
            <div class="faq-section editable-section" data-section="358">
                <div class="container">
                    <h2 class="editable-text editable-section no-drop-zone" data-section="359" data-text="243">Frequently Asked Questions</h2>
                    <div class="faq-container">
                        <!-- FAQ 1 -->
                        <div class="faq-item editable-section no-drop-zone" data-section="360">
                            <div class="faq-question editable-text editable-section no-drop-zone" data-section="361" data-text="244">
                                What is your return policy?
                                <span class="faq-icon"><i class="fas fa-chevron-down editable-icon" data-icon="48" data-default-class="fas fa-chevron-down"></i></span>
                            </div>
                            <div class="faq-answer editable-text editable-section no-drop-zone" data-section="362" data-text="245">
                                We offer a 30-day return policy for all full-priced items in original condition. Custom and personalized items are final sale. Returns must be initiated within 30 days of delivery, and items must be unused, in original packaging with all tags attached.
                            </div>
                        </div>

                        <!-- FAQ 2 -->
                        <div class="faq-item editable-section no-drop-zone" data-section="363">
                            <div class="faq-question editable-text editable-section no-drop-zone" data-section="364" data-text="246">
                                How long does shipping take?
                                <span class="faq-icon"><i class="fas fa-chevron-down editable-icon" data-icon="48" data-default-class="fas fa-chevron-down"></i></span>
                            </div>
                            <div class="faq-answer editable-text editable-section no-drop-zone" data-section="365" data-text="247">
                                Standard shipping takes 5-7 business days within the continental US. Express shipping (2-3 business days) is available for an additional fee. International shipping times vary by location, typically 10-14 business days. You'll receive tracking information once your order ships.
                            </div>
                        </div>

                        <!-- FAQ 3 -->
                        <div class="faq-item editable-section no-drop-zone" data-section="366">
                            <div class="faq-question editable-text editable-section no-drop-zone" data-section="367" data-text="248">
                                Do you offer international shipping?
                                <span class="faq-icon"><i class="fas fa-chevron-down editable-icon" data-icon="48" data-default-class="fas fa-chevron-down"></i></span>
                            </div>
                            <div class="faq-answer editable-text editable-section no-drop-zone" data-section="368" data-text="249">
                                Yes, we ship to over 50 countries worldwide. International shipping costs and delivery times vary by destination. Customs duties and taxes are the responsibility of the recipient and are not included in your order total. Please check your country's import regulations before ordering.
                            </div>
                        </div>

                        <!-- FAQ 4 -->
                        <div class="faq-item editable-section no-drop-zone" data-section="369">
                            <div class="faq-question editable-text editable-section no-drop-zone" data-section="370" data-text="250">
                                Can I visit your showroom?
                                <span class="faq-icon"><i class="fas fa-chevron-down editable-icon" data-icon="48" data-default-class="fas fa-chevron-down"></i></span>
                            </div>
                            <div class="faq-answer editable-text editable-section no-drop-zone" data-section="371" data-text="251">
                                Absolutely! Our flagship showroom in New York's Design District is open Monday through Friday, 9AM-6PM EST, and Saturday 10AM-4PM EST. We recommend scheduling an appointment for personalized service, especially for large projects. Walk-ins are always welcome during business hours.
                            </div>
                        </div>

                        <!-- FAQ 5 -->
                        <div class="faq-item editable-section no-drop-zone" data-section="372">
                            <div class="faq-question editable-text editable-section no-drop-zone" data-section="373" data-text="252">
                                Do you offer design consultation services?
                                <span class="faq-icon"><i class="fas fa-chevron-down editable-icon" data-icon="48" data-default-class="fas fa-chevron-down"></i></span>
                            </div>
                            <div class="faq-answer editable-text editable-section no-drop-zone" data-section="374" data-text="253">
                                Yes, we offer complimentary 30-minute design consultations for purchases over $1,000. Our design experts can help you select pieces that work perfectly in your space. For comprehensive design services, we offer paid consultation packages starting at $250. Contact us to schedule a consultation.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

   

    <script>
        // FAQ Toggle Functionality
        document.querySelectorAll('.faq-question').forEach(question => {
            question.addEventListener('click', () => {
                const faqItem = question.parentElement;
                faqItem.classList.toggle('active');
            });
        });

        // Form Submission
        document.getElementById('contact-form').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Get form data
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            
            // In a real implementation, this would send data to a server
            console.log('Form submitted:', data);
            
            // Show success message
            alert('Thank you for your message! We will get back to you within 24-48 hours.');
            
            // Reset form
            this.reset();
        });

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Add any initialization code here
        });
    </script>
</body>
</html>