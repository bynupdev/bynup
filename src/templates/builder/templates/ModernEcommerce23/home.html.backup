<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eclat Maison | Modern Interior Décor</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --charcoal: #2B2C31;
            --blush: #EC4477;
            --sage: #B5C272;
            --sand: #F4E3D9;
            --cloud: #F8F9FB;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius-lg: 24px;
            --border-radius-md: 16px;
            --transition: all 0.4s cubic-bezier(0.2, 0, 0, 1);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cloud);
            color: var(--charcoal);
            line-height: 1.5;
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, .serif-text {
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            letter-spacing: -0.02em;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        /* Header Styles */
        header.editable-section.no-drop-zone[data-section="1"] {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(248, 249, 251, 0.96);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(43, 44, 49, 0.08);
            transition: var(--transition);
        }
        
        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 2rem;
            max-width: 1600px;
            margin: 0 auto;
        }
        
        .logo a {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 500;
            text-decoration: none;
            color: var(--charcoal);
            letter-spacing: -0.3px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .logo a i {
            font-size: 1.6rem;
            color: var(--blush);
        }
        
        .nav-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }
        
        .nav-item {
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--charcoal);
            transition: color 0.2s;
            letter-spacing: 0.3px;
            text-transform: uppercase;
            position: relative;
        }
        
        .nav-item::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--blush);
            transition: width 0.3s ease;
        }
        
        .nav-item:hover::after {
            width: 100%;
        }
        
        .nav-item:hover {
            color: var(--blush);
        }
        
        .header-icons {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }
        
        .icon-link {
            text-decoration: none;
            font-size: 1.2rem;
            color: var(--charcoal);
            transition: color 0.2s;
            position: relative;
            display: inline-flex;
            align-items: center;
        }
        
        .icon-link:hover {
            color: var(--blush);
        }
        
        /* Account Dropdown */
        .account-dropdown {
            position: relative;
        }
        
        .dropdown-menu {
            position: absolute;
            top: 130%;
            right: 0;
            background: white;
            border-radius: var(--border-radius-md);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
            width: 220px;
            padding: 0.5rem 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.2s ease;
            z-index: 1100;
        }
        
        .account-dropdown:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        
        .dropdown-menu a {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.7rem 1.2rem;
            text-decoration: none;
            font-size: 0.85rem;
            color: var(--charcoal);
            transition: all 0.2s;
        }
        
        .dropdown-menu a i {
            width: 18px;
        }
        
        .dropdown-menu a:hover {
            background-color: var(--sand);
            color: var(--blush);
            padding-left: 1.5rem;
        }
        
        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.6rem;
            cursor: pointer;
            color: var(--charcoal);
        }
        
        /* Hero Section */
        section.hero.editable-section[data-section="13"] {
            min-height: 90vh;
            position: relative;
            display: flex;
            align-items: center;
            background-color: var(--sand);
            overflow: hidden;
        }
        
        .hero-bg {
            position: absolute;
            inset: 0;
            background-image: url('https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=1600');
            background-size: cover;
            background-position: center 30%;
            z-index: 0;
        }
        
        .hero-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(105deg, rgba(244, 227, 217, 0.85) 0%, rgba(244, 227, 217, 0.4) 70%);
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 680px;
            padding: 2rem;
            margin-left: 5%;
        }
        
        h1.editable-text.editable-section.no-drop-zone[data-section="14"] {
            font-size: 4.2rem;
            font-weight: 500;
            color: var(--charcoal);
            line-height: 1.2;
            margin-bottom: 1.5rem;
        }
        
        p.editable-text.editable-section.no-drop-zone[data-section="15"] {
            font-size: 1.2rem;
            color: rgba(43, 44, 49, 0.75);
            margin-bottom: 2rem;
            max-width: 500px;
            line-height: 1.6;
        }
        
        a.primary-action.editable-text.editable-section.no-drop-zone[data-section="16"] {
            display: inline-block;
            background-color: var(--blush);
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: var(--transition);
            box-shadow: 0 8px 20px rgba(236, 68, 119, 0.2);
        }
        
        a.primary-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(236, 68, 119, 0.3);
            background-color: #d63b6a;
        }
        
        /* New Arrivals Section */
        section.new-arrivals.editable-section[data-section="17"] {
            padding: var(--spacing-xl) 0;
            background-color: var(--cloud);
        }
        
        .section-header {
            text-align: center;
            margin-bottom: var(--spacing-lg);
        }
        
        h2.editable-text.editable-section.no-drop-zone[data-section="18"] {
            font-size: 2.8rem;
            margin-bottom: 1rem;
            color: var(--charcoal);
        }
        
        .section-subhead.editable-text.editable-section.no-drop-zone[data-section="19"] {
            font-size: 1rem;
            color: rgba(43, 44, 49, 0.6);
            max-width: 600px;
            margin: 0 auto;
        }
        
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }
        
        div.product-card.editable-section.no-drop-zone[data-section="20"] {
            background: white;
            border-radius: var(--border-radius-lg);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
        }
        
        div.product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }
        
        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1.1;
            object-fit: cover;
            transition: transform 0.6s ease;
        }
        
        div.product-card:hover .product-img {
            transform: scale(1.03);
        }
        
        .product-info {
            padding: 1.2rem 1.2rem 1.5rem;
        }
        
        .product-name.editable-section.no-drop-zone[data-section="22"] {
            font-weight: 500;
            font-size: 1rem;
            margin-bottom: 0.4rem;
            color: var(--charcoal);
        }
        
        .product-price.editable-section.no-drop-zone[data-section="23"] {
            font-weight: 400;
            color: var(--blush);
            font-size: 1rem;
        }
        
        .product-category.editable-section.no-drop-zone[data-section="21"] {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--sage);
            margin-bottom: 0.5rem;
        }
        
        a.see-more-link.editable-text.editable-section.no-drop-zone[data-section="24"] {
            display: inline-block;
            color: var(--blush);
            text-decoration: none;
            font-weight: 500;
            border-bottom: 1px solid var(--blush);
            padding-bottom: 4px;
            transition: gap 0.2s;
        }
        
        a.see-more-link:hover {
            letter-spacing: 0.5px;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: var(--border-radius-lg);
            grid-column: 1 / -1;
        }
        
        .empty-state h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--charcoal);
        }
        
        .empty-state a {
            color: var(--blush);
            text-decoration: none;
        }
        
        /* Footer Styles */
        footer.editable-section[data-section="25"] {
            background-color: var(--charcoal);
            color: var(--cloud);
            padding: var(--spacing-xl) 0 var(--spacing-lg);
            margin-top: var(--spacing-xl);
        }
        
        .footer-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 3rem;
            margin-bottom: 3rem;
        }
        
        .footer-column h3.editable-text.editable-section.no-drop-zone[data-section="27"] {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 500;
            margin-bottom: 1.5rem;
            color: var(--blush);
            position: relative;
            display: inline-block;
        }
        
        .footer-column h3::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 40px;
            height: 2px;
            background: var(--blush);
        }
        
        .footer-column p {
            color: rgba(248, 249, 251, 0.7);
            line-height: 1.6;
            margin-bottom: 1rem;
        }
        
        .footer-column ul {
            list-style: none;
            padding: 0;
        }
        
        .footer-column ul li {
            margin-bottom: 0.8rem;
        }
        
        .footer-column ul li a {
            color: rgba(248, 249, 251, 0.7);
            text-decoration: none;
            transition: var(--transition);
            display: inline-block;
        }
        
        .footer-column ul li a:hover {
            color: var(--blush);
            transform: translateX(5px);
        }
        
        /* Social Media Section */
        .footer-social {
            margin-top: 1rem;
        }
        
        .footer-social h4 {
            font-size: 1.1rem;
            margin-bottom: 1rem;
            color: var(--cloud);
        }
        
        .social-links {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        
        .social-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(248, 249, 251, 0.1);
            color: var(--cloud);
            text-decoration: none;
            transition: var(--transition);
        }
        
        .social-link:hover {
            background: var(--blush);
            transform: translateY(-3px);
            color: white;
        }
        
        .social-link i {
            font-size: 1.2rem;
        }
        
        /* Newsletter Section */
        .newsletter-section {
            margin-top: 1rem;
        }
        
        .newsletter-form {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }
        
        .newsletter-input {
            flex: 1;
            padding: 0.8rem 1rem;
            border: 1px solid rgba(248, 249, 251, 0.2);
            background: rgba(248, 249, 251, 0.05);
            border-radius: 50px;
            color: var(--cloud);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
        }
        
        .newsletter-input::placeholder {
            color: rgba(248, 249, 251, 0.5);
        }
        
        .newsletter-btn {
            padding: 0.8rem 1.5rem;
            background: var(--blush);
            color: white;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 500;
            transition: var(--transition);
        }
        
        .newsletter-btn:hover {
            background: #d63b6a;
            transform: translateY(-2px);
        }
        
        /* Contact Info */
        .contact-info-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin-bottom: 1rem;
            color: rgba(248, 249, 251, 0.7);
        }
        
        .contact-info-item i {
            width: 24px;
            color: var(--blush);
            font-size: 1rem;
        }
        
        /* Copyright */
        .footer-bottom {
            text-align: center;
            padding-top: 2rem;
            margin-top: 2rem;
            border-top: 1px solid rgba(248, 249, 251, 0.1);
            color: rgba(248, 249, 251, 0.6);
            font-size: 0.85rem;
        }
        
        /* Mobile Navigation Panel */
        .mobile-nav-panel {
            position: fixed;
            top: 0;
            left: 0;
            width: 85%;
            max-width: 320px;
            height: 100%;
            background: white;
            z-index: 2000;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 30px rgba(0, 0, 0, 0.1);
        }
        
        .mobile-nav-panel.open {
            transform: translateX(0);
        }
        
        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--sand);
        }
        
        .back-button {
            background: none;
            border: none;
            font-size: 1rem;
            font-weight: 500;
            cursor: pointer;
            color: var(--blush);
        }
        
        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }
        
        .mobile-nav-links a {
            text-decoration: none;
            font-size: 1.1rem;
            color: var(--charcoal);
            padding: 0.5rem 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .mobile-nav-links a i {
            width: 24px;
        }
        
        .mobile-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.3);
            z-index: 1999;
            opacity: 0;
            visibility: hidden;
            transition: 0.2s;
        }
        
        .mobile-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        /* Responsive */
        @media (max-width: 1024px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
            }
            h1.editable-text.editable-section.no-drop-zone[data-section="14"] {
                font-size: 3.2rem;
            }
            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
            }
        }
        
        @media (max-width: 768px) {
            .nav-links, .header-icons {
                display: none;
            }
            .mobile-menu-btn {
                display: block;
            }
            .hero-content {
                margin-left: 0;
                text-align: center;
                padding: 2rem;
            }
            p.editable-text.editable-section.no-drop-zone[data-section="15"] {
                margin-left: auto;
                margin-right: auto;
            }
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 380px;
                margin-left: auto;
                margin-right: auto;
            }
            h2.editable-text.editable-section.no-drop-zone[data-section="18"] {
                font-size: 2.2rem;
            }
            .container, .footer-container {
                padding: 0 1.2rem;
            }
            .footer-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            .newsletter-form {
                flex-direction: column;
            }
            .newsletter-btn {
                width: 100%;
            }
        }
        
        @media (max-width: 480px) {
            h1.editable-text.editable-section.no-drop-zone[data-section="14"] {
                font-size: 2.4rem;
            }
        }
    </style>
</head>
<body>

<!-- Header -->
<header class="editable-section no-drop-zone" data-section="1">
    <div class="header-inner">
        <div class="logo">
            <a href="?page=home">
                <i class="fas fa-crown editable-icon" data-icon="1" data-default-class="fas fa-crown"></i>
                <span class="editable-text editable-section no-drop-zone" data-section="2" data-text="1">Éclat<span style="color: var(--blush);">Maison</span></span>
            </a>
        </div>
        
        <nav class="nav-links">
            <a href="?page=home" class="nav-item editable-text editable-section no-drop-zone" data-section="3" data-text="2">Home</a>
            <a href="?page=products" class="nav-item editable-text editable-section no-drop-zone" data-section="4" data-text="3">Shop</a>
            <a href="?page=about" class="nav-item editable-text editable-section no-drop-zone" data-section="5" data-text="4">About Us</a>
            <a href="?page=contact" class="nav-item editable-text editable-section no-drop-zone" data-section="6" data-text="5">Contact</a>
        </nav>
        
        <div class="header-icons">
            <a href="?page=cart" class="icon-link">
                <i class="fas fa-shopping-bag editable-icon" data-icon="2" data-default-class="fas fa-shopping-bag"></i>
            </a>
            <a href="?page=wishlist" class="icon-link">
                <i class="far fa-heart editable-icon" data-icon="3" data-default-class="far fa-heart"></i>
            </a>
            <div class="account-dropdown">
                <i class="far fa-user editable-icon" data-icon="4" data-default-class="far fa-user" style="cursor: pointer; font-size: 1.2rem;"></i>
                <div class="dropdown-menu">
                    <a href="?page=login" class="editable-text editable-section no-drop-zone" data-section="7" data-text="6">
                        <i class="fas fa-sign-in-alt"></i> Sign In
                    </a>
                    <a href="?page=register" class="editable-text editable-section no-drop-zone" data-section="8" data-text="7">
                        <i class="fas fa-user-plus"></i> Sign Up
                    </a>
                    <a href="?page=orders" class="editable-text editable-section no-drop-zone" data-section="9" data-text="8">
                        <i class="fas fa-box"></i> Orders
                    </a>
                    <a href="?page=wishlist" class="editable-text editable-section no-drop-zone" data-section="10" data-text="9">
                        <i class="fas fa-heart"></i> Wishlist
                    </a>
                    <a href="?page=account" class="editable-text editable-section no-drop-zone" data-section="11" data-text="10">
                        <i class="fas fa-user-cog"></i> Account Settings
                    </a>
                </div>
            </div>
        </div>
        
        <button class="mobile-menu-btn" id="mobileMenuBtn">
            <i class="fas fa-bars editable-icon" data-icon="5" data-default-class="fas fa-bars"></i>
        </button>
    </div>
</header>

<!-- Mobile Navigation Panel -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-nav-panel" id="mobileNavPanel">
    <div class="panel-header">
        <button class="back-button" id="closeNavBtn">← Back</button>
        <span style="font-weight: 500;">Menu</span>
    </div>
    <div class="mobile-nav-links">
        <a href="?page=home"><i class="fas fa-home"></i> Home</a>
        <a href="?page=products"><i class="fas fa-shopping-bag"></i> Shop</a>
        <a href="?page=about"><i class="fas fa-info-circle"></i> About Us</a>
        <a href="?page=contact"><i class="fas fa-envelope"></i> Contact</a>
        <a href="?page=cart"><i class="fas fa-shopping-cart"></i> Cart</a>
        <a href="?page=wishlist"><i class="far fa-heart"></i> Wishlist</a>
        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--sand);">
            <a href="?page=login"><i class="fas fa-sign-in-alt"></i> Sign In</a>
            <a href="?page=register"><i class="fas fa-user-plus"></i> Sign Up</a>
            <a href="?page=orders"><i class="fas fa-box"></i> Orders</a>
        </div>
    </div>
</div>

<!-- Hero Section -->
<section class="hero editable-section" data-section="13">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <h1 class="editable-text editable-section no-drop-zone" data-section="14" data-text="11">Design Your Space,<br>Beautifully</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="15" data-text="12">Curated décor pieces that bring warmth, style, and personality into every corner of your home.</p>
        <a href="?page=products" class="primary-action editable-text editable-section no-drop-zone" data-section="16" data-text="13">Shop Décor →</a>
    </div>
</section>

<!-- New Arrivals Section -->
<section class="new-arrivals editable-section" data-section="17">
    <div class="container">
        <div class="section-header">
            <h2 class="editable-text editable-section no-drop-zone" data-section="18" data-text="14">New Arrivals</h2>
            <p class="section-subhead editable-text editable-section no-drop-zone" data-section="19" data-text="15">Fresh finds to transform your space</p>
        </div>
        
        <div class="products-grid">
            <!-- Product 1 - Editable -->
            <div class="product-card editable-section no-drop-zone" data-section="20">
