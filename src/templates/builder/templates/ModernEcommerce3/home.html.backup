<!-- builder/templates/ModernEcommerce14/home.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Velora • Timeless Luxury</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* CSS Reset & Variables */
        :root {
            --gold-1: #e2a970;
            --gold-2: #f1bb71;
            --gold-3: #fbca8a;
            --olive: #626616;
            --white: #ffffff;
            --black: #000000;
            --spacing-xs: 0.25rem;
            --spacing-sm: 0.5rem;
            --spacing-md: 1rem;
            --spacing-lg: 1.5rem;
            --spacing-xl: 2rem;
            --spacing-2xl: 3rem;
            --spacing-3xl: 4rem;
            --container-max: 1400px;
            --border-radius: 0.75rem;
            --transition: all 0.3s ease;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--white);
            color: var(--olive);
            overflow-x: hidden;
            width: 100%;
            line-height: 1.5;
        }
        
        .heading-font {
            font-family: 'Playfair Display', serif;
        }

        /* Container System */
        .container {
            width: 100%;
            max-width: var(--container-max);
            margin: 0 auto;
            padding: 0 1rem;
        }
        
        @media (min-width: 640px) {
            .container {
                padding: 0 1.5rem;
            }
        }
        
        @media (min-width: 768px) {
            .container {
                padding: 0 2rem;
            }
        }
        
        @media (min-width: 1024px) {
            .container {
                padding: 0 3rem;
            }
        }

        /* Hero Section */
        .hero-bg {
            background-image: linear-gradient(rgba(98, 102, 22, 0.15), rgba(98, 102, 22, 0.25)), 
                             url('https://picsum.photos/id/1015/2000/1200');
            background-size: cover;
            background-position: center;
            min-height: 100vh;
            width: 100%;
            position: relative;
            display: flex;
            align-items: center;
        }
        
        @media (min-width: 1024px) {
            .hero-bg {
                background-attachment: fixed;
            }
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, 
                        rgba(226, 169, 112, 0.08) 0%,
                        rgba(241, 187, 113, 0.12) 50%,
                        rgba(251, 202, 138, 0.08) 100%);
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 42rem;
            padding: 5rem 1rem 0;
        }
        
        @media (min-width: 768px) {
            .hero-content {
                padding: 5rem 2rem 0;
            }
        }

        /* Navigation */
        .header {
            /* position: fixed;
            top: 0;
            left: 0;
            right: 0; */
            z-index: 50;
            background-color: var(--white);
            border-bottom: 1px solid rgba(226, 169, 112, 0.3);
            width: 100%;
        }

        .header-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1rem;
        }
        
        @media (min-width: 640px) {
            .header-container {
                padding: 1rem 1.5rem;
            }
        }
        
        @media (min-width: 768px) {
            .header-container {
                padding: 1.25rem 2rem;
            }
        }
        
        @media (min-width: 1024px) {
            .header-container {
                padding: 1.25rem 3rem;
            }
        }

        .logo-wrapper {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-shrink: 0;
        }

        .logo-icon {
            width: 2rem;
            height: 2rem;
            border-radius: 9999px;
            background-color: var(--olive);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        @media (min-width: 768px) {
            .logo-icon {
                width: 2rem;
                height: 2rem;
            }
        }

        .logo-icon span {
            color: var(--white);
            font-size: 1.5rem;
            line-height: 1;
            margin-top: 0.125rem;
        }

        .logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            letter-spacing: -0.05em;
            font-weight: 500;
            color: var(--olive);
            white-space: nowrap;
        }
        
        @media (min-width: 768px) {
            .logo-text {
                font-size: 1.875rem;
            }
        }

        .desktop-nav {
            display: none;
            align-items: center;
            gap: 2.5rem;
        }
        
        @media (min-width: 768px) {
            .desktop-nav {
                display: flex;
            }
        }

        .nav-link {
            font-size: 0.875rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-decoration: none;
            color: var(--olive);
            position: relative;
            transition: var(--transition);
        }

        .nav-link:after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -2px;
            left: 0;
            background-color: var(--olive);
            transition: width 0.3s ease;
        }

        .nav-link:hover:after {
            width: 100%;
        }

        .icon-group {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            flex-shrink: 0;
        }
        
        @media (min-width: 640px) {
            .icon-group {
                gap: 1.5rem;
            }
        }

        .icon-btn {
            background: none;
            border: none;
            color: var(--olive);
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.25rem;
            position: relative;
        }
        
        @media (min-width: 640px) {
            .icon-btn {
                font-size: 1.5rem;
            }
        }

        .icon-btn:hover {
            color: var(--gold-3);
        }

        .cart-count {
            position: absolute;
            top: -0.25rem;
            right: -0.25rem;
            background-color: var(--gold-3);
            color: var(--olive);
            font-size: 0.625rem;
            font-weight: bold;
            width: 1rem;
            height: 1rem;
            border-radius: 9999px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        @media (min-width: 640px) {
            .cart-count {
                width: 1.25rem;
                height: 1.25rem;
            }
        }

        .account-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--white);
            min-width: 200px;
            box-shadow: 0 10px 25px rgba(98, 102, 22, 0.1);
            z-index: 60;
            border-radius: 0.75rem;
            overflow: hidden;
            margin-top: 0.5rem;
            border: 1px solid rgba(226, 169, 112, 0.3);
        }

        .dropdown-content a {
            color: var(--olive);
            padding: 0.75rem 1.5rem;
            text-decoration: none;
            display: block;
            font-size: 0.875rem;
            border-bottom: 1px solid rgba(226, 169, 112, 0.2);
            transition: var(--transition);
        }

        .dropdown-content a:hover {
            background-color: rgba(251, 202, 138, 0.1);
            color: var(--gold-2);
        }

        .dropdown-divider {
            height: 1px;
            background-color: rgba(226, 169, 112, 0.2);
            margin: 0.5rem 0;
        }

        .account-dropdown:hover .dropdown-content,
        .account-dropdown:focus-within .dropdown-content {
            display: block;
        }

        /* Mobile Menu */
        .hamburger {
            display: block;
            font-size: 1.5rem;
            background: none;
            border: none;
            color: var(--olive);
            cursor: pointer;
        }
        
        @media (min-width: 768px) {
            .hamburger {
                display: none;
            }
        }

        .mobile-menu {
            display: none;
            position: fixed;
            inset: 0;
            background-color: var(--white);
            z-index: 100;
            flex-direction: column;
            width: 100%;
            height: 100%;
            overflow-y: auto;
            animation: slideIn 0.4s cubic-bezier(0.32, 0.72, 0, 1);
        }

        .mobile-menu.active {
            display: flex;
        }

        .mobile-menu-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(226, 169, 112, 0.3);
            flex-shrink: 0;
        }

        .mobile-menu-links {
            padding: 2rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            font-size: 1.25rem;
            font-weight: 500;
            letter-spacing: 0.1em;
        }

        .mobile-menu-links a {
            text-decoration: none;
            color: var(--olive);
            padding: 0.25rem 0;
        }

        .mobile-menu-divider {
            height: 1px;
            background-color: rgba(226, 169, 112, 0.3);
            margin: 1.5rem 0;
        }

        .mobile-menu-footer {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            font-size: 1rem;
        }

        .mobile-menu-footer a {
            display: flex;
            align-items: center;
            gap: 1rem;
            text-decoration: none;
            color: var(--olive);
        }

        .back-btn {
            font-size: 1.5rem;
            background: none;
            border: none;
            color: var(--olive);
            cursor: pointer;
        }

        /* Hero Elements */
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            background-color: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(4px);
            padding: 0.5rem 1.25rem;
            border-radius: 9999px;
            margin-bottom: 1.5rem;
        }
        
        @media (min-width: 640px) {
            .hero-badge {
                margin-bottom: 2rem;
            }
        }

        .hero-badge-dot {
            width: 0.5rem;
            height: 0.5rem;
            background-color: var(--olive);
            border-radius: 9999px;
            animation: pulse 2s infinite;
        }

        .hero-badge-text {
            text-transform: uppercase;
            font-size: 0.625rem;
            letter-spacing: 0.15em;
            font-weight: 500;
        }
        
        @media (min-width: 640px) {
            .hero-badge-text {
                font-size: 0.75rem;
                letter-spacing: 0.2em;
            }
        }

        .hero-title {
            font-family: 'Playfair Display', serif;
            font-size: 15vw;
            line-height: 0.9;
            font-weight: 300;
            letter-spacing: -0.05em;
            color: var(--white);
            text-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }
        
        @media (min-width: 640px) {
            .hero-title {
                font-size: 5.75rem;
            }
        }
        
        @media (min-width: 768px) {
            .hero-title {
                font-size: 7.5rem;
            }
        }

        .hero-subtitle {
            margin-top: 1rem;
            font-size: 1.125rem;
            color: rgba(255, 255, 255, 0.9);
            max-width: 24rem;
            line-height: 1.2;
        }
        
        @media (min-width: 640px) {
            .hero-subtitle {
                margin-top: 1.5rem;
                font-size: 1.5rem;
            }
        }

        .hero-cta {
            margin-top: 2.5rem;
            display: inline-flex;
            align-items: center;
            gap: 1rem;
        }
        
        @media (min-width: 640px) {
            .hero-cta {
                margin-top: 4rem;
                gap: 1.5rem;
            }
        }

        .hero-cta-btn {
            background-color: var(--olive);
            color: var(--white);
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: 500;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
        }
        
        @media (min-width: 640px) {
            .hero-cta-btn {
                padding: 1rem 2.5rem;
                font-size: 1.125rem;
                border-radius: 1rem;
            }
        }

        .hero-cta-btn:hover {
            background-color: var(--gold-3);
            color: var(--olive);
        }

        .hero-cta-icon {
            width: 2.5rem;
            height: 2.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(255, 255, 255, 0.7);
            border-radius: 0.75rem;
            transition: var(--transition);
            flex-shrink: 0;
        }
        
        @media (min-width: 640px) {
            .hero-cta-icon {
                width: 3.5rem;
                height: 3.5rem;
                border-radius: 1rem;
            }
        }

        .hero-cta-icon i {
            color: var(--white);
            font-size: 1rem;
            transition: var(--transition);
        }
        
        @media (min-width: 640px) {
            .hero-cta-icon i {
                font-size: 1.25rem;
            }
        }

        .hero-cta-icon:hover {
            border-color: var(--gold-3);
        }

        .hero-cta-icon:hover i {
            color: var(--gold-3);
        }

        .hero-location {
            margin-top: 3rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.625rem;
            letter-spacing: 0.1em;
        }
        
        @media (min-width: 640px) {
            .hero-location {
                margin-top: 5rem;
                font-size: 0.75rem;
                gap: 2rem;
            }
        }

        .hero-location-line {
            height: 1px;
            width: 2rem;
            background-color: rgba(255, 255, 255, 0.4);
        }
        
        @media (min-width: 640px) {
            .hero-location-line {
                width: 3rem;
            }
        }

        .hero-scroll {
            position: absolute;
            bottom: 1.5rem;
            left: 50%;
            transform: translateX(-50%);
            display: none;
            flex-direction: column;
            align-items: center;
            gap: 0.25rem;
            color: rgba(255, 255, 255, 0.6);
        }
        
        @media (min-width: 640px) {
            .hero-scroll {
                display: flex;
            }
        }

        .hero-scroll span {
            font-size: 0.625rem;
            letter-spacing: 0.1em;
        }
        
        @media (min-width: 640px) {
            .hero-scroll span {
                font-size: 0.75rem;
            }
        }

        .hero-scroll i {
            font-size: 1rem;
            animation: bounce 2s infinite;
        }
        
        @media (min-width: 640px) {
            .hero-scroll i {
                font-size: 1.25rem;
            }
        }

        /* Floating Card */
        .floating-card {
            display: none;
            position: absolute;
            bottom: 3rem;
            right: 3rem;
            background-color: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            padding: 1.25rem;
            border-radius: 1rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            max-width: 260px;
        }
        
        @media (min-width: 1280px) {
            .floating-card {
                display: block;
            }
        }

        .floating-card img {
            width: 100%;
            border-radius: 0.75rem;
            box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
            object-fit: cover;
        }

        .floating-card-content {
            margin-top: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .floating-card-label {
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--olive);
        }

        .floating-card-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            color: var(--olive);
        }

        .floating-card-price {
            font-size: 1.5rem;
            font-weight: 300;
            color: var(--gold-3);
        }

        /* New Arrivals Section */
        .section {
            padding: 4rem 0;
        }
        
        @media (min-width: 640px) {
            .section {
                padding: 5rem 0;
            }
        }
        
        @media (min-width: 1024px) {
            .section {
                padding: 7rem 0;
            }
        }

        .section-header {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2.5rem;
            gap: 1rem;
        }
        
        @media (min-width: 640px) {
            .section-header {
                flex-direction: row;
                align-items: flex-end;
                margin-bottom: 4rem;
            }
        }

        .section-eyebrow {
            text-transform: uppercase;
            font-size: 0.625rem;
            letter-spacing: 0.2em;
            color: var(--gold-1);
        }
        
        @media (min-width: 640px) {
            .section-eyebrow {
                font-size: 0.75rem;
                letter-spacing: 0.25em;
            }
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            font-weight: 300;
            letter-spacing: -0.02em;
            color: var(--olive);
        }
        
        @media (min-width: 640px) {
            .section-title {
                font-size: 3rem;
            }
        }
        
        @media (min-width: 1024px) {
            .section-title {
                font-size: 3.75rem;
            }
        }

        .section-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-decoration: none;
            color: var(--olive);
            transition: var(--transition);
        }
        
        @media (min-width: 640px) {
            .section-link {
                font-size: 0.875rem;
                gap: 0.75rem;
            }
        }

        .section-link:hover {
            text-decoration: underline;
        }

        .section-link span {
            font-size: 1.25rem;
            transition: transform 0.3s ease;
        }
        
        @media (min-width: 640px) {
            .section-link span {
                font-size: 1.5rem;
            }
        }

        .section-link:hover span {
            transform: translateX(0.5rem);
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        
        @media (min-width: 640px) {
            .products-grid {
                gap: 1.25rem;
            }
        }
        
        @media (min-width: 768px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }
        }
        
        @media (min-width: 1024px) {
            .products-grid {
                grid-template-columns: repeat(4, 1fr);
                gap: 2rem;
            }
        }

        .product-card {
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .product-card:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: 0 25px 50px -12px rgba(98, 102, 22, 0.15);
        }

        .product-image-wrapper {
            position: relative;
            overflow: hidden;
            border-radius: 0.75rem;
            aspect-ratio: 4 / 5;
        }
        
        @media (min-width: 640px) {
            .product-image-wrapper {
                border-radius: 1rem;
            }
        }
        
        @media (min-width: 1024px) {
            .product-image-wrapper {
                border-radius: 1.5rem;
            }
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-image {
            transform: scale(1.1);
        }

        .product-badge {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            background-color: var(--white);
            padding: 0.25rem 0.75rem;
            border-radius: 0.75rem;
            font-size: 0.625rem;
            font-weight: 500;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
        }
        
        @media (min-width: 640px) {
            .product-badge {
                top: 1rem;
                right: 1rem;
                padding: 0.5rem 1.25rem;
                font-size: 0.75rem;
                border-radius: 1rem;
            }
        }

        .product-badge.bestseller {
            background-color: var(--gold-3);
            color: var(--olive);
        }

        .product-info {
            margin-top: 0.75rem;
            padding: 0 0.25rem;
        }
        
        @media (min-width: 640px) {
            .product-info {
                margin-top: 1.5rem;
                padding: 0 0.5rem;
            }
        }

        .product-details {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 0.25rem;
        }

        .product-name {
            font-weight: 500;
            font-size: 0.875rem;
        }
        
        @media (min-width: 640px) {
            .product-name {
                font-size: 1rem;
            }
        }
        
        @media (min-width: 1024px) {
            .product-name {
                font-size: 1.125rem;
            }
        }

        .product-category {
            font-size: 0.75rem;
            color: rgba(98, 102, 22, 0.6);
        }
        
        @media (min-width: 640px) {
            .product-category {
                font-size: 0.875rem;
            }
        }

        .product-price {
            font-size: 1rem;
            font-weight: 300;
            color: var(--gold-3);
            white-space: nowrap;
        }
        
        @media (min-width: 640px) {
            .product-price {
                font-size: 1.125rem;
            }
        }
        
        @media (min-width: 1024px) {
            .product-price {
                font-size: 1.25rem;
            }
        }

        /* Footer */
        .footer {
            background-color: var(--olive);
            color: var(--white);
            padding: 3rem 0;
        }
        
        @media (min-width: 1024px) {
            .footer {
                padding: 5rem 0;
            }
        }

        .footer-grid {
            display: grid;
            gap: 2rem;
        }
        
        @media (min-width: 768px) {
            .footer-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 3rem;
            }
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            color: var(--white);
        }

        .footer-logo-icon {
            width: 2rem;
            height: 2rem;
            border-radius: 9999px;
            background-color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .footer-logo-icon span {
            color: var(--olive);
            font-size: 1.5rem;
            line-height: 1;
            margin-top: 0.125rem;
        }

        .footer-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.875rem;
            letter-spacing: -0.05em;
        }

        .footer-description {
            margin-top: 1.5rem;
            max-width: 20rem;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.875rem;
        }

        .footer-links-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }
        
        @media (min-width: 640px) {
            .footer-links-grid {
                gap: 2rem;
            }
        }

        .footer-links-title {
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-size: 0.75rem;
            margin-bottom: 1rem;
            opacity: 0.6;
        }
        
        @media (min-width: 640px) {
            .footer-links-title {
                font-size: 0.875rem;
                margin-bottom: 1.5rem;
            }
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        @media (min-width: 640px) {
            .footer-links {
                gap: 1rem;
            }
        }

        .footer-links a {
            color: var(--white);
            text-decoration: none;
            font-size: 0.875rem;
            transition: var(--transition);
        }

        .footer-links a:hover {
            color: var(--gold-3);
        }

        .newsletter {
            text-align: right;
        }

        .newsletter-title {
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            opacity: 0.6;
        }

        .newsletter-form {
            margin-top: 0.75rem;
            display: flex;
        }

        .newsletter-input {
            flex: 1;
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 0.75rem 1rem;
            border-radius: 1rem 0 0 1rem;
            color: var(--white);
            font-size: 0.875rem;
            outline: none;
        }
        
        @media (min-width: 640px) {
            .newsletter-input {
                padding: 1rem 1.5rem;
            }
        }

        .newsletter-input:focus {
            border-color: var(--white);
        }

        .newsletter-btn {
            background-color: var(--white);
            color: var(--olive);
            padding: 0.75rem 1.5rem;
            border-radius: 0 1rem 1rem 0;
            font-weight: 500;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }
        
        @media (min-width: 640px) {
            .newsletter-btn {
                padding: 1rem 2rem;
            }
        }

        .newsletter-btn:hover {
            background-color: var(--gold-3);
        }

        .copyright {
            text-align: center;
            font-size: 0.625rem;
            letter-spacing: 0.1em;
            opacity: 0.4;
            margin-top: 4rem;
        }
        
        @media (min-width: 1024px) {
            .copyright {
                margin-top: 6rem;
            }
        }

        /* Animations */
        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: 0.5;
            }
        }

        @keyframes bounce {
            0%, 100% {
                transform: translateY(0);
                animation-timing-function: cubic-bezier(0.8, 0, 1, 1);
            }
            50% {
                transform: translateY(-25%);
                animation-timing-function: cubic-bezier(0, 0, 0.2, 1);
            }
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
            }
            to {
                transform: translateX(0);
            }
        }

        .animate-pulse {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        .animate-bounce {
            animation: bounce 2s infinite;
        }

        /* Utility Classes */
        .relative {
            position: relative;
        }

        .absolute {
            position: absolute;
        }

        .fixed {
            position: fixed;
        }

        .inset-0 {
            inset: 0;
        }

        .z-10 {
            z-index: 10;
        }

        .z-50 {
            z-index: 50;
        }

        .hidden {
            display: none;
        }

        .block {
            display: block;
        }

        .flex {
            display: flex;
        }

        .grid {
            display: grid;
        }

        .w-full {
            width: 100%;
        }

        .max-w-screen-2xl {
            max-width: 1400px;
        }

        .mx-auto {
            margin-left: auto;
            margin-right: auto;
        }

        .text-center {
            text-align: center;
        }

        .text-right {
            text-align: right;
        }

        .text-white {
            color: var(--white);
        }

        .text-\[\#626616\] {
            color: var(--olive);
        }

        .bg-white {
            background-color: var(--white);
        }

        .bg-\[\#626616\] {
            background-color: var(--olive);
        }

        .border-b {
            border-bottom-width: 1px;
            border-bottom-style: solid;
        }

        .border-\[\#e2a970\]\/30 {
            border-color: rgba(226, 169, 112, 0.3);
        }

        .py-4 {
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .px-4 {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        /* Responsive Padding/Margin Utilities */
        .pt-20 {
            padding-top: 5rem;
        }

        .pt-24 {
            padding-top: 6rem;
        }

        .pb-16 {
            padding-bottom: 4rem;
        }

        .mb-4 {
            margin-bottom: 1rem;
        }

        .mb-8 {
            margin-bottom: 2rem;
        }

        .mb-16 {
            margin-bottom: 4rem;
        }

        .mt-4 {
            margin-top: 1rem;
        }

        .mt-6 {
            margin-top: 1.5rem;
        }

        .mt-10 {
            margin-top: 2.5rem;
        }

        .mt-12 {
            margin-top: 3rem;
        }

        .mt-16 {
            margin-top: 4rem;
        }

        .mt-20 {
            margin-top: 5rem;
        }

        .gap-4 {
            gap: 1rem;
        }

        .gap-8 {
            gap: 2rem;
        }
    </style>
</head>
<body>

    <!-- HEADER - editable-section with no-drop-zone -->
    <header class="header editable-section no-drop-zone" data-section="1">
        <div class="container header-container">
            <!-- Logo -->
            <div class="logo-wrapper">
                <div class="logo-icon">
                    <span>V</span>
                </div>
                <span class="logo-text editable-text editable-section no-drop-zone" data-section="2" data-text="1">velora</span>
            </div>

            <!-- Desktop Navigation -->
            <nav class="desktop-nav">
                <a href="?page=home" class="nav-link editable-text editable-section no-drop-zone" data-section="3" data-text="2">HOME</a>
                <a href="?page=shop" class="nav-link editable-text editable-section no-drop-zone" data-section="4" data-text="3">SHOP</a>
                <a href="?page=about" class="nav-link editable-text editable-section no-drop-zone" data-section="5" data-text="4">ABOUT US</a>
                <a href="?page=contact" class="nav-link editable-text editable-section no-drop-zone" data-section="6" data-text="5">CONTACT</a>
            </nav>

            <!-- Right side icons -->
            <div class="icon-group">
                <!-- Wishlist -->
                <button onclick="toggleWishlist()" class="icon-btn">
                    <i class="fa-regular fa-heart editable-icon" data-icon="1" data-default-class="fa-regular fa-heart"></i>
                </button>
                
                <!-- Cart -->
                <button onclick="toggleCart()" class="icon-btn relative">
                    <i class="fa-solid fa-bag-shopping editable-icon" data-icon="2" data-default-class="fa-solid fa-bag-shopping"></i>
                    <span id="cart-count" class="cart-count">3</span>
                </button>

                <!-- Account Dropdown -->
                <div class="account-dropdown hidden sm:block">
                    <button class="icon-btn">
                        <i class="fa-regular fa-user editable-icon" data-icon="3" data-default-class="fa-regular fa-user"></i>
                    </button>
                    
                    <div class="dropdown-content">
                        <a href="?page=login" class="editable-text editable-section no-drop-zone" data-section="7" data-text="6">Sign In</a>
                        <a href="?page=register" class="editable-text editable-section no-drop-zone" data-section="8" data-text="7">Create Account</a>
                        <a href="?page=orders" class="editable-text editable-section no-drop-zone" data-section="9" data-text="8">My Orders</a>
                        <a href="?page=wishlist" class="editable-text editable-section no-drop-zone" data-section="10" data-text="9">Wishlist</a>
                        <div class="dropdown-divider"></div>
                        <a href="?page=logout" class="editable-text editable-section no-drop-zone" data-section="11" data-text="10">Sign Out</a>
                    </div>
