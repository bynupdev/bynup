                    <i class="fa-solid fa-bars editable-icon" data-icon="4" data-default-class="fa-solid fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- MOBILE MENU -->
        <div id="mobile-menu" class="mobile-menu">
            <div class="mobile-menu-header">
                <div class="logo-wrapper">
                    <div class="logo-icon">
                        <span>V</span>
                    </div>
                    <span class="logo-text">velora</span>
                </div>
                <!-- Back button -->
                <button onclick="toggleMobileMenu()" class="back-btn">
                    <i class="fa-solid fa-arrow-left editable-icon" data-icon="5" data-default-class="fa-solid fa-arrow-left"></i>
                </button>
            </div>
            
            <div class="mobile-menu-links">
                <a href="?page=home" class="nav-link editable-text editable-section no-drop-zone" data-section="12" data-text="11">HOME</a>
                <a href="?page=shop" class="nav-link editable-text editable-section no-drop-zone" data-section="13" data-text="12">SHOP</a>
