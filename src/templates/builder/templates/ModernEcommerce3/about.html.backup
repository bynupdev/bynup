<!-- builder/templates/ModernEcommerce14/about.html -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About | SARTOR</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300&family=Montserrat:wght@200;400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --olive-drab: #626616; 
            --brass-leaf: #e2a970; 
            --raw-silk: #fbca8a;   
            --obsidian: #0d0d0d;   
            --charcoal: #1a1a1a;   
            --white: #ffffff;
            --ease-cinematic: cubic-bezier(0.9, 0, 0.1, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--obsidian);
            color: var(--white);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            padding-top: 140px;
        }

        /* --- PAGE HEADER --- */
        .about-header.editable-section[data-section="195"] {
            padding: 6rem 5% 4rem;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .about-header h1.editable-text.editable-section.no-drop-zone[data-section="196"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 6vw, 5rem);
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 4px;
        }

        .about-header p.editable-text.editable-section.no-drop-zone[data-section="197"] {
            color: rgba(255,255,255,0.6);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.8;
            font-weight: 200;
        }

        /* --- HERO STORY SECTION --- */
        .story-hero.editable-section[data-section="198"] {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            padding: 6rem 5%;
            align-items: center;
        }

        .story-image {
            position: relative;
            overflow: hidden;
            aspect-ratio: 4/5;
        }

        .story-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 1.2s var(--ease-cinematic);
            filter: grayscale(40%);
        }

        .story-image:hover img {
            transform: scale(1.05);
            filter: grayscale(0%);
        }

        .story-content {
            padding: 2rem;
        }

        .story-tag.editable-text.editable-section.no-drop-zone[data-section="199"] {
            font-size: 0.7rem;
            letter-spacing: 5px;
            color: var(--olive-drab);
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            display: block;
        }

        .story-content h2.editable-text.editable-section.no-drop-zone[data-section="200"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .story-content p.editable-text.editable-section.no-drop-zone[data-section="201"] {
            color: rgba(255,255,255,0.7);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
            font-weight: 200;
        }

        .story-signature {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--brass-leaf);
            margin-top: 2rem;
            font-style: italic;
        }

        /* --- PHILOSOPHY SECTION --- */
        .philosophy-section.editable-section[data-section="202"] {
            padding: 6rem 5%;
            background: linear-gradient(to right, rgba(98, 98, 22, 0.1), transparent);
            border-top: 1px solid rgba(255,255,255,0.03);
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .philosophy-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .philosophy-header h2.editable-text.editable-section.no-drop-zone[data-section="203"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1rem;
        }

        .philosophy-header p.editable-text.editable-section.no-drop-zone[data-section="204"] {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .values-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 3rem;
            margin-top: 3rem;
        }

        .value-item.editable-section.no-drop-zone[data-section="205"] {
            text-align: center;
            padding: 2rem;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.03);
            transition: 0.3s;
        }

        .value-item:hover {
            transform: translateY(-10px);
            border-color: rgba(226, 169, 112, 0.3);
        }

        .value-icon {
            font-size: 2.5rem;
            color: var(--brass-leaf);
            margin-bottom: 1.5rem;
        }

        .value-item h3.editable-text.editable-section.no-drop-zone[data-section="206"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1rem;
        }

        .value-item p.editable-text.editable-section.no-drop-zone[data-section="207"] {
            color: rgba(255,255,255,0.6);
            font-size: 0.95rem;
            line-height: 1.7;
            font-weight: 200;
        }

        /* --- CRAFTSMANSHIP SECTION --- */
        .craftsmanship-section.editable-section[data-section="208"] {
            padding: 6rem 5%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .craftsmanship-content {
            padding: 2rem;
        }

        .craftsmanship-tag.editable-text.editable-section.no-drop-zone[data-section="209"] {
            font-size: 0.7rem;
            letter-spacing: 5px;
            color: var(--olive-drab);
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            display: block;
        }

        .craftsmanship-content h2.editable-text.editable-section.no-drop-zone[data-section="210"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.8rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .craftsmanship-content p.editable-text.editable-section.no-drop-zone[data-section="211"] {
            color: rgba(255,255,255,0.7);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
            font-weight: 200;
        }

        .craftsmanship-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 2rem;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number.editable-text.editable-section.no-drop-zone[data-section="212"] {
            font-size: 2.5rem;
            color: var(--brass-leaf);
            font-weight: 300;
            margin-bottom: 0.5rem;
        }

        .stat-label.editable-text.editable-section.no-drop-zone[data-section="213"] {
            color: rgba(255,255,255,0.5);
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .craftsmanship-image {
            position: relative;
            overflow: hidden;
            aspect-ratio: 4/5;
        }

        .craftsmanship-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 1.2s var(--ease-cinematic);
            filter: grayscale(40%);
        }

        .craftsmanship-image:hover img {
            transform: scale(1.05);
            filter: grayscale(0%);
        }

        /* --- TIMELINE SECTION --- */
        .timeline-section.editable-section[data-section="214"] {
            padding: 6rem 5%;
            background: linear-gradient(to top, rgba(98, 98, 22, 0.05), transparent);
            border-top: 1px solid rgba(255,255,255,0.03);
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .timeline-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .timeline-header h2.editable-text.editable-section.no-drop-zone[data-section="215"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1rem;
        }

        .timeline-header p.editable-text.editable-section.no-drop-zone[data-section="216"] {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .timeline {
            position: relative;
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem 0;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 1px;
            height: 100%;
            background: linear-gradient(to bottom, transparent, var(--brass-leaf), transparent);
        }

        .timeline-item.editable-section.no-drop-zone[data-section="217"] {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4rem;
            position: relative;
        }

        .timeline-item:nth-child(even) {
            flex-direction: row-reverse;
        }

        .timeline-year {
            width: 120px;
            text-align: center;
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            color: var(--brass-leaf);
            font-weight: 300;
        }

        .timeline-content {
            width: calc(50% - 80px);
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.03);
            padding: 2rem;
            transition: 0.3s;
        }

        .timeline-item:hover .timeline-content {
            border-color: rgba(226, 169, 112, 0.3);
            transform: translateY(-5px);
        }

        .timeline-content h3.editable-text.editable-section.no-drop-zone[data-section="218"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--raw-silk);
            margin-bottom: 0.8rem;
        }

        .timeline-content p.editable-text.editable-section.no-drop-zone[data-section="219"] {
            color: rgba(255,255,255,0.6);
            font-size: 0.95rem;
            line-height: 1.7;
            font-weight: 200;
        }

        .timeline-dot {
            width: 12px;
            height: 12px;
            background: var(--brass-leaf);
            border-radius: 50%;
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
        }

        /* --- TEAM SECTION --- */
        .team-section.editable-section[data-section="220"] {
            padding: 6rem 5%;
        }

        .team-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .team-header h2.editable-text.editable-section.no-drop-zone[data-section="221"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1rem;
        }

        .team-header p.editable-text.editable-section.no-drop-zone[data-section="222"] {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .team-member.editable-section.no-drop-zone[data-section="223"] {
            text-align: center;
        }

        .member-image {
            aspect-ratio: 1/1;
            overflow: hidden;
            background-color: var(--charcoal);
            margin-bottom: 1.5rem;
            border-radius: 50%;
        }

        .member-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s var(--ease-cinematic);
            filter: grayscale(50%);
        }

        .team-member:hover .member-image img {
            transform: scale(1.1);
            filter: grayscale(0%);
        }

        .member-name.editable-text.editable-section.no-drop-zone[data-section="224"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 300;
            color: var(--white);
            margin-bottom: 0.3rem;
        }

        .member-role.editable-text.editable-section.no-drop-zone[data-section="225"] {
            color: var(--brass-leaf);
            font-size: 0.8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .member-bio.editable-text.editable-section.no-drop-zone[data-section="226"] {
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            line-height: 1.6;
            font-weight: 200;
            max-width: 250px;
            margin: 0 auto;
        }

        /* --- STUDIO SECTION --- */
        .studio-section.editable-section[data-section="227"] {
            padding: 6rem 5%;
            background: linear-gradient(to right, rgba(98, 98, 22, 0.1), transparent);
            border-top: 1px solid rgba(255,255,255,0.03);
            border-bottom: 1px solid rgba(255,255,255,0.03);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
        }

        .studio-content {
            padding: 2rem;
        }

        .studio-tag.editable-text.editable-section.no-drop-zone[data-section="228"] {
            font-size: 0.7rem;
            letter-spacing: 5px;
            color: var(--olive-drab);
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            display: block;
        }

        .studio-content h2.editable-text.editable-section.no-drop-zone[data-section="229"] {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.8rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1.5rem;
            line-height: 1.2;
        }

        .studio-content p.editable-text.editable-section.no-drop-zone[data-section="230"] {
            color: rgba(255,255,255,0.7);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
            font-weight: 200;
        }

        .studio-gallery {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .gallery-image {
            aspect-ratio: 1/1;
            overflow: hidden;
        }

        .gallery-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s var(--ease-cinematic);
            filter: grayscale(60%);
        }

        .gallery-image:hover img {
            transform: scale(1.1);
            filter: grayscale(0%);
        }

        /* --- RESPONSIVE --- */
        @media (max-width: 1200px) {
            .team-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 992px) {
            .story-hero,
            .craftsmanship-section,
            .studio-section {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .values-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .timeline::before {
                left: 30px;
            }

            .timeline-item,
            .timeline-item:nth-child(even) {
                flex-direction: column;
                align-items: flex-start;
                padding-left: 60px;
            }

            .timeline-year {
                width: auto;
                margin-bottom: 1rem;
            }

            .timeline-content {
                width: 100%;
            }

            .timeline-dot {
                left: 30px;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 120px;
            }

            .values-grid {
                grid-template-columns: 1fr;
            }

            .team-grid {
                grid-template-columns: 1fr;
            }

            .craftsmanship-stats {
                grid-template-columns: 1fr;
            }

            .about-header h1 {
                font-size: 2.5rem;
            }

            .story-content h2,
            .craftsmanship-content h2,
            .studio-content h2 {
                font-size: 2.2rem;
            }
        }

        @media (max-width: 576px) {
            .story-content,
            .craftsmanship-content,
            .studio-content {
                padding: 1rem 0;
            }

            .studio-gallery {
                grid-template-columns: 1fr;
            }

            .team-member {
                max-width: 300px;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body>
    <!-- About Header -->
    <div class="about-header editable-section" data-section="195">
        <h1 class="editable-text editable-section no-drop-zone" data-section="196" data-text="149">The Maison</h1>
        <p class="editable-text editable-section no-drop-zone" data-section="197" data-text="150">Craftsmanship, heritage, and the pursuit of perfection since 1925</p>
    </div>

    <!-- Story Hero -->
    <div class="story-hero editable-section" data-section="198">
        <div class="story-image">
            <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&q=80&w=1200" alt="SARTOR Atelier" class="editable-image" data-image="21">
        </div>
        <div class="story-content">
            <span class="story-tag editable-text" data-section="199" data-text="151">Founded 1925</span>
            <h2 class="editable-text" data-section="200" data-text="152">The Art of<br>Sartorial Excellence</h2>
            <p class="editable-text" data-section="201" data-text="153">SARTOR was born from a singular vision: to create garments that transcend time. In the heart of Milan's historic district, our founder, Alessandro Moretti, established a small atelier with the belief that true luxury is felt, never flaunted. For nearly a century, we have remained faithful to this philosophy, crafting pieces that speak through their silence.</p>
            <p class="editable-text" data-section="202" data-text="154">Today, the house of SARTOR continues to serve discerning gentlemen across the globe, maintaining the same standards of excellence that defined our earliest creations. Each garment carries not just our name, but a legacy of uncompromising quality.</p>
            <div class="story-signature">— Alessandro Moretti, Founder</div>
        </div>
    </div>

    <!-- Philosophy Section -->
    <div class="philosophy-section editable-section" data-section="203">
        <div class="philosophy-header">
            <h2 class="editable-text" data-section="204" data-text="155">Our Philosophy</h2>
            <p class="editable-text" data-section="205" data-text="156">Principles that guide every stitch</p>
        </div>

        <div class="values-grid">
            <!-- Value 1 -->
            <div class="value-item editable-section no-drop-zone" data-section="206">
                <div class="value-icon"><i class="fa-regular fa-gem"></i></div>
                <h3 class="editable-text" data-section="207" data-text="157">Uncompromising Quality</h3>
                <p class="editable-text" data-section="208" data-text="158">Only the finest materials find their way into our atelier. From the wool of Italian mills to the mother-of-pearl from Pacific waters, every element is carefully selected for its exceptional character.</p>
            </div>

            <!-- Value 2 -->
            <div class="value-item editable-section no-drop-zone" data-section="209">
                <div class="value-icon"><i class="fa-regular fa-clock"></i></div>
                <h3 class="editable-text" data-section="210" data-text="159">Timeless Design</h3>
                <p class="editable-text" data-section="211" data-text="160">We do not chase trends. Our designs are conceived to remain relevant for decades, evolving gracefully with their wearer and acquiring character with each wearing.</p>
            </div>

            <!-- Value 3 -->
            <div class="value-item editable-section no-drop-zone" data-section="212">
                <div class="value-icon"><i class="fa-regular fa-hand-sparkles"></i></div>
                <h3 class="editable-text" data-section="213" data-text="161">Artisanal Mastery</h3>
                <p class="editable-text" data-section="214" data-text="162">Each piece passes through the hands of at least 12 master artisans, ensuring that traditional techniques are preserved and celebrated in every creation.</p>
            </div>
        </div>
    </div>

    <!-- Craftsmanship Section -->
    <div class="craftsmanship-section editable-section" data-section="215">
        <div class="craftsmanship-content">
            <span class="craftsmanship-tag editable-text" data-section="216" data-text="163">Heritage in Every Stitch</span>
            <h2 class="editable-text" data-section="217" data-text="164">The Art of<br>Hand Craftsmanship</h2>
            <p class="editable-text" data-section="218" data-text="165">In an age of mass production, we remain steadfast in our commitment to hand craftsmanship. Each SARTOR garment requires over 40 hours of meticulous handwork, from the initial cutting to the final pressing. Our master artisans, many of whom have been with us for over three decades, bring generations of knowledge to every piece they create.</p>
            <p class="editable-text" data-section="219" data-text="166">The canvas construction, the hand-stitched buttonholes, the precise pattern matching—these details may go unnoticed by the casual observer, but they define the experience of wearing SARTOR.</p>
            
            <div class="craftsmanship-stats">
                <div class="stat-item">
                    <div class="stat-number editable-text" data-section="220" data-text="167">40+</div>
                    <div class="stat-label editable-text" data-section="221" data-text="168">Hours per garment</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number editable-text" data-section="222" data-text="169">12</div>
                    <div class="stat-label editable-text" data-section="223" data-text="170">Master artisans</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number editable-text" data-section="224" data-text="171">98%</div>
                    <div class="stat-label editable-text" data-section="225" data-text="172">Client retention</div>
                </div>
            </div>
        </div>
        <div class="craftsmanship-image">
            <img src="https://images.unsplash.com/photo-1581965230225-2c3257b3bff5?auto=format&fit=crop&q=80&w=1200" alt="Craftsmanship" class="editable-image" data-image="22">
        </div>
    </div>

    <!-- Timeline Section -->
    <div class="timeline-section editable-section" data-section="226">
        <div class="timeline-header">
            <h2 class="editable-text" data-section="227" data-text="173">A Century of Excellence</h2>
            <p class="editable-text" data-section="228" data-text="174">The milestones that shaped our story</p>
        </div>

        <div class="timeline">
            <!-- Timeline Item 1 -->
            <div class="timeline-item editable-section no-drop-zone" data-section="229">
                <div class="timeline-year">1925</div>
                <div class="timeline-content">
                    <h3 class="editable-text" data-section="230" data-text="175">The Founding</h3>
                    <p class="editable-text" data-section="231" data-text="176">Alessandro Moretti opens the first SARTOR atelier on Via Montenapoleone in Milan, specializing in bespoke tailoring for the city's cultural elite.</p>
                </div>
                <div class="timeline-dot"></div>
            </div>

            <!-- Timeline Item 2 -->
            <div class="timeline-item editable-section no-drop-zone" data-section="232">
                <div class="timeline-year">1952</div>
