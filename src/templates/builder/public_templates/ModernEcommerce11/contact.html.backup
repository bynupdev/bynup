{% load style_filters %}
{% load color_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Lullaby Luxe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --primary-brown: #B0988B;
            --primary-teal: #4D8581;
            --light-teal: #ABDED7;
            --light-beige: #DBCBBE;
            --background-cream: #EEE7DF;
            --text-dark: #333333;
            --text-light: #555555;
            --white: #FFFFFF;
            --shadow: rgba(0, 0, 0, 0.05);
        }
        {% generate_color_variables %}

        /* Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--background-cream);
            color: var(--text-dark);
            line-height: 1.6;
            padding-top: 100px; /* For fixed header */
        }

        h1, h2, h3, h4 {
            font-weight: 300;
            letter-spacing: 0.5px;
        }

        p {
            color: var(--text-light);
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .btn {
            display: inline-block;
            background-color: var(--primary-teal);
            color: var(--white);
            border: none;
            padding: 14px 32px;
            font-size: 16px;
            font-weight: 400;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            border-radius: 2px;
            text-decoration: none;
        }

        .btn:hover {
            background-color: var(--primary-brown);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px var(--shadow);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--primary-teal);
            border: 1px solid var(--primary-teal);
        }

        .btn-secondary:hover {
            background-color: rgba(77, 133, 129, 0.1);
        }

        section {
            padding: 80px 0;
        }

        /* Contact Header */
        .contact-header {
            padding: 40px 0 20px;
            border-bottom: 1px solid var(--light-beige);
            margin-bottom: 40px;
        }

        .contact-header h1 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 10px;
            font-weight: 300;
        }

        /* Contact Section */
        .contact-section {
            padding: 40px 0;
        }

        .contact-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        /* Contact Info */
        .contact-info {
            background-color: var(--white);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 5px 20px var(--shadow);
        }

        .contact-info h2 {
            font-size: 28px;
            color: var(--primary-teal);
            margin-bottom: 30px;
            font-weight: 400;
        }

        .contact-methods {
            display: flex;
            flex-direction: column;
            gap: 30px;
            margin-bottom: 40px;
        }

        .contact-method {
            display: flex;
            align-items: flex-start;
            gap: 20px;
        }

        .contact-icon {
            width: 50px;
            height: 50px;
            background-color: var(--light-teal);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-teal);
            font-size: 20px;
            flex-shrink: 0;
        }

        .contact-details h3 {
            font-size: 18px;
            color: var(--primary-teal);
            margin-bottom: 5px;
            font-weight: 500;
        }

        .contact-details p {
            margin-bottom: 5px;
        }

        .business-hours {
            background-color: var(--background-cream);
            padding: 25px;
            border-radius: 8px;
            margin-top: 20px;
        }

        .business-hours h3 {
            font-size: 18px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 500;
        }

        .hours-list {
            list-style: none;
        }

        .hours-list li {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--light-beige);
        }

        .hours-list li:last-child {
            border-bottom: none;
        }

        /* Contact Form */
        .contact-form-container {
            background-color: var(--white);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 5px 20px var(--shadow);
        }

        .contact-form-container h2 {
            font-size: 28px;
            color: var(--primary-teal);
            margin-bottom: 30px;
            font-weight: 400;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 500;
            color: var(--text-dark);
        }

        .form-control {
            width: 100%;
            padding: 14px;
            border: 1px solid var(--light-beige);
            border-radius: 6px;
            font-size: 16px;
            transition: all 0.3s ease;
            background-color: var(--background-cream);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-teal);
            box-shadow: 0 0 0 3px rgba(77, 133, 129, 0.1);
            background-color: var(--white);
        }

        textarea.form-control {
            min-height: 150px;
            resize: vertical;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-check {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-check input {
            width: 18px;
            height: 18px;
        }

        .form-check label {
            margin-bottom: 0;
            font-size: 14px;
        }

        /* FAQ Section */
        .faq-section {
            padding: 60px 0;
            background-color: var(--light-teal);
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 36px;
            color: var(--primary-teal);
            margin-bottom: 15px;
            font-weight: 300;
        }

        .faq-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .faq-item {
            background-color: var(--white);
            border-radius: 8px;
            margin-bottom: 15px;
            overflow: hidden;
            box-shadow: 0 3px 10px var(--shadow);
        }

        .faq-question {
            padding: 25px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .faq-question:hover {
            background-color: rgba(77, 133, 129, 0.05);
        }

        .faq-question h3 {
            font-size: 18px;
            color: var(--primary-teal);
            font-weight: 500;
            margin: 0;
        }

        .faq-icon {
            color: var(--primary-teal);
            font-size: 20px;
            transition: transform 0.3s ease;
        }

        .faq-answer {
            padding: 0 30px;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s ease;
            background-color: rgba(255, 255, 255, 0.9);
        }

        .faq-answer p {
            padding: 20px 0;
            margin: 0;
            border-top: 1px solid var(--light-beige);
        }

        .faq-item.active .faq-answer {
            max-height: 500px;
        }

        .faq-item.active .faq-icon {
            transform: rotate(45deg);
        }

        /* Map Section */
        .map-section {
            padding: 60px 0;
            background-color: var(--white);
        }

        .map-container {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px var(--shadow);
            height: 400px;
            background-color: var(--light-beige);
        }

        /* Contact CTA */
        .contact-cta {
            padding: 60px 0;
            background-color: var(--light-teal);
            text-align: center;
        }

        .contact-cta h2 {
            font-size: 32px;
            color: var(--primary-teal);
            margin-bottom: 20px;
            font-weight: 300;
        }

        .contact-cta p {
            margin-bottom: 30px;
            font-size: 18px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .contact-container {
                gap: 40px;
            }
        }

        @media (max-width: 992px) {
            .contact-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .contact-header h1 {
                font-size: 32px;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
            
            .section-title h2 {
                font-size: 28px;
            }
        }

        @media (max-width: 768px) {
            .contact-info,
            .contact-form-container {
                padding: 30px;
            }
            
            .contact-method {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .faq-question {
                padding: 20px;
            }
            
            .faq-question h3 {
                font-size: 16px;
            }
            
            .faq-answer {
                padding: 0 20px;
            }
            
            section {
                padding: 60px 0;
            }
            
            .contact-cta h2 {
                font-size: 28px;
            }
        }

        @media (max-width: 576px) {
            .contact-header h1 {
                font-size: 28px;
            }
            
            .btn {
                padding: 12px 24px;
                font-size: 15px;
            }
            
            .contact-icon {
                width: 40px;
                height: 40px;
                font-size: 18px;
            }
            
            .map-container {
                height: 300px;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 231 312 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 231 312 %}
        /* Generate keyframes for animations */
        {% generate_hover_keyframes %}
    </style>
</head>
<body>
     {%include 'builder/public_templates/ModernEcommerce11/snippets/header1.html'%}
    <!-- Contact Header -->
    <section class="contact-header" id="section-231">
        <div class="container">
            <h1 id="section-232">{{ text_contents.168|default:"Contact Us" }}</h1>
            <p id="section-233">{{ text_contents.169|default:"We're here to help with any questions about our premium baby clothing" }}</p>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '231' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Contact Section -->
    <section class="contact-section" id="section-234">
        <div class="container">
            <div class="contact-container">
                <!-- Contact Info -->
                <div class="contact-info" id="section-235">
                    <h2 id="section-236">{{ text_contents.170|default:"Get in Touch" }}</h2>
                    
                    <div class="contact-methods">
                        <!-- Contact Method 1 -->
                        <div class="contact-method" id="section-237">
                            <div class="contact-icon">
                                <i class="fas fa-phone-alt" data-icon="50"></i>
                            </div>
                            <div class="contact-details">
                                <h3 id="section-238">{{ text_contents.171|default:"Phone" }}</h3>
                                <p id="section-239">{{ contact_info.phone|default:"+1 (555) 123-4567" }}</p>
                                <p id="section-240">{{ text_contents.173|default:"Mon-Fri 9am-6pm EST" }}</p>
                            </div>
                        </div>
                        
                        <!-- Contact Method 2 -->
                        <div class="contact-method" id="section-241">
                            <div class="contact-icon">
                                <i class="fas fa-envelope" data-icon="51"></i>
                            </div>
                            <div class="contact-details">
                                <h3 id="section-242">{{ text_contents.174|default:"Email" }}</h3>
                                <p id="section-243">{{ contact_info.email|default:"hello@lullabyluxe.com" }}</p>
                                <p id="section-244">{{ text_contents.176|default:"We respond within 24 hours" }}</p>
                            </div>
                        </div>
                        
                        <!-- Contact Method 3 -->
                        <div class="contact-method" id="section-245">
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt" data-icon="52"></i>
                            </div>
                            <div class="contact-details">
                                <h3 id="section-246">{{ text_contents.177|default:"Visit Our Studio" }}</h3>
                                <p id="section-247">{{ contact_info.address_line1|default:"123 Luxury Lane" }}</p>
                                <p id="section-248">{{ contact_info.address_line2|default:"New York, NY 10001" }}</p>
                                <p id="section-249">{{ text_contents.180|default:"By appointment only" }}</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Business Hours -->
                    <div class="business-hours" id="section-250">
                        <h3 id="section-251">{{ text_contents.181|default:"Business Hours" }}</h3>
                        <ul class="hours-list">
                            <li>
                                <span id="section-252">{{ text_contents.182|default:"Monday - Friday" }}</span>
                                <span id="section-253">{{ text_contents.183|default:"9:00 AM - 6:00 PM" }}</span>
                            </li>
                            <li>
                                <span id="section-254">{{ text_contents.184|default:"Saturday" }}</span>
                                <span id="section-255">{{ text_contents.185|default:"10:00 AM - 4:00 PM" }}</span>
                            </li>
                            <li>
                                <span id="section-256">{{ text_contents.186|default:"Sunday" }}</span>
                                <span id="section-257">{{ text_contents.187|default:"Closed" }}</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Contact Form -->
                <div class="contact-form-container" id="section-258">
                    <h2 id="section-259">{{ text_contents.188|default:"Send Us a Message" }}</h2>
                    
                    <form id="contact-form" method="POST" action="#" id="section-260">
                        <!-- Your existing CSRF token is already here - perfect! -->
                        {% csrf_token %}
                        
                        <!-- ONLY ADDITION: Hidden form identifier -->
                        <input type="hidden" name="form_name" value="about_contact">
                        
                        <div class="form-row">
                            <div class="form-group" id="section-261">
                                <label for="first-name" id="section-262">{{ text_contents.189|default:"First Name" }}</label>
                                <input type="text" id="first-name" name="first_name" class="form-control" placeholder="Enter your first name" required>
                            </div>
                            <div class="form-group" id="section-263">
                                <label for="last-name" id="section-264">{{ text_contents.190|default:"Last Name" }}</label>
                                <input type="text" id="last-name" name="last_name" class="form-control" placeholder="Enter your last name" required>
                            </div>
                        </div>
                        
                        <div class="form-group" id="section-265">
                            <label for="email" id="section-266">{{ text_contents.191|default:"Email Address" }}</label>
                            <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email address" required>
                        </div>
                        
                        <div class="form-group" id="section-267">
                            <label for="phone" id="section-268">{{ text_contents.192|default:"Phone Number (Optional)" }}</label>
                            <input type="tel" id="phone" name="phone" class="form-control" placeholder="Enter your phone number">
                        </div>
                        
                        <div class="form-group" id="section-269">
                            <label for="subject" id="section-270">{{ text_contents.193|default:"Subject" }}</label>
                            <select id="subject" name="subject" class="form-control" required>
                                <option value="" disabled selected id="section-271">{{ text_contents.194|default:"Select a subject" }}</option>
                                <option value="order" id="section-272">{{ text_contents.195|default:"Order Inquiry" }}</option>
                                <option value="shipping" id="section-273">{{ text_contents.196|default:"Shipping & Delivery" }}</option>
                                <option value="returns" id="section-274">{{ text_contents.197|default:"Returns & Exchanges" }}</option>
                                <option value="product" id="section-275">{{ text_contents.198|default:"Product Questions" }}</option>
                                <option value="other" id="section-276">{{ text_contents.199|default:"Other Inquiry" }}</option>
                            </select>
                        </div>
                        
                        <div class="form-group" id="section-277">
                            <label for="message" id="section-278">{{ text_contents.200|default:"Your Message" }}</label>
                            <textarea id="message" name="message" class="form-control" placeholder="How can we help you today?" required></textarea>
                        </div>
                        
                        <div class="form-group" id="section-279">
                            <div class="form-check">
                                <input type="checkbox" id="newsletter" name="newsletter">
                                <label for="newsletter" id="section-280">{{ text_contents.201|default:"Subscribe to our newsletter for updates and special offers" }}</label>
                            </div>
                        </div>
                        
                        <button type="submit" class="btn" id="section-281">{{ text_contents.202|default:"Send Message" }}</button>
                    </form>

                </div>
            </div>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '234' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- FAQ Section -->
    <section class="faq-section" id="section-282">
        <div class="container">
            <div class="section-title">
                <h2 id="section-283">{{ text_contents.203|default:"Frequently Asked Questions" }}</h2>
                <p id="section-284">{{ text_contents.204|default:"Find quick answers to common questions about our products and services" }}</p>
            </div>
            
            <div class="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item" id="section-285">
                    <div class="faq-question" onclick="toggleFAQ(1)">
                        <h3 id="section-286">{{ text_contents.205|default:"What materials are used in your baby clothing?" }}</h3>
                        <div class="faq-icon" data-icon="53">+</div>
                    </div>
                    <div class="faq-answer">
                        <p id="section-287">{{ text_contents.206|default:"We use only the finest materials including GOTS-certified organic cotton, premium cashmere blends, and breathable linen. All fabrics are carefully selected for their softness, durability, and suitability for delicate baby skin." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 2 -->
                <div class="faq-item" id="section-288">
                    <div class="faq-question" onclick="toggleFAQ(2)">
                        <h3 id="section-289">{{ text_contents.207|default:"What is your return and exchange policy?" }}</h3>
                        <div class="faq-icon" data-icon="53">+</div>
                    </div>
                    <div class="faq-answer">
                        <p id="section-290">{{ text_contents.208|default:"We offer a 30-day return policy for unworn items with tags attached. Exchanges are free within the U.S. for a different size or color. International returns are subject to shipping fees. All returns are processed within 3-5 business days of receipt." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 3 -->
                <div class="faq-item" id="section-291">
                    <div class="faq-question" onclick="toggleFAQ(3)">
                        <h3 id="section-292">{{ text_contents.209|default:"How do I care for the baby clothing?" }}</h3>
                        <div class="faq-icon" data-icon="53">+</div>
                    </div>
                    <div class="faq-answer">
                        <p id="section-293">{{ text_contents.210|default:"Most items are machine washable in cold water with mild detergent. We recommend tumble drying on low heat or line drying to preserve fabric quality. Specific care instructions are included with each garment and available on the product page." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 4 -->
                <div class="faq-item" id="section-294">
                    <div class="faq-question" onclick="toggleFAQ(4)">
                        <h3 id="section-295">{{ text_contents.211|default:"Do you offer international shipping?" }}</h3>
                        <div class="faq-icon" data-icon="53">+</div>
                    </div>
                    <div class="faq-answer">
                        <p id="section-296">{{ text_contents.212|default:"Yes, we ship to over 50 countries worldwide. Shipping costs and delivery times vary by destination. Customs duties and taxes may apply and are the responsibility of the customer. Please allow 7-14 business days for international delivery." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 5 -->
                <div class="faq-item" id="section-297">
                    <div class="faq-question" onclick="toggleFAQ(5)">
                        <h3 id="section-298">{{ text_contents.213|default:"Are your products suitable for sensitive skin?" }}</h3>
                        <div class="faq-icon" data-icon="53">+</div>
                    </div>
                    <div class="faq-answer">
                        <p id="section-299">{{ text_contents.214|default:"Absolutely! Our organic collection is specifically designed for sensitive skin. All fabrics are OEKO-TEX certified, meaning they're free from harmful substances. We use hypoallergenic dyes and avoid harsh chemicals in our production process." }}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '282' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Map Section -->
    <section class="map-section" id="section-300">
        <div class="container">
            <div class="section-title">
                <h2 id="section-301">{{ text_contents.215|default:"Visit Our Studio" }}</h2>
                <p id="section-302">{{ text_contents.216|default:"Schedule an appointment to see our collections in person" }}</p>
            </div>
            
            <div class="map-container" id="section-303">
                <!-- Dynamic Map - Can be replaced with actual Google Maps embed -->
                <div style="width: 100%; height: 100%; background-color: var(--light-beige); display: flex; align-items: center; justify-content: center; color: var(--primary-teal);">
                    <div style="text-align: center; padding: 40px;">
                        <i class="fas fa-map-marker-alt" style="font-size: 60px; margin-bottom: 20px;" data-icon="52"></i>
                        <h3 style="margin-bottom: 10px;" id="section-304">{{ text_contents.217|default:"Lullaby Luxe Studio" }}</h3>
                        <p id="section-305">{{ contact_info.address_line1|default:"123 Luxury Lane" }}, {{ contact_info.address_line2|default:"New York, NY 10001" }}</p>
                        <p id="section-306">{{ text_contents.219|default:"By appointment only" }}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '300' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Contact CTA -->
    <section class="contact-cta" id="section-307">
        <div class="container">
            <h2 id="section-308">{{ text_contents.220|default:"Still Have Questions?" }}</h2>
            <p id="section-309">{{ text_contents.221|default:"Our customer service team is here to help you find the perfect items for your little one." }}</p>
            <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
                <a href="#contact-form" class="btn" id="section-310">{{ text_contents.222|default:"Send Us a Message" }}</a>
                <a href="tel:{{ contact_info.phone|default:'+15551234567' }}" class="btn btn-secondary" id="section-311">{{ text_contents.223|default:"Call Now" }}</a>
            </div>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '307' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

     {%include 'builder/public_templates/ModernEcommerce11/snippets/footer.html'%}


    <!-- ONLY ADDITION: JavaScript for AJAX submission -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const contactForm = document.getElementById('contact-form');
    const submitBtn = document.getElementById('section-281');
    const originalButtonText = submitBtn.innerHTML;
    
    // Get the store subdomain from the page context
    const pageSubdomain = '{{ page.subdomain }}';
    
    contactForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Show loading state (preserving your button styling)
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
        submitBtn.disabled = true;
        
        // Collect form data
        const formData = new FormData(contactForm);
        
        try {
            const response = await fetch(`/builder/submit-form/${pageSubdomain}/`, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Show success message
                alert('Thank you! Your message has been sent successfully.');
                contactForm.reset();
            } else {
                alert('Error: ' + (result.error || 'Something went wrong. Please try again.'));
            }
        } catch (error) {
            alert('Network error. Please check your connection and try again.');
        } finally {
            // Restore button to original state with your editable text
            submitBtn.innerHTML = originalButtonText;
            submitBtn.disabled = false;
        }
    });
});
</script>

<!-- ONLY ADDITION: Font Awesome for spinner icon (if not already loaded) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script>
        // FAQ Toggle Functionality
        function toggleFAQ(faqNumber) {
            const faqItem = document.querySelector(`.faq-item:nth-child(${faqNumber})`);
            const isActive = faqItem.classList.contains('active');
            
            // Close all FAQs
            document.querySelectorAll('.faq-item').forEach(item => {
                item.classList.remove('active');
                const icon = item.querySelector('.faq-icon');
                if (icon) icon.textContent = '+';
            });
            
            // Open clicked FAQ if it wasn't already active
            if (!isActive) {
                faqItem.classList.add('active');
                const icon = faqItem.querySelector('.faq-icon');
                if (icon) icon.textContent = '−';
            }
        }

        
        // Auto-open first FAQ on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Open first FAQ by default
            const firstFAQ = document.querySelector('.faq-item');
            if (firstFAQ) {
                firstFAQ.classList.add('active');
                const icon = firstFAQ.querySelector('.faq-icon');
                if (icon) icon.textContent = '−';
            }
            
            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;
                    
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 120,
                            behavior: 'smooth'
                        });
                    }
                });
            });
        });

        // Phone number formatting
        document.getElementById('phone').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 3 && value.length <= 6) {
                value = value.replace(/(\d{3})(\d{0,3})/, '($1) $2');
            } else if (value.length > 6) {
                value = value.replace(/(\d{3})(\d{3})(\d{0,4})/, '($1) $2-$3');
            }
            e.target.value = value;
        });
    </script>
</body>
</html>