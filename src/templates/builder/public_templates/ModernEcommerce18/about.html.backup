{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>About Us | {{ page.brand_name }}</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
{% render_icon_data icon_customizations %}

<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

{% generate_color_variables %}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
    padding-top: 100px;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Page Header */
.page-header {
    text-align: center;
    padding: var(--spacing-lg) 0 var(--spacing-md);
    margin-bottom: var(--spacing-md);
}

.page-header h1 {
    font-size: 3rem;
    color: var(--espresso-dark);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
}

.page-header h1::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
}

.page-header p {
    color: var(--sienna-deep);
    font-size: 1rem;
    max-width: 700px;
    margin: 1rem auto 0;
    opacity: 0.8;
}

/* Hero Section */
.hero-about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    align-items: center;
}

.hero-image {
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 15px 40px var(--shadow-soft);
    height: 500px;
    width: 100%;
    object-fit: cover;
    background-color: var(--cream-warm);
}

.hero-content {
    padding: var(--spacing-md);
}

.hero-content h2 {
    font-size: 2rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
}

.hero-content p {
    color: var(--sienna-deep);
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
}

.highlight-text {
    font-size: 1.1rem;
    font-style: italic;
    color: var(--terracotta);
    border-left: 3px solid var(--terracotta);
    padding-left: var(--spacing-sm);
    margin: var(--spacing-md) 0;
}

/* Mission & Values */
.mission-values {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-lg);
    box-shadow: 0 10px 30px var(--shadow-soft);
    margin-bottom: var(--spacing-xl);
}

.mission-values h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.value-item {
    text-align: center;
    padding: var(--spacing-md);
}

.value-icon {
    font-size: 2.5rem;
    color: var(--terracotta);
    margin-bottom: var(--spacing-sm);
}

.value-title {
    font-size: 1.3rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
}

.value-description {
    color: var(--sienna-deep);
    font-size: 0.9rem;
    line-height: 1.6;
}

.mission-statement {
    text-align: center;
    padding: var(--spacing-lg);
    background: rgba(209, 134, 80, 0.05);
    border-radius: var(--border-radius);
    margin-top: var(--spacing-lg);
}

.mission-statement h3 {
    font-size: 1.5rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
}

.mission-statement p {
    color: var(--sienna-deep);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
    font-style: italic;
}

/* Craftsmanship Section */
.craftsmanship {
    margin-bottom: var(--spacing-xl);
}

.craftsmanship h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.craftsmanship-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    align-items: center;
}

.craftsmanship-image {
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 10px 30px var(--shadow-soft);
    height: 400px;
    width: 100%;
    object-fit: cover;
    background-color: var(--cream-warm);
}

.craftsmanship-text {
    padding: var(--spacing-md);
}

.craftsmanship-text h3 {
    font-size: 1.5rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
}

.craftsmanship-text p {
    color: var(--sienna-deep);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
}

.craftsmanship-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-sm);
    margin-top: var(--spacing-md);
}

.stat-item {
    text-align: center;
    padding: var(--spacing-sm);
    background: rgba(209, 134, 80, 0.05);
    border-radius: var(--border-radius);
}

.stat-number {
    font-size: 1.8rem;
    color: var(--terracotta);
    font-weight: 600;
    margin-bottom: 0.3rem;
}

.stat-label {
    color: var(--sienna-deep);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Our Story Timeline */
.story-timeline {
    margin-bottom: var(--spacing-xl);
}

.story-timeline h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
}

.timeline::before {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 100%;
    background: var(--terracotta);
    opacity: 0.3;
}

.timeline-item {
    margin-bottom: var(--spacing-lg);
    position: relative;
    width: 45%;
}

.timeline-item:nth-child(odd) {
    margin-left: 0;
    margin-right: auto;
}

.timeline-item:nth-child(even) {
    margin-left: auto;
    margin-right: 0;
}

.timeline-content {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    box-shadow: 0 5px 20px var(--shadow-soft);
    position: relative;
}

.timeline-year {
    font-size: 1.2rem;
    color: var(--terracotta);
    font-weight: 600;
    margin-bottom: 0.5rem;
}

.timeline-title {
    font-size: 1.1rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
}

.timeline-description {
    color: var(--sienna-deep);
    font-size: 0.85rem;
    line-height: 1.6;
}

.timeline-item::before {
    content: '';
    position: absolute;
    width: 12px;
    height: 12px;
    background: var(--terracotta);
    border-radius: 50%;
    top: 20px;
}

.timeline-item:nth-child(odd)::before {
    right: -38px;
}

.timeline-item:nth-child(even)::before {
    left: -38px;
}

/* Team Section */
.team-section {
    margin-bottom: var(--spacing-xl);
}

.team-section h2 {
    font-size: 2rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.team-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
}

.team-member {
    text-align: center;
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    box-shadow: 0 5px 20px var(--shadow-soft);
    transition: var(--transition);
}

.team-member:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px var(--shadow-hover);
}

.team-member-image {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    margin: 0 auto var(--spacing-sm);
    object-fit: cover;
    border: 3px solid var(--cream-warm);
    box-shadow: 0 5px 15px var(--shadow-soft);
    display: block;
    background-color: var(--cream-warm);
}

.team-member-name {
    font-size: 1.1rem;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
    font-weight: 600;
}

.team-member-role {
    color: var(--terracotta);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-sm);
}

.team-member-bio {
    color: var(--sienna-deep);
    font-size: 0.8rem;
    line-height: 1.5;
}

/* Commitment Section */
.commitment {
    background: linear-gradient(135deg, var(--espresso-dark), var(--sienna-deep));
    color: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-xl);
    text-align: center;
    margin-bottom: var(--spacing-xl);
}

.commitment h2 {
    font-size: 2rem;
    margin-bottom: var(--spacing-md);
    color: var(--white-pure);
}

.commitment p {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto var(--spacing-lg);
    opacity: 0.9;
}

.commitment-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
}

.commitment-stat {
    text-align: center;
}

.commitment-number {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--cream-warm);
}

.commitment-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.9;
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .team-grid {
        grid-template-columns: repeat(3, 1fr);
    }
    .values-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 992px) {
    .hero-about,
    .craftsmanship-content {
        grid-template-columns: 1fr;
    }
    .hero-image,
    .craftsmanship-image {
        height: 350px;
        order: -1;
    }
    .team-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .timeline::before {
        left: 30px;
    }
    .timeline-item {
        width: calc(100% - 60px);
        margin-left: 60px !important;
        margin-right: 0 !important;
    }
    .timeline-item:nth-child(odd)::before,
    .timeline-item:nth-child(even)::before {
        left: -38px;
    }
    .commitment-stats {
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-lg);
    }
}

@media (max-width: 768px) {
    body {
        padding-top: 80px;
    }
    .team-grid {
        grid-template-columns: 1fr;
        max-width: 300px;
        margin: 0 auto;
    }
    .values-grid {
        grid-template-columns: 1fr;
    }
    .craftsmanship-stats {
        grid-template-columns: 1fr;
    }
    .commitment-stats {
        grid-template-columns: 1fr;
    }
    .page-header h1 {
        font-size: 2rem;
    }
    .hero-content h2 {
        font-size: 1.5rem;
    }
    .mission-values {
        padding: var(--spacing-md);
    }
    .commitment {
        padding: var(--spacing-lg) var(--spacing-md);
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 1.2rem;
    }
    .hero-image,
    .craftsmanship-image {
        height: 250px;
    }
    .team-member-image {
        width: 100px;
        height: 100px;
    }
}

/* Dynamic Section Styles */
{% generate_section_styles style_customizations 450 542 %}

/* Dynamic Background Images */
{% generate_background_images background_images 450 542 %}

{% generate_hover_keyframes %}
</style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce18/snippets/header1.html' %}



<!-- Page Header -->
<div class="page-header" id="section-450">
    <div class="container">
        <h1 id="section-451">{{ text_contents.800|default:"Our Story" }}</h1>
        <p id="section-452">{{ text_contents.801|default:"Crafting premium pet essentials with love, care, and unwavering commitment to quality since 2015." }}</p>
    </div>
</div>

{% for component in components %}
{% if component.drop_zone == '450' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Hero Section -->
<div class="container">
    <div class="hero-about" id="section-453">
        <img class="hero-image" src="{% if image_customizations.700 %}{{ image_customizations.700.image_url }}{% else %}{{ about_hero_image|default:'https://images.pexels.com/photos/6231634/pexels-photo-6231634.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&fit=crop' }}{% endif %}" alt="{{ image_customizations.700.alt_text|default:'Founder with pet' }}">
        <div class="hero-content" id="section-454">
            <h2 id="section-455">{{ text_contents.802|default:"A Passion Born from Love" }}</h2>
            <p id="section-456">{{ text_contents.803|default:"PŌTA was founded in 2015 by Emma Bennett, a devoted pet parent who believed that our companions deserve the very best. After struggling to find products that combined luxury aesthetics with genuine comfort and durability, Emma decided to create her own collection." }}</p>
            <p id="section-457">{{ text_contents.804|default:"What began as a small atelier in Brooklyn has grown into a beloved brand trusted by pet parents worldwide. Today, we continue to honor Emma's original vision: to create beautiful, functional products that enhance the lives of pets and their families." }}</p>
            <p class="highlight-text" id="section-458">{{ text_contents.805|default:"\"Every product we create is a reflection of the love we have for our own companions. Quality, comfort, and style should never be compromised.\" - Emma Bennett, Founder" }}</p>
        </div>
    </div>
</div>

<!-- Mission & Values -->
<div class="container">
    <div class="mission-values" id="section-459">
        <h2 id="section-460">{{ text_contents.806|default:"Our Philosophy" }}</h2>
        <div class="values-grid">
            <div class="value-item" id="section-461">
                <div class="value-icon">
                    <i class="fas fa-gem" data-icon="700"></i>
                </div>
                <h3 class="value-title" id="section-462">{{ text_contents.807|default:"Uncompromising Quality" }}</h3>
                <p class="value-description" id="section-463">{{ text_contents.808|default:"We source only the finest materials and subject every product to rigorous quality testing. Your pet deserves nothing less than excellence." }}</p>
            </div>
            <div class="value-item" id="section-464">
                <div class="value-icon">
                    <i class="fas fa-hand-sparkles" data-icon="701"></i>
                </div>
                <h3 class="value-title" id="section-465">{{ text_contents.809|default:"Artisan Craftsmanship" }}</h3>
                <p class="value-description" id="section-466">{{ text_contents.810|default:"Each piece is thoughtfully designed and meticulously crafted by skilled artisans who share our passion for excellence." }}</p>
            </div>
            <div class="value-item" id="section-467">
                <div class="value-icon">
                    <i class="fas fa-heart" data-icon="702"></i>
                </div>
                <h3 class="value-title" id="section-468">{{ text_contents.811|default:"Conscious Compassion" }}</h3>
                <p class="value-description" id="section-469">{{ text_contents.812|default:"We are committed to ethical sourcing, sustainable practices, and giving back to animal welfare organizations." }}</p>
            </div>
        </div>
        <div class="mission-statement" id="section-470">
            <h3 id="section-471">{{ text_contents.813|default:"Our Mission" }}</h3>
            <p id="section-472">{{ text_contents.814|default:"To create heirloom-quality pet essentials that celebrate the bond between humans and their animal companions, combining timeless design with exceptional craftsmanship while maintaining ethical and sustainable practices throughout our supply chain." }}</p>
        </div>
    </div>
</div>

<!-- Craftsmanship Section -->
<div class="container">
    <div class="craftsmanship" id="section-473">
        <h2 id="section-474">{{ text_contents.815|default:"The Art of Craftsmanship" }}</h2>
        <div class="craftsmanship-content">
            <div class="craftsmanship-text" id="section-475">
                <h3 id="section-476">{{ text_contents.816|default:"Meticulous Attention to Detail" }}</h3>
                <p id="section-477">{{ text_contents.817|default:"Every PŌTA product begins as a sketch, meticulously refined to ensure both beauty and functionality. Our designers work closely with veterinarians and pet behaviorists to understand what truly matters for your companion's comfort and well-being." }}</p>
                <p id="section-478">{{ text_contents.818|default:"From selecting premium, non-toxic materials to testing durability against the most enthusiastic play, we leave no detail overlooked. Each product undergoes multiple quality checks before it reaches your doorstep." }}</p>
                <div class="craftsmanship-stats">
                    <div class="stat-item" id="section-479">
                        <div class="stat-number" id="section-480">{{ text_contents.819|default:"25+" }}</div>
                        <div class="stat-label" id="section-481">{{ text_contents.820|default:"Quality Checks" }}</div>
                    </div>
                    <div class="stat-item" id="section-482">
                        <div class="stat-number" id="section-483">{{ text_contents.821|default:"100%" }}</div>
                        <div class="stat-label" id="section-484">{{ text_contents.822|default:"Non-Toxic Materials" }}</div>
                    </div>
                    <div class="stat-item" id="section-485">
                        <div class="stat-number" id="section-486">{{ text_contents.823|default:"3+ Years" }}</div>
                        <div class="stat-label" id="section-487">{{ text_contents.824|default:"Durability Tested" }}</div>
                    </div>
                </div>
            </div>
            <img class="craftsmanship-image" src="{% if image_customizations.701 %}{{ image_customizations.701.image_url }}{% else %}{{ craftsmanship_image|default:'https://images.pexels.com/photos/5794842/pexels-photo-5794842.jpeg?auto=compress&cs=tinysrgb&w=800&h=600&fit=crop' }}{% endif %}" alt="{{ image_customizations.701.alt_text|default:'Craftsmanship process' }}">
        </div>
    </div>
</div>

<!-- Our Story Timeline -->
<div class="container">
    <div class="story-timeline" id="section-488">
        <h2 id="section-489">{{ text_contents.825|default:"Our Journey Through Time" }}</h2>
        <div class="timeline">
            <div class="timeline-item" id="section-490">
                <div class="timeline-content">
                    <div class="timeline-year" id="section-491">{{ text_contents.826|default:"2015" }}</div>
                    <h3 class="timeline-title" id="section-492">{{ text_contents.827|default:"A Dream Takes Shape" }}</h3>
                    <p class="timeline-description" id="section-493">{{ text_contents.828|default:"Emma Bennett founded PŌTA in her Brooklyn apartment, creating the first collection of luxury pet beds by hand. The brand quickly gains a devoted following among local pet parents." }}</p>
                </div>
            </div>
            <div class="timeline-item" id="section-494">
                <div class="timeline-content">
                    <div class="timeline-year" id="section-495">{{ text_contents.829|default:"2018" }}</div>
                    <h3 class="timeline-title" id="section-496">{{ text_contents.830|default:"Expanding the Vision" }}</h3>
                    <p class="timeline-description" id="section-497">{{ text_contents.831|default:"PŌTA launches its full product line, including grooming essentials, dining accessories, and travel gear. The first flagship boutique opens in SoHo, New York." }}</p>
                </div>
            </div>
            <div class="timeline-item" id="section-498">
                <div class="timeline-content">
                    <div class="timeline-year" id="section-499">{{ text_contents.832|default:"2020" }}</div>
                    <h3 class="timeline-title" id="section-500">{{ text_contents.833|default:"A Commitment to Sustainability" }}</h3>
                    <p class="timeline-description" id="section-501">{{ text_contents.834|default:"PŌTA transitions to 100% sustainable packaging and partners with ethical suppliers committed to environmental responsibility. The brand also launches its first charitable initiative, donating 5% of profits to animal rescue organizations." }}</p>
                </div>
            </div>
            <div class="timeline-item" id="section-502">
                <div class="timeline-content">
                    <div class="timeline-year" id="section-503">{{ text_contents.835|default:"2023" }}</div>
                    <h3 class="timeline-title" id="section-504">{{ text_contents.836|default:"Global Recognition" }}</h3>
                    <p class="timeline-description" id="section-505">{{ text_contents.837|default:"PŌTA expands internationally, serving pet parents in over 30 countries. The brand is recognized for its innovative designs and commitment to animal welfare, receiving multiple industry awards." }}</p>
                </div>
            </div>
            <div class="timeline-item" id="section-506">
                <div class="timeline-content">
                    <div class="timeline-year" id="section-507">{{ text_contents.838|default:"Present Day" }}</div>
                    <h3 class="timeline-title" id="section-508">{{ text_contents.839|default:"Continuing the Legacy" }}</h3>
                    <p class="timeline-description" id="section-509">{{ text_contents.840|default:"Today, PŌTA continues to innovate, creating thoughtfully designed products that enhance the lives of pets and their families. Our mission remains the same: to celebrate the bond we share with our animal companions through quality, style, and care." }}</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Team Section -->
<div class="container">
    <div class="team-section" id="section-510">
        <h2 id="section-511">{{ text_contents.841|default:"Meet Our Team" }}</h2>
        <div class="team-grid">
            <div class="team-member" id="section-512">
                <img class="team-member-image" src="{% if image_customizations.702 %}{{ image_customizations.702.image_url }}{% else %}{{ team_member1_image|default:'https://images.pexels.com/photos/1181690/pexels-photo-1181690.jpeg?auto=compress&cs=tinysrgb&w=200&h=200&fit=crop' }}{% endif %}" alt="{{ image_customizations.702.alt_text|default:'Emma Bennett' }}">
                <h3 class="team-member-name" id="section-513">{{ text_contents.842|default:"Emma Bennett" }}</h3>
                <div class="team-member-role" id="section-514">{{ text_contents.843|default:"Founder & Creative Director" }}</div>
                <p class="team-member-bio" id="section-515">{{ text_contents.844|default:"Emma's passion for design and love for her rescue dog, Oliver, inspired the creation of PŌTA. With a background in textile design, she leads our creative vision with warmth and purpose." }}</p>
            </div>
            <div class="team-member" id="section-516">
                <img class="team-member-image" src="{% if image_customizations.703 %}{{ image_customizations.703.image_url }}{% else %}{{ team_member2_image|default:'https://images.pexels.com/photos/2379005/pexels-photo-2379005.jpeg?auto=compress&cs=tinysrgb&w=200&h=200&fit=crop' }}{% endif %}" alt="{{ image_customizations.703.alt_text|default:'Marcus Chen' }}">
                <h3 class="team-member-name" id="section-517">{{ text_contents.845|default:"Marcus Chen" }}</h3>
                <div class="team-member-role" id="section-518">{{ text_contents.846|default:"Head of Product Development" }}</div>
                <p class="team-member-bio" id="section-519">{{ text_contents.847|default:"Marcus brings over 15 years of experience in product design and manufacturing. His attention to detail ensures every PŌTA product meets the highest standards of quality and safety." }}</p>
            </div>
            <div class="team-member" id="section-520">
                <img class="team-member-image" src="{% if image_customizations.704 %}{{ image_customizations.704.image_url }}{% else %}{{ team_member3_image|default:'https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=200&h=200&fit=crop' }}{% endif %}" alt="{{ image_customizations.704.alt_text|default:'Dr. Sarah Williams' }}">
                <h3 class="team-member-name" id="section-521">{{ text_contents.848|default:"Dr. Sarah Williams" }}</h3>
                <div class="team-member-role" id="section-522">{{ text_contents.849|default:"Veterinary Consultant" }}</div>
                <p class="team-member-bio" id="section-523">{{ text_contents.850|default:"As a practicing veterinarian, Dr. Williams ensures our products support pet health and well-being. Her expertise guides our design choices, from ergonomic beds to safe materials." }}</p>
            </div>
            <div class="team-member" id="section-524">
                <img class="team-member-image" src="{% if image_customizations.705 %}{{ image_customizations.705.image_url }}{% else %}{{ team_member4_image|default:'https://images.pexels.com/photos/774909/pexels-photo-774909.jpeg?auto=compress&cs=tinysrgb&w=200&h=200&fit=crop' }}{% endif %}" alt="{{ image_customizations.705.alt_text|default:'Isabella Rossi' }}">
                <h3 class="team-member-name" id="section-525">{{ text_contents.851|default:"Isabella Rossi" }}</h3>
                <div class="team-member-role" id="section-526">{{ text_contents.852|default:"Customer Experience Director" }}</div>
                <p class="team-member-bio" id="section-527">{{ text_contents.853|default:"Isabella leads our dedicated customer service team, ensuring every pet parent feels supported and valued. Her genuine care and responsiveness have earned PŌTA a reputation for exceptional service." }}</p>
            </div>
        </div>
    </div>
</div>

<!-- Commitment Section -->
<div class="container">
    <div class="commitment" id="section-528">
        <h2 id="section-529">{{ text_contents.854|default:"Our Commitment to Excellence" }}</h2>
        <p id="section-530">{{ text_contents.855|default:"We believe that the products we create for our pets should be as thoughtfully designed as those we choose for ourselves. Every PŌTA piece is crafted with intention, combining luxury aesthetics with uncompromising functionality." }}</p>
        <div class="commitment-stats">
            <div class="commitment-stat" id="section-531">
                <div class="commitment-number" id="section-532">{{ text_contents.856|default:"50K+" }}</div>
                <div class="commitment-label" id="section-533">{{ text_contents.857|default:"Happy Pets" }}</div>
            </div>
            <div class="commitment-stat" id="section-534">
                <div class="commitment-number" id="section-535">{{ text_contents.858|default:"$100K+" }}</div>
                <div class="commitment-label" id="section-536">{{ text_contents.859|default:"Donated to Animal Welfare" }}</div>
            </div>
            <div class="commitment-stat" id="section-537">
                <div class="commitment-number" id="section-538">{{ text_contents.860|default:"100%" }}</div>
                <div class="commitment-label" id="section-539">{{ text_contents.861|default:"Ethically Sourced Materials" }}</div>
            </div>
            <div class="commitment-stat" id="section-540">
                <div class="commitment-number" id="section-541">{{ text_contents.862|default:"30+" }}</div>
                <div class="commitment-label" id="section-542">{{ text_contents.863|default:"Countries Served" }}</div>
            </div>
        </div>
    </div>
</div>

{% for component in components %}
{% if component.drop_zone == '528' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce18/snippets/footer.html' %}

{% for component in components %}
{% if component.drop_zone == 'end' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
// Timeline animation
document.addEventListener('DOMContentLoaded', function() {
    const timelineItems = document.querySelectorAll('.timeline-item');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.2 });
    
    timelineItems.forEach(item => {
        item.style.opacity = '0';
        item.style.transform = 'translateY(20px)';
        item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        observer.observe(item);
    });
    
    // Team member hover effects
    const teamMembers = document.querySelectorAll('.team-member');
    teamMembers.forEach(member => {
        member.addEventListener('mouseenter', function() {
            const image = this.querySelector('.team-member-image');
            if (image) {
                image.style.transform = 'scale(1.05)';
                image.style.transition = 'transform 0.3s ease';
            }
        });
        member.addEventListener('mouseleave', function() {
            const image = this.querySelector('.team-member-image');
            if (image) {
                image.style.transform = 'scale(1)';
            }
        });
    });
    
    // Value items animation
    const valueItems = document.querySelectorAll('.value-item');
    valueItems.forEach((item, index) => {
        item.style.opacity = '0';
        item.style.transform = 'translateY(20px)';
        item.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
        setTimeout(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
        }, 300 + (index * 100));
    });
});
</script>
</body>
</html>