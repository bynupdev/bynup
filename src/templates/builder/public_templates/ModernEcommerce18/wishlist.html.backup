{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Wishlist | {{ page.brand_name }}</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
{% render_icon_data icon_customizations %}

<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

{% generate_color_variables %}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
    padding-top: 100px;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Page Header */
.page-header {
    text-align: center;
    padding: var(--spacing-lg) 0 var(--spacing-md);
    margin-bottom: var(--spacing-md);
}

.page-header h1 {
    font-size: 3rem;
    color: var(--espresso-dark);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
}

.page-header h1::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
}

.page-header p {
    color: var(--sienna-deep);
    font-size: 1rem;
    max-width: 600px;
    margin: 1rem auto 0;
    opacity: 0.8;
}

/* Wishlist Stats */
.wishlist-stats {
    padding: 2rem 0;
    background-color: var(--white-pure);
    border-radius: var(--border-radius);
    margin-bottom: var(--spacing-lg);
    box-shadow: 0 4px 12px var(--shadow-soft);
}

.stats-container {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
}

.stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.stat-value {
    font-size: 2rem;
    color: var(--terracotta);
    font-weight: 600;
    font-family: 'Cormorant Garamond', serif;
}

.stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--sienna-deep);
}

/* Wishlist Actions */
.wishlist-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
    flex-wrap: wrap;
    gap: 1rem;
}

.filter-buttons {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 0.5rem 1.2rem;
    background: var(--white-pure);
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: 2rem;
    color: var(--sienna-deep);
    font-size: 0.8rem;
    cursor: pointer;
    transition: var(--transition);
    font-family: 'Montserrat', sans-serif;
}

.filter-btn:hover {
    border-color: var(--terracotta);
    color: var(--terracotta);
}

.filter-btn.active {
    background: var(--terracotta);
    border-color: var(--terracotta);
    color: var(--white-pure);
}

.clear-wishlist-btn {
    padding: 0.5rem 1.2rem;
    background: transparent;
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: 2rem;
    color: var(--sienna-deep);
    font-size: 0.8rem;
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Montserrat', sans-serif;
}

.clear-wishlist-btn:hover {
    border-color: var(--terracotta);
    color: var(--terracotta);
}

/* Wishlist Grid */
.wishlist-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: var(--spacing-xl);
}

.wishlist-item {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: 0 6px 12px var(--shadow-soft);
    position: relative;
}

.wishlist-item:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 28px var(--shadow-hover);
}

.wishlist-item-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
    background-color: var(--cream-warm);
}

.wishlist-item:hover .wishlist-item-image {
    transform: scale(1.02);
}

.wishlist-item-info {
    padding: 1.2rem;
    text-align: left;
}

.wishlist-item-category {
    color: var(--terracotta);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
}

.wishlist-item-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--espresso-dark);
    margin-bottom: 0.5rem;
    line-height: 1.3;
}

.wishlist-item-price {
    color: var(--terracotta);
    font-weight: 500;
    font-size: 1rem;
    margin-bottom: 1rem;
}

.wishlist-item-actions {
    display: flex;
    gap: 0.8rem;
    margin-top: 1rem;
}

.btn-add-to-cart-wishlist {
    flex: 1;
    background: var(--terracotta);
    color: var(--white-pure);
    padding: 0.6rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    border-radius: 2rem;
    transition: var(--transition);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: 'Montserrat', sans-serif;
}

.btn-add-to-cart-wishlist:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
}

.btn-remove-wishlist {
    width: 36px;
    height: 36px;
    background: var(--white-pure);
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: 50%;
    color: var(--sienna-deep);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
}

.btn-remove-wishlist:hover {
    background: rgba(209, 134, 80, 0.1);
    color: var(--terracotta);
    border-color: var(--terracotta);
}

.wishlist-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--terracotta);
    color: var(--white-pure);
    padding: 0.2rem 0.6rem;
    border-radius: 2rem;
    font-size: 0.7rem;
    font-weight: 500;
    z-index: 2;
}

/* Empty Wishlist State */
.empty-wishlist {
    text-align: center;
    padding: var(--spacing-xl) var(--spacing-md);
    background: var(--white-pure);
    border-radius: var(--border-radius);
    box-shadow: 0 6px 12px var(--shadow-soft);
    margin-bottom: var(--spacing-xl);
    grid-column: 1 / -1;
}

.empty-wishlist-icon {
    font-size: 4rem;
    color: var(--terracotta-light);
    margin-bottom: var(--spacing-md);
}

.empty-wishlist h2 {
    font-size: 1.6rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
}

.empty-wishlist p {
    color: var(--sienna-deep);
    margin-bottom: var(--spacing-md);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    font-size: 0.9rem;
}

.shop-now-wishlist-btn {
    display: inline-block;
    background: var(--terracotta);
    color: var(--white-pure);
    padding: 0.8rem 2rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 1px;
    text-decoration: none;
    border-radius: 3rem;
    transition: var(--transition);
}

.shop-now-wishlist-btn:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
}

/* Recently Viewed Section */
.recently-viewed {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-lg);
    border-top: 1px solid rgba(102, 47, 23, 0.1);
}

.recently-viewed h2 {
    font-size: 1.8rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.recently-viewed-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: var(--spacing-lg);
}

.recent-product-card {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: 0 5px 15px var(--shadow-soft);
    cursor: pointer;
    text-decoration: none;
    display: block;
    color: inherit;
}

.recent-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px var(--shadow-hover);
}

.recent-product-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
    background-color: var(--cream-warm);
}

.recent-product-card:hover .recent-product-img {
    transform: scale(1.02);
}

.recent-product-info {
    padding: 1rem;
    text-align: center;
}

.recent-product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
}

.recent-product-price {
    color: var(--terracotta);
    font-weight: 500;
    font-size: 0.85rem;
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .wishlist-grid {
        grid-template-columns: repeat(3, 1fr);
    }
    .recently-viewed-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 992px) {
    .wishlist-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .recently-viewed-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .stats-container {
        gap: 2rem;
    }
}

@media (max-width: 768px) {
    body {
        padding-top: 80px;
    }
    .wishlist-grid {
        grid-template-columns: 1fr;
        max-width: 320px;
        margin-left: auto;
        margin-right: auto;
    }
    .recently-viewed-grid {
        grid-template-columns: 1fr;
        max-width: 280px;
        margin-left: auto;
        margin-right: auto;
    }
    .wishlist-actions {
        flex-direction: column;
        align-items: stretch;
    }
    .filter-buttons {
        justify-content: center;
    }
    .clear-wishlist-btn {
        text-align: center;
        justify-content: center;
    }
    .page-header h1 {
        font-size: 2rem;
    }
    .stat-value {
        font-size: 1.5rem;
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 1.2rem;
    }
    .stats-container {
        gap: 1rem;
    }
    .stat-item {
        min-width: 80px;
    }
}

/* Dynamic Section Styles */
{% generate_section_styles style_customizations 310 369 %}

/* Dynamic Background Images */
{% generate_background_images background_images 310 369 %}

{% generate_hover_keyframes %}
</style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce18/snippets/header1.html' %}

{% for component in components %}
{% if component.drop_zone == '1' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Page Header -->
<div class="page-header" id="section-310">
    <div class="container">
        <h1 id="section-311">{{ text_contents.500|default:"Your Wishlist" }}</h1>
        <p id="section-312">{{ text_contents.501|default:"Save your favorite pieces for later. Your wishlist is always here when you're ready to make them yours." }}</p>
    </div>
</div>

{% for component in components %}
{% if component.drop_zone == '310' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Wishlist Stats -->
<div class="container">
    <div class="wishlist-stats" id="section-313">
        <div class="stats-container">
            <div class="stat-item">
                <span class="stat-value" id="itemsCount">{{ wishlist_items|length|default:"0" }}</span>
                <span class="stat-label" id="section-314">{{ text_contents.502|default:"Items Saved" }}</span>
            </div>
            <div class="stat-item">
                <span class="stat-value" id="onSaleCount">
                    {% if wishlist_items %}
                    {{ wishlist_items|length }}
                    {% else %}
                    0
                    {% endif %}
                </span>
                <span class="stat-label" id="section-315">{{ text_contents.503|default:"On Sale" }}</span>
            </div>
            <div class="stat-item">
                <span class="stat-value" id="totalValue">
                    {% if wishlist_items %}
                    {{ wish_price_total|currency:page }}
                    {% else %}
                    {{ 0|currency:page }}
                    {% endif %}
                </span>
                <span class="stat-label" id="section-316">{{ text_contents.504|default:"Total Value" }}</span>
            </div>
            <div class="stat-item">
                <span class="stat-value" id="lowStockCount">
                    {% if wishlist_items %}
                    {{ wish_low_stock_count|default:"0" }}
                    {% else %}
                    0
                    {% endif %}
                </span>
                <span class="stat-label" id="section-317">{{ text_contents.505|default:"Low in Stock" }}</span>
            </div>
        </div>
    </div>
</div>

<!-- Wishlist Actions -->
<div class="container">
    <div class="wishlist-actions">
        <div class="filter-buttons">
            <button class="filter-btn active" data-filter="all" id="section-318">{{ text_contents.506|default:"All Items" }}</button>
            <button class="filter-btn" data-filter="sale" id="section-319">{{ text_contents.507|default:"On Sale" }}</button>
            <button class="filter-btn" data-filter="in-stock" id="section-320">{{ text_contents.508|default:"In Stock" }}</button>
            <button class="filter-btn" data-filter="new" id="section-321">{{ text_contents.509|default:"New Arrivals" }}</button>
        </div>
        <button class="clear-wishlist-btn" id="section-322">
            <i class="fas fa-trash-alt" data-icon="400"></i> {{ text_contents.510|default:"Clear All" }}
        </button>
    </div>
</div>

<!-- Wishlist Grid -->
<div class="container">
    <div class="wishlist-grid" id="wishlist-grid">
        {% if wishlist_items %}
        {% for item in wishlist_items %}
        {% with product=item.product %}
        <a href="/product/{{ product.slug }}/" style="text-decoration: none;">
        <div class="wishlist-item" 
            id="section-323"
            data-product-id="{{ product.id }}"
            data-category="{{ product.category.slug|default:'general' }}"
            data-stock="{% if product.quantity < 5 %}low-stock{% else %}in-stock{% endif %}"
            data-badge="{% if product.is_on_sale %}sale{% elif forloop.counter == 1 %}new{% endif %}">
            {% if product.is_on_sale %}
            <div class="wishlist-badge" >{{ text_contents.511|default:"SALE" }}</div>
            {% elif forloop.counter == 1 %}
            <div class="wishlist-badge" style="background: var(--terracotta);">{{ text_contents.512|default:"NEW" }}</div>
            {% endif %}
            {% if product.main_image %}
            <img src="{{ product.main_image.url }}" alt="{{ product.title }}" class="wishlist-item-image">
            {% else %}
            <div class="wishlist-item-image" style="background-color: var(--cream-warm);"></div>
            {% endif %}
            <div class="wishlist-item-info">
                <div class="wishlist-item-category" id="section-324">{{ product.category.name|default:"ACCESSORIES" }}</div>
                <div class="wishlist-item-name" id="section-325">{{ product.title }}</div>
                <div class="wishlist-item-price" id="section-326">
                    {% if product.is_on_sale %}
                    <span style="text-decoration: line-through; color: #999;">{{ product.compare_at_price|currency:page }}</span> {{ product.price|currency:page }}
                    {% else %}
                    {{ product.price|currency:page }}
                    {% endif %}
                </div>
                <div class="wishlist-item-actions">
                    <button class="btn-add-to-cart-wishlist" id="section-327" data-add-to-cart="{{ product.id }}">
                        <i class="fas fa-shopping-bag" data-icon="401"></i> {{ text_contents.514|default:"Add to Cart" }}
                    </button>
                    <button class="btn-remove-wishlist" data-remove-from-wishlist="{{ product.id }}">
                        <i class="fas fa-times" data-icon="402"></i>
                    </button>
                </div>
            </div>
        </div>
        </a>
        {% endwith %}
        {% endfor %}
        {% else %}
        <div class="empty-wishlist">
            <div class="empty-wishlist-icon">
                <i class="far fa-heart" data-icon="404"></i>
            </div>
            <h2 >Your Wishlist is Empty</h2>
            <p >Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready.</p>
            <a href="?page=products" class="shop-now-wishlist-btn" id="section-331">
                default:"Start Shopping
            </a>
        </div>
        {% endif %}
    </div>
</div>

{% for component in components %}
{% if component.drop_zone == '323' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Recently Viewed Section -->
<div class="container">
    <div class="recently-viewed" id="section-328">
        <h2 id="section-329">{{ text_contents.515|default:"Recently Viewed" }}</h2>
        <div class="recently-viewed-grid">
            {% if recently_viewed_products %}
            {% for rvp in recently_viewed_products|slice:":4" %}
            {% with product=rvp.product %}
            <a href="/product/{{ product.slug }}/" class="recent-product-card">
                {% if product.main_image %}
                <img src="{{ product.main_image.url }}" alt="{{ product.title }}" class="recent-product-img">
                {% else %}
                <div class="recent-product-img" style="background-color: var(--cream-warm);"></div>
                {% endif %}
                <div class="recent-product-info">
                    <div class="recent-product-name" id="section-330">{{ product.title|truncatechars:30 }}</div>
                    <div class="recent-product-price" id="section-331">{{ product.price|currency:page }}</div>
                </div>
            </a>
            {% endwith %}
            {% endfor %}

            {% endif %}
        </div>
    </div>
</div>

{% for component in components %}
{% if component.drop_zone == '332' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce18/snippets/footer.html' %}

{% for component in components %}
{% if component.drop_zone == 'end' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
// Wishlist Management Variables
let currentFilter = 'all';

// Filter buttons
const filterBtns = document.querySelectorAll('.filter-btn');
filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
        filterBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        currentFilter = this.getAttribute('data-filter');
        filterWishlistItems();
    });
});

function filterWishlistItems() {
    const wishlistItems = document.querySelectorAll('.wishlist-item');
    let visibleCount = 0;
    
    wishlistItems.forEach(item => {
        const badge = item.getAttribute('data-badge');
        const stock = item.getAttribute('data-stock');
        let shouldShow = true;
        
        switch(currentFilter) {
            case 'sale':
                shouldShow = badge === 'sale';
                break;
            case 'in-stock':
                shouldShow = stock === 'in-stock';
                break;
            case 'new':
                shouldShow = badge === 'new';
                break;
            case 'all':
            default:
                shouldShow = true;
        }
        
        if (shouldShow) {
            item.style.display = 'block';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });
    
    const wishlistGrid = document.getElementById('wishlist-grid');
    const emptyMessage = document.querySelector('.empty-wishlist');
    
    if (visibleCount === 0 && wishlistItems.length > 0 && !emptyMessage) {
        const emptyHtml = `
            <div class="empty-wishlist" style="grid-column: 1 / -1;">
                <div class="empty-wishlist-icon">
                    <i class="far fa-heart" data-icon="404"></i>
                </div>
                <h2 id="section-334">{{ text_contents.518|default:"No Items Match Your Filter" }}</h2>
                <p id="section-335">{{ text_contents.519|default:"Try selecting a different filter to view your saved items." }}</p>
                <button class="shop-now-wishlist-btn" id="section-336" onclick="resetFilters()">{{ text_contents.520|default:"Show All Items" }}</button>
            </div>
        `;
        wishlistGrid.insertAdjacentHTML('beforeend', emptyHtml);
    } else if (visibleCount > 0) {
        const existingEmpty = document.querySelector('.empty-wishlist');
        if (existingEmpty && !existingEmpty.closest('.wishlist-item')) {
            existingEmpty.remove();
        }
    }
}

function resetFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    filterBtns.forEach(btn => btn.classList.remove('active'));
    document.querySelector('.filter-btn[data-filter="all"]').classList.add('active');
    currentFilter = 'all';
    filterWishlistItems();
}

// Remove from wishlist
document.querySelectorAll('.btn-remove-wishlist').forEach(button => {
    button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const productId = this.getAttribute('data-remove-from-wishlist');
        if (window.cartManager) {
            window.cartManager.removeFromWishlist(productId);
        }
    });
});

// Add to cart from wishlist
document.querySelectorAll('.btn-add-to-cart-wishlist').forEach(button => {
    button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const productId = this.getAttribute('data-add-to-cart');
        if (window.cartManager) {
            window.cartManager.addToCart(productId, 1);
        }
    });
});

// Clear all wishlist
const clearWishlistBtn = document.getElementById('section-322');
if (clearWishlistBtn) {
    clearWishlistBtn.addEventListener('click', function() {
        if (window.cartManager) {
            window.cartManager.clearWishlist();
        }
    });
}

// Recently viewed product click
document.querySelectorAll('.recent-product-card').forEach(card => {
    card.addEventListener('click', function(e) {
        // Already has href, no need for additional alert
    });
});

window.resetFilters = resetFilters;
</script>
</body>
</html>