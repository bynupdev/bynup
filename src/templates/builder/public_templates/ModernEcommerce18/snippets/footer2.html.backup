{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

{% generate_color_variables %}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Footer */
footer {
    background-color: var(--espresso-dark);
    color: var(--bg-light);
    padding: var(--spacing-lg) 0;
    margin-top: var(--spacing-lg);
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
}

.footer-section {
    flex: 1;
    min-width: 200px;
}

h3 {
    font-size: 1.3rem;
    margin-bottom: 1.2rem;
    color: var(--cream-warm);
    font-family: 'Cormorant Garamond', serif;
}

.footer-column p, .footer-column a {
    color: rgba(253, 247, 240, 0.8);
    margin-bottom: 0.6rem;
    display: block;
    text-decoration: none;
    transition: var(--transition);
    font-size: 0.9rem;
}

.footer-column a:hover {
    color: var(--cream-warm);
}

.social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
}

.social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(253, 247, 240, 0.1);
    color: var(--bg-light);
    transition: var(--transition);
}

.social-link:hover {
    background: var(--terracotta);
    transform: translateY(-3px);
}

.copyright {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(253, 247, 240, 0.1);
    color: rgba(253, 247, 240, 0.6);
    font-size: 0.85rem;
}

@media (max-width: 768px) {
    .footer-content {
        flex-direction: column;
        gap: 2rem;
    }
    .footer-section {
        min-width: 100%;
    }
    .container {
        padding: 0 1.2rem;
    }
}

/* Dynamic Section Styles */
{% generate_section_styles style_customizations 25 50 %}

/* Dynamic Background Images */
{% generate_background_images background_images 25 50 %}

{% generate_hover_keyframes %}
</style>

<footer id="section-25">
    <div class="container">
        <div class="footer-content">
            <div class="footer-section" id="section-26">
                <h3 id="section-27">{{ text_contents.20|default:"PŌTA" }}</h3>
                <ul>
                    <li id="section-28">{{ text_contents.21|default:"Premium essentials for the modern pet parent. Thoughtfully crafted with love and care." }}</li>
                </ul>
                {% if page.social_media.all %}
                <div class="social-links">
                    {% for social in page.social_media.all %}
                    {% if social.is_active %}
                    <a href="{{ social.get_url }}" class="social-link" target="{{ social.open_in_new_tab|yesno:'_blank,_self' }}" rel="noopener noreferrer" title="{{ social.display_name|default:social.get_platform_display }}">
                        <i class="{{ social.get_icon }}"></i>
                    </a>
                    {% endif %}
                    {% endfor %}
                </div>
                {% else %}
                <div class="social-links">
                    <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-link"><i class="fab fa-pinterest-p"></i></a>
                </div>
                {% endif %}
            </div>
            <div class="footer-section">
                <h3 id="section-29">{{ text_contents.22|default:"Quick Links" }}</h3>
                <ul>
                    <li id="section-30"><a href="../../?page=home">{{ text_contents.23|default:"Home" }}</a></li>
                    <li id="section-31"><a href="../../?page=products">{{ text_contents.24|default:"Shop" }}</a></li>
                    <li id="section-32"><a href="../../?page=about">{{ text_contents.25|default:"About Us" }}</a></li>
                    <li id="section-33"><a href="../../?page=contact">{{ text_contents.26|default:"Contact" }}</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3 id="section-34">{{ text_contents.27|default:"Customer Service" }}</h3>
                <ul>
                    <li id="section-35"><a href="{% url 'public_shipping_policy' subdomain=page.subdomain %}">{{ text_contents.28|default:"Shipping & Returns" }}</a></li>
                    <li id="section-36"><a href="{% url 'public_privacy' subdomain=page.subdomain %}">{{ text_contents.29|default:"Privacy Policy" }}</a></li>
                    <li id="section-37"><a href="{% url 'public_terms' subdomain=page.subdomain %}">{{ text_contents.30|default:"Terms & Conditions" }}</a></li>
                    <li id="section-38"><a href="../../?page=contact">{{ text_contents.31|default:"FAQ" }}</a></li>
                </ul>
            </div>
            <div class="footer-section">
                <h3 id="section-39">{{ text_contents.32|default:"Contact Us" }}</h3>
                <ul>
                    <li id="section-40">{{ text_contents.33|default:"+1 (555) 123-4567" }}</li>
                    <li id="section-41">{{ text_contents.34|default:"hello@pota.com" }}</li>
                    <li id="section-42">{{ text_contents.35|default:"123 Luxury Ave, New York, NY 10001" }}</li>
                </ul>
            </div>
        </div>
        <div class="copyright" id="section-43">
            <p id="section-44">{{ text_contents.36|default:"&copy; 2024 PŌTA. All rights reserved."|safe }}</p>
        </div>
    </div>
</footer>

<!-- Message Notification Container -->
<div id="backend-messages-container" class="backend-messages-container">
    <div id="backend-message-template" class="backend-message" style="display: none;">
        <div class="backend-message-content">
            <i class="backend-message-icon"></i>
            <div class="backend-message-text">
                <strong class="backend-message-title"></strong>
                <div class="backend-message-body"></div>
            </div>
            <button class="backend-message-close" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="backend-message-progress"></div>
    </div>
</div>

{% if messages %}
<div id="django-messages-container" class="django-messages-container">
    {% for message in messages %}
    <div class="django-message django-message-{{ message.tags }}">
        <div class="django-message-content">
            <i class="fas fa-{% if message.tags == 'success' %}check-circle{% elif message.tags == 'error' or message.tags == 'danger' %}exclamation-circle{% else %}info-circle{% endif %}"></i>
            <div class="django-message-text">
                <strong>{{ message|capfirst }}</strong>
            </div>
            <button class="django-message-close" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<style>
.backend-messages-container,
.django-messages-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 400px;
}

.backend-message {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
    border-left: 4px solid;
    animation: slideInBackendMessage 0.3s ease forwards;
    transform: translateX(100%);
    opacity: 0;
}

.backend-message.success { border-left-color: #28a745; background: linear-gradient(90deg, rgba(40, 167, 69, 0.08) 0%, white 30%); }
.backend-message.error { border-left-color: #dc3545; background: linear-gradient(90deg, rgba(220, 53, 69, 0.08) 0%, white 30%); }
.backend-message.warning { border-left-color: #ffc107; background: linear-gradient(90deg, rgba(255, 193, 7, 0.08) 0%, white 30%); }
.backend-message.info { border-left-color: #17a2b8; background: linear-gradient(90deg, rgba(23, 162, 184, 0.08) 0%, white 30%); }

.django-message {
    background: white;
    border-radius: 8px;
    padding: 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    border-left: 4px solid;
    animation: slideInBackendMessage 0.3s ease forwards;
}
.django-message.success { border-left-color: #28a745; background: linear-gradient(90deg, rgba(40, 167, 69, 0.1) 0%, white 30%); }
.django-message.error { border-left-color: #dc3545; background: linear-gradient(90deg, rgba(220, 53, 69, 0.1) 0%, white 30%); }
.django-message.warning { border-left-color: #ffc107; background: linear-gradient(90deg, rgba(255, 193, 7, 0.1) 0%, white 30%); }
.django-message.info { border-left-color: #17a2b8; background: linear-gradient(90deg, rgba(23, 162, 184, 0.1) 0%, white 30%); }

.backend-message-content,
.django-message-content {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    gap: 12px;
}

.backend-message-icon,
.django-message-content i {
    font-size: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.success .backend-message-icon,
.django-message.success i { background-color: #28a745; color: white; }
.error .backend-message-icon,
.django-message.error i { background-color: #dc3545; color: white; }
.warning .backend-message-icon,
.django-message.warning i { background-color: #ffc107; color: #212529; }
.info .backend-message-icon,
.django-message.info i { background-color: #17a2b8; color: white; }

.backend-message-text,
.django-message-text { flex: 1; font-size: 14px; line-height: 1.5; }
.backend-message-title { display: block; color: #212529; font-weight: 600; margin-bottom: 2px; }
.backend-message-body { color: #495057; font-size: 13px; line-height: 1.4; }

.backend-message-close,
.django-message-close {
    background: none;
    border: none;
    color: #6c757d;
    cursor: pointer;
    padding: 6px;
    font-size: 14px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
}
.backend-message-close:hover,
.django-message-close:hover { color: #495057; background-color: rgba(0, 0, 0, 0.05); }

.backend-message-progress { height: 3px; background: rgba(0, 0, 0, 0.1); width: 100%; }
.backend-message.progressing .backend-message-progress { animation: progressBar 5s linear forwards; }

@keyframes slideInBackendMessage {
    0% { transform: translateX(100%); opacity: 0; }
    100% { transform: translateX(0); opacity: 1; }
}
@keyframes slideOutBackendMessage {
    0% { transform: translateX(0); opacity: 1; }
    100% { transform: translateX(100%); opacity: 0; }
}
@keyframes progressBar {
    0% { width: 100%; }
    100% { width: 0%; }
}
.backend-message.slide-out { animation: slideOutBackendMessage 0.3s ease forwards; }

@media (max-width: 768px) {
    .backend-messages-container,
    .django-messages-container {
        top: 10px;
        right: 10px;
        left: 10px;
        max-width: calc(100% - 20px);
    }
    .backend-message,
    .django-message { max-width: 100%; }
    .backend-message-content,
    .django-message-content { padding: 14px 16px; }
}
</style>

<script>
const BackendMessages = {
    showBackendMessage(type, title, body = '', duration = 5000) {
        const container = document.getElementById('backend-messages-container');
        const template = document.getElementById('backend-message-template');
        if (!container || !template) return null;
        const messageElement = template.cloneNode(true);
        messageElement.id = 'backend-msg-' + Date.now();
        messageElement.style.display = 'block';
        messageElement.classList.add(type);
        if (duration > 0) messageElement.classList.add('progressing');
        const iconMap = { 'success': 'fas fa-check-circle', 'error': 'fas fa-exclamation-circle', 'warning': 'fas fa-exclamation-triangle', 'info': 'fas fa-info-circle' };
        const iconElement = messageElement.querySelector('.backend-message-icon');
        const titleElement = messageElement.querySelector('.backend-message-title');
        const bodyElement = messageElement.querySelector('.backend-message-body');
        if (iconElement) iconElement.className = `backend-message-icon ${iconMap[type] || iconMap.info}`;
        if (titleElement) titleElement.textContent = title;
        if (bodyElement) { bodyElement.textContent = body; if (!body) bodyElement.style.display = 'none'; }
        container.appendChild(messageElement);
        setTimeout(() => { messageElement.style.transform = 'translateX(0)'; messageElement.style.opacity = '1'; }, 10);
        if (duration > 0) setTimeout(() => this.removeBackendMessage(messageElement), duration);
        return messageElement.id;
    },
    removeBackendMessage(messageElement) {
        if (!messageElement) return;
        messageElement.classList.add('slide-out');
        setTimeout(() => { if (messageElement.parentElement) messageElement.parentElement.removeChild(messageElement); }, 300);
    },
    handleAjaxResponse(responseData) {
        if (!responseData) return;
        if (responseData.errors) {
            for (const [field, errors] of Object.entries(responseData.errors)) {
                errors.forEach(error => this.showBackendMessage('error', `Field Error: ${field}`, error, 6000));
            }
            return;
        }
        if (responseData.success === true && responseData.message) this.showBackendMessage('success', 'Success', responseData.message);
        else if (responseData.success === false && responseData.error) this.showBackendMessage('error', 'Error', responseData.error);
        else if (responseData.message) this.showBackendMessage('info', 'Notice', responseData.message);
        if (responseData.action === 'add_to_cart') {
            if (responseData.success) this.showBackendMessage('success', 'Added to Cart', `"${responseData.product_title}" has been added to your cart.`, 4000);
            else this.showBackendMessage('error', 'Cart Error', responseData.error || 'Could not add item to cart.', 5000);
        }
        if (responseData.action === 'add_to_wishlist') {
            if (responseData.success) this.showBackendMessage('success', 'Added to Wishlist', `"${responseData.product_title}" has been added to your wishlist.`, 4000);
            else this.showBackendMessage('error', 'Wishlist Error', responseData.error || 'Could not add item to wishlist.', 5000);
        }
        if (responseData.max_quantity) this.showBackendMessage('warning', 'Quantity Limit', `Maximum quantity is ${responseData.max_quantity}.`, 4000);
        if (responseData.out_of_stock === true) this.showBackendMessage('error', 'Out of Stock', 'This item is currently out of stock.', 5000);
        if (responseData.low_stock === true) this.showBackendMessage('warning', 'Low Stock', 'Only a few items left in stock!', 4000);
    },
    interceptFetch() {
        const originalFetch = window.fetch;
        window.fetch = async function(...args) {
            try {
                const response = await originalFetch(...args);
                const clonedResponse = response.clone();
                const contentType = clonedResponse.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) {
                    const data = await clonedResponse.json();
                    if (data) setTimeout(() => BackendMessages.handleAjaxResponse(data), 100);
                }
                return response;
            } catch (error) {
                BackendMessages.showBackendMessage('error', 'Network Error', 'Unable to connect to the server. Please check your connection.', 6000);
                throw error;
            }
        };
    },
    init() {
        setTimeout(() => {
            const djangoMessages = document.querySelectorAll('.django-message');
            djangoMessages.forEach(message => setTimeout(() => { if (message.parentElement) message.remove(); }, 5000));
        }, 1000);
        this.interceptFetch();
        window.BackendMessages = this;
        console.log('BackendMessages initialized');
    }
};
document.addEventListener('DOMContentLoaded', function() { BackendMessages.init(); });
</script>

<script>
    // Set branding configuration
    window.BYNUP_CONFIG = {
        showBranding: {{ show_bynup_branding|yesno:"true,false" }}
    };
</script>
<script src="{% static 'builder/js/bynup-branding.js' %}"></script>


<script src="{% static 'builder/js/cart-manager.js' %}"></script>