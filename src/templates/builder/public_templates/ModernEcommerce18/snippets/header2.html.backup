{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

{% generate_color_variables %}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Header / Navigation */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 1.2rem 0;
    background-color: rgba(253, 247, 240, 0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(102, 47, 23, 0.05);
    transition: var(--transition);
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo a {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--espresso-dark);
    text-decoration: none;
    letter-spacing: 1px;
}

.logo span {
    color: var(--espresso-dark);
}

.logo span span {
    color: var(--terracotta);
}

.desktop-nav {
    display: flex;
    gap: 2.5rem;
}

.desktop-nav a {
    text-decoration: none;
    color: var(--espresso-dark);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    transition: var(--transition);
    position: relative;
}

.desktop-nav a:hover {
    color: var(--terracotta);
}

.desktop-nav a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
    transition: width 0.3s ease;
}

.desktop-nav a:hover::after {
    width: 100%;
}

.nav-icons {
    display: flex;
    gap: 1.5rem;
    align-items: center;
}

.nav-icons i {
    font-size: 1.2rem;
    color: var(--espresso-dark);
    cursor: pointer;
    transition: var(--transition);
}

.nav-icons i:hover {
    color: var(--terracotta);
}

.icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    padding: 0.4rem;
}

.cart-counter,
.wishlist-counter {
    position: absolute;
    top: 0;
    right: 0;
    transform: translate(50%, -50%);
    background-color: var(--terracotta);
    color: white;
    padding: 0.2rem 0.4rem;
    border-radius: 1rem;
    font-size: 0.65rem;
    font-weight: 500;
    min-width: 18px;
    text-align: center;
}

/* Account Dropdown */
.account-dropdown {
    position: relative;
    display: inline-block;
}

.dropdown {
    display: none;
    position: absolute;
    right: 0;
    top: 100%;
    background-color: white;
    min-width: 200px;
    box-shadow: 0 8px 25px rgba(102, 47, 23, 0.1);
    z-index: 1;
    border-radius: var(--border-radius);
    overflow: hidden;
    /* margin-top: 10px; */
    list-style: none;
}

.dropdown a {
    color: var(--espresso-dark);
    padding: 0.8rem 1.2rem;
    text-decoration: none;
    display: block;
    font-size: 0.9rem;
    transition: var(--transition);
}

.dropdown a:hover {
    background-color: rgba(227, 194, 163, 0.3);
    color: var(--terracotta);
}

.account-dropdown:hover .dropdown {
    display: block;
}

/* Hamburger Menu */
.hamburger {
    display: none;
    cursor: pointer;
    font-size: 1.5rem;
    color: var(--espresso-dark);
}

.mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--bg-light);
    z-index: 9999;
    padding: 2rem;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
}

.mobile-nav.active {
    transform: translateX(0);
}

.mobile-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

.mobile-nav-links a {
    text-decoration: none;
    color: var(--espresso-dark);
    font-size: 1.2rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(102, 47, 23, 0.05);
    display: flex;
    align-items: center;
    gap: 0.8rem;
}

.back-button {
    background: none;
    border: none;
    font-size: 1rem;
    color: var(--espresso-dark);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--cream-warm);
    border-radius: 2rem;
}

@media (max-width: 768px) {
    .hamburger {
        display: block;
    }
    .desktop-nav {
        display: none;
    }
    .container {
        padding: 0 1.2rem;
    }
    .logo a {
        font-size: 1.6rem;
    }
}

/* Dynamic Section Styles */
{% generate_section_styles style_customizations 1 50 %}

/* Dynamic Background Images */
{% generate_background_images background_images 1 50 %}

{% generate_hover_keyframes %}
</style>

<header id="section-1">
    <div class="container header-container">
        <div class="logo">
            <a href="../../?page=home">
                <i class="fas fa-paw" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"PŌTA<span>Pet</span>"|safe }}</span>
            </a>
        </div>
        <nav class="desktop-nav">
            <a href="../../?page=home" id="section-3">{{ text_contents.2|default:"Home" }}</a>
            <a href="../../?page=products" id="section-4">{{ text_contents.3|default:"Shop" }}</a>
            <a href="../../?page=about" id="section-5">{{ text_contents.4|default:"About Us" }}</a>
            <a href="../../?page=contact" id="section-6">{{ text_contents.5|default:"Contact" }}</a>
        </nav>
        <div class="nav-icons">
            <a href="../../?page=cart" class="icon-btn">
                <span class="cart-counter">0</span>
                <i class="fas fa-shopping-bag" data-icon="2"></i>
            </a>
            <a href="../../?page=wishlist" class="icon-btn">
                <span class="wishlist-counter">0</span>
                <i class="far fa-heart" data-icon="3"></i>
            </a>
            <div class="account-dropdown">
                <i class="far fa-user" data-icon="4" onclick="toggleDropdown()" style="cursor:pointer;"></i>
                <ul id="dropdown" class="dropdown">
                    <div onclick="toggleDropdown()" style="text-align:right; padding:5px 15px; cursor:pointer;">
                        <i class="fa-solid fa-xmark" data-icon="5" style="font-size:18px; color:#444;"></i>
                    </div>
                    <li><a href="{{ website_login_url }}" id="section-7">{{ text_contents.6|default:"Sign In" }}</a></li>
                    <li><a href="{{ website_register_url }}" id="section-8">{{ text_contents.7|default:"Sign Up" }}</a></li>
                    <li><a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-9">{{ text_contents.8|default:"Orders" }}</a></li>
                    <li><a href="../../?page=wishlist" id="section-10">{{ text_contents.9|default:"Wishlist" }}</a></li>
                    <li><a href="{{ website_logout_url }}" id="section-7"><i class="fas fa-sign-out-alt"></i>  Logout</a></li>
                    <!-- <li><a href="../../?page=account" id="section-11">{{ text_contents.10|default:"Account Settings" }}</a></li> -->
                </ul>
            </div>
            <div class="hamburger">
                <i class="fas fa-bars" data-icon="6"></i>
            </div>
        </div>
    </div>
</header>

<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="../../?page=home" class="logo">PŌTA<span>Pet</span></a>
        <button class="back-button" id="closeNav">
            <i class="fas fa-arrow-left" data-icon="6"></i> Back
        </button>
    </div>
    <div class="mobile-nav-links">
        <a href="../../?page=home">Home</a>
        <a href="../../?page=products">Shop</a>
        <a href="../../?page=about">About Us</a>
        <a href="../../?page=contact">Contact</a>
        <a href="../../?page=cart"><i class="fas fa-shopping-bag"></i> Cart</a>
        <a href="../../?page=wishlist"><i class="far fa-heart"></i> Wishlist</a>
        <a href="../../?page=account"><i class="far fa-user"></i> Account</a>
    </div>
</div>

<script>
// Mobile Navigation
const hamburger = document.querySelector('.hamburger');
const mobileNav = document.getElementById('mobileNav');
const closeNav = document.getElementById('closeNav');

if (hamburger) {
    hamburger.addEventListener('click', function() {
        mobileNav.classList.add('active');
    });
}
if (closeNav) {
    closeNav.addEventListener('click', function() {
        mobileNav.classList.remove('active');
    });
}

const mobileNavLinks = document.querySelectorAll('.mobile-nav-links a');
mobileNavLinks.forEach(link => {
    link.addEventListener('click', function() {
        mobileNav.classList.remove('active');
    });
});

// Header scroll effect
window.addEventListener('scroll', function() {
    const header = document.querySelector('header');
    if (header && window.scrollY > 100) {
        header.style.padding = '0.8rem 0';
        header.style.boxShadow = '0 5px 20px rgba(102, 47, 23, 0.1)';
    } else if (header) {
        header.style.padding = '1.2rem 0';
        header.style.boxShadow = '0 2px 20px rgba(102, 47, 23, 0.05)';
    }
});

function toggleDropdown() {
    const menu = document.getElementById("dropdown");
    const isVisible = menu.style.display === "block";
    menu.style.display = isVisible ? "none" : "block";
    menu.style.opacity = isVisible ? "0" : "1";
    menu.style.transform = isVisible ? "translateY(-5px)" : "translateY(0px)";
}

document.addEventListener('click', function(event) {
    const dropdown = document.getElementById('dropdown');
    const userIcon = document.querySelector('.fa-user');
    if (dropdown && userIcon && !userIcon.contains(event.target) && !dropdown.contains(event.target)) {
        dropdown.style.display = 'none';
        dropdown.style.opacity = '0';
        dropdown.style.transform = 'translateY(-5px)';
    }
});
</script>