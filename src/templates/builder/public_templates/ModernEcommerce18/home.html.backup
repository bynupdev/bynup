{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ page.brand_name }} </title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
{% render_icon_data icon_customizations %}

<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

{% generate_color_variables %}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Header / Navigation */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 1.2rem 0;
    background-color: rgba(253, 247, 240, 0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(102, 47, 23, 0.05);
    transition: var(--transition);
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo a {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--espresso-dark);
    text-decoration: none;
    letter-spacing: 1px;
}

.logo span {
    color: var(--espresso-dark);
}

.logo span span {
    color: var(--terracotta);
}

.desktop-nav {
    display: flex;
    gap: 2.5rem;
}

.desktop-nav a {
    text-decoration: none;
    color: var(--espresso-dark);
    font-weight: 400;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    transition: var(--transition);
    position: relative;
}

.desktop-nav a:hover {
    color: var(--terracotta);
}

.desktop-nav a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
    transition: width 0.3s ease;
}

.desktop-nav a:hover::after {
    width: 100%;
}

.nav-icons {
    display: flex;
    gap: 1.5rem;
    align-items: center;
}

.nav-icons i {
    font-size: 1.2rem;
    color: var(--espresso-dark);
    cursor: pointer;
    transition: var(--transition);
}

.nav-icons i:hover {
    color: var(--terracotta);
}

/* Account Dropdown */
.account-dropdown {
    position: relative;
    display: inline-block;
}

.dropdown-content {
    display: none;
    position: absolute;
    right: 0;
    top: 100%;
    background-color: var(--white-pure);
    min-width: 200px;
    box-shadow: 0 8px 25px rgba(102, 47, 23, 0.1);
    z-index: 1;
    border-radius: var(--border-radius);
    overflow: hidden;
    margin-top: 10px;
}

.dropdown-content a {
    color: var(--espresso-dark);
    padding: 0.8rem 1.2rem;
    text-decoration: none;
    display: block;
    font-size: 0.9rem;
    transition: var(--transition);
}

.dropdown-content a:hover {
    background-color: rgba(227, 194, 163, 0.3);
    color: var(--terracotta);
}

.account-dropdown:hover .dropdown-content {
    display: block;
}

/* Hamburger Menu */
.hamburger {
    display: none;
    cursor: pointer;
    font-size: 1.5rem;
    color: var(--espresso-dark);
}

.mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--bg-light);
    z-index: 9999;
    padding: 2rem;
    transform: translateX(-100%);
    transition: transform 0.4s ease;
}

.mobile-nav.active {
    transform: translateX(0);
}

.mobile-nav-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
}

.mobile-nav-links a {
    text-decoration: none;
    color: var(--espresso-dark);
    font-size: 1.2rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(102, 47, 23, 0.05);
}

.back-button {
    background: none;
    border: none;
    font-size: 1rem;
    color: var(--espresso-dark);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background-color: var(--cream-warm);
    border-radius: 2rem;
}

/* Hero Section */
section.hero {
    height: 100vh;
    width: 100%;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    margin-top: 80px;
}

.hero{
width: 100%;
    height: 100%;
    background-image: url('{%static "images/Ecom18/hero.png"%}');
    background-size: cover;
    background-position: center 30%;
    z-index: 1;
}

.hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    /* width: 100%;
    height: 100%;
    background-image: url('https://images.pexels.com/photos/6231634/pexels-photo-6231634.jpeg?auto=compress&cs=tinysrgb&w=1600');
    background-size: cover;
    background-position: center 30%;
    z-index: 1; */
}

.hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(120deg, rgba(227, 194, 163, 0.25) 0%, rgba(102, 47, 23, 0.15) 100%);
    z-index: 2;
}

.hero-content {
    position: relative;
    z-index: 3;
    max-width: 650px;
    padding: 2rem;
    background: rgba(253, 247, 240, 0.75);
    backdrop-filter: blur(8px);
    border-radius: 2rem;
    margin: 2rem;
}

h1 {
    font-size: 3.5rem;
    color: var(--espresso-dark);
    line-height: 1.2;
    margin-bottom: 1.2rem;
    font-weight: 600;
}

p {
    font-size: 1.1rem;
    color: var(--sienna-deep);
    margin-bottom: 2rem;
    font-weight: 400;
    line-height: 1.6;
}

a.cta-btn {
    display: inline-block;
    background: var(--terracotta);
    color: var(--white-pure);
    padding: 1rem 2rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-decoration: none;
    border-radius: 3rem;
    transition: var(--transition);
    box-shadow: 0 4px 12px rgba(102, 47, 23, 0.15);
}

a.cta-btn:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(102, 47, 23, 0.2);
}

/* New Arrivals Section */
section.new-arrivals {
    padding: var(--spacing-xl) 0;
    text-align: center;
}

.section-header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
}

h2 {
    font-size: 2.8rem;
    color: var(--espresso-dark);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
}

h2::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 2px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
}

.section-header p {
    color: var(--sienna-deep);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-bottom: var(--spacing-lg);
}

div.product-card {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: 0 6px 12px var(--shadow-soft);
    cursor: pointer;
}

div.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 28px var(--shadow-hover);
}

.product-img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    transition: transform 0.4s ease;
}

div.product-card:hover .product-img {
    transform: scale(1.02);
}

.product-info {
    padding: 1.2rem;
    text-align: left;
}

.product-name {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
}

.product-price {
    font-weight: 500;
    color: var(--terracotta);
    font-size: 1rem;
}

.product-category {
    color: var(--sienna-deep);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
}

.see-more {
    display: inline-block;
    background: none;
    border: none;
    font-weight: 600;
    color: var(--sienna-deep);
    font-size: 1rem;
    cursor: pointer;
    border-bottom: 2px solid var(--terracotta-light);
    padding-bottom: 4px;
    transition: 0.2s;
    font-family: inherit;
    text-decoration: none;
}

.see-more:hover {
    color: var(--espresso-dark);
    border-bottom-color: var(--espresso-dark);
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 3rem;
    background: white;
    border-radius: var(--border-radius);
    box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
    margin: 2rem 0;
}

.empty-state h3 {
    color: var(--espresso-dark);
    margin-bottom: 1rem;
}

.empty-state a {
    color: var(--terracotta);
    text-decoration: none;
    font-weight: 500;
}

.empty-state a:hover {
    text-decoration: underline;
}

/* Footer */
footer {
    background-color: var(--espresso-dark);
    color: var(--bg-light);
    padding: var(--spacing-lg) 0;
    margin-top: var(--spacing-lg);
}

.footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
}

.footer-section {
    flex: 1;
    min-width: 200px;
}

h3 {
    font-size: 1.3rem;
    margin-bottom: 1.2rem;
    color: var(--cream-warm);
    font-family: 'Cormorant Garamond', serif;
}

.footer-column p, .footer-column a {
    color: rgba(253, 247, 240, 0.8);
    margin-bottom: 0.6rem;
    display: block;
    text-decoration: none;
    transition: var(--transition);
    font-size: 0.9rem;
}

.footer-column a:hover {
    color: var(--cream-warm);
}

.social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
}

.social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(253, 247, 240, 0.1);
    color: var(--bg-light);
    transition: var(--transition);
}

.social-link:hover {
    background: var(--terracotta);
    transform: translateY(-3px);
}

.copyright {
    text-align: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(253, 247, 240, 0.1);
    color: rgba(253, 247, 240, 0.6);
    font-size: 0.85rem;
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .products-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1.8rem;
    }
    h1 {
        font-size: 3rem;
    }
}

@media (max-width: 992px) {
    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    h1 {
        font-size: 2.8rem;
    }
    .desktop-nav {
        gap: 1.8rem;
    }
}

@media (max-width: 768px) {
    .hamburger {
        display: block;
    }
    .desktop-nav {
        display: none;
    }
    section.hero {
        height: 80vh;
        margin-top: 70px;
        justify-content: center;
        text-align: center;
    }
    .hero-content {
        margin: 1rem;
        padding: 1.5rem;
    }
    h1 {
        font-size: 2.2rem;
    }
    p {
        font-size: 1rem;
    }
    .products-grid {
        grid-template-columns: 1fr;
        max-width: 380px;
        margin: 0 auto 2rem;
    }
    h2 {
        font-size: 2rem;
    }
    .container {
        padding: 0 1.2rem;
    }
    .footer-content {
        flex-direction: column;
        gap: 2rem;
    }
    .footer-section {
        min-width: 100%;
    }
}

@media (max-width: 576px) {
    h1 {
        font-size: 1.8rem;
    }
    a.cta-btn,
    .see-more {
        padding: 0.8rem 1.5rem;
        font-size: 0.9rem;
    }
}

/* Dynamic Section Styles */
{% generate_section_styles style_customizations 1 50 %}

/* Dynamic Background Images */
{% generate_background_images background_images 1 50 %}

{% generate_hover_keyframes %}
</style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce18/snippets/header1.html' %}

{% for component in components %}
{% if component.drop_zone == '1' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Hero Section -->
<section class="hero" id="section-13">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 id="section-14">{{ text_contents.11|default:"Care Beyond Companionship" }}</h1>
        <p id="section-15">{{ text_contents.12|default:"Premium essentials crafted for the comfort, health, and happiness of your pet." }}</p>
        <a href="?page=products" class="cta-btn" id="section-16">{{ text_contents.13|default:"Shop Pet Essentials" }}</a>
    </div>
</section>

{% for component in components %}
{% if component.drop_zone == '13' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- New Arrivals Section -->
<section class="new-arrivals" id="section-17">
    <div class="container">
        <div class="section-header">
            <h2 id="section-18">{{ text_contents.14|default:"New Arrivals" }}</h2>
            <p id="section-19">{{ text_contents.15|default:"Curated essentials for the discerning pet parent." }}</p>
        </div>
        {% if products %}
        <div class="products-grid">
            {% for product in products|slice:":4" %}
            <a href="/product/{{ product.slug }}/" class="product-image-link" style="text-decoration: none;">
                <div class="product-card" id="section-20">
                    {% if product.main_image %}
                    <img src="{{ product.main_image.url }}" alt="{{ product.title }}" class="product-img">
                    {% else %}
                    <div class="product-img" style="background-color: var(--cream-warm);"></div>
                    {% endif %}
                    <div class="product-info">
                        <div class="product-category" id="section-21">{{ product.category.name|default:"ACCESSORIES"|truncatewords:3 }}</div>
                        <div class="product-name" id="section-22">{{ product.title|truncatewords:3 }}</div>
                        <div class="product-price" id="section-23">{{ product.price|currency:page }}</div>
                    </div>
                </div>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <h3>No Products Yet</h3>
            <p>You haven't added any products to your collection yet. <a href="{{ SITE_DOMAIN }}/manage-products/{{ page.subdomain }}/">Add your first product</a> to get started.</p>
        </div>
        {% endif %}
        <a href="?page=products" class="see-more" id="section-24">{{ text_contents.19|default:"View All →" }}</a>
    </div>
</section>

{% for component in components %}
{% if component.drop_zone == '17' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce18/snippets/footer.html' %}

{% for component in components %}
{% if component.drop_zone == '25' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

{% for component in components %}
{% if component.drop_zone == 'end' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<script src="{% static 'builder/js/cart-manager.js' %}"></script>
</body>
</html>