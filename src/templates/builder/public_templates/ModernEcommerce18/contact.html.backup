{% endfor %}

<!-- FAQ Section (5 Editable Questions) -->
<div class="container">
    <div class="faq-section" id="section-421">
        <h2 id="section-422">{{ text_contents.748|default:"Frequently Asked Questions" }}</h2>
        <div class="faq-container">
            <!-- FAQ 1 -->
            <div class="faq-item" id="section-423">
                <button class="faq-question">
                    <span id="section-424">{{ text_contents.749|default:"What is your return policy?" }}</span>
                    <i class="fas fa-plus faq-icon" data-icon="604"></i>
                </button>
                <div class="faq-answer" id="section-425">
                    {{ text_contents.750|default:"We offer a 30-day return policy for all unused items in their original packaging. Custom items and personalized products are non-returnable. Returns are processed within 5-7 business days, and you will receive a full refund to your original payment method. For more details, please visit our Returns & Exchanges page." }}
                </div>
            </div>
            <!-- FAQ 2 -->
            <div class="faq-item" id="section-426">
                <button class="faq-question">
                    <span id="section-427">{{ text_contents.751|default:"How do I determine the right size for my pet?" }}</span>
                    <i class="fas fa-plus faq-icon" data-icon="604"></i>
                </button>
                <div class="faq-answer" id="section-428">
                    {{ text_contents.752|default:"We provide detailed sizing guides for each product category. For beds, measure your pet from nose to tail while lying down and add 4-6 inches. For collars and harnesses, measure around the neck and add two finger widths for comfort. Our customer service team is also available to help you select the perfect size for your companion." }}
                </div>
            </div>
            <!-- FAQ 3 -->
            <div class="faq-item" id="section-429">
                <button class="faq-question">
                    <span id="section-430">{{ text_contents.753|default:"Do you offer international shipping?" }}</span>
                    <i class="fas fa-plus faq-icon" data-icon="604"></i>
                </button>
                <div class="faq-answer" id="section-431">
                    {{ text_contents.754|default:"Yes, we ship to over 50 countries worldwide. International shipping rates and delivery times vary by destination. Please note that customs duties and taxes may apply and are the responsibility of the customer. For a complete list of countries we ship to and estimated delivery times, please visit our Shipping Information page." }}
                </div>
            </div>
            <!-- FAQ 4 -->
            <div class="faq-item" id="section-432">
                <button class="faq-question">
                    <span id="section-433">{{ text_contents.755|default:"How do I care for my PŌTA products?" }}</span>
                    <i class="fas fa-plus faq-icon" data-icon="604"></i>
                </button>
                <div class="faq-answer" id="section-434">
                    {{ text_contents.756|default:"Care instructions vary by product. Most beds feature removable, machine-washable covers. Grooming tools can be cleaned with mild soap and water. For leather accessories, we recommend using a leather conditioner to maintain softness and durability. Detailed care instructions are included with each product and available on our product pages." }}
                </div>
            </div>
            <!-- FAQ 5 -->
            <div class="faq-item" id="section-435">
                <button class="faq-question">
                    <span id="section-436">{{ text_contents.757|default:"Can I track my order?" }}</span>
                    <i class="fas fa-plus faq-icon" data-icon="604"></i>
                </button>
                <div class="faq-answer" id="section-437">
                    {{ text_contents.758|default:"Yes! Once your order ships, you'll receive a confirmation email with a tracking number. You can also track your order status by logging into your account and visiting the Orders section. If you have any questions about your shipment, our customer service team is happy to help." }}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Support Section -->
<div class="container">
    <div class="additional-support" id="section-438">
        <h2 id="section-439">{{ text_contents.759|default:"Additional Support" }}</h2>
        <div class="support-grid">
            <div class="support-item">
                <div class="support-icon">
