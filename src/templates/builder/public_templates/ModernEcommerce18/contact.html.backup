{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact Us | {{ page.brand_name }}</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
{% render_icon_data icon_customizations %}

<style>
:root {
    --cream-warm: #E3C2A3;
    --terracotta-light: #E1A16F;
    --terracotta: #D08650;
    --sienna-deep: #93523B;
    --espresso-dark: #662F17;
    --bg-light: #FDF7F0;
    --shadow-soft: rgba(102, 47, 23, 0.08);
    --shadow-hover: rgba(102, 47, 23, 0.15);
    --white-pure: #FFFFFF;
    --black-soft: #2E241F;
    --spacing-xl: 6rem;
    --spacing-lg: 4rem;
    --spacing-md: 2rem;
    --spacing-sm: 1rem;
    --border-radius: 12px;
    --transition: all 0.3s ease;
}

{% generate_color_variables %}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Montserrat', sans-serif;
    background-color: var(--bg-light);
    color: var(--espresso-dark);
    overflow-x: hidden;
    line-height: 1.6;
    padding-top: 100px;
}

h1, h2, h3, h4 {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

/* Page Header */
.page-header {
    text-align: center;
    padding: var(--spacing-lg) 0 var(--spacing-md);
    margin-bottom: var(--spacing-md);
}

.page-header h1 {
    font-size: 3rem;
    color: var(--espresso-dark);
    margin-bottom: 1rem;
    position: relative;
    display: inline-block;
}

.page-header h1::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 2px;
    background: linear-gradient(90deg, var(--terracotta), var(--sienna-deep));
}

.page-header p {
    color: var(--sienna-deep);
    font-size: 1rem;
    max-width: 700px;
    margin: 1rem auto 0;
    opacity: 0.8;
}

/* Contact Layout */
.contact-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
}

/* Contact Information */
.contact-info {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    box-shadow: 0 6px 12px var(--shadow-soft);
    height: fit-content;
}

.contact-info h2 {
    font-size: 1.5rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.contact-methods {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.contact-method {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
}

.contact-icon {
    width: 48px;
    height: 48px;
    background: rgba(209, 134, 80, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--terracotta);
    font-size: 1.2rem;
    flex-shrink: 0;
}

.contact-details h3 {
    font-size: 1rem;
    color: var(--espresso-dark);
    margin-bottom: 0.3rem;
    font-weight: 600;
}

.contact-details p {
    color: var(--sienna-deep);
    font-size: 0.85rem;
    line-height: 1.5;
}

.contact-details a {
    color: var(--terracotta);
    text-decoration: none;
    transition: var(--transition);
}

.contact-details a:hover {
    text-decoration: underline;
}

/* Business Hours - FULLY EDITABLE */
.business-hours {
    margin-top: var(--spacing-md);
    padding-top: var(--spacing-md);
    border-top: 1px solid rgba(102, 47, 23, 0.1);
}

.business-hours h3 {
    font-size: 1rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-sm);
    font-weight: 600;
}

.hours-list {
    list-style: none;
}

.hours-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(102, 47, 23, 0.05);
    font-size: 0.85rem;
}

.hours-list li:last-child {
    border-bottom: none;
}

.day {
    color: var(--espresso-dark);
    font-weight: 500;
}

.time {
    color: var(--sienna-deep);
}

/* Contact Form */
.contact-form-section {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-md);
    box-shadow: 0 6px 12px var(--shadow-soft);
}

.contact-form-section h2 {
    font-size: 1.5rem;
    color: var(--espresso-dark);
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid rgba(102, 47, 23, 0.1);
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
}

.form-group {
    margin-bottom: var(--spacing-sm);
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--espresso-dark);
    font-weight: 500;
    font-size: 0.85rem;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(102, 47, 23, 0.2);
    border-radius: var(--border-radius);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.85rem;
    transition: var(--transition);
    background: var(--white-pure);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--terracotta);
    box-shadow: 0 0 0 3px rgba(209, 134, 80, 0.1);
}

.form-group textarea {
    min-height: 120px;
    resize: vertical;
}

.submit-btn {
    background: linear-gradient(135deg, var(--terracotta), var(--sienna-deep));
    color: var(--white-pure);
    padding: 0.9rem 2rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 1px;
    border-radius: 3rem;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    margin-top: var(--spacing-sm);
    width: auto;
    align-self: flex-start;
    font-family: 'Montserrat', sans-serif;
}

.submit-btn:hover {
    background: var(--espresso-dark);
    transform: translateY(-2px);
}

/* Shop Locations Section - FULLY EDITABLE */
.shop-locations {
    margin-bottom: var(--spacing-xl);
}

.shop-locations h2 {
    font-size: 1.8rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.locations-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
}

.location-card {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    overflow: hidden;
    transition: var(--transition);
    box-shadow: 0 6px 12px var(--shadow-soft);
}

.location-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px var(--shadow-hover);
}

.location-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.4s ease;
    background-color: var(--cream-warm);
}

.location-card:hover .location-image {
    transform: scale(1.02);
}

.location-info {
    padding: 1.2rem;
    text-align: left;
}

.location-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--espresso-dark);
    margin-bottom: 0.5rem;
}

.location-address {
    color: var(--sienna-deep);
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 0.5rem;
}

.location-phone {
    color: var(--terracotta);
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
}

.location-hours {
    color: var(--sienna-deep);
    font-size: 0.75rem;
    font-style: italic;
}

/* FAQ Section - FULLY EDITABLE */
.faq-section {
    margin-bottom: var(--spacing-xl);
}

.faq-section h2 {
    font-size: 1.8rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.faq-container {
    max-width: 900px;
    margin: 0 auto;
}

.faq-item {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    margin-bottom: var(--spacing-sm);
    box-shadow: 0 4px 12px var(--shadow-soft);
    overflow: hidden;
    transition: var(--transition);
}

.faq-item:hover {
    box-shadow: 0 8px 20px var(--shadow-hover);
}

.faq-question {
    padding: 1.2rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    background: var(--white-pure);
    border: none;
    width: 100%;
    text-align: left;
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--espresso-dark);
    transition: var(--transition);
}

.faq-question:hover {
    background: rgba(227, 194, 163, 0.1);
}

.faq-question.active {
    color: var(--terracotta);
}

.faq-icon {
    color: var(--terracotta);
    font-size: 1rem;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    margin-left: var(--spacing-sm);
}

.faq-question.active .faq-icon {
    transform: rotate(45deg);
}

.faq-answer {
    padding: 0 1.5rem;
    max-height: 0;
    overflow: hidden;
    transition: all 0.3s ease;
    color: var(--sienna-deep);
    line-height: 1.7;
    font-size: 0.9rem;
}

.faq-answer.active {
    padding: 0 1.5rem 1.2rem;
    max-height: 500px;
}

/* Additional Support - FULLY EDITABLE */
.additional-support {
    background: var(--white-pure);
    border-radius: var(--border-radius);
    padding: var(--spacing-lg);
    box-shadow: 0 6px 12px var(--shadow-soft);
    margin-bottom: var(--spacing-xl);
}

.additional-support h2 {
    font-size: 1.5rem;
    text-align: center;
    margin-bottom: var(--spacing-lg);
    color: var(--espresso-dark);
}

.support-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-md);
}

.support-item {
    text-align: center;
    padding: var(--spacing-md);
}

.support-icon {
    font-size: 2rem;
    color: var(--terracotta);
    margin-bottom: var(--spacing-sm);
}

.support-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem;
    color: var(--espresso-dark);
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.support-description {
    color: var(--sienna-deep);
    font-size: 0.85rem;
    line-height: 1.5;
}

/* Responsive Styles */
@media (max-width: 1200px) {
    .locations-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 992px) {
    .contact-layout {
        grid-template-columns: 1fr;
    }
    .support-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .locations-grid {
        gap: 1.5rem;
    }
}

@media (max-width: 768px) {
    body {
        padding-top: 80px;
    }
    .form-row {
        grid-template-columns: 1fr;
    }
    .support-grid {
        grid-template-columns: 1fr;
        max-width: 320px;
        margin: 0 auto;
    }
    .locations-grid {
        grid-template-columns: 1fr;
        max-width: 320px;
        margin-left: auto;
        margin-right: auto;
    }
    .submit-btn {
        width: 100%;
    }
    .page-header h1 {
        font-size: 2rem;
    }
    .faq-question {
        font-size: 0.9rem;
        padding: 1rem;
    }
    .contact-method {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.8rem;
    }
}

@media (max-width: 576px) {
    .container {
        padding: 0 1.2rem;
    }
    .contact-info,
    .contact-form-section {
        padding: var(--spacing-sm);
    }
}

/* Dynamic Section Styles */
{% generate_section_styles style_customizations 372 440 %}

/* Dynamic Background Images */
{% generate_background_images background_images 372 440 %}

{% generate_hover_keyframes %}
</style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce18/snippets/header1.html' %}



<!-- Page Header -->
<div class="page-header" id="section-372">
    <div class="container">
        <h1 id="section-373">{{ text_contents.700|default:"Contact Us" }}</h1>
        <p id="section-374">{{ text_contents.701|default:"We'd love to hear from you. Reach out with any questions about our products, orders, or custom requests." }}</p>
    </div>
</div>

{% for component in components %}
{% if component.drop_zone == '372' %}
<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
    {{ component.html_content|safe }}
</section>
{% endif %}
{% endfor %}

<!-- Contact Layout -->
<div class="container">
    <div class="contact-layout">
        <!-- Contact Information -->
        <div class="contact-info" id="section-375">
            <h2 id="section-376">{{ text_contents.702|default:"Get In Touch" }}</h2>
            <div class="contact-methods">
                <div class="contact-method">
                    <div class="contact-icon">
                        <i class="fas fa-map-marker-alt" data-icon="600"></i>
                    </div>
                    <div class="contact-details">
                        <h3 id="section-377">{{ text_contents.703|default:"Visit Our Boutique" }}</h3>
                        <p id="section-378">{{ text_contents.704|default:"123 Luxury Avenue<br>New York, NY 10001<br>United States"|safe }}</p>
                    </div>
                </div>
                <div class="contact-method">
                    <div class="contact-icon">
                        <i class="fas fa-phone" data-icon="601"></i>
                    </div>
                    <div class="contact-details">
                        <h3 id="section-379">{{ text_contents.705|default:"Call Us" }}</h3>
                        <p id="section-380">{{ text_contents.706|default:"<a href='tel:+15551234567'>+1 (555) 123-4567</a><br>Monday - Friday: 9AM - 6PM EST<br>Saturday: 10AM - 4PM EST"|safe }}</p>
                    </div>
                </div>
                <div class="contact-method">
                    <div class="contact-icon">
                        <i class="fas fa-envelope" data-icon="602"></i>
                    </div>
                    <div class="contact-details">
                        <h3 id="section-381">{{ text_contents.707|default:"Email Us" }}</h3>
                        <p id="section-382">{{ text_contents.708|default:"<a href='mailto:hello@pota.com'>hello@pota.com</a><br>General Inquiries<br><a href='mailto:support@pota.com'>support@pota.com</a><br>Customer Support"|safe }}</p>
                    </div>
                </div>
            </div>
            <!-- Business Hours - FULLY EDITABLE -->
            <div class="business-hours">
                <h3 id="section-383">{{ text_contents.709|default:"Business Hours" }}</h3>
                <ul class="hours-list">
                    <li>
                        <span class="day" id="section-384">{{ text_contents.710|default:"Monday - Friday" }}</span>
                        <span class="time" id="section-385">{{ text_contents.711|default:"9:00 AM - 6:00 PM" }}</span>
                    </li>
                    <li>
                        <span class="day" id="section-386">{{ text_contents.712|default:"Saturday" }}</span>
                        <span class="time" id="section-387">{{ text_contents.713|default:"10:00 AM - 4:00 PM" }}</span>
                    </li>
                    <li>
                        <span class="day" id="section-388">{{ text_contents.714|default:"Sunday" }}</span>
                        <span class="time" id="section-389">{{ text_contents.715|default:"Closed" }}</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form-section" id="section-390">
            <h2 id="section-391">{{ text_contents.716|default:"Send Us a Message" }}</h2>
            <form class="contact-form" id="contactForm" method="POST" >
                {% csrf_token %}
                <input type="hidden" name="form_name" value="contact_form">
                <div class="form-row">
                    <div class="form-group">
                        <label id="section-392">{{ text_contents.717|default:"First Name" }} *</label>
                        <input type="text" id="firstName" name="first_name" required>
                    </div>
                    <div class="form-group">
                        <label id="section-393">{{ text_contents.718|default:"Last Name" }} *</label>
                        <input type="text" id="lastName" name="last_name" required>
                    </div>
                </div>
                <div class="form-group">
                    <label id="section-394">{{ text_contents.719|default:"Email Address" }} *</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label id="section-395">{{ text_contents.720|default:"Phone Number" }}</label>
                    <input type="tel" id="phone" name="phone">
                </div>
                <div class="form-group">
                    <label id="section-396">{{ text_contents.721|default:"Subject" }} *</label>
                    <select id="subject" name="subject" required>
                        <option value="">{{ text_contents.722|default:"Select a subject" }}</option>
                        <option value="general">{{ text_contents.723|default:"General Inquiry" }}</option>
                        <option value="order">{{ text_contents.724|default:"Order Status" }}</option>
                        <option value="custom">{{ text_contents.725|default:"Custom Design Request" }}</option>
                        <option value="repair">{{ text_contents.726|default:"Product Care & Repair" }}</option>
                        <option value="wholesale">{{ text_contents.727|default:"Wholesale Inquiry" }}</option>
                        <option value="other">{{ text_contents.728|default:"Other" }}</option>
                    </select>
                </div>
                <div class="form-group">
                    <label id="section-397">{{ text_contents.729|default:"Your Message" }} *</label>
                    <textarea id="message" name="message" rows="4" required></textarea>
                </div>
                <button type="submit" class="submit-btn" id="section-398">
                    {{ text_contents.730|default:"Send Message" }}
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Shop Locations Section (4 Editable Locations) -->
<div class="container">
    <div class="shop-locations" id="section-399">
        <h2 id="section-400">{{ text_contents.731|default:"Our Boutique Locations" }}</h2>
        <div class="locations-grid">
            <!-- Location 1 -->
            <div class="location-card" id="section-401">
                <img src="{% if image_customizations.600 %}{{ image_customizations.600.image_url }}{% else %}https://images.pexels.com/photos/1484852/pexels-photo-1484852.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop{% endif %}" alt="New York Boutique" class="location-image">
                <div class="location-info">
                    <div class="location-name" id="section-402">{{ text_contents.732|default:"New York - Fifth Avenue" }}</div>
                    <div class="location-address" id="section-403">{{ text_contents.733|default:"123 Fifth Avenue, New York, NY 10001" }}</div>
                    <div class="location-phone" id="section-404">{{ text_contents.734|default:"+1 (212) 555-0123" }}</div>
                    <div class="location-hours" id="section-405">{{ text_contents.735|default:"Mon-Sat: 10AM-7PM | Sun: 12PM-5PM" }}</div>
                </div>
            </div>
            <!-- Location 2 -->
            <div class="location-card" id="section-406">
                <img src="{% if image_customizations.601 %}{{ image_customizations.601.image_url }}{% else %}https://images.pexels.com/photos/1251202/pexels-photo-1251202.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop{% endif %}" alt="Los Angeles Boutique" class="location-image">
                <div class="location-info">
                    <div class="location-name" id="section-407">{{ text_contents.736|default:"Los Angeles - Beverly Hills" }}</div>
                    <div class="location-address" id="section-408">{{ text_contents.737|default:"456 Rodeo Drive, Beverly Hills, CA 90210" }}</div>
                    <div class="location-phone" id="section-409">{{ text_contents.738|default:"+1 (310) 555-0456" }}</div>
                    <div class="location-hours" id="section-410">{{ text_contents.739|default:"Mon-Sat: 10AM-8PM | Sun: 11AM-6PM" }}</div>
                </div>
            </div>
            <!-- Location 3 -->
            <div class="location-card" id="section-411">
                <img src="{% if image_customizations.602 %}{{ image_customizations.602.image_url }}{% else %}https://images.pexels.com/photos/1080696/pexels-photo-1080696.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop{% endif %}" alt="London Boutique" class="location-image">
                <div class="location-info">
                    <div class="location-name" id="section-412">{{ text_contents.740|default:"London - Mayfair" }}</div>
                    <div class="location-address" id="section-413">{{ text_contents.741|default:"78-80 Regent Street, Mayfair, London W1B 5RS" }}</div>
                    <div class="location-phone" id="section-414">{{ text_contents.742|default:"+44 20 7123 4567" }}</div>
                    <div class="location-hours" id="section-415">{{ text_contents.743|default:"Mon-Sat: 10AM-6PM | Sun: 12PM-5PM" }}</div>
                </div>
            </div>
            <!-- Location 4 -->
            <div class="location-card" id="section-416">
                <img src="{% if image_customizations.603 %}{{ image_customizations.603.image_url }}{% else %}https://images.pexels.com/photos/1449773/pexels-photo-1449773.jpeg?auto=compress&cs=tinysrgb&w=600&h=450&fit=crop{% endif %}" alt="Tokyo Boutique" class="location-image">
                <div class="location-info">
                    <div class="location-name" id="section-417">{{ text_contents.744|default:"Tokyo - Ginza" }}</div>
                    <div class="location-address" id="section-418">{{ text_contents.745|default:"6-9-5 Ginza, Chuo City, Tokyo 104-0061" }}</div>
                    <div class="location-phone" id="section-419">{{ text_contents.746|default:"+81 3-1234-5678" }}</div>
                    <div class="location-hours" id="section-420">{{ text_contents.747|default:"Daily: 11AM-8PM" }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

