                <div class="support-icon">
                    <i class="fas fa-user-cog" data-icon="607"></i>
                </div>
                <div class="support-title" id="section-444">{{ text_contents.764|default:"Account Support" }}</div>
                <div class="support-description" id="section-445">{{ text_contents.765|default:"Help with account management, order history, password resets, and privacy settings." }}</div>
            </div>
        </div>
    </div>
</div>

{% for component in components %}
{% if component.drop_zone == '438' %}
