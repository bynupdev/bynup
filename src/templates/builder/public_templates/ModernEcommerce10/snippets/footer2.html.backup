{% load static %}
{% load style_filters %}
{% load icon_filters %}
{% render_icon_data icon_customizations %}
<style>
    /* Header / Navigation Styles */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: var(--cream);
            backdrop-filter: blur(10px);
            z-index: 1000;
            padding: 15px 0;
            border-bottom: 1px solid var(--text-dark);
            transition: var(--transition);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 600;
            color: var(--deep-blue);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo a {
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo i {
            font-size: 24px;
        }

        .nav-desktop {
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-dark);
            font-weight: 500;
            font-size: 16px;
            transition: var(--transition);
            position: relative;
        }

        .nav-links a:hover {
            color: var(--deep-blue);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background-color: var(--deep-blue);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .icon-btn {
            color: var(--text-dark);
            font-size: 18px;
            transition: var(--transition);
            position: relative;
            text-decoration: none;
        }

        .icon-btn:hover {
            color: var(--deep-blue);
        }

        .badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: var(--deep-blue);
            color: white;
            font-size: 10px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .sign-in-btn {
            padding: 10px 24px;
            background-color: var(--deep-blue);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            font-size: 14px;
            transition: var(--transition);
        }

        .sign-in-btn:hover {
            background-color: var(--medium-blue);
            transform: translateY(-2px);
        }

        .account-dropdown {
            position: relative;
        }

        .dropdown-content {
            position: absolute;
            top: 30px;
            right: 0;
            background-color: white;
            min-width: 180px;
            box-shadow: 0 8px 25px var(--shadow);
            border-radius: 8px;
            padding: 10px 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: var(--transition);
            z-index: 10;
        }

        .account-dropdown:hover .dropdown-content {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-content a {
            display: block;
            padding: 12px 20px;
            text-decoration: none;
            color: var(--text-dark);
            font-size: 14px;
            transition: var(--transition);
        }

        .dropdown-content a:hover {
            background-color: rgba(146, 188, 250, 0.1);
            color: var(--deep-blue);
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            color: var(--text-dark);
            cursor: pointer;
        }

         /* Footer */
        footer {
            background-color: var(--deep-blue);
            color: white;
            padding: 60px 0 30px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-section h3 {
            font-size: 20px;
            margin-bottom: 25px;
            color: white;
        }

        .footer-section ul {
            list-style: none;
        }

        .footer-section a {
            display: block;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            margin-bottom: 15px;
            transition: var(--transition);
        }

        .footer-section a:hover {
            color: white;
            transform: translateX(5px);
        }

        .footer-section i {
            margin-right: 10px;
        }

        .footer-bottom {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.8);
            font-size: 14px;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            background-color: var(--cream);
            border-radius: 12px;
            margin: 40px 0;
        }

        .empty-state i {
            font-size: 48px;
            color: var(--medium-blue);
            margin-bottom: 20px;
        }

        .empty-state h3 {
            font-size: 24px;
            margin-bottom: 15px;
            color: var(--text-dark);
        }

        .empty-state p {
            color: var(--text-light);
            margin-bottom: 25px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Mobile Navigation */
        .mobile-nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--cream);
            z-index: 999;
            padding: 100px 40px 40px;
            transform: translateX(-100%);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

        .mobile-nav.active {
            transform: translateX(0);
        }

        .mobile-nav a {
            padding: 18px 0;
            font-size: 20px;
            text-decoration: none;
            color: var(--text-dark);
            border-bottom: 1px solid rgba(146, 188, 250, 0.2);
            transition: var(--transition);
        }

        .mobile-nav a:hover {
            color: var(--deep-blue);
            padding-left: 10px;
        }

        .mobile-close {
            position: absolute;
            top: 30px;
            right: 30px;
            font-size: 28px;
            color: var(--text-dark);
            cursor: pointer;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .hero h1 {
                font-size: 48px;
            }
        }

        @media (max-width: 992px) {
            .hero-container {
                flex-direction: column;
                gap: 40px;
            }
            
            .hero-content {
                padding-left: 0;
                text-align: center;
            }
            
            .hero h1 {
                font-size: 42px;
            }
            
            .hero p {
                margin: 0 auto 40px;
            }
            
            .footer-content {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .nav-desktop {
                display: none;
            }
            
            .mobile-menu-btn {
                display: block;
            }
        }

        @media (max-width: 768px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }
            
            .hero h1 {
                font-size: 36px;
            }
            
            .hero-image-container {
                height: 400px;
            }
            
            .section-header h2 {
                font-size: 36px;
            }
            
            section {
                padding: 60px 0;
            }
        }

        @media (max-width: 576px) {
            .products-grid {
                grid-template-columns: 1fr;
            }
            
            .hero h1 {
                font-size: 32px;
            }
            
            .hero p {
                font-size: 16px;
            }
            
            .cta-btn {
                padding: 15px 30px;
                font-size: 15px;
            }
            
            .footer-content {
                grid-template-columns: 1fr;
            }
            
            .header-actions .sign-in-btn {
                display: none;
            }
        }
        section{
            padding-left: 10px !important;
            padding-right: 10px !important;
        }
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 54 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 1 54 %}

</style>


