{% load style_filters %}
{% load static %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        /* Inherit all base styles */
        :root {
            --cream: #fdf0ec;
            --light-blue: #aee1f9;
            --medium-blue: #bde3fb;
            --deep-blue: #92bcfa;
            --text-dark: #333333;
            --text-light: #666666;
            --shadow: rgba(146, 188, 250, 0.1);
            --transition: all 0.3s ease;
        }

        {% generate_color_variables %}

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            background-color: var(--cream);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4 {
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            line-height: 1.2;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            /* padding: 0 20px; */
        }

        section {
            padding: 80px 0;
        }

        /* Cart Header */
        .cart-header {
            padding-top: 150px;
            padding-bottom: 60px;
            background: linear-gradient(to right, var(--cream) 0%, rgba(253, 240, 236, 0.9) 100%);
        }

        .cart-header-content {
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .cart-header h1 {
            font-size: 48px;
            margin-bottom: 20px;
            color: var(--text-dark);
        }

        .cart-header p {
            font-size: 18px;
            color: var(--text-light);
            margin-bottom: 30px;
        }

        /* Cart Section */
        .cart-section {
            background-color: var(--nav-text, white);
            padding: 60px 0 100px;
        }

        .cart-container {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
        }

        /* Cart Items */
        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .cart-item {
            display: grid;
            grid-template-columns: 120px 1fr auto;
            gap: 25px;
            padding: 25px;
            background-color: var(--nav-text, white);
            border-radius: 12px;
            box-shadow: 0 5px 20px var(--shadow);
            border: 1px solid rgba(146, 188, 250, 0.2);
            transition: var(--transition);
        }

        .cart-item:hover {
            box-shadow: 0 10px 30px rgba(146, 188, 250, 0.2);
            transform: translateY(-5px);
        }

        .cart-item-image {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 8px;
        }

        .cart-item-details {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .cart-item-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .cart-item-category {
            font-size: 14px;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .cart-item-variant {
            font-size: 14px;
            color: var(--text-light);
            margin-bottom: 15px;
        }

        .cart-item-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        .quantity-control {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: var(--cream);
            border-radius: 8px;
            padding: 5px;
        }

        .quantity-btn {
            width: 32px;
            height: 32px;
            background-color: var(--nav-text, white);
            border: 1px solid var(--medium-blue);
            border-radius: 6px;
            color: var(--deep-blue);
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quantity-btn:hover {
            background-color: var(--light-blue);
        }

        .quantity-input {
            width: 50px;
            text-align: center;
            border: none;
            background: transparent;
            font-weight: 600;
            font-size: 16px;
            color: var(--text-dark);
        }

        .quantity-input:focus {
            outline: none;
        }

        .remove-btn {
            background: none;
            border: none;
            color: var(--text-light);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 14px;
        }

        .remove-btn:hover {
            color: #ff4444;
        }

        .cart-item-price {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: space-between;
        }

        .item-total {
            font-size: 22px;
            font-weight: 600;
            color: var(--deep-blue);
        }

        .item-unit-price {
            font-size: 14px;
            color: var(--text-light);
        }

        /* Cart Summary */
        .cart-summary {
            background-color: var(--cream);
            padding: 30px;
            border-radius: 12px;
            height: fit-content;
            position: sticky;
            top: 100px;
            box-shadow: 0 5px 20px var(--shadow);
        }

        .summary-title {
            font-size: 24px;
            margin-bottom: 25px;
            color: var(--text-dark);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 15px 0;
            border-bottom: 1px solid rgba(146, 188, 250, 0.2);
        }

        .summary-row:last-child {
            border-bottom: none;
        }

        .summary-label {
            color: var(--text-dark);
        }

        .summary-value {
            font-weight: 600;
            color: var(--text-dark);
        }

        .summary-total {
            font-size: 22px;
            color: var(--deep-blue);
            font-weight: 700;
        }

        .checkout-btn {
            width: 100%;
            background-color: var(--deep-blue);
            color: var(--nav-text, white);
            border: none;
            padding: 18px 30px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 16px;
            margin-top: 25px;
        }

        .checkout-btn:hover {
            background-color: var(--medium-blue);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(146, 188, 250, 0.3);
        }

        .continue-shopping {
            display: block;
            text-align: center;
            color: var(--deep-blue);
            text-decoration: none;
            margin-top: 20px;
            font-weight: 500;
            transition: var(--transition);
        }

        .continue-shopping:hover {
            color: var(--medium-blue);
            text-decoration: underline;
        }

        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: 80px 20px;
            background-color: var(--nav-text, white);
            border-radius: 12px;
            margin: 40px 0;
            grid-column: 1 / -1;
        }

        .empty-cart i {
            font-size: 64px;
            color: var(--medium-blue);
            margin-bottom: 30px;
        }

        .empty-cart h3 {
            font-size: 28px;
            margin-bottom: 20px;
            color: var(--text-dark);
        }

        .empty-cart p {
            color: var(--text-light);
            margin-bottom: 30px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
            font-size: 18px;
        }

        /* Related Products Section */
        .related-products {
            background-color: var(--light-blue);
            padding: 100px 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 36px;
            color: var(--text-dark);
            margin-bottom: 15px;
        }

        .section-header p {
            font-size: 18px;
            color: var(--text-light);
            max-width: 600px;
            margin: 0 auto;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .product-card {
            background-color: var(--nav-text, white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px var(--shadow);
            transition: var(--transition);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(146, 188, 250, 0.2);
        }

        .product-image-container {
            position: relative;
            overflow: hidden;
            height: 250px;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }

        .product-card:hover .product-image {
            transform: scale(1.05);
        }

        .product-info {
            padding: 20px;
        }

        .product-info h3 {
            font-size: 18px;
            margin-bottom: 8px;
            color: var(--text-dark);
        }

        .product-price {
            font-size: 20px;
            font-weight: 600;
            color: var(--deep-blue);
            margin-bottom: 15px;
        }

        .product-actions {
            display: flex;
            gap: 10px;
        }

        .btn-small {
            flex: 1;
            background-color: var(--deep-blue);
            color: var(--nav-text, white);
            border: none;
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 14px;
        }

        .btn-small:hover {
            background-color: var(--medium-blue);
        }

        .wishlist-small {
            width: 40px;
            background-color: var(--cream);
            border: 1px solid var(--medium-blue);
            border-radius: 8px;
            color: var(--deep-blue);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .wishlist-small:hover {
            background-color: var(--light-blue);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .cart-header h1 {
                font-size: 42px;
            }
        }

        @media (max-width: 992px) {
            .cart-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .cart-summary {
                position: static;
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .cart-header h1 {
                font-size: 36px;
            }
        }

        @media (max-width: 768px) {
            .cart-header {
                padding-top: 120px;
            }
            
            .cart-item {
                grid-template-columns: 1fr;
                text-align: center;
            }
            
            .cart-item-image {
                width: 100%;
                height: 200px;
            }
            
            .cart-item-price {
                align-items: center;
            }
            
            .section-header h2 {
                font-size: 28px;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            
            .cart-header h1 {
                font-size: 32px;
            }
        }

        @media (max-width: 576px) {
            .cart-item-actions {
                flex-direction: column;
                align-items: center;
            }
            
            .remove-btn {
                margin-top: 10px;
            }
            
            .product-actions {
                flex-direction: column;
            }
            
            .wishlist-small {
                width: 100%;
                height: 40px;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 120 149 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 120 149 %}

        /* Generate keyframes for animations */
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
    {%include 'builder/public_templates/ModernEcommerce10/snippets/header1.html'%}
    <!-- Include Header -->


    <!-- Cart Header -->
    <section class="cart-header" id="section-120">
        <div class="container">
            <div class="cart-header-content">
                <h1 id="section-121">{{ text_contents.93|default:"Your Shopping Cart" }}</h1>
                <p id="section-122">{{ text_contents.94|default:"Review your selected items before proceeding to checkout" }}</p>
            </div>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '120' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Cart Section -->
    <section class="cart-section" id="section-123">
        <div class="container">
            {% if cart and cart.items.all %}
            <div class="cart-container">
                <!-- Cart Items -->
                <div class="cart-items">
                    {% for item in cart.items.all %}
                    <!-- Cart Item Template -->
                    <div class="cart-item" 
                         id="section-124" 
                         data-cart-item-id="{{ item.id }}"
                         data-product-id="{{ item.product.id }}"
                         data-unit-price="{{ item.product.price }}"
                         data-cj-vid="{% if item.product.variants.first.cj_vid %}{{ item.product.variants.first.cj_vid }}{% endif %}">
                        
                        <!-- Hidden fields for checkout data -->
                        <input type="hidden" class="product-id" value="{{ item.product.id }}">
                        <input type="hidden" class="cj-vid" value="{% if item.product.variants.first.cj_vid %}{{ item.product.variants.first.cj_vid }}{% else %}{% endif %}">
                        
                        <!-- Product Image -->
                        {% if item.product.main_image %}
                        <img src="{{ item.product.main_image.url }}" 
                             alt="{{ item.product.title }}" 
                             class="cart-item-image">
                        {% else %}
                        <div class="cart-item-image" style="background-color: var(--medium-blue); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-image" data-icon="47" style="font-size: 24px; color: var(--nav-text, white);"></i>
                        </div>
                        {% endif %}
                        
                        <div class="cart-item-details">
                            <div>
                                <h3 class="cart-item-title product-title" id="section-125">
                                    <a href="/product/{{ item.product.slug }}/">
                                        {{ item.product.title|truncatechars:40 }}
                                    </a>
                                </h3>
                                <div class="cart-item-category" id="section-126">
                                    {% if item.product.category %}
                                    {{ item.product.category.name }}
                                    {% else %}
                                    {{ text_contents.96|default:"Uncategorized" }}
                                    {% endif %}
                                </div>
                                {% if item.selected_color or item.selected_size %}
                                <div class="cart-item-variant" id="section-127">
                                    <span class="product-color">
                                        {% if item.selected_color %}Color: {{ item.selected_color }}{% endif %}
                                    </span>
                                    <span class="product-size">
                                        {% if item.selected_size %}{% if item.selected_color %} | {% endif %}Size: {{ item.selected_size }}{% endif %}
                                    </span>
                                </div>
                                {% endif %}
                                <div class="product-description" style="display: none;">
                                    {{ item.product.short_description|default:item.product.description|truncatechars:100 }}
                                </div>
                            </div>
                            
                            <div class="cart-item-actions">
                                <div class="quantity-control">
                                    <button class="quantity-btn decrement-cart" data-product-id="{{ item.product.id }}">
                                        <i class="fas fa-minus" data-icon="41"></i>
                                    </button>
                                    <input type="text" class="quantity-input" value="{{ item.quantity }}" readonly data-product-id="{{ item.product.id }}">
                                    <button class="quantity-btn increment-cart" data-product-id="{{ item.product.id }}">
                                        <i class="fas fa-plus" data-icon="42"></i>
                                    </button>
                                </div>
                                <button class="remove-btn remove-cart-item" data-product-id="{{ item.product.id }}">
                                    <i class="fas fa-trash" data-icon="43"></i>
                                    <span id="section-128">
                                        {{ text_contents.98|default:"Remove" }}
                                    </span>
                                </button>
                            </div>
                        </div>
                        
                        <div class="cart-item-price">
                            <div class="item-total" 
                                 id="section-129" 
                                 data-item-id="{{ item.product.id }}"
                                 data-calculated-total="{{ item.product.price|floatformat:2 }}">
                                {{page.currency_symbol}}<span class="product-total">{{ item.get_total_price|floatformat:2 }}</span>
                            </div>
                            <div class="item-unit-price product-price" id="section-130">
                                {{ item.product.price|currency:page }} each
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                
                <!-- Cart Summary -->
                <div class="cart-summary" id="section-131">
                    <h3 class="summary-title" id="section-132">{{ text_contents.101|default:"Order Summary" }}</h3>
                    
                    <div class="summary-row">
                        <span class="summary-label" id="section-133">{{ text_contents.102|default:"Subtotal" }}</span>
                        <span class="summary-value" id="cart-subtotal">
                            {{ cart.get_subtotal|currency:page }}
                        </span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label" id="section-135">{{ text_contents.104|default:"Shipping" }}</span>
                        <span  style="display: none;" class="summary-value" id="cart-shipping">
                            {% if cart.get_subtotal >= 50 or cart.items.count == 0 %}
                            {{page.currency_symbol}}0.00
                            {% else %}
                            {{page.currency_symbol}}5.00
                            {% endif %}
                        </span>
                        <span class="summary-value" >{% if has_shipping_config %} <small>Calculated at Checkout</small> {% else %}Free{% endif %}</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label" id="section-137">{{ text_contents.106|default:"Tax" }}</span>
                        <span style="display: none;" class="summary-value" id="cart-tax">
                            {{ cart.get_tax_amount|currency:page  }}
                        </span>
                        <span class="summary-value">---</span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label" id="section-139">{{ text_contents.108|default:"Total" }}</span>
                        <span class="summary-value summary-total" id="cart-total">
                            {{ cart.get_total_amount|currency:page }}
                        </span>
                    </div>
                    
                    <button class="checkout-btn" id="section-141" onclick="redirectCartToPaymentSelection()">
                        <i class="fas fa-lock" data-icon="44"></i> {{ text_contents.110|default:"Proceed to Checkout" }}
                    </button>
                    
                    <a href="?page=products" class="continue-shopping" id="section-142">
                        <i class="fas fa-arrow-left"></i> {{ text_contents.111|default:"Continue Shopping" }}
                    </a>
                </div>
            </div>
            {% else %}
            <!-- Empty Cart State -->
            <div class="empty-cart">
                <i class="fas fa-shopping-cart" data-icon="48"></i>
                <h3>{{ text_contents.109|default:"Your Cart is Empty" }}</h3>
                <p>{{ text_contents.110|default:"Add some items to your cart and they'll appear here." }}</p>
                <a href="?page=products" class="checkout-btn" style="display: inline-block; width: auto; padding: 15px 40px;">
                    <i class="fas fa-store" data-icon="49"></i> {{ text_contents.111|default:"Continue Shopping" }}
                </a>
            </div>
            {% endif %}
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '123' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Hidden field for page subdomain (needed for checkout redirect) -->
    <input type="hidden" id="page-subdomain" value="{{ page.subdomain }}">

    <!-- Related Products Section (same as before) -->
    <section class="related-products" id="section-143">
        <div class="container">
            <div class="section-header">
                <h2 id="section-144">{{ text_contents.112|default:"You May Also Like" }}</h2>
                <p id="section-145">{{ text_contents.113|default:"Complete your collection with these items" }}</p>
            </div>
            
            <div class="products-grid">
                {% if products %}
                    {% for product in products|slice:":4" %}
                    <!-- Related Product Template -->
                    <div class="product-card" 
                         id="section-146"
                         data-product-id="{{ product.id }}"
                         data-product-title="{{ product.title }}"
                         data-product-price="{{ product.price }}"
                         data-product-image="{% if product.main_image %}{{ product.main_image.url }}{% endif %}">
                        
                        <div class="product-image-container">
                            <a href="/product/{{ product.slug }}/" class="product-image-link">
                                {% if product.main_image %}
                                <img src="{{ product.main_image.url }}" 
                                     alt="{{ product.title }}" 
                                     class="product-image">
                                {% else %}
                                <div class="product-image" style="background-color: var(--light-blue); display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-image" data-icon="50" style="font-size: 32px; color: var(--nav-text, white);"></i>
                                </div>
                                {% endif %}
                            </a>
                        </div>
                        
                        <div class="product-info">
                            <h3 id="section-147">
                                <a href="/product/{{ product.slug }}/">
                                    {{ product.title|truncatechars:30 }}
                                </a>
                            </h3>
                            <div class="product-price" id="section-148">
                                {{ product.price|currency:page }}
                                {% if product.compare_at_price and product.compare_at_price > product.price %}
                                <span style="font-size: 14px; color: var(--text-light); text-decoration: line-through; margin-left: 8px;">
                                    {{ product.compare_at_price|currency:page }}
                                </span>
                                {% endif %}
                            </div>
                            <div class="product-actions">
                                <button class="btn-small add-to-cart-btn" 
                                        id="section-149" 
                                        data-add-to-cart="{{ product.id }}">
                                    <i class="fas fa-cart-plus" data-icon="45"></i> 
                                    {{ text_contents.116|default:"Add to Cart" }}
                                </button>
                                <button class="wishlist-small add-to-wishlist-btn" data-add-to-wishlist="{{ product.id }}">
                                    {% if product in wishlist_items %}
                                    <i class="fas fa-heart" data-icon="46"></i>
                                    {% else %}
                                    <i class="far fa-heart" data-icon="46"></i>
                                    {% endif %}
                                </button>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '143' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Include Footer -->
    {%include 'builder/public_templates/ModernEcommerce10/snippets/footer.html'%}

    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    <input type="hidden" value="{{page.currency_symbol}}" id="currency-symbol">

    <!-- Cart Manager Script -->
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>

    <!-- Cart Operations Script (from your documentation) -->
    <script src="{% static 'builder/js/cart-operations.js' %}"></script>

    {% render_icon_script %}

    <!-- Custom JavaScript for Cart Page -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Cart Manager if not already initialized
            if (!window.cartManager) {
                const subdomain = document.body.dataset.subdomain || 
                                (window.location.hostname.includes('localhost') ? 
                                 document.body.dataset.pageSubdomain : 
                                 window.location.hostname.split('.')[0]);
                
                window.cartManager = new CartManager(subdomain, {
                    autoDiscover: true,
                    autoCreateButtons: true
                });
            }

            // Function to update cart summary
            function updateCartSummary() {
                let subtotal = 0;
                document.querySelectorAll('.cart-item').forEach(item => {
                    const quantity = parseInt(item.querySelector('.quantity-input').value) || 0;
                    const unitPrice = parseFloat(item.getAttribute('data-unit-price')) || 0;
                    const itemTotal = quantity * unitPrice;
                    subtotal += itemTotal;
                    
                    // Update item total display
                    const itemTotalElement = item.querySelector('.product-total');
                    if (itemTotalElement) {
                        itemTotalElement.textContent = itemTotal.toFixed(2);
                    }
                });
                
                // Calculate shipping (free over $50)
                const shipping = 0;
                
                // Calculate tax (8%)
                const tax = 0;
                
                // Calculate total
                const total = subtotal + shipping + tax;
                const currencySymbol = document.getElementById('currency-symbol').value || '$';
                
                // Update summary display
                document.getElementById('cart-subtotal').textContent = `${currencySymbol}${subtotal.toFixed(2)}`;
                document.getElementById('cart-shipping').textContent = `${currencySymbol}${shipping.toFixed(2)}`;
                document.getElementById('cart-tax').textContent = `${currencySymbol}${tax.toFixed(2)}`;
                document.getElementById('cart-total').textContent = `${currencySymbol}${total.toFixed(2)}`;
                
                return {
                    subtotal: subtotal.toFixed(2),
                    shipping: shipping.toFixed(2),
                    tax: tax.toFixed(2),
                    total: total.toFixed(2)
                };
            }

            // Initialize cart summary on page load
            updateCartSummary();

            // Quantity controls using CartManager
            document.querySelectorAll('.increment-cart').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    if (window.cartManager && window.cartManager.incrementCartItem) {
                        window.cartManager.incrementCartItem(productId, 1);
                        
                        // Update local quantity display immediately for better UX
                        const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                        if (input) {
                            let currentValue = parseInt(input.value) || 0;
                            input.value = currentValue + 1;
                            updateCartSummary();
                        }
                    }
                });
            });

            document.querySelectorAll('.decrement-cart').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                    
                    if (input) {
                        let currentValue = parseInt(input.value) || 0;
                        if (currentValue > 1) {
                            if (window.cartManager && window.cartManager.decrementCartItem) {
                                window.cartManager.decrementCartItem(productId, 1);
                                
                                // Update local quantity display immediately
                                input.value = currentValue - 1;
                                updateCartSummary();
                            }
                        } else {
                            // If quantity would become 0, remove the item
                            if (window.cartManager && window.cartManager.removeFromCart) {
                                window.cartManager.removeFromCart(productId);
                            }
                        }
                    }
                });
            });

            // Remove item using CartManager
            document.querySelectorAll('.remove-cart-item').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    if (window.cartManager && window.cartManager.removeFromCart) {
                        window.cartManager.removeFromCart(productId);
                        
                        // Remove item from DOM immediately for better UX
                        const cartItem = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                        if (cartItem) {
                            cartItem.style.opacity = '0';
                            cartItem.style.transform = 'translateX(-20px)';
                            
                            setTimeout(() => {
                                if (cartItem.parentNode) {
                                    cartItem.remove();
                                    updateCartSummary();
                                    
                                    // Check if cart is empty
                                    if (document.querySelectorAll('.cart-item').length === 0) {
                                        showEmptyCartState();
                                    }
                                }
                            }, 300);
                        }
                    }
                });
            });

            // Add to cart from related products
            document.querySelectorAll('.add-to-cart-btn[data-add-to-cart]').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const productId = this.getAttribute('data-add-to-cart');
                    
                    if (window.cartManager && window.cartManager.addToCart) {
                        window.cartManager.addToCart(productId, 1);
                    }
                });
            });

            // Add to wishlist from related products
            document.querySelectorAll('.add-to-wishlist-btn[data-add-to-wishlist]').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const productId = this.getAttribute('data-add-to-wishlist');
                    const heartIcon = this.querySelector('i');
                    
                    if (window.cartManager && window.cartManager.addToWishlist) {
                        window.cartManager.addToWishlist(productId);
                        
                        // Update heart icon
                        if (heartIcon.classList.contains('far')) {
                            heartIcon.classList.remove('far');
                            heartIcon.classList.add('fas');
                            this.style.backgroundColor = 'var(--light-blue)';
                        }
                    }
                });
            });

            // Show empty cart state
            function showEmptyCartState() {
                const cartSection = document.querySelector('.cart-section .container');
                if (cartSection && !cartSection.querySelector('.empty-cart')) {
                    const emptyCartHTML = `
                        <div class="empty-cart">
                            <i class="fas fa-shopping-cart"></i>
                            <h3>{{ text_contents.109|default:"Your Cart is Empty" }}</h3>
                            <p>{{ text_contents.110|default:"Add some items to your cart and they'll appear here." }}</p>
                            <a href="?page=products" class="checkout-btn" style="display: inline-block; width: auto; padding: 15px 40px;">
                                <i class="fas fa-store"></i> {{ text_contents.111|default:"Continue Shopping" }}
                            </a>
                        </div>
                    `;
                    
                    cartSection.innerHTML = emptyCartHTML;
                }
            }

            // Check if cart is empty on load
            {% if not cart or not cart.items.all %}
                showEmptyCartState();
            {% endif %}

            // Cart item animation on scroll
            const cartItems = document.querySelectorAll('.cart-item');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, {
                threshold: 0.1
            });

            // Set initial state for animation
            cartItems.forEach(item => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                observer.observe(item);
            });

            // Related products animation
            const relatedProducts = document.querySelectorAll('.product-card');
            relatedProducts.forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                observer.observe(card);
            });
        });

        // GET CART DATA FUNCTION (from your documentation - cart-operations.js)
        function getCartData() {
            const items = [];
            let subtotal = 0;
            
            document.querySelectorAll('.cart-item').forEach(item => {
                const title = item.querySelector('.product-title')?.textContent || 'Product';
                const description = item.querySelector('.product-description')?.textContent || '';
                const currencySymbol = document.getElementById('currency-symbol').value || '$';
                const price = parseFloat(
                    item.querySelector('.product-price')?.textContent.replace(currencySymbol, '').replace(' each', '')
                ) || 0;
                const quantity = parseInt(
                    item.querySelector('.quantity-input')?.value
                ) || 1;
                const selected_color = item.querySelector('.product-color')?.textContent.replace('Color:', '').trim() || '';
                const selected_size = item.querySelector('.product-size')?.textContent.replace('Size:', '').trim() || '';
                const id = item.querySelector('.product-id')?.value || '';
                const cj_vid = item.querySelector('.cj-vid')?.value || '';
                const total = price * quantity;
                
                subtotal += total;
                
                items.push({
                    title: title,
                    description: description,
                    id: id,
                    cj_vid: cj_vid,
                    price: price,
                    quantity: quantity,
                    selected_color: selected_color,
                    selected_size: selected_size,
                    total_price: total
                });
            });
            
            // Calculate shipping and tax
            const shipping = 0;
            const tax = 0;
            const total = subtotal + shipping + tax;
            
            // Variant data from backend (if needed)
            const variants = window.VARIANTS || [];
            
            // Resolve CJ VID for each item (from your documentation)
            items.forEach(item => {
                if (item.selected_color || item.selected_size) {
                    const merged = `${item.selected_color}-${item.selected_size}`.toLowerCase();
                    const mergedParts = merged.split('-');
                    const partCount = mergedParts.length;
                    const productVariants = variants.filter(
                        v => String(v.product_id) === String(item.id)
                    );
                    
                    for (let v of productVariants) {
                        if (!v.option1) continue;
                        const optionParts = v.option1.toLowerCase().split('-');
                        if (
                            optionParts.length >= partCount &&
                            optionParts.slice(-partCount).join('-') === merged
                        ) {
                            item.cj_vid = v.cj_vid;
                            break;
                        }
                    }
                }
            });
            
            return {
                items: items,
                subtotal: subtotal.toFixed(2),
                shipping_amount: shipping.toFixed(2),
                tax_amount: tax.toFixed(2),
                total_amount: total.toFixed(2)
            };
        }

        // REDIRECT TO PAYMENT SELECTION FUNCTION (from your documentation)
        function redirectCartToPaymentSelection() {
            const cartData = getCartData();
            
            if (!cartData.items || cartData.items.length === 0) {
                alert('Your cart is empty');
                return;
            }

            // Get current page subdomain
            const hostname = window.location.hostname;
            const page_domain = document.getElementById('page-subdomain').value;
            const subdomain = hostname.includes('localhost') ? page_domain : hostname.split('.')[0];

            // Redirect to payment selection page with cart data
            const params = new URLSearchParams({
                type: 'cart',
                cart: JSON.stringify(cartData)
            });

            window.location.href = `/payments/select-payment/${subdomain}/?${params.toString()}`;
        }
    </script>
</body>
</html>