{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.brand_name }} | Pure Beauty, Refined</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --color-bg-primary: #F2E7E2;
            --color-bg-soft: #F4E6CB;
            --color-accent-warm: #F9D0BE;
            --color-lavender: #E1C6D6;
            --color-text-dark: #2c2a2a;
            --color-text-soft: #5e5a5a;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 24px;
            --transition: all 0.3s ease;
        }

        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--color-bg-primary);
            color: var(--color-text-dark);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Header / Navigation */
        header {
            position: sticky;
            top: 0;
            width: 100%;
            z-index: 1000;
            padding: 1.2rem 0;
            background-color: rgba(242, 231, 226, 0.92);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid rgba(225, 198, 214, 0.4);
            transition: var(--transition);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo a {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 600;
            letter-spacing: 1px;
            color: var(--color-text-dark);
            text-decoration: none;
        }

        .logo span {
            color: var(--color-text-dark);
        }

        .logo span span {
            color: var(--color-accent-warm);
        }

        .desktop-nav {
            display: flex;
            gap: 2.5rem;
        }

        .desktop-nav a {
            text-decoration: none;
            color: var(--color-text-dark);
            font-weight: 400;
            font-size: 0.95rem;
            letter-spacing: 0.5px;
            transition: var(--transition);
            position: relative;
        }

        .desktop-nav a:hover {
            color: #b27d6a;
        }

        .desktop-nav a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--color-accent-warm);
            transition: width 0.3s ease;
        }

        .desktop-nav a:hover::after {
            width: 100%;
        }

        .nav-icons {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .nav-icons i {
            font-size: 1.2rem;
            color: var(--color-text-dark);
            cursor: pointer;
            transition: var(--transition);
        }

        .nav-icons i:hover {
            color: #b27d6a;
        }

        /* Account Dropdown */
        .account-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: white;
            min-width: 200px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            z-index: 1;
            border-radius: 12px;
            overflow: hidden;
            margin-top: 10px;
        }

        .dropdown-content a {
            color: var(--color-text-dark);
            padding: 0.8rem 1.2rem;
            text-decoration: none;
            display: block;
            font-size: 0.85rem;
            transition: var(--transition);
        }

        .dropdown-content a:hover {
            background-color: var(--color-bg-soft);
            color: #b27d6a;
        }

        .account-dropdown:hover .dropdown-content {
            display: block;
        }

        /* Hamburger Menu */
        .hamburger {
            display: none;
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--color-text-dark);
        }

        .mobile-nav {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--color-bg-primary);
            z-index: 9999;
            padding: 2rem;
            transform: translateX(-100%);
            transition: transform 0.4s ease;
        }

        .mobile-nav.active {
            transform: translateX(0);
        }

        .mobile-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(44, 42, 42, 0.1);
        }

        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-nav-links a {
            text-decoration: none;
            color: var(--color-text-dark);
            font-size: 1.2rem;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(44, 42, 42, 0.05);
        }

        .back-button {
            background: none;
            border: none;
            font-size: 1rem;
            color: var(--color-text-dark);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'Montserrat', sans-serif;
        }

        /* Hero Section */
        section.hero {
            min-height: 90vh;
            width: 100%;
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 55%;
            background-image: url('{% if image_customizations.7 %}{{ image_customizations.7.image_url }}{% else %}https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1000&auto=format{% endif %}');
            background-size: cover;
            background-position: 30% 20%;
            border-radius: 40px 0 0 40px;
            box-shadow: -10px 0 20px rgba(0, 0, 0, 0.02);
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, rgba(242, 231, 226, 0.2) 0%, rgba(242, 231, 226, 0) 70%);
            pointer-events: none;
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 580px;
            padding: 3rem 2rem 3rem 0;
        }

        h1 {
            font-size: 4rem;
            font-weight: 500;
            line-height: 1.2;
            margin-bottom: 1rem;
            color: #2a2624;
        }

        p {
            font-size: 1.1rem;
            color: var(--color-text-soft);
            margin-bottom: 2rem;
            line-height: 1.5;
            font-weight: 350;
        }

        a.cta-btn {
            display: inline-block;
            background-color: var(--color-accent-warm);
            color: #3e2c25;
            padding: 0.9rem 2.2rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: var(--transition);
            box-shadow: 0 4px 10px rgba(249, 208, 190, 0.3);
            border: none;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
        }

        a.cta-btn:hover {
            background-color: #efbc9b;
            transform: translateY(-2px);
            box-shadow: 0 12px 20px -8px rgba(0, 0, 0, 0.1);
        }

        /* New Arrivals Section */
        section.new-arrivals {
            padding: var(--spacing-xl) 0;
            background-color: var(--color-bg-soft);
        }

        .section-header {
            text-align: center;
            margin-bottom: var(--spacing-lg);
        }

        h2 {
            font-size: 2.8rem;
            color: var(--color-text-dark);
            margin-bottom: 0.8rem;
            position: relative;
            display: inline-block;
        }

        h2::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, var(--color-accent-warm), var(--color-lavender));
        }

        .section-header p {
            color: var(--color-text-soft);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .product-card {
            background: #fffbf8;
            border-radius: 28px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.02);
            text-decoration: none;
            color: inherit;
        }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.08);
        }

        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1.1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-img {
            transform: scale(1.02);
        }

        .product-info {
            padding: 1rem 1rem 1.2rem;
        }

        .product-category {
            color: var(--color-accent-warm);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.3rem;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            margin-bottom: 0.3rem;
        }

        .product-price {
            font-weight: 500;
            color: #b27d6a;
            font-size: 0.95rem;
        }

        .see-more {
            display: inline-block;
            background-color: transparent;
            color: #b27d6a;
            padding: 0.8rem 2rem;
            font-size: 0.9rem;
            font-weight: 400;
            letter-spacing: 0.5px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            border: 1px solid #b27d6a;
        }

        .see-more:hover {
            background-color: #b27d6a;
            color: white;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: 28px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            margin: 2rem 0;
        }

        .empty-state h3 {
            color: var(--color-text-dark);
            margin-bottom: 1rem;
        }

        .empty-state a {
            color: #b27d6a;
            text-decoration: none;
            font-weight: 500;
        }

        .empty-state a:hover {
            text-decoration: underline;
        }

        /* Responsive Styles */
        @media (max-width: 1024px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
            }
            h1 {
                font-size: 3rem;
            }
            .hero-bg {
                width: 50%;
            }
        }

        @media (max-width: 768px) {
            .desktop-nav {
                display: none;
            }
            .hamburger {
                display: block;
            }
            section.hero {
                flex-direction: column;
                min-height: auto;
                padding: 2rem 0;
            }
            .hero-bg {
                position: relative;
                width: 100%;
                height: 380px;
                border-radius: 28px;
                margin-top: 1rem;
                background-position: center 30%;
            }
            .hero-content {
                padding: 2rem 0 1rem;
                text-align: center;
                max-width: 100%;
            }
            h1 {
                font-size: 2.5rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 360px;
                margin: 0 auto 2rem;
            }
            h2 {
                font-size: 2.2rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 2rem;
            }
            p {
                font-size: 1rem;
            }
            a.cta-btn, .see-more {
                padding: 0.8rem 1.8rem;
                font-size: 0.85rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}
        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce17/snippets/header1.html' %}

    {% for component in components %}
        {% if component.drop_zone == '1' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Hero Section -->
    <section class="hero" id="section-13">
        <div class="hero-bg"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 id="section-14">{{ text_contents.11|default:'Pure Beauty, Refined' }}</h1>
            <p id="section-15">{{ text_contents.12|default:'Skincare crafted to nourish, restore, and elevate your natural glow. Experience the essence of purity and calm.' }}</p>
            <a href="?page=products" class="cta-btn" id="section-16">{{ text_contents.13|default:'Shop Skincare' }}</a>
        </div>
    </section>

    {% for component in components %}
        {% if component.drop_zone == '13' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- New Arrivals Section -->
    <section class="new-arrivals" id="section-17">
        <div class="container">
            <div class="section-header">
                <h2 id="section-18">{{ text_contents.14|default:'New Arrivals' }}</h2>
                <p id="section-19">{{ text_contents.15|default:'Discover our latest formulations, crafted with exceptional care for your skin.' }}</p>
            </div>
            {% if products %}
                <div class="products-grid">
                    {% for product in products|slice:":4" %}
                        <a href="/product/{{ product.slug }}/" class="product-card" id="section-20">
                            {% if product.main_image %}
                                <img src="{{ product.main_image.url }}" alt="{{ product.title }}" class="product-img">
                            {% else %}
                                <div class="product-img" style="background-color: var(--color-lavender); display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-leaf" style="font-size: 3rem; color: var(--color-accent-warm); opacity: 0.5;"></i>
                                </div>
                            {% endif %}
                            <div class="product-info">
                                <div class="product-category" id="section-21">{{ product.category.name|default:"SKINCARE" }}</div>
                                <div class="product-name" id="section-22">{{ product.title|truncatechars:30 }}</div>
                                <div class="product-price" id="section-23">{{ product.price|currency:page }}</div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <h3>No Products Yet</h3>
                    <p>You haven't added any skincare products to your collection yet. <a href="/admin/add-product">Add your first product</a> to get started.</p>
                </div>
            {% endif %}
            <a href="?page=products" class="see-more" id="section-24">{{ text_contents.16|default:'View All Collections →' }}</a>
        </div>
    </section>

    {% for component in components %}
        {% if component.drop_zone == '17' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce17/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}
    
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Cart management buttons
            document.querySelectorAll('.increment-cart').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.incrementCartItem(productId, 1);
                    }
                });
            });

            document.querySelectorAll('.decrement-cart').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.decrementCartItem(productId, 1);
                    }
                });
            });

            document.querySelectorAll('.remove-cart-item').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.removeFromCart(productId);
                    }
                });
            });

            // Add to Cart from recommended products
            document.querySelectorAll('.add-to-cart-small').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.addToCart(productId, 1);
                    }
                });
            });
        });

        function redirectCartToPaymentSelection() {
            const cartData = getCartData();
            if (!cartData.items || cartData.items.length === 0) {
                alert('Your cart is empty');
                return;
            }

            const hostname = window.location.hostname;
            const page_domain = document.getElementById('page-subdomain').value;
            const subdomain = hostname.includes('localhost') ? page_domain : hostname.split('.')[0];

            const params = new URLSearchParams({
                type: 'cart',
                cart: JSON.stringify(cartData)
            });

            window.location.href = `/payments/select-payment/${subdomain}/?${params.toString()}`;
        }

        function getCartData() {
            const items = [];
            let subtotal = 0;

            document.querySelectorAll('.cart-item').forEach(item => {
                const title = item.querySelector('.product-title')?.textContent || 'Product';
                const description = item.querySelector('.product-description')?.textContent || 'Description';
                const price = parseFloat(item.querySelector('.product-price')?.textContent.replace('$', '')) || 0;
                const quantity = parseInt(item.querySelector('.quantity-input')?.textContent) || 1;
                const total = price * quantity;

                items.push({ title, description, price, quantity, total_price: total });
                subtotal += total;
            });

            const shipping = subtotal > 0 ? 5.00 : 0;
            const tax = subtotal * 0.08;
            const total = subtotal + shipping + tax;

            return {
                items: items,
                subtotal: subtotal,
                shipping_amount: shipping,
                tax_amount: tax,
                total_amount: total
            };
        }
    </script>
</body>
</html>