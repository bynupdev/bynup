{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
    :root {
        --color-bg-primary: #F2E7E2;
        --color-bg-soft: #F4E6CB;
        --color-accent-warm: #F9D0BE;
        --color-lavender: #E1C6D6;
        --color-text-dark: #2c2a2a;
        --color-text-soft: #5e5a5a;
        --spacing-xl: 6rem;
        --spacing-lg: 4rem;
        --spacing-md: 2rem;
        --spacing-sm: 1rem;
        --border-radius: 24px;
        --transition: all 0.3s ease;
    }

    {% generate_color_variables %}

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--color-bg-primary);
        color: var(--color-text-dark);
        overflow-x: hidden;
        line-height: 1.6;
    }

    h1, h2, h3, h4 {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 500;
        letter-spacing: -0.01em;
    }

    .container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Header / Navigation */
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        padding: 1.2rem 0;
        background-color: rgba(242, 231, 226, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid rgba(225, 198, 214, 0.4);
        transition: var(--transition);
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo a {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.8rem;
        font-weight: 600;
        letter-spacing: 1px;
        color: var(--color-text-dark);
        text-decoration: none;
    }

    .logo span {
        color: var(--color-text-dark);
    }

    .logo span span {
        color: var(--color-accent-warm);
    }

    .desktop-nav {
        display: flex;
        gap: 2.5rem;
    }

    .desktop-nav a {
        text-decoration: none;
        color: var(--color-text-dark);
        font-weight: 400;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
        transition: var(--transition);
        position: relative;
    }

    .desktop-nav a:hover {
        color: #b27d6a;
    }

    .desktop-nav a::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 1px;
        background: var(--color-accent-warm);
        transition: width 0.3s ease;
    }

    .desktop-nav a:hover::after {
        width: 100%;
    }

    .nav-icons {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .nav-icons i {
        font-size: 1.2rem;
        color: var(--color-text-dark);
        cursor: pointer;
        transition: var(--transition);
    }

    .nav-icons i:hover {
        color: #b27d6a;
    }

    /* Account Dropdown */
    .account-dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        background-color: white;
        min-width: 210px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        z-index: 1;
        border-radius: 12px;
        overflow: hidden;
        margin-top: 10px;
        padding: 10px 0;
        list-style: none;
        transform: translateY(-5px);
        opacity: 0;
        transition: all 0.2s ease;
    }

    .dropdown a {
        color: var(--color-text-dark);
        padding: 0.8rem 1.2rem;
        text-decoration: none;
        display: block;
        font-size: 0.85rem;
        transition: var(--transition);
    }

    .dropdown a:hover {
        background-color: rgba(249, 208, 190, 0.2);
        color: #b27d6a;
    }

    /* Hamburger Menu */
    .hamburger {
        display: none;
        cursor: pointer;
        font-size: 1.5rem;
        color: var(--color-text-dark);
    }

    .mobile-nav {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: var(--color-bg-primary);
        z-index: 9999;
        padding: 2rem;
        transform: translateX(-100%);
        transition: transform 0.4s ease;
    }

    .mobile-nav.active {
        transform: translateX(0);
    }

    .mobile-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 3rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(44, 42, 42, 0.1);
    }

    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .mobile-nav-links a {
        text-decoration: none;
        color: var(--color-text-dark);
        font-size: 1.2rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid rgba(44, 42, 42, 0.05);
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .back-button {
        background: none;
        border: none;
        font-size: 1rem;
        color: var(--color-text-dark);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Montserrat', sans-serif;
    }

    .icon-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: inherit;
        padding: 0.4rem;
    }

    .wishlist-counter,
    .cart-counter {
        position: absolute;
        top: 0;
        right: 0;
        transform: translate(50%, -50%);
        background-color: #b27d6a;
        color: white;
        padding: 0.2rem 0.5rem;
        border-radius: 50px;
        font-size: 0.65rem;
        font-weight: 500;
        min-width: 18px;
        text-align: center;
    }

    .icon-btn i {
        font-size: 1.2rem;
    }

    /* Responsive Styles */
    @media (max-width: 992px) {
        .desktop-nav {
            gap: 2rem;
        }
    }

    @media (max-width: 768px) {
        .hamburger {
            display: block;
        }
        .desktop-nav {
            display: none;
        }
        .nav-icons {
            gap: 1rem;
        }
        header {
            padding: 0.8rem 0;
        }
        .logo a {
            font-size: 1.5rem;
        }
    }

    @media (max-width: 576px) {
        .container {
            padding: 0 1rem;
        }
        .nav-icons {
            gap: 0.8rem;
        }
    }

    /* Dynamic Section Styles */
    {% generate_section_styles style_customizations 1 50 %}
    /* Dynamic Background Images */
    {% generate_background_images background_images 1 50 %}
    {% generate_hover_keyframes %}
</style>

<!-- Header -->
<header id="section-1">
    <div class="container header-container">
        <div class="logo">
            <a href="?page=home">
                <i class="fas fa-leaf" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"LUMIÈRE<span>ÉCLAT</span>"|safe }}</span>
            </a>
        </div>
        <nav class="desktop-nav">
            <a href="?page=home" id="section-3">{{ text_contents.2|default:"Home" }}</a>
            <a href="?page=products" id="section-4">{{ text_contents.3|default:"Shop" }}</a>
            <a href="?page=about" id="section-5">{{ text_contents.4|default:"About Us" }}</a>
            <a href="?page=contact" id="section-6">{{ text_contents.5|default:"Contact" }}</a>
        </nav>
        <div class="nav-icons">
            <a href="?page=cart" class="icon-btn">
                <span class="cart-counter" id="cart-counter">0</span>
                <i class="fas fa-shopping-bag" data-icon="2"></i>
            </a>
            <a href="?page=wishlist" class="icon-btn">
                <span class="wishlist-counter" id="wishlist-counter">0</span>
                <i class="far fa-heart" data-icon="3"></i>
            </a>
            <!-- USER DROPDOWN -->
            <div style="position:relative;">
                <div class="account-dropdown">
                    <i class="far fa-user" data-icon="4" onclick="toggleDropdown()" style="cursor:pointer;"></i>
                    <ul id="dropdown" class="dropdown">
                        <!-- Close button -->
                        <div onclick="toggleDropdown()" style="text-align:right; padding:5px 15px; cursor:pointer;">
                            <i class="fa-solid fa-xmark" data-icon="5" style="font-size:18px; color:#444;"></i>
                        </div>
                        {% if show_auth_links %}
                            {% if not is_website_member %}
                                <li>
                                    <a href="{{ website_register_url }}" id="section-7">
                                        <i class="fa-solid fa-user-plus"></i> {{ text_contents.6|default:"Sign Up" }}
                                    </a>
                                </li>
                                <li>
                                    <a href="{{ website_login_url }}" id="section-8">
                                        <i class="fas fa-sign-in-alt"></i> {{ text_contents.7|default:"Sign In" }}
                                    </a>
                                </li>
                                <li>
                                    <a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-9">
                                        <i class="fa-solid fa-box"></i> {{ text_contents.8|default:"Orders" }}
                                    </a>
                                </li>
                            {% else %}
                                <li>
                                    <a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-10">
                                        <i class="fa-solid fa-box"></i> {{ text_contents.9|default:"Orders" }}
                                    </a>
                                </li>
                                <li>
                                    <a href="?page=wishlist" id="section-11">
                                        <i class="fa-regular fa-heart"></i> {{ text_contents.10|default:"Wishlist" }}
                                    </a>
                                </li>
                                <li>
                                    <a href="?page=account" id="section-12">
                                        <i class="fa-solid fa-user-gear"></i> {{ text_contents.11|default:"Account Settings" }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endif %}
                    </ul>
                </div>
            </div>
            <div class="hamburger" id="hamburgerBtn">
                <i class="fas fa-bars" data-icon="6"></i>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Navigation -->
<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="?page=home" class="logo">LUMIÈRE<span>ÉCLAT</span></a>
        <button class="back-button" id="closeNav">
            <i class="fas fa-times" data-icon="5"></i> Back
        </button>
    </div>
    <div class="mobile-nav-links">
        <a href="?page=home"><i class="fas fa-home"></i> Home</a>
        <a href="?page=products"><i class="fas fa-shopping-bag"></i> Shop</a>
        <a href="?page=about"><i class="fas fa-leaf"></i> About Us</a>
        <a href="?page=contact"><i class="fas fa-envelope"></i> Contact</a>
        <a href="?page=cart"><i class="fas fa-shopping-cart"></i> Cart</a>
        <a href="?page=wishlist"><i class="far fa-heart"></i> Wishlist</a>
        <a href="?page=account"><i class="far fa-user"></i> Account</a>
    </div>
</div>

<script>
    // Mobile Navigation
    const hamburger = document.getElementById('hamburgerBtn');
    const mobileNav = document.getElementById('mobileNav');
    const closeNav = document.getElementById('closeNav');

    if (hamburger) {
        hamburger.addEventListener('click', function() {
            mobileNav.classList.add('active');
            document.body.style.overflow = 'hidden';
        });
    }

    if (closeNav) {
        closeNav.addEventListener('click', function() {
            mobileNav.classList.remove('active');
            document.body.style.overflow = '';
        });
    }

    // Close mobile nav when clicking a link
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-links a');
    mobileNavLinks.forEach(link => {
        link.addEventListener('click', function() {
            mobileNav.classList.remove('active');
            document.body.style.overflow = '';
        });
    });

    // Header scroll effect
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header');
        if (header && window.scrollY > 100) {
            header.style.padding = '0.8rem 0';
            header.style.backgroundColor = 'rgba(242, 231, 226, 0.98)';
        } else if (header) {
            header.style.padding = '1.2rem 0';
            header.style.backgroundColor = 'rgba(242, 231, 226, 0.92)';
        }
    });

    // User Dropdown Toggle
    function toggleDropdown() {
        const menu = document.getElementById("dropdown");
        const isVisible = menu.style.display === "block";
        menu.style.display = isVisible ? "none" : "block";
        menu.style.opacity = isVisible ? "0" : "1";
        menu.style.transform = isVisible ? "translateY(-5px)" : "translateY(0px)";
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('dropdown');
        const userIcon = document.querySelector('.fa-user');
        if (dropdown && userIcon && !userIcon.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
            dropdown.style.opacity = '0';
            dropdown.style.transform = 'translateY(-5px)';
        }
    });

    // Update cart counter from cartManager
    if (window.cartManager) {
        window.cartManager.updateCounters = function(data) {
            const cartItemsCount = data.cart_items_count || 0;
            const wishlistCount = data.wishlist_count || 0;
            const cartCounter = document.querySelector('.cart-counter');
            const wishlistCounter = document.querySelector('.wishlist-counter');
            if (cartCounter) {
                cartCounter.textContent = cartItemsCount;
                cartCounter.style.display = cartItemsCount > 0 ? 'inline-block' : 'none';
            }
            if (wishlistCounter) {
                wishlistCounter.textContent = wishlistCount;
                wishlistCounter.style.display = wishlistCount > 0 ? 'inline-block' : 'none';
            }
        };
    }
</script>