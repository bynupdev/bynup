{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{{ page.brand_name }} | Shop Fine Jewelry</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  {% render_icon_data icon_customizations %}
  <style>
    :root {
      --bg-soft: #F2F7F6;
      --bg-warm: #F2E7E6;
      --accent-rose: #F388A2;
      --acleaf-moss: #7F805C;
      --accent-sand: #F2DDB3;
      --border-radius: 24px;
      --transition: all 0.3s ease;
    }

    {% generate_color_variables %}

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-soft);
      font-family: 'Inter', sans-serif;
      color: #1e2a2a;
      line-height: 1.4;
    }

    h1, h2, h3 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .shop-header {
      padding: 8rem 0 3rem;
      text-align: center;
    }

    .shop-header h1 {
      font-size: 3.5rem;
      color: #2c3a2f;
      margin-bottom: 1rem;
    }

    .shop-header p {
      font-size: 1rem;
      color: #5b6e55;
      max-width: 600px;
      margin: 0 auto;
    }

    .shop-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-bottom: 3rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid rgba(127, 128, 92, 0.2);
    }

    .search-wrapper {
      flex: 1;
      max-width: 400px;
      position: relative;
    }

    .search-input {
      width: 100%;
      padding: 0.9rem 1rem 0.9rem 2.8rem;
      border: 1px solid rgba(127, 128, 92, 0.3);
      border-radius: 40px;
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      background: white;
      transition: var(--transition);
    }

    .search-input:focus {
      outline: none;
      border-color: var(--accent-rose);
      box-shadow: 0 0 0 3px rgba(243, 136, 162, 0.1);
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--acleaf-moss);
      font-size: 1rem;
    }

    .filter-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .categories-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.8rem 1.8rem;
      background: transparent;
      border: 1px solid var(--accent-rose);
      border-radius: 40px;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--accent-rose);
      text-decoration: none;
      transition: var(--transition);
      cursor: pointer;
    }

    .categories-btn:hover {
      background: var(--accent-rose);
      color: white;
    }

    .sort-select {
      padding: 0.8rem 1.5rem;
      border: 1px solid rgba(127, 128, 92, 0.3);
      border-radius: 40px;
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      background: white;
      cursor: pointer;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .product-card {
      background: white;
      border-radius: var(--border-radius);
      overflow: hidden;
      transition: var(--transition);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
      cursor: pointer;
      text-decoration: none;
      display: block;
    }

    .product-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
      background: #fffef7;
    }

    .product-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .product-card:hover .product-img {
      transform: scale(1.02);
    }

    .product-info {
      padding: 1.2rem 1rem 0.5rem;
      text-align: center;
    }

    .product-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 500;
      color: #3a4a3c;
      margin-bottom: 0.3rem;
    }

    .product-price {
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--accent-rose);
      margin-bottom: 0.8rem;
    }

    .product-actions {
      display: flex;
      gap: 0.8rem;
      justify-content: center;
      padding: 0 1rem 1.2rem;
    }

    .add-to-cart-btn {
      flex: 1;
      background: var(--accent-rose);
      border: none;
      padding: 0.6rem 0.8rem;
      border-radius: 40px;
      font-family: 'Inter', sans-serif;
      font-size: 0.75rem;
      font-weight: 500;
      color: white;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }

    .add-to-cart-btn:hover {
      background: #e27a97;
      transform: translateY(-2px);
    }

    .wishlist-btn {
      background: transparent;
      border: 1px solid rgba(127, 128, 92, 0.3);
      border-radius: 40px;
      padding: 0.6rem 1rem;
      cursor: pointer;
      transition: var(--transition);
      color: var(--acleaf-moss);
    }

    .wishlist-btn:hover {
      border-color: var(--accent-rose);
      color: var(--accent-rose);
    }

    .empty-state {
      text-align: center;
      padding: 4rem;
      background: white;
      border-radius: var(--border-radius);
      grid-column: 1 / -1;
    }

    .empty-state h3 {
      font-size: 1.8rem;
      color: #2c3a2f;
      margin-bottom: 1rem;
    }

    .empty-state p {
      color: #5b6e55;
      margin-bottom: 1.5rem;
    }

    .empty-state a {
      color: var(--accent-rose);
      text-decoration: none;
      font-weight: 500;
    }

    @media (max-width: 1200px) {
      .products-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    }

    @media (max-width: 992px) {
      .products-grid { grid-template-columns: repeat(2, 1fr); }
      .shop-header h1 { font-size: 2.8rem; }
    }

    @media (max-width: 768px) {
      .container { padding: 0 1.5rem; }
      .shop-header { padding: 6rem 0 2rem; }
      .shop-header h1 { font-size: 2.2rem; }
      .shop-controls { flex-direction: column; align-items: stretch; }
      .search-wrapper { max-width: 100%; }
      .filter-actions { justify-content: space-between; }
      .products-grid { grid-template-columns: 1fr; max-width: 380px; margin-left: auto; margin-right: auto; }
    }

    {% generate_section_styles style_customizations 50 100 %}
    {% generate_background_images background_images 50 100 %}
    {% generate_hover_keyframes %}
  </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Shop Header -->
<div class="shop-header" id="section-50">
  <div class="container">
    <h1 id="section-51">{{ text_contents.40|default:"Our Collection" }}</h1>
    <p id="section-52">{{ text_contents.41|default:"Discover timeless jewelry crafted with precision and passion. Each piece tells a story of elegance." }}</p>
  </div>
</div>

<!-- Shop Controls -->
<div class="container">
  <div class="shop-controls">
    <div class="search-wrapper">
      <i class="fas fa-search search-icon" data-icon="20"></i>
      <input type="text" class="search-input" id="searchInput" placeholder="Search jewelry...">
    </div>
    <div class="filter-actions">
      <a href="?page=categories" class="categories-btn" id="section-53">
        <i class="fas fa-gem" data-icon="21"></i> {{ text_contents.42|default:"Browse Categories" }}
      </a>
      <select class="sort-select" id="sortSelect">
        <option value="newest">Newest First</option>
        <option value="price-low">Price: Low to High</option>
        <option value="price-high">Price: High to Low</option>
      </select>
    </div>
  </div>
</div>

<!-- Products Grid -->
<div class="container">
  <div class="products-grid" id="productsGrid">
    {% if products %}
      {% for product in products %}
        <div class="product-card" 
             data-product-id="{{ product.id }}" 
             data-product-name="{{ product.title }}" 
             data-product-price="{{ product.price }}"
             data-product-category="{{ product.category.id|default:'' }}"
             data-product-created="{{ product.created_at|date:'U' }}">
          <img class="product-img" src="{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.pexels.com/photos/2079656/pexels-photo-2079656.jpeg?auto=compress&cs=tinysrgb&w=800{% endif %}" alt="{{ product.title }}">
          <div class="product-info">
            <div class="product-name">{{ product.title|truncatechars:35 }}</div>
            <div class="product-price">{{ product.price|currency:page }}</div>
          </div>
          <div class="product-actions">
            <button class="add-to-cart-btn" data-product-id="{{ product.id }}">
              <i class="fas fa-shopping-bag"></i> Add to Cart
            </button>
            <button class="wishlist-btn" data-product-id="{{ product.id }}">
              <i class="far fa-heart"></i>
            </button>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="empty-state">
        <h3>No Products Available</h3>
        <p>Your shop doesn't have any products yet. Start by adding your first jewelry piece to showcase your collection.</p>
        <p><a href="/admin/add-product">Add your first product</a> to get started.</p>
      </div>
    {% endif %}
  </div>
</div>

<script src="{% static 'builder/js/cart-manager.js' %}"></script>
{% render_icon_script %}

<script>
  (function() {
    const searchInput = document.getElementById('searchInput');
    const products = document.querySelectorAll('.product-card');
    const sortSelect = document.getElementById('sortSelect');
    const productsGrid = document.getElementById('productsGrid');
    
    function filterProducts() {
      const searchTerm = searchInput.value.toLowerCase().trim();
      products.forEach(product => {
        const productName = product.querySelector('.product-name').textContent.toLowerCase();
        if (searchTerm === '' || productName.includes(searchTerm)) {
          product.style.display = 'block';
        } else {
          product.style.display = 'none';
        }
      });
    }
    
    if (searchInput) searchInput.addEventListener('input', filterProducts);
    
    function sortProducts() {
      const sortValue = sortSelect.value;
      const visibleProducts = Array.from(products).filter(p => p.style.display !== 'none');
      
      visibleProducts.sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-product-price'));
        const priceB = parseFloat(b.getAttribute('data-product-price'));
        const dateA = parseInt(a.getAttribute('data-product-created') || 0);
        const dateB = parseInt(b.getAttribute('data-product-created') || 0);
        
        if (sortValue === 'price-low') return priceA - priceB;
        if (sortValue === 'price-high') return priceB - priceA;
        if (sortValue === 'newest') return dateB - dateA;
        return 0;
      });
      
      visibleProducts.forEach(product => productsGrid.appendChild(product));
    }
    
    if (sortSelect) sortSelect.addEventListener('change', sortProducts);
    
    // Add to Cart buttons
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productId = btn.getAttribute('data-product-id');
        
        btn.innerHTML = '<i class="fas fa-check"></i> Added';
        btn.style.background = '#7F805C';
        setTimeout(() => {
          btn.innerHTML = '<i class="fas fa-shopping-bag"></i> Add to Cart';
          btn.style.background = 'var(--accent-rose)';
        }, 1500);
        
        if (window.cartManager) window.cartManager.addToCart(productId, 1);
      });
    });
    
    // Wishlist buttons
    document.querySelectorAll('.wishlist-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const productId = btn.getAttribute('data-product-id');
        const icon = btn.querySelector('i');
        
        if (icon.classList.contains('far')) {
          icon.classList.remove('far');
          icon.classList.add('fas');
          btn.style.borderColor = 'var(--accent-rose)';
          btn.style.color = 'var(--accent-rose)';
        } else {
          icon.classList.remove('fas');
          icon.classList.add('far');
          btn.style.borderColor = 'rgba(127, 128, 92, 0.3)';
          btn.style.color = 'var(--acleaf-moss)';
        }
        
        if (window.cartManager) window.cartManager.addToWishlist(productId);
      });
    });
    
    // Product card click
    document.querySelectorAll('.product-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.tagName === 'BUTTON' || e.target.closest('button')) return;
        const productId = card.getAttribute('data-product-id');
        window.location.href = `/product/${card.querySelector('.product-name').textContent.toLowerCase().replace(/\s+/g, '-')}/?id=${productId}`;
      });
    });
  })();
</script>

</body>
</html>