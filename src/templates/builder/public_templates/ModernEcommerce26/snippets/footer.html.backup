{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
  /* ========== FOOTER STYLES ========== */
  .footer {
    background-color: #f6f3ef;
    margin-top: 5rem;
    padding: 3rem 2rem 2rem;
    border-top: 1px solid rgba(127,128,92,0.2);
  }

  .footer-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .footer-col h4 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--acleaf-moss, #7F805C);
    margin-bottom: 1rem;
  }

  .footer-col p,
  .footer-col a {
    display: block;
    text-decoration: none;
    color: #5b6e55;
    font-size: 0.85rem;
    margin-bottom: 0.6rem;
    transition: color 0.2s;
    line-height: 1.5;
  }

  .footer-col a:hover {
    color: var(--accent-rose, #F388A2);
  }

  .social-icons {
    display: flex;
    gap: 1.2rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .social-icons a {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(127, 128, 92, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    font-size: 1rem;
    color: var(--acleaf-moss, #7F805C);
  }

  .social-icons a:hover {
    background: var(--accent-rose, #F388A2);
    color: white;
    transform: translateY(-3px);
  }

  .copyright {
    text-align: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(127, 128, 92, 0.2);
    font-size: 0.7rem;
    color: #8c9a82;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .footer {
      padding: 2rem 1.5rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .social-icons {
      justify-content: center;
    }
  }

  /* Dynamic Styles */
  {% generate_section_styles style_customizations 22 50 %}
  {% generate_background_images background_images 22 50 %}
</style>

<!-- Footer -->
<footer class="footer" id="section-22">
  <div class="footer-grid">
    <!-- About/Brand Column -->
    <div class="footer-col" id="section-23">
      <h4 id="section-24">{{ text_contents.18|default:"LUMIÈRE" }}</h4>
      <p id="section-25">{{ text_contents.19|default:"Timeless jewelry crafted with passion and precision. Each piece is designed to become a cherished heirloom." }}</p>
    </div>
    
    <!-- Quick Links -->
    <div class="footer-col" id="section-26">
      <h4 id="section-27">{{ text_contents.20|default:"Quick Links" }}</h4>
      <a href="?page=home" id="section-28">{{ text_contents.21|default:"Home" }}</a>
      <a href="?page=products" id="section-29">{{ text_contents.22|default:"Shop" }}</a>
      <a href="?page=about" id="section-30">{{ text_contents.23|default:"About Us" }}</a>
      <a href="?page=contact" id="section-31">{{ text_contents.24|default:"Contact" }}</a>
    </div>
    
    <!-- Customer Support -->
    <div class="footer-col" id="section-32">
      <h4 id="section-33">{{ text_contents.25|default:"Customer Support" }}</h4>
      <a href="?page=help" id="section-34">{{ text_contents.26|default:"Help Center" }}</a>
      <a href="?page=shipping" id="section-35">{{ text_contents.27|default:"Shipping Info" }}</a>
      <a href="?page=returns" id="section-36">{{ text_contents.28|default:"Returns" }}</a>
      <a href="?page=faq" id="section-37">{{ text_contents.29|default:"FAQ" }}</a>
    </div>
    
    <!-- Legal & Contact -->
    <div class="footer-col" id="section-38">
      <h4 id="section-39">{{ text_contents.30|default:"Legal" }}</h4>
      <a href="?page=privacy" id="section-40">{{ text_contents.31|default:"Privacy Policy" }}</a>
      <a href="?page=terms" id="section-41">{{ text_contents.32|default:"Terms & Conditions" }}</a>
      <div style="margin-top: 1rem;">
        <h4 style="font-size: 1rem; margin-bottom: 0.5rem;" id="section-42">{{ text_contents.33|default:"Contact" }}</h4>
        <p id="section-43">{{ text_contents.34|default:"+1 (555) 234-5678" }}</p>
        <p id="section-44">{{ text_contents.35|default:"hello@lumiere.com" }}</p>
        <p id="section-45">{{ text_contents.36|default:"123 Fifth Avenue, New York, NY 10003" }}</p>
      </div>
    </div>
    
    <!-- Social Media Column -->
    <div class="footer-col" id="section-46">
      <h4 id="section-47">{{ text_contents.37|default:"Follow Us" }}</h4>
      <div class="social-icons">
        {% if page.social_media.all %}
          {% for social in page.social_media.all %}
            {% if social.is_active %}
              <a href="{{ social.get_url }}" target="{% if social.open_in_new_tab %}_blank{% else %}_self{% endif %}" rel="noopener noreferrer" aria-label="{{ social.get_platform_display }}" class="editable-icon" data-icon="{{ forloop.counter|add:10 }}">
                <i class="{{ social.get_icon }}"></i>
              </a>
            {% endif %}
          {% endfor %}
        {% else %}
          <!-- Default social icons if none configured -->
          <a href="#" aria-label="Instagram" class="editable-icon" data-icon="11"><i class="fab fa-instagram"></i></a>
          <a href="#" aria-label="Facebook" class="editable-icon" data-icon="12"><i class="fab fa-facebook-f"></i></a>
          <a href="#" aria-label="Twitter" class="editable-icon" data-icon="13"><i class="fab fa-twitter"></i></a>
          <a href="#" aria-label="Pinterest" class="editable-icon" data-icon="14"><i class="fab fa-pinterest"></i></a>
        {% endif %}
      </div>
    </div>
  </div>
  
  <div class="copyright" id="section-48">
    <p id="section-49">{{ text_contents.38|default:"© 2025 LUMIÈRE — Timeless Craftsmanship. All rights reserved." }}</p>
  </div>
</footer>

<!-- Message Notification Container -->
<div id="backend-messages-container" class="backend-messages-container">
  <div id="backend-message-template" class="backend-message" style="display: none;">
    <div class="backend-message-content">
      <i class="backend-message-icon"></i>
      <div class="backend-message-text">
        <strong class="backend-message-title"></strong>
        <div class="backend-message-body"></div>
      </div>
      <button class="backend-message-close" onclick="this.parentElement.parentElement.remove()">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="backend-message-progress"></div>
  </div>
</div>

<!-- Django Context Messages Display -->
{% if messages %}
<div id="django-messages-container" class="django-messages-container">
  {% for message in messages %}
  <div class="django-message django-message-{{ message.tags }}">
    <div class="django-message-content">
      <i class="fas fa-{% if message.tags == 'success' %}check-circle{% elif message.tags == 'error' or message.tags == 'danger' %}exclamation-circle{% else %}info-circle{% endif %}"></i>
      <div class="django-message-text">
        <strong>{{ message|capfirst }}</strong>
      </div>
      <button class="django-message-close" onclick="this.parentElement.parentElement.remove()">
        <i class="fas fa-times"></i>
      </button>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

<style>
  /* Backend Messages Container */
  .backend-messages-container,
  .django-messages-container {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 999999;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 400px;
  }

  .backend-message {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
    border-left: 4px solid;
    animation: slideInBackendMessage 0.3s ease forwards;
    transform: translateX(100%);
    opacity: 0;
  }

  .backend-message.success { border-left-color: #28a745; background: linear-gradient(90deg, rgba(40, 167, 69, 0.08) 0%, white 30%); }
  .backend-message.error { border-left-color: #dc3545; background: linear-gradient(90deg, rgba(220, 53, 69, 0.08) 0%, white 30%); }
  .backend-message.warning { border-left-color: #ffc107; background: linear-gradient(90deg, rgba(255, 193, 7, 0.08) 0%, white 30%); }
  .backend-message.info { border-left-color: #17a2b8; background: linear-gradient(90deg, rgba(23, 162, 184, 0.08) 0%, white 30%); }

  .django-message {
    background: white;
    border-radius: 8px;
    padding: 0;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
    border-left: 4px solid;
    animation: slideInBackendMessage 0.3s ease forwards;
  }

  .django-message.success { border-left-color: #28a745; background: linear-gradient(90deg, rgba(40, 167, 69, 0.1) 0%, white 30%); }
  .django-message.error { border-left-color: #dc3545; background: linear-gradient(90deg, rgba(220, 53, 69, 0.1) 0%, white 30%); }
  .django-message.warning { border-left-color: #ffc107; background: linear-gradient(90deg, rgba(255, 193, 7, 0.1) 0%, white 30%); }
  .django-message.info { border-left-color: #17a2b8; background: linear-gradient(90deg, rgba(23, 162, 184, 0.1) 0%, white 30%); }

  .backend-message-content,
  .django-message-content {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    gap: 12px;
  }

  .backend-message-icon,
  .django-message-content i:first-child {
    font-size: 20px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .success .backend-message-icon,
  .django-message.success i:first-child { background-color: #28a745; color: white; }
  .error .backend-message-icon,
  .django-message.error i:first-child { background-color: #dc3545; color: white; }
  .warning .backend-message-icon,
  .django-message.warning i:first-child { background-color: #ffc107; color: #212529; }
  .info .backend-message-icon,
  .django-message.info i:first-child { background-color: #17a2b8; color: white; }

  .backend-message-text,
  .django-message-text {
    flex: 1;
    font-size: 14px;
    line-height: 1.5;
  }

  .backend-message-title {
    display: block;
    color: #212529;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .backend-message-body {
    color: #495057;
    font-size: 13px;
    line-height: 1.4;
  }

  .backend-message-close,
  .django-message-close {
    background: none;
    border: none;
    color: #6c757d;
    cursor: pointer;
    padding: 6px;
    font-size: 14px;
    transition: all 0.2s ease;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .backend-message-close:hover,
  .django-message-close:hover {
    color: #495057;
    background-color: rgba(0, 0, 0, 0.05);
  }

  .backend-message-progress {
    height: 3px;
    background: rgba(0, 0, 0, 0.1);
    width: 100%;
  }

  .backend-message.progressing .backend-message-progress {
    animation: progressBar 5s linear forwards;
  }

  @keyframes slideInBackendMessage {
    0% { transform: translateX(100%); opacity: 0; }
    100% { transform: translateX(0); opacity: 1; }
  }

  @keyframes slideOutBackendMessage {
    0% { transform: translateX(0); opacity: 1; }
    100% { transform: translateX(100%); opacity: 0; }
  }

  @keyframes progressBar {
    0% { width: 100%; }
    100% { width: 0%; }
  }

  .backend-message.slide-out {
    animation: slideOutBackendMessage 0.3s ease forwards;
  }

  @media (max-width: 768px) {
    .backend-messages-container,
    .django-messages-container {
      top: 10px;
      right: 10px;
      left: 10px;
      max-width: calc(100% - 20px);
    }
    .backend-message-content,
    .django-message-content {
      padding: 14px 16px;
    }
  }
</style>

<script>
  // Backend Messages Manager
  const BackendMessages = {
    showBackendMessage(type, title, body = '', duration = 5000) {
      const container = document.getElementById('backend-messages-container');
      const template = document.getElementById('backend-message-template');
      if (!container || !template) return null;

      const messageElement = template.cloneNode(true);
      messageElement.id = 'backend-msg-' + Date.now();
      messageElement.style.display = 'block';
      messageElement.classList.add(type);
      if (duration > 0) messageElement.classList.add('progressing');

      const iconMap = {
        'success': 'fas fa-check-circle',
        'error': 'fas fa-exclamation-circle',
        'warning': 'fas fa-exclamation-triangle',
        'info': 'fas fa-info-circle'
      };

      const iconElement = messageElement.querySelector('.backend-message-icon');
      const titleElement = messageElement.querySelector('.backend-message-title');
      const bodyElement = messageElement.querySelector('.backend-message-body');

      if (iconElement) iconElement.className = `backend-message-icon ${iconMap[type] || iconMap.info}`;
      if (titleElement) titleElement.textContent = title;
      if (bodyElement) {
        bodyElement.textContent = body;
        if (!body) bodyElement.style.display = 'none';
      }

      container.appendChild(messageElement);
      setTimeout(() => {
        messageElement.style.transform = 'translateX(0)';
        messageElement.style.opacity = '1';
      }, 10);

      if (duration > 0) {
        setTimeout(() => this.removeBackendMessage(messageElement), duration);
      }
      return messageElement.id;
    },

    removeBackendMessage(messageElement) {
      if (!messageElement) return;
      messageElement.classList.add('slide-out');
      setTimeout(() => {
        if (messageElement.parentElement) messageElement.parentElement.removeChild(messageElement);
      }, 300);
    },

    handleAjaxResponse(responseData) {
      if (!responseData) return;
      if (responseData.errors) {
        for (const [field, errors] of Object.entries(responseData.errors)) {
          errors.forEach(error => {
            this.showBackendMessage('error', `Field Error: ${field}`, error, 6000);
          });
        }
        return;
      }
      if (responseData.success === true && responseData.message) {
        this.showBackendMessage('success', 'Success', responseData.message);
      } else if (responseData.success === false && responseData.error) {
        this.showBackendMessage('error', 'Error', responseData.error);
      } else if (responseData.message) {
        this.showBackendMessage('info', 'Notice', responseData.message);
      }
      if (responseData.action === 'add_to_cart') {
        if (responseData.success) {
          this.showBackendMessage('success', 'Added to Cart', `"${responseData.product_title}" has been added to your cart.`, 4000);
        } else {
          this.showBackendMessage('error', 'Cart Error', responseData.error || 'Could not add item to cart.', 5000);
        }
      }
      if (responseData.action === 'add_to_wishlist') {
        if (responseData.success) {
          this.showBackendMessage('success', 'Added to Wishlist', `"${responseData.product_title}" has been added to your wishlist.`, 4000);
        } else {
          this.showBackendMessage('error', 'Wishlist Error', responseData.error || 'Could not add item to wishlist.', 5000);
        }
      }
    },

    interceptFetch() {
      const originalFetch = window.fetch;
      window.fetch = async function(...args) {
        try {
          const response = await originalFetch(...args);
          const clonedResponse = response.clone();
          const contentType = clonedResponse.headers.get('content-type');
          if (contentType && contentType.includes('application/json')) {
            const data = await clonedResponse.json();
            if (data) {
              setTimeout(() => BackendMessages.handleAjaxResponse(data), 100);
            }
          }
          return response;
        } catch (error) {
          BackendMessages.showBackendMessage('error', 'Network Error', 'Unable to connect to the server. Please check your connection.', 6000);
          throw error;
        }
      };
    },

    init() {
      setTimeout(() => {
        const djangoMessages = document.querySelectorAll('.django-message');
        djangoMessages.forEach(message => {
          setTimeout(() => { if (message.parentElement) message.remove(); }, 5000);
        });
      }, 1000);
      this.interceptFetch();
      window.BackendMessages = this;
    }
  };

  document.addEventListener('DOMContentLoaded', function() {
    BackendMessages.init();
  });
</script>

<script src="{% static 'builder/js/cart-manager.js' %}"></script>