{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>My Wishlist | {{ page.brand_name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  {% render_icon_data icon_customizations %}
  <style>
    :root {
      --bg-soft: #F2F7F6;
      --bg-warm: #F2E7E6;
      --accent-rose: #F388A2;
      --acleaf-moss: #7F805C;
      --accent-sand: #F2DDB3;
      --border-radius: 24px;
      --transition: all 0.3s ease;
    }

    {% generate_color_variables %}

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: var(--bg-soft);
      font-family: 'Inter', sans-serif;
      color: #1e2a2a;
      line-height: 1.5;
    }

    h1, h2, h3, h4 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .wishlist-header {
      padding: 7rem 0 2rem;
      text-align: center;
    }

    .wishlist-header h1 {
      font-size: 3rem;
      color: #2c3a2f;
      margin-bottom: 0.5rem;
    }

    .wishlist-header p {
      color: var(--acleaf-moss);
      font-size: 0.9rem;
    }

    .wishlist-stats {
      display: flex;
      justify-content: center;
      gap: 3rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }

    .stat-card {
      text-align: center;
      padding: 1rem 2rem;
      background: white;
      border-radius: var(--border-radius);
      min-width: 150px;
    }

    .stat-number {
      font-size: 2rem;
      font-weight: 600;
      color: var(--accent-rose);
    }

    .stat-label {
      font-size: 0.8rem;
      color: var(--acleaf-moss);
    }

    .wishlist-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .filter-buttons {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .filter-btn {
      padding: 0.5rem 1.2rem;
      border: 1px solid rgba(127, 128, 92, 0.3);
      border-radius: 40px;
      background: white;
      cursor: pointer;
      transition: var(--transition);
      font-size: 0.85rem;
    }

    .filter-btn.active {
      background: var(--accent-rose);
      border-color: var(--accent-rose);
      color: white;
    }

    .clear-wishlist {
      padding: 0.5rem 1.2rem;
      border: 1px solid rgba(127, 128, 92, 0.3);
      border-radius: 40px;
      background: white;
      cursor: pointer;
      transition: var(--transition);
      color: var(--accent-rose);
    }

    .clear-wishlist:hover {
      background: var(--accent-rose);
      color: white;
    }

    .wishlist-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .wishlist-card {
      background: white;
      border-radius: var(--border-radius);
      overflow: hidden;
      transition: var(--transition);
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.02);
      position: relative;
      text-decoration: none;
      display: block;
    }

    .wishlist-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
    }

    .wishlist-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .wishlist-card:hover .wishlist-img {
      transform: scale(1.02);
    }

    .wishlist-info {
      padding: 1rem 1rem 0.8rem;
      text-align: center;
    }

    .wishlist-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 500;
      color: #2c3a2f;
      margin-bottom: 0.3rem;
    }

    .wishlist-price {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--accent-rose);
      margin-bottom: 0.5rem;
    }

    .wishlist-actions-buttons {
      display: flex;
      gap: 0.8rem;
      padding: 0 1rem 1rem;
    }

    .add-to-cart-wishlist {
      flex: 1;
      background: var(--accent-rose);
      border: none;
      padding: 0.6rem;
      border-radius: 40px;
      font-size: 0.75rem;
      font-weight: 500;
      color: white;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }

    .add-to-cart-wishlist:hover {
      background: #e27a97;
      transform: translateY(-2px);
    }

    .remove-wishlist {
      background: transparent;
      border: 1px solid rgba(127, 128, 92, 0.3);
      border-radius: 40px;
      padding: 0.6rem 1rem;
      cursor: pointer;
      transition: var(--transition);
      color: var(--acleaf-moss);
    }

    .remove-wishlist:hover {
      border-color: var(--accent-rose);
      color: var(--accent-rose);
    }

    .badge {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: var(--accent-rose);
      color: white;
      padding: 0.2rem 0.6rem;
      border-radius: 20px;
      font-size: 0.7rem;
      font-weight: 500;
      z-index: 2;
    }

    .empty-wishlist {
      text-align: center;
      padding: 4rem;
      background: white;
      border-radius: var(--border-radius);
      grid-column: 1 / -1;
    }

    .empty-wishlist i {
      font-size: 4rem;
      color: var(--acleaf-moss);
      margin-bottom: 1rem;
    }

    .empty-wishlist h3 {
      font-size: 1.8rem;
      margin-bottom: 0.5rem;
    }

    .empty-wishlist p {
      color: #5b6e55;
      margin-bottom: 1.5rem;
    }

    .shop-now-btn {
      display: inline-block;
      background: var(--accent-rose);
      color: white;
      padding: 0.8rem 2rem;
      border-radius: 40px;
      text-decoration: none;
      transition: var(--transition);
    }

    .shop-now-btn:hover {
      background: #e27a97;
      transform: translateY(-2px);
    }

    .recently-viewed {
      margin-top: 3rem;
      padding-top: 3rem;
      border-top: 1px solid rgba(127, 128, 92, 0.2);
    }

    .recently-viewed h2 {
      font-size: 2rem;
      text-align: center;
      margin-bottom: 2rem;
    }

    .recent-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }

    .recent-card {
      background: white;
      border-radius: var(--border-radius);
      overflow: hidden;
      transition: var(--transition);
      text-decoration: none;
      display: block;
    }

    .recent-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
    }

    .recent-img {
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }

    .recent-info {
      padding: 0.8rem;
      text-align: center;
    }

    .recent-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 0.9rem;
      color: #2c3a2f;
      margin-bottom: 0.2rem;
    }

    .recent-price {
      font-size: 0.8rem;
      color: var(--accent-rose);
      font-weight: 500;
    }

    @media (max-width: 1200px) {
      .wishlist-grid, .recent-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 992px) {
      .wishlist-grid, .recent-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 1.5rem;
      }
      .wishlist-header {
        padding: 6rem 0 1.5rem;
      }
      .wishlist-header h1 {
        font-size: 2.2rem;
      }
      .wishlist-grid, .recent-grid {
        grid-template-columns: 1fr;
        max-width: 350px;
        margin: 0 auto;
      }
      .wishlist-stats {
        gap: 1rem;
      }
      .stat-card {
        min-width: 100px;
        padding: 0.8rem;
      }
      .stat-number {
        font-size: 1.5rem;
      }
    }

    {% generate_section_styles style_customizations 100 150 %}
    {% generate_background_images background_images 100 150 %}
    {% generate_hover_keyframes %}
  </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<div class="container">
  <!-- Wishlist Header -->
  <div class="wishlist-header" id="section-100">
    <h1 id="section-101">{{ text_contents.90|default:"My Wishlist" }}</h1>
    <p id="section-102">{{ text_contents.91|default:"Save your favorite pieces for later" }}</p>
  </div>

  <!-- Wishlist Stats -->
  <div class="wishlist-stats">
    <div class="stat-card">
      <div class="stat-number" id="totalItems">{% if wishlist_items %}{{ wishlist_items|length }}{% else %}0{% endif %}</div>
      <div class="stat-label">Items Saved</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="totalValue">{{ wish_price_total|currency:page|default:"$0" }}</div>
      <div class="stat-label">Total Value</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="onSaleCount">{{ wish_low_stock_count|default:"0" }}</div>
      <div class="stat-label">Low Stock</div>
    </div>
  </div>

  <!-- Wishlist Actions -->
  <div class="wishlist-actions">
    <div class="filter-buttons">
      <button class="filter-btn active" data-filter="all">All Items</button>
      <button class="filter-btn" data-filter="on-sale">On Sale</button>
      <button class="filter-btn" data-filter="low-stock">Low Stock</button>
    </div>
    <button class="clear-wishlist" id="clearWishlistBtn">Clear All</button>
  </div>

  <!-- Wishlist Grid -->
  <div class="wishlist-grid" id="wishlistGrid">
    {% if wishlist_items %}
      {% for item in wishlist_items %}
        {% with product=item.product %}
        <div class="wishlist-card" 
             data-product-id="{{ product.id }}"
             data-category="{{ product.category.slug|default:'jewelry' }}"
             data-stock="{% if product.quantity < 5 %}low-stock{% else %}in-stock{% endif %}"
             data-sale="{% if product.compare_at_price and product.compare_at_price > product.price %}true{% else %}false{% endif %}">
          
          {% if product.compare_at_price and product.compare_at_price > product.price %}
          <div class="badge" style="background: #7F805C;">Sale</div>
          {% elif product.quantity < 5 and product.quantity > 0 %}
          <div class="badge" style="background: #f5b342;">Low Stock</div>
          {% elif product.quantity == 0 %}
          <div class="badge" style="background: #aaa;">Out of Stock</div>
          {% elif forloop.counter == 1 %}
          <div class="badge">New</div>
          {% endif %}
          
          <img class="wishlist-img" src="{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.pexels.com/photos/2079656/pexels-photo-2079656.jpeg?auto=compress&cs=tinysrgb&w=400{% endif %}" alt="{{ product.title }}">
          <div class="wishlist-info">
            <div class="wishlist-name">{{ product.title|truncatechars:35 }}</div>
            <div class="wishlist-price">
              {{ product.price|currency:page }}
              {% if product.compare_at_price and product.compare_at_price > product.price %}
              <span style="text-decoration: line-through; color: #aaa; font-size: 0.75rem; margin-left: 0.3rem;">{{ product.compare_at_price|currency:page }}</span>
              {% endif %}
            </div>
          </div>
          <div class="wishlist-actions-buttons">
            <button class="add-to-cart-wishlist" data-product-id="{{ product.id }}" {% if product.quantity == 0 %}disabled style="opacity: 0.5;"{% endif %}>
              <i class="fas fa-shopping-bag"></i> {% if product.quantity == 0 %}Out of Stock{% else %}Add to Cart{% endif %}
            </button>
            <button class="remove-wishlist" data-product-id="{{ product.id }}"><i class="fas fa-trash-alt"></i></button>
          </div>
        </div>
        {% endwith %}
      {% endfor %}
    {% else %}
      <div class="empty-wishlist">
        <i class="far fa-heart"></i>
        <h3>Your Wishlist is Empty</h3>
        <p>Save items you love by clicking the heart icon. Come back here to view them all.</p>
        <a href="?page=shop" class="shop-now-btn">Start Shopping</a>
      </div>
    {% endif %}
  </div>

  <!-- Recently Viewed Section -->
  <div class="recently-viewed" id="section-105">
    <h2 id="section-106">{{ text_contents.94|default:"Recently Viewed" }}</h2>
    <div class="recent-grid" id="recentGrid">
      {% if recently_viewed_products %}
        {% for rvp in recently_viewed_products|slice:":4" %}
        <a href="/product/{{ rvp.product.slug }}/" class="recent-card">
          <img class="recent-img" src="{% if rvp.product.main_image %}{{ rvp.product.main_image.url }}{% else %}https://images.pexels.com/photos/2079656/pexels-photo-2079656.jpeg?auto=compress&cs=tinysrgb&w=400{% endif %}" alt="{{ rvp.product.title }}">
          <div class="recent-info">
            <div class="recent-name">{{ rvp.product.title|truncatechars:30 }}</div>
            <div class="recent-price">{{ rvp.product.price|currency:page }}</div>
          </div>
        </a>
        {% endfor %}
      {% else %}
        {% for product in products|slice:":4" %}
        <a href="/product/{{ product.slug }}/" class="recent-card">
          <img class="recent-img" src="{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.pexels.com/photos/2079656/pexels-photo-2079656.jpeg?auto=compress&cs=tinysrgb&w=400{% endif %}" alt="{{ product.title }}">
          <div class="recent-info">
            <div class="recent-name">{{ product.title|truncatechars:30 }}</div>
            <div class="recent-price">{{ product.price|currency:page }}</div>
          </div>
        </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<script src="{% static 'builder/js/cart-manager.js' %}"></script>
{% render_icon_script %}

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll('.filter-btn');
  const wishlistItems = document.querySelectorAll('.wishlist-card');
  
  function updateStats() {
    const visibleItems = document.querySelectorAll('.wishlist-card:not(.empty-placeholder)');
    const totalItems = visibleItems.length;
    let totalValue = 0;
    let onSaleCount = 0;
    
    visibleItems.forEach(item => {
      const priceText = item.querySelector('.wishlist-price').textContent;
      const price = parseFloat(priceText.replace('$', '').replace(',', '').split(' ')[0]);
      totalValue += price;
      
      const badge = item.querySelector('.badge');
      if (badge && badge.textContent.includes('Sale')) {
        onSaleCount++;
      }
    });
    
    document.getElementById('totalItems').textContent = totalItems;
    document.getElementById('totalValue').textContent = '$' + totalValue.toLocaleString('en-US', {minimumFractionDigits: 0, maximumFractionDigits: 0});
    document.getElementById('onSaleCount').textContent = onSaleCount;
  }
  
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      
      wishlistItems.forEach(item => {
        if (filter === 'all') {
          item.style.display = 'block';
        } else if (filter === 'on-sale') {
          const isOnSale = item.querySelector('.badge')?.textContent.includes('Sale');
          item.style.display = isOnSale ? 'block' : 'none';
        } else if (filter === 'low-stock') {
          const isLowStock = item.querySelector('.badge')?.textContent.includes('Low Stock');
          item.style.display = isLowStock ? 'block' : 'none';
        }
      });
      
      updateStats();
    });
  });
  
  // Remove individual item
  const removeButtons = document.querySelectorAll('.remove-wishlist');
  removeButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const productId = btn.getAttribute('data-product-id');
      const wishlistCard = btn.closest('.wishlist-card');
      
      if (window.cartManager) {
        await window.cartManager.removeFromWishlist(productId);
      }
      
      wishlistCard.remove();
      updateStats();
      
      if (document.querySelectorAll('.wishlist-card').length === 0) {
        const wishlistGrid = document.getElementById('wishlistGrid');
        wishlistGrid.innerHTML = `
          <div class="empty-wishlist">
            <i class="far fa-heart"></i>
            <h3>Your Wishlist is Empty</h3>
            <p>Save items you love by clicking the heart icon. Come back here to view them all.</p>
            <a href="?page=shop" class="shop-now-btn">Start Shopping</a>
          </div>
        `;
      }
    });
  });
  
  // Clear all wishlist items
  const clearWishlistBtn = document.getElementById('clearWishlistBtn');
  if (clearWishlistBtn) {
    clearWishlistBtn.addEventListener('click', async () => {
      if (confirm('Are you sure you want to clear your entire wishlist?')) {
        if (window.cartManager) {
          await window.cartManager.clearWishlist();
        }
        const wishlistGrid = document.getElementById('wishlistGrid');
        wishlistGrid.innerHTML = `
          <div class="empty-wishlist">
            <i class="far fa-heart"></i>
            <h3>Your Wishlist is Empty</h3>
            <p>Save items you love by clicking the heart icon. Come back here to view them all.</p>
            <a href="?page=shop" class="shop-now-btn">Start Shopping</a>
          </div>
        `;
        updateStats();
      }
    });
  }
  
  // Add to cart from wishlist
  const addToCartButtons = document.querySelectorAll('.add-to-cart-wishlist');
  addToCartButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const productId = btn.getAttribute('data-product-id');
      const originalText = btn.innerHTML;
      
      if (window.cartManager) {
        await window.cartManager.addToCart(productId, 1);
      }
      
      btn.innerHTML = '<i class="fas fa-check"></i> Added';
      btn.style.background = '#7F805C';
      
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.style.background = 'var(--accent-rose)';
      }, 1500);
    });
  });
  
  // Wishlist item click to view details (excluding button clicks)
  document.querySelectorAll('.wishlist-card').forEach(card => {
    card.addEventListener('click', (e) => {
      if (e.target.tagName === 'BUTTON' || e.target.closest('button')) {
        return;
      }
      const productLink = card.querySelector('a');
      if (productLink) {
        window.location.href = productLink.href;
      } else {
        const productId = card.getAttribute('data-product-id');
        if (productId) {
          window.location.href = `/product/${productId}/`;
        }
      }
    });
  });
  
  // Initial stats update
  updateStats();
</script>

</body>
</html>