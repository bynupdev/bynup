<!-- templates/builder/public_templates/ModernEcommerce5/products.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | {{ page.brand_name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    {% render_icon_data icon_customizations %}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-charcoal: #2A2A34;
            --color-stone-teal: #5596AA;
            --color-mist-blue: #AABFD4;
            --color-lavender-frost: #E6E8F5;
            --color-dusty-lilac: #DCD7DD;
            --bg-primary: #E6E8F5;
            --text-primary: #2A2A34;
            --accent-soft: #5596AA;
            --border-light: rgba(42, 42, 52, 0.1);
            --transition: all 0.3s ease;
        }

        {% generate_color_variables %}

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.5;
            padding-top: 90px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Shop Header */
        .shop-header {
            text-align: center;
            padding: 2rem 0 3rem;
        }

        .shop-header h1 {
            font-size: 2.5rem;
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            color: var(--color-deep-charcoal);
            margin-bottom: 0.5rem;
            position: relative;
            display: inline-block;
        }

        .shop-header h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--color-stone-teal), var(--color-mist-blue));
        }

        .shop-header p {
            color: #6a6a78;
            font-size: 1rem;
            max-width: 700px;
            margin: 1rem auto 0;
        }

        /* Shop Controls */
        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .search-container {
            flex: 1;
            max-width: 400px;
        }

        .search-input {
            width: 100%;
            padding: 0.875rem 1.25rem;
            border: 1px solid var(--border-light);
            border-radius: 50px;
            font-family: 'Inter', sans-serif;
            font-size: 0.95rem;
            background: white;
            transition: var(--transition);
        }

        .search-input:focus {
            outline: none;
            border-color: var(--color-stone-teal);
            box-shadow: 0 0 0 3px rgba(85,150,170,0.1);
        }

        .controls-right {
            display: flex;
            gap: 1rem;
            align-items: center;
        }

        .sort-select {
            padding: 0.875rem 1.25rem;
            border: 1px solid var(--border-light);
            border-radius: 50px;
            font-family: 'Inter', sans-serif;
            font-size: 0.875rem;
            background: white;
            cursor: pointer;
            transition: var(--transition);
        }

        .sort-select:hover {
            border-color: var(--color-stone-teal);
        }

        .categories-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: transparent;
            border: 1px solid var(--color-stone-teal);
            color: var(--color-stone-teal);
            padding: 0.875rem 1.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.875rem;
            transition: var(--transition);
        }

        .categories-btn:hover {
            background: var(--color-stone-teal);
            color: white;
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: 4rem;
        }

        .product-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            position: relative;
            text-decoration: none;
            display: block;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        }

        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-img {
            transform: scale(1.03);
        }

        .product-info {
            padding: 1.25rem;
        }

        .product-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-stone-teal);
            margin-bottom: 0.5rem;
        }

        .product-name {
            font-size: 1.125rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--color-deep-charcoal);
        }

        .product-price {
            font-size: 1rem;
            font-weight: 500;
            color: var(--color-stone-teal);
            margin-bottom: 1rem;
        }

        .product-actions {
            display: flex;
            gap: 0.75rem;
            margin-top: 1rem;
        }

        .btn-add-to-cart {
            flex: 1;
            background: var(--color-stone-teal);
            color: white;
            padding: 0.75rem;
            font-size: 0.875rem;
            font-weight: 500;
            border-radius: 40px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-add-to-cart:hover {
            background: #3f7688;
            transform: translateY(-2px);
        }

        .btn-wishlist {
            width: 42px;
            height: 42px;
            background: white;
            border: 1px solid var(--border-light);
            border-radius: 40px;
            color: var(--color-deep-charcoal);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-wishlist:hover {
            background: rgba(85,150,170,0.1);
            color: var(--color-stone-teal);
            border-color: var(--color-stone-teal);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 20px;
            box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
            margin: 2rem 0;
            grid-column: 1 / -1;
        }

        .empty-state h3 {
            color: var(--color-deep-charcoal);
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

        .empty-state p {
            color: #6a6a78;
            margin-bottom: 1.5rem;
        }

        .empty-state a {
            color: var(--color-stone-teal);
            text-decoration: none;
            font-weight: 500;
        }

        /* No Results State */
        .no-results {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 20px;
            margin: 2rem 0;
            grid-column: 1 / -1;
            display: none;
        }

        .no-results.active {
            display: block;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }
        }

        @media (max-width: 992px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .shop-header h1 {
                font-size: 2rem;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            .shop-controls {
                flex-direction: column;
                align-items: stretch;
            }
            .search-container {
                max-width: 100%;
            }
            .controls-right {
                justify-content: space-between;
            }
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .container {
                padding: 0 1.25rem;
            }
        }

        @media (max-width: 576px) {
            .controls-right {
                flex-direction: column;
                gap: 0.75rem;
            }
            .sort-select, .categories-btn {
                width: 100%;
                text-align: center;
                justify-content: center;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 51 70 %}
        {% generate_background_images background_images 51 70 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

    {% include 'builder/public_templates/ModernEcommerce5/snippets/header1.html' %}

    <!-- Shop Header -->
    <div class="shop-header" id="section-51">
        <div class="container">
            <h1 id="section-52">{{ text_contents.40|default:"Our Collection" }}</h1>
            <p id="section-53">{{ text_contents.41|default:"Discover thoughtfully curated pieces that bring warmth and elegance to your home" }}</p>
        </div>
    </div>

    {% for component in components %}
        {% if component.drop_zone == '51' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Shop Controls -->
    <div class="container">
        <div class="shop-controls">
            <div class="search-container">
                <input type="text" class="search-input" id="searchInput" placeholder="Search products...">
            </div>
            <div class="controls-right">
                <select class="sort-select" id="sortSelect">
                    <option value="default">Sort by: Featured</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                    <option value="newest">Newest First</option>
                </select>
                <a href="?page=categories" class="categories-btn" id="section-54">
                    <i class="fas fa-th-large" data-icon="10"></i> {{ text_contents.42|default:"Browse Categories" }}
                </a>
            </div>
        </div>
    </div>

    <!-- Products Section -->
    <div class="container">
        {% if products %}
            <div class="products-grid" id="productsGrid">
                {% for product in products %}
                    <a href="/product/{{ product.slug }}/" class="product-card" id="section-55"
                       data-product-id="{{ product.id }}"
                       data-product-title="{{ product.title }}"
                       data-product-price="{{ product.price }}"
                       data-product-category="{% if product.category %}{{ product.category.name }}{% endif %}">
                        <div class="product-img" style="background-image: url('{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.pexels.com/photos/1571459/pexels-photo-1571459.jpeg?auto=compress&cs=tinysrgb&w=600{% endif %}')"></div>
                        <div class="product-info">
                            <div class="product-category" id="section-56">
                                {{ product.category.name|default:"ACCESSORIES" }}
                            </div>
                            <div class="product-name" id="section-57">
                                {{ product.title|truncatechars:40 }}
                            </div>
                            <div class="product-price" id="section-58">
                                {{ product.price|currency:page }}
                                {% if product.compare_at_price and product.compare_at_price > product.price %}
                                    <span style="text-decoration: line-through; color: #999; font-size: 0.8rem; margin-left: 0.5rem;">
                                        {{ product.compare_at_price|currency:page }}
                                    </span>
                                {% endif %}
                            </div>
                            <div class="product-actions">
                                <button class="btn-add-to-cart" id="section-59" data-add-to-cart="{{ product.id }}">
                                    <i class="fas fa-shopping-bag" data-icon="11"></i> {{ text_contents.43|default:"Add to Cart" }}
                                </button>
                                <button class="btn-wishlist" data-add-to-wishlist="{{ product.id }}">
                                    <i class="far fa-heart" data-icon="12"></i>
                                </button>
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
            <div class="no-results" id="noResults">
                <h3>No products found</h3>
                <p>Try adjusting your search or browse our collections</p>
            </div>
        {% else %}
            <div class="empty-state">
                <h3>No Products Available</h3>
                <p>Your shop doesn't have any products yet. Start by adding your first décor piece to showcase your collection.</p>
                <p><a href="{{ SITE_DOMAIN }}/manage-products/{{ page.subdomain }}/">Add your first product</a> to get started.</p>
            </div>
        {% endif %}
    </div>

    {% for component in components %}
        {% if component.drop_zone == '55' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% include 'builder/public_templates/ModernEcommerce5/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>

    <script>
        // Search and Filter Functionality
        const searchInput = document.getElementById('searchInput');
        const sortSelect = document.getElementById('sortSelect');
        const productsGrid = document.getElementById('productsGrid');
        const noResults = document.getElementById('noResults');

        if (searchInput && sortSelect && productsGrid) {
            function filterProducts() {
                const searchTerm = searchInput.value.toLowerCase();
                const products = Array.from(document.querySelectorAll('.product-card'));
                let visibleCount = 0;

                products.forEach(product => {
                    const productName = product.getAttribute('data-product-title') || 
                                       product.querySelector('.product-name')?.textContent || '';
                    const productCategory = product.getAttribute('data-product-category') ||
                                           product.querySelector('.product-category')?.textContent || '';
                    
                    const matchesSearch = productName.toLowerCase().includes(searchTerm) ||
                                         productCategory.toLowerCase().includes(searchTerm);
                    
                    if (matchesSearch) {
                        product.style.display = 'block';
                        visibleCount++;
                    } else {
                        product.style.display = 'none';
                    }
                });

                if (visibleCount === 0 && products.length > 0) {
                    noResults.classList.add('active');
                    productsGrid.style.display = 'none';
                } else {
                    noResults.classList.remove('active');
                    productsGrid.style.display = 'grid';
                }
            }

            function sortProducts() {
                const sortValue = sortSelect.value;
                const products = Array.from(document.querySelectorAll('.product-card'));
                const visibleProducts = products.filter(p => p.style.display !== 'none');

                visibleProducts.sort((a, b) => {
                    const priceA = parseFloat(a.getAttribute('data-product-price')) || 0;
                    const priceB = parseFloat(b.getAttribute('data-product-price')) || 0;
                    
                    if (sortValue === 'price-low') {
                        return priceA - priceB;
                    } else if (sortValue === 'price-high') {
                        return priceB - priceA;
                    }
                    return 0;
                });

                visibleProducts.forEach(product => {
                    productsGrid.appendChild(product);
                });
            }

            searchInput.addEventListener('input', () => {
                filterProducts();
                sortProducts();
            });

            sortSelect.addEventListener('change', () => {
                sortProducts();
            });
        }

        // Add to Cart functionality
        document.querySelectorAll('[data-add-to-cart]').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const productId = this.getAttribute('data-add-to-cart');
                if (window.cartManager) {
                    window.cartManager.addToCart(productId, 1);
                } else {
                    console.log('Added product ' + productId + ' to cart');
                    alert('Item added to cart!');
                }
            });
        });

        // Wishlist functionality
        document.querySelectorAll('[data-add-to-wishlist]').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                const productId = this.getAttribute('data-add-to-wishlist');
                if (window.cartManager) {
                    window.cartManager.addToWishlist(productId);
                } else {
                    console.log('Added product ' + productId + ' to wishlist');
                    alert('Item added to wishlist!');
                }
            });
        });
    </script>
</body>
</html>