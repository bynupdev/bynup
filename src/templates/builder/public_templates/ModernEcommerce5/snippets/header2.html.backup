<!-- templates/builder/public_templates/ModernEcommerce16/snippets/header1.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
    :root {
        --color-deep-charcoal: #2A2A34;
        --color-stone-teal: #5596AA;
        --color-mist-blue: #AABFD4;
        --color-lavender-frost: #E6E8F5;
        --color-dusty-lilac: #DCD7DD;
        --bg-primary: #E6E8F5;
        --text-primary: #2A2A34;
        --accent-soft: #5596AA;
        --border-light: rgba(42, 42, 52, 0.1);
        --transition: all 0.3s ease;
    }

    {% generate_color_variables %}

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-primary);
        color: var(--text-primary);
        overflow-x: hidden;
        line-height: 1.5;
    }

    h1, h2, h3, h4, h5, h6 {
        font-family: 'Playfair Display', serif;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    .container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Header */
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        padding: 1.25rem 0;
        background-color: rgba(230, 232, 245, 0.95);
        backdrop-filter: blur(12px);
        box-shadow: 0 2px 20px rgba(42, 42, 52, 0.05);
        transition: var(--transition);
        border-bottom: 1px solid var(--border-light);
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    .logo a {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--color-deep-charcoal);
        text-decoration: none;
        letter-spacing: -0.02em;
    }

    .logo i {
        color: var(--color-stone-teal);
        margin-right: 0.5rem;
    }

    .desktop-nav {
        display: flex;
        gap: 2rem;
        align-items: center;
    }

    .desktop-nav a {
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 500;
        font-size: 0.95rem;
        transition: var(--transition);
        position: relative;
    }

    .desktop-nav a:hover {
        color: var(--color-stone-teal);
    }

    .desktop-nav a::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(90deg, var(--color-stone-teal), var(--color-mist-blue));
        transition: width 0.3s ease;
    }

    .desktop-nav a:hover::after {
        width: 100%;
    }

    .nav-icons {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .nav-icons i {
        font-size: 1.2rem;
        color: var(--color-deep-charcoal);
        cursor: pointer;
        transition: var(--transition);
    }

    .nav-icons i:hover {
        color: var(--color-stone-teal);
    }

    /* Account Dropdown */
    .account-dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown-content {
        display: none;
        position: absolute;
        right: 0;
        top: 100%;
        background-color: white;
        min-width: 200px;
        box-shadow: 0 8px 25px rgba(42, 42, 52, 0.1);
        z-index: 1;
        border-radius: 12px;
        overflow: hidden;
        /* margin-top: 10px; */
    }

    .dropdown-content a {
        color: var(--text-primary);
        padding: 0.75rem 1.25rem;
        text-decoration: none;
        display: block;
        font-size: 0.875rem;
        border-bottom: 1px solid rgba(42, 42, 52, 0.05);
        transition: var(--transition);
    }

    .dropdown-content a:hover {
        background-color: var(--color-lavender-frost);
        color: var(--color-stone-teal);
    }

    .account-dropdown:hover .dropdown-content {
        display: block;
    }

    /* Icon Buttons */
    .icon-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: inherit;
        padding: 0.25rem;
    }

    .cart-counter,
    .wishlist-counter {
        position: absolute;
        top: -8px;
        right: -12px;
        background-color: var(--color-stone-teal);
        color: white;
        padding: 0.2rem 0.45rem;
        border-radius: 20px;
        font-size: 0.65rem;
        font-weight: 600;
        min-width: 18px;
        text-align: center;
    }

    /* Hamburger Menu */
    .hamburger {
        display: none;
        cursor: pointer;
        font-size: 1.5rem;
        color: var(--color-deep-charcoal);
    }

    /* Mobile Navigation */
    .mobile-nav {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: var(--bg-primary);
        z-index: 9999;
        padding: 2rem;
        transform: translateX(-100%);
        transition: transform 0.4s ease;
    }

    .mobile-nav.active {
        transform: translateX(0);
        display: block;
    }

    .mobile-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-light);
    }

    .mobile-nav-header .logo {
        font-size: 1.5rem;
    }

    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .mobile-nav-links a {
        text-decoration: none;
        color: var(--text-primary);
        font-size: 1.1rem;
        font-weight: 500;
        padding: 0.5rem 0;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        border-bottom: 1px solid rgba(42, 42, 52, 0.05);
    }

    .mobile-nav-links a i {
        width: 24px;
        color: var(--color-stone-teal);
    }

    .close-mobile {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: var(--color-deep-charcoal);
    }

    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(42, 42, 52, 0.5);
        z-index: 9998;
        display: none;
    }

    .overlay.active {
        display: block;
    }

    /* Responsive */
    @media (max-width: 992px) {
        .desktop-nav {
            gap: 1.5rem;
        }
        .logo a {
            font-size: 1.5rem;
        }
    }

    @media (max-width: 768px) {
        .hamburger {
            display: block;
        }
        .desktop-nav {
            display: none;
        }
        .header-container {
            padding: 0 1.25rem;
        }
        .nav-icons {
            gap: 1rem;
        }
        body {
            padding-top: 70px;
        }
        header {
            padding: 0.875rem 0;
        }
    }

    @media (max-width: 576px) {
        .nav-icons {
            gap: 0.75rem;
        }
        .logo a {
            font-size: 1.3rem;
        }
    }

    /* Dynamic Section Styles */
    {% generate_section_styles style_customizations 1 50 %}
    {% generate_background_images background_images 1 50 %}
    {% generate_hover_keyframes %}
</style>

<!-- Header -->
<header id="section-1">
    <div class="header-container">
        <div class="logo">
            <a href="../../?page=home">
                <i class="fas fa-feather-alt" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"LUMINAE"|safe }}</span>
            </a>
        </div>
        <nav class="desktop-nav">
            <a href="../../?page=home" id="section-3">{{ text_contents.2|default:"Home" }}</a>
            <a href="../../?page=products" id="section-4">{{ text_contents.3|default:"Shop" }}</a>
            <a href="../../?page=about" id="section-5">{{ text_contents.4|default:"About Us" }}</a>
            <a href="../../?page=contact" id="section-6">{{ text_contents.5|default:"Contact" }}</a>
        </nav>
        <div class="nav-icons">
            <a href="../../?page=cart" class="icon-btn">
                <span class="cart-counter">0</span>
                <i class="fas fa-shopping-bag" data-icon="2"></i>
            </a>
            <a href="../../?page=wishlist" class="icon-btn">
                <span class="wishlist-counter">0</span>
                <i class="far fa-heart" data-icon="3"></i>
            </a>
            <div class="account-dropdown">
                <i class="far fa-user" data-icon="4"></i>
                <div class="dropdown-content">
                    <a href="{{ login_url }}" id="section-7">{{ text_contents.6|default:"Sign In" }}</a>
                    <a href="{{ registration_url }}" id="section-8">{{ text_contents.7|default:"Sign Up" }}</a>
                    <a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-9">{{ text_contents.8|default:"Orders" }}</a>
                    <a href="../../?page=wishlist" id="section-10">{{ text_contents.9|default:"Wishlist" }}</a>
                    <a href="#" id="section-11">{{ text_contents.10|default:"Account Settings" }}</a>
                </div>
            </div>
            <div class="hamburger" id="hamburgerBtn">
                <i class="fas fa-bars" data-icon="5"></i>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Navigation -->
<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <div class="logo">LUMINAE</div>
        <button class="close-mobile" id="closeMobileBtn">
            <i class="fas fa-times" data-icon="5"></i>
        </button>
    </div>
    <div class="mobile-nav-links">
        <a href="../../?page=home"><i class="fas fa-home"></i> Home</a>
        <a href="../../?page=products"><i class="fas fa-store"></i> Shop</a>
        <a href="../../?page=about"><i class="fas fa-info-circle"></i> About Us</a>
        <a href="../../?page=contact"><i class="fas fa-envelope"></i> Contact</a>
        <a href="../../?page=cart"><i class="fas fa-shopping-bag"></i> Cart</a>
        <a href="../../?page=wishlist"><i class="far fa-heart"></i> Wishlist</a>
        <a href="{{ login_url }}"><i class="fas fa-sign-in-alt"></i> Sign In</a>
        <a href="{{ registration_url }}"><i class="fas fa-user-plus"></i> Sign Up</a>
    </div>
</div>
<div class="overlay" id="overlay"></div>

<script>
    // Mobile Navigation
    const hamburger = document.getElementById('hamburgerBtn');
    const mobileNav = document.getElementById('mobileNav');
    const closeMobile = document.getElementById('closeMobileBtn');
    const overlay = document.getElementById('overlay');

    function openMobileMenu() {
        mobileNav.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
        mobileNav.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
    }

    if (hamburger) {
        hamburger.addEventListener('click', openMobileMenu);
    }

    if (closeMobile) {
        closeMobile.addEventListener('click', closeMobileMenu);
    }

    if (overlay) {
        overlay.addEventListener('click', closeMobileMenu);
    }

    const mobileNavLinks = document.querySelectorAll('.mobile-nav-links a');
    mobileNavLinks.forEach(link => {
        link.addEventListener('click', closeMobileMenu);
    });

    // Header scroll effect
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header');
        if (header && window.scrollY > 100) {
            header.style.padding = '0.875rem 0';
            header.style.boxShadow = '0 2px 20px rgba(42, 42, 52, 0.08)';
        } else if (header) {
            header.style.padding = '1.25rem 0';
            header.style.boxShadow = '0 2px 20px rgba(42, 42, 52, 0.05)';
        }
    });

    // Update cart and wishlist counters
    document.addEventListener('DOMContentLoaded', function() {
        if (window.cartManager) {
            window.cartManager.loadCartData();
        }
    });
</script>