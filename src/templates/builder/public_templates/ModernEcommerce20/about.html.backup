{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}

    <style>
        :root {
            --primary-warm: #b87a3f;
            --secondary-warm: #c8a477;
            --terracotta: #b56422;
            --sand: #d8bca4;
            --neutral-rich: #5c544c;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fefaf5;
            color: var(--neutral-rich);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1.about-title {
            font-size: 3.5rem;
            color: var(--neutral-rich);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1.about-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 140px;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-warm), var(--terracotta));
        }

        .about-subtitle {
            color: var(--neutral-rich);
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 2rem;
            opacity: 0.8;
        }

        /* Hero Section */
        .hero-about {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
            align-items: center;
        }

        .hero-image {
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: 0 15px 40px rgba(92, 84, 76, 0.1);
            height: 500px;
            width: 100%;
            object-fit: cover;
        }

        .hero-content {
            padding: var(--spacing-md);
        }

        .hero-content h2 {
            font-size: 2.5rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .hero-content p {
            color: var(--neutral-rich);
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: var(--spacing-md);
            opacity: 0.9;
        }

        .highlight-text {
            font-size: 1.3rem;
            font-style: italic;
            color: var(--primary-warm);
            border-left: 3px solid var(--primary-warm);
            padding-left: var(--spacing-sm);
            margin: var(--spacing-md) 0;
        }

        /* Mission & Values */
        .mission-values {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-lg);
            box-shadow: 0 10px 30px rgba(92, 84, 76, 0.05);
            margin-bottom: var(--spacing-xl);
        }

        .mission-values h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .values-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-lg);
        }

        .value-item {
            text-align: center;
            padding: var(--spacing-md);
        }

        .value-icon {
            font-size: 3rem;
            color: var(--primary-warm);
            margin-bottom: var(--spacing-sm);
        }

        .value-title {
            font-size: 1.8rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .value-description {
            color: var(--neutral-rich);
            font-size: 1rem;
            line-height: 1.7;
            opacity: 0.8;
        }

        .mission-statement {
            text-align: center;
            padding: var(--spacing-lg);
            background: rgba(184, 122, 63, 0.05);
            border-radius: var(--border-radius);
            margin-top: var(--spacing-lg);
        }

        .mission-statement h3 {
            font-size: 2rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .mission-statement p {
            color: var(--neutral-rich);
            font-size: 1.2rem;
            line-height: 1.8;
            max-width: 800px;
            margin: 0 auto;
            font-style: italic;
        }

        /* Craftsmanship Section */
        .craftsmanship {
            margin-bottom: var(--spacing-xl);
        }

        .craftsmanship h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .craftsmanship-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            align-items: center;
        }

        .craftsmanship-image {
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(92, 84, 76, 0.1);
            height: 400px;
            width: 100%;
            object-fit: cover;
        }

        .craftsmanship-text {
            padding: var(--spacing-md);
        }

        .craftsmanship-text h3 {
            font-size: 2rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .craftsmanship-text p {
            color: var(--neutral-rich);
            font-size: 1.1rem;
            line-height: 1.8;
            margin-bottom: var(--spacing-md);
            opacity: 0.9;
        }

        .craftsmanship-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--spacing-sm);
            margin-top: var(--spacing-md);
        }

        .stat-item {
            text-align: center;
            padding: var(--spacing-sm);
            background: rgba(184, 122, 63, 0.05);
            border-radius: var(--border-radius);
        }

        .stat-number {
            font-size: 2.2rem;
            color: var(--primary-warm);
            font-weight: 600;
            margin-bottom: 0.3rem;
        }

        .stat-label {
            color: var(--neutral-rich);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Our Story Timeline */
        .story-timeline {
            margin-bottom: var(--spacing-xl);
        }

        .story-timeline h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .timeline {
            position: relative;
            max-width: 900px;
            margin: 0 auto;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 50%;
            transform: translateX(-50%);
            width: 2px;
            height: 100%;
            background: var(--primary-warm);
        }

        .timeline-item {
            margin-bottom: var(--spacing-lg);
            position: relative;
            width: 45%;
        }

        .timeline-item:nth-child(odd) {
            margin-left: 0;
            margin-right: auto;
        }

        .timeline-item:nth-child(even) {
            margin-left: auto;
            margin-right: 0;
        }

        .timeline-content {
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-md);
            box-shadow: 0 5px 20px rgba(92, 84, 76, 0.05);
            position: relative;
        }

        .timeline-year {
            font-size: 1.5rem;
            color: var(--primary-warm);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .timeline-title {
            font-size: 1.4rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .timeline-description {
            color: var(--neutral-rich);
            font-size: 1rem;
            line-height: 1.6;
            opacity: 0.8;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            background: var(--terracotta);
            border-radius: 50%;
            top: 20px;
        }

        .timeline-item:nth-child(odd)::before {
            right: -38px;
        }

        .timeline-item:nth-child(even)::before {
            left: -38px;
        }

        /* Team Section */
        .team-section {
            margin-bottom: var(--spacing-xl);
        }

        .team-section h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .team-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-lg);
        }

        .team-member {
            text-align: center;
            background: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-md);
            box-shadow: 0 5px 20px rgba(92, 84, 76, 0.05);
            transition: var(--transition);
        }

        .team-member:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .team-member-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            margin: 0 auto var(--spacing-sm);
            object-fit: cover;
            border: 3px solid var(--sand);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.1);
            display: block;
        }

        .team-member-name {
            font-size: 1.5rem;
            color: var(--neutral-rich);
            margin-bottom: 0.5rem;
        }

        .team-member-role {
            color: var(--primary-warm);
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: var(--spacing-sm);
        }

        .team-member-bio {
            color: var(--neutral-rich);
            font-size: 0.95rem;
            line-height: 1.6;
            opacity: 0.8;
        }

        /* Commitment Section */
        .commitment {
            background: linear-gradient(135deg, var(--neutral-rich), var(--primary-warm));
            color: white;
            border-radius: var(--border-radius);
            padding: var(--spacing-xl);
            text-align: center;
            margin-bottom: var(--spacing-xl);
        }

        .commitment h2 {
            font-size: 2.5rem;
            margin-bottom: var(--spacing-md);
            color: white;
        }

        .commitment p {
            font-size: 1.2rem;
            line-height: 1.8;
            max-width: 800px;
            margin: 0 auto var(--spacing-lg);
            opacity: 0.9;
        }

        .commitment-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: var(--spacing-md);
            margin-top: var(--spacing-lg);
        }

        .commitment-stat {
            text-align: center;
        }

        .commitment-number {
            font-size: 2.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--sand);
        }

        .commitment-label {
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.9;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .team-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .values-grid,
            .craftsmanship-stats,
            .commitment-stats {
                grid-template-columns: repeat(2, 1fr);
            }
            h1.about-title {
                font-size: 3.2rem;
            }
        }

        @media (max-width: 992px) {
            .hero-about,
            .craftsmanship-content {
                grid-template-columns: 1fr;
            }
            .hero-image,
            .craftsmanship-image {
                height: 400px;
                order: -1;
            }
            .team-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1.about-title {
                font-size: 2.8rem;
            }
            .timeline::before {
                left: 30px;
            }
            .timeline-item {
                width: calc(100% - 60px);
                margin-left: 60px !important;
                margin-right: 0 !important;
            }
            .timeline-item:nth-child(odd)::before,
            .timeline-item:nth-child(even)::before {
                left: -38px;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            .hero-about {
                gap: var(--spacing-md);
                margin-bottom: var(--spacing-lg);
            }
            h1.about-title {
                font-size: 2.5rem;
            }
            .about-subtitle {
                font-size: 1.1rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .mission-values,
            .commitment {
                padding: var(--spacing-md);
            }
            .hero-content h2,
            .mission-values h2,
            .craftsmanship h2,
            .story-timeline h2,
            .team-section h2,
            .commitment h2 {
                font-size: 2rem;
            }
            .team-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            .values-grid,
            .craftsmanship-stats,
            .commitment-stats {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 576px) {
            h1.about-title {
                font-size: 2.2rem;
            }
            .about-subtitle {
                font-size: 1rem;
            }
            .hero-image,
            .craftsmanship-image {
                height: 300px;
            }
            .value-item,
            .team-member {
                padding: var(--spacing-sm);
            }
            .team-member-image {
                width: 120px;
                height: 120px;
            }
            .commitment {
                padding: var(--spacing-lg) var(--spacing-sm);
            }
            .commitment h2 {
                font-size: 1.8rem;
            }
            .commitment p {
                font-size: 1rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 149 250 %}
        {% generate_background_images background_images 149 250 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce20/snippets/header.html' %}

    {% for component in components %}
        {% if component.drop_zone == '1' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Page Header -->
    <div class="page-header" id="section-149">
        <div class="container">
            <h1 class="about-title" id="section-150">{{ text_contents.92|default:"Our Story" }}</h1>
            <p class="about-subtitle" id="section-151">{{ text_contents.93|default:"For over a decade, we have crafted premium pet essentials that combine luxury, comfort, and timeless design for discerning pet owners." }}</p>
        </div>
    </div>

    {% for component in components %}
        {% if component.drop_zone == '149' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Hero Section -->
    <div class="container">
        <div class="hero-about" id="section-152">
            <img class="hero-image" src="{% if image_customizations.27 %}{{ image_customizations.27.image_url }}{% else %}{{ about_hero_image|default:'https://images.pexels.com/photos/5324918/pexels-photo-5324918.jpeg?auto=compress&cs=tinysrgb&w=1200' }}{% endif %}" alt="{{ image_customizations.27.alt_text|default:'Luxury pet care' }}">
            <div class="hero-content" id="section-153">
                <h2 id="section-154">{{ text_contents.94|default:"Luxury Craftsmanship Since 2012" }}</h2>
                <p id="section-155">{{ text_contents.95|default:"Founded by pet lovers and design enthusiasts, LuxePaws began with a simple yet profound vision: to create pet essentials that blend exceptional quality with timeless elegance. What started as a small atelier dedicated to crafting the perfect dog bed has grown into a beloved brand trusted by pet parents worldwide." }}</p>
                <p id="section-156">{{ text_contents.96|default:"Today, guided by our founding principles of quality, comfort, and design, we continue to innovate and craft products that celebrate the special bond between pets and their people. Every piece is thoughtfully designed, meticulously crafted, and made to last." }}</p>
                <p class="highlight-text" id="section-157">{{ text_contents.97|default:"\"Every pet deserves the finest comfort. Every home deserves timeless elegance.\" - Our Founder" }}</p>
            </div>
        </div>

        <!-- Mission & Values -->
        <div class="mission-values" id="section-158">
            <h2 id="section-159">{{ text_contents.98|default:"Our Philosophy" }}</h2>
            <div class="values-grid">
                <!-- Value 1 -->
                <div class="value-item" id="section-160">
                    <div class="value-icon">
                        <i class="fas fa-gem" data-icon="25"></i>
                    </div>
                    <h3 class="value-title" id="section-161">{{ text_contents.99|default:"Uncompromising Quality" }}</h3>
                    <p class="value-description" id="section-162">{{ text_contents.100|default:"We source only the finest materials and subject every product to rigorous quality checks. Our commitment to excellence ensures your pet receives the very best." }}</p>
                </div>

                <!-- Value 2 -->
                <div class="value-item" id="section-163">
                    <div class="value-icon">
                        <i class="fas fa-heart" data-icon="26"></i>
                    </div>
                    <h3 class="value-title" id="section-164">{{ text_contents.101|default:"Pet-Centered Design" }}</h3>
                    <p class="value-description" id="section-165">{{ text_contents.102|default:"Every product is designed with your pet's comfort, health, and happiness as the priority. We consult with veterinarians and animal behaviorists to ensure optimal design." }}</p>
                </div>

                <!-- Value 3 -->
                <div class="value-item" id="section-166">
                    <div class="value-icon">
                        <i class="fas fa-leaf" data-icon="27"></i>
                    </div>
                    <h3 class="value-title" id="section-167">{{ text_contents.103|default:"Sustainable Practices" }}</h3>
                    <p class="value-description" id="section-168">{{ text_contents.104|default:"We are committed to ethical sourcing and environmentally responsible manufacturing. Our packaging is 100% recyclable, and we use eco-friendly materials whenever possible." }}</p>
                </div>
            </div>

            <div class="mission-statement" id="section-169">
                <h3 id="section-170">{{ text_contents.105|default:"Our Mission" }}</h3>
                <p id="section-171">{{ text_contents.106|default:"To create premium pet essentials that enhance the lives of pets and their people, combining exceptional craftsmanship with timeless design while maintaining ethical and sustainable practices throughout our process." }}</p>
            </div>
        </div>

        <!-- Craftsmanship Section -->
        <div class="craftsmanship" id="section-172">
            <h2 id="section-173">{{ text_contents.107|default:"The Art of Craftsmanship" }}</h2>
            <div class="craftsmanship-content">
                <div class="craftsmanship-text" id="section-174">
                    <h3 id="section-175">{{ text_contents.108|default:"Masterful Precision" }}</h3>
                    <p id="section-176">{{ text_contents.109|default:"Each LuxePaws product begins with a vision, translated into precise sketches by our design team. From these drawings, our skilled artisans select the finest materials and begin the meticulous process of creation." }}</p>
                    <p id="section-177">{{ text_contents.110|default:"Our signature construction techniques ensure exceptional durability while maintaining a soft, luxurious feel. Every stitch, every seam is carefully inspected to meet our exacting standards." }}</p>
                    <div class="craftsmanship-stats">
                        <!-- Stat 1 -->
                        <div class="stat-item" id="section-178">
                            <div class="stat-number" id="section-179">{{ text_contents.111|default:"47" }}</div>
                            <div class="stat-label" id="section-180">{{ text_contents.112|default:"Quality Checks" }}</div>
                        </div>
                        <!-- Stat 2 -->
                        <div class="stat-item" id="section-181">
                            <div class="stat-number" id="section-182">{{ text_contents.113|default:"100+" }}</div>
                            <div class="stat-label" id="section-183">{{ text_contents.114|default:"Hours of Testing" }}</div>
                        </div>
                        <!-- Stat 3 -->
                        <div class="stat-item" id="section-184">
                            <div class="stat-number" id="section-185">{{ text_contents.115|default:"98%" }}</div>
                            <div class="stat-label" id="section-186">{{ text_contents.116|default:"Customer Satisfaction" }}</div>
                        </div>
                    </div>
                </div>
                <img class="craftsmanship-image" src="{% if image_customizations.28 %}{{ image_customizations.28.image_url }}{% else %}{{ craftsmanship_image|default:'https://images.pexels.com/photos/5945781/pexels-photo-5945781.jpeg?auto=compress&cs=tinysrgb&w=800' }}{% endif %}" alt="{{ image_customizations.28.alt_text|default:'Craftsmanship process' }}">
            </div>
        </div>

        <!-- Our Story Timeline -->
        <div class="story-timeline" id="section-187">
            <h2 id="section-188">{{ text_contents.117|default:"Our Journey Through Time" }}</h2>
            <div class="timeline">
                <!-- Timeline Item 1 -->
                <div class="timeline-item" id="section-189">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-190">{{ text_contents.118|default:"2012" }}</div>
                        <h3 class="timeline-title" id="section-191">{{ text_contents.119|default:"Humble Beginnings" }}</h3>
                        <p class="timeline-description" id="section-192">{{ text_contents.120|default:"LuxePaws is founded in a small workshop, crafting premium dog beds with a focus on comfort and style. The first collection sells out within weeks." }}</p>
                    </div>
                </div>

                <!-- Timeline Item 2 -->
                <div class="timeline-item" id="section-193">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-194">{{ text_contents.121|default:"2015" }}</div>
                        <h3 class="timeline-title" id="section-195">{{ text_contents.122|default:"Expansion & Innovation" }}</h3>
                        <p class="timeline-description" id="section-196">{{ text_contents.123|default:"We expand our product line to include grooming essentials, toys, and accessories. Our signature memory foam technology is introduced." }}</p>
                    </div>
                </div>

                <!-- Timeline Item 3 -->
                <div class="timeline-item" id="section-197">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-198">{{ text_contents.124|default:"2018" }}</div>
                        <h3 class="timeline-title" id="section-199">{{ text_contents.125|default:"Sustainable Commitment" }}</h3>
                        <p class="timeline-description" id="section-200">{{ text_contents.126|default:"We transition to 100% eco-friendly packaging and begin sourcing sustainable, ethically produced materials for all products." }}</p>
                    </div>
                </div>

                <!-- Timeline Item 4 -->
                <div class="timeline-item" id="section-201">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-202">{{ text_contents.127|default:"2021" }}</div>
                        <h3 class="timeline-title" id="section-203">{{ text_contents.128|default:"Global Recognition" }}</h3>
                        <p class="timeline-description" id="section-204">{{ text_contents.129|default:"LuxePaws is recognized as a leading luxury pet brand, featured in top design publications and beloved by pet parents worldwide." }}</p>
                    </div>
                </div>

                <!-- Timeline Item 5 -->
                <div class="timeline-item" id="section-205">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-206">{{ text_contents.130|default:"2024" }}</div>
                        <h3 class="timeline-title" id="section-207">{{ text_contents.131|default:"Present Day" }}</h3>
                        <p class="timeline-description" id="section-208">{{ text_contents.132|default:"With a global community of devoted pet parents, we continue to innovate, creating timeless pieces that celebrate the bond between pets and their people." }}</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Team Section -->
        <div class="team-section" id="section-209">
            <h2 id="section-210">{{ text_contents.133|default:"Meet Our Team" }}</h2>
            <div class="team-grid">
                <!-- Team Member 1 -->
                <div class="team-member" id="section-211">
                    <img class="team-member-image" src="{% if image_customizations.29 %}{{ image_customizations.29.image_url }}{% else %}{{ team_member1_image|default:'https://images.pexels.com/photos/1560259/pexels-photo-1560259.jpeg?auto=compress&cs=tinysrgb&w=400' }}{% endif %}" alt="{{ image_customizations.29.alt_text|default:'Sarah Johnson' }}">
                    <h3 class="team-member-name" id="section-212">{{ text_contents.134|default:"Sarah Johnson" }}</h3>
                    <div class="team-member-role" id="section-213">{{ text_contents.135|default:"Founder & Creative Director" }}</div>
                    <p class="team-member-bio" id="section-214">{{ text_contents.136|default:"With a background in luxury design and a deep love for animals, Sarah founded LuxePaws to bridge the gap between pet comfort and home aesthetics. Her vision guides every product we create." }}</p>
                </div>

                <!-- Team Member 2 -->
                <div class="team-member" id="section-215">
                    <img class="team-member-image" src="{% if image_customizations.30 %}{{ image_customizations.30.image_url }}{% else %}{{ team_member2_image|default:'https://images.pexels.com/photos/1542085/pexels-photo-1542085.jpeg?auto=compress&cs=tinysrgb&w=400' }}{% endif %}" alt="{{ image_customizations.30.alt_text|default:'Dr. Michael Chen' }}">
                    <h3 class="team-member-name" id="section-216">{{ text_contents.137|default:"Dr. Michael Chen" }}</h3>
                    <div class="team-member-role" id="section-217">{{ text_contents.138|default:"Pet Wellness Advisor" }}</div>
                    <p class="team-member-bio" id="section-218">{{ text_contents.139|default:"A board-certified veterinarian with over 15 years of experience, Dr. Chen ensures every product meets the highest standards of safety and comfort for pets of all ages." }}</p>
                </div>

                <!-- Team Member 3 -->
                <div class="team-member" id="section-219">
                    <img class="team-member-image" src="{% if image_customizations.31 %}{{ image_customizations.31.image_url }}{% else %}{{ team_member3_image|default:'https://images.pexels.com/photos/1516680/pexels-photo-1516680.jpeg?auto=compress&cs=tinysrgb&w=400' }}{% endif %}" alt="{{ image_customizations.31.alt_text|default:'Emma Rodriguez' }}">
                    <h3 class="team-member-name" id="section-220">{{ text_contents.140|default:"Emma Rodriguez" }}</h3>
                    <div class="team-member-role" id="section-221">{{ text_contents.141|default:"Head of Product Design" }}</div>
                    <p class="team-member-bio" id="section-222">{{ text_contents.142|default:"Emma brings a keen eye for detail and a passion for sustainable materials. She leads our design team in creating products that are both beautiful and functional." }}</p>
                </div>

                <!-- Team Member 4 -->
                <div class="team-member" id="section-223">
                    <img class="team-member-image" src="{% if image_customizations.32 %}{{ image_customizations.32.image_url }}{% else %}{{ team_member4_image|default:'https://images.pexels.com/photos/1428126/pexels-photo-1428126.jpeg?auto=compress&cs=tinysrgb&w=400' }}{% endif %}" alt="{{ image_customizations.32.alt_text|default:'David Kim' }}">
                    <h3 class="team-member-name" id="section-224">{{ text_contents.143|default:"David Kim" }}</h3>
                    <div class="team-member-role" id="section-225">{{ text_contents.144|default:"Sustainability Director" }}</div>
                    <p class="team-member-bio" id="section-226">{{ text_contents.145|default:"David oversees our ethical sourcing initiatives and works to minimize our environmental footprint while maintaining the highest quality standards." }}</p>
                </div>
            </div>
        </div>

        <!-- Commitment Section -->
        <div class="commitment" id="section-227">
            <h2 id="section-228">{{ text_contents.146|default:"Our Commitment to Excellence" }}</h2>
            <p id="section-229">{{ text_contents.147|default:"For over a decade, our commitment has remained unwavering: to create pet essentials that not only delight today but become cherished companions for years to come. Every product we create carries this promise forward." }}</p>
            <div class="commitment-stats">
                <!-- Stat 1 -->
                <div class="commitment-stat" id="section-230">
                    <div class="commitment-number" id="section-231">{{ text_contents.148|default:"98" }}<span style="font-size: 1.8rem;">%</span></div>
                    <div class="commitment-label" id="section-232">{{ text_contents.149|default:"Customer Satisfaction" }}</div>
                </div>
                <!-- Stat 2 -->
                <div class="commitment-stat" id="section-233">
                    <div class="commitment-number" id="section-234">{{ text_contents.150|default:"50K" }}<span style="font-size: 1.8rem;">+</span></div>
                    <div class="commitment-label" id="section-235">{{ text_contents.151|default:"Happy Pets Served" }}</div>
                </div>
                <!-- Stat 3 -->
                <div class="commitment-stat" id="section-236">
                    <div class="commitment-number" id="section-237">{{ text_contents.152|default:"100" }}<span style="font-size: 1.8rem;">%</span></div>
                    <div class="commitment-label" id="section-238">{{ text_contents.153|default:"Recyclable Packaging" }}</div>
                </div>
                <!-- Stat 4 -->
                <div class="commitment-stat" id="section-239">
                    <div class="commitment-number" id="section-240">{{ text_contents.154|default:"24/7" }}</div>
                    <div class="commitment-label" id="section-241">{{ text_contents.155|default:"Customer Support" }}</div>
                </div>
            </div>
        </div>
    </div>

    {% for component in components %}
        {% if component.drop_zone == '227' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce20/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>

    <script>
        // Animation for timeline items
        document.addEventListener('DOMContentLoaded', function() {
            const timelineItems = document.querySelectorAll('.timeline-item');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, { threshold: 0.2 });

            timelineItems.forEach(item => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                observer.observe(item);
            });

            // Team member hover effects
            const teamMembers = document.querySelectorAll('.team-member');
            teamMembers.forEach(member => {
                member.addEventListener('mouseenter', function() {
                    const image = this.querySelector('.team-member-image');
                    if (image) {
                        image.style.transform = 'scale(1.05)';
                        image.style.transition = 'transform 0.3s ease';
                    }
                });
                member.addEventListener('mouseleave', function() {
                    const image = this.querySelector('.team-member-image');
                    if (image) {
                        image.style.transform = 'scale(1)';
                    }
                });
            });

            // Value items animation
            const valueItems = document.querySelectorAll('.value-item');
            valueItems.forEach((item, index) => {
                item.style.opacity = '0';
                item.style.transform = 'translateY(20px)';
                item.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
                setTimeout(() => {
                    item.style.opacity = '1';
                    item.style.transform = 'translateY(0)';
                }, 300 + (index * 100));
            });
        });
    </script>
</body>
</html>