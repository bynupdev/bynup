{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ product.title|default:"Product Details" }} | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}

    <style>
        :root {
            --primary-warm: #b87a3f;
            --secondary-warm: #c8a477;
            --terracotta: #b56422;
            --sand: #d8bca4;
            --neutral-rich: #5c544c;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }

        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fefaf5;
            color: var(--neutral-rich);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Breadcrumb */
        .breadcrumb {
            padding: var(--spacing-sm) 0;
            margin-bottom: var(--spacing-md);
            font-size: 0.9rem;
            color: var(--neutral-rich);
            opacity: 0.8;
        }

        .breadcrumb a {
            color: var(--primary-warm);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .breadcrumb span {
            margin: 0 0.5rem;
        }

        /* Product Details Layout */
        .product-details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Product Images */
        .product-images {
            position: relative;
        }

        .main-image {
            width: 100%;
            height: 500px;
            background-size: cover;
            background-position: center;
            border-radius: var(--border-radius);
            margin-bottom: var(--spacing-sm);
            box-shadow: 0 10px 30px rgba(92, 84, 76, 0.1);
            transition: var(--transition);
        }

        .thumbnail-container {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: calc(var(--border-radius) - 2px);
            background-size: cover;
            background-position: center;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .thumbnail:hover {
            transform: translateY(-3px);
            border-color: var(--primary-warm);
        }

        .thumbnail.active {
            border-color: var(--terracotta);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(181, 100, 34, 0.2);
        }

        /* Product Info */
        .product-info {
            padding: var(--spacing-md) 0;
        }

        h1.product-title {
            font-size: 3rem;
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-sm);
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: var(--spacing-sm);
        }

        .stars {
            color: var(--primary-warm);
            font-size: 1.2rem;
        }

        .rating-count {
            color: var(--neutral-rich);
            opacity: 0.7;
            font-size: 0.95rem;
        }

        .product-price {
            font-size: 2.5rem;
            color: var(--primary-warm);
            margin-bottom: var(--spacing-md);
            font-weight: 500;
        }

        .product-description {
            color: var(--neutral-rich);
            margin-bottom: var(--spacing-md);
            font-size: 1.1rem;
            line-height: 1.8;
        }

        /* Product Variants */
        .product-variants {
            margin-bottom: var(--spacing-md);
        }

        .variant-title {
            font-weight: 500;
            margin-bottom: 0.8rem;
            color: var(--neutral-rich);
            font-size: 1.1rem;
        }

        .variant-options {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .variant-option {
            padding: 0.8rem 1.5rem;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: var(--border-radius);
            background: white;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.95rem;
        }

        .variant-option:hover {
            border-color: var(--primary-warm);
            transform: translateY(-2px);
        }

        .variant-option.active {
            border-color: var(--terracotta);
            background: rgba(184, 122, 63, 0.05);
            color: var(--terracotta);
            font-weight: 500;
        }

        .color-option {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: var(--transition);
        }

        .color-option.active {
            border-color: var(--neutral-rich);
            transform: scale(1.1);
        }

        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 1rem;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
        }

        .btn-buy-now {
            flex: 2;
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: var(--nav-text, white);
            padding: 1.2rem 2rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-buy-now:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(92, 84, 76, 0.3);
        }

        .btn-add-to-cart-details {
            flex: 1;
            background: white;
            color: var(--primary-warm);
            padding: 1.2rem 2rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: 1px solid var(--primary-warm);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .btn-add-to-cart-details:hover {
            background: var(--primary-warm);
            color: var(--nav-text, white);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(184, 122, 63, 0.2);
        }

        .btn-wishlist-details {
            width: 60px;
            background: white;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: var(--border-radius);
            color: var(--neutral-rich);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.2rem;
        }

        .btn-wishlist-details:hover {
            background: rgba(184, 122, 63, 0.1);
            color: var(--primary-warm);
            border-color: var(--primary-warm);
            transform: translateY(-3px);
        }

        /* Product Details Tabs */
        .product-tabs {
            margin-bottom: var(--spacing-xl);
        }

        .tab-headers {
            display: flex;
            border-bottom: 1px solid rgba(92, 84, 76, 0.1);
            margin-bottom: var(--spacing-md);
        }

        .tab-header {
            padding: 1rem 2rem;
            background: none;
            border: none;
            color: var(--neutral-rich);
            font-size: 1.1rem;
            cursor: pointer;
            position: relative;
            transition: var(--transition);
        }

        .tab-header:hover {
            color: var(--primary-warm);
        }

        .tab-header.active {
            color: var(--primary-warm);
            font-weight: 500;
        }

        .tab-header.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--primary-warm);
        }

        .tab-content {
            display: none;
            padding: var(--spacing-md) 0;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Reviews Section */
        .review-form {
            background: white;
            padding: var(--spacing-md);
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(92, 84, 76, 0.05);
            margin-bottom: var(--spacing-lg);
        }

        .review-form h3 {
            font-size: 1.8rem;
            margin-bottom: var(--spacing-md);
            color: var(--neutral-rich);
        }

        .rating-input {
            margin-bottom: 1.5rem;
        }

        .rating-input label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--neutral-rich);
            font-weight: 500;
        }

        .star-rating-input {
            display: flex;
            gap: 0.5rem;
            font-size: 1.8rem;
            color: rgba(92, 84, 76, 0.2);
            cursor: pointer;
        }

        .star-rating-input .star:hover,
        .star-rating-input .star:hover ~ .star {
            color: var(--primary-warm);
        }

        .star-rating-input .star.selected {
            color: var(--primary-warm);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--neutral-rich);
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 1rem;
            border: 1px solid rgba(92, 84, 76, 0.2);
            border-radius: var(--border-radius);
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
            transition: var(--transition);
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-warm);
            box-shadow: 0 0 0 3px rgba(184, 122, 63, 0.1);
        }

        .btn-submit-review {
            background: linear-gradient(135deg, var(--primary-warm), var(--terracotta));
            color: var(--nav-text, white);
            padding: 1rem 2.5rem;
            font-size: 1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-submit-review:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(181, 100, 34, 0.3);
        }

        /* Customer Reviews */
        .customer-reviews {
            margin-bottom: var(--spacing-lg);
        }

        .customer-reviews h3 {
            font-size: 1.8rem;
            margin-bottom: var(--spacing-md);
            color: var(--neutral-rich);
        }

        .review-item {
            background: white;
            padding: var(--spacing-md);
            border-radius: var(--border-radius);
            margin-bottom: var(--spacing-sm);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .reviewer-name {
            font-weight: 500;
            color: var(--neutral-rich);
        }

        .review-date {
            color: rgba(92, 84, 76, 0.6);
            font-size: 0.9rem;
        }

        .review-rating {
            color: var(--primary-warm);
            margin-bottom: 0.5rem;
        }

        .review-text {
            color: var(--neutral-rich);
            line-height: 1.7;
        }

        /* Related Products */
        .related-products {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(92, 84, 76, 0.1);
        }

        .related-products h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--neutral-rich);
        }

        .related-products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .related-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .related-product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(92, 84, 76, 0.1);
        }

        .related-product-img {
            height: 250px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .related-product-card:hover .related-product-img {
            transform: scale(1.05);
        }

        .related-product-info {
            padding: 1.5rem;
        }

        .related-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            color: var(--neutral-rich);
            margin-bottom: 0.5rem;
        }

        .related-product-price {
            color: var(--primary-warm);
            font-weight: 500;
        }

        .empty-related {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 15px rgba(92, 84, 76, 0.05);
            margin: 2rem 0;
            grid-column: 1 / -1;
        }

        .empty-related h3 {
            color: var(--neutral-rich);
            margin-bottom: 0.5rem;
            font-size: 1.5rem;
        }

        .empty-related p {
            color: var(--neutral-rich);
            opacity: 0.7;
        }

        /* Success Popup */
        .popup {
            position: fixed;
            top: 20px;
            right: 20px;
            background: var(--primary-warm);
            color: white;
            padding: 20px 25px;
            border-radius: var(--border-radius);
            box-shadow: 0 4px 20px rgba(184, 122, 63, 0.3);
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 12px;
            transform: translateX(120%);
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        .popup.show {
            transform: translateX(0);
        }

        .popup-icon {
            font-size: 1.5em;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .related-products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            h1.product-title {
                font-size: 2.8rem;
            }
        }

        @media (max-width: 992px) {
            .product-details-container {
                grid-template-columns: 1fr;
                gap: var(--spacing-md);
            }
            .main-image {
                height: 400px;
            }
            .related-products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            h1.product-title {
                font-size: 2.3rem;
            }
            .product-price {
                font-size: 2rem;
            }
            .product-actions {
                flex-direction: column;
            }
            .btn-buy-now,
            .btn-add-to-cart-details {
                width: 100%;
            }
            .btn-wishlist-details {
                width: 100%;
                height: 50px;
            }
            .container {
                padding: 0 1.5rem;
            }
            .tab-headers {
                flex-direction: column;
            }
            .tab-header {
                text-align: left;
                border-bottom: 1px solid rgba(92, 84, 76, 0.1);
            }
            .tab-header.active::after {
                display: none;
            }
            .related-products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
        }

        @media (max-width: 576px) {
            h1.product-title {
                font-size: 2rem;
            }
            .main-image {
                height: 300px;
            }
            .thumbnail {
                width: 60px;
                height: 60px;
            }
            .btn-buy-now,
            .btn-add-to-cart-details,
            .btn-submit-review {
                padding: 1rem 1.5rem;
                font-size: 1rem;
            }
            .related-products h2 {
                font-size: 2rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 54 100 %}
        {% generate_background_images background_images 54 100 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce20/snippets/header.html' %}

    <!-- Success Popup -->
    <div class="popup" id="successPopup">
        <span class="popup-icon">✓</span>
        <span class="popup-message">Review submitted successfully!</span>
    </div>

    <!-- Breadcrumb -->
    <div class="breadcrumb" id="section-54">
        <div class="container">
            <a href="/?page=home">Home</a> <span>/</span>
            <a href="/?page=products">Shop</a> <span>/</span>
            {% if product.category %}
                <a href="/?page=products&category={{ product.category.slug }}">{{ product.category.name }}</a> <span>/</span>
            {% endif %}
            <span class="current-product">{{ product.title|default:"Product Details" }}</span>
        </div>
    </div>

    {% for component in components %}
        {% if component.drop_zone == '54' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Product Details -->
    <div class="container">
        {% if product %}
            <div class="product-details-container">
                <!-- Product Images -->
                <div class="product-images" id="section-55">
                    <div class="main-image" id="main-product-image"
                        style="background-image: url('{% if product.main_image %}{{ product.main_image.url }}{% elif product.image_url %}{{ product.image_url }}{% else %}https://images.pexels.com/photos/3777631/pexels-photo-3777631.jpeg?auto=compress&cs=tinysrgb&w=600{% endif %}')">
                    </div>
                    <div class="thumbnail-container">
                        {% if product.main_image %}
                            <div class="thumbnail active"
                                style="background-image: url('{{ product.main_image.url }}')"
                                data-image="{{ product.main_image.url }}">
                            </div>
                        {% endif %}
                        {% for image in product_images %}
                            <div class="thumbnail"
                                style="background-image: url('{{ image.image.url }}')"
                                data-image="{{ image.image.url }}">
                            </div>
                        {% empty %}
                            {% if product.image_gallery %}
                                {% for image_url in product.image_gallery|slice:":3" %}
                                    <div class="thumbnail {% if forloop.first and not product.main_image %}active{% endif %}"
                                        style="background-image: url('{{ image_url }}')"
                                        data-image="{{ image_url }}">
                                    </div>
                                {% endfor %}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <!-- Product Info -->
                <div class="product-info" id="section-56">
                    <h1 class="product-title" id="section-57">{{ product.title|default:"Heritage Velvet Dog Bed" }}</h1>
                    
                    <div class="product-rating star-rating-display"
                        data-rating="{{ average_rating|default:0 }}"
                        data-review-count="{{ review_count }}">
                        <div class="stars">
                            {% for i in "12345"|make_list %}
                                {% if forloop.counter <= full_stars %}
                                    <i class="fas fa-star" data-icon="14"></i>
                                {% elif forloop.counter == full_stars|add:1 and has_half_star %}
                                    <i class="fas fa-star-half-alt" data-icon="14"></i>
                                {% else %}
                                    <i class="far fa-star" data-icon="14"></i>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <span class="rating-count" id="section-58">
                            {{ average_rating|default:"4.5" }} ({{ review_count|default:"128" }} Reviews)
                        </span>
                    </div>

                    <div class="product-price" id="section-59">
                        {{ product.price|currency:page }}
                        {% if product.compare_at_price and product.compare_at_price > product.price %}
                            <span style="text-decoration: line-through; color: var(--primary-warm); font-size: 1.4rem; margin-left: 10px;">
                                {{ product.compare_at_price|currency:page }}
                            </span>
                        {% endif %}
                    </div>

                    <p class="product-description" id="section-60">
                        {{ product.short_description|default:product.description|striptags|truncatewords:50|default:"Experience the pinnacle of pet comfort with our Heritage Velvet Dog Bed. Crafted with premium velvet fabric and filled with orthopedic memory foam, this bed provides exceptional support for joints and muscles." }}
                    </p>

                    <!-- Product Color Variants -->
                    {% if colors %}
                        <div class="product-variants">
                            <div class="variant-title">Color:</div>
                            <div class="variant-options">
                                {% for color in colors %}
                                    <div class="color-option {% if forloop.first %}active{% endif %}"
                                        style="background-color: {{ color }};"
                                        title="{{ color|title }}"
                                        data-color="{{ color }}"
                                        onclick="selectColor(this, '{{ color }}')">
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <!-- Product Size Variants -->
                    {% if sizes %}
                        <div class="product-variants">
                            <div class="variant-title">Size:</div>
                            <div class="variant-options">
                                {% for size in sizes %}
                                    <div class="variant-option {% if forloop.first %}active{% endif %}"
                                        data-size="{{ size }}"
                                        onclick="selectSize(this)">
                                        {{ size }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <!-- Product Actions -->
                    <div class="product-actions">
                        <button class="btn-buy-now"
                            id="section-61"
                            data-product-id="{{ product.id }}"
                            data-product-title="{{ product.title }}"
                            data-product-price="{{ product.price }}"
                            data-product-description="{{ product.short_description|default:product.description|truncatewords:20 }}"
                            onclick="redirectToPaymentSelection(this)">
                            <i class="fas fa-bolt" data-icon="15"></i> {{ text_contents.42|default:"Buy Now" }} - {{ product.price|currency:page }}
                        </button>
                        <button class="btn-add-to-cart-details"
                            id="section-62"
                            onclick="addToCart('{{ product.id }}')">
                            <i class="fas fa-shopping-bag" data-icon="12"></i> {{ text_contents.43|default:"Add to Cart" }}
                        </button>
                        <button class="btn-wishlist-details" onclick="toggleWishlist('{{ product.id }}')">
                            <i class="far fa-heart" data-icon="13"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Product Tabs -->
            <div class="product-tabs" id="section-63">
                <div class="tab-headers">
                    <button class="tab-header active" data-tab="description">Description</button>
                    <button class="tab-header" data-tab="specifications">Specifications</button>
                    <button class="tab-header" data-tab="shipping">Shipping & Returns</button>
                    <button class="tab-header" data-tab="reviews">Reviews</button>
                </div>

                <div class="tab-content active" id="description-tab">
                    <h3>Detailed Description</h3>
                    <div class="description-content">
                        {{ product.description|safe|default:"<p>Our Heritage Velvet Dog Bed is designed with your pet's comfort and your home's aesthetic in mind. The exterior is crafted from premium velvet fabric that is both soft to the touch and durable enough to withstand daily use. The interior features high-density orthopedic memory foam that conforms to your pet's body, providing exceptional support for joints and muscles.</p><p>The bed includes a removable, machine-washable cover for easy cleaning, ensuring your pet always has a fresh and hygienic sleeping space. The non-slip bottom keeps the bed securely in place, while the elevated edges provide a sense of security and a perfect spot for resting their head.</p>" }}
                    </div>
                </div>

                <div class="tab-content" id="specifications-tab">
                    <h3>Product Specifications</h3>
                    <div class="specifications-content">
                        <ul style="list-style: none; padding-left: 0;">
                            {% if product.material %}
                                <li><strong>Material:</strong> {{ product.material }}</li>
                            {% endif %}
                            {% if product.brand %}
                                <li><strong>Brand:</strong> {{ product.brand }}</li>
                            {% endif %}
                            {% if product.colors %}
                                <li><strong>Available Colors:</strong> {{ product.colors }}</li>
                            {% endif %}
                            {% if product.sizes %}
                                <li><strong>Available Sizes:</strong> {{ product.sizes }}</li>
                            {% endif %}
                            {% if product.weight %}
                                <li><strong>Weight:</strong> {{ product.weight }} {{ product.weight_unit }}</li>
                            {% endif %}
                        </ul>
                        {% if not product.material and not product.brand %}
                            <ul style="list-style: none; padding-left: 0;">
                                <li><strong>Material:</strong> Premium Velvet Fabric</li>
                                <li><strong>Fill:</strong> Orthopedic Memory Foam</li>
                                <li><strong>Cover:</strong> Removable and Machine Washable</li>
                                <li><strong>Bottom:</strong> Non-Slip Rubber Grips</li>
                                <li><strong>Warranty:</strong> 2-Year Limited Warranty</li>
                            </ul>
                        {% endif %}
                    </div>
                </div>

                <div class="tab-content" id="shipping-tab">
                    <h3>Shipping & Returns</h3>
                    <div class="shipping-content">
                        <p><strong>Shipping:</strong> Free insured shipping worldwide. Orders typically ship within 1-2 business days and arrive in 3-7 business days.</p>
                        <p><strong>Returns:</strong> We offer a 30-day return policy. Items must be in original condition with all packaging.</p>
                        <p><strong>Warranty:</strong> All products come with a 2-year warranty against manufacturing defects.</p>
                    </div>
                </div>

                <div class="tab-content" id="reviews-tab">
                    <!-- Review Form -->
                    <div class="review-form" id="section-64">
                        <h3 id="section-65">{{ text_contents.44|default:"Add Your Review" }}</h3>
                        <form id="reviewForm" method="POST" action="{% url 'submit_review' page.subdomain %}">
                            {% csrf_token %}
                            <input type="hidden" name="product_id" value="{{ product.id }}">
                            <div class="rating-input">
                                <label>{{ text_contents.66|default:"Your Rating" }}</label>
                                <div class="star-rating-input">
                                    <input type="radio" id="star5" name="rating" value="5" style="display: none;">
                                    <label for="star5"><i class="fas fa-star" data-icon="14"></i></label>
                                    <input type="radio" id="star4" name="rating" value="4" style="display: none;">
                                    <label for="star4"><i class="fas fa-star" data-icon="14"></i></label>
                                    <input type="radio" id="star3" name="rating" value="3" style="display: none;">
                                    <label for="star3"><i class="fas fa-star" data-icon="14"></i></label>
                                    <input type="radio" id="star2" name="rating" value="2" style="display: none;">
                                    <label for="star2"><i class="fas fa-star" data-icon="14"></i></label>
                                    <input type="radio" id="star1" name="rating" value="1" style="display: none;">
                                    <label for="star1"><i class="fas fa-star" data-icon="14"></i></label>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="reviewerName">{{ text_contents.67|default:"Your Name" }}</label>
                                <input type="text" id="reviewerName" name="user_name" required>
                            </div>
                            <div class="form-group">
                                <label for="reviewTitle">{{ text_contents.68|default:"Review Title" }}</label>
                                <input type="text" id="reviewTitle" name="title" required>
                            </div>
                            <div class="form-group">
                                <label for="reviewText">{{ text_contents.69|default:"Your Review" }}</label>
                                <textarea id="reviewText" name="comment" rows="4" required></textarea>
                            </div>
                            <button type="submit" class="btn-submit-review submitBtn" id="section-66">
                                {{ text_contents.45|default:"Submit Review" }}
                            </button>
                        </form>
                    </div>

                    <!-- Customer Reviews -->
                    <div class="customer-reviews" id="section-67">
                        <h3 id="section-68">{{ text_contents.46|default:"Customer Reviews" }}</h3>
                        {% if reviews %}
                            {% for review in reviews %}
                                <div class="review-item">
                                    <div class="review-header">
                                        <div class="reviewer-name">{{ review.author_name|default:"Anonymous" }}</div>
                                        <div class="review-date">{{ review.created_at|date:"F d, Y" }}</div>
                                    </div>
                                    <div class="review-rating">
                                        {% for i in "12345"|make_list %}
                                            {% if forloop.counter <= review.rating %}
                                                <i class="fas fa-star" data-icon="14"></i>
                                            {% else %}
                                                <i class="far fa-star" data-icon="14"></i>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    <h4 style="margin-bottom: 0.5rem;">{{ review.title|default:"Great Product" }}</h4>
                                    <div class="review-text">{{ review.comment }}</div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="empty-state" style="text-align: center; padding: 2rem;">
                                <p>No reviews yet. Be the first to review this product!</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Related Products -->
            {% if related_products %}
                <div class="related-products" id="section-69">
                    <h2 id="section-70">{{ text_contents.47|default:"You May Also Like" }}</h2>
                    <div class="related-products-grid">
                        {% for related in related_products|slice:":4" %}
                            <a href="/product/{{ related.slug }}/" class="related-product-card">
                                <div class="related-product-img"
                                    style="background-image: url('{% if related.main_image %}{{ related.main_image.url }}{% elif related.image_url %}{{ related.image_url }}{% else %}https://images.pexels.com/photos/6963939/pexels-photo-6963939.jpeg?auto=compress&cs=tinysrgb&w=500{% endif %}')">
                                </div>
                                <div class="related-product-info">
                                    <div class="related-product-name">{{ related.title|truncatewords:4 }}</div>
                                    <div class="related-product-price">{{ related.price|currency:page }}</div>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="empty-related" id="section-69">
                    <h3>No Related Products</h3>
                    <p>There are currently no related products available for this item. Check back soon for new arrivals!</p>
                </div>
            {% endif %}
        {% else %}
            <div class="empty-state" style="text-align: center; padding: 4rem;">
                <h3>Product Not Found</h3>
                <p>The product you're looking for doesn't exist or has been removed.</p>
                <p><a href="/?page=products" style="color: var(--primary-warm);">Return to Shop</a></p>
            </div>
        {% endif %}
    </div>

    {% for component in components %}
        {% if component.drop_zone == '69' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce20/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}

    <!-- Hidden field for subdomain -->
    <input type="hidden" id="page-subdomain" value="{{ page.subdomain }}">

    <!-- JavaScript Files -->
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    <script src="{% static 'js/review-manager.js' %}"></script>

    <script>
        // Variants data from backend
        const VARIANTS = [
            {% for variant in variants %}
                {
                    product_id: "{{ variant.product_id }}",
                    option1: "{{ variant.option1|escapejs }}",
                    cj_vid: "{{ variant.cj_vid }}"
                }{% if not forloop.last %},{% endif %}
            {% endfor %}
        ];

        // Add the missing function definitions
        window.redirectToPaymentSelection = function(button) {
            const productId = button.dataset.productId;
            const productTitle = button.dataset.productTitle;
            const productPrice = parseFloat(button.dataset.productPrice);
            const productDescription = button.dataset.productDescription;

            const productVariants = VARIANTS.filter(
                v => String(v.product_id) === String(productId)
            );

            if (!productVariants.length) {
                const cartData = createBuyNowCartData({
                    id: productId,
                    title: productTitle,
                    description: productDescription,
                    price: productPrice,
                    quantity: 1,
                    selected_color: getSelectedColor(),
                    selected_size: getSelectedSize(),
                    cj_vid: ''
                });
                redirectToPayment(cartData);
                return;
            }

            if (productVariants.length === 1) {
                const variant = productVariants[0];
                const { color, size } = parseVariantOption(variant.option1);
                const cartData = createBuyNowCartData({
                    id: productId,
                    title: productTitle,
                    description: productDescription,
                    price: productPrice,
                    quantity: 1,
                    selected_color: color,
                    selected_size: size,
                    cj_vid: variant.cj_vid
                });
                redirectToPayment(cartData);
                return;
            }

            showVariantSelectionModal({
                productId,
                productTitle,
                productPrice,
                productDescription,
                variants: productVariants
            });
        };

        function parseVariantOption(option1) {
            if (!option1) return { color: '', size: '' };
            const normalized = option1.replace(/\//g, '-').replace(/\s*-\s*/g, '-').trim();
            const parts = normalized.split('-');
            if (parts.length < 2) return { color: '', size: '' };
            const size = parts.pop().trim();
            const color = parts.pop().trim();
            return { color, size };
        }

        function createBuyNowCartData(itemData) {
            const items = [{
                title: itemData.title,
                description: itemData.description,
                id: itemData.id,
                cj_vid: itemData.cj_vid || '',
                price: itemData.price,
                quantity: itemData.quantity || 1,
                selected_color: itemData.selected_color || '',
                selected_size: itemData.selected_size || '',
                total_price: itemData.price * (itemData.quantity || 1)
            }];
            const subtotal = items[0].total_price;
            const shipping = subtotal > 0 ? 5.00 : 0;
            const tax = subtotal * 0.08;
            const total = subtotal + shipping + tax;
            return {
                items,
                subtotal: parseFloat(subtotal.toFixed(2)),
                shipping_amount: parseFloat(shipping.toFixed(2)),
                tax_amount: parseFloat(tax.toFixed(2)),
                total_amount: parseFloat(total.toFixed(2)),
                is_buy_now: true
            };
        }

        function redirectToPayment(cartData) {
            if (!cartData.items.length) {
                alert('No items to checkout');
                return;
            }
            const hostname = window.location.hostname;
            const page_domain = document.getElementById('page-subdomain').value;
            const subdomain = hostname.includes('localhost') ? page_domain : hostname.split('.')[0];
            let urlParams;
            if (cartData.is_buy_now) {
                const product = cartData.items[0];
                urlParams = new URLSearchParams({
                    type: 'instant',
                    product: JSON.stringify({
                        title: product.title,
                        description: product.description,
                        id: product.id,
                        cj_vid: product.cj_vid,
                        price: product.price,
                        quantity: product.quantity,
                        selected_color: product.selected_color,
                        selected_size: product.selected_size,
                        total_price: product.total_price
                    })
                });
            } else {
                const cartDataForURL = {
                    items: cartData.items,
                    subtotal: cartData.subtotal,
                    shipping_amount: cartData.shipping_amount,
                    tax_amount: cartData.tax_amount,
                    total_amount: cartData.total_amount
                };
                urlParams = new URLSearchParams({
                    type: 'cart',
                    cart: JSON.stringify(cartDataForURL)
                });
            }
            window.location.href = `/payments/select-payment/${subdomain}/?${urlParams.toString()}`;
        }

        function getSelectedColor() {
            const selectedColorBtn = document.querySelector('.color-option.active');
            return selectedColorBtn ? selectedColorBtn.getAttribute('data-color') : '';
        }

        function getSelectedSize() {
            const selectedSizeBtn = document.querySelector('.variant-option.active');
            return selectedSizeBtn ? selectedSizeBtn.getAttribute('data-size') : '';
        }

        function showVariantSelectionModal(productData) {
            const { productId, productTitle, productPrice, productDescription, variants } = productData;
            const colorSet = new Set();
            const sizeSet = new Set();
            const variantMap = new Map();

            variants.forEach(v => {
                if (!v.option1) return;
                const { color, size } = parseVariantOption(v.option1);
                if (color && size) {
                    colorSet.add(color);
                    sizeSet.add(size);
                    const key = `${color}-${size}`.toLocaleLowerCase().trim();
                    variantMap.set(key, v.cj_vid);
                }
            });

            const overlay = document.createElement('div');
            overlay.style.cssText = `position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45); z-index: 9998; display: flex; justify-content: center; align-items: center;`;
            const modal = document.createElement('div');
            modal.style.cssText = `background: #fff; border-radius: 14px; padding: 24px; width: 90%; max-width: 500px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25); font-family: system-ui;`;
            
            const colorsHTML = Array.from(colorSet).map(color => `<option value="${color}">${color}</option>`).join('');
            const sizesHTML = Array.from(sizeSet).map(size => `<option value="${size}">${size}</option>`).join('');
            
            modal.innerHTML = `
                <h3 style="margin-top: 0; margin-bottom: 16px;">Select Variant</h3>
                <p style="margin-bottom: 20px; color: #666;">${productTitle}</p>
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 6px; font-weight: 500;">Color:</label>
                    <select id="buyNowColorSelect" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 16px;">
                        <option value="">Select Color</option>
                        ${colorsHTML}
                    </select>
                </div>
                <div style="margin-bottom: 16px;">
                    <label style="display: block; margin-bottom: 6px; font-weight: 500;">Size:</label>
                    <select id="buyNowSizeSelect" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 16px;">
                        <option value="">Select Size</option>
                        ${sizesHTML}
                    </select>
                </div>
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 6px; font-weight: 500;">Quantity:</label>
                    <input type="number" id="buyNowQuantity" value="1" min="1" max="10" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; font-size: 16px;">
                </div>
                <div style="display: flex; gap: 12px; justify-content: flex-end;">
                    <button id="cancelBuyNow" style="padding: 10px 18px; background: #f0f0f0; color: #333; border: none; border-radius: 8px; cursor: pointer;">Cancel</button>
                    <button id="proceedBuyNow" style="padding: 10px 18px; background: #111; color: #fff; border: none; border-radius: 8px; cursor: pointer;">Proceed to Checkout</button>
                </div>
            `;
            
            modal.querySelector('#cancelBuyNow').onclick = () => { overlay.remove(); modal.remove(); };
            modal.querySelector('#proceedBuyNow').onclick = () => {
                const selectedColor = modal.querySelector('#buyNowColorSelect').value;
                const selectedSize = modal.querySelector('#buyNowSizeSelect').value;
                const quantity = parseInt(modal.querySelector('#buyNowQuantity').value) || 1;
                if (!selectedColor || !selectedSize) {
                    alert('Please select both color and size');
                    return;
                }
                const combinationKey = `${selectedColor}-${selectedSize}`.toLowerCase().trim();
                const cjVid = variantMap.get(combinationKey);
                if (!cjVid) {
                    alert(`The combination ${selectedColor}/${selectedSize} is not available. Please select another.`);
                    return;
                }
                const cartData = createBuyNowCartData({
                    id: productId,
                    title: productTitle,
                    description: productDescription,
                    price: productPrice,
                    quantity: quantity,
                    selected_color: selectedColor,
                    selected_size: selectedSize,
                    cj_vid: cjVid
                });
                overlay.remove();
                modal.remove();
                redirectToPayment(cartData);
            };
            overlay.appendChild(modal);
            document.body.appendChild(overlay);
            modal.querySelector('#buyNowColorSelect').focus();
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Product Image Thumbnail Switcher
            const thumbnails = document.querySelectorAll('.thumbnail');
            const mainImage = document.getElementById('main-product-image');
            if (thumbnails.length > 0 && mainImage) {
                thumbnails.forEach(thumbnail => {
                    thumbnail.addEventListener('click', function() {
                        thumbnails.forEach(t => t.classList.remove('active'));
                        this.classList.add('active');
                        const newImage = this.getAttribute('data-image');
                        if (newImage) {
                            mainImage.style.backgroundImage = `url('${newImage}')`;
                        }
                    });
                });
            }

            // Product Color Variant Selection
            const colorOptions = document.querySelectorAll('.color-option');
            colorOptions.forEach(option => {
                option.addEventListener('click', function() {
                    colorOptions.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                });
            });

            // Product Size Variant Selection
            const sizeOptions = document.querySelectorAll('.variant-option');
            sizeOptions.forEach(option => {
                option.addEventListener('click', function() {
                    const parentSection = this.closest('.product-variants');
                    if (parentSection) {
                        parentSection.querySelectorAll('.variant-option').forEach(btn => {
                            btn.classList.remove('active');
                        });
                    }
                    this.classList.add('active');
                });
            });

            // Tab Switching
            const tabHeaders = document.querySelectorAll('.tab-header');
            const tabContents = document.querySelectorAll('.tab-content');
            tabHeaders.forEach(header => {
                header.addEventListener('click', function() {
                    const tabId = this.getAttribute('data-tab');
                    tabHeaders.forEach(h => h.classList.remove('active'));
                    tabContents.forEach(c => c.classList.remove('active'));
                    this.classList.add('active');
                    document.getElementById(`${tabId}-tab`).classList.add('active');
                });
            });

            // Add to Cart functionality
            window.addToCart = function(productId) {
                const quantity = 1;
                let selectedColor = getSelectedColor();
                let selectedSize = getSelectedSize();
                if (window.cartManager) {
                    window.cartManager.addToCart(productId, quantity);
                } else {
                    fetch(`/builder/cart/add/{{ page.subdomain }}/`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRFToken': getCookie('csrftoken')
                        },
                        body: JSON.stringify({
                            product_id: productId,
                            quantity: quantity,
                            selected_color: selectedColor,
                            selected_size: selectedSize
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Item added to cart!');
                            updateCartCounter(data.cart_items_count || data.cart_count || 1);
                        }
                    });
                }
            };

            // Wishlist functionality
            window.toggleWishlist = function(productId) {
                if (window.cartManager) {
                    window.cartManager.addToWishlist(productId);
                } else {
                    fetch(`/builder/wishlist/add/{{ page.subdomain }}/`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRFToken': getCookie('csrftoken')
                        },
                        body: JSON.stringify({ product_id: productId })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Added to wishlist!');
                            const wishlistBtn = document.querySelector('.btn-wishlist-details i');
                            if (wishlistBtn && wishlistBtn.classList.contains('far')) {
                                wishlistBtn.classList.remove('far');
                                wishlistBtn.classList.add('fas');
                                wishlistBtn.style.color = 'var(--primary-warm)';
                            }
                        }
                    });
                }
            };

            window.selectColor = function(element, color) {
                const colorOptions = document.querySelectorAll('.color-option');
                colorOptions.forEach(c => c.classList.remove('active'));
                element.classList.add('active');
            };

            window.selectSize = function(element) {
                const parentSection = element.closest('.product-variants');
                if (parentSection) {
                    parentSection.querySelectorAll('.variant-option').forEach(btn => {
                        btn.classList.remove('active');
                    });
                }
                element.classList.add('active');
            };

            // Star rating initialization
            const starLabels = document.querySelectorAll('.star-rating-input label');
            starLabels.forEach(star => {
                star.addEventListener('click', function() {
                    const rating = this.getAttribute('for').replace('star', '');
                    starLabels.forEach((s, index) => {
                        if (5 - index <= rating) {
                            s.style.color = 'var(--primary-warm)';
                        } else {
                            s.style.color = 'rgba(92, 84, 76, 0.2)';
                        }
                    });
                });
            });

            function updateCartCounter(count) {
                const counters = document.querySelectorAll('.cart-counter');
                counters.forEach(counter => {
                    counter.textContent = count;
                    counter.style.display = count > 0 ? 'inline' : 'none';
                });
            }

            function getCookie(name) {
                let cookieValue = null;
                if (document.cookie && document.cookie !== '') {
                    const cookies = document.cookie.split(';');
                    for (let i = 0; i < cookies.length; i++) {
                        const cookie = cookies[i].trim();
                        if (cookie.substring(0, name.length + 1) === (name + '=')) {
                            cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                            break;
                        }
                    }
                }
                return cookieValue;
            }
        });
    </script>
</body>
</html>