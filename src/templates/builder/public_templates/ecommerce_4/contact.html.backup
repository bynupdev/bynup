{% extends "builder/public_templates/ecommerce_4/base.html" %}

{% block title %}Contact - {{ page.brand_name }}{% endblock %}

{% block content %}

<style>
    
    #header-section-13{
        margin-bottom: 3rem;
        {% if style_customizations.13.background_color %}background-color: {{style_customizations.13.background_color}}{%else%} white{% endif %} ;
        {% if background_images.13.image_url %}background-image: url('{{ background_images.13.image_url }}'); background-size: cover;{% endif %}
        {% if style_customizations.13.text_color %}color:{{ style_customizations.13.text_color }}{% else %}black;{% endif %}
        {% if style_customizations.13.border_radius %}border-radius:{{ style_customizations.13.border_radius }}{% else %}8px{% endif %};
        {% if style_customizations.13.border %}border:{{ style_customizations.13.border }}{% else %}8px{% endif %};
        {% if style_customizations.13.padding %}padding:{{ style_customizations.13.padding }}{% else %}13 0{% endif %};
        {% if style_customizations.13.margin %}margin:{{ style_customizations.13.margin }}{% else %}0{% endif %};
        {% if style_customizations.13.font_family %}font-family:{{ style_customizations.13.font_family }}{% endif %};
        {% if style_customizations.13.font_size %}font-size:{{ style_customizations.13.font_size }}{% endif %};
        {% if style_customizations.13.font_weight %}font-weight:{{ style_customizations.13.font_weight }}{% endif %};

    }

    #section-14{
        margin-bottom: 3rem;
        {% if style_customizations.14.background_color %}background-color: {{style_customizations.14.background_color}}{%else%} white{% endif %} ;
        {% if background_images.14.image_url %}background-image: url('{{ background_images.14.image_url }}'); background-size: cover;{% endif %}
        {% if style_customizations.14.text_color %}color:{{ style_customizations.14.text_color }}{% else %}black{% endif %};
        {% if style_customizations.14.border_radius %}border-radius:{{ style_customizations.14.border_radius }}{% else %}8px{% endif %};
        {% if style_customizations.14.border %}border:{{ style_customizations.14.border }}{% endif %};
        {% if style_customizations.14.padding %}padding:{{ style_customizations.14.padding }}{% endif %};
        {% if style_customizations.14.margin %}margin:{{ style_customizations.14.margin }}{% endif %};
        {% if style_customizations.14.font_family %}font-family:{{ style_customizations.14.font_family }}{% endif %};
        {% if style_customizations.14.font_size %}font-size:{{ style_customizations.14.font_size }}{% endif %};
        {% if style_customizations.14.font_weight %}font-weight:{{ style_customizations.14.font_weight }}{% endif %};

    }

</style>

<strong style="background-color: red; color: var(--nav-text, white);">{{style_customizations}}</strong>
<p style="color: {{style_customizations.14.text_color}};">bro</p>

<!-- Debug info -->
<div style="background: var(--card-bg, #f8f9fa); padding: 10px; margin-bottom: 20px; border-radius: 5px; font-size: 12px;">
    <strong>Page:</strong> {{ current_page }}
</div>
<!-- Debug info (remove in production) -->
<div style="background: var(--card-bg, #f8f9fa); padding: 10px; margin-bottom: 20px; border-radius: 5px; font-size: 12px;">
    <strong>Page:</strong> {{ current_page }} | 
    <strong>Components:</strong> {{ components|length }} | 
    <strong>Texts:</strong> {{ text_contents }} |
    <br>
    <strong>Images:</strong> {{ background_images }}
    
</div>


<header id="header-section-13" style="margin-bottom: 3rem;">
    <h1>{{ text_contents.26|default:"Contact Us" }}</h1>
    <p>{{ text_contents.27|default:"Get in touch with our team" }}</p>
</header>

<section id="section-14">
    <div style="display: flex; gap: 3rem;">
        <div style="flex: 1;">
            <h3>{{ text_contents.28|default:"Contact Information" }}</h3>
            <p><strong>Email:</strong> {{ text_contents.29|default:"support@example.com" }}</p>
            <p><strong>Phone:</strong> {{ text_contents.30|default:"(555) 123-4567" }}</p>
            <p><strong>Address:</strong> {{ text_contents.31|default:"123 Business St, City, State 12345" }}</p>
        </div>
        
        <div style="flex: 1;">
            <form class="contact-form" style="max-width: 100%;">
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; margin-bottom: 0.5rem;">{{ text_contents.32|default:"Name" }}</label>
                    <input type="text" placeholder="Your name" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border-color, #ddd); border-radius: 4px;">
                </div>
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; margin-bottom: 0.5rem;">{{ 33.form_email_label|default:"Email" }}</label>
                    <input type="email" placeholder="Your email" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border-color, #ddd); border-radius: 4px;">
                </div>
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; margin-bottom: 0.5rem;">{{ 34.form_message_label|default:"Message" }}</label>
                    <textarea rows="5" placeholder="Your message" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border-color, #ddd); border-radius: 4px;"></textarea>
                </div>
                <button type="submit" style="background: var(--button-bg, #4361ee); color: var(--nav-text, white); border: none; padding: 12px 30px; border-radius: 5px; cursor: pointer;">
                    {{ text_contents.44|default:"Send Message" }}
                </button>
            </form>
        </div>
    </div>
</section>

<!-- Dynamic Components for Contact Page -->
{% for component in components %}
    {% if component.drop_zone == 'contact' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
{% endfor %}
{% endblock %}