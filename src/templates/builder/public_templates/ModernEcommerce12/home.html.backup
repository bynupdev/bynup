{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}


<!DOCTYPE html>
<html lang="en">
<head>
        
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | {{page.subdomain}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --background: #e2a970;
            --heading: #f1bb71;
            --background: #fbca8a;
            --primary: #626616;
            --secondary: #ffffff;
            --accent: #f9f6f2;
            --border: #1a1a1a;
            --success: #f8f8f8;
            --warning: #333333;
            --error: #e5e5e5;
            --gray-medium: #999999;
        }

        
        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            font-weight: 300;
            color: var(--warning);
            line-height: 1.6;
            overflow-x: hidden;
            background-color: var(--accent);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            color: var(--primary);
            letter-spacing: 0.5px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .section-padding {
            padding: 5rem 0;
        }

        .btn {
            display: inline-block;
            padding: 1rem 2.5rem;
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .btn-primary {
            background-color: var(--background);
            color: var(--secondary);
        }

        .btn-primary:hover {
            background-color: var(--heading);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .btn-secondary:hover {
            background-color: var(--primary);
            color: var(--secondary);
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}

        /* Header Styles */
        

        /* Hero Section */
        .hero {
            position: relative;
            height: 100vh;
            min-height: 700px;
            overflow: hidden;
            /* background: linear-gradient(to bottom, var(--background) 0%, rgba(251, 202, 138, 0.3) 100%); */
            background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80');
            background-size: cover;
            background-position: center 30%;
            background-repeat: no-repeat;
        }

        /* .hero-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-size: cover;
            background-position: center 30%;
            background-repeat: no-repeat;
        } */

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to right, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.1) 50%, rgba(0, 0, 0, 0.05) 100%);
        }

        .hero-content {
            position: relative;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            color: var(--secondary);
            z-index: 1;
        }

        /* New Arrivals */
        .new-arrivals {
            background-color: var(--secondary);
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2.5rem;
            margin-bottom: 4rem;
        }

        .product-card {
            position: relative;
            overflow: hidden;
        }

        .product-img {
            position: relative;
            overflow: hidden;
            height: 350px;
            background-color: var(--accent);
        }

        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-info {
            padding: 1.5rem 0.5rem;
            text-align: center;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--primary);
        }

        .product-price {
            font-size: 1rem;
            color: var(--background);
            font-weight: 500;
            letter-spacing: 1px;
        }

        /* Footer */
        
         /* Responsive Styles */
        @media (max-width: 1024px) {
            .hero-content h1 {
                font-size: 3.5rem;
            }
            
            .section-header h2 {
                font-size: 2.5rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 1.5rem;
            }
            
            .nav-desktop {
                display: none;
            }
            
            .mobile-menu-btn {
                display: block;
            }
            
            .hero-content h1 {
                font-size: 2.8rem;
            }
            
            .hero-content {
                align-items: center;
                text-align: center;
            }
            
            .section-header h2 {
                font-size: 2.2rem;
            }
            
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 2rem;
            }
            
            .footer-column {
                flex: 100%;
                margin-bottom: 2.5rem;
            }
        }

        @media (max-width: 480px) {
            .hero-content h1 {
                font-size: 2.2rem;
            }
            
            .hero-content p {
                font-size: 1rem;
            }
            
            .section-header h2 {
                font-size: 1.8rem;
            }
            
            .btn {
                padding: 0.9rem 2rem;
                font-size: 0.85rem;
            }
            
            .logo {
                font-size: 1.8rem;
            }
        }
    </style>
</head>
<body>
    {%include 'builder/public_templates/ModernEcommerce12/snippets/header1.html'%}
    <!-- Header -->
    

    {% for component in components %}
        {% if component.drop_zone == '1' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Hero Section -->
    <section class="hero" id="section-9">
        <!-- <div class="hero-background" style="background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80')"></div> -->
        <div class="hero-overlay"></div>
        
        <div class="container hero-content">
            <h1 id="section-10">{{ text_contents.7|default:'Redefining Modern Luxury' }}</h1>
            <p id="section-11">{{ text_contents.8|default:'Elevated fashion crafted for confident, timeless style. Exclusive collections from visionary designers worldwide.' }}</p>
            <a href="?page=products" class="btn btn-primary" id="section-12">{{ text_contents.9|default:"Explore the Collection" }}</a>
        </div>
    </section>

    {% for component in components %}
        {% if component.drop_zone == '9' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- New Arrivals Section -->
    <section class="new-arrivals section-padding" id="section-13">
        <div class="container">
            <div class="section-header">
                <h2 id="section-14">{{ text_contents.10|default:"New Arrivals" }}</h2>
                <p id="section-15">{{ text_contents.11|default:"Discover our latest curated selection of premium fashion pieces for the modern connoisseur." }}</p>
            </div>
            
            <div class="products-grid">
                {% if products %}
                    {% for product in products|slice:":4" %}
                        <a href="/product/{{ product.slug }}/" class="product-image-link">
                        <div class="product-card" id="section-16">
                            <div class="product-img">
                                <img src="{{ product.main_image.url }}" alt="{{ product.title }}">
                            </div>
                            <div class="product-info">
                                <h3 class="product-name" id="section-17">{{ product.title }}</h3>
                                <p class="product-price" id="section-18">{{ product.price|currency:page }}</p>
                            </div>
                        </div>
                        </a>
                    {% endfor %}
                {% else %}
                    <!-- Empty State -->
                    <div class="empty-state" style="grid-column: 1 / -1; text-align: center; padding: 4rem;">
                        <i class="fas fa-box-open" style="font-size: 3rem; color: var(--gray-medium); margin-bottom: 1.5rem;"></i>
                        <h3 style="margin-bottom: 1rem; color: var(--primary);">No Products Yet</h3>
                        <p style="color: var(--gray-medium); margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto;">
                            Your collection is currently empty. Add your first product to showcase here.
                        </p>
                        <a href="{{ SITE_DOMAIN }}/manage-products/{{ page.subdomain }}/" class="btn btn-primary">Add Your First Product</a>
                    </div>
                {% endif %}
            </div>
            
            <div class="section-cta">
                <a href="?page=products" class="btn btn-secondary" id="section-19">{{ text_contents.14|default:"View All Collections" }}</a>
            </div>
        </div>
    </section>

    {% for component in components %}
        {% if component.drop_zone == '13' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Footer -->
    

    {% for component in components %}
        {% if component.drop_zone == '20' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {%include 'builder/public_templates/ModernEcommerce12/snippets/footer.html'%}

    
</body>
</html>