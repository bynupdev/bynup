{% load style_filters %}
{%load static%}
{% load color_filters %}
{% load currency_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --background: #e2a970;
            --heading: #f1bb71;
            --background: #fbca8a;
            --primary: #626616;
            --secondary: #ffffff;
            --accent: #f9f6f2;
            --border: #1a1a1a;
            --success: #f8f8f8;
            --warning: #333333;
            --error: #e5e5e5;
            --gray-medium: #999999;
        }
        {%generate_color_variables%}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            font-weight: 300;
            color: var(--warning);
            line-height: 1.6;
            background-color: var(--accent);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            color: var(--primary);
            letter-spacing: 0.5px;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .section-padding {
            padding: 5rem 0;
        }

        .btn {
            display: inline-block;
            padding: 1rem 2.5rem;
            font-family: 'Inter', sans-serif;
            font-weight: 400;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }

        .btn-primary {
            background-color: var(--background);
            color: var(--secondary);
        }

        .btn-primary:hover {
            background-color: var(--heading);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .btn-secondary {
            background-color: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .btn-secondary:hover {
            background-color: var(--primary);
            color: var(--secondary);
        }

        .btn-sm {
            padding: 0.6rem 1.5rem;
            font-size: 0.85rem;
        }

        

        /* Shop Hero Section */
        .shop-hero {
            background: linear-gradient(to right, var(--background) 0%, rgba(251, 202, 138, 0.4) 100%);
            padding: 8rem 0 4rem;
            margin-top: 0;
            position: relative;
            overflow: hidden;
        }

        .shop-hero::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 50%;
            height: 100%;
            background-image: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80');
            background-size: cover;
            background-position: center;
            opacity: 0.1;
        }

        .shop-hero-content {
            position: relative;
            z-index: 1;
        }

        .shop-hero-content h1 {
            font-size: 3.5rem;
            margin-bottom: 1.5rem;
            color: var(--primary);
        }

        .shop-hero-content p {
            font-size: 1.1rem;
            max-width: 600px;
            margin-bottom: 2rem;
            color: var(--primary);
        }

        /* Products Section */
        .shop-products {
            padding: 4rem 0;
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-header h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .section-header p {
            font-size: 1.1rem;
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 3rem;
            margin-bottom: 4rem;
        }

        .product-card {
            position: relative;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-10px);
        }

        .product-img {
            position: relative;
            overflow: hidden;
            height: 400px;
            background-color: var(--accent);
            margin-bottom: 1.5rem;
        }

        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-img img {
            transform: scale(1.05);
        }

        .product-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, transparent 60%, rgba(0, 0, 0, 0.2) 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .product-card:hover .product-overlay {
            opacity: 1;
        }

        .product-actions {
            position: absolute;
            bottom: 1.5rem;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            opacity: 0;
            transform: translateY(10px);
            transition: all 0.3s ease;
        }

        .product-card:hover .product-actions {
            opacity: 1;
            transform: translateY(0);
        }

        .action-btn {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background-color: var(--secondary);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            color: var(--primary);
            font-size: 1rem;
        }

        .action-btn:hover {
            background-color: var(--background);
            color: var(--secondary);
            transform: scale(1.1);
        }

        .product-info {
            text-align: center;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.6rem;
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--primary);
        }

        .product-price {
            font-size: 1.1rem;
            color: var(--background);
            font-weight: 500;
            letter-spacing: 1px;
            margin-bottom: 1rem;
        }

        .product-category {
            display: inline-block;
            padding: 0.3rem 1rem;
            background-color: var(--accent);
            color: var(--primary);
            font-size: 0.8rem;
            letter-spacing: 1px;
            margin-bottom: 1rem;
            text-transform: uppercase;
        }

        .add-to-cart-btn {
            width: 100%;
            padding: 0.8rem;
            background-color: var(--primary);
            color: var(--secondary);
            border: none;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 0.5rem;
        }

        .add-to-cart-btn:hover {
            background-color: var(--background);
        }

        /* Product Badges */
        .product-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background-color: var(--background);
            color: var(--secondary);
            padding: 6px 12px;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            z-index: 2;
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 4rem;
        }

        .empty-state i {
            font-size: 3rem;
            color: var(--gray-medium);
            margin-bottom: 1.5rem;
        }

        .empty-state h3 {
            margin-bottom: 1rem;
            color: var(--primary);
        }

        .empty-state p {
            color: var(--gray-medium);
            margin-bottom: 2rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Categories CTA */
        .categories-cta {
            text-align: center;
            padding: 3rem 0;
            background-color: var(--accent);
            margin-top: 3rem;
        }

        .categories-cta h3 {
            font-size: 2rem;
            margin-bottom: 1rem;
            color: var(--primary);
        }

        .categories-cta p {
            font-size: 1.1rem;
            color: var(--gray-medium);
            max-width: 600px;
            margin: 0 auto 2rem;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 2.5rem;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 0 1.5rem;
            }
            
            .shop-hero {
                padding: 6rem 0 3rem;
            }
            
            .shop-hero-content h1 {
                font-size: 2.8rem;
            }
            
            .section-header h2 {
                font-size: 2.2rem;
            }
            
            .products-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
                gap: 2rem;
            }
            
            .product-img {
                height: 350px;
            }
        }

        @media (max-width: 480px) {
            .shop-hero-content h1 {
                font-size: 2.2rem;
            }
            
            .section-header h2 {
                font-size: 1.8rem;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 100 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 1 100 %}
        {%generate_hover_keyframes%}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
    {%include 'builder/public_templates/ModernEcommerce12/snippets/header1.html'%}
    <!-- Shop Hero Section -->
    <section class="shop-hero" id="section-41">
        <div class="container shop-hero-content">
            <h1 id="section-42">{{ text_contents.33|default:"Curated Luxury Collections" }}</h1>
            <p id="section-43">{{ text_contents.34|default:"Discover timeless pieces crafted with exceptional attention to detail and premium materials." }}</p>
            <a href="?page=categories" class="btn btn-secondary" id="section-44">{{ text_contents.35|default:"Browse by Category" }}</a>
        </div>
    </section>

    {% for component in components %}
        {% if component.drop_zone == '41' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Products Section -->
    <section class="shop-products" id="section-45">
        <div class="container">
            <div class="section-header">
                <h2 id="section-46">{{ text_contents.36|default:"Our Collection" }}</h2>
                <p id="section-47">{{ text_contents.37|default:"Exquisite fashion pieces that redefine modern elegance and sophistication." }}</p>
            </div>
            
            <div class="products-grid">
                {% if products %}
                    {% for product in products %}
                        {% if product.is_active %}
                            <div class="product-card"
                                id="section-48"
                                data-product-id="{{ product.id }}"
                                data-product-title="{{ product.title }}"
                                data-product-price="{{ product.price }}"
                                data-product-image="{% if product.main_image %}{{ product.main_image.url }}{% endif %}"
                                data-has-variants="{{ product.has_variants|yesno:'true,false' }}">
                                
                                {% if product.is_on_sale %}
                                    <div class="product-badge">Sale</div>
                                {% elif forloop.first %}
                                    <div class="product-badge">New</div>
                                {% endif %}
                                
                                <div class="product-img">
                                    {% if product.main_image %}
                                        <img src="{{ product.main_image.url }}" alt="{{ product.title }}">
                                    {% else %}
                                        <div style="background-color: #f5f5f5; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                                            <i class="fas fa-image" style="font-size: 3rem; color: #ccc;" data-icon="18"></i>
                                        </div>
                                    {% endif %}
                                    <div class="product-overlay"></div>
                                    <div class="product-actions">
                                        <button class="action-btn add-to-wishlist-btn" data-add-to-wishlist="{{ product.id }}">
                                            <i class="far fa-heart" data-icon="10"></i>
                                        </button>
                                        <a href="/product/{{ product.slug }}/" class="product-image-link">
                                            <button class="action-btn">
                                                <i class="far fa-eye" data-icon="11"></i>
                                            </button>
                                        </a>
                                    </div>
                                </div>
                                <div class="product-info">
                                    {% if product.category %}
                                        <span class="product-category" id="section-49">{{ product.category.name|default:product.category }}</span>
                                    {% endif %}
                                    <h3 class="product-name" id="section-50">{{ product.title|truncatechars:40 }}</h3>
                                    <p class="product-price" id="section-51">
                                        {{ product.price|currency:page }}
                                        {% if product.is_on_sale %}
                                            <span style="text-decoration: line-through; color: var(--gray-medium); margin-left: 8px;">
                                                {{ product.compare_at_price|currency:page }}
                                            </span>
                                            <span style="color: #ff0000; margin-left: 8px;">
                                                ({{ product.discount_percentage }}% off)
                                            </span>
                                        {% endif %}
                                    </p>
                                    <button class="add-to-cart-btn" id="section-52" data-add-to-cart="{{ product.id }}">
                                        {{ text_contents.41|default:"Add to Cart" }}
                                    </button>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                {% else %}
                    <!-- Fallback products when no products from backend -->
                    
                        <!-- Empty State -->
                    <div class="empty-state" style="grid-column: 1 / -1; text-align: center; padding: 4rem;">
                        <i class="fas fa-box-open" style="font-size: 3rem; color: var(--gray-medium); margin-bottom: 1.5rem;"></i>
                        <h3 style="margin-bottom: 1rem; color: var(--primary);">No Products Yet</h3>
                        <p style="color: var(--gray-medium); margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto;">
                            Your collection is currently empty. Add your first product to showcase here.
                        </p>
                        <a href="{{ SITE_DOMAIN }}/manage-products/{{ page.subdomain }}/" class="btn btn-primary">Add Your First Product</a>
                    </div>
                    
                {% endif %}
            </div>
            
            <!-- Products Count -->
            {% if products %}
                <div style="text-align: center; margin-top: 2rem; color: var(--gray-medium);">
                    Showing {{ products.count }} product{{ products.count|pluralize }}
                </div>
            {% endif %}
        </div>
    </section>

    {% for component in components %}
        {% if component.drop_zone == '45' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Categories CTA Section -->
    <section class="categories-cta" id="section-53">
        <div class="container">
            <h3 id="section-54">{{ text_contents.42|default:"Explore by Category" }}</h3>
            <p id="section-55">{{ text_contents.43|default:"Discover our carefully curated collections organized by style and occasion." }}</p>
            <a href="?page=categories" class="btn btn-primary" id="section-56">{{ text_contents.44|default:"View All Categories" }}</a>
        </div>
    </section>

    {% for component in components %}
        {% if component.drop_zone == '53' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {%include 'builder/public_templates/ModernEcommerce12/snippets/footer.html'%}

    <!-- Cart Manager Integration -->
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    
    <script>
        // Initialize Cart Manager when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            // Set products data from backend
            window.productsData = [
                {% for product in products %}
                {
                    id: "{{ product.id }}",
                    title: "{{ product.title|escapejs }}",
                    price: {{ product.price }},
                    image_url: "{% if product.main_image %}{{ product.main_image.url }}{% else %}{% endif %}",
                    slug: "{{ product.slug }}",
                    is_on_sale: {{ product.is_on_sale|yesno:"true,false" }},
                    compare_at_price: {{ product.compare_at_price|default:"null" }},
                    discount_percentage: {{ product.discount_percentage|default:0 }}
                }{% if not forloop.last %},{% endif %}
                {% endfor %}
            ];
            
            // Initialize Cart Manager
            const subdomain = document.body.dataset.subdomain || '{{ page.subdomain }}';
            window.cartManager = new CartManager(subdomain, {
                autoDiscover: true,
                autoCreateButtons: true
            });
            
            console.log('🛒 Cart Manager initialized for products page');
            
            // Add event listeners for cart buttons
            document.addEventListener('click', function(e) {
                // Handle add to cart buttons
                if (e.target.closest('.add-to-cart-btn')) {
                    e.preventDefault();
                    const button = e.target.closest('.add-to-cart-btn');
                    const productId = button.getAttribute('data-add-to-cart');
                    if (productId && window.cartManager) {
                        window.cartManager.addToCart(productId, 1);
                    }
                }
                
                // Handle add to wishlist buttons
                if (e.target.closest('.add-to-wishlist-btn')) {
                    e.preventDefault();
                    const button = e.target.closest('.add-to-wishlist-btn');
                    const productId = button.getAttribute('data-add-to-wishlist');
                    if (productId && window.cartManager) {
                        window.cartManager.addToWishlist(productId);
                    }
                }
            });
            
            // Load initial cart data
            if (window.cartManager) {
                window.cartManager.loadCartData();
            }
        });

        // Product card animation on scroll
        const productCards = document.querySelectorAll('.product-card');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, {
            threshold: 0.1
        });

        // Set initial state for animation
        productCards.forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(card);
        });
    </script>
</body>
</html>