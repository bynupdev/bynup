{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.brand_name }} | Modern Interior Décor</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --charcoal: #2B2C31;
            --blush: #EC4477;
            --sage: #B5C272;
            --sand: #F4E3D9;
            --cloud: #F8F9FB;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius-lg: 24px;
            --border-radius-md: 16px;
            --transition: all 0.4s cubic-bezier(0.2, 0, 0, 1);
        }
        
        {% generate_color_variables %}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cloud);
            color: var(--charcoal);
            line-height: 1.5;
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, .serif-text {
            font-family: 'Playfair Display', serif;
            font-weight: 500;
            letter-spacing: -0.02em;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        /* Header Styles */
        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(248, 249, 251, 0.96);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(43, 44, 49, 0.08);
            transition: var(--transition);
        }
        
        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 2rem;
            max-width: 1600px;
            margin: 0 auto;
        }
        
        .logo a {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 500;
            text-decoration: none;
            color: var(--charcoal);
            letter-spacing: -0.3px;
        }
        
        .nav-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }
        
        .nav-links a {
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--charcoal);
            transition: color 0.2s;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }
        
        .nav-links a:hover {
            color: var(--blush);
        }
        
        .header-icons {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }
        
        .icon-link {
            text-decoration: none;
            font-size: 1.2rem;
            color: var(--charcoal);
            transition: color 0.2s;
            position: relative;
        }
        
        .icon-link:hover {
            color: var(--blush);
        }
        
        .cart-counter, .wishlist-counter {
            position: absolute;
            top: -8px;
            right: -12px;
            background: var(--blush);
            color: white;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 50%;
        }
        
        /* Account Dropdown */
        .account-dropdown {
            position: relative;
        }
        
        .dropdown-menu {
            position: absolute;
            top: 130%;
            right: 0;
            background: white;
            border-radius: var(--border-radius-md);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
            width: 200px;
            padding: 0.5rem 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all 0.2s ease;
            z-index: 1100;
        }
        
        .account-dropdown:hover .dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        
        .dropdown-menu a {
            display: block;
            padding: 0.7rem 1.2rem;
            text-decoration: none;
            font-size: 0.85rem;
            color: var(--charcoal);
            transition: all 0.2s;
        }
        
        .dropdown-menu a:hover {
            background-color: var(--sand);
            color: var(--blush);
        }
        
        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.6rem;
            cursor: pointer;
            color: var(--charcoal);
        }
        
        /* Hero Section */
        section.hero {
            min-height: 90vh;
            position: relative;
            display: flex;
            align-items: center;
            background-color: var(--sand);
            overflow: hidden;
        }
        
        .hero-bg {
            position: absolute;
            inset: 0;
            background-image: url('https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=1600');
            background-size: cover;
            background-position: center 30%;
            z-index: 0;
        }
        
        .hero-bg::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(105deg, rgba(244, 227, 217, 0.85) 0%, rgba(244, 227, 217, 0.4) 70%);
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 680px;
            padding: 2rem;
            margin-left: 5%;
        }
        
        h1 {
            font-size: 4.2rem;
            font-weight: 500;
            color: var(--charcoal);
            line-height: 1.2;
            margin-bottom: 1.5rem;
        }
        
        .hero-sub {
            font-size: 1.2rem;
            color: rgba(43, 44, 49, 0.75);
            margin-bottom: 2rem;
            max-width: 500px;
            line-height: 1.6;
        }
        
        .primary-action {
            display: inline-block;
            background-color: var(--blush);
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: var(--transition);
            box-shadow: 0 8px 20px rgba(236, 68, 119, 0.2);
        }
        
        .primary-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(236, 68, 119, 0.3);
            background-color: #d63b6a;
        }
        
        /* New Arrivals Section */
        .new-arrivals {
            padding: var(--spacing-xl) 0;
            background-color: var(--cloud);
        }
        
        .section-header {
            text-align: center;
            margin-bottom: var(--spacing-lg);
        }
        
        h2 {
            font-size: 2.8rem;
            margin-bottom: 1rem;
            color: var(--charcoal);
        }
        
        .section-subhead {
            font-size: 1rem;
            color: rgba(43, 44, 49, 0.6);
            max-width: 600px;
            margin: 0 auto;
        }
        
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }
        
        .product-card {
            background: white;
            border-radius: var(--border-radius-lg);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
            text-decoration: none;
            color: inherit;
            display: block;
        }
        
        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }
        
        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1.1;
            background-size: cover;
            background-position: center;
            transition: transform 0.6s ease;
        }
        
        .product-card:hover .product-img {
            transform: scale(1.03);
        }
        
        .product-info {
            padding: 1.2rem 1.2rem 1.5rem;
        }
        
        .product-name {
            font-weight: 500;
            font-size: 1rem;
            margin-bottom: 0.4rem;
            color: var(--charcoal);
        }
        
        .product-price {
            font-weight: 400;
            color: var(--blush);
            font-size: 1rem;
        }
        
        .product-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--sage);
            margin-bottom: 0.5rem;
        }
        
        .see-more-link {
            display: inline-block;
            color: var(--blush);
            text-decoration: none;
            font-weight: 500;
            border-bottom: 1px solid var(--blush);
            padding-bottom: 4px;
            transition: gap 0.2s;
        }
        
        .see-more-link:hover {
            gap: 0.5rem;
            letter-spacing: 0.5px;
        }
        
        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: var(--border-radius-lg);
            grid-column: 1 / -1;
        }
        
        .empty-state h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--charcoal);
        }
        
        .empty-state a {
            color: var(--blush);
            text-decoration: none;
        }
        
        /* Mobile Navigation Panel */
        .mobile-nav-panel {
            position: fixed;
            top: 0;
            left: 0;
            width: 85%;
            max-width: 320px;
            height: 100%;
            background: white;
            z-index: 2000;
            transform: translateX(-100%);
            transition: transform 0.3s ease;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 30px rgba(0, 0, 0, 0.1);
        }
        
        .mobile-nav-panel.open {
            transform: translateX(0);
        }
        
        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--sand);
        }
        
        .back-button {
            background: none;
            border: none;
            font-size: 1rem;
            font-weight: 500;
            cursor: pointer;
            color: var(--blush);
        }
        
        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }
        
        .mobile-nav-links a {
            text-decoration: none;
            font-size: 1.1rem;
            color: var(--charcoal);
            padding: 0.5rem 0;
        }
        
        .mobile-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.3);
            z-index: 1999;
            opacity: 0;
            visibility: hidden;
            transition: 0.2s;
        }
        
        .mobile-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        
        /* Responsive */
        @media (max-width: 1024px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 1.5rem;
            }
            h1 {
                font-size: 3.2rem;
            }
        }
        
        @media (max-width: 768px) {
            .nav-links, .header-icons {
                display: none;
            }
            .mobile-menu-btn {
                display: block;
            }
            .hero-content {
                margin-left: 0;
                text-align: center;
                padding: 2rem;
            }
            .hero-sub {
                margin-left: auto;
                margin-right: auto;
            }
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 380px;
                margin-left: auto;
                margin-right: auto;
            }
            h2 {
                font-size: 2.2rem;
            }
            .container {
                padding: 0 1.2rem;
            }
        }
        
        @media (max-width: 480px) {
            h1 {
                font-size: 2.4rem;
            }
        }
        
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 30 %}
        {% generate_background_images background_images 1 30 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce23/snippets/header1.html' %}

{% for component in components %}
    {% if component.drop_zone == '1' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Hero Section -->
<section class="hero" id="section-13">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <h1 id="section-14">{{ text_contents.11|default:'Design Your Space,<br>Beautifully'|safe }}</h1>
        <p class="hero-sub" id="section-15">{{ text_contents.12|default:'Curated décor pieces that bring warmth, style, and personality into every corner of your home.' }}</p>
        <a href="?page=products" class="primary-action" id="section-16">{{ text_contents.13|default:'Shop Décor →' }}</a>
    </div>
</section>

{% for component in components %}
    {% if component.drop_zone == '13' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- New Arrivals Section -->
<section class="new-arrivals" id="section-17">
    <div class="container">
        <div class="section-header">
            <h2 id="section-18">{{ text_contents.14|default:'New Arrivals' }}</h2>
            <p class="section-subhead" id="section-19">{{ text_contents.15|default:'Fresh finds to transform your space' }}</p>
        </div>
        
        {% if products %}
            <div class="products-grid">
                {% for product in products|slice:":4" %}
                    <a href="/product/{{ product.slug }}/" class="product-card" id="section-20">
                        <div class="product-img" style="background-image: url('{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.pexels.com/photos/1583582/pexels-photo-1583582.jpeg?auto=compress&cs=tinysrgb&w=800{% endif %}')"></div>
                        <div class="product-info">
                            <div class="product-category" id="section-21">{{ product.category.name|default:"DÉCOR"|slice:":15" }}</div>
                            <div class="product-name" id="section-22">{{ product.title|truncatechars:35 }}</div>
                            <div class="product-price" id="section-23">{{ product.price|currency:page }}</div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <h3>No Products Yet</h3>
                <p>You haven't added any products to your collection yet. <a href="/admin/add-product">Add your first product</a> to get started.</p>
            </div>
        {% endif %}
        
        <div style="text-align: center;">
            <a href="?page=products" class="see-more-link" id="section-24">{{ text_contents.19|default:'View All Collections →' }}</a>
        </div>
    </div>
</section>

{% for component in components %}
    {% if component.drop_zone == '17' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce23/snippets/footer.html' %}

{% for component in components %}
    {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% render_icon_script %}

<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
    // Mobile Navigation
    const menuBtn = document.getElementById('mobileMenuBtn');
    const navPanel = document.getElementById('mobileNavPanel');
    const overlay = document.getElementById('mobileOverlay');
    const closeBtn = document.getElementById('closeNavBtn');
    
    if (menuBtn && navPanel && overlay) {
        menuBtn.addEventListener('click', () => {
            navPanel.classList.add('open');
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        });
        
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                navPanel.classList.remove('open');
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            });
        }
        
        overlay.addEventListener('click', () => {
            navPanel.classList.remove('open');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        });
    }
    
    // Header scroll effect
    window.addEventListener('scroll', () => {
        const header = document.querySelector('header');
        if (window.scrollY > 50) {
            header.style.padding = '0.5rem 0';
            header.style.boxShadow = '0 4px 20px rgba(0,0,0,0.05)';
        } else {
            header.style.padding = '';
            header.style.boxShadow = '';
        }
    });
</script>

</body>
</html>