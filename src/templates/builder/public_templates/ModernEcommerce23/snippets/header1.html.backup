{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
    :root {
        --charcoal: #2B2C31;
        --blush: #EC4477;
        --sage: #B5C272;
        --sand: #F4E3D9;
        --cloud: #F8F9FB;
        --spacing-xl: 6rem;
        --spacing-lg: 4rem;
        --spacing-md: 2rem;
        --spacing-sm: 1rem;
        --border-radius-lg: 24px;
        --border-radius-md: 16px;
        --transition: all 0.4s cubic-bezier(0.2, 0, 0, 1);
    }
    
    {% generate_color_variables %}
    
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    
    body {
        font-family: 'Inter', sans-serif;
        background-color: var(--cloud);
        color: var(--charcoal);
        line-height: 1.5;
        overflow-x: hidden;
        padding-top: 80px;
    }
    
    h1, h2, h3, h4, .serif-text {
        font-family: 'Playfair Display', serif;
        font-weight: 500;
        letter-spacing: -0.02em;
    }
    
    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }
    
    /* Header / Navigation */
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        background: rgba(248, 249, 251, 0.96);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(43, 44, 49, 0.08);
        transition: var(--transition);
    }
    
    .header-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.2rem 2rem;
        max-width: 1600px;
        margin: 0 auto;
    }
    
    .logo a {
        font-family: 'Playfair Display', serif;
        font-size: 1.8rem;
        font-weight: 500;
        text-decoration: none;
        color: var(--charcoal);
        letter-spacing: -0.3px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .logo a i {
        font-size: 1.6rem;
        color: var(--blush);
    }
    
    .nav-links {
        display: flex;
        gap: 2.5rem;
        align-items: center;
    }
    
    .nav-links a {
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--charcoal);
        transition: color 0.2s;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        position: relative;
    }
    
    .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--blush);
        transition: width 0.3s ease;
    }
    
    .nav-links a:hover::after {
        width: 100%;
    }
    
    .nav-links a:hover {
        color: var(--blush);
    }
    
    .header-icons {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }
    
    .icon-link {
        text-decoration: none;
        font-size: 1.2rem;
        color: var(--charcoal);
        transition: color 0.2s;
        position: relative;
        display: inline-flex;
        align-items: center;
        padding: 0.4rem;
    }
    
    .icon-link:hover {
        color: var(--blush);
    }
    
    .cart-counter, .wishlist-counter {
        position: absolute;
        top: -2px;
        right: -2px;
        background: var(--blush);
        color: white;
        font-size: 10px;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 50%;
        min-width: 18px;
        text-align: center;
    }
    
    /* Account Dropdown */
    .account-dropdown {
        position: relative;
    }
    
    .dropdown-menu {
        position: absolute;
        top: 130%;
        right: 0;
        background: white;
        border-radius: var(--border-radius-md);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
        width: 220px;
        padding: 0.5rem 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-8px);
        transition: all 0.2s ease;
        z-index: 1100;
    }
    
    .account-dropdown:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    
    .dropdown-menu a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem 1.2rem;
        text-decoration: none;
        font-size: 0.85rem;
        color: var(--charcoal);
        transition: all 0.2s;
    }
    
    .dropdown-menu a i {
        width: 18px;
        font-size: 0.9rem;
    }
    
    .dropdown-menu a:hover {
        background-color: var(--sand);
        color: var(--blush);
        padding-left: 1.5rem;
    }
    
    /* Hamburger Menu */
    .hamburger {
        display: none;
        cursor: pointer;
        font-size: 1.5rem;
        color: var(--charcoal);
        background: none;
        border: none;
        padding: 0.5rem;
    }
    
    .mobile-nav {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: var(--cloud);
        z-index: 9999;
        padding: 2rem;
        transform: translateX(-100%);
        transition: transform 0.4s ease;
        overflow-y: auto;
    }
    
    .mobile-nav.active {
        transform: translateX(0);
        display: block;
    }
    
    .mobile-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(43, 44, 49, 0.1);
    }
    
    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .mobile-nav-links a {
        text-decoration: none;
        color: var(--charcoal);
        font-size: 1.2rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid rgba(43, 44, 49, 0.05);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    
    .mobile-nav-links a i {
        width: 24px;
        font-size: 1.1rem;
    }
    
    .back-button {
        background: none;
        border: none;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        color: var(--blush);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .mobile-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9998;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
    }
    
    .mobile-overlay.active {
        opacity: 1;
        visibility: visible;
    }
    
    /* Responsive Styles */
    @media (max-width: 992px) {
        .nav-links {
            gap: 2rem;
        }
    }
    
    @media (max-width: 768px) {
        .hamburger {
            display: block;
        }
        
        .nav-links {
            display: none;
        }
        
        .header-icons {
            gap: 1rem;
        }
        
        .header-inner {
            padding: 1rem 1.5rem;
        }
        
        body {
            padding-top: 70px;
        }
        
        .logo a {
            font-size: 1.5rem;
        }
    }
    
    @media (max-width: 576px) {
        .header-icons .icon-link:not(.account-dropdown) {
            display: none;
        }
    }
    
    /* Dynamic Section Styles */
    {% generate_section_styles style_customizations 1 50 %}
    {% generate_background_images background_images 1 50 %}
    {% generate_hover_keyframes %}
</style>

<!-- Header -->
<header id="section-1">
    <div class="header-inner">
        <div class="logo">
            <a href="?page=home">
                <i class="fas fa-crown" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"Éclat<span style='color: var(--blush);'>Maison</span>"|safe }}</span>
            </a>
        </div>
        
        <nav class="nav-links">
            <a href="?page=home" id="section-3">{{ text_contents.2|default:"Home" }}</a>
            <a href="?page=products" id="section-4">{{ text_contents.3|default:"Shop" }}</a>
            <a href="?page=about" id="section-5">{{ text_contents.4|default:"About Us" }}</a>
            <a href="?page=contact" id="section-6">{{ text_contents.5|default:"Contact" }}</a>
        </nav>
        
        <div class="header-icons">
            <a href="?page=cart" class="icon-link">
                <i class="fas fa-shopping-bag" data-icon="2"></i>
                <span class="cart-counter">0</span>
            </a>
            <a href="?page=wishlist" class="icon-link">
                <i class="far fa-heart" data-icon="3"></i>
                <span class="wishlist-counter">0</span>
            </a>
            
            <!-- USER DROPDOWN -->
            <div class="account-dropdown">
                <i class="far fa-user" data-icon="4" onclick="toggleDropdown()" style="cursor: pointer; font-size: 1.2rem;"></i>
                <div id="dropdown" class="dropdown-menu" style="display: none;">
                    {% if show_auth_links %}
                        {% if not is_website_member %}
                            <a href="{{ website_register_url }}" id="section-7">
                                <i class="fas fa-user-plus"></i> {{ text_contents.6|default:"Sign Up" }}
                            </a>
                            <a href="{{ website_login_url }}" id="section-8">
                                <i class="fas fa-sign-in-alt"></i> {{ text_contents.7|default:"Sign In" }}
                            </a>
                            <a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-9">
                                <i class="fas fa-box"></i> {{ text_contents.8|default:"Orders" }}
                            </a>
                            <a href="?page=wishlist" id="section-10">
                                <i class="fas fa-heart"></i> {{ text_contents.9|default:"Wishlist" }}
                            </a>
                            <a href="?page=account" id="section-11">
                                <i class="fas fa-user-cog"></i> {{ text_contents.10|default:"Account Settings" }}
                            </a>
                        {% else %}
                            <a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-9">
                                <i class="fas fa-box"></i> {{ text_contents.8|default:"Orders" }}
                            </a>
                            <a href="?page=wishlist" id="section-10">
                                <i class="fas fa-heart"></i> {{ text_contents.9|default:"Wishlist" }}
                            </a>
                            <!-- <a href="?page=account" id="section-11">
                                <i class="fas fa-user-cog"></i> {{ text_contents.10|default:"Account Settings" }}
                            </a> -->
                            <a href="{{ website_logout_url }}" id="section-12">
                                <i class="fas fa-sign-out-alt"></i>  Logout 
                            </a>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
            
            <button class="hamburger" id="hamburgerBtn">
                <i class="fas fa-bars" data-icon="5"></i>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Navigation -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="?page=home" class="logo" style="font-size: 1.5rem;">Éclat<span style="color: var(--blush);">Maison</span></a>
        <button class="back-button" id="closeMobileNav">
            <i class="fas fa-times" data-icon="6"></i> Close
        </button>
    </div>
    <div class="mobile-nav-links">
        <a href="?page=home"><i class="fas fa-home"></i> {{ text_contents.2|default:"Home" }}</a>
        <a href="?page=products"><i class="fas fa-shopping-bag"></i> {{ text_contents.3|default:"Shop" }}</a>
        <a href="?page=about"><i class="fas fa-info-circle"></i> {{ text_contents.4|default:"About Us" }}</a>
        <a href="?page=contact"><i class="fas fa-envelope"></i> {{ text_contents.5|default:"Contact" }}</a>
        <a href="?page=cart"><i class="fas fa-shopping-cart"></i> Cart</a>
        <a href="?page=wishlist"><i class="far fa-heart"></i> Wishlist</a>
    </div>
    
    {% if show_auth_links %}
        <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid rgba(43, 44, 49, 0.1);">
            {% if not is_website_member %}
                <a href="{{ website_register_url }}" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                    <i class="fas fa-user-plus"></i> Sign Up
                </a>
                <a href="{{ website_login_url }}" style="display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-sign-in-alt"></i> Sign In
                </a>
            {% else %}
                <a href="{% url 'payments:customer_order_history' page.subdomain %}" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                    <i class="fas fa-box"></i> Orders
                </a>
                <a href="{{ website_logout_url }}" style="display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>

<script>
    // Mobile Navigation
    const hamburgerBtn = document.getElementById('hamburgerBtn');
    const mobileNav = document.getElementById('mobileNav');
    const mobileOverlay = document.getElementById('mobileOverlay');
    const closeMobileNav = document.getElementById('closeMobileNav');
    
    if (hamburgerBtn && mobileNav && mobileOverlay) {
        hamburgerBtn.addEventListener('click', function() {
            mobileNav.classList.add('active');
            mobileOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        });
        
        function closeMobileMenu() {
            mobileNav.classList.remove('active');
            mobileOverlay.classList.remove('active');
            document.body.style.overflow = '';
        }
        
        if (closeMobileNav) {
            closeMobileNav.addEventListener('click', closeMobileMenu);
        }
        
        mobileOverlay.addEventListener('click', closeMobileMenu);
        
        const mobileLinks = document.querySelectorAll('.mobile-nav-links a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', closeMobileMenu);
        });
    }
    
    // User Dropdown Toggle
    function toggleDropdown() {
        const dropdown = document.getElementById('dropdown');
        if (dropdown) {
            const isVisible = dropdown.style.display === 'block';
            dropdown.style.display = isVisible ? 'none' : 'block';
            dropdown.style.opacity = isVisible ? '0' : '1';
            dropdown.style.transform = isVisible ? 'translateY(-8px)' : 'translateY(0)';
        }
    }
    
    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('dropdown');
        const userIcon = document.querySelector('.fa-user');
        if (dropdown && userIcon && !userIcon.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
            dropdown.style.opacity = '0';
            dropdown.style.transform = 'translateY(-8px)';
        }
    });
    
    // Header scroll effect
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header');
        if (window.scrollY > 50) {
            header.style.padding = '0.5rem 0';
            header.style.boxShadow = '0 4px 20px rgba(0,0,0,0.05)';
        } else {
            header.style.padding = '';
            header.style.boxShadow = '';
        }
    });
</script>