{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
    /* Footer Styles */
    footer {
        background-color: var(--charcoal);
        color: var(--cloud);
        padding: var(--spacing-xl) 0 var(--spacing-lg);
        margin-top: var(--spacing-xl);
    }
    
    .footer-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }
    
    .footer-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 3rem;
        margin-bottom: 3rem;
    }
    
    .footer-column h3 {
        font-family: 'Playfair Display', serif;
        font-size: 1.3rem;
        font-weight: 500;
        margin-bottom: 1.5rem;
        color: var(--blush);
        position: relative;
        display: inline-block;
    }
    
    .footer-column h3::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 40px;
        height: 2px;
        background: var(--blush);
    }
    
    .footer-column p {
        color: rgba(248, 249, 251, 0.7);
        line-height: 1.6;
        margin-bottom: 1rem;
    }
    
    .footer-column ul {
        list-style: none;
        padding: 0;
    }
    
    .footer-column ul li {
        margin-bottom: 0.8rem;
    }
    
    .footer-column ul li a {
        color: rgba(248, 249, 251, 0.7);
        text-decoration: none;
        transition: var(--transition);
        display: inline-block;
    }
    
    .footer-column ul li a:hover {
        color: var(--blush);
        transform: translateX(5px);
    }
    
    /* Social Media Section */
    .footer-social {
        margin-top: 1rem;
    }
    
    .footer-social h4 {
        font-size: 1.1rem;
        margin-bottom: 1rem;
        color: var(--cloud);
    }
    
    .social-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }
    
    .social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: rgba(248, 249, 251, 0.1);
        color: var(--cloud);
        text-decoration: none;
        transition: var(--transition);
        position: relative;
    }
    
    .social-link:hover {
        background: var(--blush);
        transform: translateY(-3px);
        color: white;
    }
    
    .social-link i {
        font-size: 1.2rem;
    }
    
    /* Newsletter Section */
    .newsletter-section {
        margin-top: 1rem;
    }
    
    .newsletter-form {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
    }
    
    .newsletter-input {
        flex: 1;
        padding: 0.8rem 1rem;
        border: 1px solid rgba(248, 249, 251, 0.2);
        background: rgba(248, 249, 251, 0.05);
        border-radius: 50px;
        color: var(--cloud);
        font-family: 'Inter', sans-serif;
        font-size: 0.9rem;
    }
    
    .newsletter-input::placeholder {
        color: rgba(248, 249, 251, 0.5);
    }
    
    .newsletter-input:focus {
        outline: none;
        border-color: var(--blush);
    }
    
    .newsletter-btn {
        padding: 0.8rem 1.5rem;
        background: var(--blush);
        color: white;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        font-weight: 500;
        transition: var(--transition);
    }
    
    .newsletter-btn:hover {
        background: #d63b6a;
        transform: translateY(-2px);
    }
    
    /* Contact Info */
    .contact-info-item {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin-bottom: 1rem;
        color: rgba(248, 249, 251, 0.7);
    }
    
    .contact-info-item i {
        width: 24px;
        color: var(--blush);
        font-size: 1rem;
    }
    
    /* Copyright */
    .footer-bottom {
        text-align: center;
        padding-top: 2rem;
        margin-top: 2rem;
        border-top: 1px solid rgba(248, 249, 251, 0.1);
        color: rgba(248, 249, 251, 0.6);
        font-size: 0.85rem;
    }
    
    .footer-bottom a {
        color: var(--blush);
        text-decoration: none;
    }
    
    .footer-bottom a:hover {
        text-decoration: underline;
    }
    
    /* Responsive */
    @media (max-width: 992px) {
        .footer-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 2rem;
        }
    }
    
    @media (max-width: 768px) {
        .footer-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        
        .newsletter-form {
            flex-direction: column;
        }
        
        .newsletter-btn {
            width: 100%;
        }
        
        .footer-container {
            padding: 0 1.5rem;
        }
        
        footer {
            padding: var(--spacing-lg) 0;
        }
    }
</style>

<footer id="section-25">
    <div class="footer-container">
        <div class="footer-grid">
            <!-- Brand Column -->
            <div class="footer-column" id="section-26">
                <h3 id="section-27">{{ text_contents.20|default:"Éclat Maison" }}</h3>
                <p id="section-28">{{ text_contents.21|default:"Curating timeless interior décor pieces that transform houses into homes. Founded with a passion for elegance and craftsmanship." }}</p>
                
                <!-- Social Media Links -->
                <div class="footer-social">
                    <h4>Follow Us</h4>
                    <div class="social-links">
                        {% if page.social_media.all %}
                            {% for social in page.social_media.all %}
                                {% if social.is_active %}
                                    <a href="{{ social.get_url }}" class="social-link" target="{{ social.open_in_new_tab|yesno:'_blank,_self' }}" rel="noopener noreferrer" title="{{ social.display_name|default:social.get_platform_display }}">
                                        <i class="{{ social.get_icon }}" data-icon="social-{{ forloop.counter }}"></i>
                                    </a>
                                {% endif %}
                            {% endfor %}

                            
                            
                        {% endif %}
                    </div>
                </div>
            </div>
            
            <!-- Quick Links -->
            <div class="footer-column" id="section-29">
                <h3 id="section-30">{{ text_contents.22|default:"Quick Links" }}</h3>
                <ul>
                    <li id="section-31"><a href="?page=home">{{ text_contents.23|default:"Home" }}</a></li>
                    <li id="section-32"><a href="?page=products">{{ text_contents.24|default:"Shop All" }}</a></li>
                    <li id="section-33"><a href="?page=about">{{ text_contents.25|default:"About Us" }}</a></li>
                    <li id="section-34"><a href="?page=contact">{{ text_contents.26|default:"Contact" }}</a></li>
                    <li id="section-35"><a href="?page=blog">{{ text_contents.27|default:"Blog" }}</a></li>
                </ul>
            </div>
            
            <!-- Customer Service -->
            <div class="footer-column" id="section-36">
                <h3 id="section-37">{{ text_contents.28|default:"Customer Service" }}</h3>
                <ul>
                    <li id="section-38"><a href="{% url 'public_shipping_policy' subdomain=page.subdomain %}">{{ text_contents.29|default:"Shipping & Returns" }}</a></li>
                    <li id="section-39"><a href="{% url 'public_privacy' subdomain=page.subdomain %}">{{ text_contents.30|default:"Privacy Policy" }}</a></li>
                    <li id="section-40"><a href="{% url 'public_terms' subdomain=page.subdomain %}">{{ text_contents.31|default:"Terms & Conditions" }}</a></li>
                    <li id="section-41"><a href="?page=faq">{{ text_contents.32|default:"FAQs" }}</a></li>
                    <li id="section-42"><a href="?page=size-guide">{{ text_contents.33|default:"Size Guide" }}</a></li>
                </ul>
            </div>
            
            <!-- Contact & Newsletter -->
            <div class="footer-column" id="section-43">
                <h3 id="section-44">{{ text_contents.34|default:"Get in Touch" }}</h3>
                <div class="contact-info-item">
                    <i class="fas fa-map-marker-alt" data-icon="25"></i>
                    <span id="section-45">{{ text_contents.35|default:"123 Design Avenue, New York, NY 10001" }}</span>
                </div>
                <div class="contact-info-item">
                    <i class="fas fa-phone" data-icon="26"></i>
                    <span id="section-46">{{ text_contents.36|default:"+1 (555) 123-4567" }}</span>
                </div>
                <div class="contact-info-item">
                    <i class="fas fa-envelope" data-icon="27"></i>
                    <span id="section-47">{{ text_contents.37|default:"hello@eclatmaison.com" }}</span>
                </div>
                
                <div class="newsletter-section">
                    <h4>{{ text_contents.38|default:"Newsletter" }}</h4>
                    <form class="newsletter-form" id="newsletterForm" method="POST" action="#">
                        {% csrf_token %}
                        <input type="email" name="email" class="newsletter-input" placeholder="{{ text_contents.39|default:'Your email address' }}" required>
                        <button type="submit" class="newsletter-btn" id="section-48">{{ text_contents.40|default:"Subscribe" }}</button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="footer-bottom" id="section-49">
            <p id="section-50">{{ text_contents.41|default:"&copy; 2024 Éclat Maison. All rights reserved. | Designed with passion for timeless interiors."|safe }}</p>
        </div>
    </div>
</footer>

<!-- Message Notification Container -->
<div id="backend-messages-container" class="backend-messages-container">
    <!-- Template for messages -->
    <div id="backend-message-template" class="backend-message" style="display: none;">
        <div class="backend-message-content">
            <i class="backend-message-icon"></i>
            <div class="backend-message-text">
                <strong class="backend-message-title"></strong>
                <div class="backend-message-body"></div>
            </div>
            <button class="backend-message-close" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="backend-message-progress"></div>
    </div>
</div>

<!-- Django Context Messages Display -->
{% if messages %}
<div id="django-messages-container" class="django-messages-container">
    {% for message in messages %}
    <div class="django-message django-message-{{ message.tags }}">
        <div class="django-message-content">
            <i class="fas fa-{% if message.tags == 'success' %}check-circle{% elif message.tags == 'error' or message.tags == 'danger' %}exclamation-circle{% else %}info-circle{% endif %}"></i>
            <div class="django-message-text">
                <strong>{{ message|capfirst }}</strong>
            </div>
            <button class="django-message-close" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<style>
    /* Backend Messages Container */
    .backend-messages-container,
    .django-messages-container {
        position: fixed;
        top: 100px;
        right: 20px;
        z-index: 999999;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 400px;
    }
    
    /* Backend Message Styling */
    .backend-message {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        border-left: 4px solid;
        animation: slideInBackendMessage 0.3s ease forwards;
        transform: translateX(100%);
        opacity: 0;
    }
    
    /* Message Types */
    .backend-message.success {
        border-left-color: #28a745;
        background: linear-gradient(90deg, rgba(40, 167, 69, 0.08) 0%, white 30%);
    }
    
    .backend-message.error {
        border-left-color: #dc3545;
        background: linear-gradient(90deg, rgba(220, 53, 69, 0.08) 0%, white 30%);
    }
    
    .backend-message.warning {
        border-left-color: #ffc107;
        background: linear-gradient(90deg, rgba(255, 193, 7, 0.08) 0%, white 30%);
    }
    
    .backend-message.info {
        border-left-color: #17a2b8;
        background: linear-gradient(90deg, rgba(23, 162, 184, 0.08) 0%, white 30%);
    }
    
    /* Django Messages */
    .django-message {
        background: white;
        border-radius: 12px;
        padding: 0;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        border-left: 4px solid;
        animation: slideInBackendMessage 0.3s ease forwards;
    }
    
    .django-message.success {
        border-left-color: #28a745;
        background: linear-gradient(90deg, rgba(40, 167, 69, 0.1) 0%, white 30%);
    }
    
    .django-message.error {
        border-left-color: #dc3545;
        background: linear-gradient(90deg, rgba(220, 53, 69, 0.1) 0%, white 30%);
    }
    
    .django-message.warning {
        border-left-color: #ffc107;
        background: linear-gradient(90deg, rgba(255, 193, 7, 0.1) 0%, white 30%);
    }
    
    .django-message.info {
        border-left-color: #17a2b8;
        background: linear-gradient(90deg, rgba(23, 162, 184, 0.1) 0%, white 30%);
    }
    
    /* Message Content */
    .backend-message-content,
    .django-message-content {
        display: flex;
        align-items: center;
        padding: 14px 18px;
        gap: 12px;
    }
    
    .backend-message-icon,
    .django-message-content i:first-child {
        font-size: 18px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .success .backend-message-icon,
    .django-message.success i:first-child {
        background-color: #28a745;
        color: white;
    }
    
    .error .backend-message-icon,
    .django-message.error i:first-child {
        background-color: #dc3545;
        color: white;
    }
    
    .warning .backend-message-icon,
    .django-message.warning i:first-child {
        background-color: #ffc107;
        color: #212529;
    }
    
    .info .backend-message-icon,
    .django-message.info i:first-child {
        background-color: #17a2b8;
        color: white;
    }
    
    /* Message Text */
    .backend-message-text,
    .django-message-text {
        flex: 1;
        font-size: 13px;
        line-height: 1.5;
    }
    
    .backend-message-title {
        display: block;
        color: #212529;
        font-weight: 600;
        margin-bottom: 2px;
    }
    
    .backend-message-body {
        color: #495057;
        font-size: 12px;
        line-height: 1.4;
    }
    
    /* Close Button */
    .backend-message-close,
    .django-message-close {
        background: none;
        border: none;
        color: #6c757d;
        cursor: pointer;
        padding: 6px;
        font-size: 12px;
        transition: all 0.2s ease;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
    }
    
    .backend-message-close:hover,
    .django-message-close:hover {
        color: #495057;
        background-color: rgba(0, 0, 0, 0.05);
    }
    
    /* Progress Bar */
    .backend-message-progress {
        height: 3px;
        background: rgba(0, 0, 0, 0.1);
        width: 100%;
    }
    
    .backend-message.progressing .backend-message-progress {
        animation: progressBar 5s linear forwards;
    }
    
    /* Animations */
    @keyframes slideInBackendMessage {
        0% {
            transform: translateX(100%);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    @keyframes slideOutBackendMessage {
        0% {
            transform: translateX(0);
            opacity: 1;
        }
        100% {
            transform: translateX(100%);
            opacity: 0;
        }
    }
    
    @keyframes progressBar {
        0% {
            width: 100%;
        }
        100% {
            width: 0%;
        }
    }
    
    .backend-message.slide-out {
        animation: slideOutBackendMessage 0.3s ease forwards;
    }
    
    /* Responsive Design */
    @media (max-width: 768px) {
        .backend-messages-container,
        .django-messages-container {
            top: 80px;
            right: 10px;
            left: 10px;
            max-width: calc(100% - 20px);
        }
        
        .backend-message,
        .django-message {
            max-width: 100%;
        }
        
        .backend-message-content,
        .django-message-content {
            padding: 12px 14px;
        }
    }
</style>

<script>
    // Backend Messages Manager
    const BackendMessages = {
        showBackendMessage(type, title, body = '', duration = 5000) {
            const container = document.getElementById('backend-messages-container');
            const template = document.getElementById('backend-message-template');
            
            if (!container || !template) {
                console.error('Backend messages container or template not found');
                return null;
            }
            
            const messageElement = template.cloneNode(true);
            messageElement.id = 'backend-msg-' + Date.now();
            messageElement.style.display = 'block';
            messageElement.classList.add(type);
            
            if (duration > 0) {
                messageElement.classList.add('progressing');
            }
            
            const iconMap = {
                'success': 'fas fa-check-circle',
                'error': 'fas fa-exclamation-circle',
                'warning': 'fas fa-exclamation-triangle',
                'info': 'fas fa-info-circle'
            };
            
            const iconElement = messageElement.querySelector('.backend-message-icon');
            const titleElement = messageElement.querySelector('.backend-message-title');
            const bodyElement = messageElement.querySelector('.backend-message-body');
            
            if (iconElement) {
                iconElement.className = `backend-message-icon ${iconMap[type] || iconMap.info}`;
            }
            if (titleElement) titleElement.textContent = title;
            if (bodyElement) {
                bodyElement.textContent = body;
                if (!body) bodyElement.style.display = 'none';
            }
            
            container.appendChild(messageElement);
            
            setTimeout(() => {
                messageElement.style.transform = 'translateX(0)';
                messageElement.style.opacity = '1';
            }, 10);
            
            if (duration > 0) {
                setTimeout(() => this.removeBackendMessage(messageElement), duration);
            }
            
            return messageElement.id;
        },
        
        removeBackendMessage(messageElement) {
            if (!messageElement) return;
            messageElement.classList.add('slide-out');
            setTimeout(() => {
                if (messageElement.parentElement) {
                    messageElement.parentElement.removeChild(messageElement);
                }
            }, 300);
        },
        
        handleAjaxResponse(responseData) {
            if (!responseData) return;
            
            if (responseData.errors) {
                for (const [field, errors] of Object.entries(responseData.errors)) {
                    errors.forEach(error => {
                        this.showBackendMessage('error', `Field Error: ${field}`, error, 6000);
                    });
                }
                return;
            }
            
            if (responseData.success === true && responseData.message) {
                this.showBackendMessage('success', 'Success', responseData.message);
            } else if (responseData.success === false && responseData.error) {
                this.showBackendMessage('error', 'Error', responseData.error);
            } else if (responseData.message) {
                this.showBackendMessage('info', 'Notice', responseData.message);
            }
            
            if (responseData.action === 'add_to_cart') {
                if (responseData.success) {
                    this.showBackendMessage('success', 'Added to Cart', `"${responseData.product_title}" has been added to your cart.`, 4000);
                } else {
                    this.showBackendMessage('error', 'Cart Error', responseData.error || 'Could not add item to cart.', 5000);
                }
            }
            
            if (responseData.action === 'add_to_wishlist') {
                if (responseData.success) {
                    this.showBackendMessage('success', 'Added to Wishlist', `"${responseData.product_title}" has been added to your wishlist.`, 4000);
                } else {
                    this.showBackendMessage('error', 'Wishlist Error', responseData.error || 'Could not add item to wishlist.', 5000);
                }
            }
            
            if (responseData.max_quantity) {
                this.showBackendMessage('warning', 'Quantity Limit', `Maximum quantity is ${responseData.max_quantity}.`, 4000);
            }
            
            if (responseData.out_of_stock === true) {
                this.showBackendMessage('error', 'Out of Stock', 'This item is currently out of stock.', 5000);
            }
            
            if (responseData.low_stock === true) {
                this.showBackendMessage('warning', 'Low Stock', 'Only a few items left in stock!', 4000);
            }
        },
        
        interceptFetch() {
            const originalFetch = window.fetch;
            window.fetch = async function(...args) {
                try {
                    const response = await originalFetch(...args);
                    const clonedResponse = response.clone();
                    const contentType = clonedResponse.headers.get('content-type');
                    
                    if (contentType && contentType.includes('application/json')) {
                        const data = await clonedResponse.json();
                        if (data) {
                            setTimeout(() => BackendMessages.handleAjaxResponse(data), 100);
                        }
                    }
                    return response;
                } catch (error) {
                    BackendMessages.showBackendMessage('error', 'Network Error', 'Unable to connect to the server. Please check your connection.', 6000);
                    throw error;
                }
            };
        },
        
        init() {
            setTimeout(() => {
                const djangoMessages = document.querySelectorAll('.django-message');
                djangoMessages.forEach(message => {
                    setTimeout(() => {
                        if (message.parentElement) message.remove();
                    }, 5000);
                });
            }, 1000);
            
            this.interceptFetch();
            window.BackendMessages = this;
            console.log('BackendMessages initialized');
        }
    };
    
    document.addEventListener('DOMContentLoaded', function() {
        BackendMessages.init();
        
        // Newsletter Form Submission
        const newsletterForm = document.getElementById('newsletterForm');
        if (newsletterForm) {
            newsletterForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const submitBtn = this.querySelector('.newsletter-btn');
                const originalText = submitBtn.textContent;
                
                submitBtn.textContent = 'Subscribing...';
                submitBtn.disabled = true;
                
                try {
                    const response = await fetch(this.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    
                    const data = await response.json();
                    if (data.success) {
                        BackendMessages.showBackendMessage('success', 'Subscribed!', data.message || 'Thank you for subscribing to our newsletter!', 4000);
                        this.reset();
                    } else {
                        BackendMessages.showBackendMessage('error', 'Error', data.error || 'Something went wrong. Please try again.', 5000);
                    }
                } catch (error) {
                    BackendMessages.showBackendMessage('error', 'Error', 'Network error. Please try again.', 5000);
                } finally {
                    submitBtn.textContent = originalText;
                    submitBtn.disabled = false;
                }
            });
        }
    });
</script>

<script>
    // Set branding configuration
    window.BYNUP_CONFIG = {
        showBranding: {{ show_bynup_branding|yesno:"true,false" }}
    };
</script>
<script src="{% static 'builder/js/bynup-branding.js' %}"></script>


<script src="{% static 'builder/js/cart-manager.js' %}"></script>