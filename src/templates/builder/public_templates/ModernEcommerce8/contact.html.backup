 {%load static%}
 {% load style_filters %}
 {% load style_filters %}

{% load color_filters %}
{% load currency_filters %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | {{ page.brand_name }} </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
         /* CSS Variables for Color Palette */
        :root {
            --color-soft-pink: #F7DAE7;
            --color-warm-pink: #E2B4C1;
            --color-dusty-rose: #D38C9D;
            --color-deep-rose: #A55166;
            --color-white: #FFFFFF;
            --color-off-white: #FDF9FB;
            --color-dark-text: #333333;
            --color-light-text: #666666;
        }
        {%generate_color_variables%}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--color-dark-text);
            background-color: var(--color-off-white);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Contact Hero */
        .contact-hero {
            padding: 140px 0 60px;
            background: linear-gradient(135deg, var(--color-soft-pink) 0%, var(--color-warm-pink) 100%);
            text-align: center;
        }

        .contact-hero h1 {
            font-size: 56px;
            line-height: 1.1;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
            text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.5);
        }

        .contact-hero p {
            font-size: 18px;
            color: var(--color-dark-text);
            max-width: 700px;
            margin: 0 auto;
            background-color: rgba(255, 255, 255, 0.7);
            padding: 20px;
            border-radius: 4px;
            backdrop-filter: blur(5px);
        }

        /* Contact Content */
        .contact-content {
            padding: 60px 0 80px;
        }

        .contact-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
        }

        /* Contact Info Section */
        .contact-info {
            background-color: var(--nav-text, white);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .contact-info h2 {
            font-size: 32px;
            color: var(--color-deep-rose);
            margin-bottom: 30px;
            font-weight: 500;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--color-soft-pink);
        }

        .info-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .info-icon {
            width: 50px;
            height: 50px;
            background-color: var(--color-soft-pink);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-deep-rose);
            font-size: 20px;
            flex-shrink: 0;
        }

        .info-content h3 {
            font-size: 20px;
            color: var(--color-deep-rose);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .info-content p {
            color: var(--color-light-text);
            margin-bottom: 5px;
            font-size: 15px;
        }

        .info-link {
            color: var(--color-deep-rose);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .info-link:hover {
            color: var(--color-dusty-rose);
            text-decoration: underline;
        }

        /* Contact Form */
        .contact-form {
            background-color: var(--nav-text, white);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
        }

        .contact-form h2 {
            font-size: 32px;
            color: var(--color-deep-rose);
            margin-bottom: 30px;
            font-weight: 500;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            display: block;
            font-size: 14px;
            color: var(--color-dark-text);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-input,
        .form-textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--color-warm-pink);
            border-radius: 4px;
            font-family: 'Montserrat', sans-serif;
            font-size: 15px;
            color: var(--color-dark-text);
            background-color: var(--color-off-white);
            transition: all 0.3s ease;
        }

        .form-input:focus,
        .form-textarea:focus {
            outline: none;
            border-color: var(--color-deep-rose);
            background-color: var(--nav-text, white);
            box-shadow: 0 0 0 3px rgba(165, 81, 102, 0.1);
        }

        .form-textarea {
            min-height: 150px;
            resize: vertical;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .submit-button {
            display: inline-block;
            padding: 16px 40px;
            background-color: var(--color-deep-rose);
            color: var(--nav-text, white);
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(165, 81, 102, 0.3);
            position: relative;
            z-index: 1;
            overflow: hidden;
            border: none;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-size: 16px;
            width: 100%;
        }

        .submit-button:hover {
            background-color: #8a4257;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(165, 81, 102, 0.4);
        }

        .submit-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
            z-index: -1;
        }

        .submit-button:hover::before {
            left: 100%;
        }

        /* FAQ Section */
        .faq-section {
            padding: 80px 0;
            background-color: rgba(247, 218, 231, 0.1);
            border-radius: 8px;
            margin-top: 40px;
        }

        .faq-section h2 {
            font-size: 36px;
            color: var(--color-deep-rose);
            margin-bottom: 40px;
            font-weight: 500;
            text-align: center;
        }

        .faq-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .faq-item {
            background-color: var(--nav-text, white);
            border-radius: 8px;
            margin-bottom: 20px;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .faq-item.active {
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.1);
        }

        .faq-question {
            padding: 25px 30px;
            font-size: 18px;
            color: var(--color-deep-rose);
            font-weight: 500;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background-color 0.3s ease;
        }

        .faq-question:hover {
            background-color: var(--color-soft-pink);
        }

        .faq-icon {
            font-size: 14px;
            color: var(--color-dusty-rose);
            transition: transform 0.3s ease;
        }

        .faq-item.active .faq-icon {
            transform: rotate(180deg);
        }

        .faq-answer {
            padding: 0 30px;
            max-height: 0;
            overflow: hidden;
            transition: all 0.3s ease;
            color: var(--color-light-text);
            line-height: 1.7;
        }

        .faq-item.active .faq-answer {
            padding: 0 30px 25px;
            max-height: 500px;
        }

        /* Hours Section */
        .hours-section {
            padding: 40px 0;
            text-align: center;
        }

        .hours-section h3 {
            font-size: 24px;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
        }

        .hours-table {
            display: inline-block;
            text-align: left;
        }

        .hours-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 20px;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--color-soft-pink);
        }

        .hours-row:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .hours-day {
            font-weight: 500;
            color: var(--color-dark-text);
        }

        .hours-time {
            color: var(--color-light-text);
        }

        /* Map Section */
        .map-section {
            margin-top: 40px;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            height: 400px;
            background-color: var(--color-soft-pink);
        }

        .map-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--color-deep-rose);
            font-size: 18px;
            background: linear-gradient(135deg, var(--color-soft-pink) 0%, var(--color-warm-pink) 100%);
        }

        .map-placeholder i {
            font-size: 48px;
            margin-bottom: 20px;
        }

        /* Responsive Styles */
        @media (max-width: 992px) {
            .contact-wrapper {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .contact-hero h1 {
                font-size: 46px;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }

        @media (max-width: 768px) {
            .contact-hero {
                padding: 120px 0 40px;
            }
            
            .contact-hero h1 {
                font-size: 36px;
            }
            
            .contact-hero p {
                font-size: 16px;
            }
            
            .contact-info,
            .contact-form {
                padding: 30px 25px;
            }
            
            .info-item {
                flex-direction: column;
                gap: 15px;
            }
            
            .faq-section h2 {
                font-size: 28px;
            }
            
            .faq-question {
                padding: 20px 25px;
                font-size: 16px;
            }
            
            .faq-answer {
                padding: 0 25px;
            }
            
            .faq-item.active .faq-answer {
                padding: 0 25px 20px;
            }
        }

        @media (max-width: 576px) {
            .contact-hero h1 {
                font-size: 32px;
            }
            
            .contact-info h2,
            .contact-form h2 {
                font-size: 28px;
            }
            
            .hours-row {
                grid-template-columns: 1fr;
                gap: 5px;
            }
            
            .map-section {
                height: 300px;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 301 450 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 301 450 %}
        {%generate_hover_keyframes%}
    </style>
</head>
<body>
    {% load icon_filters %}
    {% render_icon_data icon_customizations %}

    <!-- Header -->
    {%include 'builder/public_templates/ModernEcommerce8/snippets/header1.html'%}

    <!-- Contact Hero -->
    <section class="contact-hero" id="section-301">
        <div class="container">
            <h1 id="section-302">{{ text_contents.201|default:"Get in Touch" }}</h1>
            <p id="section-303">{{ text_contents.202|default:"We're here to help with any questions about our luxury home décor collections or your order" }}</p>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '301' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Contact Content -->
    <section class="contact-content" id="section-304">
        <div class="container">
            <div class="contact-wrapper">
                <!-- Contact Information -->
                <div class="contact-info" id="section-305">
                    <h2 id="section-306">{{ text_contents.203|default:"Contact Information" }}</h2>
                    
                    <!-- Info Item 1 - Location -->
                    <div class="info-item" id="section-307">
                        <div class="info-icon" id="section-308">
                            <i class="fas fa-map-marker-alt" data-icon="44"></i>
                        </div>
                        <div class="info-content">
                            <h3 id="section-309">{{ text_contents.204|default:"Visit Our Showroom" }}</h3>
                            <p id="section-310">{{ text_contents.205|default:"123 Luxury Lane, Design District" }}</p>
                            <p id="section-311">{{ text_contents.206|default:"New York, NY 10001" }}</p>
                            <a href="#" class="info-link" id="section-312">{{ text_contents.207|default:"Get Directions →" }}</a>
                        </div>
                    </div>
                    
                    <!-- Info Item 2 - Phone -->
                    <div class="info-item" id="section-313">
                        <div class="info-icon" id="section-314">
                            <i class="fas fa-phone" data-icon="45"></i>
                        </div>
                        <div class="info-content">
                            <h3 id="section-315">{{ text_contents.208|default:"Phone Support" }}</h3>
                            <p id="section-316">{{ text_contents.209|default:"Monday - Friday: 9AM - 6PM EST" }}</p>
                            <p id="section-317">{{ text_contents.210|default:"Saturday: 10AM - 4PM EST" }}</p>
                            <a href="tel:+18885551234" class="info-link" id="section-318">{{ text_contents.211|default:"(888) 555-1234" }}</a>
                        </div>
                    </div>
                    
                    <!-- Info Item 3 - Email -->
                    <div class="info-item" id="section-319">
                        <div class="info-icon" id="section-320">
                            <i class="fas fa-envelope" data-icon="46"></i>
                        </div>
                        <div class="info-content">
                            <h3 id="section-321">{{ text_contents.212|default:"Email Us" }}</h3>
                            <p id="section-322">{{ text_contents.213|default:"For general inquiries:" }}</p>
                            <a href="mailto:info@elegance-decor.com" class="info-link" id="section-323">{{ text_contents.214|default:"info@elegance-decor.com" }}</a>
                            <p id="section-324">{{ text_contents.215|default:"For order support:" }}</p>
                            <a href="mailto:support@elegance-decor.com" class="info-link" id="section-325">{{ text_contents.216|default:"support@elegance-decor.com" }}</a>
                        </div>
                    </div>
                </div>

                {% for component in components %}
                {% if component.drop_zone == '305' %}
                <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                    {{ component.html_content|safe }}
                </section>
                {% endif %}
                {% endfor %}

                <!-- Contact Form -->
                <div class="contact-form" id="section-326">
                    <h2 id="section-327">{{ text_contents.217|default:"Send Us a Message" }}</h2>
                    
                    <form id="contact-form">
                        <!-- ONLY ADDITIONS: CSRF token, form identifier, and name attributes -->
                        {% csrf_token %}
                        <input type="hidden" name="form_name" value="about_contact">
                        
                        <div class="form-row">
                            <div class="form-group" id="section-328">
                                <label class="form-label" id="section-329">{{ text_contents.218|default:"First Name" }}</label>
                                <input type="text" name="first_name" class="form-input" placeholder="Enter your first name" required>
                            </div>
                            <div class="form-group" id="section-330">
                                <label class="form-label" id="section-331">{{ text_contents.219|default:"Last Name" }}</label>
                                <input type="text" name="last_name" class="form-input" placeholder="Enter your last name" required>
                            </div>
                        </div>
                        
                        <div class="form-group" id="section-332">
                            <label class="form-label" id="section-333">{{ text_contents.220|default:"Email Address" }}</label>
                            <input type="email" name="email" class="form-input" placeholder="Enter your email address" required>
                        </div>
                        
                        <div class="form-group" id="section-334">
                            <label class="form-label" id="section-335">{{ text_contents.221|default:"Phone Number" }}</label>
                            <input type="tel" name="phone" class="form-input" placeholder="Enter your phone number (optional)">
                        </div>
                        
                        <div class="form-group" id="section-336">
                            <label class="form-label" id="section-337">{{ text_contents.222|default:"Subject" }}</label>
                            <select name="subject" class="form-input" required>
                                <option value="">{{ text_contents.223|default:"Select a subject" }}</option>
                                <option value="order">{{ text_contents.224|default:"Order Inquiry" }}</option>
                                <option value="product">{{ text_contents.225|default:"Product Information" }}</option>
                                <option value="shipping">{{ text_contents.226|default:"Shipping & Delivery" }}</option>
                                <option value="returns">{{ text_contents.227|default:"Returns & Exchanges" }}</option>
                                <option value="wholesale">{{ text_contents.228|default:"Wholesale Inquiry" }}</option>
                                <option value="other">{{ text_contents.229|default:"Other" }}</option>
                            </select>
                        </div>
                        
                        <div class="form-group" id="section-338">
                            <label class="form-label" id="section-339">{{ text_contents.230|default:"Message" }}</label>
                            <textarea name="message" class="form-textarea" placeholder="Tell us how we can help..." rows="6" required></textarea>
                        </div>
                        
                        <button type="submit" class="submit-button" id="section-340">
                            {{ text_contents.231|default:"Send Message" }}
                        </button>
                    </form>

                </div>

                {% for component in components %}
                {% if component.drop_zone == '326' %}
                <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                    {{ component.html_content|safe }}
                </section>
                {% endif %}
                {% endfor %}
            </div>

            <!-- Business Hours -->
            <div class="hours-section" id="section-341">
                <h3 id="section-342">{{ text_contents.232|default:"Business Hours" }}</h3>
                <div class="hours-table">
                    <!-- Hours Row 1 -->
                    <div class="hours-row" id="section-343">
                        <div class="hours-day" id="section-344">{{ text_contents.233|default:"Monday - Friday" }}</div>
                        <div class="hours-time" id="section-345">{{ text_contents.234|default:"9:00 AM - 6:00 PM EST" }}</div>
                    </div>
                    
                    <!-- Hours Row 2 -->
                    <div class="hours-row" id="section-346">
                        <div class="hours-day" id="section-347">{{ text_contents.235|default:"Saturday" }}</div>
                        <div class="hours-time" id="section-348">{{ text_contents.236|default:"10:00 AM - 4:00 PM EST" }}</div>
                    </div>
                    
                    <!-- Hours Row 3 -->
                    <div class="hours-row" id="section-349">
                        <div class="hours-day" id="section-350">{{ text_contents.237|default:"Sunday" }}</div>
                        <div class="hours-time" id="section-351">{{ text_contents.238|default:"Closed" }}</div>
                    </div>
                    
                    <!-- Hours Row 4 -->
                    <div class="hours-row" id="section-352">
                        <div class="hours-day" id="section-353">{{ text_contents.239|default:"Holidays" }}</div>
                        <div class="hours-time" id="section-354">{{ text_contents.240|default:"Special hours may apply" }}</div>
                    </div>
                </div>
            </div>

            {% for component in components %}
            {% if component.drop_zone == '341' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
            {% endif %}
            {% endfor %}

            <!-- Map Section -->
            <div class="map-section" id="section-355">
                <div class="map-placeholder">
                    <i class="fas fa-map-marked-alt" data-icon="47"></i>
                    <p id="section-356">{{ text_contents.241|default:"Interactive Map Location" }}</p>
                    <p id="section-357">{{ text_contents.242|default:"Our showroom at 123 Luxury Lane, Design District, NY" }}</p>
                </div>
            </div>

            {% for component in components %}
            {% if component.drop_zone == '355' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
            {% endif %}
            {% endfor %}

            <!-- FAQ Section -->
            <div class="faq-section" id="section-358">
                <div class="container">
                    <h2 id="section-359">{{ text_contents.243|default:"Frequently Asked Questions" }}</h2>
                    <div class="faq-container">
                        <!-- FAQ 1 -->
                        <div class="faq-item" id="section-360">
                            <div class="faq-question" id="section-361">
                                {{ text_contents.244|default:"What is your return policy?" }}
                                <span class="faq-icon"><i class="fas fa-chevron-down" data-icon="48"></i></span>
                            </div>
                            <div class="faq-answer" id="section-362">
                                {{ text_contents.245|default:"We offer a 30-day return policy for all full-priced items in original condition. Custom and personalized items are final sale. Returns must be initiated within 30 days of delivery, and items must be unused, in original packaging with all tags attached." }}
                            </div>
                        </div>

                        <!-- FAQ 2 -->
                        <div class="faq-item" id="section-363">
                            <div class="faq-question" id="section-364">
                                {{ text_contents.246|default:"How long does shipping take?" }}
                                <span class="faq-icon"><i class="fas fa-chevron-down" data-icon="48"></i></span>
                            </div>
                            <div class="faq-answer" id="section-365">
                                {{ text_contents.247|default:"Standard shipping takes 5-7 business days within the continental US. Express shipping (2-3 business days) is available for an additional fee. International shipping times vary by location, typically 10-14 business days. You'll receive tracking information once your order ships." }}
                            </div>
                        </div>

                        <!-- FAQ 3 -->
                        <div class="faq-item" id="section-366">
                            <div class="faq-question" id="section-367">
                                {{ text_contents.248|default:"Do you offer international shipping?" }}
                                <span class="faq-icon"><i class="fas fa-chevron-down" data-icon="48"></i></span>
                            </div>
                            <div class="faq-answer" id="section-368">
                                {{ text_contents.249|default:"Yes, we ship to over 50 countries worldwide. International shipping costs and delivery times vary by destination. Customs duties and taxes are the responsibility of the recipient and are not included in your order total. Please check your country's import regulations before ordering." }}
                            </div>
                        </div>

                        <!-- FAQ 4 -->
                        <div class="faq-item" id="section-369">
                            <div class="faq-question" id="section-370">
                                {{ text_contents.250|default:"Can I visit your showroom?" }}
                                <span class="faq-icon"><i class="fas fa-chevron-down" data-icon="48"></i></span>
                            </div>
                            <div class="faq-answer" id="section-371">
                                {{ text_contents.251|default:"Absolutely! Our flagship showroom in New York's Design District is open Monday through Friday, 9AM-6PM EST, and Saturday 10AM-4PM EST. We recommend scheduling an appointment for personalized service, especially for large projects. Walk-ins are always welcome during business hours." }}
                            </div>
                        </div>

                        <!-- FAQ 5 -->
                        <div class="faq-item" id="section-372">
                            <div class="faq-question" id="section-373">
                                {{ text_contents.252|default:"Do you offer design consultation services?" }}
                                <span class="faq-icon"><i class="fas fa-chevron-down" data-icon="48"></i></span>
                            </div>
                            <div class="faq-answer" id="section-374">
                                {{ text_contents.253|default:"Yes, we offer complimentary 30-minute design consultations for purchases over $1,000. Our design experts can help you select pieces that work perfectly in your space. For comprehensive design services, we offer paid consultation packages starting at $250. Contact us to schedule a consultation." }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% for component in components %}
            {% if component.drop_zone == '358' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
            {% endif %}
            {% endfor %}
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '304' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Footer -->
    {%include 'builder/public_templates/ModernEcommerce8/snippets/footer.html'%}

    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    {% render_icon_script %}

    <!-- ONLY ADDITION: JavaScript for AJAX submission -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    const contactForm = document.getElementById('contact-form');
    const submitBtn = document.getElementById('section-340');
    const originalButtonText = submitBtn.innerHTML;
    
    // Get the store subdomain from the page context
    const pageSubdomain = '{{ page.subdomain }}';
    
    contactForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Show loading state
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
        submitBtn.disabled = true;
        
        // Collect form data
        const formData = new FormData(contactForm);
        
        try {
            const response = await fetch(`/builder/submit-form/${pageSubdomain}/`, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Show success message
                alert('Thank you! Your message has been sent successfully.');
                contactForm.reset();
            } else {
                alert('Error: ' + (result.error || 'Something went wrong. Please try again.'));
            }
        } catch (error) {
            alert('Network error. Please check your connection and try again.');
        } finally {
            // Restore button to original state with your editable text
            submitBtn.innerHTML = originalButtonText;
            submitBtn.disabled = false;
        }
    });
});
</script>

<!-- ONLY ADDITION: Font Awesome for spinner icon (if not already loaded) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
                
    <script>
        // FAQ Toggle Functionality
        document.querySelectorAll('.faq-question').forEach(question => {
            question.addEventListener('click', () => {
                const faqItem = question.parentElement;
                faqItem.classList.toggle('active');
            });
        });

     

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            // Add any initialization code here
        });
    </script>
</body>
</html>