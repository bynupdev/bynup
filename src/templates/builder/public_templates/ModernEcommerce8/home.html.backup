{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}


<!DOCTYPE html>
<html lang="en">
<head>
        
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | {{ page.brand_name }} </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        /* CSS Variables for Color Palette */
        :root {
            --color-soft-pink: #F7DAE7;
            --color-warm-pink: #E2B4C1;
            --color-dusty-rose: #D38C9D;
            --color-deep-rose: #A55166;
            --color-white: #FFFFFF;
            --color-off-white: #FDF9FB;
            --color-dark-text: #333333;
            --color-light-text: #666666;
        }

        
        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            color: var(--color-dark-text);
            background-color: var(--color-off-white);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header & Navigation */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: rgba(255, 255, 255, 0.95);
            box-shadow: 0 2px 20px rgba(165, 81, 102, 0.05);
            z-index: 1000;
            padding: 15px 0;
            transition: all 0.3s ease;
        }

        .header.scrolled {
            padding: 10px 0;
            backdrop-filter: blur(10px);
            background-color: rgba(255, 255, 255, 0.98);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 28px;
            font-weight: 600;
            color: var(--color-deep-rose);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .nav-desktop {
            display: flex;
            align-items: center;
        }

        .nav-links {
            display: flex;
            list-style: none;
            margin-right: 30px;
        }

        .nav-links li {
            margin: 0 20px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--color-dark-text);
            font-weight: 400;
            font-size: 15px;
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-links a:hover {
            color: var(--color-deep-rose);
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background-color: var(--color-deep-rose);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-icons {
            display: flex;
            align-items: center;
        }

        .nav-icons a {
            margin-left: 20px;
            color: var(--color-dark-text);
            font-size: 18px;
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-icons a:hover {
            color: var(--color-deep-rose);
        }

        .cart-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: var(--color-deep-rose);
            color: white;
            font-size: 11px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Dropdown Menu */
        .dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            background-color: white;
            min-width: 180px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
            z-index: 1;
            border-top: 2px solid var(--color-deep-rose);
        }

        .dropdown-content a {
            color: var(--color-dark-text);
            padding: 12px 16px;
            text-decoration: none;
            display: block;
            font-size: 14px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .dropdown-content a:hover {
            background-color: var(--color-soft-pink);
        }

        .dropdown:hover .dropdown-content {
            display: block;
        }

        /* Mobile Navigation */
        .mobile-menu-btn {
            display: none;
            cursor: pointer;
            font-size: 24px;
            color: var(--color-deep-rose);
            background: none;
            border: none;
        }

        .mobile-nav {
            position: fixed;
            top: 0;
            right: -100%;
            width: 85%;
            max-width: 350px;
            height: 100vh;
            background-color: white;
            z-index: 1001;
            padding: 40px 30px;
            transition: right 0.4s ease;
            box-shadow: -5px 0 30px rgba(0, 0, 0, 0.1);
            overflow-y: auto;
        }

        .mobile-nav.active {
            right: 0;
        }

        .mobile-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
        }

        .mobile-nav-links {
            list-style: none;
            margin-bottom: 30px;
        }

        .mobile-nav-links li {
            margin-bottom: 20px;
        }

        .mobile-nav-links a {
            text-decoration: none;
            color: var(--color-dark-text);
            font-size: 18px;
            display: block;
            padding: 8px 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .mobile-dropdown-content {
            margin-left: 15px;
            margin-top: 10px;
        }

        .back-button {
            background: none;
            border: none;
            color: var(--color-deep-rose);
            font-size: 16px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .overlay.active {
            display: block;
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 120px 0 60px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, var(--color-soft-pink) 0%, var(--color-warm-pink) 100%);
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
            opacity: 0.9;
            mix-blend-mode: multiply;
        }

        .hero-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            position: relative;
            z-index: 2;
        }

        .hero-image {
            flex: 1;
            position: relative;
            height: 600px;
            border-radius: 0 100px 100px 0;
            overflow: hidden;
            margin-right: 40px;
            box-shadow: 40px 40px 80px rgba(165, 81, 102, 0.1);
        }

        .hero-image::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
            background-position: right center;
        }

        .hero-image::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to right, 
                rgba(247, 218, 231, 0.8) 0%, 
                rgba(247, 218, 231, 0.6) 20%, 
                rgba(247, 218, 231, 0.3) 40%, 
                rgba(247, 218, 231, 0.1) 60%, 
                rgba(247, 218, 231, 0) 80%);
        }

        .hero-content {
            flex: 1;
            padding-right: 40px;
        }

        .hero h1 {
            font-size: 64px;
            line-height: 1.1;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
            text-shadow: 1px 1px 3px rgba(255, 255, 255, 0.5);
        }

        .hero p {
            font-size: 18px;
            color: var(--color-dark-text);
            margin-bottom: 40px;
            max-width: 500px;
            background-color: rgba(255, 255, 255, 0.7);
            padding: 20px;
            border-radius: 4px;
            backdrop-filter: blur(5px);
        }

        .action-primary {
            display: inline-block;
            padding: 16px 40px;
            background-color: var(--color-deep-rose);
            color: white;
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(165, 81, 102, 0.3);
            position: relative;
            z-index: 1;
            overflow: hidden;
            border: none;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
        }

        .action-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
            z-index: -1;
        }

        .action-primary:hover::before {
            left: 100%;
        }

        .action-primary:hover {
            background-color: #8a4257;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(165, 81, 102, 0.4);
        }

        /* New Arrivals Section */
        .new-arrivals {
            padding: 100px 0;
            background-color: white;
        }

        .section-header {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-header h2 {
            font-size: 42px;
            color: var(--color-deep-rose);
            margin-bottom: 15px;
            font-weight: 500;
        }

        .section-header p {
            color: var(--color-light-text);
            max-width: 600px;
            margin: 0 auto;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 50px;
        }

        .product-card {
            background-color: white;
            border-radius: 4px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.05);
            position: relative;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .product-image {
            height: 280px;
            overflow: hidden;
            background-color: var(--color-soft-pink);
        }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .product-card:hover .product-image img {
            transform: scale(1.05);
        }

        .product-info {
            padding: 20px;
        }

        .product-category {
            font-size: 12px;
            color: var(--color-dusty-rose);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 22px;
            color: var(--color-dark-text);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .product-price {
            font-size: 18px;
            color: var(--color-deep-rose);
            font-weight: 500;
        }

        .product-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .action-secondary {
            display: inline-block;
            padding: 10px 20px;
            background-color: transparent;
            color: var(--color-deep-rose);
            text-decoration: none;
            font-weight: 500;
            letter-spacing: 0.5px;
            border: 1px solid var(--color-deep-rose);
            border-radius: 2px;
            transition: all 0.3s ease;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            flex: 1;
            text-align: center;
        }

        .action-secondary:hover {
            background-color: var(--color-deep-rose);
            color: white;
        }

        .wishlist-button {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--color-soft-pink);
            border: none;
            color: var(--color-deep-rose);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .wishlist-button:hover {
            background-color: var(--color-dusty-rose);
            color: white;
        }

        .see-more-container {
            text-align: center;
        }

        /* Footer */
        .footer {
            background-color: var(--color-off-white);
            padding: 60px 0 30px;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
        }

        .footer-section {
            flex: 1;
            margin-right: 40px;
        }

        .footer-section:last-child {
            margin-right: 0;
        }

        .footer-section h3 {
            font-size: 20px;
            color: var(--color-deep-rose);
            margin-bottom: 20px;
            font-weight: 500;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 10px;
        }

        .footer-links a {
            text-decoration: none;
            color: var(--color-light-text);
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--color-deep-rose);
        }

        .copyright {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            color: var(--color-light-text);
            font-size: 14px;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .hero h1 {
                font-size: 54px;
            }
            
            .hero-image {
                height: 500px;
            }
            
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .hero-container {
                flex-direction: column;
            }
            
            .hero-image {
                width: 100%;
                margin-right: 0;
                margin-bottom: 40px;
                height: 400px;
                border-radius: 0 0 80px 80px;
            }
            
            .hero-image::before {
                background-position: center center;
            }
            
            .hero-image::after {
                background: linear-gradient(to bottom, 
                    rgba(247, 218, 231, 0.8) 0%, 
                    rgba(247, 218, 231, 0.6) 20%, 
                    rgba(247, 218, 231, 0.3) 40%, 
                    rgba(247, 218, 231, 0.1) 60%, 
                    rgba(247, 218, 231, 0) 80%);
            }
            
            .hero-content {
                padding-right: 0;
                text-align: center;
            }
            
            .hero p {
                margin: 0 auto 40px;
            }
            
            .nav-desktop {
                display: none;
            }
            
            .mobile-menu-btn {
                display: block;
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .footer-content {
                flex-wrap: wrap;
            }
            
            .footer-section {
                flex: 0 0 calc(50% - 40px);
                margin-bottom: 30px;
            }
        }

        @media (max-width: 768px) {
            .hero {
                padding: 100px 0 40px;
            }
            
            .hero h1 {
                font-size: 42px;
            }
            
            .hero p {
                font-size: 16px;
            }
            
            .section-header h2 {
                font-size: 36px;
            }
            
            .product-image {
                height: 220px;
            }
        }

        @media (max-width: 576px) {
            .hero h1 {
                font-size: 36px;
            }
            
            .action-primary {
                padding: 14px 30px;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            
            .footer-section {
                flex: 0 0 100%;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 43 96 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 43 96 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}" data-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {%include 'builder/public_templates/ModernEcommerce8/snippets/header1.html'%}

    <!-- Drop Zone for Header -->
    {% for component in components %}
    {% if component.drop_zone == '43' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Hero Section -->
    <section class="hero" id="section-55">
        <div class="container hero-container">
            <div class="hero-image"></div>
            <div class="hero-content">
                <h1 id="section-56">{{ text_contents.36|default:"Elevated Living, Thoughtfully Designed" }}</h1>
                <p id="section-57">{{ text_contents.37|default:"Curated home décor pieces crafted to bring warmth, balance, and timeless elegance to your space. Each piece is selected for its exceptional quality and aesthetic harmony." }}</p>
                <a href="?page=products" class="action-primary" id="section-58">{{ text_contents.38|default:"Explore the Collection" }}</a>
            </div>
        </div>
    </section>

    <!-- Drop Zone for Hero Section -->
    {% for component in components %}
    {% if component.drop_zone == '55' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- New Arrivals Section -->
    <section class="new-arrivals" id="section-59">
        <div class="container">
            <div class="section-header">
                <h2 id="section-60">{{ text_contents.39|default:"New Arrivals" }}</h2>
                <p id="section-61">{{ text_contents.40|default:"Discover our latest collection of luxury home décor, where craftsmanship meets contemporary design." }}</p>
            </div>
            
            
            <div class="products-grid">
                <!-- Products loop from backend -->
                {% for product in products|slice:":8" %}
                <div class="product-card" 
                     data-product-id="{{ product.id }}"
                     data-product-title="{{ product.title }}"
                     data-product-price="{{ product.price }}"
                     data-product-image="{% if product.main_image %}{{ product.main_image.url }}{% endif %}"
                     data-product-category="{{ product.category.name|default:'Home Decor' }}">
                    <a href="/product/{{ product.slug }}/" class="product-image-link">
                        <div class="product-image">
                            {% if product.main_image %}
                            <img src="{{ product.main_image.url }}" alt="{{ product.title }}">
                            {% else %}
                            <div style="background-color: var(--color-soft-pink); width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-image" style="font-size: 3rem; color: var(--color-dusty-rose); opacity: 0.5;"></i>
                            </div>
                            {% endif %}
                        </div>
                    </a>
                    <div class="product-info">
                        <div class="product-category" id="section-63">{{ product.category.name|default:"Home Decor" }}</div>
                        <div class="product-name" id="section-64">{{ product.title|truncatechars:30 }}</div>
                        <div class="product-price" id="section-65">{{ product.price|currency:page }}</div>
                        <div class="product-actions">
                            <button class="action-primary add-to-cart-btn" 
                                    data-add-to-cart="{{ product.id }}"
                                    id="section-66">
                                <i class="fas fa-shopping-bag" data-icon="6"></i> {{ text_contents.41|default:"Add to Cart" }}
                            </button>
                            <button class="wishlist-button" 
                                    data-add-to-wishlist="{{ product.id }}">
                                <i class="far fa-heart" data-icon="7"></i>
                            </button>
                        </div>
                    </div>
                </div>
             
                {% endfor %}
            </div>
            
            {%if products%}
            <div class="see-more-container">
                <a href="?page=products" class="action-secondary" id="section-67">{{ text_contents.42|default:"View All Collections" }}</a>
            </div>
            {%else%}
            <div class="see-more-container">
                <a href="{{ SITE_DOMAIN }}/manage-products/{{ page.subdomain }}/" class="action-secondary" id="section-67">Add Your First Product +</a>
            </div>

            {%endif%}
        </div>
    </section>

    <!-- Drop Zone for New Arrivals Section -->
    {% for component in components %}
    {% if component.drop_zone == '59' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Footer -->
    {%include 'builder/public_templates/ModernEcommerce8/snippets/footer.html'%}

    <!-- Drop Zone for Footer -->
    {% for component in components %}
    {% if component.drop_zone == '76' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Drop Zone for End of Page -->
    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Load CartManager from static files -->
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    


    <script>
        // Mobile navigation elements - declare them once at the top
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
        const overlay = document.getElementById('overlay');
        const backButton = document.getElementById('back-button');

        // CartManager will auto-initialize from cart-manager.js
        // We don't need to manually attach event listeners as cart-manager.js does that automatically
        
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, CartManager will auto-initialize');
            
            // Mobile menu functionality
            if (mobileMenuToggle) {
                mobileMenuToggle.addEventListener('click', function() {
                    const mobileNav = document.getElementById('mobile-nav');
                    if (mobileNav) {
                        mobileNav.classList.add('active');
                    }
                    if (overlay) {
                        overlay.classList.add('active');
                    }
                    document.body.style.overflow = 'hidden';
                });
            }

            if (overlay) {
                overlay.addEventListener('click', closeMobileNav);
            }
            if (backButton) {
                backButton.addEventListener('click', closeMobileNav);
            }

            // Header scroll effect
            window.addEventListener('scroll', function() {
                const header = document.querySelector('.header');
                if (window.scrollY > 50) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            });

            // Product Card Animation on Scroll
            const productCards = document.querySelectorAll('.product-card');
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, {
                threshold: 0.1
            });

            // Set initial state for animation
            productCards.forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                observer.observe(card);
            });
            
            // Log that we're ready
            console.log('Homepage initialized, waiting for CartManager...');
        });

        function closeMobileNav() {
            const mobileNav = document.getElementById('mobile-nav');
            if (mobileNav) {
                mobileNav.classList.remove('active');
            }
            if (overlay) {
                overlay.classList.remove('active');
            }
            document.body.style.overflow = 'auto';
        }

        // Function to get subdomain from hostname (used by CartManager)
        function getSubdomainFromHostname() {
            const hostname = window.location.hostname;
            
            if (hostname.includes('localhost') || hostname.includes('127.0.0.1')) {
                const parts = hostname.split('.');
                if (parts.length > 1 && parts[0] !== 'localhost' && parts[0] !== '127') {
                    return parts[0];
                }
            } else {
                const parts = hostname.split('.');
                if (parts.length >= 2) {
                    return parts[0];
                }
            }
            
            return 'default';
        }
    </script>
</body>
</html>