{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us - {{ page.brand_name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --color-bg-primary: #F0EFE6;
            --color-bg-secondary: #EAEAEA;
            --color-stone: #C6C9D2;
            --color-warm: #DCCFC1;
            --color-taupe: #BBAEA8;
            --color-charcoal: #393831;
            --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.03), 0 2px 4px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 12px 28px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(0, 0, 0, 0.01);
            --shadow-hover: 0 20px 32px -12px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02);
            --transition-smooth: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        {% generate_color_variables %}
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: var(--color-bg-primary);
            color: var(--color-charcoal);
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            overflow-x: hidden;
        }
        h1, h2, h3, .section-title { font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: -0.02em; }
        .container { max-width: 1440px; margin: 0 auto; padding: 0 32px; }
        .page-header { text-align: center; padding: 40px 0 32px; margin-bottom: 16px; }
        h1 { font-size: 3rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-charcoal); position: relative; display: inline-block; }
        h1::after { content: ''; position: absolute; bottom: -12px; left: 50%; transform: translateX(-50%); width: 80px; height: 2px; background: var(--color-charcoal); }
        .page-header p { font-size: 1rem; color: var(--color-charcoal); opacity: 0.7; max-width: 600px; margin: 1rem auto 0; }
        .about-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; margin: 48px 0 64px; align-items: center; }
        .hero-image-container { border-radius: 24px; overflow: hidden; box-shadow: var(--shadow-md); }
        .hero-image { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
        .hero-image-container:hover .hero-image { transform: scale(1.02); }
        .hero-content h2 { font-size: 2rem; margin-bottom: 20px; color: var(--color-charcoal); }
        .hero-content p { font-size: 1rem; line-height: 1.6; margin-bottom: 20px; color: var(--color-charcoal); opacity: 0.8; }
        .highlight-text { font-size: 1.1rem; font-style: italic; color: var(--color-charcoal); border-left: 3px solid var(--color-charcoal); padding-left: 20px; margin: 24px 0; opacity: 0.9; }
        .mission-values { background: var(--color-bg-secondary); border-radius: 24px; padding: 48px 32px; margin: 64px 0; }
        .mission-values h2 { font-size: 1.8rem; text-align: center; margin-bottom: 40px; }
        .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-bottom: 48px; }
        .value-item { text-align: center; padding: 24px; }
        .value-icon { font-size: 2.5rem; color: var(--color-charcoal); margin-bottom: 16px; }
        .value-title { font-size: 1.2rem; margin-bottom: 12px; }
        .value-description { font-size: 0.9rem; line-height: 1.5; opacity: 0.7; }
        .mission-statement { text-align: center; padding: 32px; background: var(--color-bg-primary); border-radius: 20px; }
        .mission-statement h3 { font-size: 1.3rem; margin-bottom: 16px; }
        .mission-statement p { font-size: 1rem; line-height: 1.6; max-width: 800px; margin: 0 auto; opacity: 0.8; }
        .craftsmanship { margin: 64px 0; }
        .craftsmanship h2 { font-size: 1.8rem; text-align: center; margin-bottom: 40px; }
        .craftsmanship-content { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
        .craftsmanship-text h3 { font-size: 1.5rem; margin-bottom: 20px; }
        .craftsmanship-text p { font-size: 1rem; line-height: 1.6; margin-bottom: 20px; opacity: 0.8; }
        .craftsmanship-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
        .stat-item { text-align: center; padding: 20px; background: var(--color-bg-secondary); border-radius: 16px; }
        .stat-number { font-size: 2rem; font-weight: 700; color: var(--color-charcoal); }
        .stat-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; margin-top: 8px; opacity: 0.6; }
        .craftsmanship-image { border-radius: 24px; overflow: hidden; box-shadow: var(--shadow-md); }
        .craftsmanship-img { width: 100%; height: 100%; object-fit: cover; }
        .timeline-section { margin: 64px 0; }
        .timeline-section h2 { font-size: 1.8rem; text-align: center; margin-bottom: 48px; }
        .timeline { position: relative; max-width: 900px; margin: 0 auto; }
        .timeline::before { content: ''; position: absolute; left: 50%; transform: translateX(-50%); width: 2px; height: 100%; background: var(--color-stone); }
        .timeline-item { margin-bottom: 48px; position: relative; width: 45%; }
        .timeline-item:nth-child(odd) { margin-left: 0; margin-right: auto; }
        .timeline-item:nth-child(even) { margin-left: auto; margin-right: 0; }
        .timeline-content { background: var(--color-bg-secondary); border-radius: 20px; padding: 24px; position: relative; }
        .timeline-year { font-size: 1.2rem; font-weight: 700; color: var(--color-charcoal); margin-bottom: 8px; }
        .timeline-title { font-size: 1.1rem; margin-bottom: 12px; }
        .timeline-description { font-size: 0.9rem; line-height: 1.5; opacity: 0.7; }
        .timeline-item::before { content: ''; position: absolute; width: 12px; height: 12px; background: var(--color-charcoal); border-radius: 50%; top: 28px; }
        .timeline-item:nth-child(odd)::before { right: -42px; }
        .timeline-item:nth-child(even)::before { left: -42px; }
        .team-section { margin: 64px 0; }
        .team-section h2 { font-size: 1.8rem; text-align: center; margin-bottom: 48px; }
        .team-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
        .team-member { text-align: center; background: var(--color-bg-secondary); border-radius: 24px; padding: 24px; transition: var(--transition-smooth); }
        .team-member:hover { transform: translateY(-8px); box-shadow: var(--shadow-hover); }
        .team-member-image { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin: 0 auto 20px; }
        .team-member-name { font-size: 1.1rem; margin-bottom: 8px; }
        .team-member-role { font-size: 0.85rem; color: var(--color-taupe); margin-bottom: 12px; }
        .team-member-bio { font-size: 0.85rem; line-height: 1.5; opacity: 0.7; }
        .commitment { background: var(--color-charcoal); color: var(--color-bg-primary); border-radius: 24px; padding: 64px 48px; margin: 64px 0; text-align: center; }
        .commitment h2 { font-size: 2rem; margin-bottom: 24px; color: var(--color-bg-primary); }
        .commitment p { font-size: 1rem; line-height: 1.6; max-width: 800px; margin: 0 auto 48px; opacity: 0.9; }
        .commitment-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
        .commitment-stat { text-align: center; }
        .commitment-number { font-size: 2rem; font-weight: 700; color: var(--color-warm); margin-bottom: 8px; }
        .commitment-label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; }
        @media (max-width: 1200px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 992px) { .about-hero { grid-template-columns: 1fr; gap: 32px; } .craftsmanship-content { grid-template-columns: 1fr; gap: 32px; } .values-grid { grid-template-columns: repeat(2, 1fr); } .commitment-stats { grid-template-columns: repeat(2, 1fr); } h1 { font-size: 2.5rem; } .timeline::before { left: 30px; } .timeline-item { width: calc(100% - 60px); margin-left: 60px !important; margin-right: 0 !important; } .timeline-item:nth-child(odd)::before, .timeline-item:nth-child(even)::before { left: -38px; } }
        @media (max-width: 768px) { .container { padding: 0 24px; } .values-grid { grid-template-columns: 1fr; } .team-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; } .commitment-stats { grid-template-columns: 1fr; gap: 24px; } h1 { font-size: 2rem; } .mission-values { padding: 32px 24px; } .commitment { padding: 48px 32px; } }
        @media (max-width: 480px) { .container { padding: 0 20px; } h1 { font-size: 1.8rem; } }
        {% generate_section_styles style_customizations 136 230 %}
        {% generate_background_images background_images 136 230 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-subdomain="{{ page.subdomain }}" style="margin-top: 80px;">

<main>
     {% include 'builder/public_templates/ModernEcommerce15/snippets/header1.html' %}

    <div class="container">
        <!-- Page Header -->
        <div class="page-header" id="section-136">
            <h1 id="section-137">{{ text_contents.92|default:"Our Story" }}</h1>
            <p id="section-138">{{ text_contents.93|default:"Redefining streetwear with refined elegance and uncompromising quality" }}</p>
        </div>

        {% for component in components %}{% if component.drop_zone == '136' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Hero Section -->
        <div class="about-hero" id="section-139">
            <div class="hero-image-container">
                <img class="hero-image" src="{% if image_customizations.70 %}{{ image_customizations.70.image_url }}{% else %}https://images.unsplash.com/photo-1556761175-b413da4baf72?w=800&auto=format{% endif %}" alt="{{ image_customizations.70.alt_text|default:'KRUX Studio' }}">
            </div>
            <div class="hero-content" id="section-140">
                <h2 id="section-141">{{ text_contents.94|default:"Founded in 2020" }}</h2>
                <p id="section-142">{{ text_contents.95|default:"KRUX was born from a vision to bridge the gap between urban streetwear and refined elegance. What began as a small atelier in Brooklyn has grown into a brand recognized for its commitment to quality, craftsmanship, and timeless design." }}</p>
                <p id="section-143">{{ text_contents.96|default:"Our founder, Marcus Chen, envisioned a brand that would honor the authenticity of street culture while embracing the sophistication of luxury fashion. Today, KRUX continues to push boundaries, creating pieces that are as functional as they are beautiful." }}</p>
                <p class="highlight-text" id="section-144">{{ text_contents.97|default:"\"Fashion should feel effortless. Every piece we create is designed to be worn, lived in, and loved for years to come.\" — Marcus Chen, Founder" }}</p>
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '139' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Mission & Values Section -->
        <div class="mission-values" id="section-145">
            <h2 id="section-146">{{ text_contents.98|default:"Our Philosophy" }}</h2>
            <div class="values-grid">
                <div class="value-item" id="section-147">
                    <div class="value-icon"><i class="fas fa-gem" data-icon="70"></i></div>
                    <h3 class="value-title" id="section-148">{{ text_contents.99|default:"Uncompromising Quality" }}</h3>
                    <p class="value-description" id="section-149">{{ text_contents.100|default:"We source only the finest materials from ethical suppliers. Every garment undergoes rigorous quality checks before reaching your hands." }}</p>
                </div>
                <div class="value-item" id="section-150">
                    <div class="value-icon"><i class="fas fa-hand-sparkles" data-icon="71"></i></div>
                    <h3 class="value-title" id="section-151">{{ text_contents.101|default:"Artisan Craftsmanship" }}</h3>
                    <p class="value-description" id="section-152">{{ text_contents.102|default:"Each piece is crafted with precision by skilled artisans who take pride in their work, ensuring exceptional attention to detail." }}</p>
                </div>
                <div class="value-item" id="section-153">
                    <div class="value-icon"><i class="fas fa-leaf" data-icon="72"></i></div>
                    <h3 class="value-title" id="section-154">{{ text_contents.103|default:"Sustainable Practices" }}</h3>
                    <p class="value-description" id="section-155">{{ text_contents.104|default:"We're committed to reducing our environmental impact through sustainable materials and ethical manufacturing processes." }}</p>
                </div>
            </div>
            <div class="mission-statement" id="section-156">
                <h3 id="section-157">{{ text_contents.105|default:"Our Mission" }}</h3>
                <p id="section-158">{{ text_contents.106|default:"To create timeless streetwear that empowers individuals to express themselves authentically, while championing sustainability and craftsmanship in everything we do." }}</p>
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '145' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Craftsmanship Section -->
        <div class="craftsmanship" id="section-159">
            <h2 id="section-160">{{ text_contents.107|default:"The Art of Craftsmanship" }}</h2>
            <div class="craftsmanship-content">
                <div class="craftsmanship-text" id="section-161">
                    <h3 id="section-162">{{ text_contents.108|default:"Masterful Precision" }}</h3>
                    <p id="section-163">{{ text_contents.109|default:"Every KRUX garment begins with a vision. Our designers sketch, prototype, and refine each piece until it meets our exacting standards. From there, our skilled artisans bring these designs to life using time-honored techniques." }}</p>
                    <p id="section-164">{{ text_contents.110|default:"We believe that true quality is found in the details. That's why we obsess over every stitch, every seam, and every finish. The result is clothing that not only looks exceptional but stands the test of time." }}</p>
                    <div class="craftsmanship-stats">
                        <div class="stat-item" id="section-165">
                            <div class="stat-number" id="section-166">{{ text_contents.111|default:"47" }}</div>
                            <div class="stat-label" id="section-167">{{ text_contents.112|default:"Quality Checks" }}</div>
                        </div>
                        <div class="stat-item" id="section-168">
                            <div class="stat-number" id="section-169">{{ text_contents.113|default:"100+" }}</div>
                            <div class="stat-label" id="section-170">{{ text_contents.114|default:"Hours Per Collection" }}</div>
                        </div>
                        <div class="stat-item" id="section-171">
                            <div class="stat-number" id="section-172">{{ text_contents.115|default:"95%" }}</div>
                            <div class="stat-label" id="section-173">{{ text_contents.116|default:"Sustainable Materials" }}</div>
                        </div>
                    </div>
                </div>
                <div class="craftsmanship-image">
                    <img class="craftsmanship-img" src="{% if image_customizations.71 %}{{ image_customizations.71.image_url }}{% else %}https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=800&auto=format{% endif %}" alt="{{ image_customizations.71.alt_text|default:'Craftsmanship process' }}">
                </div>
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '159' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Timeline Section -->
        <div class="timeline-section" id="section-174">
            <h2 id="section-175">{{ text_contents.117|default:"Our Journey" }}</h2>
            <div class="timeline">
                <div class="timeline-item" id="section-176">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-177">{{ text_contents.118|default:"2020" }}</div>
                        <h3 class="timeline-title" id="section-178">{{ text_contents.119|default:"The Beginning" }}</h3>
                        <p class="timeline-description" id="section-179">{{ text_contents.120|default:"KRUX is founded in Brooklyn, New York, with a small collection of 12 pieces and a commitment to quality over quantity." }}</p>
                    </div>
                </div>
                <div class="timeline-item" id="section-180">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-181">{{ text_contents.121|default:"2021" }}</div>
                        <h3 class="timeline-title" id="section-182">{{ text_contents.122|default:"First Flagship" }}</h3>
                        <p class="timeline-description" id="section-183">{{ text_contents.123|default:"We open our first flagship store in SoHo, creating a space where customers can experience the brand's aesthetic firsthand." }}</p>
                    </div>
                </div>
                <div class="timeline-item" id="section-184">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-185">{{ text_contents.124|default:"2022" }}</div>
                        <h3 class="timeline-title" id="section-186">{{ text_contents.125|default:"Sustainable Shift" }}</h3>
                        <p class="timeline-description" id="section-187">{{ text_contents.126|default:"We transition to 95% sustainable materials across our entire collection, reinforcing our commitment to the planet." }}</p>
                    </div>
                </div>
                <div class="timeline-item" id="section-188">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-189">{{ text_contents.127|default:"2023" }}</div>
                        <h3 class="timeline-title" id="section-190">{{ text_contents.128|default:"Global Recognition" }}</h3>
                        <p class="timeline-description" id="section-191">{{ text_contents.129|default:"KRUX gains international recognition, with our collections featured in leading fashion publications worldwide." }}</p>
                    </div>
                </div>
                <div class="timeline-item" id="section-192">
                    <div class="timeline-content">
                        <div class="timeline-year" id="section-193">{{ text_contents.130|default:"2024" }}</div>
                        <h3 class="timeline-title" id="section-194">{{ text_contents.131|default:"Looking Forward" }}</h3>
                        <p class="timeline-description" id="section-195">{{ text_contents.132|default:"We continue to innovate, expanding our sustainable practices and reaching new communities around the globe." }}</p>
                    </div>
                </div>
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '174' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Team Section -->
        <div class="team-section" id="section-196">
            <h2 id="section-197">{{ text_contents.133|default:"Meet Our Team" }}</h2>
            <div class="team-grid">
                <div class="team-member" id="section-198">
                    <img class="team-member-image" src="{% if image_customizations.72 %}{{ image_customizations.72.image_url }}{% else %}https://images.unsplash.com/photo-1560250097-0b93528c311a?w=300&auto=format{% endif %}" alt="{{ image_customizations.72.alt_text|default:'Marcus Chen' }}">
                    <h3 class="team-member-name" id="section-199">{{ text_contents.134|default:"Marcus Chen" }}</h3>
                    <div class="team-member-role" id="section-200">{{ text_contents.135|default:"Founder & Creative Director" }}</div>
                    <p class="team-member-bio" id="section-201">{{ text_contents.136|default:"With a background in architecture and fashion, Marcus brings a unique perspective to design, blending structural elements with fluid silhouettes." }}</p>
                </div>
                <div class="team-member" id="section-202">
                    <img class="team-member-image" src="{% if image_customizations.73 %}{{ image_customizations.73.image_url }}{% else %}https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=300&auto=format{% endif %}" alt="{{ image_customizations.73.alt_text|default:'Elena Rodriguez' }}">
                    <h3 class="team-member-name" id="section-203">{{ text_contents.137|default:"Elena Rodriguez" }}</h3>
                    <div class="team-member-role" id="section-204">{{ text_contents.138|default:"Head of Design" }}</div>
                    <p class="team-member-bio" id="section-205">{{ text_contents.139|default:"Elena leads our design team with a passion for minimalism and functionality, ensuring every piece serves a purpose while looking effortless." }}</p>
                </div>
                <div class="team-member" id="section-206">
                    <img class="team-member-image" src="{% if image_customizations.74 %}{{ image_customizations.74.image_url }}{% else %}https://images.unsplash.com/photo-1580489944761-15a19d654956?w=300&auto=format{% endif %}" alt="{{ image_customizations.74.alt_text|default:'Sarah Kim' }}">
                    <h3 class="team-member-name" id="section-207">{{ text_contents.140|default:"Sarah Kim" }}</h3>
                    <div class="team-member-role" id="section-208">{{ text_contents.141|default:"Sustainability Director" }}</div>
                    <p class="team-member-bio" id="section-209">{{ text_contents.142|default:"Sarah spearheads our sustainability initiatives, working with suppliers and manufacturers to reduce our environmental footprint." }}</p>
                </div>
                <div class="team-member" id="section-210">
                    <img class="team-member-image" src="{% if image_customizations.75 %}{{ image_customizations.75.image_url }}{% else %}https://images.unsplash.com/photo-1566492031773-4f4e44671857?w=300&auto=format{% endif %}" alt="{{ image_customizations.75.alt_text|default:'David Okafor' }}">
                    <h3 class="team-member-name" id="section-211">{{ text_contents.143|default:"David Okafor" }}</h3>
                    <div class="team-member-role" id="section-212">{{ text_contents.144|default:"Production Manager" }}</div>
                    <p class="team-member-bio" id="section-213">{{ text_contents.145|default:"David oversees our production process, ensuring quality standards are met and that our artisans have the resources they need." }}</p>
                </div>
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '196' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Commitment Section -->
        <div class="commitment" id="section-214">
            <h2 id="section-215">{{ text_contents.146|default:"Our Commitment to Excellence" }}</h2>
            <p id="section-216">{{ text_contents.147|default:"We believe that great design is timeless, and true quality is measured not by seasons, but by years. Every piece we create is an investment in your personal style and our shared future." }}</p>
            <div class="commitment-stats">
                <div class="commitment-stat" id="section-217">
                    <div class="commitment-number" id="section-218">{{ text_contents.148|default:"100%" }}</div>
                    <div class="commitment-label" id="section-219">{{ text_contents.149|default:"Ethically Sourced" }}</div>
                </div>
                <div class="commitment-stat" id="section-220">
                    <div class="commitment-number" id="section-221">{{ text_contents.150|default:"10K+" }}</div>
                    <div class="commitment-label" id="section-222">{{ text_contents.151|default:"Happy Customers" }}</div>
                </div>
                <div class="commitment-stat" id="section-223">
                    <div class="commitment-number" id="section-224">{{ text_contents.152|default:"95%" }}</div>
                    <div class="commitment-label" id="section-225">{{ text_contents.153|default:"Sustainable Materials" }}</div>
                </div>
                <div class="commitment-stat" id="section-226">
                    <div class="commitment-number" id="section-227">{{ text_contents.154|default:"12+" }}</div>
                    <div class="commitment-label" id="section-228">{{ text_contents.155|default:"Countries Served" }}</div>
                </div>
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '214' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}
    </div>
     {% include 'builder/public_templates/ModernEcommerce15/snippets/footer.html' %}
</main>

{% render_icon_script %}

<script>
    // Timeline animation on scroll
    const timelineItems = document.querySelectorAll('.timeline-item');
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if(entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, { threshold: 0.2 });
    
    timelineItems.forEach(item => {
        item.style.opacity = '0';
        item.style.transform = 'translateY(20px)';
        item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        observer.observe(item);
    });
</script>
</body>
</html>