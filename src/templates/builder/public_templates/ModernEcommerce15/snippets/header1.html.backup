{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
    :root {
        --color-bg-primary: #F0EFE6;
        --color-bg-secondary: #EAEAEA;
        --color-stone: #C6C9D2;
        --color-warm: #DCCFC1;
        --color-taupe: #BBAEA8;
        --color-charcoal: #393831;
        --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.03), 0 2px 4px rgba(0, 0, 0, 0.02);
        --shadow-md: 0 12px 28px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(0, 0, 0, 0.01);
        --shadow-hover: 0 20px 32px -12px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02);
        --transition-smooth: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    }
    {% generate_color_variables %}
    
    .site-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: rgba(240, 239, 230, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(57, 56, 49, 0.08);
        transition: var(--transition-smooth);
    }
    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 0;
    }
    .logo a {
        font-family: 'Syne', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--color-charcoal);
        text-decoration: none;
        transition: opacity 0.2s;
    }
    .nav-links {
        display: flex;
        gap: 2rem;
        align-items: center;
    }
    .nav-item {
        font-family: 'Syne', sans-serif;
        font-weight: 500;
        font-size: 0.95rem;
        color: var(--color-charcoal);
        text-decoration: none;
        transition: color 0.2s;
    }
    .nav-item:hover {
        color: #5e5a54;
    }
    .header-actions {
        display: flex;
        gap: 1.6rem;
        align-items: center;
    }
    .icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.4rem;
        color: var(--color-charcoal);
        transition: transform 0.2s;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    .icon-btn:hover {
        transform: translateY(-2px);
    }
    .cart-counter, .wishlist-counter {
        position: absolute;
        top: -8px;
        right: -12px;
        background-color: var(--color-charcoal);
        color: var(--color-bg-primary);
        font-size: 0.7rem;
        font-weight: 600;
        border-radius: 30px;
        padding: 2px 6px;
        font-family: 'Inter', sans-serif;
    }
    .account-dropdown {
        position: relative;
    }
    .dropdown-menu {
        position: absolute;
        top: 44px;
        right: 0;
        background: var(--color-bg-primary);
        backdrop-filter: blur(8px);
        background-color: rgba(240, 239, 230, 0.98);
        border-radius: 20px;
        width: 210px;
        padding: 1rem 0;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--color-stone);
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s, visibility 0.2s;
        z-index: 200;
    }
    .account-dropdown.active .dropdown-menu {
        opacity: 1;
        visibility: visible;
    }
    .dropdown-item {
        display: block;
        padding: 0.7rem 1.5rem;
        font-size: 0.9rem;
        color: var(--color-charcoal);
        text-decoration: none;
        transition: background 0.2s;
        font-weight: 450;
    }
    .dropdown-item:hover {
        background: var(--color-warm);
    }
    .mobile-menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: 1.8rem;
        cursor: pointer;
        color: var(--color-charcoal);
    }
    .mobile-nav-panel {
        position: fixed;
        top: 0;
        left: -100%;
        width: 85%;
        max-width: 320px;
        height: 100%;
        background: var(--color-bg-primary);
        z-index: 2000;
        padding: 2rem 1.5rem;
        box-shadow: 2px 0 20px rgba(0,0,0,0.08);
        transition: left 0.35s ease-out;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--color-stone);
    }
    .mobile-nav-panel.open {
        left: 0;
    }
    .mobile-back-btn {
        background: none;
        border: none;
        font-size: 1rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 2rem;
        cursor: pointer;
        font-family: 'Syne', sans-serif;
        color: var(--color-charcoal);
        width: fit-content;
        padding: 8px 0;
    }
    .mobile-nav-list {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }
    .mobile-nav-list a {
        font-size: 1.3rem;
        font-weight: 500;
        text-decoration: none;
        color: var(--color-charcoal);
        font-family: 'Syne', sans-serif;
    }
    .mobile-account-items {
        margin-top: 1.8rem;
        border-top: 1px solid var(--color-stone);
        padding-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .mobile-account-items a {
        font-size: 1rem;
        text-decoration: none;
        color: var(--color-charcoal);
        font-family: 'Inter', sans-serif;
    }
    .menu-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.2);
        z-index: 1999;
        opacity: 0;
        visibility: hidden;
        transition: 0.2s;
    }
    .menu-overlay.active {
        opacity: 1;
        visibility: visible;
    }
    @media (max-width: 768px) {
        .nav-links, .header-actions .icon-btn:not(.mobile-menu-toggle) { display: none; }
        .mobile-menu-toggle { display: inline-flex; }
    }
</style>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<header class="site-header" id="section-1">
    <div class="container header-inner">
        <div class="logo">
            <a href="?page=home">
                <span id="section-2">{{ text_contents.1|default:"KRUX"|safe }}</span>
            </a>
        </div>
        <nav class="nav-links">
            <a href="?page=home" class="nav-item" id="section-3">{{ text_contents.2|default:"Home" }}</a>
            <a href="?page=products" class="nav-item" id="section-4">{{ text_contents.3|default:"Shop" }}</a>
            <a href="?page=about" class="nav-item" id="section-5">{{ text_contents.4|default:"About Us" }}</a>
            <a href="?page=contact" class="nav-item" id="section-6">{{ text_contents.5|default:"Contact" }}</a>
        </nav>
        <div class="header-actions">
            <a href="?page=cart" class="icon-btn">
                <span class="cart-counter">0</span>
                <i class="fas fa-shopping-cart" data-icon="1"></i>
            </a>
            <a href="?page=wishlist" class="icon-btn">
                <span class="wishlist-counter">0</span>
                <i class="far fa-heart" data-icon="2"></i>
            </a>
            <div class="account-dropdown">
                <button class="icon-btn" id="accountIconBtn">
                    <i class="far fa-user" data-icon="3"></i>
                </button>
                <div class="dropdown-menu">
                    <a href="{{ login_url }}" class="dropdown-item" id="section-7">{{ text_contents.6|default:"Sign In" }}</a>
                    <a href="{{ registration_url }}" class="dropdown-item" id="section-8">{{ text_contents.7|default:"Sign Up" }}</a>
                    <a href="?page=orders" class="dropdown-item" id="section-9">{{ text_contents.8|default:"Orders" }}</a>
                    <a href="?page=wishlist" class="dropdown-item" id="section-10">{{ text_contents.9|default:"Wishlist" }}</a>
                    <a href="?page=account" class="dropdown-item" id="section-11">{{ text_contents.10|default:"Account Settings" }}</a>
                </div>
            </div>
            <button class="mobile-menu-toggle" id="mobileMenuBtn">☰</button>
        </div>
    </div>
</header>

<div class="mobile-nav-panel" id="mobilePanel">
    <button class="mobile-back-btn" id="mobileBackBtn">← Back</button>
    <div class="mobile-nav-list">
        <a href="?page=home">Home</a>
        <a href="?page=products">Shop</a>
        <a href="?page=about">About Us</a>
        <a href="?page=contact">Contact</a>
    </div>
    <div class="mobile-account-items">
        <a href="{{ login_url }}">Sign In</a>
        <a href="{{ registration_url }}">Sign Up</a>
        <a href="?page=orders">Orders</a>
        <a href="?page=wishlist">Wishlist</a>
        <a href="?page=account">Account Settings</a>
    </div>
</div>
<div class="menu-overlay" id="menuOverlay"></div>

<script>
    // Account dropdown
    const accountDropdown = document.querySelector('.account-dropdown');
    const accountIcon = document.getElementById('accountIconBtn');
    if(accountIcon && accountDropdown) {
        accountIcon.addEventListener('click', (e) => {
            e.stopPropagation();
            accountDropdown.classList.toggle('active');
        });
        document.addEventListener('click', (e) => {
            if (!accountDropdown.contains(e.target)) accountDropdown.classList.remove('active');
        });
    }
    // Mobile nav
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const mobilePanel = document.getElementById('mobilePanel');
    const menuOverlay = document.getElementById('menuOverlay');
    const backBtn = document.getElementById('mobileBackBtn');
    function openMobileNav() { mobilePanel.classList.add('open'); menuOverlay.classList.add('active'); document.body.style.overflow = 'hidden'; }
    function closeMobileNav() { mobilePanel.classList.remove('open'); menuOverlay.classList.remove('active'); document.body.style.overflow = ''; }
    if(mobileBtn) mobileBtn.addEventListener('click', openMobileNav);
    if(backBtn) backBtn.addEventListener('click', closeMobileNav);
    if(menuOverlay) menuOverlay.addEventListener('click', closeMobileNav);
    
    // Header scroll effect
    window.addEventListener('scroll', function() {
        const header = document.querySelector('.site-header');
        if(header && window.scrollY > 100) {
            header.style.padding = '10px 0';
        } else if(header) {
            header.style.padding = '18px 0';
        }
    });
</script>