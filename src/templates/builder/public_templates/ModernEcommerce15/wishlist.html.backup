{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist - {{ page.brand_name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --color-bg-primary: #F0EFE6;
            --color-bg-secondary: #EAEAEA;
            --color-stone: #C6C9D2;
            --color-warm: #DCCFC1;
            --color-taupe: #BBAEA8;
            --color-charcoal: #393831;
            --shadow-sm: 0 8px 20px rgba(0, 0, 0, 0.03), 0 2px 4px rgba(0, 0, 0, 0.02);
            --shadow-md: 0 12px 28px rgba(0, 0, 0, 0.05), 0 0 0 1px rgba(0, 0, 0, 0.01);
            --shadow-hover: 0 20px 32px -12px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.02);
            --transition-smooth: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        {% generate_color_variables %}
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background-color: var(--color-bg-primary);
            color: var(--color-charcoal);
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            overflow-x: hidden;
        }
        h1, h2, h3, .section-title { font-family: 'Syne', sans-serif; font-weight: 600; letter-spacing: -0.02em; }
        .container { max-width: 1440px; margin: 0 auto; padding: 0 32px; }
        .page-header { text-align: center; padding: 40px 0 32px; margin-bottom: 16px; }
        h1 { font-size: 3rem; font-weight: 700; margin-bottom: 1rem; color: var(--color-charcoal); position: relative; display: inline-block; }
        h1::after { content: ''; position: absolute; bottom: -12px; left: 50%; transform: translateX(-50%); width: 80px; height: 2px; background: var(--color-charcoal); }
        .page-header p { font-size: 1rem; color: var(--color-charcoal); opacity: 0.7; max-width: 600px; margin: 1rem auto 0; }
        .wishlist-stats { display: flex; justify-content: center; gap: 48px; margin: 32px 0 48px; flex-wrap: wrap; }
        .stat-card { text-align: center; background: var(--color-bg-secondary); padding: 20px 32px; border-radius: 24px; min-width: 150px; }
        .stat-number { font-size: 2rem; font-weight: 700; font-family: 'Syne', sans-serif; color: var(--color-charcoal); }
        .stat-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; margin-top: 8px; }
        .wishlist-actions { display: flex; justify-content: flex-end; margin-bottom: 32px; }
        .clear-wishlist-btn { background: transparent; border: 1px solid var(--color-stone); color: var(--color-charcoal); padding: 10px 24px; border-radius: 40px; font-family: 'Inter', sans-serif; font-size: 0.85rem; cursor: pointer; transition: var(--transition-smooth); display: flex; align-items: center; gap: 8px; }
        .clear-wishlist-btn:hover { border-color: var(--color-charcoal); background: var(--color-charcoal); color: var(--color-bg-primary); }
        .wishlist-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
        .wishlist-card { background: var(--color-bg-secondary); border-radius: 24px; overflow: hidden; transition: var(--transition-smooth); box-shadow: var(--shadow-sm); position: relative; }
        .wishlist-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-hover); }
        .wishlist-img { width: 100%; aspect-ratio: 4 / 5; background-size: cover; background-position: center; transition: transform 0.5s ease; }
        .wishlist-card:hover .wishlist-img { transform: scale(1.03); }
        .wishlist-info { padding: 1.2rem 1rem 1.2rem; }
        .wishlist-name { font-family: 'Syne', sans-serif; font-weight: 600; font-size: 1.1rem; margin-bottom: 0.5rem; color: var(--color-charcoal); }
        .wishlist-price { font-weight: 500; font-size: 1rem; color: #5a5650; margin-bottom: 1rem; }
        .wishlist-actions-buttons { display: flex; gap: 12px; }
        .add-to-cart-wishlist { flex: 1; background: var(--color-charcoal); color: var(--color-bg-primary); border: none; padding: 10px 16px; border-radius: 40px; font-family: 'Inter', sans-serif; font-weight: 500; font-size: 0.85rem; cursor: pointer; transition: var(--transition-smooth); display: flex; align-items: center; justify-content: center; gap: 8px; }
        .add-to-cart-wishlist:hover { background: #4f4c45; transform: translateY(-2px); }
        .remove-wishlist-btn { width: 42px; background: transparent; border: 1px solid var(--color-stone); border-radius: 40px; color: var(--color-charcoal); cursor: pointer; transition: var(--transition-smooth); display: flex; align-items: center; justify-content: center; }
        .remove-wishlist-btn:hover { border-color: #d43f31; color: #d43f31; transform: translateY(-2px); }
        .empty-wishlist { text-align: center; padding: 80px 20px; background: var(--color-bg-secondary); border-radius: 24px; margin: 32px 0; }
        .empty-wishlist-icon { font-size: 4rem; margin-bottom: 20px; opacity: 0.5; }
        .empty-wishlist h2 { font-size: 1.8rem; margin-bottom: 12px; }
        .empty-wishlist p { opacity: 0.7; margin-bottom: 24px; }
        .shop-now-wishlist-btn { display: inline-block; background: var(--color-charcoal); color: var(--color-bg-primary); padding: 14px 32px; border-radius: 40px; text-decoration: none; font-family: 'Syne', sans-serif; font-weight: 500; transition: var(--transition-smooth); }
        .shop-now-wishlist-btn:hover { background: #4f4c45; transform: translateY(-2px); }
        .recently-viewed { margin: 64px 0 48px; }
        .recently-viewed h2 { font-size: 1.8rem; margin-bottom: 32px; text-align: center; }
        .recently-viewed-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
        .recent-card { background: var(--color-bg-secondary); border-radius: 20px; overflow: hidden; transition: var(--transition-smooth); text-decoration: none; color: inherit; }
        .recent-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
        .recent-img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
        .recent-info { padding: 16px; }
        .recent-name { font-family: 'Syne', sans-serif; font-weight: 600; font-size: 0.95rem; margin-bottom: 6px; }
        .recent-price { font-size: 0.9rem; font-weight: 500; color: #5a5650; }
        @media (max-width: 1200px) { .wishlist-grid { grid-template-columns: repeat(3, 1fr); gap: 28px; } .recently-viewed-grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 992px) { .wishlist-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } .recently-viewed-grid { grid-template-columns: repeat(2, 1fr); } h1 { font-size: 2.5rem; } .wishlist-stats { gap: 24px; } .stat-card { padding: 16px 24px; min-width: 120px; } }
        @media (max-width: 768px) { .container { padding: 0 24px; } .wishlist-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto 64px; } .recently-viewed-grid { grid-template-columns: 1fr; max-width: 350px; margin: 0 auto; } h1 { font-size: 2rem; } .wishlist-stats { flex-direction: column; align-items: center; gap: 16px; } .stat-card { width: 100%; max-width: 250px; } .wishlist-actions { justify-content: center; } }
        @media (max-width: 480px) { .container { padding: 0 20px; } h1 { font-size: 1.8rem; } }
        {% generate_section_styles style_customizations 77 90 %}
        {% generate_background_images background_images 77 90 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-subdomain="{{ page.subdomain }}" style="margin-top: 80px;">
 {% include 'builder/public_templates/ModernEcommerce15/snippets/header1.html' %}
<main>
    <div class="container">
        <!-- Page Header -->
        <div class="page-header" id="section-77">
            <h1 id="section-78">{{ text_contents.56|default:"Your Wishlist" }}</h1>
            <p id="section-79">{{ text_contents.57|default:"Save your favorite pieces for later" }}</p>
        </div>

        {% for component in components %}{% if component.drop_zone == '77' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Wishlist Stats -->
        <div class="wishlist-stats" id="section-80">
            <div class="stat-card">
                <div class="stat-number" id="wishlistCount">{{ wishlist_items|length|default:"0" }}</div>
                <div class="stat-label">Items Saved</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="wishlistValue">{{ wish_price_total|currency:page|default:"$0" }}</div>
                <div class="stat-label">Total Value</div>
            </div>
            <div class="stat-card">
                <div class="stat-number" id="wishlistLowStock">{{ wish_low_stock_count|default:"0" }}</div>
                <div class="stat-label">Low in Stock</div>
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '80' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Wishlist Actions -->
        <div class="wishlist-actions">
            <button class="clear-wishlist-btn" id="section-81" id="clearWishlistBtn">
                <i class="fas fa-trash-alt" data-icon="40"></i>
                {{ text_contents.58|default:"Clear Wishlist" }}
            </button>
        </div>

        <!-- Wishlist Grid -->
        {% if wishlist_items %}
        <div id="wishlistWithItems">
            <div class="wishlist-grid" id="wishlistGrid">
                {% for item in wishlist_items %}
                <div class="wishlist-card" id="section-82" data-product-id="{{ item.product.id }}">
                    <div class="wishlist-img" style="background-image: url('{% if item.product.main_image %}{{ item.product.main_image.url }}{% else %}https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=600&auto=format{% endif %}');"></div>
                    <div class="wishlist-info">
                        <div class="wishlist-name" id="section-86">{{ item.product.title }}</div>
                        <div class="wishlist-price" id="section-87">{{ item.product.price|currency:page }}</div>
                        <div class="wishlist-actions-buttons">
                            <button class="add-to-cart-wishlist" data-add-to-cart="{{ item.product.id }}">
                                <i class="fas fa-shopping-bag" data-icon="41"></i>
                                Add to Cart
                            </button>
                            <button class="remove-wishlist-btn" data-remove-from-wishlist="{{ item.product.id }}">
                                <i class="fas fa-times" data-icon="42"></i>
                            </button>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% else %}
        <!-- Empty Wishlist State -->
        <div id="emptyWishlistState">
            <div class="empty-wishlist">
                <div class="empty-wishlist-icon">
                    <i class="far fa-heart"></i>
                </div>
                <h2>Your Wishlist is Empty</h2>
                <p>Start adding items you love to your wishlist. They'll appear here for easy access.</p>
                <a href="?page=products" class="shop-now-wishlist-btn" id="section-83">{{ text_contents.61|default:"Start Shopping" }}</a>
            </div>
        </div>
        {% endif %}

        {% for component in components %}{% if component.drop_zone == '83' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}

        <!-- Recently Viewed Section -->
        <div class="recently-viewed" id="section-84">
            <h2 id="section-85">{{ text_contents.62|default:"Recently Viewed" }}</h2>
            <div class="recently-viewed-grid">
                {% if recently_viewed_products %}
                    {% for viewed in recently_viewed_products|slice:":4" %}
                    <a href="/product/{{ viewed.product.slug }}/" class="recent-card">
                        <img class="recent-img" src="{% if viewed.product.main_image %}{{ viewed.product.main_image.url }}{% else %}https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=400&auto=format{% endif %}" alt="{{ viewed.product.title }}">
                        <div class="recent-info">
                            <div class="recent-name">{{ viewed.product.title|truncatechars:30 }}</div>
                            <div class="recent-price">{{ viewed.product.price|currency:page }}</div>
                        </div>
                    </a>
                    {% endfor %}
                {% else %}
                    <!-- Default recently viewed items -->
                    {% for product in products|slice:":4" %}
                    <a href="/product/{{ product.slug }}/" class="recent-card">
                        <img class="recent-img" src="{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.unsplash.com/photo-1556905055-8f358a7a47b2?w=400&auto=format{% endif %}" alt="{{ product.title }}">
                        <div class="recent-info">
                            <div class="recent-name">{{ product.title|truncatechars:30 }}</div>
                            <div class="recent-price">{{ product.price|currency:page }}</div>
                        </div>
                    </a>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        {% for component in components %}{% if component.drop_zone == '84' %}<section class="dynamic-component" data-instance-id="{{ component.instance_id }}">{{ component.html_content|safe }}</section>{% endif %}{% endfor %}
    </div>
</main>
 {% include 'builder/public_templates/ModernEcommerce15/snippets/footer.html' %}

<script src="{% static 'builder/js/cart-manager.js' %}"></script>
{% render_icon_script %}

<script>
    // Update wishlist stats (frontend calculation for dynamic updates)
    function updateWishlistStats() {
        const wishlistItems = document.querySelectorAll('#wishlistGrid .wishlist-card');
        const itemCount = wishlistItems.length;
        let totalValue = 0;
        let lowStockCount = 0;
        
        wishlistItems.forEach(item => {
            const priceText = item.querySelector('.wishlist-price').textContent.replace(/[^0-9.-]/g, '');
            const price = parseFloat(priceText);
            if(!isNaN(price)) totalValue += price;
            
            // Check for low stock (from data attribute if available)
            if(item.dataset.lowStock === 'true') lowStockCount++;
        });
        
        const currencySymbol = '{{ page.currency_symbol }}';
        document.getElementById('wishlistCount').textContent = itemCount;
        document.getElementById('wishlistValue').textContent = currencySymbol + totalValue.toFixed(2);
        document.getElementById('wishlistLowStock').textContent = lowStockCount;
        
        // Show/hide empty state
        const wishlistWithItems = document.getElementById('wishlistWithItems');
        const emptyWishlistState = document.getElementById('emptyWishlistState');
        
        if(itemCount === 0 && wishlistWithItems && emptyWishlistState) {
            wishlistWithItems.style.display = 'none';
            emptyWishlistState.style.display = 'block';
        } else if(wishlistWithItems && emptyWishlistState) {
            wishlistWithItems.style.display = 'block';
            emptyWishlistState.style.display = 'none';
        }
    }
    
    // Add to cart from wishlist (handled by cart-manager.js)
    document.querySelectorAll('.add-to-cart-wishlist').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const productId = btn.dataset.addToCart;
            if(window.cartManager) {
                window.cartManager.addToCart(productId, 1);
            }
        });
    });
    
    // Remove from wishlist
    document.querySelectorAll('.remove-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const productId = btn.dataset.removeFromWishlist;
            if(window.cartManager) {
                window.cartManager.removeFromWishlist(productId);
                const wishlistItem = btn.closest('.wishlist-card');
                wishlistItem.remove();
                setTimeout(updateWishlistStats, 100);
            }
        });
    });
    
    // Clear wishlist
    document.getElementById('clearWishlistBtn')?.addEventListener('click', () => {
        const wishlistItems = document.querySelectorAll('#wishlistGrid .wishlist-card');
        if(wishlistItems.length === 0) {
            alert('Your wishlist is already empty.');
            return;
        }
        
        if(confirm('Are you sure you want to clear your entire wishlist? This action cannot be undone.')) {
            if(window.cartManager) {
                window.cartManager.clearWishlist();
            }
            wishlistItems.forEach(item => item.remove());
            updateWishlistStats();
        }
    });
    
    // Initial stats calculation
    updateWishlistStats();
</script>
</body>
</html>