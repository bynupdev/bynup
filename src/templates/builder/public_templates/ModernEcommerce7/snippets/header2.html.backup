{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}
{% render_icon_data icon_customizations %}

<style>
     /* Header Styles */
        header {
            background-color: var(--light);
            position: fixed;
            width: 100%;
            z-index: 1000;
            padding: 15px 0;
            box-shadow: 0 2px 15px rgba(26, 61, 99, 0.05);
            
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            
        }

        .logo a {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .logo span {
            color: var(--highlight);
        }

        .nav-desktop {
            display: flex;
            align-items: center;
        }

        .nav-desktop ul {
            display: flex;
            list-style: none;
        }

        .nav-desktop li {
            margin-left: 30px;
        }

        .nav-desktop a {
            text-decoration: none;
            color: var(--primary);
            font-weight: 500;
            font-size: 15px;
            transition: color 0.3s;
            position: relative;
        }

        .nav-desktop a:hover {
            color: var(--highlight);
        }

        .nav-desktop a:after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            background: var(--highlight);
            left: 0;
            bottom: -5px;
            transition: width 0.3s;
        }

        .nav-desktop a:hover:after {
            width: 100%;
        }

        .nav-icons {
            display: flex;
            align-items: center;
            margin-left: 40px;
        }

        .nav-icons a {
            margin-left: 20px;
            color: var(--primary);
            font-size: 18px;
            transition: color 0.3s;
        }

        .nav-icons a:hover {
            color: var(--highlight);
        }

        .cart-count {
            background-color: var(--highlight);
            color: white;
            font-size: 10px;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: -8px;
            right: -8px;
        }

        .icon-wrapper {
            position: relative;
        }

        .sign-in-btn {
            background-color: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
            padding: 8px 20px;
            border-radius: 30px;
            text-decoration: none;
            margin-left: 20px;
            transition: all 0.3s;
        }

        .sign-in-btn:hover {
            background-color: var(--primary);
            color: white;
        }


        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 24px;
            color: var(--primary);
            cursor: pointer;
        }

        .mobile-menu {
            display: none;
            position: fixed;
            top: 70px;
            left: 0;
            width: 100%;
            background-color: var(--light);
            box-shadow: 0 5px 15px rgba(26, 61, 99, 0.1);
            padding: 20px;
            z-index: 999;
            transform: translateY(-10px);
            opacity: 0;
            transition: all 0.3s ease;
            max-height: calc(100vh - 70px);
            overflow-y: auto;
        }

        .mobile-menu.active {
            display: block;
            transform: translateY(0);
            opacity: 1;
        }

        .mobile-menu ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .mobile-menu li {
            margin-bottom: 15px;
        }

        .mobile-menu a {
            text-decoration: none;
            color: var(--primary);
            font-weight: 500;
            font-size: 18px;
            display: block;
            padding: 10px 0;
            border-bottom: 1px solid rgba(179, 207, 229, 0.3);
        }

        .mobile-menu .mobile-actions {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-top: 20px;
            padding-top: 10px;
            border-top: 1px solid rgba(179, 207, 229, 0.3);
        }

        .mobile-menu .mobile-actions a {
            flex: 1;
            text-align: center;
            border-bottom: none;
            background: rgba(179, 207, 229, 0.1);
            border-radius: 8px;
            padding: 12px;
        }

        /* Responsive Styles */
        @media (max-width: 1024px) {
            .hero-title {
                font-size: 42px;
            }
            
            .hero-container {
                gap: 40px;
            }
        }

        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: block;
            }
            
            .nav-desktop {
                display: none;
            }
            
            /* REMOVED: .mobile-menu { display: block; } - This was causing the issue */
            /* The mobile menu is now controlled by JavaScript and starts hidden */
            
            .hero-container {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 40px;
            }
            
            .hero-content {
                padding-right: 0;
                order: 2;
            }
            
            .hero-image-container {
                order: 1;
                height: 400px;
            }
            
            .hero-title {
                font-size: 36px;
            }
            
            .hero-subtitle {
                font-size: 18px;
            }
        }

        @media (max-width: 576px) {
            .hero {
                padding: 120px 0 60px;
            }
            
            .hero-title {
                font-size: 32px;
            }
            
            .hero-image-container {
                height: 300px;
            }
            
            .section-title {
                font-size: 30px;
            }
            
            .product-image {
                height: 180px;
            }
        }

        /* Animations */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in {
            animation: fadeIn 0.8s ease forwards;
        }

        .delay-1 { animation-delay: 0.2s; }
        .delay-2 { animation-delay: 0.4s; }
        .delay-3 { animation-delay: 0.6s; }

        /* Cart Badge */
        .cart-badge {
            position: relative;
        }

        .cart-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background-color: var(--highlight);
            color: white;
            font-size: 10px;
            border-radius: 50%;
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}
        {% generate_hover_keyframes %}
</style>

<header id="section-1">
    <div class="container header-container">
        <div class="logo">
            <a href="../../?page=home">
                <i class="fas fa-gem" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"Luxe" }}</span>
                <span id="section-3">{{ text_contents.2|default:"Essence" }}</span>
            </a>
        </div>
        
        <nav class="nav-desktop">
            <ul id="main-nav">
                <li id="section-4"><a href="../../?page=home" class="active">{{ text_contents.3|default:"HOME" }}</a></li>
                <li id="section-5"><a href="../../?page=products">{{ text_contents.4|default:"SHOP" }}</a></li>
                <li id="section-6"><a href="../../?page=categories">{{ text_contents.5|default:"COLLECTIONS" }}</a></li>
                <li id="section-7"><a href="../../?page=about">{{ text_contents.6|default:"ABOUT US" }}</a></li>
                <li id="section-8"><a href="../../?page=contact">{{ text_contents.7|default:"CONTACT" }}</a></li>
            </ul>

            <div class="nav-icons">
                <a href="../../?page=cart" class="icon-wrapper cart-badge">
                    <i class="fas fa-shopping-bag" data-icon="4"></i>
                    <span class="cart-count cart-counter">0</span>
                </a>
                <a href="../../?page=wishlist">
                    <i class="far fa-heart" data-icon="3"></i>
                </a>
            </div>
            
            <!-- USER DROPDOWN -->
            <div style="position:relative;" id="section-9">
                <a class="sign-in-btn" 
                   onclick="toggleDropdown()" 
                   style="cursor:pointer;">{{ text_contents.8|default:"Account" }}</a>

                <ul id="dropdown" 
                    style="display:none; position:absolute; right:0; top:40px; width:210px; background:white; border-radius:8px; padding:10px 0; list-style:none; margin:0; box-shadow:0 5px 15px rgba(0,0,0,0.15); transform:translateY(-5px); opacity:0; transition:all .2s ease; z-index:1001;">
                    
                    <!-- Close button -->
                    <div onclick="toggleDropdown()" 
                        style="text-align:right; padding:5px 15px; cursor:pointer;">
                        <i class="fa-solid fa-xmark" style="font-size:18px; color:#444;"></i>
                    </div>
                    {% if show_auth_links %}
                    {% if not is_website_member %}
                    <li>
                        <a href="{{ website_register_url }}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-user-plus"></i> Signup
                        </a>
                    </li>

                    <li>
                        <a href="{% url 'accounts:universal_login' %}?website_id={{ page.id }}&next={{ website_homepage_url|urlencode }}"
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </li>

                    <li>
                        <a href="{% url 'payments:customer_order_history' page.subdomain %}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-box"></i> Orders
                        </a>
                    </li>

                    {%else%}
                    <li>
                        <a href="{% url 'payments:customer_order_history' page.subdomain %}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-box"></i> Orders
                        </a>
                    </li>

                    <li>
                        <a href="{{ website_logout_url }}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                        </a>
                    </li>
                    {%endif%}
                    {%endif%}
                </ul>
            </div>
        </nav>

        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" id="mobileMenuBtn">
            <i class="fas fa-bars" data-icon="2"></i>
        </button>
    </div>
    
    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <ul>
            <li><a href="../../?page=home">Home</a></li>
            <li><a href="../../?page=products">Shop</a></li>
            <li><a href="../../?page=about">About Us</a></li>
            <li><a href="../../?page=contact">Contact</a></li>
            <li class="mobile-actions">
                <a href="../../?page=cart" style="position: relative;">
                    <i class="fas fa-shopping-bag" data-icon="4"></i> Cart 
                    <span class="cart-count cart-counter" style="position: relative; top: -15px; right: auto; margin-left: 5px; display: inline-flex;">0</span>
                </a>
                <a href="../../?page=wishlist" style="position: relative;">
                    <i class="far fa-heart" data-icon="3"></i> Wishlist 
                    <span class="cart-count wish-counter" style="position: relative; top: -15px; right: auto; margin-left: 5px; display: inline-flex;">0</span>
                </a>
            </li>
            
            <li><a href="{{ website_register_url }}"><i class="fas fa-user-plus"></i> Sign Up</a></li>
            <li><a href="{% url 'payments:customer_order_history' page.subdomain %}"><i class="fas fa-box"></i> Orders</a></li>
            <li><a href="{{ website_logout_url }}"><i class="fa-solid fa-right-from-bracket"></i> Log Out</a></li>
        </ul>
    </div>
    
    <div class="header-actions">
        <!-- These are commented out in your original, keeping as is -->
    </div>
</header>

{% render_icon_script %}

<script>
    // Mobile Menu Toggle
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');
    
    if (mobileMenuBtn && mobileMenu) {
        mobileMenuBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            mobileMenu.classList.toggle('active');
            
            // Change icon based on menu state
            const icon = mobileMenuBtn.querySelector('i');
            if (mobileMenu.classList.contains('active')) {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-times');
                // Prevent body scroll when menu is open
                document.body.style.overflow = 'hidden';
            } else {
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
                document.body.style.overflow = '';
            }
        });
        
        // Close mobile menu when clicking outside
        document.addEventListener('click', function(e) {
            if (mobileMenu.classList.contains('active') && 
                !mobileMenu.contains(e.target) && 
                e.target !== mobileMenuBtn && 
                !mobileMenuBtn.contains(e.target)) {
                mobileMenu.classList.remove('active');
                const icon = mobileMenuBtn.querySelector('i');
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
                document.body.style.overflow = '';
            }
        });
        
        // Close mobile menu when clicking a link
        const mobileLinks = document.querySelectorAll('.mobile-menu a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.remove('active');
                const icon = mobileMenuBtn.querySelector('i');
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
                document.body.style.overflow = '';
            });
        });
    }
    
    // Smooth scrolling for anchor links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            
            const targetId = this.getAttribute('href');
            if(targetId === '#') return;
            
            const targetElement = document.querySelector(targetId);
            if(targetElement) {
                window.scrollTo({
                    top: targetElement.offsetTop - 80,
                    behavior: 'smooth'
                });
            }
        });
    });
    
    // Add scroll effect to header
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header');
        if (window.scrollY > 100) {
            header.style.padding = '10px 0';
            header.style.boxShadow = '0 5px 20px rgba(26, 61, 99, 0.1)';
        } else {
            header.style.padding = '15px 0';
            header.style.boxShadow = '0 2px 15px rgba(26, 61, 99, 0.05)';
        }
    });
    
    // Fade-in animation on scroll
    const fadeElements = document.querySelectorAll('.fade-in');
    
    const fadeInOnScroll = function() {
        fadeElements.forEach(element => {
            const elementTop = element.getBoundingClientRect().top;
            const elementVisible = 150;
            
            if (elementTop < window.innerHeight - elementVisible) {
                element.style.opacity = "1";
                element.style.transform = "translateY(0)";
            }
        });
    };
    
    // Set initial state for fade-in elements
    fadeElements.forEach(element => {
        element.style.opacity = "0";
        element.style.transform = "translateY(20px)";
        element.style.transition = "opacity 0.8s ease, transform 0.8s ease";
    });
    
    window.addEventListener('scroll', fadeInOnScroll);
    // Trigger once on load
    fadeInOnScroll();
</script>

<script>
function toggleDropdown() {
    const menu = document.getElementById("dropdown");
    if (!menu) return;
    
    const isVisible = menu.style.display === "block";
    menu.style.display = isVisible ? "none" : "block";
    menu.style.opacity = isVisible ? "0" : "1";
    menu.style.transform = isVisible ? "translateY(-5px)" : "translateY(0px)";
}

// Close dropdown when clicking outside
document.addEventListener('click', function(e) {
    const dropdown = document.getElementById("dropdown");
    const accountBtn = document.querySelector('.sign-in-btn');
    
    if (dropdown && dropdown.style.display === "block" && 
        !dropdown.contains(e.target) && 
        !accountBtn.contains(e.target)) {
        dropdown.style.display = "none";
        dropdown.style.opacity = "0";
        dropdown.style.transform = "translateY(-5px)";
    }
});
</script>