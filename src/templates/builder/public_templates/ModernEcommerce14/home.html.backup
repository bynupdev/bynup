{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}



<!DOCTYPE html>
<html lang="en">
<head>
        
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | {{page.brand_name}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-luxury: #fbf9e2;
            --accent-rich: #965123;
            --metallic-gold: #bf8039;
            --deep-elegance: #462415;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 8px;
            --transition: all 0.3s ease;
        }
        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-luxury);
            color: var(--deep-elegance);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Header / Navigation */
        header {
            /* position: fixed;
            top: 0;
            left: 0; */
            width: 100%;
            z-index: 1000;
            padding: 1.5rem 0;
            background-color: rgba(251, 249, 226, 0.95);
            box-shadow: 0 2px 20px rgba(70, 36, 21, 0.05);
            transition: var(--transition);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo a {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            font-weight: 600;
            color: var(--deep-elegance);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--deep-elegance);
        }

        .logo span span {
            color: var(--metallic-gold);
        }

        .desktop-nav {
            display: flex;
            gap: 2.5rem;
        }

        .desktop-nav a {
            text-decoration: none;
            color: var(--deep-elegance);
            font-weight: 300;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            transition: var(--transition);
            position: relative;
        }

        .desktop-nav a:hover {
            color: var(--metallic-gold);
        }

        .desktop-nav a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background: linear-gradient(90deg, var(--metallic-gold), var(--accent-rich));
            transition: width 0.3s ease;
        }

        .desktop-nav a:hover::after {
            width: 100%;
        }

        .nav-icons {
            display: flex;
            gap: 1.5rem;
        }

        .nav-icons i {
            font-size: 1.3rem;
            color: var(--deep-elegance);
            cursor: pointer;
            transition: var(--transition);
        }

        .nav-icons i:hover {
            color: var(--metallic-gold);
        }

        /* Account Dropdown */
        .account-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--nav-text, white);
            min-width: 200px;
            box-shadow: 0 8px 25px rgba(70, 36, 21, 0.1);
            z-index: 1;
            border-radius: var(--border-radius);
            overflow: hidden;
            margin-top: 10px;
        }

        .dropdown-content a {
            color: var(--deep-elegance);
            padding: 1rem 1.5rem;
            text-decoration: none;
            display: block;
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(251, 249, 226, 0.5);
            transition: var(--transition);
        }

        .dropdown-content a:hover {
            background-color: rgba(251, 249, 226, 0.3);
            color: var(--accent-rich);
        }

        .account-dropdown:hover .dropdown-content {
            display: block;
        }

        /* Hamburger Menu */
        .hamburger {
            display: none;
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--deep-elegance);
        }

        .mobile-nav {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--bg-luxury);
            z-index: 9999;
            padding: 2rem;
            transform: translateX(-100%);
            transition: transform 0.4s ease;
        }

        .mobile-nav.active {
            transform: translateX(0);
        }

        .mobile-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(70, 36, 21, 0.1);
        }

        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-nav-links a {
            text-decoration: none;
            color: var(--deep-elegance);
            font-size: 1.3rem;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(70, 36, 21, 0.05);
        }

        .back-button {
            background: none;
            border: none;
            font-size: 1.2rem;
            color: var(--deep-elegance);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        /* Hero Section */
        section.hero {
            height: 100vh;
            width: 100%;
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
            margin-top: 80px;
            background-image: url('https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1467&q=80');
            background-size: cover;
            background-position: center 30%;

        }

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            /* background-image: url('https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1467&q=80');
            background-size: cover;
            background-position: center 30%; */
            z-index: 1;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to right, rgba(70, 36, 21, 0.3) 0%, rgba(70, 36, 21, 0.1) 50%, rgba(251, 249, 226, 0.1) 100%);
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            max-width: 650px;
            padding: 0 3rem;
        }

        h1 {
            font-size: 4.5rem;
            color: var(--nav-text, white);
            line-height: 1.1;
            margin-bottom: 1.5rem;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
        }

        p {
            font-size: 1.3rem;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 2.5rem;
            font-weight: 300;
            max-width: 550px;
        }

        a.cta-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent-rich), var(--metallic-gold));
            color: var(--nav-text, white);
            padding: 1.2rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: var(--border-radius);
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(150, 81, 35, 0.2);
        }

        a.cta-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(150, 81, 35, 0.3);
        }

        .hero-images {
            display: none;
        }

        /* New Arrivals Section */
        section.new-arrivals{
            padding: var(--spacing-xl) 0;
            text-align: center;
        }

        .section-header {
            text-align: center;
            margin-bottom: var(--spacing-lg);
        }

        h2{
            font-size: 3rem;
            color: var(--deep-elegance);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h2::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, var(--metallic-gold), var(--accent-rich));
        }

        .hero-content p{
            color: var(--deep-elegance);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
            opacity: 0.8;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2.5rem;
            margin-bottom: var(--spacing-lg);
        }

        div.product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
            position: relative;
        }

        div.product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(70, 36, 21, 0.1);
        }

        .product-img {
            height: 300px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        div.product-card:hover .product-img {
            transform: scale(1.05);
        }

        .product-info {
            padding: 1.5rem;
            text-align: left;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            color: var(--deep-elegance);
            margin-bottom: 0.5rem;
        }

        .product-price {
            color: var(--accent-rich);
            font-weight: 500;
            font-size: 1.1rem;
        }

        .product-category {
            color: var(--metallic-gold);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .see-more {
            display: inline-block;
            background-color: transparent;
            color: var(--accent-rich);
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: var(--border-radius);
            transition: var(--transition);
            border: 1px solid var(--accent-rich);
        }

        .see-more:hover {
            background-color: var(--accent-rich);
            color: var(--nav-text, white);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
            margin: 2rem 0;
        }

        .empty-state h3 {
            color: var(--deep-elegance);
            margin-bottom: 1rem;
        }

        .empty-state a {
            color: var(--accent-rich);
            text-decoration: none;
            font-weight: 500;
        }

        .empty-state a:hover {
            text-decoration: underline;
        }

       

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 2rem;
            }
            
            h1 {
                font-size: 4rem;
            }
        }

        @media (max-width: 992px) {
            h1 {
                font-size: 3.5rem;
            }
            
            p.editable-text{
                font-size: 1.2rem;
            }
            
            .desktop-nav {
                gap: 2rem;
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .hamburger {
                display: block;
            }
            
            .desktop-nav {
                display: none;
            }
            
            section.hero {
                height: 80vh;
                margin-top: 70px;
                justify-content: center;
                text-align: center;
            }
            
            .hero-content {
                padding: 0 1.5rem;
            }
            
            h1.editable-text{
                font-size: 3rem;
            }
            
            p.editable-text {
                font-size: 1.1rem;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto 3rem;
            }
            
            h2{
                font-size: 2.5rem;
            }
            
            .container {
                padding: 0 1.5rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 2.5rem;
            }
            
            p{
                font-size: 1rem;
            }
            
            a.cta-btn,
            .see-more {
                padding: 1rem 2rem;
                font-size: 1rem;
            }
            
            h2{
                font-size: 2.2rem;
            }
            
            .footer-section{
                min-width: 100%;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}
        {% generate_hover_keyframes%}
    </style>
</head>
<body>
    <!-- Header -->
    {%include 'builder/public_templates/ModernEcommerce14/snippets/header1.html'%}

    {% for component in components %}
    {% if component.drop_zone == '1' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Hero Section -->
    <section class="hero" id="section-13">
        <div class="hero-bg"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h1 id="section-14">{{ text_contents.12|default:'Where Elegance Becomes Timeless' }}</h1>
            <p id="section-15">{{ text_contents.13|default:"Discover handcrafted jewelry designed to celebrate beauty, luxury, and lasting moments. Each piece is an heirloom, crafted with meticulous attention to detail." }}</p>
            <br>
            <a href="?page=products" class="cta-btn" id="section-16">{{ text_contents.14|default:"Shop the Collection" }}</a>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '13' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- New Arrivals Section -->
    <section class="new-arrivals" id="section-17">
        <div class="container">
            <div class="section-header">
                <h2 id="section-18">{{ text_contents.15|default:"New Arrivals" }}</h2>
                <p id="section-19">{{ text_contents.16|default:"Our latest creations, crafted with exceptional attention to detail and timeless design." }}</p>
            </div>
            
            {% if products %}
            <div class="products-grid">
                {% for product in products %}
                <a href="/product/{{ product.slug }}/"  class="product-image-link">
                <div class="product-card" id="section-20">
                    <div class="product-img" style="background-image: url('{{ product.main_image.url }}')"></div>
                    <div class="product-info">
                        <div class="product-category" id="section-21">{{ product.category|truncatewords:3 }}</div>
                        <div class="product-name" id="section-22">{{ product.title|truncatewords:3}}</div>
                        <div class="product-price" id="section-23">{{ product.price|currency:page}}</div>
                    </div>
                </div>
                </a>
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-state">
                <h3>No Products Yet</h3>
                <p>You haven't added any products to your collection yet. <a href="/admin/add-product">Add your first product</a> to get started.</p>
            </div>
            {% endif %}
            
            <a href="?page=products" class="see-more" id="section-24">{{ text_contents.17|default:"View All Collections" }}</a>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '17' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Footer -->
    {%include 'builder/public_templates/ModernEcommerce14/snippets/footer.html'%}

    {% for component in components %}
    {% if component.drop_zone == '25' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    
</body>
</html>