{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500&display=swap" rel="stylesheet">
    
    {% render_icon_data icon_customizations %}

    <style>
        :root {
            --bg-luxury: #fbf9e2;
            --accent-rich: #965123;
            --metallic-gold: #bf8039;
            --deep-elegance: #462415;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 8px;
            --transition: all 0.3s ease;
        }

        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-luxury);
            color: var(--deep-elegance);
            overflow-x: hidden;
            line-height: 1.6;
        }

        main {
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        .page-header h1 {
            font-size: 3.5rem;
            color: var(--deep-elegance);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        .page-header h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--metallic-gold), var(--accent-rich));
        }

        /* Cart Content Layout */
        .cart-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Cart Items Section */
        .cart-items {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(70, 36, 21, 0.05);
            padding: var(--spacing-md);
        }

        .cart-items-header {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(70, 36, 21, 0.1);
            font-weight: 500;
            color: var(--deep-elegance);
            margin-bottom: var(--spacing-md);
        }

        .cart-item {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 0.5fr;
            align-items: center;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid rgba(70, 36, 21, 0.05);
            transition: var(--transition);
        }

        .cart-item:hover {
            background: rgba(251, 249, 226, 0.2);
        }

        /* Product Info in Cart */
        .cart-product-info {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }

        .cart-product-image {
            width: 100px;
            height: 100px;
            border-radius: calc(var(--border-radius) - 2px);
            background-size: cover;
            background-position: center;
            flex-shrink: 0;
        }

        .cart-product-details {
            flex: 1;
        }

        .cart-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            color: var(--deep-elegance);
            margin-bottom: 0.3rem;
        }

        .cart-product-category {
            color: var(--metallic-gold);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .cart-product-variant {
            font-size: 0.9rem;
            color: rgba(70, 36, 21, 0.7);
        }

        .cart-product-price {
            font-size: 1.3rem;
            color: var(--accent-rich);
            font-weight: 500;
        }

        /* Quantity Controls */
        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .quantity-btn {
            width: 32px;
            height: 32px;
            background: white;
            border: 1px solid rgba(70, 36, 21, 0.2);
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.1rem;
            color: var(--deep-elegance);
        }

        .quantity-btn:hover {
            background: var(--bg-luxury);
            border-color: var(--metallic-gold);
            color: var(--accent-rich);
        }

        .quantity-input {
            width: 50px;
            height: 32px;
            text-align: center;
            border: 1px solid rgba(70, 36, 21, 0.2);
            border-radius: 4px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
        }

        .quantity-input:focus {
            outline: none;
            border-color: var(--metallic-gold);
        }

        .item-total {
            font-size: 1.3rem;
            color: var(--accent-rich);
            font-weight: 500;
        }

        /* Remove Button */
        .remove-btn {
            background: none;
            border: none;
            color: rgba(70, 36, 21, 0.5);
            cursor: pointer;
            font-size: 1.2rem;
            transition: var(--transition);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
        }

        .remove-btn:hover {
            color: var(--accent-rich);
            background: rgba(150, 81, 35, 0.1);
        }

        /* Cart Summary */
        .cart-summary {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(70, 36, 21, 0.05);
            padding: var(--spacing-md);
            height: fit-content;
            position: sticky;
            top: 120px;
        }

        .cart-summary h2 {
            font-size: 1.8rem;
            margin-bottom: var(--spacing-md);
            color: var(--deep-elegance);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(70, 36, 21, 0.1);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            color: var(--deep-elegance);
        }

        .summary-row.total {
            font-size: 1.3rem;
            font-weight: 500;
            color: var(--accent-rich);
            margin-top: var(--spacing-sm);
            padding-top: var(--spacing-sm);
            border-top: 1px solid rgba(70, 36, 21, 0.1);
        }

        /* Promo Code */
        .promo-code {
            margin: var(--spacing-md) 0;
        }

        .promo-code h3 {
            font-size: 1.1rem;
            margin-bottom: 0.8rem;
            color: var(--deep-elegance);
        }

        .promo-input-group {
            display: flex;
            gap: 0.5rem;
        }

        .promo-input {
            flex: 1;
            padding: 0.8rem 1rem;
            border: 1px solid rgba(70, 36, 21, 0.2);
            border-radius: var(--border-radius);
            font-family: 'Montserrat', sans-serif;
            font-size: 1rem;
        }

        .promo-input:focus {
            outline: none;
            border-color: var(--metallic-gold);
        }

        .apply-promo-btn {
            background: var(--metallic-gold);
            color: var(--nav-text, white);
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: var(--border-radius);
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.95rem;
        }

        .apply-promo-btn:hover {
            background: var(--accent-rich);
            transform: translateY(-2px);
        }

        /* Checkout Button */
        .checkout-btn {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, var(--accent-rich), var(--deep-elegance));
            color: var(--nav-text, white);
            padding: 1.2rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            border-radius: var(--border-radius);
            border: none;
            cursor: pointer;
            transition: var(--transition);
            margin-top: var(--spacing-md);
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .checkout-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(70, 36, 21, 0.3);
        }

        /* Continue Shopping */
        .continue-shopping {
            text-align: center;
            margin-top: var(--spacing-sm);
        }

        .continue-shopping a {
            color: var(--accent-rich);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .continue-shopping a:hover {
            text-decoration: underline;
        }

        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            grid-column: 1 / -1;
        }

        .empty-cart-icon {
            font-size: 4rem;
            color: var(--metallic-gold);
            margin-bottom: var(--spacing-md);
        }

        .empty-cart h2 {
            font-size: 2.2rem;
            color: var(--deep-elegance);
            margin-bottom: var(--spacing-sm);
        }

        .empty-cart p {
            color: var(--deep-elegance);
            opacity: 0.8;
            margin-bottom: var(--spacing-md);
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-now-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--accent-rich), var(--metallic-gold));
            color: var(--nav-text, white);
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: var(--border-radius);
            transition: var(--transition);
        }

        .shop-now-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(150, 81, 35, 0.3);
        }

        /* You May Also Like Section */
        .you-may-also-like {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(70, 36, 21, 0.1);
        }

        .you-may-also-like h2 {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--deep-elegance);
        }

        .recommended-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .recommended-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(70, 36, 21, 0.05);
            text-decoration: none;
            color: inherit;
        }

        .recommended-product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(70, 36, 21, 0.1);
        }

        .recommended-product-img {
            height: 250px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }

        .recommended-product-card:hover .recommended-product-img {
            transform: scale(1.05);
        }

        .recommended-product-info {
            padding: 1.5rem;
        }

        .recommended-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            color: var(--deep-elegance);
            margin-bottom: 0.5rem;
        }

        .recommended-product-price {
            color: var(--accent-rich);
            font-weight: 500;
            margin-bottom: 1rem;
        }

        .add-to-cart-small {
            width: 100%;
            background: var(--bg-luxury);
            color: var(--accent-rich);
            padding: 0.7rem;
            font-size: 0.9rem;
            font-weight: 300;
            border-radius: var(--border-radius);
            border: 1px solid var(--accent-rich);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-to-cart-small:hover {
            background: var(--accent-rich);
            color: var(--nav-text, white);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .recommended-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .page-header h1 {
                font-size: 3.2rem;
            }
        }

        @media (max-width: 992px) {
            .cart-content {
                grid-template-columns: 1fr;
            }
            .cart-summary {
                position: static;
                order: -1;
            }
            .recommended-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .cart-items-header {
                display: none;
            }
            .cart-item {
                grid-template-columns: 1fr;
                gap: var(--spacing-sm);
                padding: var(--spacing-md) 0;
                position: relative;
            }
            .cart-product-price {
                position: absolute;
                top: var(--spacing-md);
                right: 0;
            }
            .remove-btn {
                position: absolute;
                top: var(--spacing-md);
                right: 0;
            }
            .quantity-controls {
                justify-content: flex-start;
            }
        }

        @media (max-width: 768px) {
            main {
                padding-top: 80px;
            }
            .page-header h1 {
                font-size: 2.5rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .cart-items, .cart-summary {
                padding: var(--spacing-sm);
            }
            .cart-product-image {
                width: 80px;
                height: 80px;
            }
            .recommended-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .you-may-also-like h2 {
                font-size: 2rem;
            }
        }

        @media (max-width: 576px) {
            .page-header h1 {
                font-size: 2.2rem;
            }
            .promo-input-group {
                flex-direction: column;
            }
            .apply-promo-btn,
            .checkout-btn,
            .shop-now-btn {
                padding: 0.8rem 1.5rem;
                font-size: 1rem;
            }
            .empty-cart h2 {
                font-size: 1.8rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 139 175 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 139 175 %}
        
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce14/snippets/header1.html' %}

    <!-- Component Drop Zones for Section 1 -->
    {% for component in components %}
        {% if component.drop_zone == '1' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <main>
        <!-- Page Header -->
        <div class="page-header" id="section-139">
            <div class="container">
                <h1 id="section-140">{{ text_contents.300|default:"Your Shopping Cart" }}</h1>
            </div>
        </div>

        <!-- Component Drop Zones for Section 139 -->
        {% for component in components %}
            {% if component.drop_zone == '139' %}
                <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                    {{ component.html_content|safe }}
                </section>
            {% endif %}
        {% endfor %}

        <!-- Cart Content -->
        <div class="container">
            {% if cart and cart.items.all %}
                <div class="cart-content">
                    <!-- Cart Items -->
                    <div class="cart-items" id="section-141">
                        <div class="cart-items-header">
                            <div id="section-164">{{ text_contents.301|default:"Product" }}</div>
                            <div id="section-165">{{ text_contents.302|default:"Price" }}</div>
                            <div id="section-166">{{ text_contents.303|default:"Quantity" }}</div>
                            <div id="section-167">{{ text_contents.304|default:"Total" }}</div>
                            <div></div>
                        </div>
                        
                        {% for item in cart.items.all %}
                            <div class="cart-item" id="section-142" data-cart-item-id="{{ item.id }}" data-product-id="{{ item.product.id }}">
                                <div class="cart-product-info">
                                    <div class="cart-product-image" style="background-image: url('{% if item.product.main_image %}{{ item.product.main_image.url }}{% else %}https://images.unsplash.com/photo-1602173574767-37ac01994b2a?ixlib=rb-4.0.3&auto=format&fit=crop&w=200&q=80{% endif %}')"></div>
                                    <div class="cart-product-details">
                                        <div class="cart-product-name" id="section-143">{{ item.product.title }}</div>
                                        <div class="cart-product-category" id="section-144">{{ item.product.category.name|default:"JEWELRY" }}</div>
                                        <div class="cart-product-variant" id="section-145">
                                            {% if item.selected_color or item.selected_size %}
                                                Color: {{ item.selected_color|default:"N/A" }} | Size: {{ item.selected_size|default:"N/A" }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                                <div class="cart-product-price" id="section-146" data-price="{{ item.product.price }}">{{ item.product.price|currency:page }}</div>
                                <div class="quantity-controls">
                                    <button class="quantity-btn minus" data-action="decrement" data-product-id="{{ item.product.id }}">-</button>
                                    <input type="number" class="quantity-input" value="{{ item.quantity }}" min="1" max="10" data-product-id="{{ item.product.id }}">
                                    <button class="quantity-btn plus" data-action="increment" data-product-id="{{ item.product.id }}">+</button>
                                </div>
                                <div class="item-total" data-product-id="{{ item.product.id }}">{{ item.total_price|currency:page|default:item.product.price|currency:page }}</div>
                                <button class="remove-btn" data-action="remove" data-product-id="{{ item.product.id }}">
                                    <i class="fas fa-times" data-icon="50"></i>
                                </button>
                            </div>
                        {% endfor %}
                    </div>
                    
                    <!-- Cart Summary -->
                    <div class="cart-summary" id="section-147">
                        <h2 id="section-148">{{ text_contents.309|default:"Order Summary" }}</h2>
                        
                        <div class="summary-row">
                            <span id="section-168">{{ text_contents.310|default:"Subtotal" }}</span>
                            <span id="cart-subtotal" id="section-169">{{ cart.total_price|currency:page }}</span>
                        </div>
                        
                        <div class="summary-row">
                            <span id="section-170">{{ text_contents.312|default:"Shipping" }}</span>
                            <!-- <span id="cart-shipping" id="section-171">
                                {% if has_shipping_config %} <small>Calculated at Checkout</small> {% else %}Free{% endif %}
                            </span> -->
                            <span  id="section-171">
                                {% if has_shipping_config %} <small>Calculated at Checkout</small> {% else %}Free{% endif %}
                            </span>

                        </div>
                        
                        <div class="summary-row">
                            <span id="section-172">{{ text_contents.314|default:"Tax" }}</span>
                            <!-- <span id="cart-tax" id="section-173" style="display: none;">{{ cart.tax_amount|currency:page|default:"0.00" }}</span> -->
                             <span  id="section-173" >---</span>

                        </div>
                        
                        <div class="summary-row total">
                            <span id="section-174">{{ text_contents.316|default:"Total" }}</span>
                            <span id="cart-total" id="section-175">{{ cart.final_total|currency:page|default:"0.00" }}</span>
                        </div>
                        
                        <!-- Promo Code -->
                        <div class="promo-code" id="section-149">
                            <h3 id="section-150">{{ text_contents.318|default:"Promo Code" }}</h3>
                            <div class="promo-input-group">
                                <input type="text" class="promo-input" id="promo-code-input" data-text="319" placeholder="{{ text_contents.319|default:'Enter code' }}">
                                <button class="apply-promo-btn" id="section-151" data-text="320" id="applyPromoBtn">{{ text_contents.320|default:"Apply" }}</button>
                            </div>
                        </div>
                        
                        <!-- Checkout Button -->
                        <button class="checkout-btn" id="section-152" data-text="321" onclick="proceedToCheckout()">
                            <i class="fas fa-lock" data-icon="51"></i> {{ text_contents.321|default:"Proceed to Checkout" }}
                        </button>
                        
                        <!-- Continue Shopping -->
                        <div class="continue-shopping">
                            <a href="?page=shop" id="section-153" data-text="322">
                                <i class="fas fa-arrow-left" data-icon="52"></i> {{ text_contents.322|default:"Continue Shopping" }}
                            </a>
                        </div>
                    </div>
                </div>
                
                <!-- You May Also Like -->
                <div class="you-may-also-like" id="section-158">
                    <h2 id="section-159">{{ text_contents.323|default:"You May Also Like" }}</h2>
                    <div class="recommended-grid">
                        {% for product in recommended_products|slice:":4" %}
                            <div class="recommended-product-card" id="section-160" data-product-id="{{ product.id }}">
                                <div class="recommended-product-img" style="background-image: url('{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80{% endif %}')"></div>
                                <div class="recommended-product-info">
                                    <div class="recommended-product-name" id="section-161">{{ product.title|truncatechars:30 }}</div>
                                    <div class="recommended-product-price" id="section-162">{{ product.price|currency:page }}</div>
                                    <button class="add-to-cart-small" id="section-163" data-text="326" data-product-id="{{ product.id }}">
                                        <i class="fas fa-cart-plus" data-icon="54"></i> {{ text_contents.326|default:"Add to Cart" }}
                                    </button>
                                </div>
                            </div>
                        {% empty %}
                            {% for product in products|slice:":4" %}
                                <div class="recommended-product-card" id="section-160" data-product-id="{{ product.id }}">
                                    <div class="recommended-product-img" style="background-image: url('{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80{% endif %}')"></div>
                                    <div class="recommended-product-info">
                                        <div class="recommended-product-name" id="section-161">{{ product.title|truncatechars:30 }}</div>
                                        <div class="recommended-product-price" id="section-162">{{ product.price|currency:page }}</div>
                                        <button class="add-to-cart-small" id="section-163" data-product-id="{{ product.id }}">
                                            <i class="fas fa-cart-plus" data-icon="54"></i> Add to Cart
                                        </button>
                                    </div>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <!-- Empty Cart State -->
                <div class="empty-cart" id="section-154">
                    <div class="empty-cart-icon">
                        <i class="fas fa-shopping-cart" data-icon="12"></i>
                    </div>
                    <h2 id="section-155">{{ text_contents.327|default:"Your Cart is Empty" }}</h2>
                    <p id="section-156">{{ text_contents.328|default:"Looks like you haven't added any jewelry to your cart yet. Explore our collection to find the perfect piece." }}</p>
                    <a href="?page=shop" class="shop-now-btn" id="section-157" data-text="329">{{ text_contents.329|default:"Start Shopping" }}</a>
                </div>
                
                <!-- You May Also Like (shown when cart is empty) -->
                <div class="you-may-also-like" id="section-158">
                    <h2 id="section-159">{{ text_contents.323|default:"You May Also Like" }}</h2>
                    <div class="recommended-grid">
                        {% for product in products|slice:":4" %}
                            <div class="recommended-product-card" id="section-160" data-product-id="{{ product.id }}">
                                <div class="recommended-product-img" style="background-image: url('{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80{% endif %}')"></div>
                                <div class="recommended-product-info">
                                    <div class="recommended-product-name" id="section-161">{{ product.title|truncatechars:30 }}</div>
                                    <div class="recommended-product-price" id="section-162">{{ product.price|currency:page }}</div>
                                    <button class="add-to-cart-small" id="section-163" data-product-id="{{ product.id }}">
                                        <i class="fas fa-cart-plus" data-icon="54"></i> Add to Cart
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Component Drop Zones for Section 158 -->
        {% for component in components %}
            {% if component.drop_zone == '158' %}
                <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                    {{ component.html_content|safe }}
                </section>
            {% endif %}
        {% endfor %}
    </main>

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce14/snippets/footer.html' %}

    <!-- Component Drop Zones for end -->
    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}

    <input type="hidden" value="{{ page.currency_symbol }}" id="currency-symbol">

    <!-- Cart Manager Script -->
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>

    <script>
        // Cart Data for Checkout
        let cartData = {
            items: [],
            subtotal: 0,
            shipping_amount: 0,
            tax_amount: 0,
            total_amount: 0,
            promo_code: null,
            discount_amount: 0
        };

        // Initialize Cart Data from Page
        function initializeCartData() {
            const cartItems = document.querySelectorAll('.cart-item');
            cartData.items = [];
            cartData.subtotal = 0;
            
            cartItems.forEach(item => {
                const productId = item.getAttribute('data-product-id');
                const priceElement = item.querySelector('.cart-product-price');
                const price = parseFloat(priceElement.getAttribute('data-price')) || 
                             parseFloat(priceElement.textContent.replace('$', '').replace('€', '').replace('£', '')) || 0;
                const quantity = parseInt(item.querySelector('.quantity-input').value) || 1;
                const itemTotal = price * quantity;
                
                cartData.items.push({
                    id: productId,
                    title: item.querySelector('.cart-product-name')?.textContent || 'Product',
                    price: price,
                    quantity: quantity,
                    total_price: itemTotal
                });
                cartData.subtotal += itemTotal;
            });
            
            cartData.shipping_amount = 0;
            cartData.tax_amount = 0;
            cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;
            
            updateCartSummary();
        }

        function updateCartSummary() {
            const currencySymbol = document.getElementById('currency-symbol').value || '$';
            const subtotalElement = document.getElementById('cart-subtotal');
            const shippingElement = document.getElementById('cart-shipping');
            const taxElement = document.getElementById('cart-tax');
            const totalElement = document.getElementById('cart-total');
            
            if (subtotalElement) subtotalElement.textContent = currencySymbol + cartData.subtotal.toFixed(2);
            
            if (shippingElement) {
                if (cartData.shipping_amount === 0) {
                    shippingElement.textContent = 'FREE';
                } else {
                    shippingElement.textContent = currencySymbol + cartData.shipping_amount.toFixed(2);
                }
            }
            
            if (taxElement) taxElement.textContent = currencySymbol + cartData.tax_amount.toFixed(2);
            if (totalElement) totalElement.textContent = currencySymbol + cartData.total_amount.toFixed(2);
        }

        function updateItemTotal(productId, quantity) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return;
            
            const priceElement = itemElement.querySelector('.cart-product-price');
            const price = parseFloat(priceElement.getAttribute('data-price')) || 
                         parseFloat(priceElement.textContent.replace('$', '').replace('€', '').replace('£', '')) || 0;
            const itemTotal = price * quantity;
            
            const itemTotalElement = itemElement.querySelector('.item-total');
            if (itemTotalElement) {
                const currencySymbol = document.getElementById('currency-symbol').value || '$';
                itemTotalElement.textContent = currencySymbol + itemTotal.toFixed(2);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            initializeCartData();
            
            // Quantity button events
            document.querySelectorAll('.quantity-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const action = this.getAttribute('data-action');
                    const productId = this.getAttribute('data-product-id');
                    const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                    if (!input) return;
                    
                    let currentValue = parseInt(input.value);
                    
                    if (action === 'increment' && currentValue < 10) {
                        input.value = currentValue + 1;
                        if (window.cartManager) {
                            window.cartManager.incrementCartItem(productId, 1);
                        }
                    } else if (action === 'decrement' && currentValue > 1) {
                        input.value = currentValue - 1;
                        if (window.cartManager) {
                            window.cartManager.decrementCartItem(productId, 1);
                        }
                    }
                    updateItemTotal(productId, parseInt(input.value));
                    initializeCartData();
                });
            });
            
            // Quantity input change events
            document.querySelectorAll('.quantity-input').forEach(input => {
                input.addEventListener('change', function() {
                    const productId = this.getAttribute('data-product-id');
                    let value = parseInt(this.value);
                    
                    if (value < 1) {
                        value = 1;
                        this.value = 1;
                    } else if (value > 10) {
                        value = 10;
                        this.value = 10;
                    }
                    
                    if (window.cartManager) {
                        window.cartManager.updateCartItemQuantity(productId, value);
                    }
                    updateItemTotal(productId, value);
                    initializeCartData();
                });
            });
            
            // Remove button events
            document.querySelectorAll('.remove-btn[data-action="remove"]').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    if (window.cartManager) {
                        window.cartManager.removeFromCart(productId);
                    }
                    const cartItem = this.closest('.cart-item');
                    if (cartItem) {
                        cartItem.remove();
                        initializeCartData();
                    }
                });
            });
            
            // Add to cart from recommended products
            document.querySelectorAll('.add-to-cart-small').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const productId = this.getAttribute('data-product-id');
                    if (window.cartManager) {
                        window.cartManager.addToCart(productId, 1);
                    } else {
                        console.log('Added product ' + productId + ' to cart');
                        alert('Item added to cart!');
                    }
                });
            });
            
            // Promo code application
            const applyPromoBtn = document.getElementById('applyPromoBtn');
            if (applyPromoBtn) {
                applyPromoBtn.addEventListener('click', applyPromoCode);
            }
            
            const promoInput = document.querySelector('.promo-input');
            if (promoInput) {
                promoInput.addEventListener('keypress', function(e) {
                    if (e.key === 'Enter') {
                        applyPromoCode();
                    }
                });
            }
            
            document.addEventListener('cartUpdated', function() {
                setTimeout(() => {
                    location.reload();
                }, 500);
            });
        });
        
        function applyPromoCode() {
            const promoInput = document.querySelector('.promo-input');
            const promoCode = promoInput ? promoInput.value.trim() : '';
            
            if (!promoCode) {
                alert('Please enter a promo code');
                return;
            }
            
            const validPromoCodes = {
                'ELEGANCE10': 0.10,
                'JEWELRY15': 0.15,
                'FREE_SHIP': 'free_shipping'
            };
            
            if (validPromoCodes[promoCode]) {
                const discount = validPromoCodes[promoCode];
                if (discount === 'free_shipping') {
                    cartData.shipping_amount = 0;
                    cartData.promo_code = promoCode;
                    cartData.discount_amount = 0;
                    alert('Free shipping applied!');
                } else {
                    cartData.discount_amount = cartData.subtotal * discount;
                    cartData.promo_code = promoCode;
                    alert(`Promo code applied! ${discount * 100}% discount added.`);
                }
                cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;
                updateCartSummary();
            } else {
                alert('Invalid promo code');
            }
        }
        
        function proceedToCheckout() {
            if (cartData.items.length === 0) {
                alert('Your cart is empty. Please add items before checkout.');
                return;
            }
            
            const hostname = window.location.hostname;
            const pageDomain = document.body.getAttribute('data-page-subdomain');
            const subdomain = hostname.includes('localhost') ? pageDomain : hostname.split('.')[0];
            
            const checkoutData = {
                ...cartData,
                items: cartData.items.map(item => ({
                    ...item,
                    selected_color: getSelectedColor(item.id) || '',
                    selected_size: getSelectedSize(item.id) || ''
                }))
            };
            
            window.location.href = `/payments/select-payment/${subdomain}/?type=cart&cart=${encodeURIComponent(JSON.stringify(checkoutData))}`;
        }
        
        function getSelectedColor(productId) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return '';
            const variantText = itemElement.querySelector('.cart-product-variant')?.textContent || '';
            const colorMatch = variantText.match(/Color:\s*([^|]+)/);
            return colorMatch ? colorMatch[1].trim() : '';
        }
        
        function getSelectedSize(productId) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return '';
            const variantText = itemElement.querySelector('.cart-product-variant')?.textContent || '';
            const sizeMatch = variantText.match(/Size:\s*([^|]+)/);
            return sizeMatch ? sizeMatch[1].trim() : '';
        }
        
        function triggerCartUpdate() {
            const event = new Event('cartUpdated');
            document.dispatchEvent(event);
        }
    </script>
</body>
</html>