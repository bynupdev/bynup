{% load static %}
{% load style_filters %}

{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}
{% render_icon_data icon_customizations %}
<style>
    :root {
            --bg-luxury: #fbf9e2;
            --accent-rich: #965123;
            --metallic-gold: #bf8039;
            --deep-elegance: #462415;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 8px;
            --transition: all 0.3s ease;
        }
            {%generate_color_variables%}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-luxury);
            color: var(--deep-elegance);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Header / Navigation */
        header.editable-section.no-drop-zone[data-section="1"] {
            /* position: fixed;
            top: 0;
            left: 0; */
            width: 100%;
            z-index: 1000;
            padding: 1.5rem 0;
            background-color: rgba(251, 249, 226, 0.95);
            box-shadow: 0 2px 20px rgba(70, 36, 21, 0.05);
            transition: var(--transition);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo a {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            font-weight: 600;
            color: var(--deep-elegance);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--deep-elegance);
        }

        .logo span span {
            color: var(--metallic-gold);
        }

        .desktop-nav {
            display: flex;
            gap: 2.5rem;
        }

        .desktop-nav a {
            text-decoration: none;
            color: var(--deep-elegance);
            font-weight: 300;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            transition: var(--transition);
            position: relative;
        }

        .desktop-nav a:hover {
            color: var(--metallic-gold);
        }

        .desktop-nav a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background: linear-gradient(90deg, var(--metallic-gold), var(--accent-rich));
            transition: width 0.3s ease;
        }

        .desktop-nav a:hover::after {
            width: 100%;
        }

        .nav-icons {
            display: flex;
            gap: 1.5rem;
        }

        .nav-icons i {
            font-size: 1.3rem;
            color: var(--deep-elegance);
            cursor: pointer;
            transition: var(--transition);
        }

        .nav-icons i:hover {
            color: var(--metallic-gold);
        }

        /* Account Dropdown */
        .account-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: white;
            min-width: 200px;
            box-shadow: 0 8px 25px rgba(70, 36, 21, 0.1);
            z-index: 1;
            border-radius: var(--border-radius);
            overflow: hidden;
            margin-top: 10px;
        }

        .dropdown-content a {
            color: var(--deep-elegance);
            padding: 1rem 1.5rem;
            text-decoration: none;
            display: block;
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(251, 249, 226, 0.5);
            transition: var(--transition);
        }

        .dropdown-content a:hover {
            background-color: rgba(251, 249, 226, 0.3);
            color: var(--accent-rich);
        }

        .account-dropdown:hover .dropdown-content {
            display: block;
        }

        /* Hamburger Menu */
        .hamburger {
            display: none;
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--deep-elegance);
        }

        .mobile-nav {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--bg-luxury);
            z-index: 9999;
            padding: 2rem;
            transform: translateX(-100%);
            transition: transform 0.4s ease;
        }

        .mobile-nav.active {
            transform: translateX(0);
        }

        .mobile-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(70, 36, 21, 0.1);
        }

        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-nav-links a {
            text-decoration: none;
            color: var(--deep-elegance);
            font-size: 1.3rem;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(70, 36, 21, 0.05);
        }

        .back-button {
            background: none;
            border: none;
            font-size: 1.2rem;
            color: var(--deep-elegance);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        

        /* Footer */
        footer {
            background-color: var(--deep-elegance);
            color: var(--bg-luxury);
            padding: var(--spacing-lg) 0;
            margin-top: var(--spacing-lg);
        }
        footer a{
            text-decoration: none;
            color: var(--bg-luxury);
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 3rem;
        }

        .footer-section {
            flex: 1;
            min-width: 250px;
        }

        h3.editable-section {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--metallic-gold);
        }

        .footer-column p, .footer-column a {
            color: rgba(251, 249, 226, 0.8);
            margin-bottom: 0.8rem;
            display: block;
            text-decoration: none;
            transition: var(--transition);
        }

        .footer-column a:hover {
            color: var(--metallic-gold);
        }

        .copyright {
            text-align: center;
            margin-top: 3rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(251, 249, 226, 0.1);
            color: rgba(251, 249, 226, 0.6);
            font-size: 0.9rem;
        }

        /* Responsive Styles */
       

        @media (max-width: 992px) {

            
            .desktop-nav {
                gap: 2rem;
            }
            
        } 

        @media (max-width: 768px) {
            .hamburger {
                display: block;
            }
            
            .desktop-nav {
                display: none;
            }
        }
            
            

        @media (max-width: 576px) {
           
            
            .footer-section{
                min-width: 100%;
            }
        }
        

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}
        {% generate_hover_keyframes %}

</style>

<footer id="section-25">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section" id="section-26">
                    <h3 id="section-27">{{ text_contents.21|default:"Timeless Elegance" }}</h3>
                    <ul>
                        <li id="section-28">{{ text_contents.22|default:"Since 1925, we have crafted jewelry that transcends trends, creating pieces that become cherished family heirlooms." }}</li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h3 id="section-29">{{ text_contents.23|default:"Quick Links" }}</h3>
                    <ul>
                        <li id="section-30"><a href="?page=home">{{ text_contents.24|default:"Home" }}</a></li>
                        <li id="section-31"><a href="?page=products">{{ text_contents.25|default:"Shop" }}</a></li>
                        <li id="section-32"><a href="?page=about">{{ text_contents.26|default:"About Us" }}</a></li>
                        <li id="section-33"><a href="?page=contact">{{ text_contents.27|default:"Contact" }}</a></li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h3 id="section-34">{{ text_contents.28|default:"Customer Service" }}</h3>
                    <ul>
                        <li id="section-35"><a href="{% url 'public_shipping_policy' subdomain=page.subdomain %}">{{ text_contents.29|default:"Shipping & Returns" }}</a></li>
                        <li id="section-36"><a href="{% url 'public_privacy' subdomain=page.subdomain %}">{{ text_contents.30|default:"Privacy Policy" }}</a></li>
                        <li id="section-37"><a href="{% url 'public_terms' subdomain=page.subdomain %}">{{ text_contents.31|default:"Terms & Conditions" }}</a></li>
                        <li id="section-38"><a href="?page=contact">{{ text_contents.32|default:"FAQ" }}</a></li>
                    </ul>
                </div>
                
                <div class="footer-section">
                    <h3 id="section-39">{{ text_contents.33|default:"Contact Us" }}</h3>
                    <ul>
                        <li id="section-40"><a href="tel:{{ text_contents.34}}">{{ text_contents.34|default:"+1 (555) 123-4567" }}</a></li>
                        <li id="section-41"><a href="mailto:{{ text_contents.35}}">{{ text_contents.35|default:"contact@timelesselegance.com" }}</a></li>
                        <li id="section-42">{{ text_contents.36|default:"123 Luxury Avenue, New York, NY 10001" }}</li>
                    </ul>
                    <!-- Social Media Section in Footer -->
                    {% if page.social_media.all %}
                    <div class="footer-social">
                        <h4 class="footer-title">Connect With Us</h4>
                        <div class="social-links">
                            {% for social in page.social_media.all %}
                                {% if social.is_active %}
                                <a href="{{ social.get_url }}" 
                                class="social-link" 
                                target="{{ social.open_in_new_tab|yesno:'_blank,_self' }}"
                                rel="noopener noreferrer"
                                title="{{ social.display_name|default:social.get_platform_display }}"
                                style="--social-color: {{ social.get_color }};">
                                    <i class="{{ social.get_icon }}"></i>
                                    {% if social.display_name %}
                                        <span class="social-name">{{ social.display_name }}</span>
                                    {% endif %}
                                </a>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>

                    <style>
                    .footer-social {
                        margin: 2rem 0 1rem;
                        text-align: center;
                    }

                    .footer-title {
                        font-family: 'Cormorant Garamond', serif;
                        font-size: 1.2rem;
                        color: var(--text-primary);
                        margin-bottom: 1rem;
                        position: relative;
                        display: inline-block;
                    }

                    .footer-title::after {
                        content: '';
                        position: absolute;
                        bottom: -5px;
                        left: 50%;
                        transform: translateX(-50%);
                        width: 40px;
                        height: 2px;
                        background: var(--secondary);
                    }

                    .social-links {
                        display: flex;
                        flex-wrap: wrap;
                        justify-content: center;
                        gap: 0.8rem;
                    }

                    .social-link {
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        width: 40px;
                        height: 40px;
                        border-radius: 50%;
                        background: var(--surface);
                        color: var(--text-primary);
                        text-decoration: none;
                        transition: all 0.3s ease;
                        border: 1px solid var(--border);
                        position: relative;
                        overflow: hidden;
                    }

                    .social-link:hover {
                        transform: translateY(-3px);
                        background: var(--social-color);
                        color: white;
                        border-color: var(--social-color);
                        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
                    }

                    .social-link i {
                        font-size: 1.1rem;
                        transition: all 0.3s ease;
                    }

                    .social-link .social-name {
                        display: none;
                        position: absolute;
                        bottom: -30px;
                        left: 50%;
                        transform: translateX(-50%);
                        background: var(--primary);
                        color: white;
                        padding: 0.2rem 0.5rem;
                        border-radius: 4px;
                        font-size: 0.7rem;
                        white-space: nowrap;
                        opacity: 0;
                        transition: all 0.3s ease;
                    }

                    .social-link:hover .social-name {
                        display: block;
                        bottom: -25px;
                        opacity: 1;
                    }

                    /* Responsive */
                    @media (max-width: 768px) {
                        .social-links {
                            gap: 0.5rem;
                        }
                        
                        .social-link {
                            width: 35px;
                            height: 35px;
                        }
                        
                        .social-link i {
                            font-size: 1rem;
                        }
                    }
                    </style>
                    {% endif %}
                </div>
            </div>
            
            <div class="copyright" id="section-43">
                <p id="section-44">{{ text_contents.37|default:"&copy; 2023 Timeless Elegance Jewelry. All rights reserved."|safe }}</p>
            </div>
        </div>
    </footer>
{% render_icon_script %}
<!-- Message Notification Container -->
<div id="backend-messages-container" class="backend-messages-container">
    <!-- Template for messages -->
    <div id="backend-message-template" class="backend-message" style="display: none;">
        <div class="backend-message-content">
            <i class="backend-message-icon"></i>
            <div class="backend-message-text">
                <strong class="backend-message-title"></strong>
                <div class="backend-message-body"></div>
            </div>
            <button class="backend-message-close" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="backend-message-progress"></div>
    </div>
</div>

<!-- Django Context Messages Display -->
{% if messages %}
<div id="django-messages-container" class="django-messages-container">
    {% for message in messages %}
    <div class="django-message django-message-{{ message.tags }}">
        <div class="django-message-content">
            <i class="fas fa-{% if message.tags == 'success' %}check-circle{% elif message.tags == 'error' or message.tags == 'danger' %}exclamation-circle{% else %}info-circle{% endif %}"></i>
            <div class="django-message-text">
                <strong>{{ message|capfirst }}</strong>
            </div>
            <button class="django-message-close" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}

<style>
    /* Backend Messages Container */
    .backend-messages-container,
    .django-messages-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 999999;
        display: flex;
        flex-direction: column;
        gap: 12px;
        max-width: 400px;
    }
    
    /* Backend Message Styling */
    .backend-message {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.15);
        border-left: 4px solid;
        animation: slideInBackendMessage 0.3s ease forwards;
        transform: translateX(100%);
        opacity: 0;
    }
    
    /* Message Types */
    .backend-message.success {
        border-left-color: #28a745;
        background: linear-gradient(90deg, rgba(40, 167, 69, 0.08) 0%, white 30%);
    }
    
    .backend-message.error {
        border-left-color: #dc3545;
        background: linear-gradient(90deg, rgba(220, 53, 69, 0.08) 0%, white 30%);
    }
    
    .backend-message.warning {
        border-left-color: #ffc107;
        background: linear-gradient(90deg, rgba(255, 193, 7, 0.08) 0%, white 30%);
    }
    
    .backend-message.info {
        border-left-color: #17a2b8;
        background: linear-gradient(90deg, rgba(23, 162, 184, 0.08) 0%, white 30%);
    }
    
    /* Django Messages */
    .django-message {
        background: white;
        border-radius: 8px;
        padding: 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.12);
        border-left: 4px solid;
        animation: slideInBackendMessage 0.3s ease forwards;
    }
    
    .django-message.success {
        border-left-color: #28a745;
        background: linear-gradient(90deg, rgba(40, 167, 69, 0.1) 0%, white 30%);
    }
    
    .django-message.error {
        border-left-color: #dc3545;
        background: linear-gradient(90deg, rgba(220, 53, 69, 0.1) 0%, white 30%);
    }
    
    .django-message.warning {
        border-left-color: #ffc107;
        background: linear-gradient(90deg, rgba(255, 193, 7, 0.1) 0%, white 30%);
    }
    
    .django-message.info {
        border-left-color: #17a2b8;
        background: linear-gradient(90deg, rgba(23, 162, 184, 0.1) 0%, white 30%);
    }
    
    /* Message Content */
    .backend-message-content,
    .django-message-content {
        display: flex;
        align-items: center;
        padding: 16px 20px;
        gap: 12px;
    }
    
    .backend-message-icon,
    .django-message-content i {
        font-size: 20px;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .success .backend-message-icon,
    .django-message.success i {
        background-color: #28a745;
        color: white;
    }
    
    .error .backend-message-icon,
    .django-message.error i {
        background-color: #dc3545;
        color: white;
    }
    
    .warning .backend-message-icon,
    .django-message.warning i {
        background-color: #ffc107;
        color: #212529;
    }
    
    .info .backend-message-icon,
    .django-message.info i {
        background-color: #17a2b8;
        color: white;
    }
    
    /* Message Text */
    .backend-message-text,
    .django-message-text {
        flex: 1;
        font-size: 14px;
        line-height: 1.5;
    }
    
    .backend-message-title {
        display: block;
        color: #212529;
        font-weight: 600;
        margin-bottom: 2px;
    }
    
    .backend-message-body {
        color: #495057;
        font-size: 13px;
        line-height: 1.4;
    }
    
    /* Close Button */
    .backend-message-close,
    .django-message-close {
        background: none;
        border: none;
        color: #6c757d;
        cursor: pointer;
        padding: 6px;
        font-size: 14px;
        transition: all 0.2s ease;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }
    
    .backend-message-close:hover,
    .django-message-close:hover {
        color: #495057;
        background-color: rgba(0, 0, 0, 0.05);
    }
    
    /* Progress Bar */
    .backend-message-progress {
        height: 3px;
        background: rgba(0, 0, 0, 0.1);
        width: 100%;
    }
    
    .backend-message.progressing .backend-message-progress {
        animation: progressBar 5s linear forwards;
    }
    
    /* Animations */
    @keyframes slideInBackendMessage {
        0% {
            transform: translateX(100%);
            opacity: 0;
        }
        100% {
            transform: translateX(0);
            opacity: 1;
        }
    }
    
    @keyframes slideOutBackendMessage {
        0% {
            transform: translateX(0);
            opacity: 1;
        }
        100% {
            transform: translateX(100%);
            opacity: 0;
        }
    }
    
    @keyframes progressBar {
        0% {
            width: 100%;
        }
        100% {
            width: 0%;
        }
    }
    
    .backend-message.slide-out {
        animation: slideOutBackendMessage 0.3s ease forwards;
    }
    
    /* Responsive Design */
    @media (max-width: 768px) {
        .backend-messages-container,
        .django-messages-container {
            top: 10px;
            right: 10px;
            left: 10px;
            max-width: calc(100% - 20px);
        }
        
        .backend-message,
        .django-message {
            max-width: 100%;
        }
        
        .backend-message-content,
        .django-message-content {
            padding: 14px 16px;
        }
    }
</style>

<script>
    // Backend Messages Manager
    const BackendMessages = {
        // Show a message from backend
        showBackendMessage(type, title, body = '', duration = 5000) {
            const container = document.getElementById('backend-messages-container');
            const template = document.getElementById('backend-message-template');
            
            if (!container || !template) {
                console.error('Backend messages container or template not found');
                return null;
            }
            
            // Clone template
            const messageElement = template.cloneNode(true);
            messageElement.id = 'backend-msg-' + Date.now();
            messageElement.style.display = 'block';
            
            // Set message type
            messageElement.classList.add(type);
            if (duration > 0) {
                messageElement.classList.add('progressing');
            }
            
            // Get appropriate icon
            const iconMap = {
                'success': 'fas fa-check-circle',
                'error': 'fas fa-exclamation-circle',
                'warning': 'fas fa-exclamation-triangle',
                'info': 'fas fa-info-circle'
            };
            
            // Fill content
            const iconElement = messageElement.querySelector('.backend-message-icon');
            const titleElement = messageElement.querySelector('.backend-message-title');
            const bodyElement = messageElement.querySelector('.backend-message-body');
            
            if (iconElement) {
                iconElement.className = `backend-message-icon ${iconMap[type] || iconMap.info}`;
            }
            
            if (titleElement) {
                titleElement.textContent = title;
            }
            
            if (bodyElement) {
                bodyElement.textContent = body;
                if (!body) {
                    bodyElement.style.display = 'none';
                }
            }
            
            // Add to container
            container.appendChild(messageElement);
            
            // Trigger animation
            setTimeout(() => {
                messageElement.style.transform = 'translateX(0)';
                messageElement.style.opacity = '1';
            }, 10);
            
            // Auto-remove
            if (duration > 0) {
                setTimeout(() => {
                    this.removeBackendMessage(messageElement);
                }, duration);
            }
            
            return messageElement.id;
        },
        
        // Remove a message
        removeBackendMessage(messageElement) {
            if (!messageElement) return;
            
            messageElement.classList.add('slide-out');
            
            setTimeout(() => {
                if (messageElement.parentElement) {
                    messageElement.parentElement.removeChild(messageElement);
                }
            }, 300);
        },
        
        // Handle AJAX responses from backend
        handleAjaxResponse(responseData) {
            if (!responseData) return;
            
            // Handle Django form errors
            if (responseData.errors) {
                for (const [field, errors] of Object.entries(responseData.errors)) {
                    errors.forEach(error => {
                        this.showBackendMessage('error', `Field Error: ${field}`, error, 6000);
                    });
                }
                return;
            }
            
            // Handle success/error messages
            if (responseData.success === true && responseData.message) {
                this.showBackendMessage('success', 'Success', responseData.message);
            } else if (responseData.success === false && responseData.error) {
                this.showBackendMessage('error', 'Error', responseData.error);
            } else if (responseData.message) {
                this.showBackendMessage('info', 'Notice', responseData.message);
            }
            
            // Handle specific cart/wishlist responses
            if (responseData.action === 'add_to_cart') {
                if (responseData.success) {
                    this.showBackendMessage('success', 'Added to Cart', 
                        `"${responseData.product_title}" has been added to your cart.`, 4000);
                } else {
                    this.showBackendMessage('error', 'Cart Error', 
                        responseData.error || 'Could not add item to cart.', 5000);
                }
            }
            
            if (responseData.action === 'add_to_wishlist') {
                if (responseData.success) {
                    this.showBackendMessage('success', 'Added to Wishlist', 
                        `"${responseData.product_title}" has been added to your wishlist.`, 4000);
                } else {
                    this.showBackendMessage('error', 'Wishlist Error', 
                        responseData.error || 'Could not add item to wishlist.', 5000);
                }
            }
            
            // Handle quantity validation
            if (responseData.max_quantity) {
                this.showBackendMessage('warning', 'Quantity Limit', 
                    `Maximum quantity is ${responseData.max_quantity}.`, 4000);
            }
            
            // Handle stock validation
            if (responseData.out_of_stock === true) {
                this.showBackendMessage('error', 'Out of Stock', 
                    'This item is currently out of stock.', 5000);
            }
            
            if (responseData.low_stock === true) {
                this.showBackendMessage('warning', 'Low Stock', 
                    'Only a few items left in stock!', 4000);
            }
        },
        
        // Intercept fetch requests to handle backend responses
        interceptFetch() {
            const originalFetch = window.fetch;
            
            window.fetch = async function(...args) {
                try {
                    const response = await originalFetch(...args);
                    
                    // Clone response to read it and still return it
                    const clonedResponse = response.clone();
                    
                    // Check if it's a JSON response
                    const contentType = clonedResponse.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) {
                        const data = await clonedResponse.json();
                        
                        // Show backend messages if present
                        if (data) {
                            setTimeout(() => {
                                BackendMessages.handleAjaxResponse(data);
                            }, 100);
                        }
                    }
                    
                    return response;
                } catch (error) {
                    // Show network errors
                    BackendMessages.showBackendMessage('error', 'Network Error', 
                        'Unable to connect to the server. Please check your connection.', 6000);
                    throw error;
                }
            };
        },
        
        // Initialize
        init() {
            // Auto-remove Django messages after 5 seconds
            setTimeout(() => {
                const djangoMessages = document.querySelectorAll('.django-message');
                djangoMessages.forEach(message => {
                    setTimeout(() => {
                        if (message.parentElement) {
                            message.remove();
                        }
                    }, 5000);
                });
            }, 1000);
            
            // Intercept fetch requests
            this.interceptFetch();
            
            // Make available globally
            window.BackendMessages = this;
            console.log('BackendMessages initialized');
        }
    };
    
    // Initialize when DOM is loaded
    document.addEventListener('DOMContentLoaded', function() {
        BackendMessages.init();
    });
</script>

<script>
    // Set branding configuration
    window.BYNUP_CONFIG = {
        showBranding: {{ show_bynup_branding|yesno:"true,false" }}
    };
</script>
<script src="{% static 'builder/js/bynup-branding.js' %}"></script>


      <script src="{% static 'builder/js/cart-manager.js' %}"></script>



