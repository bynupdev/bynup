 {% load style_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Elite Residences</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Contact Page Specific Styles */
        .contact-container#section-204 {
            max-width: 1400px;
            margin: 0 auto;
            padding: 4rem 5%;
            margin-top: 80px;
        }
        
        .contact-header#section-205 {
            margin-bottom: 3rem;
            text-align: center;
        }
        
        .contact-title {
            font-size: 2.5rem;
            color: var(--deep-elegance);
            margin-bottom: 1rem;
        }
        
        .contact-subtitle {
            color: var(--warm-neutral);
            font-size: 1.1rem;
            max-width: 700px;
            margin: 0 auto;
        }
        
        .contact-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-bottom: 5rem;
        }
        
        .contact-info#section-208 {
            padding: 2rem 0;
        }
        
        .contact-methods {
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
            margin-bottom: 3rem;
        }
        
        .contact-method {
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
        }
        
        .method-icon {
            width: 60px;
            height: 60px;
            background-color: rgba(169, 161, 188, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--luxury-accent);
            font-size: 1.5rem;
            flex-shrink: 0;
        }
        
        .method-details h3 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
            color: var(--deep-elegance);
        }
        
        .method-details p {
            color: var(--warm-neutral);
            margin-bottom: 0.5rem;
        }
        
        .method-link {
            color: var(--luxury-accent);
            text-decoration: none;
            transition: var(--transition);
        }
        
        .method-link:hover {
            color: var(--warm-neutral);
        }
        
        .business-hours#section-221 {
            background-color: rgba(214, 215, 210, 0.3);
            padding: 2rem;
            border-radius: 5px;
        }
        
        .hours-title {
            font-size: 1.3rem;
            margin-bottom: 1.5rem;
            color: var(--deep-elegance);
        }
        
        .hours-list {
            list-style: none;
        }
        
        .hours-list li {
            display: flex;
            justify-content: space-between;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(126, 112, 83, 0.1);
            color: var(--deep-elegance);
        }
        
        .hours-list li:last-child {
            border-bottom: none;
        }
        
        .contact-form#section-226 {
            background-color: var(--white);
            padding: 3rem;
            border: 1px solid rgba(126, 112, 83, 0.1);
            border-radius: 5px;
        }
        
        .form-title {
            font-size: 1.8rem;
            margin-bottom: 1.5rem;
            color: var(--deep-elegance);
        }
        
        .form-description {
            color: var(--warm-neutral);
            margin-bottom: 2rem;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }
        
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--deep-elegance);
            font-weight: 500;
        }
        
        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 0.8rem 1rem;
            border: 1px solid rgba(126, 112, 83, 0.3);
            background-color: var(--white);
            color: var(--deep-elegance);
            font-family: inherit;
            transition: var(--transition);
        }
        
        .form-input:focus,
        .form-select:focus,
        .form-textarea:focus {
            outline: none;
            border-color: var(--luxury-accent);
        }
        
        .form-textarea {
            min-height: 150px;
            resize: vertical;
        }
        
        .btn-submit {
            padding: 1rem 2.5rem;
            background-color: var(--warm-neutral);
            color: var(--white);
            border: none;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1rem;
            letter-spacing: 1.5px;
        }
        
        .btn-submit:hover {
            background-color: var(--deep-elegance);
            transform: translateY(-2px);
        }
        
        /* FAQ Section */
        .faq-section#section-248 {
            margin-top: 5rem;
            padding-top: 3rem;
            border-top: 1px solid rgba(126, 112, 83, 0.2);
        }
        
        .section-title {
            font-size: 1.8rem;
            margin-bottom: 2rem;
            color: var(--deep-elegance);
            text-align: center;
        }
        
        .faq-container {
            max-width: 900px;
            margin: 0 auto;
        }
        
        .faq-item {
            background-color: var(--white);
            border: 1px solid rgba(126, 112, 83, 0.1);
            margin-bottom: 1rem;
            border-radius: 5px;
            overflow: hidden;
        }
        
        .faq-question {
            padding: 1.5rem;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: var(--transition);
        }
        
        .faq-question:hover {
            background-color: rgba(214, 215, 210, 0.1);
        }
        
        .faq-question h3 {
            font-size: 1.1rem;
            color: var(--deep-elegance);
            margin: 0;
        }
        
        .faq-toggle {
            color: var(--luxury-accent);
            transition: var(--transition);
        }
        
        .faq-answer {
            padding: 0 1.5rem;
            max-height: 0;
            overflow: hidden;
            transition: var(--transition);
            color: var(--warm-neutral);
            line-height: 1.6;
        }
        
        .faq-item.active .faq-answer {
            padding: 0 1.5rem 1.5rem;
            max-height: 500px;
        }
        
        .faq-item.active .faq-toggle {
            transform: rotate(45deg);
        }
        
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 204 270 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 204 270 %}
        
        /* Responsive Design */
        @media (max-width: 1024px) {
            .contact-content {
                gap: 3rem;
            }
        }
        
        @media (max-width: 900px) {
            .contact-content {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
        }
        
        @media (max-width: 768px) {
            .contact-container#section-204 {
                padding: 3rem 5%;
                margin-top: 70px;
            }
            
            .contact-title {
                font-size: 2rem;
            }
            
            .contact-form#section-226 {
                padding: 2rem;
            }
            
            .contact-method {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }
            
            .section-title {
                font-size: 1.5rem;
            }
        }
        
        @media (max-width: 640px) {
            .contact-header#section-205 {
                margin-bottom: 2rem;
            }
            
            .contact-title {
                font-size: 1.7rem;
            }
            
            .form-title {
                font-size: 1.5rem;
            }
        }
        
        @media (max-width: 480px) {
            .business-hours#section-221 {
                padding: 1.5rem;
            }
            
            .faq-question {
                padding: 1rem;
            }
            
            .faq-question h3 {
                font-size: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- Contact Content -->
    <div class="contact-container" id="section-204">
        <div class="contact-header" id="section-205">
            <h1 class="contact-title" id="section-206">{{ text_contents.160|default:"Connect With Our Luxury Specialists" }}</h1>
            <p class="contact-subtitle" id="section-207">{{ text_contents.161|default:"Our dedicated team of luxury property experts is ready to provide personalized assistance with your exclusive real estate needs." }}</p>
        </div>
        
        {% for component in components %}
        {% if component.drop_zone == '204' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
        {% endif %}
        {% endfor %}
        
        <div class="contact-content">
            <!-- Contact Information -->
            <div class="contact-info" id="section-208">
                <div class="contact-methods">
                    <!-- Phone -->
                    <div class="contact-method" id="section-209">
                        <div class="method-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="method-details">
                            <h3 id="section-210">{{ text_contents.162|default:"Phone" }}</h3>
                            <p id="section-211">{{ text_contents.163|default:"Speak directly with a luxury property specialist" }}</p>
                            <a href="tel:+15551234567" class="method-link" id="section-212">{{ text_contents.164|default:"+1 (555) 123-4567" }}</a>
                        </div>
                    </div>
                    
                    <!-- Email -->
                    <div class="contact-method" id="section-213">
                        <div class="method-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="method-details">
                            <h3 id="section-214">{{ text_contents.165|default:"Email" }}</h3>
                            <p id="section-215">{{ text_contents.166|default:"Send detailed inquiries to our dedicated team" }}</p>
                            <a href="mailto:info@eliteresidences.com" class="method-link" id="section-216">{{ text_contents.167|default:"info@eliteresidences.com" }}</a>
                        </div>
                    </div>
                    
                    <!-- Office -->
                    <div class="contact-method" id="section-217">
                        <div class="method-icon">
                            <i class="fas fa-building"></i>
                        </div>
                        <div class="method-details">
                            <h3 id="section-218">{{ text_contents.168|default:"Corporate Office" }}</h3>
                            <p id="section-219">{{ text_contents.169|default:"Visit our flagship location by appointment" }}</p>
                            <p id="section-220">{{ text_contents.170|default:"123 Luxury Avenue, Beverly Hills, CA 90210" }}</p>
                        </div>
                    </div>
                </div>
                
                <!-- Business Hours -->
                <div class="business-hours" id="section-221">
                    <h3 class="hours-title" id="section-222">{{ text_contents.171|default:"Business Hours" }}</h3>
                    <ul class="hours-list">
                        <li id="section-223">
                            <span>{{ text_contents.172|default:"Monday - Friday" }}</span>
                            <span>{{ text_contents.173|default:"9:00 AM - 7:00 PM" }}</span>
                        </li>
                        <li id="section-224">
                            <span>{{ text_contents.174|default:"Saturday" }}</span>
                            <span>{{ text_contents.175|default:"10:00 AM - 5:00 PM" }}</span>
                        </li>
                        <li id="section-225">
                            <span>{{ text_contents.176|default:"Sunday" }}</span>
                            <span>{{ text_contents.177|default:"By Appointment Only" }}</span>
                        </li>
                    </ul>
                </div>
            </div>
            
            {% for component in components %}
            {% if component.drop_zone == '208' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
            {% endif %}
            {% endfor %}
            
            <!-- Contact Form -->
            <div class="contact-form" id="section-226">
                <h2 class="form-title" id="section-227">{{ text_contents.178|default:"Schedule a Consultation" }}</h2>
                <p class="form-description" id="section-228">{{ text_contents.179|default:"Complete the form below and our luxury property specialist will contact you within 24 hours to schedule a private consultation." }}</p>
                
                <form id="contact-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" id="section-229">{{ text_contents.180|default:"First Name" }}</label>
                            <input type="text" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label" id="section-230">{{ text_contents.181|default:"Last Name" }}</label>
                            <input type="text" class="form-input" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" id="section-231">{{ text_contents.182|default:"Email Address" }}</label>
                            <input type="email" class="form-input" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label" id="section-232">{{ text_contents.183|default:"Phone Number" }}</label>
                            <input type="tel" class="form-input" required>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" id="section-233">{{ text_contents.184|default:"Inquiry Type" }}</label>
                        <select class="form-select">
                            <option value="" selected disabled>{{ text_contents.185|default:"Select an option" }}</option>
                            <option value="property-viewing" id="section-235">{{ text_contents.186|default:"Property Viewing" }}</option>
                            <option value="investment-consultation" id="section-236">{{ text_contents.187|default:"Investment Consultation" }}</option>
                            <option value="property-valuation" id="section-237">{{ text_contents.188|default:"Property Valuation" }}</option>
                            <option value="general-inquiry" id="section-238">{{ text_contents.189|default:"General Inquiry" }}</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" id="section-239">{{ text_contents.190|default:"Property Budget Range" }}</label>
                        <select class="form-select">
                            <option value="" selected disabled>{{ text_contents.191|default:"Select budget range" }}</option>
                            <option value="5-10m" id="section-241">{{ text_contents.192|default:"$5M - $10M" }}</option>
                            <option value="10-25m" id="section-242">{{ text_contents.193|default:"$10M - $25M" }}</option>
                            <option value="25-50m" id="section-243">{{ text_contents.194|default:"$25M - $50M" }}</option>
                            <option value="50m-plus" id="section-244">{{ text_contents.195|default:"$50M+" }}</option>
                        </select>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label" id="section-245">{{ text_contents.196|default:"Message" }}</label>
                        <textarea class="form-textarea" id="section-246" placeholder="{{ text_contents.197|default:'Please provide details about your luxury property requirements, preferred locations, timeline, and any specific amenities or features you\\'re seeking...' }}"></textarea>
                    </div>
                    
                    <button type="submit" class="btn-submit" id="section-247">{{ text_contents.198|default:"Submit Inquiry" }}</button>
                </form>
            </div>
        </div>
        
        {% for component in components %}
        {% if component.drop_zone == '248' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
        {% endif %}
        {% endfor %}
        
        <!-- FAQ Section -->
        <div class="faq-section" id="section-248">
            <h2 class="section-title" id="section-249">{{ text_contents.199|default:"Frequently Asked Questions" }}</h2>
            
            <div class="faq-container">
                <!-- FAQ 1 -->
                <div class="faq-item" id="section-250">
                    <div class="faq-question" onclick="toggleFAQ(1)">
                        <h3 id="section-251">{{ text_contents.200|default:"What is the typical timeline for purchasing a luxury property through Elite Residences?" }}</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer" id="section-252">
                        {{ text_contents.201|default:"The timeline for acquiring a luxury property typically ranges from 30 to 90 days, depending on factors such as property availability, due diligence requirements, and financing arrangements. Our concierge team streamlines the entire process, from initial consultation to closing, ensuring a seamless experience. For international clients or complex transactions involving multiple jurisdictions, additional time may be required for legal and regulatory compliance." }}
                    </div>
                </div>
                
                <!-- FAQ 2 -->
                <div class="faq-item" id="section-253">
                    <div class="faq-question" onclick="toggleFAQ(2)">
                        <h3 id="section-254">{{ text_contents.202|default:"Do you offer property viewing services for international clients?" }}</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer" id="section-255">
                        {{ text_contents.203|default:"Yes, we specialize in serving international clients and offer comprehensive property viewing services including virtual tours, video consultations, and in-person viewings coordinated with your travel schedule. Our multilingual team can arrange private viewings, provide local market insights, and assist with travel logistics. For clients unable to travel, we offer detailed digital presentations and live virtual tours conducted by our property specialists." }}
                    </div>
                </div>
                
                <!-- FAQ 3 -->
                <div class="faq-item" id="section-256">
                    <div class="faq-question" onclick="toggleFAQ(3)">
                        <h3 id="section-257">{{ text_contents.204|default:"What due diligence services do you provide during the property acquisition process?" }}</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer" id="section-258">
                        {{ text_contents.205|default:"Our comprehensive due diligence services include property inspection by certified engineers, title verification, zoning compliance checks, environmental assessments, and historical preservation reviews. We also provide investment analysis, market valuation, and comparative market analysis. For international properties, we coordinate with local legal experts to ensure compliance with all regulatory requirements and provide detailed reports on tax implications and ownership structures." }}
                    </div>
                </div>
                
                <!-- FAQ 4 -->
                <div class="faq-item" id="section-259">
                    <div class="faq-question" onclick="toggleFAQ(4)">
                        <h3 id="section-260">{{ text_contents.206|default:"Can you assist with property management after purchase?" }}</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer" id="section-261">
                        {{ text_contents.207|default:"Absolutely. We offer premium property management services including maintenance coordination, staff hiring and management (housekeepers, gardeners, security), utility management, and seasonal preparation. Our concierge services also include rental management for investment properties, with comprehensive tenant screening, lease administration, and regular property inspections. We provide detailed monthly reports and 24/7 emergency support for all managed properties." }}
                    </div>
                </div>
                
                <!-- FAQ 5 -->
                <div class="faq-item" id="section-262">
                    <div class="faq-question" onclick="toggleFAQ(5)">
                        <h3 id="section-263">{{ text_contents.208|default:"What makes Elite Residences different from other luxury real estate agencies?" }}</h3>
                        <div class="faq-toggle">
                            <i class="fas fa-plus"></i>
                        </div>
                    </div>
                    <div class="faq-answer" id="section-264">
                        {{ text_contents.209|default:"Elite Residences distinguishes itself through our exclusive focus on ultra-premium properties, personalized concierge service, and global network of luxury specialists. We maintain strict confidentiality, offer access to off-market listings, and provide comprehensive investment analysis. Our team includes former architects, interior designers, and financial analysts who offer holistic advisory services. We also provide post-purchase integration services, helping clients with interior design, art acquisition, and lifestyle curation for their new property." }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <script>
        // FAQ Toggle Functionality
        function toggleFAQ(faqNumber) {
            const faqItem = document.querySelector(`.faq-item:nth-child(${faqNumber})`);
            faqItem.classList.toggle('active');
        }
        
        // Form Submission
        document.getElementById('contact-form').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you for your inquiry! Our luxury property specialist will contact you within 24 hours.');
            this.reset();
        });
        
        // Initialize first FAQ as open
        document.querySelector('.faq-item').classList.add('active');
    </script>
</body>
</html>