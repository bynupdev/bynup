{% load style_filters %}
{% load color_filters %}



<!DOCTYPE html>
<html lang="en">
<head>      
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elite Residences | Luxury Real Estate</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Base Styles & Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        
        
        :root {
            --luxury-accent: #A9A1BC;
            --warm-neutral: #7E7053;
            --deep-elegance: #4D3E27;
            --light-bg: #D6D7D2;
            --white: #FFFFFF;
            --transition: all 0.3s ease;
        }
       
        {% generate_color_variables %}
        
        html {
            scroll-behavior: smooth;
        }
        
        body {
            background-color: var(--light-bg);
            color: var(--deep-elegance);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        /* Typography */
        h1, h2, h3, h4 {
            font-weight: 300;
            letter-spacing: 1px;
            line-height: 1.2;
        }
        
        h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
        }
        
        h2 {
            font-size: 2.5rem;
            margin-bottom: 2rem;
            text-align: center;
            position: relative;
        }
        
        h2:after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 1px;
            background-color: var(--warm-neutral);
        }
        
        h3 {
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }
        
        p {
            font-size: 1.1rem;
            margin-bottom: 1.5rem;
            font-weight: 300;
        }
        
        /* Header & Navigation */
        header#section-1 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 1.2rem 5%;
            background-color: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(126, 112, 83, 0.1);
            transition: var(--transition);
        }
        
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .logo {
            font-size: 1.8rem;
            font-weight: 300;
            letter-spacing: 3px;
            color: var(--deep-elegance);
            text-decoration: none;
        }
        
        .logo span {
            font-weight: 600;
            color: var(--warm-neutral);
        }
        
        nav ul {
            display: flex;
            list-style: none;
            gap: 2.5rem;
        }
        
        nav a {
            text-decoration: none;
            color: var(--deep-elegance);
            font-weight: 300;
            letter-spacing: 1px;
            font-size: 1rem;
            transition: var(--transition);
            position: relative;
        }
        
        nav a:after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background-color: var(--warm-neutral);
            transition: var(--transition);
        }
        
        nav a:hover:after {
            width: 100%;
        }
        
        .header-icons {
            display: flex;
            gap: 1.5rem;
        }
        
        .header-icons i {
            font-size: 1.2rem;
            color: var(--deep-elegance);
            cursor: pointer;
            transition: var(--transition);
        }
        
        .header-icons i:hover {
            color: var(--warm-neutral);
        }
        
        .account-dropdown {
            position: relative;
        }
        
        .dropdown-content {
            position: absolute;
            top: 100%;
            right: 0;
            background-color: var(--white);
            min-width: 200px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(126, 112, 83, 0.1);
            opacity: 0;
            visibility: hidden;
            transform: translateY(10px);
            transition: var(--transition);
            z-index: 100;
        }
        
        .dropdown-content a {
            display: block;
            padding: 1rem 1.5rem;
            color: var(--deep-elegance);
            text-decoration: none;
            font-weight: 300;
            border-bottom: 1px solid rgba(126, 112, 83, 0.05);
            transition: var(--transition);
        }
        
        .dropdown-content a:last-child {
            border-bottom: none;
        }
        
        .dropdown-content a:hover {
            background-color: rgba(169, 161, 188, 0.05);
            padding-left: 2rem;
        }
        
        .account-dropdown:hover .dropdown-content {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }
        
        .hamburger-menu {
            display: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--deep-elegance);
        }
        
        .mobile-back-btn {
            display: none;
            font-size: 1.2rem;
            margin-right: 1rem;
            cursor: pointer;
        }
        
        /* Hero Section */
        .hero#section-12 {
            height: 100vh;
            position: relative;
            background: linear-gradient(rgba(77, 62, 39, 0.1), rgba(77, 62, 39, 0.1)), 
                        url('https://images.unsplash.com/photo-1613490493576-7fde63acd811?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2071&q=80');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--white);
            padding: 0 5%;
        }
        
        .hero-content {
            max-width: 900px;
            z-index: 2;
        }
        
        .hero h1 {
            font-size: 4rem;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
            margin-bottom: 1.5rem;
        }
        
        .hero p {
            font-size: 1.3rem;
            margin-bottom: 2.5rem;
            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
            font-weight: 300;
        }
        
        .btn {
            display: inline-block;
            padding: 1.2rem 2.8rem;
            background-color: transparent;
            color: var(--white);
            border: 1px solid var(--white);
            text-decoration: none;
            font-size: 1rem;
            letter-spacing: 2px;
            transition: var(--transition);
            cursor: pointer;
        }
        
        .btn:hover {
            background-color: rgba(255, 255, 255, 0.1);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
        }
        
        /* New Arrivals Section */
        .new-arrivals#section-16 {
            padding: 6rem 5%;
            max-width: 1400px;
            margin: 0 auto;
        }
        
        .properties-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2.5rem;
            margin-top: 3rem;
        }
        
        .property-card {
            background-color: var(--white);
            overflow: hidden;
            transition: var(--transition);
            border: 1px solid rgba(126, 112, 83, 0.1);
            position: relative;
        }
        
        .property-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }
        
        .property-image {
            height: 250px;
            overflow: hidden;
        }
        
        .property-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }
        
        .property-card:hover .property-image img {
            transform: scale(1.05);
        }
        
        .property-info {
            padding: 1.8rem;
        }
        
        .property-info h3 {
            margin-bottom: 0.5rem;
        }
        
        .property-location {
            color: var(--warm-neutral);
            font-size: 1rem;
            margin-bottom: 1rem;
            font-weight: 300;
        }
        
        .property-price {
            color: var(--deep-elegance);
            font-size: 1.5rem;
            font-weight: 400;
        }
        
        .see-more-container {
            text-align: center;
            margin-top: 4rem;
        }
        
        .btn-secondary {
            background-color: var(--warm-neutral);
            color: var(--white);
            border: none;
            padding: 1.2rem 3rem;
        }
        
        .btn-secondary:hover {
            background-color: var(--deep-elegance);
        }
        
        /* Footer */
        footer#section-24 {
            background-color: var(--deep-elegance);
            color: var(--light-bg);
            padding: 4rem 5% 2rem;
            text-align: center;
        }
        
        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 3rem;
        }
        
        .footer-logo {
            font-size: 2rem;
            margin-bottom: 1.5rem;
            letter-spacing: 3px;
        }
        
        .footer-logo span {
            color: var(--luxury-accent);
        }
        
        .footer-tagline {
            font-size: 1.1rem;
            margin-bottom: 2rem;
            font-weight: 300;
            color: rgba(214, 215, 210, 0.8);
        }
        
        .copyright {
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(169, 161, 188, 0.2);
            font-size: 0.9rem;
            color: rgba(214, 215, 210, 0.6);
        }
        
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}
        
        /* Responsive Design */
        @media (max-width: 1024px) {
            h1 {
                font-size: 3rem;
            }
            
            .hero h1 {
                font-size: 3.2rem;
            }
            
            h2 {
                font-size: 2.2rem;
            }
        }
        
        @media (max-width: 768px) {
            header#section-1 {
                padding: 1rem 5%;
            }
            
            nav ul {
                gap: 1.5rem;
            }
            
            .hero h1 {
                font-size: 2.8rem;
            }
            
            .hero p {
                font-size: 1.1rem;
            }
            
            .properties-grid {
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 2rem;
            }
        }
        
        @media (max-width: 640px) {
            .hamburger-menu {
                display: block;
            }
            
            nav {
                position: fixed;
                top: 0;
                right: -100%;
                width: 80%;
                max-width: 350px;
                height: 100vh;
                background-color: var(--white);
                padding: 2rem;
                transition: var(--transition);
                z-index: 1001;
                box-shadow: -10px 0 30px rgba(0, 0, 0, 0.1);
            }
            
            nav.active {
                right: 0;
            }
            
            nav ul {
                flex-direction: column;
                margin-top: 3rem;
                gap: 1.5rem;
            }
            
            .mobile-back-btn {
                display: block;
            }
            
            .header-icons {
                display: none;
            }
            
            .hero {
                height: 80vh;
            }
            
            .hero h1 {
                font-size: 2.2rem;
            }
            
            .hero p {
                font-size: 1rem;
            }
            
            h1 {
                font-size: 2.5rem;
            }
            
            h2 {
                font-size: 2rem;
            }
            
            .new-arrivals {
                padding: 4rem 5%;
            }
        }
        
        @media (max-width: 480px) {
            .hero h1 {
                font-size: 1.8rem;
            }
            
            .btn {
                padding: 1rem 2rem;
                font-size: 0.9rem;
            }
            
            .property-card {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header id="section-1">
        <div class="header-container">
            <div class="logo">
                <a href="?page=home">
                    <i class="fas fa-building"></i>
                    <span id="section-2">{{ text_contents.1|default:"ELITE<span style='color: var(--warm-neutral);'>RESIDENCES</span>"|safe }}</span>
                </a>
            </div>
            
            <button class="hamburger-menu" id="mobile-menu-toggle">
                <i class="fas fa-bars"></i>
            </button>
            
            <nav>
                <ul id="main-nav">
                    <li id="section-3"><a href="?page=home" class="active">{{ text_contents.2|default:"HOME" }}</a></li>
                    <li id="section-4"><a href="?page=products">{{ text_contents.3|default:"SHOP" }}</a></li>
                    <li id="section-5"><a href="?page=about">{{ text_contents.4|default:"ABOUT US" }}</a></li>
                    <li id="section-6"><a href="?page=contact">{{ text_contents.5|default:"CONTACT" }}</a></li>
                </ul>
            </nav>
            
            <div class="header-icons">
                <a href="?page=cart" class="icon-btn">
                    <i class="fas fa-shopping-cart"></i>
                    <span class="badge">0</span>
                </a>
                <a href="?page=wishlist" class="icon-btn">
                    <i class="fas fa-heart"></i>
                    <span class="badge">0</span>
                </a>
                <div class="account-dropdown">
                    <i class="fas fa-user"></i>
                    <div class="dropdown-content">
                        <a href="?page=signin" id="section-7">{{ text_contents.6|default:"SIGN IN" }}</a>
                        <a href="?page=signup" id="section-8">{{ text_contents.7|default:"SIGN UP" }}</a>
                        <a href="?page=orders" id="section-9">{{ text_contents.8|default:"ORDERS" }}</a>
                        <a href="?page=saved" id="section-10">{{ text_contents.9|default:"SAVED PROPERTIES" }}</a>
                        <a href="?page=settings" id="section-11">{{ text_contents.10|default:"ACCOUNT SETTINGS" }}</a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    {% for component in components %}
    {% if component.drop_zone == '1' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Hero Section -->
    <section class="hero" id="section-12">
        <div class="hero-content">
            <h1 id="section-13">{{ text_contents.11|default:"Redefining Luxury Living" }}</h1>
            <p id="section-14">{{ text_contents.12|default:"Discover exclusive properties crafted for comfort, elegance, and long-term value." }}</p>
            <a href="#new-arrivals" class="btn" id="section-15">{{ text_contents.13|default:"Explore Properties" }}</a>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '12' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- New Arrivals Section -->
    <section class="new-arrivals" id="section-16" id="new-arrivals">
        <h2 id="section-17">{{ text_contents.14|default:"Latest Properties" }}</h2>
        <p id="section-18" style="text-align: center; max-width: 700px; margin: 0 auto 1rem;">{{ text_contents.15|default:"Explore our newest collection of premium residences, each offering unparalleled luxury, privacy, and architectural excellence." }}</p>
        
        <div class="properties-grid">
            <!-- First property is editable and will be used as template for others -->
            <!-- <div class="property-card" id="section-19">
                <div class="property-image">
                    <img src="https://images.unsplash.com/photo-1613977257363-707ba9348227?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" alt="Modern Cliffside Villa">
                </div>
                <div class="property-info">
                    <h3 id="section-20">{{ text_contents.16|default:"Modern Cliffside Villa" }}</h3>
                    <div class="property-location" id="section-21">{{ text_contents.17|default:"Malibu, California" }}</div>
                    <div class="property-price" id="section-22">{{ text_contents.18|default:"Starting from $12,500,000" }}</div>
                </div>
            </div> -->
            
            <!-- Other properties will be generated from backend loop -->
            {% for product in products%}
            <div class="property-card">
                <div class="property-image">
                    <img src="{{ product.main_image.url }}" alt="{{ property.title }}">
                </div>
                <div class="property-info">
                    <h3>{{ product.title }}</h3>
                    <div class="property-location">{{ product.category }}</div>
                    <div class="property-price">{{ product.price }}</div>
                </div>
            </div>
            {% endfor %}
        </div>
        
        <div class="see-more-container">
            <a href="?page=products" class="btn btn-secondary" id="section-23">{{ text_contents.19|default:"View All Listings" }}</a>
        </div>
    </section>

    {% for component in components %}
    {% if component.drop_zone == '16' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <!-- Footer -->
    <footer id="section-24">
        <div class="footer-content">
            <div class="footer-section" id="section-25">
                <div class="footer-logo" id="section-26">{{ text_contents.20|default:"ELITE<span>RESIDENCES</span>"|safe }}</div>
                <p class="footer-tagline" id="section-27">{{ text_contents.21|default:"For over two decades, we've been connecting discerning clients with exceptional properties worldwide." }}</p>
            </div>
            
            <div class="footer-section" id="section-28">
                <h3 id="section-29">{{ text_contents.22|default:"Contact" }}</h3>
                <ul>
                    <li id="section-30"><a href="?page=contact">{{ text_contents.23|default:"Schedule Consultation" }}</a></li>
                    <li id="section-31"><a href="tel:+15551234567">{{ text_contents.24|default:"+1 (555) 123-4567" }}</a></li>
                    <li id="section-32"><a href="mailto:info@eliteresidences.com">{{ text_contents.25|default:"info@eliteresidences.com" }}</a></li>
                </ul>
            </div>
        </div>
        
        <div class="copyright" id="section-33">
            <p id="section-34">{{ text_contents.26|default:"&copy; 2023 Elite Residences. All rights reserved. | Luxury Real Estate E-Commerce"|safe }}</p>
        </div>
    </footer>

    {% for component in components %}
    {% if component.drop_zone == '24' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <script>
        // Mobile Navigation Toggle
        const hamburger = document.getElementById('mobile-menu-toggle');
        const mainNav = document.querySelector('nav');
        const backBtn = document.querySelector('.mobile-back-btn');
        
        if (hamburger) {
            hamburger.addEventListener('click', () => {
                mainNav.classList.add('active');
            });
        }
        
        if (backBtn) {
            backBtn.addEventListener('click', () => {
                mainNav.classList.remove('active');
            });
        }
        
        // Close mobile menu when clicking on a link
        const navLinks = document.querySelectorAll('nav a');
        navLinks.forEach(link => {
            link.addEventListener('click', () => {
                mainNav.classList.remove('active');
            });
        });
        
        // Header scroll effect
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (window.scrollY > 50) {
                header.style.padding = '0.8rem 5%';
                header.style.boxShadow = '0 5px 20px rgba(0, 0, 0, 0.05)';
            } else {
                header.style.padding = '1.2rem 5%';
                header.style.boxShadow = 'none';
            }
        });
        
        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                if(this.getAttribute('href') === '#') return;
                
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                
                if(targetElement) {
                    window.scrollTo({
                        top: targetElement.offsetTop - 80,
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>
</body>
</html>