{% load style_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us | Elite Residences</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* About Page Specific Styles */
        .about-container#section-265 {
            max-width: 1400px;
            margin: 0 auto;
            padding: 4rem 5%;
            margin-top: 80px;
        }
        
        .about-hero#section-266 {
            text-align: center;
            margin-bottom: 5rem;
        }
        
        .about-title {
            font-size: 3rem;
            color: var(--deep-elegance);
            margin-bottom: 1.5rem;
        }
        
        .about-subtitle {
            color: var(--warm-neutral);
            font-size: 1.2rem;
            max-width: 800px;
            margin: 0 auto 2rem;
            line-height: 1.6;
        }
        
        .hero-image#section-269 {
            height: 400px;
            width: 100%;
            overflow: hidden;
            border-radius: 10px;
            margin-top: 2rem;
        }
        
        .hero-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .mission-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-bottom: 5rem;
            align-items: center;
        }
        
        .mission-content#section-270 {
            padding-right: 2rem;
        }
        
        .section-title {
            font-size: 2rem;
            color: var(--deep-elegance);
            margin-bottom: 1.5rem;
            position: relative;
            padding-bottom: 0.8rem;
        }
        
        .section-title:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 60px;
            height: 2px;
            background-color: var(--warm-neutral);
        }
        
        .mission-text {
            color: var(--deep-elegance);
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }
        
        .mission-image#section-274 {
            height: 400px;
            overflow: hidden;
            border-radius: 10px;
        }
        
        .mission-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .values-section#section-275 {
            margin-bottom: 5rem;
            text-align: center;
        }
        
        .values-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2.5rem;
            margin-top: 3rem;
        }
        
        .value-card {
            background-color: var(--white);
            padding: 2.5rem;
            border: 1px solid rgba(126, 112, 83, 0.1);
            border-radius: 10px;
            transition: var(--transition);
        }
        
        .value-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }
        
        .value-icon {
            width: 80px;
            height: 80px;
            background-color: rgba(169, 161, 188, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
            color: var(--luxury-accent);
            font-size: 2rem;
        }
        
        .value-title {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--deep-elegance);
        }
        
        .value-description {
            color: var(--warm-neutral);
            line-height: 1.6;
        }
        
        .team-section#section-290 {
            margin-bottom: 5rem;
        }
        
        .team-header#section-291 {
            text-align: center;
            margin-bottom: 3rem;
        }
        
        .team-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 3rem;
        }
        
        .team-member {
            text-align: center;
        }
        
        .member-image {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            overflow: hidden;
            margin: 0 auto 1.5rem;
            border: 5px solid var(--white);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }
        
        .member-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .member-name {
            font-size: 1.4rem;
            margin-bottom: 0.5rem;
            color: var(--deep-elegance);
        }
        
        .member-role {
            color: var(--luxury-accent);
            margin-bottom: 1rem;
            font-weight: 500;
        }
        
        .member-bio {
            color: var(--warm-neutral);
            line-height: 1.6;
            max-width: 300px;
            margin: 0 auto;
        }
        
        .achievements-section#section-306 {
            background-color: rgba(214, 215, 210, 0.3);
            padding: 4rem;
            border-radius: 10px;
            margin-bottom: 5rem;
        }
        
        .achievements-header#section-307 {
            text-align: center;
            margin-bottom: 3rem;
        }
        
        .achievements-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 3rem;
            text-align: center;
        }
        
        .achievement-item {
            padding: 1.5rem;
        }
        
        .achievement-number {
            font-size: 2.5rem;
            color: var(--deep-elegance);
            margin-bottom: 0.5rem;
            font-weight: 300;
        }
        
        .achievement-label {
            color: var(--warm-neutral);
            font-size: 1rem;
        }
        
        .cta-section#section-322 {
            text-align: center;
            padding: 4rem;
            background-color: var(--white);
            border: 1px solid rgba(126, 112, 83, 0.1);
            border-radius: 10px;
        }
        
        .cta-title {
            font-size: 2rem;
            margin-bottom: 1.5rem;
            color: var(--deep-elegance);
        }
        
        .cta-text {
            color: var(--warm-neutral);
            margin-bottom: 2rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.6;
        }
        
        .btn-cta {
            display: inline-block;
            padding: 1rem 2.5rem;
            background-color: var(--warm-neutral);
            color: var(--white);
            border: none;
            text-decoration: none;
            font-size: 1rem;
            letter-spacing: 1.5px;
            transition: var(--transition);
            cursor: pointer;
        }
        
        .btn-cta:hover {
            background-color: var(--deep-elegance);
            transform: translateY(-3px);
        }
        
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 265 330 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 265 330 %}
        
        /* Responsive Design */
        @media (max-width: 1024px) {
            .mission-section {
                gap: 3rem;
            }
            
            .team-grid {
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 2.5rem;
            }
        }
        
        @media (max-width: 900px) {
            .mission-section {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
            
            .mission-content#section-270 {
                padding-right: 0;
            }
            
            .mission-image#section-274 {
                height: 350px;
            }
            
            .achievements-section#section-306 {
                padding: 3rem 2rem;
            }
        }
        
        @media (max-width: 768px) {
            .about-container#section-265 {
                padding: 3rem 5%;
                margin-top: 70px;
            }
            
            .about-title {
                font-size: 2.5rem;
            }
            
            .about-subtitle {
                font-size: 1.1rem;
            }
            
            .hero-image#section-269 {
                height: 300px;
            }
            
            .section-title {
                font-size: 1.7rem;
            }
            
            .values-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            
            .cta-section#section-322 {
                padding: 3rem 2rem;
            }
        }
        
        @media (max-width: 640px) {
            .about-hero#section-266 {
                margin-bottom: 3rem;
            }
            
            .about-title {
                font-size: 2rem;
            }
            
            .team-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            
            .achievements-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 2rem;
            }
            
            .achievement-number {
                font-size: 2rem;
            }
        }
        
        @media (max-width: 480px) {
            .about-title {
                font-size: 1.8rem;
            }
            
            .achievements-grid {
                grid-template-columns: 1fr;
            }
            
            .cta-title {
                font-size: 1.7rem;
            }
        }
    </style>
</head>
<body>
    <!-- About Content -->
    <div class="about-container" id="section-265">
        {% for component in components %}
        {% if component.drop_zone == '265' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
        {% endif %}
        {% endfor %}
        
        <!-- Hero Section -->
        <div class="about-hero" id="section-266">
            <h1 class="about-title" id="section-267">{{ text_contents.210|default:"Redefining Luxury Real Estate Since 1998" }}</h1>
            <p class="about-subtitle" id="section-268">{{ text_contents.211|default:"For over two decades, Elite Residences has been the trusted partner for discerning clients seeking exceptional properties that transcend ordinary luxury living." }}</p>
            <div class="hero-image" id="section-269">
                <img src="{{ about_hero_image|default:'https://images.unsplash.com/photo-1568605114967-8130f3a36994?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80' }}" alt="Elite Residences Headquarters">
            </div>
        </div>
        
        <!-- Mission & Vision -->
        <div class="mission-section">
            <div class="mission-content" id="section-270">
                <h2 class="section-title" id="section-271">{{ text_contents.212|default:"Our Mission" }}</h2>
                <p class="mission-text" id="section-272">{{ text_contents.213|default:"To connect visionary clients with exceptional properties that represent not just homes, but legacies. We believe luxury real estate should offer more than prestige—it should provide sanctuary, inspire creativity, and build generational wealth through strategic investment in extraordinary assets." }}</p>
                <p class="mission-text" id="section-273">{{ text_contents.214|default:"Our approach combines architectural appreciation with financial acumen, ensuring every property we represent offers both aesthetic excellence and sound investment potential. We maintain relationships with the world's most respected architects, designers, and developers to provide access to truly exclusive opportunities." }}</p>
            </div>
            <div class="mission-image" id="section-274">
                <img src="{{ mission_image|default:'https://images.unsplash.com/photo-1613490493576-7fde63acd811?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80' }}" alt="Mission & Vision">
            </div>
        </div>
        
        {% for component in components %}
        {% if component.drop_zone == '275' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
        {% endif %}
        {% endfor %}
        
        <!-- Core Values -->
        <div class="values-section" id="section-275">
            <h2 class="section-title" id="section-276">{{ text_contents.215|default:"Our Core Values" }}</h2>
            <p class="about-subtitle" id="section-277" style="max-width: 700px;">{{ text_contents.216|default:"The principles that guide every interaction and transaction at Elite Residences." }}</p>
            
            <div class="values-grid">
                <!-- Value 1 -->
                <div class="value-card" id="section-278">
                    <div class="value-icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h3 class="value-title" id="section-279">{{ text_contents.217|default:"Discretion" }}</h3>
                    <p class="value-description" id="section-280">{{ text_contents.218|default:"We maintain absolute confidentiality in all client interactions, ensuring privacy and security throughout the property acquisition process." }}</p>
                </div>
                
                <!-- Value 2 -->
                <div class="value-card" id="section-281">
                    <div class="value-icon">
                        <i class="fas fa-award"></i>
                    </div>
                    <h3 class="value-title" id="section-282">{{ text_contents.219|default:"Excellence" }}</h3>
                    <p class="value-description" id="section-283">{{ text_contents.220|default:"Every property in our portfolio meets rigorous standards of architectural quality, location desirability, and investment potential." }}</p>
                </div>
                
                <!-- Value 3 -->
                <div class="value-card" id="section-284">
                    <div class="value-icon">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <h3 class="value-title" id="section-285">{{ text_contents.221|default:"Integrity" }}</h3>
                    <p class="value-description" id="section-286">{{ text_contents.222|default:"We provide transparent advice, honest valuations, and ethical representation, building trust through every transaction." }}</p>
                </div>
                
                <!-- Value 4 -->
                <div class="value-card" id="section-287">
                    <div class="value-icon">
                        <i class="fas fa-globe-americas"></i>
                    </div>
                    <h3 class="value-title" id="section-288">{{ text_contents.223|default:"Global Perspective" }}</h3>
                    <p class="value-description" id="section-289">{{ text_contents.224|default:"With specialists in major luxury markets worldwide, we provide insights into local nuances while maintaining global standards." }}</p>
                </div>
            </div>
        </div>
        
        <!-- Leadership Team -->
        <div class="team-section" id="section-290">
            <div class="team-header" id="section-291">
                <h2 class="section-title" id="section-292">{{ text_contents.225|default:"Leadership Team" }}</h2>
                <p class="about-subtitle" id="section-293" style="max-width: 700px;">{{ text_contents.226|default:"Our team of luxury property specialists combines decades of experience with passion for exceptional real estate." }}</p>
            </div>
            
            <div class="team-grid">
                <!-- Team Member 1 -->
                <div class="team-member" id="section-294">
                    <div class="member-image">
                        <img src="{{ team_member1_image|default:'https://images.unsplash.com/photo-1560250097-0b93528c311a?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80' }}" alt="James Wellington">
                    </div>
                    <h3 class="member-name" id="section-295">{{ text_contents.227|default:"James Wellington" }}</h3>
                    <div class="member-role" id="section-296">{{ text_contents.228|default:"Founder & CEO" }}</div>
                    <p class="member-bio" id="section-297">{{ text_contents.229|default:"With 25+ years in luxury real estate, James founded Elite Residences to create a boutique firm focused exclusively on ultra-premium properties." }}</p>
                </div>
                
                <!-- Team Member 2 -->
                <div class="team-member" id="section-298">
                    <div class="member-image">
                        <img src="{{ team_member2_image|default:'https://images.unsplash.com/photo-1580489944761-15a19d654956?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80' }}" alt="Victoria Sterling">
                    </div>
                    <h3 class="member-name" id="section-299">{{ text_contents.230|default:"Victoria Sterling" }}</h3>
                    <div class="member-role" id="section-300">{{ text_contents.231|default:"Managing Director" }}</div>
                    <p class="member-bio" id="section-301">{{ text_contents.232|default:"Former architect turned luxury property specialist, Victoria brings unique insight into architectural quality and design potential." }}</p>
                </div>
                
                <!-- Team Member 3 -->
                <div class="team-member" id="section-302">
                    <div class="member-image">
                        <img src="{{ team_member3_image|default:'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80' }}" alt="Marcus Thorne">
                    </div>
                    <h3 class="member-name" id="section-303">{{ text_contents.233|default:"Marcus Thorne" }}</h3>
                    <div class="member-role" id="section-304">{{ text_contents.234|default:"Head of International Markets" }}</div>
                    <p class="member-bio" id="section-305">{{ text_contents.235|default:"Multilingual specialist with expertise in European and Asian luxury markets, facilitating cross-border transactions for international clients." }}</p>
                </div>
            </div>
        </div>
        
        {% for component in components %}
        {% if component.drop_zone == '306' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
        {% endif %}
        {% endfor %}
        
        <!-- Achievements -->
        <div class="achievements-section" id="section-306">
            <div class="achievements-header" id="section-307">
                <h2 class="section-title" id="section-308">{{ text_contents.236|default:"Our Legacy in Numbers" }}</h2>
                <p class="about-subtitle" id="section-309" style="color: var(--warm-neutral);">{{ text_contents.237|default:"Two decades of excellence in luxury real estate." }}</p>
            </div>
            
            <div class="achievements-grid">
                <!-- Achievement 1 -->
                <div class="achievement-item" id="section-310">
                    <div class="achievement-number" id="section-311">{{ text_contents.238|default:"25+" }}</div>
                    <div class="achievement-label" id="section-312">{{ text_contents.239|default:"Years of Excellence" }}</div>
                </div>
                
                <!-- Achievement 2 -->
                <div class="achievement-item" id="section-313">
                    <div class="achievement-number" id="section-314">{{ text_contents.240|default:"$4.2B+" }}</div>
                    <div class="achievement-label" id="section-315">{{ text_contents.241|default:"Total Transaction Value" }}</div>
                </div>
                
                <!-- Achievement 3 -->
                <div class="achievement-item" id="section-316">
                    <div class="achievement-number" id="section-317">{{ text_contents.242|default:"28" }}</div>
                    <div class="achievement-label" id="section-318">{{ text_contents.243|default:"Countries Served" }}</div>
                </div>
                
                <!-- Achievement 4 -->
                <div class="achievement-item" id="section-319">
                    <div class="achievement-number" id="section-320">{{ text_contents.244|default:"98%" }}</div>
                    <div class="achievement-label" id="section-321">{{ text_contents.245|default:"Client Retention Rate" }}</div>
                </div>
            </div>
        </div>
        
        <!-- CTA Section -->
        <div class="cta-section" id="section-322">
            <h2 class="cta-title" id="section-323">{{ text_contents.246|default:"Begin Your Luxury Property Journey" }}</h2>
            <p class="cta-text" id="section-324">{{ text_contents.247|default:"Discover how Elite Residences can help you acquire the exceptional property that matches your vision, lifestyle, and investment objectives." }}</p>
            <a href="?page=contact" class="btn-cta" id="section-325">{{ text_contents.248|default:"Schedule a Consultation" }}</a>
        </div>
    </div>

    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    <script>
        // Simple animation for achievement numbers (optional)
        document.addEventListener('DOMContentLoaded', function() {
            const achievementNumbers = document.querySelectorAll('.achievement-number');
            achievementNumbers.forEach(number => {
                const originalText = number.textContent;
                const finalValue = parseInt(originalText.replace(/[^0-9]/g, ''));
                const isPercentage = originalText.includes('%');
                const hasPlus = originalText.includes('+');
                
                if (!isNaN(finalValue)) {
                    let currentValue = 0;
                    const increment = finalValue / 30;
                    const timer = setInterval(() => {
                        currentValue += increment;
                        if (currentValue >= finalValue) {
                            let displayValue = finalValue;
                            if (isPercentage) displayValue += '%';
                            if (hasPlus) displayValue += '+';
                            number.textContent = displayValue;
                            clearInterval(timer);
                        } else {
                            number.textContent = Math.floor(currentValue) + (isPercentage ? '%' : '');
                        }
                    }, 30);
                }
            });
        });
    </script>
</body>
</html>