{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    
    {% render_icon_data icon_customizations %}
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-teal: #273b40;
            --color-mist: #cae9ea;
            --color-charcoal: #1d1d1d;
            --color-slate: #3c4748;
            --color-emerald-teal: #208c8c;
        }

        {% generate_color_variables %}

        body {
            background-color: var(--color-charcoal);
            color: #eef2f3;
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            scroll-behavior: smooth;
            overflow-x: hidden;
            padding-top: 90px;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            margin-bottom: 48px;
            padding: 40px 0 20px;
        }

        .page-title {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--color-mist) 0%, var(--color-emerald-teal) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .cart-subtitle {
            font-size: 1rem;
            color: rgba(202, 233, 234, 0.6);
        }

        /* Cart Layout */
        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 48px;
            margin-bottom: 64px;
        }

        /* Cart Items Section */
        .cart-items-section {
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            border: 1px solid rgba(32, 140, 140, 0.2);
            overflow: hidden;
        }

        .cart-header {
            display: grid;
            grid-template-columns: 3fr 1fr 1fr 0.5fr;
            padding: 20px 24px;
            background: rgba(32, 140, 140, 0.1);
            border-bottom: 1px solid rgba(32, 140, 140, 0.2);
            font-weight: 600;
            color: var(--color-mist);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .cart-item {
            display: grid;
            grid-template-columns: 3fr 1fr 1fr 0.5fr;
            align-items: center;
            padding: 24px;
            border-bottom: 1px solid rgba(60, 71, 72, 0.5);
            transition: all 0.3s ease;
        }

        .cart-item:hover {
            background: rgba(60, 71, 72, 0.3);
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        /* Product Info */
        .product-info-cart {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .cart-product-image {
            width: 80px;
            height: 80px;
            border-radius: 16px;
            object-fit: cover;
            background: rgba(60, 71, 72, 0.5);
        }

        .cart-product-details h3 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 6px;
            color: #ffffff;
        }

        .cart-product-variant {
            font-size: 0.75rem;
            color: var(--color-emerald-teal);
            margin-bottom: 4px;
        }

        .cart-product-category {
            font-size: 0.7rem;
            color: rgba(202, 233, 234, 0.5);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Price & Quantity */
        .cart-item-price {
            font-weight: 600;
            color: var(--color-emerald-teal);
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .quantity-btn {
            width: 32px;
            height: 32px;
            background: rgba(60, 71, 72, 0.5);
            border: 1px solid rgba(32, 140, 140, 0.3);
            border-radius: 8px;
            color: var(--color-mist);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quantity-btn:hover {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border-color: var(--color-emerald-teal);
        }

        .quantity-input {
            width: 50px;
            text-align: center;
            background: rgba(60, 71, 72, 0.5);
            border: 1px solid rgba(32, 140, 140, 0.3);
            border-radius: 8px;
            color: var(--color-mist);
            padding: 6px;
            font-size: 0.9rem;
        }

        .cart-item-total {
            font-weight: 700;
            color: var(--color-emerald-teal);
            font-size: 1.1rem;
        }

        .remove-item {
            background: none;
            border: none;
            color: rgba(202, 233, 234, 0.5);
            cursor: pointer;
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .remove-item:hover {
            color: #ff6b6b;
            transform: scale(1.1);
        }

        /* Cart Summary */
        .cart-summary {
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            border: 1px solid rgba(32, 140, 140, 0.2);
            padding: 28px;
            position: sticky;
            top: 100px;
            height: fit-content;
        }

        .summary-title {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 24px;
            color: var(--color-mist);
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(32, 140, 140, 0.2);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 16px;
            color: rgba(202, 233, 234, 0.8);
        }

        .summary-row.total {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(32, 140, 140, 0.2);
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--color-mist);
        }

        .summary-row.total .summary-value {
            color: var(--color-emerald-teal);
            font-size: 1.4rem;
        }

        /* Promo Code */
        .promo-section {
            margin: 24px 0;
        }

        .promo-title {
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 12px;
            color: var(--color-mist);
        }

        .promo-input-group {
            display: flex;
            gap: 12px;
        }

        .promo-input {
            flex: 1;
            padding: 12px 16px;
            background: rgba(60, 71, 72, 0.5);
            border: 1px solid rgba(32, 140, 140, 0.3);
            border-radius: 40px;
            color: var(--color-mist);
            font-family: 'Inter', sans-serif;
        }

        .promo-input:focus {
            outline: none;
            border-color: var(--color-emerald-teal);
        }

        .apply-promo-btn {
            padding: 12px 24px;
            background: rgba(32, 140, 140, 0.2);
            border: 1px solid var(--color-emerald-teal);
            border-radius: 40px;
            color: var(--color-emerald-teal);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .apply-promo-btn:hover {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
        }

        /* Checkout Button */
        .checkout-btn {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, var(--color-emerald-teal), #1a6e6e);
            border: none;
            border-radius: 40px;
            color: var(--color-charcoal);
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 16px;
        }

        .checkout-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(32, 140, 140, 0.3);
        }

        .continue-shopping {
            text-align: center;
        }

        .continue-shopping a {
            color: var(--color-emerald-teal);
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .continue-shopping a:hover {
            text-decoration: underline;
        }

        /* Empty Cart */
        .empty-cart {
            text-align: center;
            padding: 80px 40px;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            margin-bottom: 64px;
        }

        .empty-cart-icon {
            font-size: 5rem;
            color: var(--color-emerald-teal);
            opacity: 0.5;
            margin-bottom: 24px;
        }

        .empty-cart h2 {
            font-size: 1.8rem;
            color: var(--color-mist);
            margin-bottom: 16px;
        }

        .empty-cart p {
            color: rgba(202, 233, 234, 0.7);
            margin-bottom: 32px;
        }

        .shop-now-btn {
            display: inline-block;
            padding: 14px 40px;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            text-decoration: none;
            border-radius: 40px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .shop-now-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(32, 140, 140, 0.3);
        }

        /* You May Also Like Section */
        .you-may-also-like {
            margin-top: 64px;
            padding-top: 48px;
            border-top: 1px solid rgba(60, 71, 72, 0.5);
        }

        .you-may-also-like h2 {
            font-size: 1.8rem;
            margin-bottom: 32px;
            color: var(--color-mist);
            text-align: center;
        }

        .recommended-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .recommended-product {
            background: rgba(60, 71, 72, 0.2);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid rgba(32, 140, 140, 0.2);
            text-decoration: none;
            display: block;
        }

        .recommended-product:hover {
            transform: translateY(-4px);
            border-color: var(--color-emerald-teal);
        }

        .recommended-product-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .recommended-product-info {
            padding: 16px;
        }

        .recommended-product-name {
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .recommended-product-price {
            color: var(--color-emerald-teal);
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 12px;
        }

        .add-to-cart-recommended {
            width: 100%;
            padding: 8px;
            background: rgba(32, 140, 140, 0.2);
            border: 1px solid var(--color-emerald-teal);
            border-radius: 40px;
            color: var(--color-emerald-teal);
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .add-to-cart-recommended:hover {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .cart-layout {
                grid-template-columns: 1fr;
                gap: 32px;
            }
            .cart-summary {
                position: static;
                max-width: 500px;
                margin: 0 auto;
            }
            .recommended-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 768px) {
            body { padding-top: 80px; }
            .container { padding: 0 24px; }
            .cart-header { display: none; }
            .cart-item {
                grid-template-columns: 1fr;
                gap: 16px;
            }
            .product-info-cart { gap: 16px; }
            .cart-item-price, .cart-item-total {
                text-align: left;
            }
            .quantity-controls { justify-content: flex-start; }
            .recommended-grid { grid-template-columns: repeat(2, 1fr); }
            .page-title { font-size: 2.5rem; }
        }

        @media (max-width: 576px) {
            .recommended-grid { grid-template-columns: 1fr; max-width: 300px; margin: 0 auto; }
            .cart-product-image { width: 60px; height: 60px; }
            .page-title { font-size: 2rem; }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 89 110 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 89 110 %}

        {% generate_hover_keyframes %}
    </style>
</head>
<body data-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce21/snippets/header.html' %}

    <!-- Dynamic Components -->
    {% for component in components %}
        {% if component.drop_zone == '89' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <div class="container">
        <!-- Page Header -->
        <div class="page-header" id="section-89">
            <h1 class="page-title" id="section-90">{{ text_contents.65|default:"Shopping Cart" }}</h1>
            <p class="cart-subtitle" id="section-91">{{ text_contents.66|default:"Review and manage your items before checkout" }}</p>
        </div>

        {% if cart and cart.items.all %}
        <div class="cart-layout">
            <!-- Cart Items -->
            <div class="cart-items-section" id="section-92">
                <div class="cart-header">
                    <div id="section-93">{{ text_contents.67|default:"Product" }}</div>
                    <div id="section-94">{{ text_contents.68|default:"Price" }}</div>
                    <div id="section-95">{{ text_contents.69|default:"Quantity" }}</div>
                    <div id="section-96">{{ text_contents.70|default:"Total" }}</div>
                </div>
                
                <div id="cartItemsContainer">
                    {% for item in cart.items.all %}
                    <div class="cart-item" data-product-id="{{ item.product.id }}" data-cart-item-id="{{ item.id }}">
                        <div class="product-info-cart">
                            {% if item.product.main_image %}
                                <img class="cart-product-image" src="{{ item.product.main_image.url }}" alt="{{ item.product.title }}">
                            {% else %}
                                <div class="cart-product-image" style="background: var(--color-slate); display: flex; align-items: center; justify-content: center;">
                                    <i class="fas fa-gamepad" style="font-size: 2rem; color: var(--color-emerald-teal); opacity: 0.5;"></i>
                                </div>
                            {% endif %}
                            <div class="cart-product-details">
                                <h3 id="section-97">{{ item.product.title }}</h3>
                                <div class="cart-product-variant">
                                    {% if item.selected_color or item.selected_size %}
                                        Color: {{ item.selected_color|default:"N/A" }} | Size: {{ item.selected_size|default:"N/A" }}
                                    {% endif %}
                                </div>
                                <div class="cart-product-category">{{ item.product.category.name|default:"ACCESSORIES" }}</div>
                            </div>
                        </div>
                        <div class="cart-item-price" data-price="{{ item.product.price }}">{{ item.product.price|currency:page }}</div>
                        <div class="quantity-controls">
                            <button class="quantity-btn decrement" data-action="decrement" data-product-id="{{ item.product.id }}">-</button>
                            <input type="number" class="quantity-input" value="{{ item.quantity }}" min="1" max="10" data-product-id="{{ item.product.id }}">
                            <button class="quantity-btn increment" data-action="increment" data-product-id="{{ item.product.id }}">+</button>
                        </div>
                        <div class="cart-item-total" data-product-id="{{ item.product.id }}">{{ item.total_price|currency:page }}</div>
                        <button class="remove-item" data-action="remove" data-product-id="{{ item.product.id }}">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Cart Summary -->
            <div class="cart-summary" id="section-98">
                <h3 class="summary-title" id="section-99">{{ text_contents.72|default:"Order Summary" }}</h3>
                
                <div class="summary-row">
                    <span class="summary-label">Subtotal</span>
                    <span class="summary-value" id="cart-subtotal">{{ cart.total_price|currency:page }}</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Shipping</span>
                    <span class="summary-value" id="cart-shipping">
                        {% if cart.total_price > 100 %}
                            FREE
                        {% else %}
                            $5.00
                        {% endif %}
                    </span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">Tax (8%)</span>
                    <span class="summary-value" id="cart-tax">{{ cart.tax_amount|currency:page|default:"$0.00" }}</span>
                </div>
                <div class="summary-row total">
                    <span class="summary-label">Total</span>
                    <span class="summary-value" id="cart-total">{{ cart.final_total|currency:page|default:cart.total_price|currency:page }}</span>
                </div>

                <!-- Promo Code -->
                <div class="promo-section">
                    <div class="promo-title" id="section-100">{{ text_contents.73|default:"Promo Code" }}</div>
                    <div class="promo-input-group">
                        <input type="text" class="promo-input" id="promoCode" placeholder="Enter code">
                        <button class="apply-promo-btn" id="section-101">{{ text_contents.74|default:"Apply" }}</button>
                    </div>
                </div>

                <!-- Checkout Button -->
                <button class="checkout-btn" id="section-102" onclick="proceedToCheckout()">
                    <i class="fas fa-lock"></i> {{ text_contents.75|default:"Proceed to Checkout" }}
                </button>

                <!-- Continue Shopping -->
                <div class="continue-shopping">
                    <a href="?page=products" id="section-103">
                        <i class="fas fa-arrow-left"></i> {{ text_contents.76|default:"Continue Shopping" }}
                    </a>
                </div>
            </div>
        </div>

        <!-- You May Also Like Section -->
        {% if recommended_products %}
        <div class="you-may-also-like" id="section-104">
            <h2 id="section-105">{{ text_contents.77|default:"You May Also Like" }}</h2>
            <div class="recommended-grid">
                {% for product in recommended_products|slice:":4" %}
                    <div class="recommended-product" data-product-id="{{ product.id }}">
                        {% if product.main_image %}
                            <img class="recommended-product-image" src="{{ product.main_image.url }}" alt="{{ product.title }}">
                        {% else %}
                            <div class="recommended-product-image" style="background: var(--color-slate); display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-gamepad" style="font-size: 2rem; color: var(--color-emerald-teal); opacity: 0.5;"></i>
                            </div>
                        {% endif %}
                        <div class="recommended-product-info">
                            <div class="recommended-product-name">{{ product.title|truncatechars:30 }}</div>
                            <div class="recommended-product-price">{{ product.price|currency:page }}</div>
                            <button class="add-to-cart-recommended" data-add-to-cart="{{ product.id }}">
                                <i class="fas fa-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% else %}
        <div class="you-may-also-like" id="section-104">
            <h2 id="section-105">{{ text_contents.77|default:"You May Also Like" }}</h2>
            <div class="empty-related" style="text-align: center; padding: 60px; background: rgba(60, 71, 72, 0.2); border-radius: 28px; grid-column: 1 / -1;">
                <i class="fas fa-box-open" style="font-size: 3rem; color: var(--color-emerald-teal); opacity: 0.5; margin-bottom: 16px;"></i>
                <p style="color: rgba(202, 233, 234, 0.7);">No recommended products available at the moment.</p>
            </div>
        </div>
        {% endif %}
        
        {% else %}
        <!-- Empty Cart State -->
        <div class="empty-cart">
            <div class="empty-cart-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <h2>{{ text_contents.112|default:"Your Cart is Empty" }}</h2>
            <p>{{ text_contents.113|default:"Looks like you haven't added any items to your cart yet. Explore our collection to find the perfect gaming gear." }}</p>
            <a href="?page=products" class="shop-now-btn">{{ text_contents.114|default:"Start Shopping" }}</a>
        </div>
        {% endif %}
    </div>

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce21/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}
    
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    
    <script>
        // Cart Data for Checkout
        let cartData = {
            items: [],
            subtotal: 0,
            shipping_amount: 0,
            tax_amount: 0,
            total_amount: 0,
            promo_code: null,
            discount_amount: 0
        };

        // Initialize Cart Data from Page
        function initializeCartData() {
            const cartItems = document.querySelectorAll('.cart-item');
            cartData.items = [];
            cartData.subtotal = 0;
            
            cartItems.forEach(item => {
                const productId = item.getAttribute('data-product-id');
                const title = item.querySelector('.cart-product-details h3').textContent;
                const priceEl = item.querySelector('.cart-item-price');
                const price = parseFloat(priceEl.getAttribute('data-price') || priceEl.textContent.replace('$', '').replace(',', ''));
                const quantity = parseInt(item.querySelector('.quantity-input').value);
                const itemTotal = price * quantity;
                const variantEl = item.querySelector('.cart-product-variant');
                let selectedColor = '', selectedSize = '';
                
                if (variantEl && variantEl.textContent) {
                    const variantText = variantEl.textContent;
                    const colorMatch = variantText.match(/Color:\s*([^|]+)/);
                    const sizeMatch = variantText.match(/Size:\s*([^|]+)/);
                    if (colorMatch) selectedColor = colorMatch[1].trim();
                    if (sizeMatch) selectedSize = sizeMatch[1].trim();
                }
                
                cartData.items.push({
                    id: productId,
                    title: title,
                    price: price,
                    quantity: quantity,
                    total_price: itemTotal,
                    selected_color: selectedColor,
                    selected_size: selectedSize
                });
                cartData.subtotal += itemTotal;
            });
            
            cartData.shipping_amount = cartData.subtotal > 100 ? 0 : 5.00;
            cartData.tax_amount = cartData.subtotal * 0.08;
            cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;
            
            updateCartSummaryDisplay();
        }
        
        function updateCartSummaryDisplay() {
            const currencySymbol = '$';
            document.getElementById('cart-subtotal').textContent = currencySymbol + cartData.subtotal.toFixed(2);
            
            const shippingEl = document.getElementById('cart-shipping');
            if (cartData.shipping_amount === 0) {
                shippingEl.textContent = 'FREE';
            } else {
                shippingEl.textContent = currencySymbol + cartData.shipping_amount.toFixed(2);
            }
            
            document.getElementById('cart-tax').textContent = currencySymbol + cartData.tax_amount.toFixed(2);
            document.getElementById('cart-total').textContent = currencySymbol + cartData.total_amount.toFixed(2);
        }
        
        function updateItemTotal(productId, quantity) {
            const itemElement = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
            if (!itemElement) return;
            
            const price = parseFloat(itemElement.querySelector('.cart-item-price').getAttribute('data-price') || 
                itemElement.querySelector('.cart-item-price').textContent.replace('$', '').replace(',', ''));
            const itemTotal = price * quantity;
            const totalElement = itemElement.querySelector('.cart-item-total');
            totalElement.textContent = '$' + itemTotal.toFixed(2);
        }
        
        // Quantity Controls
        document.querySelectorAll('.quantity-btn').forEach(button => {
            button.addEventListener('click', function() {
                const action = this.classList.contains('increment') ? 'increment' : 'decrement';
                const productId = this.getAttribute('data-product-id');
                const input = document.querySelector(`.quantity-input[data-product-id="${productId}"]`);
                if (!input) return;
                
                let currentValue = parseInt(input.value);
                
                if (action === 'increment' && currentValue < 10) {
                    currentValue++;
                    if (window.cartManager) {
                        window.cartManager.incrementCartItem(productId, 1);
                    }
                } else if (action === 'decrement' && currentValue > 1) {
                    currentValue--;
                    if (window.cartManager) {
                        window.cartManager.decrementCartItem(productId, 1);
                    }
                }
                
                input.value = currentValue;
                updateItemTotal(productId, currentValue);
                initializeCartData();
            });
        });
        
        // Quantity Input Change
        document.querySelectorAll('.quantity-input').forEach(input => {
            input.addEventListener('change', function() {
                const productId = this.getAttribute('data-product-id');
                let value = parseInt(this.value);
                
                if (isNaN(value) || value < 1) value = 1;
                if (value > 10) value = 10;
                this.value = value;
                
                if (window.cartManager) {
                    window.cartManager.updateCartItemQuantity(productId, value);
                }
                
                updateItemTotal(productId, value);
                initializeCartData();
            });
        });
        
        // Remove Item
        document.querySelectorAll('.remove-item').forEach(button => {
            button.addEventListener('click', function() {
                const productId = this.getAttribute('data-product-id');
                if (window.cartManager) {
                    window.cartManager.removeFromCart(productId);
                }
                location.reload();
            });
        });
        
        // Apply Promo Code
        document.querySelector('.apply-promo-btn')?.addEventListener('click', function() {
            const promoInput = document.getElementById('promoCode');
            const promoCode = promoInput.value.trim();
            
            if (!promoCode) {
                alert('Please enter a promo code');
                return;
            }
            
            const validPromoCodes = {
                'WELCOME10': 0.10,
                'FREESHIP': 'free_shipping',
                'SAVE20': 0.20
            };
            
            if (validPromoCodes[promoCode.toUpperCase()]) {
                const discount = validPromoCodes[promoCode.toUpperCase()];
                if (discount === 'free_shipping') {
                    cartData.shipping_amount = 0;
                    cartData.promo_code = promoCode;
                    alert('Free shipping applied!');
                } else {
                    cartData.discount_amount = cartData.subtotal * discount;
                    cartData.promo_code = promoCode;
                    alert(`${discount * 100}% discount applied!`);
                }
                cartData.total_amount = cartData.subtotal + cartData.shipping_amount + cartData.tax_amount - cartData.discount_amount;
                updateCartSummaryDisplay();
            } else {
                alert('Invalid promo code');
            }
            promoInput.value = '';
        });
        
        // Proceed to Checkout
        function proceedToCheckout() {
            if (cartData.items.length === 0) {
                alert('Your cart is empty. Please add items before checkout.');
                return;
            }
            
            const hostname = window.location.hostname;
            const pageDomain = document.body.getAttribute('data-subdomain');
            const subdomain = hostname.includes('localhost') ? pageDomain : hostname.split('.')[0];
            
            const checkoutData = {
                items: cartData.items,
                subtotal: cartData.subtotal,
                shipping_amount: cartData.shipping_amount,
                tax_amount: cartData.tax_amount,
                total_amount: cartData.total_amount,
                promo_code: cartData.promo_code,
                discount_amount: cartData.discount_amount
            };
            
            const params = new URLSearchParams({
                type: 'cart',
                cart: JSON.stringify(checkoutData)
            });
            
            window.location.href = `/payments/select-payment/${subdomain}/?${params.toString()}`;
        }
        
        // Add to Cart from Recommended Products
        document.querySelectorAll('.add-to-cart-recommended').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const productId = this.getAttribute('data-add-to-cart');
                if (window.cartManager) {
                    window.cartManager.addToCart(productId, 1);
                }
            });
        });
        
        // Initialize Cart
        initializeCartData();
        
        // Listen for cart updates
        document.addEventListener('cartUpdated', function() {
            setTimeout(() => location.reload(), 500);
        });
        
        // Continue Shopping
        document.querySelector('.continue-shopping a')?.addEventListener('click', function(e) {
            e.preventDefault();
            window.location.href = '?page=products';
        });
        
        window.proceedToCheckout = proceedToCheckout;
    </script>
</body>
</html>