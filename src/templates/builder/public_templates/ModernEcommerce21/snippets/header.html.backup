{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
    :root {
        --color-deep-teal: #273b40;
        --color-mist: #cae9ea;
        --color-charcoal: #1d1d1d;
        --color-slate: #3c4748;
        --color-emerald-teal: #208c8c;
    }
    
    {% generate_color_variables %}
    
    /* Header Styles */
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        background: rgba(29, 29, 29, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(60, 71, 72, 0.4);
        padding: 16px 0;
    }
    
    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 32px;
    }
    
    .logo {
        font-size: 1.7rem;
        font-weight: 700;
        letter-spacing: -0.5px;
        background: linear-gradient(135deg, var(--color-mist) 0%, var(--color-emerald-teal) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    
    .logo a {
        text-decoration: none;
    }
    
    .nav-list {
        display: flex;
        gap: 2rem;
        align-items: center;
        list-style: none;
    }
    
    .nav-item {
        color: var(--color-mist);
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
        position: relative;
        padding: 6px 0;
    }
    
    .nav-item:hover {
        color: var(--color-emerald-teal);
    }
    
    .icon-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: inherit;
        padding: 0.4rem;
    }
    
    .wishlist-counter,
    .cart-counter {
        position: absolute;
        top: 0;
        right: 0;
        transform: translate(50%, -50%);
        background-color: var(--color-emerald-teal);
        color: white;
        padding: 0.25rem 0.5rem;
        border-radius: 1rem;
        font-size: 0.5rem;
        font-weight: 600;
    }
    
    .account-dropdown {
        position: relative;
        cursor: pointer;
    }
    
    .account-dropdown-trigger {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--color-mist);
        font-weight: 500;
    }
    
    .dropdown-menu {
        position: absolute;
        top: 40px;
        right: 0;
        background: var(--color-deep-teal);
        backdrop-filter: blur(8px);
        background-color: rgba(39, 59, 64, 0.98);
        border-radius: 14px;
        width: 200px;
        padding: 12px 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: all 0.2s;
        box-shadow: 0 12px 28px rgba(0,0,0,0.3);
        border: 1px solid rgba(32, 140, 140, 0.3);
        z-index: 110;
    }
    
    .account-dropdown:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    
    .dropdown-menu a {
        display: block;
        padding: 10px 20px;
        color: var(--color-mist);
        text-decoration: none;
        font-size: 0.85rem;
        transition: 0.2s;
    }
    
    .dropdown-menu a:hover {
        background: rgba(32, 140, 140, 0.2);
        color: var(--color-emerald-teal);
    }
    
    .hamburger {
        display: none;
        background: none;
        border: none;
        color: var(--color-mist);
        font-size: 1.8rem;
        cursor: pointer;
    }
    
    .mobile-nav {
        display: none;
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100%;
        background: var(--color-deep-teal);
        backdrop-filter: blur(20px);
        background-color: rgba(29, 29, 29, 0.98);
        z-index: 2000;
        padding: 28px 20px;
        box-shadow: -5px 0 30px rgba(0,0,0,0.5);
        transition: right 0.3s ease;
        border-left: 1px solid var(--color-emerald-teal);
    }
    
    .mobile-nav.active {
        right: 0;
    }
    
    .mobile-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
    }
    
    .mobile-back-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        background: none;
        border: none;
        color: var(--color-mist);
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
    }
    
    .mobile-nav-links {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 28px;
    }
    
    .mobile-nav-links a {
        color: var(--color-mist);
        text-decoration: none;
        font-size: 1.2rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    
    .mobile-dropdown-group {
        margin-top: 20px;
        padding-left: 20px;
        border-left: 2px solid var(--color-emerald-teal);
    }
    
    .mobile-dropdown-group a {
        font-size: 0.95rem;
        padding: 8px 0;
        display: block;
    }
    
    .overlay-blur {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(4px);
        z-index: 1999;
        opacity: 0;
        visibility: hidden;
        transition: 0.2s;
    }
    
    .overlay-blur.active {
        opacity: 1;
        visibility: visible;
    }
    
    @media (max-width: 860px) {
        .nav-list {
            display: none;
        }
        .hamburger {
            display: block;
        }
        .mobile-nav {
            display: block;
        }
        .header-inner {
            padding: 0 24px;
        }
    }
</style>

<header class="site-header" id="section-1">
    <div class="header-inner">
        <div class="logo">
            <a href="?page=home">
                <i class="fas fa-gamepad" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"NEXUS" }}</span>
            </a>
        </div>
        <ul class="nav-list">
            <li><a href="?page=home" class="nav-item" id="section-3">{{ text_contents.2|default:"Home" }}</a></li>
            <li><a href="?page=products" class="nav-item" id="section-4">{{ text_contents.3|default:"Shop" }}</a></li>
            <li><a href="?page=about" class="nav-item" id="section-5">{{ text_contents.4|default:"About Us" }}</a></li>
            <li><a href="?page=contact" class="nav-item" id="section-6">{{ text_contents.5|default:"Contact" }}</a></li>
            <li><a href="?page=cart" class="nav-item icon-btn">
                <span class="cart-counter">0</span>
                <i class="fas fa-shopping-cart" data-icon="2"></i>
            </a></li>
            <li><a href="?page=wishlist" class="nav-item icon-btn">
                <span class="wishlist-counter">0</span>
                <i class="far fa-heart" data-icon="3"></i>
            </a></li>
            <li class="account-dropdown">
                <div class="account-dropdown-trigger">
                    <i class="fas fa-user-circle"></i> Account <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                </div>
                <div class="dropdown-menu">
                    <a href="{% url 'accounts:universal_login' %}?website_id={{ page.id }}&next={{ website_homepage_url|urlencode }}" id="section-9">{{ text_contents.8|default:"Sign In" }}</a>
                    <a href="{{ website_register_url }}" id="section-10">{{ text_contents.9|default:"Sign Up" }}</a>
                    <a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-11">{{ text_contents.10|default:"Orders" }}</a>
                    <a href="?page=wishlist" id="section-12">{{ text_contents.11|default:"Wishlist" }}</a>
                </div>
            </li>
        </ul>
        <button class="hamburger" id="hamburgerBtn" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
    </div>
</header>

<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <button class="mobile-back-btn" id="closeMobileNav">
            <i class="fas fa-arrow-left"></i> Back
        </button>
        <i class="fas fa-times" id="closeMobileIcon" style="font-size: 1.4rem; cursor: pointer;"></i>
    </div>
    <ul class="mobile-nav-links">
        <li><a href="?page=home"><i class="fas fa-home"></i> Home</a></li>
        <li><a href="?page=products"><i class="fas fa-store"></i> Shop</a></li>
        <li><a href="?page=about"><i class="fas fa-info-circle"></i> About Us</a></li>
        <li><a href="?page=contact"><i class="fas fa-envelope"></i> Contact</a></li>
        <li><a href="?page=cart"><i class="fas fa-shopping-cart"></i> Cart</a></li>
        <li><a href="?page=wishlist"><i class="far fa-heart"></i> Wishlist</a></li>
        <li>
            <div style="margin-top: 10px;"><i class="fas fa-user"></i> Account</div>
            <div class="mobile-dropdown-group">
                <a href="{% url 'accounts:universal_login' %}?website_id={{ page.id }}">Sign In</a>
                <a href="{{ website_register_url }}">Sign Up</a>
                <a href="{% url 'payments:customer_order_history' page.subdomain %}">Orders</a>
                <a href="?page=wishlist">Wishlist</a>
            </div>
        </li>
    </ul>
</div>
<div class="overlay-blur" id="overlayBlur"></div>

<script>
    const hamburger = document.getElementById('hamburgerBtn');
    const mobileNav = document.getElementById('mobileNav');
    const overlay = document.getElementById('overlayBlur');
    const closeMobileNavBtn = document.getElementById('closeMobileNav');
    const closeIcon = document.getElementById('closeMobileIcon');

    function openMobileNav() {
        mobileNav.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }
    
    function closeMobileNavFunc() {
        mobileNav.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
    }

    if (hamburger) hamburger.addEventListener('click', openMobileNav);
    if (closeMobileNavBtn) closeMobileNavBtn.addEventListener('click', closeMobileNavFunc);
    if (closeIcon) closeIcon.addEventListener('click', closeMobileNavFunc);
    if (overlay) overlay.addEventListener('click', closeMobileNavFunc);

    window.addEventListener('resize', function() {
        if (window.innerWidth > 860 && mobileNav.classList.contains('active')) {
            closeMobileNavFunc();
        }
    });
</script>