{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | {{ page.brand_name }} Gaming Gear</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    
    {% render_icon_data icon_customizations %}
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-teal: #273b40;
            --color-mist: #cae9ea;
            --color-charcoal: #1d1d1d;
            --color-slate: #3c4748;
            --color-emerald-teal: #208c8c;
        }

        {% generate_color_variables %}

        body {
            background-color: var(--color-charcoal);
            color: #eef2f3;
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            scroll-behavior: smooth;
            overflow-x: hidden;
            padding-top: 90px;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            margin-bottom: 48px;
            padding: 40px 0 20px;
        }

        .page-title {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--color-mist) 0%, var(--color-emerald-teal) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .page-description {
            font-size: 1.1rem;
            color: rgba(202, 233, 234, 0.7);
            max-width: 600px;
            margin: 0 auto;
        }

        /* Shop Controls */
        .shop-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 48px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(60, 71, 72, 0.5);
        }

        .categories-action {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .categories-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(32, 140, 140, 0.15);
            border: 1px solid var(--color-emerald-teal);
            color: var(--color-emerald-teal);
            padding: 10px 24px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .categories-button:hover {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(32, 140, 140, 0.3);
        }

        .filter-sort {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .filter-btn, .sort-select {
            background: rgba(60, 71, 72, 0.3);
            border: 1px solid rgba(60, 71, 72, 0.5);
            padding: 10px 20px;
            border-radius: 40px;
            color: var(--color-mist);
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-btn:hover, .sort-select:hover {
            border-color: var(--color-emerald-teal);
            color: var(--color-emerald-teal);
        }

        .sort-select {
            background: rgba(60, 71, 72, 0.3);
            min-width: 160px;
        }

        /* Filter Modal */
        .filter-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .filter-modal.active {
            display: flex;
        }

        .filter-modal-content {
            background: var(--color-deep-teal);
            border-radius: 28px;
            padding: 32px;
            width: 90%;
            max-width: 500px;
            border: 1px solid rgba(32, 140, 140, 0.3);
        }

        .filter-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .filter-modal-header h3 {
            color: var(--color-mist);
            font-size: 1.5rem;
        }

        .close-filter-modal {
            background: none;
            border: none;
            color: var(--color-mist);
            font-size: 1.5rem;
            cursor: pointer;
        }

        .filter-categories {
            margin-bottom: 24px;
        }

        .filter-categories h4 {
            color: var(--color-mist);
            margin-bottom: 16px;
        }

        .category-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .category-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 12px;
            cursor: pointer;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .category-item:hover {
            background: rgba(32, 140, 140, 0.1);
        }

        .category-item input {
            cursor: pointer;
        }

        .category-item label {
            color: var(--color-mist);
            cursor: pointer;
            flex: 1;
        }

        .filter-actions {
            display: flex;
            gap: 16px;
            margin-top: 24px;
        }

        .btn-apply-filters, .btn-clear-filters {
            flex: 1;
            padding: 12px;
            border-radius: 40px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-apply-filters {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border: none;
        }

        .btn-apply-filters:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(32, 140, 140, 0.3);
        }

        .btn-clear-filters {
            background: transparent;
            border: 1px solid var(--color-emerald-teal);
            color: var(--color-emerald-teal);
        }

        .btn-clear-filters:hover {
            background: rgba(32, 140, 140, 0.1);
        }

        /* Active Filters */
        .active-filters {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 24px;
            align-items: center;
        }

        .active-filter-tag {
            background: rgba(32, 140, 140, 0.2);
            color: var(--color-emerald-teal);
            padding: 6px 12px;
            border-radius: 40px;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .remove-filter {
            background: none;
            border: none;
            color: var(--color-emerald-teal);
            cursor: pointer;
            font-size: 0.8rem;
        }

        .clear-all-filters {
            background: none;
            border: none;
            color: var(--color-mist);
            cursor: pointer;
            font-size: 0.85rem;
            text-decoration: underline;
        }

        /* Products Grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            margin-bottom: 60px;
        }

        .product-card {
            background: rgba(60, 71, 72, 0.2);
            backdrop-filter: blur(2px);
            border-radius: 28px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            border: 1px solid rgba(32, 140, 140, 0.2);
            text-decoration: none;
            display: block;
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(32, 140, 140, 0.4);
            background: rgba(39, 59, 64, 0.5);
        }

        .product-image {
            width: 100%;
            aspect-ratio: 1 / 0.9;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .product-card:hover .product-image {
            transform: scale(1.02);
        }

        .product-info {
            padding: 20px;
        }

        .product-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-emerald-teal);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .product-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #ffffff;
            line-height: 1.3;
        }

        .product-price {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--color-emerald-teal);
            margin-bottom: 16px;
        }

        .product-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

        .add-to-cart-btn {
            flex: 1;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border: none;
            padding: 10px 16px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .add-to-cart-btn:hover {
            background: #1e7a7a;
            transform: translateY(-2px);
        }

        .wishlist-btn {
            background: rgba(60, 71, 72, 0.5);
            border: 1px solid rgba(32, 140, 140, 0.3);
            color: var(--color-mist);
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .wishlist-btn:hover {
            background: rgba(32, 140, 140, 0.3);
            color: var(--color-emerald-teal);
            transform: translateY(-2px);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 40px;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            grid-column: 1 / -1;
        }

        .empty-state-icon {
            font-size: 4rem;
            color: var(--color-emerald-teal);
            margin-bottom: 24px;
            opacity: 0.5;
        }

        .empty-state h3 {
            font-size: 1.8rem;
            color: var(--color-mist);
            margin-bottom: 16px;
        }

        .empty-state p {
            color: rgba(202, 233, 234, 0.7);
            margin-bottom: 24px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .empty-state a {
            display: inline-block;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            padding: 12px 32px;
            border-radius: 40px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .empty-state a:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(32, 140, 140, 0.3);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 24px;
            }
        }

        @media (max-width: 992px) {
            .page-title { font-size: 2.5rem; }
            .products-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            body { padding-top: 80px; }
            .container { padding: 0 24px; }
            .shop-controls { flex-direction: column; align-items: stretch; }
            .categories-action { justify-content: center; }
            .filter-sort { justify-content: center; }
            .products-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto 60px; }
            .page-title { font-size: 2rem; }
        }

        @media (max-width: 576px) {
            .filter-sort { flex-direction: column; width: 100%; }
            .filter-btn, .sort-select { width: 100%; text-align: center; }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 44 60 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 44 60 %}

        {% generate_hover_keyframes %}
    </style>
</head>
<body data-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce21/snippets/header.html' %}

    <!-- Dynamic Components -->
    {% for component in components %}
        {% if component.drop_zone == '44' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <div class="container">
        <!-- Page Header -->
        <div class="page-header" id="section-44">
            <h1 class="page-title" id="section-45">{{ text_contents.35|default:"Shop Gaming Gear" }}</h1>
            <p class="page-description" id="section-46">{{ text_contents.36|default:"Discover precision-crafted peripherals designed for competitive edge and immersive gameplay." }}</p>
        </div>

        <!-- Shop Controls -->
        <div class="shop-controls" id="section-47">
            <div class="categories-action">
                <a href="?page=categories" class="categories-button" id="section-48">
                    <i class="fas fa-th-large"></i> {{ text_contents.37|default:"Browse Categories" }}
                </a>
            </div>
            <div class="filter-sort">
                <button class="filter-btn" id="open-filter-modal" id="section-49">
                    <i class="fas fa-filter"></i> {{ text_contents.38|default:"Filter" }}
                </button>
                <select class="sort-select" id="sort-products" id="section-50">
                    <option value="newest">{{ text_contents.39|default:"Newest First" }}</option>
                    <option value="price-low">{{ text_contents.40|default:"Price: Low to High" }}</option>
                    <option value="price-high">{{ text_contents.41|default:"Price: High to Low" }}</option>
                </select>
            </div>
        </div>

        <!-- Active Filters Display -->
        <div class="active-filters" id="active-filters" style="display: none;">
            <span>Active filters:</span>
            <div id="active-filters-list"></div>
            <button class="clear-all-filters" id="clear-all-filters">Clear all</button>
        </div>

        <!-- Filter Modal -->
        <div class="filter-modal" id="filter-modal">
            <div class="filter-modal-content">
                <div class="filter-modal-header">
                    <h3>Filter Products</h3>
                    <button class="close-filter-modal" id="close-filter-modal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div class="filter-categories">
                    <h4>Categories</h4>
                    <div class="category-list" id="category-list">
                        {% for category in categories %}
                            {% if category.is_active %}
                                <div class="category-item" data-category-id="{{ category.id }}" data-category-name="{{ category.name }}">
                                    <input type="checkbox" id="category-{{ category.id }}" class="category-checkbox">
                                    <label for="category-{{ category.id }}">{{ category.name }}</label>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
                <div class="filter-actions">
                    <button class="btn-apply-filters" id="apply-filters">Apply Filters</button>
                    <button class="btn-clear-filters" id="clear-filters-modal">Clear All</button>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        {% if products %}
        <div class="products-grid" id="products-grid">
            {% for product in products %}
                <div class="product-card" id="section-51"
                     data-product-id="{{ product.id }}"
                     data-product-title="{{ product.title }}"
                     data-product-price="{{ product.price }}"
                     data-product-category="{{ product.category.id|default:'' }}"
                     data-product-category-name="{{ product.category.name|default:'Uncategorized' }}">
                    {% if product.main_image %}
                        <img src="{{ product.main_image.url }}" alt="{{ product.title }}" class="product-image">
                    {% else %}
                        <div class="product-image" style="background: var(--color-slate); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-gamepad" style="font-size: 3rem; color: var(--color-emerald-teal); opacity: 0.5;"></i>
                        </div>
                    {% endif %}
                    <div class="product-info">
                        <div class="product-category" id="section-52">
                            {{ product.category.name|default:"ACCESSORIES" }}
                        </div>
                        <div class="product-name" id="section-53">{{ product.title|truncatechars:40 }}</div>
                        <div class="product-price" id="section-54">
                            {{ product.price|currency:page }}
                            {% if product.compare_at_price and product.compare_at_price > product.price %}
                                <span style="text-decoration: line-through; color: rgba(202, 233, 234, 0.5); font-size: 0.9rem; margin-left: 8px;">
                                    {{ product.compare_at_price|currency:page }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="product-actions">
                            <button class="add-to-cart-btn" id="section-55" data-add-to-cart="{{ product.id }}">
                                <i class="fas fa-shopping-cart"></i> {{ text_contents.43|default:"Add to Cart" }}
                            </button>
                            <button class="wishlist-btn" data-add-to-wishlist="{{ product.id }}">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="fas fa-gamepad"></i>
            </div>
            <h3>No Products Available</h3>
            <p>Your shop doesn't have any products yet. Start by adding your first gaming gear to showcase your collection.</p>
            <a href="/admin/add-product">Add Your First Product</a>
        </div>
        {% endif %}
    </div>

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce21/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}
    
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    
    <script>
        // Filter Modal Functionality
        let activeFilters = {
            categories: [],
            sortBy: 'newest'
        };

        document.addEventListener('DOMContentLoaded', function() {
            const filterModal = document.getElementById('filter-modal');
            const openFilterBtn = document.getElementById('open-filter-modal');
            const closeFilterBtn = document.getElementById('close-filter-modal');
            const applyFiltersBtn = document.getElementById('apply-filters');
            const clearFiltersModalBtn = document.getElementById('clear-filters-modal');
            const clearAllFiltersBtn = document.getElementById('clear-all-filters');
            const sortSelect = document.getElementById('sort-products');

            if (openFilterBtn) {
                openFilterBtn.addEventListener('click', function() {
                    filterModal.classList.add('active');
                });
            }

            if (closeFilterBtn) {
                closeFilterBtn.addEventListener('click', function() {
                    filterModal.classList.remove('active');
                });
            }

            if (filterModal) {
                filterModal.addEventListener('click', function(e) {
                    if (e.target === filterModal) {
                        filterModal.classList.remove('active');
                    }
                });
            }

            if (applyFiltersBtn) {
                applyFiltersBtn.addEventListener('click', function() {
                    const selectedCategories = [];
                    const categoryCheckboxes = document.querySelectorAll('.category-checkbox:checked');
                    categoryCheckboxes.forEach(checkbox => {
                        const categoryItem = checkbox.closest('.category-item');
                        const categoryId = categoryItem.getAttribute('data-category-id');
                        const categoryName = categoryItem.getAttribute('data-category-name');
                        selectedCategories.push({ id: categoryId, name: categoryName });
                    });
                    activeFilters.categories = selectedCategories;
                    applyFilters();
                    filterModal.classList.remove('active');
                });
            }

            if (clearFiltersModalBtn) {
                clearFiltersModalBtn.addEventListener('click', function() {
                    document.querySelectorAll('.category-checkbox').forEach(checkbox => {
                        checkbox.checked = false;
                    });
                });
            }

            if (clearAllFiltersBtn) {
                clearAllFiltersBtn.addEventListener('click', clearAllFilters);
            }

            if (sortSelect) {
                sortSelect.addEventListener('change', function() {
                    activeFilters.sortBy = this.value;
                    applyFilters();
                });
            }

            document.querySelectorAll('.category-item').forEach(item => {
                item.addEventListener('click', function(e) {
                    if (e.target.type !== 'checkbox') {
                        const checkbox = this.querySelector('.category-checkbox');
                        checkbox.checked = !checkbox.checked;
                    }
                });
            });

            // Initialize cart and wishlist buttons
            initializeCartButtons();
        });

        function applyFilters() {
            const products = document.querySelectorAll('.product-card');
            let visibleProducts = 0;

            products.forEach(product => {
                let shouldShow = true;

                if (activeFilters.categories.length > 0) {
                    const productCategoryId = product.getAttribute('data-product-category');
                    const hasCategoryMatch = activeFilters.categories.some(cat => cat.id === productCategoryId);
                    shouldShow = shouldShow && hasCategoryMatch;
                }

                if (shouldShow) {
                    product.style.display = 'block';
                    visibleProducts++;
                } else {
                    product.style.display = 'none';
                }
            });

            if (activeFilters.sortBy !== 'newest') {
                sortProducts();
            }

            updateActiveFiltersDisplay();

            const noProductsMessage = document.getElementById('no-products-message');
            const productsGrid = document.getElementById('products-grid');

            if (visibleProducts === 0 && products.length > 0) {
                if (!noProductsMessage) {
                    showEmptyFilterState();
                }
            } else {
                const emptyState = document.querySelector('.empty-filter-state');
                if (emptyState) emptyState.remove();
            }
        }

        function sortProducts() {
            const productsGrid = document.getElementById('products-grid');
            const products = Array.from(document.querySelectorAll('.product-card'));

            products.sort((a, b) => {
                switch(activeFilters.sortBy) {
                    case 'price-low':
                        const priceA = parseFloat(a.getAttribute('data-product-price')) || 0;
                        const priceB = parseFloat(b.getAttribute('data-product-price')) || 0;
                        return priceA - priceB;
                    case 'price-high':
                        const priceAHigh = parseFloat(a.getAttribute('data-product-price')) || 0;
                        const priceBHigh = parseFloat(b.getAttribute('data-product-price')) || 0;
                        return priceBHigh - priceAHigh;
                    case 'newest':
                    default:
                        return 0;
                }
            });

            if (productsGrid) {
                products.forEach(product => {
                    productsGrid.appendChild(product);
                });
            }
        }

        function updateActiveFiltersDisplay() {
            const activeFiltersContainer = document.getElementById('active-filters');
            const activeFiltersList = document.getElementById('active-filters-list');

            if (!activeFiltersContainer || !activeFiltersList) return;

            if (activeFilters.categories.length === 0) {
                activeFiltersContainer.style.display = 'none';
                return;
            }

            let filtersHtml = '';
            activeFilters.categories.forEach(category => {
                filtersHtml += `
                    <div class="active-filter-tag">
                        ${category.name}
                        <button class="remove-filter" onclick="removeCategoryFilter('${category.id}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;
            });
            activeFiltersList.innerHTML = filtersHtml;
            activeFiltersContainer.style.display = 'flex';
        }

        function removeCategoryFilter(categoryId) {
            activeFilters.categories = activeFilters.categories.filter(cat => cat.id !== categoryId);
            const checkbox = document.querySelector(`.category-checkbox[data-category-id="${categoryId}"]`);
            if (checkbox) {
                checkbox.checked = false;
            }
            applyFilters();
        }

        function clearAllFilters() {
            activeFilters.categories = [];
            activeFilters.sortBy = 'newest';
            document.querySelectorAll('.category-checkbox').forEach(checkbox => {
                checkbox.checked = false;
            });
            const sortSelect = document.getElementById('sort-products');
            if (sortSelect) {
                sortSelect.value = 'newest';
            }
            applyFilters();
        }

        function showEmptyFilterState() {
            const productsGrid = document.getElementById('products-grid');
            const existingEmpty = document.querySelector('.empty-filter-state');
            if (existingEmpty) return;

            const emptyState = document.createElement('div');
            emptyState.className = 'empty-state empty-filter-state';
            emptyState.innerHTML = `
                <div class="empty-state-icon">
                    <i class="fas fa-filter"></i>
                </div>
                <h3>No Products Match Your Filters</h3>
                <p>Try adjusting your filters or clear them to see all available products.</p>
                <button class="clear-all-filters-btn" onclick="clearAllFilters()">Clear All Filters</button>
            `;
            emptyState.querySelector('.clear-all-filters-btn').style.cssText = `
                background: var(--color-emerald-teal);
                color: var(--color-charcoal);
                padding: 12px 32px;
                border-radius: 40px;
                border: none;
                font-weight: 600;
                cursor: pointer;
                margin-top: 16px;
            `;
            productsGrid.appendChild(emptyState);
        }

        function initializeCartButtons() {
            document.querySelectorAll('[data-add-to-cart]').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const productId = this.dataset.addToCart;
                    if (window.cartManager) {
                        window.cartManager.addToCart(productId, 1);
                    } else {
                        alert('Item added to cart!');
                    }
                });
            });

            document.querySelectorAll('[data-add-to-wishlist]').forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const productId = this.dataset.addToWishlist;
                    if (window.cartManager) {
                        window.cartManager.addToWishlist(productId);
                    } else {
                        alert('Item added to wishlist!');
                    }
                });
            });
        }
    </script>
</body>
</html>