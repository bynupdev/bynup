{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    
    {% render_icon_data icon_customizations %}
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-deep-teal: #273b40;
            --color-mist: #cae9ea;
            --color-charcoal: #1d1d1d;
            --color-slate: #3c4748;
            --color-emerald-teal: #208c8c;
        }

        {% generate_color_variables %}

        body {
            background-color: var(--color-charcoal);
            color: #eef2f3;
            font-family: 'Inter', sans-serif;
            line-height: 1.4;
            scroll-behavior: smooth;
            overflow-x: hidden;
            padding-top: 90px;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 32px;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            margin-bottom: 48px;
            padding: 40px 0 20px;
        }

        .page-title {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--color-mist) 0%, var(--color-emerald-teal) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 16px;
            letter-spacing: -1px;
        }

        .wishlist-subtitle {
            font-size: 1rem;
            color: rgba(202, 233, 234, 0.6);
        }

        /* Wishlist Stats */
        .wishlist-stats {
            display: flex;
            justify-content: center;
            gap: 48px;
            margin-bottom: 48px;
            flex-wrap: wrap;
        }

        .stat-card {
            background: rgba(60, 71, 72, 0.2);
            border: 1px solid rgba(32, 140, 140, 0.2);
            border-radius: 20px;
            padding: 20px 32px;
            text-align: center;
            min-width: 150px;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: var(--color-emerald-teal);
        }

        .stat-label {
            font-size: 0.85rem;
            color: rgba(202, 233, 234, 0.7);
            margin-top: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Wishlist Controls */
        .wishlist-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 32px;
            padding-bottom: 24px;
            border-bottom: 1px solid rgba(60, 71, 72, 0.5);
        }

        .filter-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 8px 20px;
            background: rgba(60, 71, 72, 0.3);
            border: 1px solid rgba(32, 140, 140, 0.3);
            border-radius: 40px;
            color: var(--color-mist);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.85rem;
        }

        .filter-btn:hover, .filter-btn.active {
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border-color: var(--color-emerald-teal);
        }

        .clear-wishlist-btn {
            padding: 8px 24px;
            background: rgba(60, 71, 72, 0.3);
            border: 1px solid rgba(255, 107, 107, 0.3);
            border-radius: 40px;
            color: #ff6b6b;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.85rem;
        }

        .clear-wishlist-btn:hover {
            background: rgba(255, 107, 107, 0.2);
            border-color: #ff6b6b;
        }

        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 32px;
            margin-bottom: 64px;
        }

        .wishlist-card {
            background: rgba(60, 71, 72, 0.2);
            backdrop-filter: blur(2px);
            border-radius: 28px;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
            border: 1px solid rgba(32, 140, 140, 0.2);
            position: relative;
        }

        .wishlist-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 30px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(32, 140, 140, 0.4);
            background: rgba(39, 59, 64, 0.5);
        }

        .wishlist-image {
            width: 100%;
            aspect-ratio: 1 / 0.9;
            object-fit: cover;
            transition: transform 0.3s;
        }

        .wishlist-card:hover .wishlist-image {
            transform: scale(1.02);
        }

        .wishlist-badge {
            position: absolute;
            top: 16px;
            right: 16px;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 0.7rem;
            font-weight: 600;
            z-index: 2;
        }

        .wishlist-info {
            padding: 20px;
        }

        .wishlist-category {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-emerald-teal);
            margin-bottom: 8px;
            font-weight: 500;
        }

        .wishlist-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: #ffffff;
            line-height: 1.3;
        }

        .wishlist-price {
            font-size: 1.3rem;
            font-weight: 600;
            color: var(--color-emerald-teal);
            margin-bottom: 16px;
        }

        .wishlist-actions {
            display: flex;
            gap: 12px;
            margin-top: 16px;
        }

        .add-to-cart-wishlist {
            flex: 1;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            border: none;
            padding: 10px 16px;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .add-to-cart-wishlist:hover {
            background: #1e7a7a;
            transform: translateY(-2px);
        }

        .remove-wishlist {
            background: rgba(60, 71, 72, 0.5);
            border: 1px solid rgba(255, 107, 107, 0.3);
            color: #ff6b6b;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .remove-wishlist:hover {
            background: rgba(255, 107, 107, 0.2);
            transform: translateY(-2px);
        }

        /* Empty Wishlist */
        .empty-wishlist {
            text-align: center;
            padding: 80px 40px;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            margin-bottom: 64px;
        }

        .empty-wishlist-icon {
            font-size: 5rem;
            color: var(--color-emerald-teal);
            opacity: 0.5;
            margin-bottom: 24px;
        }

        .empty-wishlist h2 {
            font-size: 1.8rem;
            color: var(--color-mist);
            margin-bottom: 16px;
        }

        .empty-wishlist p {
            color: rgba(202, 233, 234, 0.7);
            margin-bottom: 32px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-now-wishlist {
            display: inline-block;
            padding: 14px 40px;
            background: var(--color-emerald-teal);
            color: var(--color-charcoal);
            text-decoration: none;
            border-radius: 40px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .shop-now-wishlist:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(32, 140, 140, 0.3);
        }

        /* Recently Viewed Section */
        .recently-viewed {
            margin-top: 64px;
            padding-top: 48px;
            border-top: 1px solid rgba(60, 71, 72, 0.5);
        }

        .recently-viewed h2 {
            font-size: 1.8rem;
            margin-bottom: 32px;
            color: var(--color-mist);
            text-align: center;
        }

        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .recent-product {
            background: rgba(60, 71, 72, 0.2);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid rgba(32, 140, 140, 0.2);
            text-decoration: none;
            display: block;
        }

        .recent-product:hover {
            transform: translateY(-4px);
            border-color: var(--color-emerald-teal);
        }

        .recent-product-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .recent-product-info {
            padding: 16px;
        }

        .recent-product-name {
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .recent-product-price {
            color: var(--color-emerald-teal);
            font-weight: 600;
            font-size: 1rem;
        }

        .empty-recent {
            text-align: center;
            padding: 60px;
            background: rgba(60, 71, 72, 0.2);
            border-radius: 28px;
            grid-column: 1 / -1;
        }

        .empty-recent i {
            font-size: 3rem;
            color: var(--color-emerald-teal);
            opacity: 0.5;
            margin-bottom: 16px;
        }

        .empty-recent p {
            color: rgba(202, 233, 234, 0.7);
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .wishlist-grid, .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .wishlist-grid, .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .page-title { font-size: 2.5rem; }
        }

        @media (max-width: 768px) {
            body { padding-top: 80px; }
            .container { padding: 0 24px; }
            .wishlist-controls { flex-direction: column; align-items: stretch; }
            .filter-buttons { justify-content: center; }
            .clear-wishlist-btn { justify-content: center; }
            .wishlist-grid, .recently-viewed-grid { grid-template-columns: 1fr; max-width: 380px; margin: 0 auto; }
            .page-title { font-size: 2rem; }
            .wishlist-stats { gap: 16px; }
            .stat-card { padding: 16px 24px; min-width: 120px; }
            .stat-number { font-size: 1.5rem; }
        }

        @media (max-width: 576px) {
            .wishlist-stats { gap: 12px; }
            .stat-card { padding: 12px 16px; min-width: 100px; }
            .stat-number { font-size: 1.2rem; }
            .stat-label { font-size: 0.7rem; }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 110 140 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 110 140 %}

        {% generate_hover_keyframes %}
    </style>
</head>
<body data-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce21/snippets/header.html' %}

    <!-- Dynamic Components -->
    {% for component in components %}
        {% if component.drop_zone == '110' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <div class="container">
        <!-- Page Header -->
        <div class="page-header" id="section-110">
            <h1 class="page-title" id="section-111">{{ text_contents.78|default:"Your Wishlist" }}</h1>
            <p class="wishlist-subtitle" id="section-112">{{ text_contents.79|default:"Save your favorite gaming gear for later" }}</p>
        </div>

        {% if wishlist and wishlist.items.all %}
        <!-- Wishlist Stats -->
        <div class="wishlist-stats" id="section-113">
            <div class="stat-card" id="section-114">
                <div class="stat-number" id="section-115">{{ wishlist_items|length|default:"0" }}</div>
                <div class="stat-label" id="section-116">{{ text_contents.81|default:"Items Saved" }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ wishlist_items|length|default:"0" }}</div>
                <div class="stat-label">{{ text_contents.83|default:"On Sale" }}</div>
            </div>
            <div class="stat-card">
                <div class="stat-number">{{ wish_price_total|currency:page|default:"$0" }}</div>
                <div class="stat-label">{{ text_contents.85|default:"Total Value" }}</div>
            </div>
        </div>

        <!-- Wishlist Controls -->
        <div class="wishlist-controls" id="section-117">
            <div class="filter-buttons">
                <button class="filter-btn active" id="section-118">{{ text_contents.82|default:"All Items" }}</button>
                <button class="filter-btn" id="section-119">{{ text_contents.83|default:"On Sale" }}</button>
                <button class="filter-btn" id="section-120">{{ text_contents.84|default:"In Stock" }}</button>
                <button class="filter-btn" id="section-121">{{ text_contents.85|default:"New Arrivals" }}</button>
            </div>
            <button class="clear-wishlist-btn" id="section-122">
                <i class="fas fa-trash-alt"></i> {{ text_contents.86|default:"Clear All" }}
            </button>
        </div>

        <!-- Wishlist Grid -->
        <div class="wishlist-grid" id="wishlistGrid">
            {% for item in wishlist_items %}
                {% with product=item.product %}
                <div class="wishlist-card" 
                     data-product-id="{{ product.id }}"
                     data-product-title="{{ product.title }}"
                     data-product-price="{{ product.price }}"
                     data-category="{{ product.category.name|default:'accessories'|slugify }}"
                     data-stock="in-stock"
                     {% if product.discount_percentage %}data-sale="true"{% endif %}>
                    {% if product.main_image %}
                        <img class="wishlist-image" src="{{ product.main_image.url }}" alt="{{ product.title }}">
                    {% else %}
                        <div class="wishlist-image" style="background: var(--color-slate); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-gamepad" style="font-size: 3rem; color: var(--color-emerald-teal); opacity: 0.5;"></i>
                        </div>
                    {% endif %}
                    {% if product.discount_percentage %}
                        <div class="wishlist-badge">Sale -{{ product.discount_percentage }}%</div>
                    {% elif forloop.counter == 1 %}
                        <div class="wishlist-badge">Best Seller</div>
                    {% elif forloop.counter == 3 %}
                        <div class="wishlist-badge">New</div>
                    {% endif %}
                    <div class="wishlist-info">
                        <div class="wishlist-category" id="section-124">{{ product.category.name|default:"ACCESSORIES" }}</div>
                        <div class="wishlist-name" id="section-125">{{ product.title }}</div>
                        <div class="wishlist-price" id="section-126">
                            {{ product.price|currency:page }}
                            {% if product.compare_at_price and product.compare_at_price > product.price %}
                                <span style="text-decoration: line-through; font-size: 0.9rem; color: rgba(202, 233, 234, 0.5); margin-left: 8px;">
                                    {{ product.compare_at_price|currency:page }}
                                </span>
                            {% endif %}
                        </div>
                        <div class="wishlist-actions">
                            <button class="add-to-cart-wishlist" data-add-to-cart="{{ product.id }}" id="section-127">
                                <i class="fas fa-shopping-cart"></i> {{ text_contents.90|default:"Add to Cart" }}
                            </button>
                            <button class="remove-wishlist" data-remove-from-wishlist="{{ product.id }}">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </div>
                {% endwith %}
            {% endfor %}
        </div>

        <!-- Recently Viewed Section -->
        <div class="recently-viewed" id="section-128">
            <h2 id="section-129">{{ text_contents.91|default:"Recently Viewed" }}</h2>
            {% if recently_viewed_products %}
            <div class="recently-viewed-grid">
                {% for rvp in recently_viewed_products|slice:":4" %}
                    {% with product=rvp.product %}
                    <a href="/product/{{ product.slug }}/" class="recent-product">
                        {% if product.main_image %}
                            <img class="recent-product-image" src="{{ product.main_image.url }}" alt="{{ product.title }}">
                        {% else %}
                            <div class="recent-product-image" style="background: var(--color-slate); display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-gamepad" style="font-size: 2rem; color: var(--color-emerald-teal); opacity: 0.5;"></i>
                            </div>
                        {% endif %}
                        <div class="recent-product-info">
                            <div class="recent-product-name" id="section-131">{{ product.title|truncatechars:30 }}</div>
                            <div class="recent-product-price" id="section-132">{{ product.price|currency:page }}</div>
                        </div>
                    </a>
                    {% endwith %}
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-recent">
                <i class="fas fa-history"></i>
                <p>{{ text_contents.95|default:"No recently viewed products. Browse our collection to see items here." }}</p>
            </div>
            {% endif %}
        </div>
        
        {% else %}
        <!-- Empty Wishlist State -->
        <div class="empty-wishlist">
            <div class="empty-wishlist-icon">
                <i class="far fa-heart"></i>
            </div>
            <h2>{{ text_contents.92|default:"Your Wishlist is Empty" }}</h2>
            <p>{{ text_contents.93|default:"Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready." }}</p>
            <a href="?page=products" class="shop-now-wishlist">{{ text_contents.94|default:"Start Shopping" }}</a>
        </div>

        <!-- Recently Viewed Section (even when wishlist is empty) -->
        <div class="recently-viewed" id="section-128">
            <h2 id="section-129">{{ text_contents.91|default:"Recently Viewed" }}</h2>
            {% if recently_viewed_products %}
            <div class="recently-viewed-grid">
                {% for rvp in recently_viewed_products|slice:":4" %}
                    {% with product=rvp.product %}
                    <a href="/product/{{ product.slug }}/" class="recent-product">
                        {% if product.main_image %}
                            <img class="recent-product-image" src="{{ product.main_image.url }}" alt="{{ product.title }}">
                        {% else %}
                            <div class="recent-product-image" style="background: var(--color-slate); display: flex; align-items: center; justify-content: center;">
                                <i class="fas fa-gamepad" style="font-size: 2rem; color: var(--color-emerald-teal); opacity: 0.5;"></i>
                            </div>
                        {% endif %}
                        <div class="recent-product-info">
                            <div class="recent-product-name">{{ product.title|truncatechars:30 }}</div>
                            <div class="recent-product-price">{{ product.price|currency:page }}</div>
                        </div>
                    </a>
                    {% endwith %}
                {% endfor %}
            </div>
            {% else %}
            <div class="empty-recent">
                <i class="fas fa-history"></i>
                <p>{{ text_contents.95|default:"No recently viewed products. Browse our collection to see items here." }}</p>
            </div>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce21/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}
    
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    
    <script>
        // Wishlist Filtering
        let currentFilter = 'all';
        
        function filterWishlistItems() {
            const items = document.querySelectorAll('.wishlist-card');
            let visibleCount = 0;
            
            items.forEach(item => {
                let shouldShow = true;
                const isOnSale = item.hasAttribute('data-sale');
                const isNew = item.querySelector('.wishlist-badge')?.textContent.includes('New');
                const category = item.getAttribute('data-category');
                
                switch(currentFilter) {
                    case 'on-sale':
                        shouldShow = isOnSale;
                        break;
                    case 'in-stock':
                        shouldShow = true;
                        break;
                    case 'new-arrivals':
                        shouldShow = isNew;
                        break;
                    case 'all-items':
                    default:
                        shouldShow = true;
                }
                
                if (shouldShow) {
                    item.style.display = 'block';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });
            
            const wishlistGrid = document.getElementById('wishlistGrid');
            const existingEmpty = wishlistGrid?.querySelector('.empty-filter-message');
            
            if (visibleCount === 0 && items.length > 0) {
                if (!existingEmpty) {
                    const emptyMsg = document.createElement('div');
                    emptyMsg.className = 'empty-filter-message';
                    emptyMsg.style.cssText = 'text-align: center; padding: 60px; background: rgba(60, 71, 72, 0.2); border-radius: 28px; grid-column: 1 / -1;';
                    emptyMsg.innerHTML = `
                        <i class="fas fa-filter" style="font-size: 3rem; color: var(--color-emerald-teal); opacity: 0.5; margin-bottom: 16px;"></i>
                        <p style="color: rgba(202, 233, 234, 0.7);">No items match your filter. Try selecting a different category.</p>
                    `;
                    wishlistGrid.appendChild(emptyMsg);
                }
            } else if (existingEmpty) {
                existingEmpty.remove();
            }
        }
        
        // Filter Buttons
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentFilter = this.textContent.toLowerCase().replace(/[-\s]/g, '-');
                filterWishlistItems();
            });
        });
        
        // Remove from Wishlist
        document.querySelectorAll('.remove-wishlist').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const productId = this.getAttribute('data-remove-from-wishlist');
                if (window.cartManager) {
                    window.cartManager.removeFromWishlist(productId);
                }
                const wishlistCard = this.closest('.wishlist-card');
                wishlistCard.remove();
                location.reload();
            });
        });
        
        // Clear All Wishlist
        document.querySelector('.clear-wishlist-btn')?.addEventListener('click', function() {
            if (window.cartManager) {
                window.cartManager.clearWishlist();
            }
        });
        
        // Add to Cart from Wishlist
        document.querySelectorAll('.add-to-cart-wishlist').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const productId = this.getAttribute('data-add-to-cart');
                if (window.cartManager) {
                    window.cartManager.addToCart(productId, 1);
                }
            });
        });
        
        // Initialize filtering
        filterWishlistItems();
    </script>
</body>
</html>