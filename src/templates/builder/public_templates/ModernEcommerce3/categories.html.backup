<!-- builder/public_templates/ModernEcommerce14/categories.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Collections | SARTOR</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300&family=Montserrat:wght@200;400;700&display=swap" rel="stylesheet">
    
    {% render_icon_data icon_customizations %}
    
    <style>
        :root {
            --olive-drab: #626616; 
            --brass-leaf: #e2a970; 
            --raw-silk: #fbca8a;   
            --obsidian: #0d0d0d;   
            --charcoal: #1a1a1a;   
            --white: #ffffff;
            --ease-cinematic: cubic-bezier(0.9, 0, 0.1, 1);
        }

        {% generate_color_variables %}

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--obsidian);
            color: var(--white);
            font-family: 'Montserrat', sans-serif;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            padding-top: 140px;
        }

        /* --- PAGE HEADER --- */
        .categories-header {
            padding: 6rem 5% 4rem;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .categories-header h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(3rem, 6vw, 5rem);
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            letter-spacing: 4px;
        }

        .categories-header p {
            color: rgba(255,255,255,0.6);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.8;
            font-weight: 200;
        }

        /* --- FEATURED COLLECTION --- */
        .featured-collection {
            padding: 6rem 5%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .featured-image {
            position: relative;
            overflow: hidden;
            aspect-ratio: 4/5;
        }

        .featured-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 1.2s var(--ease-cinematic);
            filter: grayscale(40%);
        }

        .featured-collection:hover .featured-image img {
            transform: scale(1.05);
            filter: grayscale(0%);
        }

        .featured-content {
            padding: 2rem;
        }

        .featured-label {
            font-size: 0.7rem;
            letter-spacing: 5px;
            color: var(--olive-drab);
            text-transform: uppercase;
            margin-bottom: 1.5rem;
            display: block;
        }

        .featured-content h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3.5rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1.5rem;
            line-height: 1.1;
        }

        .featured-description {
            color: rgba(255,255,255,0.7);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 2.5rem;
            font-weight: 200;
        }

        .featured-link {
            display: inline-flex;
            align-items: center;
            gap: 1rem;
            color: var(--brass-leaf);
            text-decoration: none;
            font-size: 0.8rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: 0.3s;
            border-bottom: 1px solid transparent;
            padding-bottom: 0.3rem;
        }

        .featured-link:hover {
            gap: 1.5rem;
            border-bottom-color: var(--brass-leaf);
        }

        /* --- CATEGORIES GRID --- */
        .categories-grid-section {
            padding: 6rem 5%;
        }

        .section-intro {
            text-align: center;
            margin-bottom: 5rem;
        }

        .section-intro h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.8rem;
            font-weight: 300;
            color: var(--raw-silk);
            margin-bottom: 1rem;
        }

        .section-intro p {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 3rem;
        }

        .category-card {
            position: relative;
            text-decoration: none;
            color: inherit;
            display: block;
            overflow: hidden;
            background-color: var(--charcoal);
            aspect-ratio: 3/4;
        }

        .category-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.8s var(--ease-cinematic);
            filter: grayscale(50%);
        }

        .category-card:hover .category-image {
            transform: scale(1.08);
            filter: grayscale(0%);
        }

        .category-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(13,13,13,0.9), rgba(13,13,13,0.3));
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 2.5rem;
            transition: 0.5s ease;
        }

        .category-card:hover .category-overlay {
            background: linear-gradient(to top, rgba(98,98,22,0.9), rgba(98,98,22,0.4));
        }

        .category-icon {
            font-size: 2.5rem;
            color: var(--brass-leaf);
            margin-bottom: 1rem;
            transition: 0.3s;
        }

        .category-card:hover .category-icon {
            transform: translateY(-5px);
            color: var(--raw-silk);
        }

        .category-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 300;
            color: var(--white);
            margin-bottom: 0.5rem;
            transition: 0.3s;
        }

        .category-count {
            color: rgba(255,255,255,0.7);
            font-size: 0.8rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: 0.3s;
        }

        .category-card:hover .category-count {
            color: var(--white);
        }

        /* --- COLLECTION SHOWCASE --- */
        .collection-showcase {
            padding: 6rem 5%;
            background: linear-gradient(to right, rgba(98, 98, 22, 0.1), transparent);
            border-top: 1px solid rgba(255,255,255,0.03);
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .showcase-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 4rem;
        }

        .showcase-header h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            font-weight: 300;
            color: var(--raw-silk);
        }

        .showcase-header a {
            color: var(--brass-leaf);
            text-decoration: none;
            font-size: 0.8rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .showcase-header a:hover {
            color: var(--white);
            gap: 1.2rem;
        }

        .showcase-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .showcase-item {
            text-decoration: none;
            color: inherit;
            transition: 0.3s;
        }

        .showcase-item:hover {
            transform: translateY(-5px);
        }

        .showcase-image {
            aspect-ratio: 1/1;
            overflow: hidden;
            background-color: var(--charcoal);
            margin-bottom: 1.5rem;
            border-radius: 50%;
        }

        .showcase-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s var(--ease-cinematic);
            filter: grayscale(40%);
        }

        .showcase-item:hover .showcase-image img {
            transform: scale(1.1);
            filter: grayscale(0%);
        }

        .showcase-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 300;
            color: var(--white);
            margin-bottom: 0.3rem;
            text-align: center;
        }

        .showcase-subtitle {
            color: rgba(255,255,255,0.5);
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-align: center;
            text-transform: uppercase;
        }

        /* --- SEASONAL EDITORIAL --- */
        .editorial-section {
            padding: 6rem 5%;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 3rem;
        }

        .editorial-card {
            position: relative;
            overflow: hidden;
            aspect-ratio: 16/9;
            text-decoration: none;
            color: inherit;
        }

        .editorial-card.large {
            aspect-ratio: 16/10;
        }

        .editorial-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.8s var(--ease-cinematic);
            filter: grayscale(40%);
        }

        .editorial-card:hover .editorial-image {
            transform: scale(1.05);
            filter: grayscale(0%);
        }

        .editorial-content {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            padding: 2.5rem;
            background: linear-gradient(to top, rgba(13,13,13,0.9), transparent);
        }

        .editorial-tag {
            font-size: 0.6rem;
            letter-spacing: 4px;
            color: var(--brass-leaf);
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            display: block;
        }

        .editorial-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 300;
            color: var(--white);
            margin-bottom: 0.3rem;
        }

        .editorial-subtitle {
            color: rgba(255,255,255,0.7);
            font-size: 0.8rem;
        }

        /* --- EMPTY STATE --- */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 6rem;
            background: rgba(255,255,255,0.02);
            border: 1px solid rgba(255,255,255,0.03);
        }

        .empty-state i {
            font-size: 4rem;
            color: var(--olive-drab);
            margin-bottom: 2rem;
            opacity: 0.5;
        }

        .empty-state h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            color: var(--raw-silk);
            margin-bottom: 1rem;
            font-weight: 300;
        }

        .empty-state p {
            color: rgba(255,255,255,0.5);
            margin-bottom: 2rem;
        }

        .empty-state a {
            color: var(--brass-leaf);
            text-decoration: none;
            border-bottom: 1px solid var(--brass-leaf);
            padding-bottom: 2px;
        }

        /* --- RESPONSIVE --- */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .showcase-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .featured-collection {
                grid-template-columns: 1fr;
                gap: 2rem;
            }
            .editorial-section {
                grid-template-columns: 1fr;
            }
            .showcase-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 120px;
            }

            .categories-grid {
                grid-template-columns: 1fr;
            }

            .showcase-grid {
                grid-template-columns: 1fr;
            }

            .featured-content h2 {
                font-size: 2.5rem;
            }

            .categories-header h1 {
                font-size: 2.5rem;
            }
        }

        @media (max-width: 576px) {
            .featured-content {
                padding: 1rem 0;
            }

            .category-overlay {
                padding: 1.5rem;
            }

            .category-title {
                font-size: 1.5rem;
            }

            .editorial-title {
                font-size: 1.3rem;
            }
        }

        {% generate_section_styles style_customizations 109 150 %}
        {% generate_background_images background_images 109 150 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body>
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce14/snippets/header1.html' %}

    {% for component in components %}
        {% if component.drop_zone == '109' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Categories Header -->
    <div class="categories-header" id="section-109">
        <h1 id="section-110">{{ text_contents.82|default:"The Collections" }}</h1>
        <p id="section-111">{{ text_contents.83|default:"Curated expressions of craftsmanship, heritage, and modern authority. Each collection tells a distinct story." }}</p>
    </div>

    {% if categories %}
    <!-- Featured Collection (first category as featured if exists) -->
    {% with featured=categories.0 %}
    <div class="featured-collection" id="section-112">
        <div class="featured-image">
            <img src="{% if featured.image %}{{ featured.image.url }}{% else %}https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&q=80&w=1200{% endif %}" 
                 alt="{{ featured.name }}" 
                 class="editable-image" 
                 data-image="15">
        </div>
        <div class="featured-content">
            <span class="featured-label" id="section-113">{{ text_contents.84|default:"Signature Series" }}</span>
            <h2 id="section-114">{{ text_contents.85|default:featured.name }}</h2>
            <p class="featured-description" id="section-115">{{ text_contents.86|default:featured.description|truncatewords:30 }}</p>
            <a href="?page=shop&category={{ featured.slug }}" class="featured-link">
                Explore Collection <i class="fa-regular fa-arrow-right" data-icon="13"></i>
            </a>
        </div>
    </div>
    {% endwith %}

    <!-- Categories Grid -->
    <div class="categories-grid-section">
        <div class="section-intro">
            <h2 id="section-116">{{ text_contents.87|default:"Browse by Category" }}</h2>
            <p id="section-117">{{ text_contents.88|default:"Discover our complete range of offerings" }}</p>
        </div>

        <div class="categories-grid">
            {% for category in categories %}
                {% if forloop.first %}
                <!-- Editable Category (first) -->
                <a href="?page=shop&category={{ category.slug }}" class="category-card" id="section-118">
                    <img src="{% if category.image %}{{ category.image.url }}{% else %}https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&q=80&w=800{% endif %}" 
                         alt="{{ category.name }}" 
                         class="category-image editable-image" 
                         data-image="16">
                    <div class="category-overlay">
                        <div class="category-icon"><i class="{{ category.icon|default:'fa-regular fa-shirt' }}" data-icon="19"></i></div>
                        <h3 class="category-title" id="section-122">{{ text_contents.89|default:category.name }}</h3>
                        <span class="category-count" id="section-123">{{ text_contents.90|default:category.product_count|default:"0" }} pieces</span>
                    </div>
                </a>
                {% else %}
                <!-- Non-editable Categories -->
                <a href="?page=shop&category={{ category.slug }}" class="category-card">
                    <img src="{% if category.image %}{{ category.image.url }}{% else %}
                        {% cycle 'https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?auto=format&fit=crop&q=80&w=800' 'https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&q=80&w=800' 'https://images.unsplash.com/photo-1556306535-0f09c5378310?auto=format&fit=crop&q=80&w=800' 'https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&q=80&w=800' 'https://images.unsplash.com/photo-1603252109366-409b4c5c6bf0?auto=format&fit=crop&q=80&w=800' as category_image %}
                        {{ category_image }}
                        {% endcycle %}
                    {% endif %}" 
                         alt="{{ category.name }}" 
                         class="category-image">
                    <div class="category-overlay">
                        <div class="category-icon"><i class="{{ category.icon|default:'fa-regular fa-star' }}" data-icon="{% cycle '20' '21' '22' '23' '24' %}"></i></div>
                        <h3 class="category-title">{{ category.name }}</h3>
                        <span class="category-count">{{ category.product_count|default:"0" }} pieces</span>
                    </div>
                </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>

    <!-- Collection Showcase (if collections exist) -->
    {% if collections %}
    <div class="collection-showcase" id="section-119">
        <div class="showcase-header">
            <h2 id="section-120">{{ text_contents.91|default:"Curated Selections" }}</h2>
            <a href="?page=shop">View All <i class="fa-regular fa-arrow-right" data-icon="13"></i></a>
        </div>

        <div class="showcase-grid">
            {% for collection in collections|slice:":4" %}
                {% if forloop.first %}
                <!-- Editable Showcase Item (first) -->
                <a href="?page=shop&collection={{ collection.slug }}" class="showcase-item" id="section-124">
                    <div class="showcase-image">
                        <img src="{% if collection.image %}{{ collection.image.url }}{% else %}https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&q=80&w=400{% endif %}" 
                             alt="{{ collection.name }}"
                             class="editable-image"
                             data-image="17">
                    </div>
                    <h3 class="showcase-title" id="section-125">{{ text_contents.92|default:collection.name }}</h3>
                    <div class="showcase-subtitle" id="section-126">{{ text_contents.93|default:collection.subtitle|default:"Est. 2024" }}</div>
                </a>
                {% else %}
                <!-- Non-editable Showcase Items -->
                <a href="?page=shop&collection={{ collection.slug }}" class="showcase-item">
                    <div class="showcase-image">
                        <img src="{% if collection.image %}{{ collection.image.url }}{% else %}
                            {% cycle 'https://images.unsplash.com/photo-1593032465175-481ac7f401a0?auto=format&fit=crop&q=80&w=400' 'https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?auto=format&fit=crop&q=80&w=400' 'https://images.unsplash.com/photo-1603252109366-409b4c5c6bf0?auto=format&fit=crop&q=80&w=400' as showcase_image %}
                            {{ showcase_image }}
                            {% endcycle %}
                        {% endif %}" 
                             alt="{{ collection.name }}">
                    </div>
                    <h3 class="showcase-title">{{ collection.name }}</h3>
                    <div class="showcase-subtitle">{{ collection.subtitle|default:"The Collection" }}</div>
                </a>
                {% endif %}
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Seasonal Editorial (if editorials exist) -->
    {% if editorials %}
    <div class="editorial-section" id="section-121">
        {% for editorial in editorials|slice:":2" %}
            {% if forloop.first %}
            <a href="?page=shop&collection={{ editorial.slug }}" class="editorial-card large">
                <img src="{% if editorial.image %}{{ editorial.image.url }}{% else %}https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&q=80&w=1200{% endif %}" 
                     alt="{{ editorial.title }}" 
                     class="editorial-image editable-image" 
                     data-image="18">
                <div class="editorial-content">
                    <span class="editorial-tag" id="section-127">{{ text_contents.94|default:editorial.tag|default:"New Season" }}</span>
                    <h3 class="editorial-title" id="section-128">{{ text_contents.95|default:editorial.title }}</h3>
                    <div class="editorial-subtitle" id="section-129">{{ text_contents.96|default:editorial.subtitle|default:"Lightness of Being" }}</div>
                </div>
            </a>
            {% else %}
            <a href="?page=shop&collection={{ editorial.slug }}" class="editorial-card">
                <img src="{% if editorial.image %}{{ editorial.image.url }}{% else %}https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?auto=format&fit=crop&q=80&w=800{% endif %}" 
                     alt="{{ editorial.title }}" 
                     class="editorial-image editable-image" 
                     data-image="19">
                <div class="editorial-content">
                    <span class="editorial-tag" id="section-130">{{ text_contents.97|default:editorial.tag|default:"Made to Measure" }}</span>
                    <h3 class="editorial-title" id="section-131">{{ text_contents.98|default:editorial.title }}</h3>
                    <div class="editorial-subtitle" id="section-132">{{ text_contents.99|default:editorial.subtitle|default:"Your silhouette, your rules" }}</div>
                </div>
            </a>
            {% endif %}
        {% endfor %}
    </div>
    {% endif %}

    {% else %}
    <!-- Empty State -->
    <div class="categories-grid-section">
        <div class="empty-state">
            <i class="fa-regular fa-grid-2" data-icon="25"></i>
            <h3>No Collections Yet</h3>
            <p>Your collections are waiting to be curated. <a href="/admin/add-category">Create your first category</a> to showcase your offerings.</p>
        </div>
    </div>
    {% endif %}

    {% for component in components %}
        {% if component.drop_zone == '121' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce14/snippets/footer.html' %}

    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}

    {% render_icon_script %}

    <script src="{% static 'builder/js/cart-manager.js' %}"></script>

    <script>
        // Optional: Add hover effects or animations
        document.querySelectorAll('.category-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                const icon = this.querySelector('.category-icon i');
                if (icon) {
                    icon.style.transition = 'transform 0.3s ease';
                }
            });
        });

        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
</body>
</html>