{%load static%}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop | {{page.brand_name}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        {% generate_color_variables %}
        
        /* Dynamic Section Styles for Shop Page */
        {% generate_section_styles style_customizations 0 106 %}
        
        /* Dynamic Background Images for Shop Page */
        {% generate_background_images background_images 0 106 %}
        {% generate_hover_keyframes %}
        
        /* Rest of the CSS remains the same as above */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Shop Hero Section */
        .shop-hero#section-91 {
            padding: 180px 0 100px;
            background: linear-gradient(135deg, rgba(187, 194, 182, 0.1) 0%, rgba(239, 236, 228, 0.05) 100%);
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        
        .shop-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%2362664b' fill-opacity='0.03' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.3;
            z-index: 0;
        }
        
        .shop-hero-content {
            position: relative;
            z-index: 1;
        }
        
        .shop-hero h1#section-92 {
            font-size: 64px;
            line-height: 1.1;
            margin-bottom: 20px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .shop-hero p#section-93 {
            font-size: 18px;
            line-height: 1.6;
            color: var(--primary-dark);
            font-weight: 300;
            max-width: 600px;
            margin: 0 auto 40px;
        }
        
        /* Filters Section */
        .shop-filters#section-94 {
            padding: 40px 0;
            background-color: var(--primary-light);
            border-bottom: 1px solid rgba(187, 194, 182, 0.3);
        }
        
        .filters-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        
        .filter-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .filter-label#section-95 {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .filter-select {
            padding: 12px 24px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            font-family: var(--font-sans);
            font-size: 14px;
            border-radius: 2px;
            min-width: 180px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .filter-select:hover {
            border-color: var(--primary-accent);
        }
        
        .filter-select:focus {
            outline: none;
            border-color: var(--primary-accent);
        }
        
        .total-products#section-98 {
            font-size: 14px;
            color: var(--primary-accent);
            font-weight: 400;
        }
        
        /* Products Grid Section */
        .shop-products#section-99 {
            padding: 80px 0 120px;
            background-color: var(--primary-light);
        }
        
        .products-grid-shop {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }
        
        .product-card-shop {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            position: relative;
        }
        
        .product-card-shop:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(98, 102, 75, 0.1);
        }
        
        .product-img-shop {
            height: 350px;
            width: 100%;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .product-info-shop {
            padding: 25px;
        }
        
        .product-category-shop {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-accent);
            margin-bottom: 8px;
            font-weight: 400;
        }
        
        .product-name-shop {
            font-size: 20px;
            margin-bottom: 10px;
            font-weight: 500;
            font-family: var(--font-serif);
            color: var(--primary-dark);
        }
        
        .product-description-shop {
            font-size: 14px;
            line-height: 1.5;
            color: var(--primary-dark);
            margin-bottom: 15px;
            font-weight: 300;
            opacity: 0.8;
        }
        
        .product-price-shop {
            font-size: 20px;
            font-weight: 500;
            color: var(--primary-dark);
            margin-bottom: 20px;
        }
        
        .product-actions-shop {
            display: flex;
            gap: 10px;
        }
        
        .btn-add-to-cart {
            flex: 1;
            padding: 12px 20px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .btn-add-to-cart:hover {
            background-color: var(--primary-dark);
        }
        
        .btn-wishlist-shop {
            width: 44px;
            height: 44px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .btn-wishlist-shop:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        .product-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            padding: 6px 12px;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            z-index: 2;
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid-shop {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .shop-hero h1#section-92 {
                font-size: 56px;
            }
        }
        
        @media (max-width: 992px) {
            .products-grid-shop {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .filters-container {
                flex-direction: column;
                align-items: flex-start;
                gap: 25px;
            }
            
            .shop-hero h1#section-92 {
                font-size: 48px;
            }
            
            .shop-hero {
                padding: 160px 0 80px;
            }
        }
        
        @media (max-width: 768px) {
            .shop-hero h1#section-92 {
                font-size: 40px;
            }
            
            .shop-hero p#section-93 {
                font-size: 16px;
            }
            
            .filter-group {
                width: 100%;
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
            
            .filter-select {
                width: 100%;
                min-width: unset;
            }
            
            .product-img-shop {
                height: 300px;
            }
        }
        
        @media (max-width: 576px) {
            .products-grid-shop {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            
            .shop-hero {
                padding: 140px 0 60px;
            }
            
            .shop-products {
                padding: 60px 0 100px;
            }
        }
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
    {%include 'builder/public_templates/ModernEcommerce2/snippets/header.html'%}


    <!-- Shop Hero Section -->
    <section class="shop-hero" id="section-91">
        <div class="container shop-hero-content">
            <h1 id="section-92">{{ text_contents.64|default:"Discover Our Collection" }}</h1>
            <p id="section-93">{{ text_contents.65|default:"Explore our curated selection of luxury fashion pieces, meticulously crafted for timeless elegance and exceptional quality." }}</p>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '91' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    <!-- Filters Section -->
    <section class="shop-filters" id="section-94">
        <div class="container">
            <div class="filters-container">
                <div class="filter-group">
                    <span class="filter-label" id="section-95">{{ text_contents.66|default:"Sort By" }}</span>
                    <select class="filter-select">
                        <option value="featured">Featured</option>
                        <option value="newest">Newest Arrivals</option>
                        <option value="price-low">Price: Low to High</option>
                        <option value="price-high">Price: High to Low</option>
                        <option value="popular">Most Popular</option>
                    </select>
                </div>
                
                <div class="filter-group">
                    <span class="filter-label" id="section-96">{{ text_contents.67|default:"Category" }}</span> |
                    <!-- <select class="filter-select"> -->
                        <!-- <option value="all">All Categories</option>
                        {%for product in products%}
                        <option value="{{product.category}}">{{product.category}}</option>
                        {%endfor%} -->
                        <a href="?page=categories"><option value="all">See All</option></a>
                    <!-- </select> -->
                </div>
                
                <div class="filter-group">
                    <span class="filter-label" id="section-97">{{ text_contents.68|default:"Size" }}</span>
                    <select class="filter-select">
                        <option value="all">All Sizes</option>
                        <option value="xs">XS</option>
                        <option value="s">S</option>
                        <option value="m">M</option>
                        <option value="l">L</option>
                        <option value="xl">XL</option>
                    </select>
                </div>
                
                <div class="total-products" id="section-98">{{products.count}} {{ text_contents.69|default:"Products" }}</div>
            </div>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '94' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    <!-- Products Grid Section -->
    <section class="shop-products" id="section-99">
        <div class="container">
            <div class="products-grid-shop">
                <!-- Products will be populated from backend in a loop -->
                {% for product in products %}
                <a href="/product/{{ product.slug }}/" class="product-image-link">
                <div class=" product-card-shop {% if forloop.first %}id="section-100"{% endif %}"

                    data-product-id="{{ product.id }}"
                    data-product-title="{{ product.title }}"
                    data-product-price="{{ product.price }}"
                    data-product-image="{% if product.main_image %}{{ product.main_image.url }}{% endif %}"
                >
                    {% if forloop.first %}
                    <div class="product-badge" id="section-101">{{ text_contents.70|default:"New" }}</div>
                    {% elif product.badge %}
                    <div class="product-badge">{{ product.badge }}</div>
                    {% endif %}
                    
                    {% if product.main_image %}
                    <img src="{{ product.main_image.url }}" alt="{{ product.title }}" class="product-img-shop">
                    {% else %}
                    <div class="product-img-shop" style="background-color: {% cycle '#BBC2B6' '#EFECE4' '#AB8872' '#62664B' '#BBC2B6' '#EFECE4' '#AB8872' '#62664B' '#BBC2B6' '#EFECE4' '#AB8872' '#62664B' %};"></div>
                    {% endif %}
                    
                    <div class="product-info-shop">
                        <div class="product-category-shop" id="section-102">{{ product.category }}</div>
                        <h3 class="product-name-shop" id="section-103">{{ product.title|truncatewords:10 }}</h3>
                        <p class="product-description-shop" id="section-104">{{ product.description|striptags|truncatewords:10 }}</p>
                        <div class="product-price-shop" id="section-105">{{ product.price|currency:page }}</div>

                        
                        <!-- <div class="product-category-shop" id="section-102">{{ text_contents.71|default:"Tailored Collection" }}</div>
                        <h3 class="product-name-shop" id="section-103">{{ text_contents.72|default:"The Sofia Blazer" }}</h3>
                        <p class="product-description-shop" id="section-104">{{ text_contents.73|default:"Tailored wool-blend blazer with peak lapels and silk lining." }}</p>
                        <div class="product-price-shop" id="section-105">{{ text_contents.74|default:"$485" }}</div> -->
    
                        
                        <div class="product-actions-shop">
                            

                            <button class="btn-add-to-cart" id="section-106" data-add-to-cart="{{ product.id }}">
                                <i class="fas fa-shopping-bag" data-icon="42"></i> {{ text_contents.75|default:"Add to Cart" }}
                            </button>
                            <!-- <button style="color: red;" class="btn btn-primary " data-add-to-cart="{{ product.id }}">
                                Add to Cart
                            </button> -->
                            
                            <button class="btn-wishlist-shop" data-add-to-wishlist="{{ product.id }}">
                                <i class="far fa-heart" data-icon="43"></i>
                            </button>
                        </div>
                    </div>
                </div>
                </a>
                {% empty %}
                <!-- Fallback products when no products from backend -->
                <div class="product-card-shop" id="section-100">
                    <div class="product-badge" id="section-101">{{ text_contents.70|default:"New" }}</div>
                    <div class="product-img-shop" style="background-color: #BBC2B6;"></div>
                    <div class="product-info-shop">
                        <div class="product-category-shop" id="section-102">{{ text_contents.71|default:"Tailored Collection" }}</div>
                        <h3 class="product-name-shop" id="section-103">{{ text_contents.72|default:"The Sofia Blazer" }}</h3>
                        <p class="product-description-shop" id="section-104">{{ text_contents.73|default:"Tailored wool-blend blazer with peak lapels and silk lining." }}</p>
                        <div class="product-price-shop" id="section-105">{{ text_contents.74|default:"$485" }}</div>
                        <div class="product-actions-shop">
                            <button class="btn-add-to-cart" id="section-106">
                                <i class="fas fa-shopping-bag" data-icon="42"></i> {{ text_contents.75|default:"Add to Cart" }}
                            </button>
                            <button class="btn-wishlist-shop">
                                <i class="far fa-heart" data-icon="43"></i>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- Additional fallback products (11 more) -->
                {% for i in "12345678901"|make_list %}
                <div class="product-card-shop">
                    {% with badge_index=forloop.counter %}
                        {% if badge_index == 2 or badge_index == 4 or badge_index == 7 or badge_index == 10 %}
                        <div class="product-badge">
                            {% if badge_index == 2 %}Bestseller{% elif badge_index == 4 %}Limited{% elif badge_index == 7 %}New{% elif badge_index == 10 %}Sale{% endif %}
                        </div>
                        {% endif %}
                    {% endwith %}
                    
                    <div class="product-img-shop" style="background-color: {% cycle '#EFECE4' '#AB8872' '#62664B' '#BBC2B6' '#EFECE4' '#AB8872' '#62664B' '#BBC2B6' '#EFECE4' '#AB8872' '#62664B' %};"></div>
                    <div class="product-info-shop">
                        <div class="product-category-shop">
                            {% cycle 'Evening Wear' 'Outerwear' 'Accessories' 'Tailored Collection' 'Lingerie' 'Daywear' 'Footwear' 'Outerwear' 'Daywear' 'Bottoms' 'Accessories' %}
                        </div>
                        <h3 class="product-name-shop">
                            {% cycle 'Silk Evening Gown' 'Cashmere Wrap Coat' 'Leather Tote Bag' 'Wide-Leg Trousers' 'Silk Camisole' 'Knit Midi Dress' 'Leather Ankle Boots' 'Trench Coat' 'Silk Blouse' 'Leather Skirt' 'Wool Scarf' %}
                        </h3>
                        <p class="product-description-shop">
                            {% cycle 'Flowing silk gown with draped neckline and side slit.' 'Luxury cashmere coat with oversized collar and belt.' 'Italian leather tote with gold hardware and interior pockets.' 'High-waisted trousers in premium wool crepe.' 'Luxury silk camisole with delicate lace trim.' 'Ribbed knit dress with roll neck and side slits.' 'Italian leather boots with block heel and side zip.' 'Classic trench coat in water-resistant cotton.' 'Flowy silk blouse with button front and tie neck.' 'Midi skirt in soft lambskin leather with side zip.' 'Cashmere-wool blend scarf with fringe detail.' %}
                        </p>
                        <div class="product-price-shop">
                            {% cycle '$920' '$750' '$395' '$280' '$165' '$320' '$450' '$590' '$245' '$385' '$185' %}
                        </div>
                        <div class="product-actions-shop">
                            <button class="btn-add-to-cart">
                                <i class="fas fa-shopping-bag"></i> Add to Cart
                            </button>
                            <button class="btn-wishlist-shop">
                                <i class="far fa-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
                {% endfor %}
                {% endfor %}
            </div>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '99' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    {%include 'builder/public_templates/ModernEcommerce2/snippets/footer.html'%}

    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>

    <!-- Below is the default cart functionality. Don't touch or alter it. Make sure that it keeps functioning even with the integrated cart. Every products/shop page i will provide you has one. -->
    <script>
        // Add to Cart Functionality
        // Product Card Animation on Scroll
        const productCards = document.querySelectorAll('.product-card-shop');
        
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, {
            threshold: 0.1
        });
        
        // Set initial state for animation
        productCards.forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            observer.observe(card);
        });
        
        // Filter functionality (simulated)
        document.querySelectorAll('.filter-select').forEach(select => {
            select.addEventListener('change', function() {
                // In a real implementation, you would filter products via AJAX
                console.log(`Filter changed: ${this.value}`);
            });
        });
    </script>
</body>
</html>