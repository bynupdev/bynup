{%load static%}
{% load style_filters %}
{%load color_filters%}
{% load currency_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | {{page.brand_name}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        {% generate_color_variables %}
        
        /* Dynamic Section Styles for Cart Page */
        {% generate_section_styles style_customizations 135 153 %}
        
        /* Dynamic Background Images for Cart Page */
        {% generate_background_images background_images 135 153 %}
        {% generate_hover_keyframes %}
        
        /* Rest of the CSS remains the same as above */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Cart Hero Section */
        .cart-hero#section-135 {
            padding: 160px 0 60px;
            background: linear-gradient(135deg, rgba(187, 194, 182, 0.05) 0%, rgba(239, 236, 228, 0.02) 100%);
            text-align: center;
        }
        
        .cart-hero h1#section-136 {
            font-size: 48px;
            line-height: 1.1;
            margin-bottom: 15px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .cart-hero p#section-137 {
            font-size: 18px;
            line-height: 1.6;
            color: var(--primary-dark);
            font-weight: 300;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Cart Content */
        .cart-content#section-138 {
            padding: 60px 0 120px;
        }
        
        .cart-container {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 60px;
        }
        
        /* Cart Items Section */
        .cart-items {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }
        
        .cart-item {
            display: grid;
            grid-template-columns: 120px 1fr auto;
            gap: 25px;
            padding: 30px;
            background-color: var(--primary-light);
            border-radius: 5px;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
            transition: all 0.3s ease;
            position: relative;
        }
        
        .cart-item:hover {
            box-shadow: 0 10px 25px rgba(98, 102, 75, 0.1);
            transform: translateY(-2px);
        }
        
        .cart-item-image {
            width: 120px;
            height: 150px;
            object-fit: cover;
            border-radius: 3px;
            background-color: var(--secondary-light);
        }
        
        .cart-item-details {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        
        .cart-item-title#section-139 {
            font-size: 20px;
            font-family: var(--font-serif);
            color: var(--primary-dark);
            margin-bottom: 8px;
            font-weight: 500;
        }
        
        .cart-item-variant {
            font-size: 14px;
            color: var(--primary-accent);
            margin-bottom: 5px;
        }
        
        .cart-item-size, .cart-item-color {
            font-size: 14px;
            color: var(--primary-dark);
            opacity: 0.8;
            margin-bottom: 3px;
        }
        
        .cart-item-actions {
            display: flex;
            gap: 15px;
            margin-top: 15px;
        }
        
        .quantity-selector-cart {
            display: flex;
            align-items: center;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
        }
        
        .quantity-btn-cart {
            width: 36px;
            height: 36px;
            background-color: var(--primary-light);
            color: var(--primary-dark);
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .quantity-input-cart {
            width: 50px;
            height: 36px;
            text-align: center;
            border: none;
            background-color: var(--primary-light);
            color: var(--primary-dark);
            font-size: 16px;
            font-family: var(--font-sans);
        }
        
        .btn-remove-item {
            padding: 8px 16px;
            background-color: transparent;
            color: var(--primary-dark);
            font-size: 14px;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        
        .btn-remove-item:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        .cart-item-price {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-end;
            text-align: right;
        }
        
        .item-price#section-140 {
            font-size: 22px;
            color: var(--primary-dark);
            font-weight: 500;
            margin-bottom: 10px;
        }
        
        .item-subtotal {
            font-size: 14px;
            color: var(--primary-dark);
            opacity: 0.7;
        }
        
        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: 80px 20px;
            background-color: var(--primary-light);
            border-radius: 5px;
            border: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .empty-cart-icon {
            font-size: 64px;
            color: var(--secondary-light);
            margin-bottom: 25px;
        }
        
        .empty-cart-title#section-141 {
            font-size: 28px;
            color: var(--primary-dark);
            margin-bottom: 15px;
            font-weight: 500;
        }
        
        .empty-cart-message#section-142 {
            font-size: 16px;
            color: var(--primary-dark);
            opacity: 0.8;
            margin-bottom: 30px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .btn-continue-shopping#section-143 {
            padding: 14px 30px;
            background-color: var(--primary-dark);
            color: var(--primary-light);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        
        .btn-continue-shopping:hover {
            background-color: var(--primary-accent);
        }
        
        /* Cart Summary */
        .cart-summary {
            background-color: var(--primary-light);
            border-radius: 5px;
            padding: 35px;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
            position: sticky;
            top: 120px;
            height: fit-content;
        }
        
        .summary-title#section-144 {
            font-size: 24px;
            color: var(--primary-dark);
            margin-bottom: 25px;
            font-weight: 500;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(187, 194, 182, 0.3);
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
            font-size: 16px;
            color: var(--primary-dark);
        }
        
        .summary-label {
            opacity: 0.8;
        }
        
        .summary-value {
            font-weight: 500;
        }
        
        .summary-row.total {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(187, 194, 182, 0.3);
            font-size: 20px;
            color: var(--primary-dark);
        }
        
        .summary-row.total .summary-value {
            font-weight: 600;
        }
        
        .shipping-note#section-150 {
            font-size: 14px;
            color: var(--primary-accent);
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(187, 194, 182, 0.2);
            text-align: center;
        }
        
        .btn-checkout#section-153 {
            width: 100%;
            padding: 16px 30px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 16px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            margin-top: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        
        .btn-checkout:hover {
            background-color: var(--primary-dark);
        }
        
        .btn-checkout:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .btn-checkout:disabled:hover {
            background-color: var(--primary-accent);
        }
        
        .payment-methods {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
            opacity: 0.7;
        }
        
        .payment-methods i {
            font-size: 24px;
        }
        
        /* Promo Code Section */
        .promo-code {
            margin-top: 25px;
            padding-top: 25px;
            border-top: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .promo-title#section-151 {
            font-size: 16px;
            color: var(--primary-dark);
            margin-bottom: 12px;
            font-weight: 500;
        }
        
        .promo-form {
            display: flex;
            gap: 10px;
        }
        
        .promo-input {
            flex: 1;
            padding: 12px 16px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            font-family: var(--font-sans);
            font-size: 14px;
            border-radius: 2px;
        }
        
        .promo-input:focus {
            outline: none;
            border-color: var(--primary-accent);
        }
        
        .btn-apply-promo#section-152 {
            padding: 12px 20px;
            background-color: var(--primary-dark);
            color: var(--primary-light);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            white-space: nowrap;
        }
        
        .btn-apply-promo:hover {
            background-color: var(--primary-accent);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .cart-container {
                grid-template-columns: 1fr 350px;
                gap: 40px;
            }
        }
        
        @media (max-width: 992px) {
            .cart-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .cart-summary {
                position: static;
                max-width: 500px;
                margin: 0 auto;
            }
            
            .cart-hero h1#section-136 {
                font-size: 40px;
            }
        }
        
        @media (max-width: 768px) {
            .cart-hero#section-135 {
                padding: 140px 0 40px;
            }
            
            .cart-hero h1#section-136 {
                font-size: 36px;
            }
            
            .cart-hero p#section-137 {
                font-size: 16px;
            }
            
            .cart-content#section-138 {
                padding: 40px 0 80px;
            }
            
            .cart-item {
                grid-template-columns: 100px 1fr;
                gap: 20px;
                padding: 20px;
            }
            
            .cart-item-price {
                grid-column: 1 / -1;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                text-align: left;
                padding-top: 15px;
                border-top: 1px solid rgba(187, 194, 182, 0.2);
            }
            
            .item-price#section-140 {
                margin-bottom: 0;
            }
            
            .cart-item-image {
                width: 100px;
                height: 120px;
            }
        }
        
        @media (max-width: 576px) {
            .cart-item {
                grid-template-columns: 1fr;
            }
            
            .cart-item-image {
                width: 100%;
                height: 200px;
            }
            
            .cart-item-price {
                grid-column: 1;
            }
            
            .cart-summary {
                padding: 25px;
            }
            
            .promo-form {
                flex-direction: column;
            }
            
            .btn-apply-promo#section-152 {
                width: 100%;
            }
            
            .empty-cart {
                padding: 60px 15px;
            }
            
            .empty-cart-title#section-141 {
                font-size: 24px;
            }
        }

        

    .variant-popup {
    background: #fff;
    border-radius: 12px;
    padding: 20px;
    box-shadow: 0 10px 40px rgba(0,0,0,.15);
    }
    .variant-popup ul {
    margin-top: 10px;
    }
    .variant-popup li {
    padding: 6px 0;
    }
    </style>
</head>
<body data-subdomain="{{ page.subdomain }}">
       {%include 'builder/public_templates/ModernEcommerce2/snippets/header.html'%}
    <!-- Cart Hero Section -->
    <section class="cart-hero" id="section-135">
        <div class="container">
            <h1 id="section-136">{{ text_contents.101|default:"Your Shopping Cart" }}</h1>
            <p id="section-137">{{ text_contents.102|default:"Review your selected items and proceed to checkout" }}</p>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '135' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    <!-- Cart Content -->
    <section class="cart-content" id="section-138">
        <div class="container">
            <div class="cart-container">
                <!-- Cart Items -->
                <div class="cart-items">
                    {% if cart and cart.items.all %}
                        {% for item in cart.items.all %}
        
                        <div class="cart-item">
                            
                            <img src="{{ item.product.main_image.url }}" alt="{{ item.product.title }}" class="cart-item-image">
                            
                            
                            <div class="cart-item-details">
                                <h3 class="product-title cart-item-title" id="section-139">
                                    {{ item.product.title|truncatewords:5 }}
                                </h3>
                                <div class="product-description cart-item-variant">{{ item.product.description|striptags|truncatewords:10 }}</div>
                                <div class="product-color cart-item-color">Color: {{ item.selected_color }}</div>
                                <div class="product-size cart-item-size">Size: {{ item.selected_size }}</div>
                                <input class="product-id" type="hidden" value="{{item.product.id}}">
                                <div class="cart-item-actions">
                                    <div class="quantity-selector-cart">
                                        <button class="quantity-btn-cart decrease-btn decrement-cart" data-product-id="{{ item.product.id }}">-</button>
                                        <!-- <input type="text" class="quantity-input-cart cart-item-quantity" value="{{ item.quantity|default:1 }}" readonly data-item-id="{{ item.id|default:0 }}"> -->
                                        <span class="quantity-input mx-2 cart-item-quantity">{{item.quantity}}</span>
                                        <button class="quantity-btn-cart increase-btn increment-cart" data-product-id="{{ item.product.id }}">+</button>
                                    </div>
                                    

                                    <input type="text" class="cj-vid" name="" value="{{item.product.cj_vid}}" id="">
                                    
                                    <button class="btn-remove-item remove-cart-item" data-product-id="{{ item.product.id }}" data-product-id="{{ item.product.id }}">
                                        <i class="far fa-trash-alt" {% if forloop.first %}data-icon="48"{% endif %}></i> Remove
                                    </button>
                                </div>
                            </div>
                            
                            <div class="cart-item-price">
                                <div class="product-price item-price" id="section-140">
                                    {{ item.product.price|currency:page }}
                                </div>
                                <!-- <div class="item-subtotal">
                                    <span>$<span id="cart-total-price">{{ cart.get_total_price }}</span></span>
                                </div> -->
                            </div>
                        </div>
                        {% endfor %}
                    {% else %}
                        <!-- Empty Cart State -->
                        <div class="empty-cart">
                            <div class="empty-cart-icon">
                                <i class="fas fa-shopping-bag" data-icon="49"></i>
                            </div>
                            <h2 id="section-141">{{ text_contents.105|default:"Your Cart is Empty" }}</h2>
                            <p id="section-142">{{ text_contents.106|default:"Looks like you haven't added any items to your cart yet. Start shopping to discover our luxury collection." }}</p>
                            <a href="?page=products" class="btn-continue-shopping" id="section-143">
                                <i class="fas fa-arrow-left" data-icon="50"></i> {{ text_contents.107|default:"Continue Shopping" }}
                            </a>
                        </div>
                    {% endif %}
                </div>
                
                <!-- Cart Summary -->
                <div class="cart-summary">
                    <h2 class="summary-title" id="section-144">{{ text_contents.108|default:"Order Summary" }}</h2>
                    
                    <div class="summary-row">
                        <span class="summary-label" id="section-147">{{ text_contents.111|default:"Items" }}</span>
                        <span class="summary-value" id="cart-total-items tax">{{ cart.items.count }}</span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label" id="section-145">{{ text_contents.109|default:"Subtotal" }}</span>
                        <span class="summary-value" id="subtotal">{{ page.currency_symbol }}<span id="cart-total-price">{{ cart.get_total_price|floatformat:2 }}</span></span>
                    </div>
                    
                    <div class="summary-row">
                        <span class="summary-label" id="section-146">{{ text_contents.110|default:"Shipping" }}</span>
                        <span class="summary-value" id="shipping">
                            Calculated at checkout
                        </span>
                    </div>
                    
                    
                    
                    <div class="summary-row">
                        <span class="summary-label" id="section-148">{{ text_contents.112|default:"Discount" }}</span>
                        <span class="summary-value" id="discount">
                            {% if discount_amount and discount_amount > 0 %}
                                -{{ discount_amount|currency:page }}
                            {% else %}
                                {{ page.currency_symbol }}0.00
                            {% endif %}
                        </span>
                    </div>
                    
                    <div class="summary-row total">
                        <span class="summary-label" id="section-149">{{ text_contents.113|default:"Total" }}</span>
                        <span class="summary-value" id="total">$<span id="cart-grand-total">{{ cart.get_total_price|floatformat:2  }}</span></span>
                    </div>
                    
                    <p class="shipping-note" id="section-150">
                        {% if cart_subtotal and cart_subtotal >= 200 %}
                            ✓ Free shipping applied
                        {% else %}
                            {{ text_contents.114|default:"Free shipping on all orders over $200" }}
                        {% endif %}
                    </p>
                    
                    <!-- Promo Code Section -->
                    <div class="promo-code">
                        <h3 class="promo-title" id="section-151">{{ text_contents.115|default:"Promo Code" }}</h3>
                        <div class="promo-form">
                            <input type="text" class="promo-input" placeholder="Enter code" id="promoInput">
                            <button class="btn-apply-promo" id="section-152">{{ text_contents.116|default:"Apply" }}</button>
                        </div>
                    </div>
                    
                    <button class="cart-checkout-btn btn-checkout" id="section-153" onclick="redirectCartToPaymentSelection()">
                        <i class="fas fa-lock" data-icon="51"></i> {{ text_contents.117|default:"Proceed to Checkout" }}
                    </button>

                    <div class="payment-methods">
                        <i class="fab fa-cc-visa" data-icon="52"></i>
                        <i class="fab fa-cc-mastercard" data-icon="53"></i>
                        <i class="fab fa-cc-amex" data-icon="54"></i>
                        <i class="fab fa-cc-paypal" data-icon="55"></i>
                        <i class="fab fa-apple-pay" data-icon="56"></i>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '138' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

    {%include 'builder/public_templates/ModernEcommerce2/snippets/footer.html'%}

    
    {% for component in components %}
    {% if component.drop_zone == 'end' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    <input type="hidden" value="{{page.subdomain}}" id="page-subdomain">
    <input type="hidden" name="" id="currency_symbol" value="{{ page.currency_symbol }}">
<!-- Scripts -->
 <script>
    
/* ======================================================
   VARIANT DATA (Injected via Django template loop)
====================================================== */
const VARIANTS = [
    {% for variant in variants %}
    {
        product_id: "{{ variant.product_id }}",
        option1: "{{ variant.option1|escapejs }}",
        cj_vid: "{{ variant.cj_vid }}"
    }{% if not forloop.last %},{% endif %}
    {% endfor %}
];


/* ======================================================
   CART BUTTON HANDLERS
====================================================== */
document.addEventListener('DOMContentLoaded', function () {

    document.querySelectorAll('.increment-cart').forEach(btn => {
        btn.addEventListener('click', function () {
            
            window.cartManager?.incrementCartItem(this.dataset.productId, 1);
        });
    });

    document.querySelectorAll('.decrement-cart').forEach(btn => {
        btn.addEventListener('click', function () {
            window.cartManager?.decrementCartItem(this.dataset.productId, 1);
        });
    });

    document.querySelectorAll('.remove-cart-item').forEach(btn => {
        btn.addEventListener('click', function () {
            window.cartManager?.removeFromCart(this.dataset.productId);
        });
    });

    document.getElementById('clearCartBtn')?.addEventListener('click', function () {
        window.cartManager?.clearCart();
    });

});


/* ======================================================
   COLLECT CART DATA
====================================================== */
function getCartData() {

    const items = [];
    let subtotal = 0;

    document.querySelectorAll('.cart-item').forEach(item => {

        const title = item.querySelector('.product-title')?.textContent || '';
        const description = item.querySelector('.product-description')?.textContent || '';
        const currency_symbol = document.getElementById('currency_symbol')?.value || '$';
        const price = parseFloat(
            item.querySelector('.product-price')?.textContent.replace(currency_symbol, '')
        ) || 0;

        const quantity = parseInt(
            item.querySelector('.quantity-input')?.textContent
        ) || 1;

        const selected_color = item.querySelector('.product-color')?.textContent.replace('Color:', '').trim() || '';

        const selected_size = item.querySelector('.product-size')?.textContent.replace('Size:', '').trim() || '';

        const id = item.querySelector('.product-id')?.value;
        const cj_vid = item.querySelector('.cj-vid')?.value || '';

        const total = price * quantity;
        subtotal += total;

        items.push({
            title,
            description,
            id,
            cj_vid,
            price,
            quantity,
            selected_color,
            selected_size,
            total_price: total
        });
    });

    const shipping = subtotal > 0 ? 5.00 : 0;
    const tax = subtotal * 0.08;

    return {
        items,
        subtotal,
        shipping_amount: shipping,
        tax_amount: tax,
        total_amount: subtotal + shipping + tax,
        // is_buy_now: false
    };
}


/* ======================================================
   VARIANT MATCHING (REPLACES cj_vid)
====================================================== */
function resolveVariantCJVID(item) {

    // If product already has no CJ intent, skip everything
    const productVariants = VARIANTS.filter(
        v => String(v.product_id) === String(item.id)
    );

    // No variants OR no CJ_VID in any variant → skip CJ logic
    const hasCJVariants = productVariants.some(v => v.cj_vid && v.cj_vid.trim());

    if (!hasCJVariants) {
        item.cj_vid = ''; // explicitly ensure empty
        return '';
    }

    // If CJ product but user didn’t select variant fully → keep existing cj_vid
    if (!item.selected_color || !item.selected_size) {
        return item.cj_vid;
    }

    const merged = `${item.selected_color}-${item.selected_size}`.toLowerCase();
    const mergedParts = merged.split('-');
    const partCount = mergedParts.length;

    for (let v of productVariants) {
        if (!v.option1 || !v.cj_vid) continue;

        const normalizedOption = v.option1
            .replace(/\//g, '-')
            .replace(/\s*-\s*/g, '-')
            .toLowerCase();

        const optionParts = normalizedOption.split('-');

        if (
            optionParts.length >= partCount &&
            optionParts.slice(-partCount).join('-') === merged
        ) {
            item.cj_vid = v.cj_vid;
            return item.cj_vid;
        }
    }

    // Only CJ products reach here
    showVariantPopup(item, productVariants);
    throw new Error('Variant not found');
}

/* ======================================================
   SMART AVAILABLE OPTIONS POPUP
====================================================== */
function showVariantPopup(item, variants) {

    const colorSet = new Set();
    const sizeSet = new Set();
    const combinations = [];

    variants.forEach(v => {
        if (!v.option1) return;

        const parts = v.option1.split('-');
        if (parts.length < 2) return;

        const color = parts[parts.length - 2];
        const size = parts[parts.length - 1];

        colorSet.add(color);
        sizeSet.add(size);
        combinations.push(`${color}-${size}`);
    });

    const overlay = document.createElement('div');
    overlay.style.cssText = `
        position:fixed;
        inset:0;
        background:rgba(0,0,0,.45);
        z-index:9998;
    `;

    const modal = document.createElement('div');
    modal.style.cssText = `
        position:fixed;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        background:#fff;
        border-radius:14px;
        padding:22px;
        width:90%;
        max-width:440px;
        box-shadow:0 20px 60px rgba(0,0,0,.25);
        z-index:9999;
        font-family:system-ui;
    `;

    modal.innerHTML = `
        <h3 style="margin-top:0">Variant Not Available</h3>
        <p>
            No match for
            <strong>${item.selected_color}-${item.selected_size}</strong>
        </p>

        <p><strong>Available Colors:</strong><br>
            ${Array.from(colorSet).join(', ')}
        </p>

        <p><strong>Available Sizes:</strong><br>
            ${Array.from(sizeSet).join(', ')}
        </p>

        <p><strong>Valid Combinations:</strong></p>
        <div style="max-height:120px; overflow:auto;">
            ${combinations.join('<br>')}
        </div>

        <button id="closeVariantPopup"
            style="
                margin-top:16px;
                padding:10px 18px;
                background:#111;
                color:#fff;
                border:none;
                border-radius:8px;
                cursor:pointer;">
            Close
        </button>
    `;

    modal.querySelector('#closeVariantPopup').onclick = () => {
        overlay.remove();
        modal.remove();
    };

    document.body.appendChild(overlay);
    document.body.appendChild(modal);
}


/* ======================================================
   CHECKOUT REDIRECT
====================================================== */
function redirectCartToPaymentSelection() {

    const cartData = getCartData();

    if (!cartData.items.length) {
        alert('Your cart is empty');
        return;
    }

    try {
        cartData.items.forEach(item => {
            resolveVariantCJVID(item);
        });
    } catch {
        return;
    }

    // redirectToPayment(cartData)

    const hostname = window.location.hostname;
    const page_domain = document.getElementById('page-subdomain').value;

    const subdomain = hostname.includes('localhost')
        ? page_domain
        : hostname.split('.')[0];

    const params = new URLSearchParams({
        type: 'cart',
        cart: JSON.stringify(cartData)
    });

    window.location.href =
        `/payments/select-payment/${subdomain}/?${params.toString()}`;
}

