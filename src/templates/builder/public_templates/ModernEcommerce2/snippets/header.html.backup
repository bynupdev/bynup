{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}
{% render_icon_data icon_customizations %}
<style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        {% generate_color_variables %}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 43 90 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 43 90 %}
        {% generate_hover_keyframes %}
        
        /* Header / Navigation */
        header#section-43 {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background-color: rgba(239, 236, 228, 0.95);
            padding: 20px 0;
            border-bottom: 1px solid rgba(187, 194, 182, 0.3);
            backdrop-filter: blur(10px);
        }
        
        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .logo {
            font-family: var(--font-serif);
            font-size: 32px;
            font-weight: 600;
            letter-spacing: 2px;
            color: var(--primary-dark);
        }
        
        .nav-links {
            display: flex;
            gap: 40px;
            align-items: center;
        }
        
        .nav-links a {
            font-size: 15px;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
        }
        
        .nav-links a:hover {
            color: var(--primary-accent);
        }
        
        .nav-links a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -5px;
            left: 0;
            background-color: var(--primary-accent);
            transition: width 0.3s ease;
        }
        
        .nav-links a:hover::after {
            width: 100%;
        }
        
        .nav-icons {
            display: flex;
            gap: 25px;
        }
        
        .nav-icons i {
            font-size: 18px;
            cursor: pointer;
        }
        
        .nav-icons i:hover {
            color: var(--primary-accent);
        }
        
        .hamburger {
            display: none;
            font-size: 24px;
            cursor: pointer;
        }
        
        /* Hero Section */
        .hero#section-57 {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 100px;
            position: relative;
            overflow: hidden;
        }
        
        .hero-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            width: 100%;
        }
        
        .hero-image {
            height: 85vh;
            background: linear-gradient(to bottom right, var(--secondary-light), var(--primary-light));
            position: relative;
            border-radius: 0 0 0 200px;
            overflow: hidden;
        }
        
        .hero-image::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(187, 194, 182, 0.2) 0%, rgba(187, 194, 182, 0) 70%);
            z-index: 1;
        }
        
        .model-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 30%;
            mix-blend-mode: normal;
        }
        
        .hero-content {
            padding-right: 40px;
        }
        
        .hero-content h1#section-58 {
            font-size: 64px;
            line-height: 1.1;
            margin-bottom: 30px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .hero-content p#section-59 {
            font-size: 18px;
            line-height: 1.6;
            margin-bottom: 40px;
            color: var(--primary-dark);
            font-weight: 300;
            max-width: 500px;
        }
        
        .cta-button#section-60 {
            display: inline-block;
            padding: 18px 40px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 16px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: none;
            position: relative;
            overflow: hidden;
        }
        
        .cta-button:hover {
            background-color: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(98, 102, 75, 0.15);
        }
        
        /* New Arrivals Section */
        .new-arrivals#section-61 {
            padding: 120px 0;
            background-color: var(--primary-light);
        }
        
        .section-header {
            text-align: center;
            margin-bottom: 70px;
        }
        
        .section-header h2#section-62 {
            font-size: 48px;
            font-weight: 500;
            margin-bottom: 15px;
            color: var(--primary-dark);
        }
        
        .section-header p#section-63 {
            font-size: 18px;
            color: var(--primary-dark);
            font-weight: 300;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            margin-bottom: 60px;
        }
        
        .product-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            position: relative;
        }
        
        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(98, 102, 75, 0.1);
        }
        
        .product-img {
            height: 400px;
            width: 100%;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .product-info {
            padding: 25px;
        }
        
        .product-info h3 {
            font-size: 22px;
            margin-bottom: 10px;
            font-weight: 500;
        }
        
        .product-info p {
            font-size: 16px;
            color: var(--primary-accent);
            font-weight: 400;
            margin-bottom: 15px;
        }
        
        .product-price {
            font-size: 20px;
            font-weight: 500;
            color: var(--primary-dark);
        }
        
        .see-more {
            text-align: center;
        }
        
        .see-more-button#section-68 {
            display: inline-block;
            padding: 16px 50px;
            background-color: transparent;
            color: var(--primary-dark);
            font-size: 16px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            border: 1px solid var(--primary-dark);
            position: relative;
            overflow: hidden;
        }
        
        .see-more-button:hover {
            background-color: var(--primary-dark);
            color: var(--primary-light);
        }
        .icon-btn {
                position: relative; /* Equivalent to Bootstrap's position-relative */
                display: inline-flex; /* Aligns icon and badge properly */
                align-items: center; /* Centers items vertically */
                text-decoration: none; /* Remove underline from link */
                color: inherit; /* Inherit text color */
                padding: 0.4rem; /* Add some padding around the button */
            }
            .wishlist-counter,
            .cart-counter {
                position: absolute; /* Equivalent to Bootstrap's position-absolute */
                top: 0; /* Aligns to the top */
                right: 0; /* Aligns to the right */
                transform: translate(50%, -50%); /* Center the badge */
                background-color: grey; /* Background color for the badge */
                color: white; /* Text color for the badge */
                padding: 0.25rem 0.5rem; /* Padding for the badge */
                border-radius: 1rem; /* Rounded pill shape */
                font-size: 0.5rem; /* Font size for the badge text */
            }

            .icon-btn i {
                font-size: 1.5rem; /* Adjust icon size as needed */
            }

        
        /* Footer */
        footer#section-69 {
            background-color: var(--primary-dark);
            color: var(--primary-light);
            padding: 70px 0 30px;
        }
        
        .footer-content {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 50px;
            margin-bottom: 50px;
        }
        
        .footer-column h3 {
            font-size: 20px;
            margin-bottom: 25px;
            font-weight: 500;
        }
        
        .footer-column ul {
            list-style: none;
        }
        
        .footer-column ul li {
            margin-bottom: 12px;
        }
        
        .footer-column ul li a:hover {
            color: var(--primary-accent);
        }
        
        .footer-bottom {
            text-align: center;
            padding-top: 30px;
            border-top: 1px solid rgba(187, 194, 182, 0.2);
            font-size: 14px;
            color: var(--secondary-light);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .hero-content h1#section-58 {
                font-size: 56px;
            }
            
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .footer-content {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media (max-width: 992px) {
            .hero-container {
                grid-template-columns: 1fr;
                gap: 40px;
            }
            
            .hero-image {
                height: 60vh;
                border-radius: 0 0 0 100px;
            }
            
            .hero-content {
                padding-right: 0;
                text-align: center;
                max-width: 700px;
                margin: 0 auto;
            }
            
            .hero-content p#section-59 {
                margin: 0 auto 40px;
            }
            
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .nav-links {
                display: none;
            }
            
            .hamburger {
                display: block;
            }
            
            .nav-icons {
                gap: 20px;
            }
        }
        
        @media (max-width: 768px) {
            .hero-content h1#section-58 {
                font-size: 48px;
            }
            
            .section-header h2#section-62 {
                font-size: 40px;
            }
            
            .product-img {
                height: 300px;
            }
            
            .footer-content {
                grid-template-columns: 1fr;
                gap: 40px;
            }
        }
        
        @media (max-width: 576px) {
            .hero-content h1#section-58 {
                font-size: 40px;
            }
            
            .hero-content p#section-59 {
                font-size: 16px;
            }
            
            .cta-button#section-60, .see-more-button#section-68 {
                padding: 14px 30px;
                font-size: 14px;
            }
            
            .products-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto 60px;
            }
            
            .section-header h2#section-62 {
                font-size: 36px;
            }
            
            .logo {
                font-size: 28px;
            }
            
            .hero#section-57 {
                padding-top: 80px;
            }
        }
        
        /* Mobile Navigation Menu */
        .mobile-nav {
            position: fixed;
            top: 0;
            right: -100%;
            width: 300px;
            height: 100vh;
            background-color: var(--primary-light);
            z-index: 1001;
            padding: 100px 40px 40px;
            transition: right 0.4s ease;
            box-shadow: -5px 0 30px rgba(98, 102, 75, 0.1);
        }
        
        .mobile-nav.active {
            right: 0;
        }
        
        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 25px;
            margin-bottom: 40px;
        }
        
        .mobile-nav-links a {
            font-size: 18px;
            font-weight: 400;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(187, 194, 182, 0.3);
        }
        
        .close-menu {
            position: absolute;
            top: 30px;
            right: 30px;
            font-size: 24px;
            cursor: pointer;
        }
        
        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(98, 102, 75, 0.5);
            z-index: 1000;
            display: none;
        }
        
        .overlay.active {
            display: block;
        }
    
    </style>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<header id="section-43">
        <div class="header-container">
            <div class="logo">
                <a href="?page=home">
                    <i class="fas fa-crown" data-icon="25"></i>
                    <span id="section-44">{{ home_text_contents.25|default:"ÉLYSIUM" }}</span>
                </a>
            </div>
            
            <div class="nav-links">
                <a href="?page=home" id="section-45">{{ home_text_contents.26|default:"Home" }}</a>
                <a href="?page=products" id="section-46">{{ home_text_contents.27|default:"Shop" }}</a>
                <a href="?page=about" id="section-47">{{ home_text_contents.28|default:"About Us" }}</a>
                <a href="?page=contact" id="section-48">{{ home_text_contents.29|default:"Contact" }}</a>
            </div>
            
            <div class="nav-icons">
                <a href="?page=cart" class="icon-btn" >
                    <span class="cart-counter" >0</span>
                    <i class="fas fa-shopping-bag" data-icon="26"></i>
                </a>
                <a href="?page=wishlist" class="icon-btn">
                    <span class="wishlist-counter">0</span>
                    <i class="far fa-heart" data-icon="27"></i>
                </a>
            
                 <!-- USER DROPDOWN -->
                <div style="position:relative;">

                    <i class="fa-solid fa-user" data-icon="32"
                    onclick="toggleDropdown()" 
                    style="cursor:pointer;"></i>

                    <ul id="dropdown" 
                        style="display:none; position:absolute; right:0; top:40px; width:210px; background:white; border-radius:8px; padding:10px 0; list-style:none; margin:0; box-shadow:0 5px 15px rgba(0,0,0,0.15); transform:translateY(-5px); opacity:0; transition:all .2s ease;">
                    
                    <!-- Close button -->
                    <div onclick="toggleDropdown()" 
                        style="text-align:right; padding:5px 15px; cursor:pointer;">
                        <i class="fa-solid fa-xmark" data-icon="33" style="font-size:18px; color:#444;"></i>
                    </div>
                    {% if show_auth_links %}
                    {% if not is_website_member %}
                    <li>
                        <a href="{{ website_register_url }}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-user-plus" data-icon="34"></i> Signup
                        </a>
                    </li>

                    <li>
                        <a href="{% url 'accounts:universal_login' %}?website_id={{ page.id }}&next={{ website_homepage_url|urlencode }}"
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fas fa-sign-in-alt" data-icon="35"></i> Login
                        </a>
                    </li>

                    <li>
                        <a href="{% url 'payments:customer_order_history' page.subdomain %}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-box" data-icon="36"></i> Orders
                        </a>
                    </li>

                    <!-- <li>
                        <a href="/dashboard/" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-gauge" data-icon="37"></i> Dashboard
                        </a>
                    </li> -->

                   
                    {%else%}

                     <li>
                        <a href="{% url 'payments:customer_order_history' page.subdomain %}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-box" data-icon="36"></i> Orders
                        </a>
                    </li>

                    <li>
                        <a href="{{ website_logout_url }}" 
                        style="display:flex; align-items:center; gap:12px; padding:12px 20px; text-decoration:none; color:#333; transition:0.2s;"
                        onmouseover="this.style.background='#f5f5f5'; this.style.transform='translateX(4px)';"
                        onmouseout="this.style.background=''; this.style.transform='';">
                        <i class="fa-solid fa-right-from-bracket" data-icon="38"></i> Logout
                        </a>
                    </li>
                    {%endif%}
                    {%endif%}
                    </ul>

                </div>


            </div>
            
            <div class="hamburger" id="hamburger">
                <i class="fas fa-bars" data-icon="28"></i>
            </div>
        </div>
    </header>

    <!-- Mobile Navigation -->
    <div class="overlay" id="overlay"></div>
    <div class="mobile-nav" id="mobileNav">
        <div class="close-menu" id="closeMenu">
            <i class="fas fa-times" data-icon="29"></i>
        </div>
        
        <div class="mobile-nav-links">
            <a href="?page=home" class="editable-text editable-section no-drop-zone" data-section="49" data-text="30">Home</a>
            <a href="?page=products" class="editable-text editable-section no-drop-zone" data-section="50" data-text="31">Shop</a>
            <a href="?page=about" class="editable-text editable-section no-drop-zone" data-section="51" data-text="32">About Us</a>
            <a href="?page=contact" class="editable-text editable-section no-drop-zone" data-section="52" data-text="33">Contact</a>
            <a href="?page=cart" class="editable-text editable-section no-drop-zone" data-section="53" data-text="34">Cart</a>
            <a href="?page=wishlist" class="editable-text editable-section no-drop-zone" data-section="54" data-text="35">Wishlist</a>
        </div>
        
        <div class="nav-icons">
            <a href="?page=cart" class="editable-text editable-section no-drop-zone" data-section="55" data-text="36">
                <i class="fas fa-shopping-bag" data-icon="30"></i> Cart
            </a>
            <a href="?page=wishlist" class="editable-text editable-section no-drop-zone" data-section="56" data-text="37">
                <i class="far fa-heart" data-icon="31"></i> Wishlist
            </a>
        </div>
    </div>
    <!-- JAVASCRIPT -->
{% render_icon_script %}
<script>
function toggleDropdown() {
  const menu = document.getElementById("dropdown");
  const isVisible = menu.style.display === "block";

  menu.style.display = isVisible ? "none" : "block";
  menu.style.opacity = isVisible ? "0" : "1";
  menu.style.transform = isVisible ? "translateY(-5px)" : "translateY(0px)";
}
</script>