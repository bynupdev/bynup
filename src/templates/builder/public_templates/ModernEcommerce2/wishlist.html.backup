<!-- Here is the javaScript that interacts with the backend -->
  <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Cart management buttons
            document.querySelectorAll('.increment-cart').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.incrementCartItem(productId, 1);
                    }
                });
            });

            document.querySelectorAll('.decrement-cart').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.decrementCartItem(productId, 1);
                    }
                });
            });

            document.querySelectorAll('.remove-cart-item').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.removeFromCart(productId);
                    }
                });
            });

            document.getElementById('clearCartBtn')?.addEventListener('click', function() {
                if (window.cartManager) {
                    window.cartManager.clearCart();
                }
            });

            // document.getElementById('remove-wish-item')?.addEventListener('click', function() {
            //     if (window.cartManager) {
            //         alert("Button pressed");
            //         window.cartManager.removeFromWishlist();
            //     }
            // });

            document.querySelectorAll('.remove-wish-item').forEach(button => {
                button.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    if (window.cartManager) {
                        window.cartManager.removeFromWishlist(productId);
                    }
                });
            });


        });

        document.getElementById('section-171')?.addEventListener('click', function() {
            if (window.cartManager) {
                window.cartManager.clearWishlist();
            }
        });
        

        function redirectCartToPaymentSelection() {
    // Get cart data from your existing cart system
    const cartData = getCartData(); // Replace with your cart function
    
    if (!cartData.items || cartData.items.length === 0) {
        alert('Your cart is empty');
        return;
    }
    
    // Get current page subdomain
    const hostname = window.location.hostname;
    const page_domain = document.getElementById('page-subdomain').value
    const subdomain = hostname.includes('localhost') ? page_domain : hostname.split('.')[0];
    
    // Redirect to payment selection page with cart data
    const params = new URLSearchParams({
        type: 'cart',
        cart: JSON.stringify(cartData)
    });
    
    window.location.href = `/payments/select-payment/${subdomain}/?${params.toString()}`;
}

// Example cart data function - replace with your actual cart implementation
function getCartData() {
    // This should connect to your existing cart system
    // Example implementation:
    const items = [];
    let subtotal = 0;
    
    document.querySelectorAll('.cart-item').forEach(item => {
        const title = item.querySelector('.product-title')?.textContent || 'Product';
        const description = item.querySelector('.product-description')?.textContent || 'Description';
        const price = parseFloat(item.querySelector('.product-price')?.textContent.replace('$', '')) || 0;
        const quantity = parseInt(item.querySelector('.quantity-input')?.textContent) || 1;
        const total = price * quantity;

        console.log("Product Title", title)
        console.log("Product Description", description)
        console.log("Product Price", price)
        console.log("Product Quantity", quantity)
        console.log("Product total", total)
        
        items.push({ title,description, price, quantity, total_price: total });
        subtotal += total;
    });
    
    const shipping = subtotal > 0 ? 5.00 : 0;
    const tax = subtotal * 0.08;
    const total = subtotal + shipping + tax;
    
    return {
        items: items,
        subtotal: subtotal,
        shipping_amount: shipping,
        tax_amount: tax,
        total_amount: total
    };
}
    </script>

<!-- This doesnt interact with the backend. It is the default template javascript -->
    <script>
        // Wishlist Management Variables
        let currentFilter = 'all';
        
        // Filter Buttons
        document.querySelectorAll('.filter-btn').forEach(button => {
            button.addEventListener('click', function() {
                // Remove active class from all buttons
                document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
                
                // Add active class to clicked button
                this.classList.add('active');
                
                // Update current filter
                currentFilter = this.textContent.toLowerCase().replace(' ', '-');
                
                // Filter items
                filterWishlistItems();
            });
        });
        
        function filterWishlistItems() {
            const wishlistItemsElements = document.querySelectorAll('.wishlist-item');
            let visibleCount = 0;
            
            wishlistItemsElements.forEach(itemElement => {
                const category = itemElement.getAttribute('data-category') || '';
                const status = itemElement.getAttribute('data-status') || '';
                const badge = itemElement.getAttribute('data-badge') || '';
                let shouldShow = true;
                
                switch(currentFilter) {
                    case 'on-sale':
                        shouldShow = badge.toLowerCase() === 'sale';
                        break;
                    case 'in-stock':
                        shouldShow = status === 'in-stock' || status === 'low-stock';
                        break;
                    case 'new-arrivals':
                        shouldShow = badge.toLowerCase() === 'new';
                        break;
                    case 'all':
                    default:
                        shouldShow = true;
                        break;
                }
                
                if (shouldShow) {
                    itemElement.style.display = 'block';
                    visibleCount++;
                } else {
                    itemElement.style.display = 'none';
                }
            });
            
            // Show empty state if no items match filter
            const emptyWishlist = document.querySelector('.empty-wishlist');
            const wishlistGrid = document.querySelector('.wishlist-grid');
            
            if (visibleCount === 0 && wishlistItemsElements.length > 0) {
                if (emptyWishlist) {
                    emptyWishlist.style.display = 'block';
                    emptyWishlist.querySelector('#section-176').textContent = 'No Items Match Your Filter';
                    emptyWishlist.querySelector('#section-177').textContent = 'Try selecting a different filter to view your saved items.';
                }
                if (wishlistGrid) wishlistGrid.style.display = 'none';
            } else {
                if (emptyWishlist) emptyWishlist.style.display = 'none';
                if (wishlistGrid) wishlistGrid.style.display = 'grid';
            }
        }
        
        // Remove Item from Wishlist
        document.querySelectorAll('.btn-remove-wishlist').forEach(button => {
            button.addEventListener('click', function() {
                const itemId = this.getAttribute('data-item-id');
                const itemElement = this.closest('.wishlist-item');
                const itemName = itemElement ? itemElement.querySelector('.wishlist-item-title').textContent : 'Item';
                
                if (confirm(`Remove "${itemName}" from your wishlist?`)) {
                    // Remove the item element from DOM
                    if (itemElement) {
                        itemElement.remove();
                    }
                    
                    // Update stats
                    updateWishlistStats();
                    
                    // Check if wishlist is now empty
                    const remainingItems = document.querySelectorAll('.wishlist-item');
                    if (remainingItems.length === 0) {
                        showEmptyWishlistState();
                    }
                    
                    // In a real implementation, you would update wishlist via AJAX
                    console.log(`Removed item ${itemId} from wishlist`);
                }
            });
        });
        
        // Clear All Items
        const clearWishlistBtn = document.getElementById('section-171');
        
        if (clearWishlistBtn) {
            clearWishlistBtn.addEventListener('click', function() {
                const wishlistItemsElements = document.querySelectorAll('.wishlist-item');
                
                if (wishlistItemsElements.length === 0) {
                    alert('Your wishlist is already empty.');
                    return;
                }
                
                if (confirm('Are you sure you want to clear your entire wishlist? This action cannot be undone.')) {
                    // Remove all item elements from DOM
                    wishlistItemsElements.forEach(item => item.remove());
                    
                    // Update stats
                    updateWishlistStats();
                    
                    // Show empty state
                    showEmptyWishlistState();
                    
                    // In a real implementation, you would clear wishlist via AJAX
                    console.log('Cleared entire wishlist');
                }
            });
        }
        
        // Add to Cart from Wishlist
        document.querySelectorAll('.btn-add-to-cart-wishlist:not(:disabled)').forEach(button => {
            button.addEventListener('click', function() {
                const itemId = this.getAttribute('data-item-id');
                const itemElement = this.closest('.wishlist-item');
                const itemName = itemElement ? itemElement.querySelector('.wishlist-item-title').textContent : 'Item';
                const itemPrice = itemElement ? itemElement.querySelector('.wishlist-item-price').textContent : '$0';
                
                // Visual feedback
                const originalText = this.innerHTML;
                this.innerHTML = '<i class="fas fa-check"></i> Added';
                this.style.backgroundColor = 'var(--primary-dark)';
                
                // Reset after 1.5 seconds
                setTimeout(() => {
                    this.innerHTML = originalText;
                    this.style.backgroundColor = 'var(--primary-accent)';
                }, 1500);
                
                // In a real implementation, you would add to cart via AJAX
                console.log(`Added to cart from wishlist: ${itemName} - ${itemPrice} (ID: ${itemId})`);
                
                // Optionally remove from wishlist after adding to cart
                // if (itemElement) {
                //     itemElement.remove();
                //     updateWishlistStats();
                // }
            });
        });
        
        // Update Wishlist Statistics (frontend calculation)
        function updateWishlistStats() {
            const wishlistItemsElements = document.querySelectorAll('.wishlist-item');
            const itemCount = wishlistItemsElements.length;
            
            let onSaleCount = 0;
            let totalValue = 0;
            let lowStockCount = 0;
            
            wishlistItemsElements.forEach(item => {
                // Check if item is on sale
                const badgeElement = item.querySelector('.wishlist-item-badge');
                if (badgeElement && badgeElement.textContent.toLowerCase() === 'sale') {
                    onSaleCount++;
                }
                
                // Calculate total value
                const priceElement = item.querySelector('.wishlist-item-price');
                if (priceElement) {
                    const priceText = priceElement.textContent.replace('$', '').replace(',', '');
                    const price = parseFloat(priceText) || 0;
                    totalValue += price;
                }
                
                // Check if item is low stock
                const statusElement = item.querySelector('.wishlist-item-status');
                if (statusElement && statusElement.classList.contains('status-low-stock')) {
                    lowStockCount++;
                }
            });
            
            // Update stat values if they exist
            const statValues = document.querySelectorAll('.stat-value');
            if (statValues.length >= 4) {
                statValues[0].textContent = itemCount;
                statValues[1].textContent = onSaleCount;
                statValues[2].textContent = `$${totalValue.toLocaleString()}`;
                statValues[3].textContent = lowStockCount;
            }
            
            // Update hero message
            const heroMessage = document.getElementById('section-156');
            if (heroMessage && itemCount > 0) {
                heroMessage.textContent = `You have ${itemCount} item${itemCount !== 1 ? 's' : ''} saved in your wishlist`;
            }
        }
        
        // Show Empty Wishlist State
        function showEmptyWishlistState() {
            const emptyWishlist = document.querySelector('.empty-wishlist');
            const wishlistGrid = document.querySelector('.wishlist-grid');
            const wishlistActions = document.querySelector('.wishlist-actions');
            
            if (emptyWishlist) {
                emptyWishlist.style.display = 'block';
                // Reset empty wishlist messages to default
                emptyWishlist.querySelector('#section-176').textContent = '{{ text_contents.137|default:"Your Wishlist is Empty" }}';
                emptyWishlist.querySelector('#section-177').textContent = '{{ text_contents.138|default:"Save items you love by clicking the heart icon. Come back here to view them all and purchase when you\'re ready." }}';
            }
            if (wishlistGrid) wishlistGrid.style.display = 'none';
            if (wishlistActions) wishlistActions.style.display = 'none';
            
            // Reset filter buttons
            document.querySelectorAll('.filter-btn').forEach(btn => {
                if (btn.id === 'section-167') {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });
            
            currentFilter = 'all';
            
            // Update hero message
            const heroMessage = document.getElementById('section-156');
            if (heroMessage) {
                heroMessage.textContent = '{{ text_contents.119|default:"Save your favorite pieces for later or share with friends" }}';
            }
        }
        
        // Start Shopping Button (for empty wishlist)
        const startShoppingBtn = document.getElementById('section-178');
        
        if (startShoppingBtn) {
            startShoppingBtn.addEventListener('click', function(e) {
                e.preventDefault();
                // In a real implementation, this would navigate to the shop page
                console.log('Redirecting to shop page');
                // window.location.href = '?page=shop';
            });
        }
        
        // Initialize filter on page load
        filterWishlistItems();
    </script>
</body>
</html>