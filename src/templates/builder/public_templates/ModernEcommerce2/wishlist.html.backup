 {% load style_filters %}
 {% load currency_filters %}
 {% load color_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | {{page.brand_name}}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-dark: #62664B;
            --primary-accent: #AB8872;
            --primary-light: #EFECE4;
            --secondary-light: #BBC2B6;
            
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Inter', sans-serif;
        }
        {% generate_color_variables %}
        
        /* Dynamic Section Styles for Wishlist Page */
        {% generate_section_styles style_customizations 154 180 %}
        
        /* Dynamic Background Images for Wishlist Page */
        {% generate_background_images background_images 154 180 %}
        {% generate_hover_keyframes %}
        
        /* Rest of the CSS remains the same as above */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: var(--font-sans);
            color: var(--primary-dark);
            background-color: var(--primary-light);
            overflow-x: hidden;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-serif);
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        a {
            text-decoration: none;
            color: inherit;
            transition: all 0.3s ease;
        }
        
        button {
            font-family: var(--font-sans);
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
            outline: none;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px;
        }
        
        /* Wishlist Hero Section */
        .wishlist-hero#section-154 {
            padding: 160px 0 60px;
            background: linear-gradient(135deg, rgba(187, 194, 182, 0.05) 0%, rgba(239, 236, 228, 0.02) 100%);
            text-align: center;
            position: relative;
        }
        
        .wishlist-hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2362664b' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
            opacity: 0.4;
            z-index: 0;
        }
        
        .wishlist-hero-content {
            position: relative;
            z-index: 1;
        }
        
        .wishlist-hero h1#section-155 {
            font-size: 48px;
            line-height: 1.1;
            margin-bottom: 15px;
            color: var(--primary-dark);
            font-weight: 500;
        }
        
        .wishlist-hero p#section-156 {
            font-size: 18px;
            line-height: 1.6;
            color: var(--primary-dark);
            font-weight: 300;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Wishlist Stats */
        .wishlist-stats#section-157 {
            padding: 30px 0;
            background-color: var(--primary-light);
            border-bottom: 1px solid rgba(187, 194, 182, 0.2);
        }
        
        .stats-container {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
        }
        
        .stat-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }
        
        .stat-value {
            font-size: 32px;
            color: var(--primary-accent);
            font-weight: 500;
            font-family: var(--font-serif);
        }
        
        .stat-label {
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-dark);
            opacity: 0.8;
        }
        
        /* Wishlist Content */
        .wishlist-content#section-166 {
            padding: 60px 0 120px;
        }
        
        .wishlist-container {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }
        
        .wishlist-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }
        
        .wishlist-filters {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }
        
        .filter-btn {
            padding: 10px 20px;
            background-color: transparent;
            color: var(--primary-dark);
            font-size: 14px;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        
        .filter-btn:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        .filter-btn.active {
            background-color: var(--primary-dark);
            color: var(--primary-light);
            border-color: var(--primary-dark);
        }
        
        .wishlist-bulk-actions {
            display: flex;
            gap: 15px;
        }
        
        .btn-clear-wishlist#section-171 {
            padding: 10px 20px;
            background-color: transparent;
            color: var(--primary-dark);
            font-size: 14px;
            border: 1px solid var(--secondary-light);
            border-radius: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .btn-clear-wishlist:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        /* Wishlist Grid */
        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }
        
        .wishlist-item {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
            border: 1px solid rgba(187, 194, 182, 0.2);
            position: relative;
        }
        
        .wishlist-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(98, 102, 75, 0.1);
        }
        
        .wishlist-item-image {
            width: 100%;
            height: 280px;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .wishlist-item-info {
            padding: 20px;
        }
        
        .wishlist-item-category {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary-accent);
            margin-bottom: 8px;
            font-weight: 400;
        }
        
        .wishlist-item-title#section-173 {
            font-size: 18px;
            font-family: var(--font-serif);
            color: var(--primary-dark);
            margin-bottom: 10px;
            font-weight: 500;
            line-height: 1.3;
        }
        
        .wishlist-item-price#section-174 {
            font-size: 20px;
            color: var(--primary-dark);
            font-weight: 500;
            margin-bottom: 15px;
        }
        
        .wishlist-item-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }
        
        .btn-add-to-cart-wishlist#section-175 {
            flex: 1;
            padding: 10px 15px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .btn-add-to-cart-wishlist:hover {
            background-color: var(--primary-dark);
        }
        
        .btn-add-to-cart-wishlist:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .btn-add-to-cart-wishlist:disabled:hover {
            background-color: var(--primary-accent);
        }
        
        #btn-remove-wishlist {
            width: 40px;
            height: 40px;
            background-color: var(--primary-light);
            border: 1px solid var(--secondary-light);
            color: var(--primary-dark);
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        
    #btn-remove-wishlist:hover {
            border-color: var(--primary-accent);
            color: var(--primary-accent);
        }
        
        .wishlist-item-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            background-color: var(--primary-accent);
            color: var(--primary-light);
            padding: 4px 10px;
            font-size: 11px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            z-index: 2;
        }
        
        .wishlist-item-status {
            position: absolute;
            top: 15px;
            left: 15px;
            font-size: 12px;
            color: var(--primary-dark);
            background-color: rgba(239, 236, 228, 0.9);
            padding: 4px 10px;
            border-radius: 2px;
            z-index: 2;
        }
        
        .status-in-stock {
            color: #4CAF50;
        }
        
        .status-low-stock {
            color: #FF9800;
        }
        
        .status-out-of-stock {
            color: #F44336;
        }
        
        /* Empty Wishlist State */
        .empty-wishlist {
            text-align: center;
            padding: 80px 20px;
            background-color: var(--primary-light);
            border-radius: 5px;
            border: 1px solid rgba(187, 194, 182, 0.2);
            margin-top: 30px;
        }
        
        .empty-wishlist-icon {
            font-size: 64px;
            color: var(--secondary-light);
            margin-bottom: 25px;
        }
        
        .empty-wishlist-title#section-176 {
            font-size: 28px;
            color: var(--primary-dark);
            margin-bottom: 15px;
            font-weight: 500;
        }
        
        .empty-wishlist-message#section-177 {
            font-size: 16px;
            color: var(--primary-dark);
            opacity: 0.8;
            margin-bottom: 30px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }
        
        .btn-start-shopping#section-178 {
            padding: 14px 30px;
            background-color: var(--primary-dark);
            color: var(--primary-light);
            font-size: 14px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 2px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        
        .btn-start-shopping:hover {
            background-color: var(--primary-accent);
        }
        
        /* Recently Viewed Section */
        .recently-viewed#section-179 {
            padding: 60px 0;
            background-color: rgba(187, 194, 182, 0.05);
            border-top: 1px solid rgba(187, 194, 182, 0.1);
        }
        
        .section-title#section-180 {
            font-size: 32px;
            margin-bottom: 40px;
            color: var(--primary-dark);
            font-weight: 500;
            text-align: center;
        }
        
        .recently-viewed-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }
        
        .recent-product-card {
            background-color: var(--primary-light);
            border-radius: 5px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 5px 15px rgba(98, 102, 75, 0.05);
        }
        
        .recent-product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(98, 102, 75, 0.1);
        }
        
        .recent-product-img {
            height: 220px;
            width: 100%;
            object-fit: cover;
            background-color: var(--secondary-light);
        }
        
        .recent-product-info {
            padding: 20px;
        }
        
        .recent-product-name {
            font-size: 16px;
            margin-bottom: 8px;
            font-weight: 500;
            font-family: var(--font-serif);
            color: var(--primary-dark);
        }
        
        .recent-product-price {
            font-size: 18px;
            font-weight: 500;
            color: var(--primary-dark);
        }
        
        /* Responsive Styles */
        @media (max-width: 1200px) {
            .wishlist-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            
            .recently-viewed-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        
        @media (max-width: 992px) {
            .wishlist-hero h1#section-155 {
                font-size: 40px;
            }
            
            .wishlist-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .recently-viewed-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .wishlist-actions {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .wishlist-bulk-actions {
                width: 100%;
                justify-content: flex-start;
            }
        }
        
        @media (max-width: 768px) {
            .wishlist-hero#section-154 {
                padding: 140px 0 40px;
            }
            
            .wishlist-hero h1#section-155 {
                font-size: 36px;
            }
            
            .wishlist-hero p#section-156 {
                font-size: 16px;
            }
            
            .wishlist-content#section-166 {
                padding: 40px 0 80px;
            }
            
            .wishlist-item-image {
                height: 240px;
            }
            
            .section-title#section-180 {
                font-size: 28px;
            }
            
            .stat-value {
                font-size: 28px;
            }
        }
        
        @media (max-width: 576px) {
            .wishlist-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            
            .recently-viewed-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            
            .stats-container {
                gap: 20px;
            }
            
            .stat-item {
                min-width: 100px;
            }
            
            .wishlist-filters {
                width: 100%;
                justify-content: center;
            }
            
            .filter-btn {
                flex: 1;
                text-align: center;
            }
            
            .empty-wishlist {
                padding: 60px 15px;
            }
            
            .empty-wishlist-title#section-176 {
                font-size: 24px;
            }
            
            .recently-viewed#section-179 {
                padding: 40px 0;
            }
        }
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
 {%include 'builder/public_templates/ModernEcommerce2/snippets/header.html'%}

    <!-- Wishlist Hero Section -->
    <section class="wishlist-hero" id="section-154">
        <div class="container">
            <div class="wishlist-hero-content">
                <h1 id="section-155">{{ text_contents.118|default:"Your Wishlist" }}</h1>
                <p id="section-156">
                    {% if wishlist_items and wishlist_items|length > 0 %}
                        You have {{ wishlist_items|length }} item{{ wishlist_items|length|pluralize }} saved in your wishlist
                    {% else %}
                        {{ text_contents.119|default:"Save your favorite pieces for later or share with friends" }}
                    {% endif %}
                </p>
            </div>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '154' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    <!-- Wishlist Stats -->
    <section class="wishlist-stats" id="section-157">
        <div class="container">
            <div class="stats-container">
                <div class="stat-item">
                    <span class="stat-value" id="section-158">{{ wishlist_items|length }}</span>
                    <span class="stat-label" id="section-159">{{ text_contents.121|default:"Items Saved" }}</span>
                </div>
                
                <div class="stat-item">
                    <span class="stat-value" id="section-160">
                        
                            {{ wishlist_items|length}}
                        
                    </span>
                    <span class="stat-label" id="section-161">{{ text_contents.123|default:"On Sale" }}</span>
                </div>
                
                <div class="stat-item">
                    <span class="stat-value" id="section-162">
                        
                            {{ wish_price_total|currency:page }}
                        
                    </span>
                    <span class="stat-label" id="section-163">{{ text_contents.125|default:"Total Value" }}</span>
                </div>
                
                <div class="stat-item">
                    <span class="stat-value" id="section-164">
                        {% if wishlist_items %}
                            {{ wish_low_stock_count }}
                        {% else %}
                            0
                        {% endif %}
                    </span>
                    <span class="stat-label" id="section-165">{{ text_contents.127|default:"Low in Stock" }}</span>
                </div>
            </div>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '157' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    <!-- Wishlist Content -->
    <section class="wishlist-content" id="section-166">
        <div class="container">
            <div class="wishlist-container">
                <!-- Wishlist Actions -->
                <div class="wishlist-actions">
                    <div class="wishlist-filters">
                        <button class="filter-btn active" id="section-167">{{ text_contents.128|default:"All Items" }}</button>
                        <button class="filter-btn" id="section-168">{{ text_contents.129|default:"On Sale" }}</button>
                        <button class="filter-btn" id="section-169">{{ text_contents.130|default:"In Stock" }}</button>
                        <button class="filter-btn" id="section-170">{{ text_contents.131|default:"New Arrivals" }}</button>
                    </div>
                    
                    <div class="wishlist-bulk-actions">
                        <button class="btn-clear-wishlist" id="section-171">
                            <i class="far fa-trash-alt" data-icon="57"></i> {{ text_contents.132|default:"Clear All" }}
                        </button>
                    </div>
                </div>
                
                <!-- Wishlist Grid -->
                <div class="wishlist-grid">
                    {% if wishlist and wishlist.items.all %}
                        {% for item in wishlist.items.all %}
                        
                        <div class="wishlist-item" data-category="{{ item.product.category|default:'all' }}" data-status="{{ item.status|default:'in-stock' }}" data-badge="{{ item.badge|default:'' }}"
                            data-product-id="{{ item.product.id }}"
                            data-product-title="{{ item.product.title }}"
                            data-product-price="{{ item.product.price }}"
                            data-product-image="{% if item.product.main_image %}{{ item.product.main_image.url }}{% endif %}"
                        >
                            {% if item.badge %}
                            <div class="wishlist-item-badge">{{ item.badge }}</div>
                            {% endif %}
                            
                            {% if item.status %}
                            <div class="wishlist-item-status status-{{ item.status }}">
                                {% if item.status == 'in-stock' %}
                                    In Stock
                                {% elif item.status == 'low-stock' %}
                                    Low Stock
                                {% elif item.status == 'out-of-stock' %}
                                    Out of Stock
                                {% endif %}
                            </div>
                            {% endif %}
                            
                            <a href="/product/{{ item.product.slug }}/" class="product-image-link">
                            <img src="{{ item.product.main_image.url }}" alt="{{ item.product.title }}" class="wishlist-item-image">
                            
                            </a>
                            <div class="wishlist-item-info">
                                <div class="wishlist-item-category {% if forloop.first %}id="section-172"{% endif %}">
                                    {% if forloop.first %}
                                        {{ item.product.category }}
                                    {% else %}
                                        {{ item.product.category }}
                                    {% endif %}
                                </div>
                                <h3 class="wishlist-item-title {% if forloop.first %}id="section-173"{% endif %}">
                                    {% if forloop.first %}
                                        {{ item.product.title }}
                                    {% else %}
                                        {{ item.product.title }}
                                    {% endif %}
                                </h3>
                                <div class="wishlist-item-price {% if forloop.first %}id="section-174"{% endif %}">
                                    {% if forloop.first %}
                                        {{ item.product.price|currency:page }}
                                    {% else %}
                                        {{ item.product.price|currency:page }}
                                    {% endif %}
                                </div>
                                
                                <div class="wishlist-item-actions">
                                    {% if item.status == 'out-of-stock' %}
                                    <button class="btn-add-to-cart-wishlist {% if forloop.first %}id="section-175"{% endif %}" disabled>
                                        <i class="fas fa-bell" data-icon="60"></i> Notify Me
                                    </button>
                                    {% else %}
                                    <button class="btn-add-to-cart-wishlist btn-add-to-cart" id="section-175" data-add-to-cart="{{ item.product.id }}">
                                            <i class="fas fa-shopping-bag" {% if forloop.first %}data-icon="58"{% endif %}></i> {{ text_contents.136|default:"Add to Cart" }}
                                        
                                    </button>
                                    {% endif %}
                                    <button class="remove-wish-item" id="btn-remove-wishlist" data-remove-from-wishlist="{{ item.product.id }}" title="Remove from wishlist">
                                        <i class="fas fa-times" {% if forloop.first %}data-icon="59"{% endif %}></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        {% endfor %}
                    {% else %}
                        <!-- Empty Wishlist State -->
                        <div class="empty-wishlist">
                            <div class="empty-wishlist-icon">
                                <i class="far fa-heart" data-icon="61"></i>
                            </div>
                            <h2 id="section-176">{{ text_contents.137|default:"Your Wishlist is Empty" }}</h2>
                            <p id="section-177">{{ text_contents.138|default:"Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready." }}</p>
                            <a href="?page=shop" class="btn-start-shopping" id="section-178">
                                <i class="fas fa-arrow-left" data-icon="62"></i> {{ text_contents.139|default:"Start Shopping" }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '166' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}
    
    <!-- Recently Viewed Section -->
    <section class="recently-viewed" id="section-179">
        <div class="container">
            <h2 class="section-title" id="section-180">{{ text_contents.140|default:"Recently Viewed" }}</h2>
            
            <div class="recently-viewed-grid">
                {% for rvp in recently_viewed_products %}
                <a href="/product/{{ rvp.product.slug }}/" class="recent-product-card">
                    {% if rvp.product.main_image %}
                    <img src="{{ rvp.product.main_image.url }}" alt="{{ rvp.product.title }}" class="recent-product-img">
                    {% else %}
                    <div class="recent-product-img" style="background-color: {% cycle '#BBC2B6' '#EFECE4' '#AB8872' '#62664B' %};"></div>
                    {% endif %}
                    <div class="recent-product-info">
                        <h3 class="recent-product-name">{{ rvp.product.title|truncatechars:30 }}</h3>
                        <div class="recent-product-price">{{ rvp.product.price|currency:page }}</div>
                    </div>
                </a>
                {% empty %}
                <!-- Default recently viewed products -->
                <a href="?page=product-details&id=9" class="recent-product-card">
                    <div class="recent-product-img" style="background-color: #BBC2B6;"></div>
                    <div class="recent-product-info">
                        <h3 class="recent-product-name">Trench Coat</h3>
                        <div class="recent-product-price">$590</div>
                    </div>
                </a>
                
                <a href="?page=product-details&id=10" class="recent-product-card">
                    <div class="recent-product-img" style="background-color: #EFECE4;"></div>
                    <div class="recent-product-info">
                        <h3 class="recent-product-name">Silk Blouse</h3>
                        <div class="recent-product-price">$245</div>
                    </div>
                </a>
                
                <a href="?page=product-details&id=11" class="recent-product-card">
                    <div class="recent-product-img" style="background-color: #AB8872;"></div>
                    <div class="recent-product-info">
                        <h3 class="recent-product-name">Leather Skirt</h3>
                        <div class="recent-product-price">$385</div>
                    </div>
                </a>
                
                <a href="?page=product-details&id=12" class="recent-product-card">
                    <div class="recent-product-img" style="background-color: #62664B;"></div>
                    <div class="recent-product-info">
                        <h3 class="recent-product-name">Wool Scarf</h3>
                        <div class="recent-product-price">$185</div>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>
    
    {% for component in components %}
    {% if component.drop_zone == '179' %}
    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
        {{ component.html_content|safe }}
    </section>
    {% endif %}
    {% endfor %}

        {%include 'builder/public_templates/ModernEcommerce2/snippets/footer.html'%}
    
