{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    {% render_icon_data icon_customizations %}
    
    <style>
        :root {
            --golden-glow: #FBC867;
            --soft-peach: #FCA994;
            --rich-ebony: #250B06;
            --rose-brick: #C25D61;
            --vibrant-ember: #ED760B;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        
        {% generate_color_variables %}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--rich-ebony);
            color: #FFFFFF;
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }
        
        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }
        
        h1.categories-title {
            font-size: 3rem;
            color: var(--golden-glow);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }
        
        h1.categories-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--golden-glow), var(--soft-peach));
        }
        
        .categories-subtitle {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-xl);
        }
        
        .category-card {
            background: rgba(37, 11, 6, 0.75);
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            border: 1px solid rgba(252, 169, 148, 0.2);
            cursor: pointer;
            position: relative;
        }
        
        .category-card:hover {
            transform: translateY(-10px);
            border-color: var(--golden-glow);
        }
        
        .category-image {
            height: 280px;
            width: 100%;
            background-size: cover;
            background-position: center;
            transition: transform 0.5s ease;
        }
        
        .category-card:hover .category-image {
            transform: scale(1.05);
        }
        
        .category-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(37, 11, 6, 0.9), transparent);
            padding: 1.5rem;
        }
        
        .category-name {
            font-size: 1.5rem;
            color: var(--golden-glow);
            margin-bottom: 0.3rem;
            font-family: 'Cormorant Garamond', serif;
        }
        
        .category-count {
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.7);
        }
        
        .category-description {
            padding: 1rem 1.2rem 1.2rem;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.85rem;
            line-height: 1.5;
            border-top: 1px solid rgba(252, 169, 148, 0.1);
        }
        
        .explore-link {
            display: inline-block;
            margin: 0 1.2rem 1.2rem;
            padding: 0.5rem 1rem;
            background: rgba(252, 169, 148, 0.1);
            border: 1px solid rgba(252, 169, 148, 0.3);
            border-radius: 40px;
            color: var(--soft-peach);
            font-size: 0.8rem;
            text-decoration: none;
            transition: var(--transition);
            text-align: center;
        }
        
        .explore-link:hover {
            background: rgba(252, 169, 148, 0.2);
            border-color: var(--golden-glow);
            color: var(--golden-glow);
        }
        
        /* Featured Categories Section */
        .featured-categories {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(252, 169, 148, 0.2);
        }
        
        .featured-categories h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--golden-glow);
        }
        
        .featured-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }
        
        .featured-card {
            background: rgba(37, 11, 6, 0.75);
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            border: 1px solid rgba(252, 169, 148, 0.2);
            cursor: pointer;
            text-align: center;
            padding: 2rem;
        }
        
        .featured-card:hover {
            transform: translateY(-5px);
            border-color: var(--golden-glow);
        }
        
        .featured-icon {
            font-size: 3rem;
            color: var(--golden-glow);
            margin-bottom: 1rem;
        }
        
        .featured-name {
            font-size: 1.3rem;
            color: #FFFFFF;
            margin-bottom: 0.5rem;
        }
        
        .featured-count {
            font-size: 0.85rem;
            color: var(--soft-peach);
        }
        
        /* Empty State */
        .empty-categories {
            text-align: center;
            padding: 4rem;
            background: rgba(37, 11, 6, 0.75);
            border-radius: var(--border-radius);
            border: 1px solid rgba(252, 169, 148, 0.2);
        }
        
        .empty-categories-icon {
            font-size: 4rem;
            color: var(--soft-peach);
            margin-bottom: 1.5rem;
        }
        
        .empty-categories h2 {
            font-size: 2rem;
            color: var(--golden-glow);
            margin-bottom: 1rem;
        }
        
        .empty-categories p {
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 2rem;
        }
        
        .add-category-btn {
            display: inline-block;
            padding: 1rem 2rem;
            background: linear-gradient(135deg, var(--vibrant-ember), var(--soft-peach));
            border: none;
            border-radius: 40px;
            color: var(--rich-ebony);
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
        }
        
        .add-category-btn:hover {
            background: linear-gradient(135deg, var(--golden-glow), var(--vibrant-ember));
            transform: translateY(-2px);
        }
        
        /* Responsive */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }
        
        @media (max-width: 992px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .featured-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        
        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            .categories-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            .featured-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            h1.categories-title {
                font-size: 2.5rem;
            }
        }
        
        @media (max-width: 576px) {
            h1.categories-title {
                font-size: 2rem;
            }
        }
        
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 94 110 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 94 110 %}
        
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce25/snippets/header1.html' %}
    
    {% for component in components %}
        {% if component.drop_zone == '1' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    <!-- Page Header -->
    <div class="page-header" id="section-94">
        <div class="container">
            <h1 class="categories-title" id="section-95">{{ text_contents.74|default:"Shop by Category" }}</h1>
            <p class="categories-subtitle" id="section-96">{{ text_contents.75|default:"Explore our curated lighting collections, each designed to transform your space with warmth and elegance" }}</p>
        </div>
    </div>
    
    {% for component in components %}
        {% if component.drop_zone == '94' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    <div class="container">
        <!-- Categories Grid -->
        <div class="categories-grid" id="categoriesGrid">
            {% if categories %}
                {% for category in categories %}
                    <div class="category-card" 
                         data-category-id="{{ category.id }}" 
                         data-category-slug="{{ category.slug }}"
                         id="{% if forloop.first %}section-97{% endif %}">
                        <div class="category-image" style="background-image: url('{% if category.image %}{{ category.image.url }}{% else %}https://images.pexels.com/photos/2129794/pexels-photo-2129794.jpeg?auto=compress&cs=tinysrgb&w=500{% endif %}')"></div>
                        <div class="category-overlay">
                            <div class="category-name {% if forloop.first %}id="section-98"{% endif %}">{{ category.name }}</div>
                            <div class="category-count">
                                {% if category.get_active_products_count %}
                                    {{ category.get_active_products_count }} Products
                                {% else %}
                                    {{ category.get_total_products_count|default:"0" }} Products
                                {% endif %}
                            </div>
                        </div>
                        <div class="category-description {% if forloop.first %}id="section-99"{% endif %}">
                            {{ category.description|default:"Discover our curated collection of lighting designs that combine form and function."|truncatechars:100 }}
                        </div>
                        <a href="?page=products&category={{ category.slug }}" class="explore-link">Explore Collection →</a>
                    </div>
                {% endfor %}
            {% else %}
                <!-- Empty Categories State -->
                <div class="empty-categories" style="grid-column: 1 / -1;">
                    <div class="empty-categories-icon">
                        <i class="fas fa-folder-open"></i>
                    </div>
                    <h2>{{ text_contents.79|default:"No Categories Available" }}</h2>
                    <p>{{ text_contents.80|default:"There are no lighting categories to display at the moment. Categories will appear here once they are added to your store." }}</p>
                    <a href="/admin/add-category" class="add-category-btn">{{ text_contents.81|default:"Add Your First Category" }}</a>
                </div>
            {% endif %}
        </div>
        
        {% for component in components %}
            {% if component.drop_zone == '97' %}
                <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                    {{ component.html_content|safe }}
                </section>
            {% endif %}
        {% endfor %}
        
        <!-- Featured Categories Section -->
        <div class="featured-categories" id="section-100">
            <h2 id="section-101">{{ text_contents.78|default:"Featured Collections" }}</h2>
            <div class="featured-grid">
                <div class="featured-card" data-collection="popular">
                    <div class="featured-icon"><i class="fas fa-star"></i></div>
                    <div class="featured-name">Best Sellers</div>
                    <div class="featured-count">Most Popular Picks</div>
                </div>
                <div class="featured-card" data-collection="newest">
                    <div class="featured-icon"><i class="fas fa-fire"></i></div>
                    <div class="featured-name">New Arrivals</div>
                    <div class="featured-count">Latest Designs</div>
                </div>
                <div class="featured-card" data-collection="sale">
                    <div class="featured-icon"><i class="fas fa-tag"></i></div>
                    <div class="featured-name">Sale Collection</div>
                    <div class="featured-count">Limited Time Offers</div>
                </div>
            </div>
        </div>
    </div>
    
    {% for component in components %}
        {% if component.drop_zone == '100' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce25/snippets/footer.html' %}
    
    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    {% render_icon_script %}
    
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    
    <script>
        // Category card click handling
        document.querySelectorAll('.category-card').forEach(card => {
            card.addEventListener('click', function(e) {
                if (e.target.classList.contains('explore-link') || e.target.closest('.explore-link')) {
                    return;
                }
                const exploreLink = this.querySelector('.explore-link');
                if (exploreLink) {
                    window.location.href = exploreLink.getAttribute('href');
                }
            });
        });
        
        // Featured collections click
        document.querySelectorAll('.featured-card').forEach(card => {
            card.addEventListener('click', function() {
                const collectionName = this.querySelector('.featured-name').textContent;
                let filter = '';
                if (collectionName === 'Best Sellers') filter = 'popular';
                else if (collectionName === 'New Arrivals') filter = 'newest';
                else if (collectionName === 'Sale Collection') filter = 'sale';
                window.location.href = `?page=products&sort=${filter}`;
            });
        });
        
        // Add animation on scroll for categories
        const categoryCards = document.querySelectorAll('.category-card');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '0';
                    entry.target.style.transform = 'translateY(30px)';
                    setTimeout(() => {
                        entry.target.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }, 100);
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        
        categoryCards.forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            observer.observe(card);
        });
    </script>
</body>
</html>