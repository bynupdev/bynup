{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    {% render_icon_data icon_customizations %}
    
    <style>
        :root {
            --golden-glow: #FBC867;
            --soft-peach: #FCA994;
            --rich-ebony: #250B06;
            --rose-brick: #C25D61;
            --vibrant-ember: #ED760B;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        }
        
        {% generate_color_variables %}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--rich-ebony);
            color: #FFFFFF;
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }
        
        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }
        
        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }
        
        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }
        
        h1.contact-title {
            font-size: 3rem;
            color: var(--golden-glow);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }
        
        h1.contact-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, var(--golden-glow), var(--soft-peach));
        }
        
        .contact-subtitle {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Contact Layout */
        .contact-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }
        
        /* Contact Information */
        .contact-info {
            background: rgba(37, 11, 6, 0.75);
            border-radius: var(--border-radius);
            border: 1px solid rgba(252, 169, 148, 0.2);
            padding: 2rem;
        }
        
        .contact-info h2 {
            font-size: 1.8rem;
            color: var(--golden-glow);
            margin-bottom: 1.5rem;
            padding-bottom: 0.8rem;
            border-bottom: 1px solid rgba(252, 169, 148, 0.2);
        }
        
        .contact-methods {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .contact-method {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }
        
        .contact-icon {
            width: 50px;
            height: 50px;
            background: rgba(252, 169, 148, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--golden-glow);
            font-size: 1.3rem;
            flex-shrink: 0;
        }
        
        .contact-details h3 {
            font-size: 1.1rem;
            color: var(--soft-peach);
            margin-bottom: 0.3rem;
        }
        
        .contact-details p, .contact-details a {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            transition: var(--transition);
            font-size: 0.9rem;
            line-height: 1.5;
        }
        
        .contact-details a:hover {
            color: var(--golden-glow);
        }
        
        /* Business Hours */
        .business-hours {
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(252, 169, 148, 0.2);
        }
        
        .business-hours h3 {
            font-size: 1.1rem;
            color: var(--soft-peach);
            margin-bottom: 1rem;
        }
        
        .hours-list {
            list-style: none;
        }
        
        .hours-list li {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(252, 169, 148, 0.1);
        }
        
        .hours-list li:last-child {
            border-bottom: none;
        }
        
        .hours-day {
            font-weight: 500;
        }
        
        .hours-time {
            color: rgba(255, 255, 255, 0.6);
        }
        
        /* Contact Form */
        .contact-form-section {
            background: rgba(37, 11, 6, 0.75);
            border-radius: var(--border-radius);
            border: 1px solid rgba(252, 169, 148, 0.2);
            padding: 2rem;
        }
        
        .contact-form-section h2 {
            font-size: 1.8rem;
            color: var(--golden-glow);
            margin-bottom: 1.5rem;
            padding-bottom: 0.8rem;
            border-bottom: 1px solid rgba(252, 169, 148, 0.2);
        }
        
        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .form-group label {
            color: var(--soft-peach);
            font-size: 0.85rem;
            font-weight: 500;
        }
        
        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 0.8rem 1rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(252, 169, 148, 0.3);
            border-radius: var(--border-radius);
            color: #FFFFFF;
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            transition: var(--transition);
        }
        
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--golden-glow);
            background: rgba(255, 255, 255, 0.1);
        }
        
        .form-group select option {
            background: var(--rich-ebony);
            color: #FFFFFF;
        }
        
        .form-group textarea {
            resize: vertical;
            min-height: 120px;
        }
        
        .submit-btn {
            padding: 1rem;
            background: linear-gradient(135deg, var(--vibrant-ember), var(--soft-peach));
            border: none;
            border-radius: 40px;
            color: var(--rich-ebony);
            font-weight: 600;
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
            margin-top: 0.5rem;
        }
        
        .submit-btn:hover {
            background: linear-gradient(135deg, var(--golden-glow), var(--vibrant-ember));
            transform: translateY(-2px);
        }
        
        /* Map Section */
        .map-section {
            margin-bottom: var(--spacing-xl);
        }
        
        .map-section h2 {
            font-size: 1.8rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--golden-glow);
        }
        
        .map-container {
            border-radius: var(--border-radius);
            overflow: hidden;
            height: 400px;
            background: rgba(37, 11, 6, 0.75);
            border: 1px solid rgba(252, 169, 148, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        
        .map-placeholder {
            text-align: center;
            color: rgba(255, 255, 255, 0.6);
        }
        
        .map-placeholder i {
            font-size: 3rem;
            color: var(--golden-glow);
            margin-bottom: 1rem;
        }
        
        /* FAQ Section */
        .faq-section {
            margin-bottom: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(252, 169, 148, 0.2);
        }
        
        .faq-section h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--golden-glow);
        }
        
        .faq-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }
        
        .faq-item {
            background: rgba(37, 11, 6, 0.75);
            border-radius: var(--border-radius);
            border: 1px solid rgba(252, 169, 148, 0.2);
            overflow: hidden;
            transition: var(--transition);
        }
        
        .faq-item:hover {
            border-color: var(--golden-glow);
        }
        
        .faq-question {
            width: 100%;
            padding: 1.2rem 1.5rem;
            background: none;
            border: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            transition: var(--transition);
            font-family: 'Inter', sans-serif;
            font-size: 1rem;
            font-weight: 500;
            color: var(--soft-peach);
            text-align: left;
        }
        
        .faq-question:hover {
            background: rgba(252, 169, 148, 0.05);
        }
        
        .faq-question.active {
            color: var(--golden-glow);
        }
        
        .faq-icon {
            font-size: 1.2rem;
            transition: transform 0.3s ease;
            color: var(--golden-glow);
        }
        
        .faq-question.active .faq-icon {
            transform: rotate(45deg);
        }
        
        .faq-answer {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-out;
            padding: 0 1.5rem;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            line-height: 1.6;
        }
        
        .faq-answer.active {
            max-height: 300px;
            padding: 0 1.5rem 1.2rem 1.5rem;
        }
        
        /* Responsive */
        @media (max-width: 992px) {
            .contact-layout {
                grid-template-columns: 1fr;
                gap: var(--spacing-md);
            }
            .faq-grid {
                grid-template-columns: 1fr;
            }
        }
        
        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            .form-row {
                grid-template-columns: 1fr;
            }
            h1.contact-title {
                font-size: 2.5rem;
            }
            .map-container {
                height: 300px;
            }
        }
        
        @media (max-width: 576px) {
            h1.contact-title {
                font-size: 2rem;
            }
            .contact-method {
                flex-direction: column;
                align-items: center;
                text-align: center;
            }
            .business-hours h3 {
                text-align: center;
            }
        }
        
        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 102 135 %}
        
        /* Dynamic Background Images */
        {% generate_background_images background_images 102 135 %}
        
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">
    <!-- Header -->
    {% include 'builder/public_templates/ModernEcommerce25/snippets/header1.html' %}
    
    {% for component in components %}
        {% if component.drop_zone == '1' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    <!-- Page Header -->
    <div class="page-header" id="section-102">
        <div class="container">
            <h1 class="contact-title" id="section-103">{{ text_contents.82|default:"Contact Us" }}</h1>
            <p class="contact-subtitle" id="section-104">{{ text_contents.83|default:"We'd love to hear from you. Reach out with any questions, feedback, or custom lighting inquiries." }}</p>
        </div>
    </div>
    
    {% for component in components %}
        {% if component.drop_zone == '102' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    <div class="container">
        <!-- Contact Layout -->
        <div class="contact-layout">
            <!-- Contact Information -->
            <div class="contact-info" id="section-105">
                <h2 id="section-106">{{ text_contents.84|default:"Get in Touch" }}</h2>
                <div class="contact-methods">
                    <div class="contact-method">
                        <div class="contact-icon">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div class="contact-details">
                            <h3 id="section-107">{{ text_contents.85|default:"Visit Our Showroom" }}</h3>
                            <p id="section-108">{{ text_contents.86|default:"123 Lighting Lane<br>New York, NY 10001<br>United States"|safe }}</p>
                        </div>
                    </div>
                    <div class="contact-method">
                        <div class="contact-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div class="contact-details">
                            <h3 id="section-109">{{ text_contents.87|default:"Call Us" }}</h3>
                            <p id="section-110">{{ text_contents.88|default:"+1 (555) 123-4567<br>Mon-Fri: 9AM - 6PM EST"|safe }}</p>
                        </div>
                    </div>
                    <div class="contact-method">
                        <div class="contact-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="contact-details">
                            <h3 id="section-111">{{ text_contents.89|default:"Email Us" }}</h3>
                            <p id="section-112">{{ text_contents.90|default:"hello@lumina.com<br>support@lumina.com"|safe }}</p>
                        </div>
                    </div>
                </div>
                <div class="business-hours">
                    <h3 id="section-113">{{ text_contents.91|default:"Business Hours" }}</h3>
                    <ul class="hours-list">
                        <li><span class="hours-day">Monday - Friday</span><span class="hours-time">9:00 AM - 6:00 PM</span></li>
                        <li><span class="hours-day">Saturday</span><span class="hours-time">10:00 AM - 4:00 PM</span></li>
                        <li><span class="hours-day">Sunday</span><span class="hours-time">Closed</span></li>
                    </ul>
                </div>
            </div>
            
            {% for component in components %}
                {% if component.drop_zone == '105' %}
                    <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                        {{ component.html_content|safe }}
                    </section>
                {% endif %}
            {% endfor %}
            
            <!-- Contact Form -->
            <div class="contact-form-section" id="section-114">
                <h2 id="section-115">{{ text_contents.92|default:"Send Us a Message" }}</h2>
                <form class="contact-form" id="contactForm" method="POST" action="{% url 'submit_contact_form' page.subdomain %}">
                    {% csrf_token %}
                    <input type="hidden" name="form_name" value="contact_form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="firstName">First Name *</label>
                            <input type="text" id="firstName" name="first_name" required>
                        </div>
                        <div class="form-group">
                            <label for="lastName">Last Name *</label>
                            <input type="text" id="lastName" name="last_name" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email">Email Address *</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone Number</label>
                        <input type="tel" id="phone" name="phone">
                    </div>
                    <div class="form-group">
                        <label for="subject">Subject *</label>
                        <select id="subject" name="subject" required>
                            <option value="">Select a subject</option>
                            <option value="general">General Inquiry</option>
                            <option value="order">Order Status</option>
                            <option value="custom">Custom Lighting Design</option>
                            <option value="wholesale">Wholesale Inquiry</option>
                            <option value="support">Technical Support</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="message">Your Message *</label>
                        <textarea id="message" name="message" rows="5" required></textarea>
                    </div>
                    <button type="submit" class="submit-btn">Send Message</button>
                </form>
            </div>
        </div>
        
        {% for component in components %}
            {% if component.drop_zone == '114' %}
                <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                    {{ component.html_content|safe }}
                </section>
            {% endif %}
        {% endfor %}
        
        <!-- Map Section -->
        <div class="map-section" id="section-116">
            <h2 id="section-117">{{ text_contents.93|default:"Find Our Showroom" }}</h2>
            <div class="map-container" id="map-container">
                <div class="map-placeholder">
                    <i class="fas fa-map-marked-alt"></i>
                    <p>{{ text_contents.86|default:"123 Lighting Lane, New York, NY 10001"|striptags }}</p>
                    <p style="font-size: 0.8rem; margin-top: 0.5rem;">Click to view interactive map</p>
                </div>
            </div>
        </div>
        
        {% for component in components %}
            {% if component.drop_zone == '116' %}
                <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                    {{ component.html_content|safe }}
                </section>
            {% endif %}
        {% endfor %}
        
        <!-- FAQ Section - 5 Editable FAQs -->
        <div class="faq-section" id="section-118">
            <h2 id="section-119">{{ text_contents.94|default:"Frequently Asked Questions" }}</h2>
            <div class="faq-grid">
                <!-- FAQ 1 -->
                <div class="faq-item" id="section-120">
                    <button class="faq-question">
                        <span id="section-121">{{ text_contents.95|default:"What is the warranty on your lighting products?" }}</span>
                        <i class="fas fa-plus faq-icon"></i>
                    </button>
                    <div class="faq-answer" id="section-122">
                        <p>{{ text_contents.96|default:"All LUMINA lighting products come with a 5-year limited warranty covering manufacturing defects and LED components. This warranty does not cover damage from improper installation, misuse, or normal wear and tear. For detailed warranty information, please refer to the documentation included with your product or contact our support team." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 2 -->
                <div class="faq-item" id="section-123">
                    <button class="faq-question">
                        <span id="section-124">{{ text_contents.97|default:"How do I determine the right size light fixture for my space?" }}</span>
                        <i class="fas fa-plus faq-icon"></i>
                    </button>
                    <div class="faq-answer" id="section-125">
                        <p>{{ text_contents.98|default:"A general rule is to add the room dimensions in feet and convert that sum to inches for the ideal fixture diameter. For dining tables, the fixture should be 12 inches narrower than the table width. Height-wise, pendants should hang 30-36 inches above a table surface. Our lighting specialists are available to help you make the perfect selection." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 3 -->
                <div class="faq-item" id="section-126">
                    <button class="faq-question">
                        <span id="section-127">{{ text_contents.99|default:"Do you offer custom lighting design services?" }}</span>
                        <i class="fas fa-plus faq-icon"></i>
                    </button>
                    <div class="faq-answer" id="section-128">
                        <p>{{ text_contents.100|default:"Yes! Our design team specializes in custom lighting solutions for residential and commercial projects. We offer personalized consultations to understand your vision and create bespoke fixtures tailored to your space. The process includes initial design concepts, material selection, and final fabrication. Contact our custom design team to get started." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 4 -->
                <div class="faq-item" id="section-129">
                    <button class="faq-question">
                        <span id="section-130">{{ text_contents.101|default:"What is your return and exchange policy?" }}</span>
                        <i class="fas fa-plus faq-icon"></i>
                    </button>
                    <div class="faq-answer" id="section-131">
                        <p>{{ text_contents.102|default:"We offer a 30-day return policy for unused items in original packaging. Custom orders are final sale. To initiate a return, please contact our customer service team with your order number. Return shipping is free for defective items; otherwise, shipping costs are the responsibility of the customer. Refunds are processed within 5-7 business days of receiving the returned item." }}</p>
                    </div>
                </div>
                
                <!-- FAQ 5 -->
                <div class="faq-item" id="section-132">
                    <button class="faq-question">
                        <span id="section-133">{{ text_contents.103|default:"How do I care for and clean my lighting fixtures?" }}</span>
                        <i class="fas fa-plus faq-icon"></i>
                    </button>
                    <div class="faq-answer" id="section-134">
                        <p>{{ text_contents.104|default:"For most fixtures, use a soft, dry microfiber cloth to gently wipe away dust. For glass components, use a damp cloth with mild soap and dry immediately. Avoid harsh chemicals, abrasive cleaners, or excess moisture. Always turn off power and allow bulbs to cool before cleaning. For specific care instructions, please refer to the product manual included with your fixture." }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {% for component in components %}
        {% if component.drop_zone == '118' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    <!-- Footer -->
    {% include 'builder/public_templates/ModernEcommerce25/snippets/footer.html' %}
    
    {% for component in components %}
        {% if component.drop_zone == 'end' %}
            <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
                {{ component.html_content|safe }}
            </section>
        {% endif %}
    {% endfor %}
    
    {% render_icon_script %}
    
    <script src="{% static 'builder/js/cart-manager.js' %}"></script>
    
    <script>
        // FAQ Accordion Functionality
        const faqButtons = document.querySelectorAll('.faq-question');
        
        faqButtons.forEach(button => {
            button.addEventListener('click', () => {
                const faqItem = button.closest('.faq-item');
                const answer = faqItem.querySelector('.faq-answer');
                const isActive = button.classList.contains('active');
                
                // Close all other FAQs (optional - keeps only one open at a time)
                faqButtons.forEach(otherButton => {
                    if (otherButton !== button) {
                        otherButton.classList.remove('active');
                        const otherAnswer = otherButton.closest('.faq-item').querySelector('.faq-answer');
                        if (otherAnswer) otherAnswer.classList.remove('active');
                    }
                });
                
                // Toggle current FAQ
                if (!isActive) {
                    button.classList.add('active');
                    answer.classList.add('active');
                } else {
                    button.classList.remove('active');
                    answer.classList.remove('active');
                }
            });
        });
        
        // Open first FAQ by default (optional)
        if (faqButtons.length > 0) {
            // Uncomment to open first FAQ by default
            // faqButtons[0].click();
        }
        
        // Contact Form Submission with AJAX
        const contactForm = document.getElementById('contactForm');
        if (contactForm) {
            contactForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const submitBtn = this.querySelector('.submit-btn');
                const originalText = submitBtn.textContent;
                submitBtn.textContent = 'Sending...';
                submitBtn.disabled = true;
                
                const formData = new FormData(this);
                
                try {
                    const response = await fetch(this.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        alert('Thank you for your message! We will get back to you within 24-48 hours.');
                        contactForm.reset();
                    } else {
                        alert(data.error || 'There was an error sending your message. Please try again.');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Network error. Please check your connection and try again.');
                } finally {
                    submitBtn.textContent = originalText;
                    submitBtn.disabled = false;
                }
            });
        }
        
        // Map placeholder click
        const mapContainer = document.getElementById('map-container');
        if (mapContainer) {
            mapContainer.addEventListener('click', function() {
                const address = "123 Lighting Lane, New York, NY 10001";
                const mapsUrl = `https://www.google.com/maps/search/${encodeURIComponent(address)}`;
                window.open(mapsUrl, '_blank');
            });
        }
        
        // Animation on scroll for FAQ items
        const faqItems = document.querySelectorAll('.faq-item');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '0';
                    entry.target.style.transform = 'translateY(20px)';
                    setTimeout(() => {
                        entry.target.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }, 100);
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        
        faqItems.forEach(item => {
            item.style.opacity = '0';
            item.style.transform = 'translateY(20px)';
            observer.observe(item);
        });
    </script>
</body>
</html>