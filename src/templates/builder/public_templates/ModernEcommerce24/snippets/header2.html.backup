{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}
{% render_icon_data icon_customizations %}

<style>
    :root {
            --bg-luxury: #fbf9e2;
            --accent-rich: #965123;
            --metallic-gold: #bf8039;
            --deep-elegance: #462415;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 8px;
            --transition: all 0.3s ease;
        }
        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-luxury);
            color: var(--deep-elegance);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: 0.5px;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Header / Navigation */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 1.5rem 0;
            background-color: rgba(251, 249, 226, 0.95);
            box-shadow: 0 2px 20px rgba(70, 36, 21, 0.05);
            transition: var(--transition);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo a {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            font-weight: 600;
            color: var(--deep-elegance);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span {
            color: var(--deep-elegance);
        }

        .logo span span {
            color: var(--metallic-gold);
        }

        .desktop-nav {
            display: flex;
            gap: 2.5rem;
        }

        .desktop-nav a {
            text-decoration: none;
            color: var(--deep-elegance);
            font-weight: 300;
            font-size: 1.05rem;
            letter-spacing: 0.5px;
            transition: var(--transition);
            position: relative;
        }

        .desktop-nav a:hover {
            color: var(--metallic-gold);
        }

        .desktop-nav a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 1px;
            background: linear-gradient(90deg, var(--metallic-gold), var(--accent-rich));
            transition: width 0.3s ease;
        }

        .desktop-nav a:hover::after {
            width: 100%;
        }

        .nav-icons {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .nav-icons i {
            font-size: 1.3rem;
            color: var(--deep-elegance);
            cursor: pointer;
            transition: var(--transition);
        }

        .nav-icons i:hover {
            color: var(--metallic-gold);
        }

        /* Account Dropdown */
        .account-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown a {
            color: var(--deep-elegance);
            padding: 1rem 1.5rem;
            text-decoration: none;
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(251, 249, 226, 0.5);
            transition: var(--transition);
            display: block;
        }

        .dropdown a:hover {
            background-color: rgba(251, 249, 226, 0.3);
            color: var(--accent-rich);
        }

        /* Hamburger Menu */
        .hamburger {
            display: none;
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--deep-elegance);
        }

        .mobile-nav {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--bg-luxury);
            z-index: 9999;
            padding: 2rem;
            transform: translateX(-100%);
            transition: transform 0.4s ease;
        }

        .mobile-nav.active {
            transform: translateX(0);
        }

        .mobile-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(70, 36, 21, 0.1);
        }

        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-nav-links a {
            text-decoration: none;
            color: var(--deep-elegance);
            font-size: 1.3rem;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(70, 36, 21, 0.05);
        }

        .back-button {
            background: none;
            border: none;
            font-size: 1.2rem;
            color: var(--deep-elegance);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .product-image-link{
            text-decoration: none;
        }

        .icon-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            text-decoration: none;
            color: inherit;
            padding: 0.4rem;
        }
        
        .wishlist-counter,
        .cart-counter {
            position: absolute;
            top: 0;
            right: 0;
            transform: translate(50%, -50%);
            background-color: grey;
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 1rem;
            font-size: 0.5rem;
        }

        .icon-btn i {
            font-size: 1.5rem;
        }

        /* Footer */
        footer {
            background-color: var(--deep-elegance);
            color: var(--bg-luxury);
            padding: var(--spacing-lg) 0;
            margin-top: var(--spacing-lg);
        }

        .footer-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 3rem;
        }

        .footer-section {
            flex: 1;
            min-width: 250px;
        }

        h3.editable-section {
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
            color: var(--metallic-gold);
        }

        .footer-column p, .footer-column a {
            color: rgba(251, 249, 226, 0.8);
            margin-bottom: 0.8rem;
            display: block;
            text-decoration: none;
            transition: var(--transition);
        }

        .footer-column a:hover {
            color: var(--metallic-gold);
        }

        .copyright {
            text-align: center;
            margin-top: 3rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(251, 249, 226, 0.1);
            color: rgba(251, 249, 226, 0.6);
            font-size: 0.9rem;
        }

        /* Responsive Styles */
        @media (max-width: 992px) {
            .desktop-nav {
                gap: 2rem;
            }
        } 

        @media (max-width: 768px) {
            .hamburger {
                display: block;
            }
            
            .desktop-nav {
                display: none;
            }
        }

        @media (max-width: 576px) {
            .footer-section{
                min-width: 100%;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}

        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}
        {% generate_hover_keyframes %}
</style>

<!-- Header -->
<header id="section-1">
    <div class="container header-container">
        <div class="logo">
            <a href="../../?page=home">
                <i class="fas fa-gem" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"Timeless<span>Elegance</span>"|safe }}</span>
            </a>
        </div>
        
        <nav class="desktop-nav">
            <a href="../../?page=home" id="section-3">{{ text_contents.2|default:"Home" }}</a>
            <a href="../../?page=products" id="section-4">{{ text_contents.3|default:"Shop" }}</a>
            <a href="../../?page=categories" id="section-5">{{ text_contents.4|default:"Collections" }}</a>
            <a href="../../?page=about" id="section-6">{{ text_contents.5|default:"About Us" }}</a>
            <a href="../../?page=contact" id="section-7">{{ text_contents.6|default:"Contact" }}</a>
        </nav>
        
        <div class="nav-icons">
            <a href="../../?page=cart" class="icon-btn">
                <span class="cart-counter">0</span>
                <i class="fas fa-shopping-cart" data-icon="2"></i>
            </a>
            <a href="../../?page=wishlist" class="icon-btn">
                <span class="wishlist-counter">0</span>
                <i class="far fa-heart" data-icon="3"></i>
            </a>
            
            <!-- USER DROPDOWN -->
            <div style="position:relative;">
                <div class="account-dropdown">
                    <i class="far fa-user" data-icon="4" onclick="toggleDropdown()" style="cursor:pointer;"></i>

                    <ul id="dropdown" class="dropdown"
                        style="display:none; position:absolute; right:0; top:40px; width:210px; background:white; border-radius:8px; padding:10px 0; list-style:none; margin:0; box-shadow:0 5px 15px rgba(0,0,0,0.15); transform:translateY(-5px); opacity:0; transition:all .2s ease;">
                    
                        <!-- Close button -->
                        <div onclick="toggleDropdown()" 
                            style="text-align:right; padding:5px 15px; cursor:pointer;">
                            <i class="fa-solid fa-xmark" data-icon="5" style="font-size:18px; color:#444;"></i>
                        </div>

                        <li><a href="{% url 'accounts:universal_login' %}?website_id={{ page.id }}&next={{ website_homepage_url|urlencode }}" id="section-8">{{ text_contents.7|default:"Sign In" }}</a></li>
                        <li><a href="{{ website_register_url }}" id="section-9">{{ text_contents.8|default:"Sign Up" }}</a></li>
                        <li><a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-10">{{ text_contents.9|default:"Orders" }}</a></li>
                        <li><a href="../../?page=wishlist" id="section-11">{{ text_contents.10|default:"Wishlist" }}</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="hamburger">
                <i class="fas fa-bars" data-icon="6"></i>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Navigation -->
<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="../../?page=home" class="logo">Timeless<span>Elegance</span></a>
        <button class="back-button" id="closeNav">
            <i class="fas fa-times" data-icon="5"></i>
        </button>
    </div>
    
    <div class="mobile-nav-links">
        <a href="../../?page=home">Home</a>
        <a href="../../?page=products">Shop</a>
        <a href="../../?page=categories">Collections</a>
        <a href="../../?page=about">About Us</a>
        <a href="../../?page=contact">Contact</a>
        <a href="../../?page=cart"><i class="fas fa-shopping-cart" data-icon="2"></i> Cart</a>
        <a href="../../?page=wishlist"><i class="far fa-heart" data-icon="3"></i> Wishlist</a>
        <a href="../../?page=account"><i class="far fa-user" data-icon="4"></i> Account</a>
    </div>
</div>

<script>
    // Mobile Navigation
    const hamburger = document.querySelector('.hamburger');
    const mobileNav = document.getElementById('mobileNav');
    const closeNav = document.getElementById('closeNav');
    
    if (hamburger) {
        hamburger.addEventListener('click', function() {
            mobileNav.classList.add('active');
        });
    }
    
    if (closeNav) {
        closeNav.addEventListener('click', function() {
            mobileNav.classList.remove('active');
        });
    }
    
    // Close mobile nav when clicking a link
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-links a');
    mobileNavLinks.forEach(link => {
        link.addEventListener('click', function() {
            mobileNav.classList.remove('active');
        });
    });
    
    // Header scroll effect
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header');
        if (header && window.scrollY > 100) {
            header.style.padding = '1rem 0';
            header.style.boxShadow = '0 5px 20px rgba(70, 36, 21, 0.1)';
        } else if (header) {
            header.style.padding = '1.5rem 0';
            header.style.boxShadow = '0 2px 20px rgba(70, 36, 21, 0.05)';
        }
    });
</script>

<!-- JAVASCRIPT User Dropdown -->
<script>
function toggleDropdown() {
    const menu = document.getElementById("dropdown");
    const isVisible = menu.style.display === "block";

    menu.style.display = isVisible ? "none" : "block";
    menu.style.opacity = isVisible ? "0" : "1";
    menu.style.transform = isVisible ? "translateY(-5px)" : "translateY(0px)";
}

// Close dropdown when clicking outside
document.addEventListener('click', function(event) {
    const dropdown = document.getElementById('dropdown');
    const userIcon = document.querySelector('.fa-user');
    
    if (dropdown && userIcon && !userIcon.contains(event.target) && !dropdown.contains(event.target)) {
        dropdown.style.display = 'none';
        dropdown.style.opacity = '0';
        dropdown.style.transform = 'translateY(-5px)';
    }
});
</script>