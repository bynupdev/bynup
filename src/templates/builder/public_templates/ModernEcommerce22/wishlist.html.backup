{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | {{ page.brand_name }} - Precision Gaming Equipment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --teal-primary: #02ABB0;
            --teal-deep: #035A69;
            --teal-darker: #024E5B;
            --cyan-accent: #01A4BD;
            --gray-soft: #DCDADE;
            --bg-dark: #0A0F12;
            --bg-card: rgba(16, 24, 28, 0.85);
            --text-light: #F0F2F4;
            --text-muted: #9CA3AF;
            --border-subtle: rgba(220, 218, 222, 0.12);
            --glow-teal: rgba(2, 171, 176, 0.3);
            --success: #28a745;
            --danger: #dc3545;
            --warning: #ffc107;
        }
        {% generate_color_variables %}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
            padding-top: 80px;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Space Grotesk', monospace;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        .page-header {
            text-align: center;
            padding: 40px 0 30px;
            background: radial-gradient(circle at 50% 0%, rgba(2, 171, 176, 0.08), transparent);
            margin-bottom: 40px;
        }

        .page-header h1 {
            font-size: 3rem;
            margin-bottom: 12px;
            position: relative;
            display: inline-block;
        }

        .page-header h1::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, var(--teal-primary), var(--cyan-accent));
            border-radius: 3px;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 1rem;
            margin-top: 20px;
        }

        .wishlist-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 50px;
            padding: 20px;
            background: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-subtle);
        }

        .stat-card {
            text-align: center;
            padding: 20px;
            background: rgba(2, 171, 176, 0.05);
            border-radius: 16px;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            background: rgba(2, 171, 176, 0.1);
            transform: translateY(-3px);
        }

        .stat-value {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--teal-primary);
            margin-bottom: 8px;
        }

        .stat-label {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .wishlist-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 40px;
            padding: 20px 0;
            border-bottom: 1px solid var(--border-subtle);
        }

        .filter-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .filter-chip {
            padding: 8px 20px;
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            color: var(--text-light);
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .filter-chip:hover {
            border-color: var(--teal-primary);
            color: var(--teal-primary);
        }

        .filter-chip.active {
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            border-color: transparent;
            color: var(--bg-dark);
        }

        .clear-wishlist-btn {
            padding: 8px 24px;
            background: rgba(220, 53, 69, 0.1);
            border: 1px solid var(--danger);
            border-radius: 40px;
            color: var(--danger);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
        }

        .clear-wishlist-btn:hover {
            background: var(--danger);
            color: white;
        }

        .wishlist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 60px;
        }

        .wishlist-card {
            background: var(--bg-card);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid var(--border-subtle);
            position: relative;
        }

        .wishlist-card:hover {
            transform: translateY(-8px);
            border-color: var(--teal-primary);
            box-shadow: 0 20px 35px -12px rgba(2, 171, 176, 0.2);
        }

        .wishlist-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .wishlist-card:hover .wishlist-image {
            transform: scale(1.03);
        }

        .wishlist-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            z-index: 2;
        }

        .wishlist-info {
            padding: 20px;
        }

        .wishlist-category {
            color: var(--teal-primary);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .wishlist-name {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .wishlist-price {
            color: var(--teal-primary);
            font-weight: 700;
            font-size: 1.2rem;
            margin-bottom: 15px;
        }

        .wishlist-actions-buttons {
            display: flex;
            gap: 12px;
        }

        .move-to-cart-btn {
            flex: 1;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            border: none;
            padding: 10px 0;
            border-radius: 40px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .move-to-cart-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px var(--glow-teal);
        }

        .remove-wishlist-btn {
            width: 42px;
            background: rgba(220, 218, 222, 0.1);
            border: 1px solid var(--border-subtle);
            border-radius: 40px;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .remove-wishlist-btn:hover {
            border-color: var(--danger);
            color: var(--danger);
        }

        .empty-wishlist {
            text-align: center;
            padding: 80px 20px;
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid var(--border-subtle);
            grid-column: 1 / -1;
        }

        .empty-wishlist-icon {
            font-size: 5rem;
            color: var(--text-muted);
            margin-bottom: 24px;
        }

        .empty-wishlist h2 {
            font-size: 2rem;
            margin-bottom: 16px;
        }

        .empty-wishlist p {
            color: var(--text-muted);
            margin-bottom: 32px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .browse-shop-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            padding: 14px 40px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .browse-shop-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px var(--glow-teal);
        }

        .recently-viewed {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 1px solid var(--border-subtle);
        }

        .recently-viewed h2 {
            font-size: 2rem;
            margin-bottom: 40px;
            text-align: center;
        }

        .recent-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 40px;
        }

        .recent-card {
            background: var(--bg-card);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid var(--border-subtle);
            text-decoration: none;
            display: block;
        }

        .recent-card:hover {
            transform: translateY(-5px);
            border-color: var(--teal-primary);
            box-shadow: 0 10px 30px rgba(2, 171, 176, 0.2);
        }

        .recent-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
        }

        .recent-info {
            padding: 16px;
        }

        .recent-name {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-light);
        }

        .recent-price {
            color: var(--teal-primary);
            font-weight: 700;
        }

        .empty-recent {
            text-align: center;
            padding: 60px;
            background: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-subtle);
            grid-column: 1 / -1;
        }

        .empty-recent i {
            font-size: 3rem;
            color: var(--text-muted);
            margin-bottom: 16px;
        }

        .empty-recent p {
            color: var(--text-muted);
        }

        @media (max-width: 1200px) {
            .wishlist-grid,
            .recent-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .wishlist-stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 992px) {
            .wishlist-grid,
            .recent-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 70px;
            }
            .container {
                padding: 0 20px;
            }
            .page-header h1 {
                font-size: 2.2rem;
            }
            .wishlist-stats {
                grid-template-columns: repeat(2, 1fr);
            }
            .wishlist-grid,
            .recent-grid {
                grid-template-columns: 1fr;
                max-width: 380px;
                margin-left: auto;
                margin-right: auto;
            }
            .wishlist-actions {
                flex-direction: column;
                align-items: stretch;
            }
            .filter-buttons {
                justify-content: center;
            }
            .clear-wishlist-btn {
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .wishlist-stats {
                grid-template-columns: 1fr;
            }
        }

        {% generate_section_styles style_customizations 105 130 %}
        {% generate_background_images background_images 105 130 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

{% include 'builder/public_templates/ModernEcommerce22/snippets/header1.html' %}

{% for component in components %}
    {% if component.drop_zone == '105' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Page Header -->
<div class="page-header" id="section-105">
    <div class="container">
        <h1 id="section-106">{{ text_contents.76|default:"My Wishlist" }}</h1>
        <p id="section-107">{{ text_contents.77|default:"Save your favorite gaming gear and come back later" }}</p>
    </div>
</div>

<div class="container">
    <!-- Wishlist Stats -->
    <div class="wishlist-stats" id="section-108">
        <div class="stat-card">
            <div class="stat-value" id="totalItems">{{ wishlist_items|length|default:"0" }}</div>
            <div class="stat-label">Total Items</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="totalValue">{{ wish_price_total|currency:page|default:"$0.00" }}</div>
            <div class="stat-label">Total Value</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="inStockItems">{{ in_stock_count|default:"0" }}</div>
            <div class="stat-label">In Stock</div>
        </div>
        <div class="stat-card">
            <div class="stat-value" id="onSaleItems">{{ on_sale_count|default:"0" }}</div>
            <div class="stat-label">On Sale</div>
        </div>
    </div>

    <!-- Wishlist Actions -->
    <div class="wishlist-actions" id="section-109">
        <div class="filter-buttons">
            <button class="filter-chip active" data-filter="all">All Items</button>
            <button class="filter-chip" data-filter="in-stock">In Stock</button>
            <button class="filter-chip" data-filter="sale">On Sale</button>
        </div>
        <button class="clear-wishlist-btn" id="clearWishlistBtn">
            <i class="fas fa-trash-alt"></i> Clear All
        </button>
    </div>

    <!-- Wishlist Grid -->
    <div class="wishlist-grid" id="wishlistGrid">
        {% if wishlist_items %}
            {% for item in wishlist_items %}
            <div class="wishlist-card" 
                 data-category="{{ item.product.category.name|default:''|lower }}"
                 data-stock="{% if item.product.quantity > 0 %}in-stock{% else %}out-of-stock{% endif %}"
                 data-sale="{% if item.product.compare_at_price and item.product.compare_at_price > item.product.price %}true{% else %}false{% endif %}"
                 data-product-id="{{ item.product.id }}"
                 data-product-price="{{ item.product.price }}">
                {% if item.product.compare_at_price and item.product.compare_at_price > item.product.price %}
                <div class="wishlist-badge">Sale</div>
                {% elif forloop.first %}
                <div class="wishlist-badge">New</div>
                {% endif %}
                <img src="{% if item.product.main_image %}{{ item.product.main_image.url }}{% else %}https://images.pexels.com/photos/2115256/pexels-photo-2115256.jpeg?auto=compress&cs=tinysrgb&w=400{% endif %}" alt="{{ item.product.title }}" class="wishlist-image">
                <div class="wishlist-info">
                    <div class="wishlist-category" id="section-111">{{ item.product.category.name|default:"GAMING"|upper }}</div>
                    <div class="wishlist-name" id="section-112">{{ item.product.title }}</div>
                    <div class="wishlist-price" id="section-113">
                        {{ item.product.price|currency:page }}
                        {% if item.product.compare_at_price and item.product.compare_at_price > item.product.price %}
                        <span style="text-decoration: line-through; font-size: 0.8rem; color: var(--text-muted); margin-left: 8px;">{{ item.product.compare_at_price|currency:page }}</span>
                        {% endif %}
                    </div>
                    <div class="wishlist-actions-buttons">
                        <button class="move-to-cart-btn" data-product-id="{{ item.product.id }}">
                            <i class="fas fa-cart-plus"></i> Move to Cart
                        </button>
                        <button class="remove-wishlist-btn" data-product-id="{{ item.product.id }}">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>
            {% endfor %}
        {% else %}
            <div class="empty-wishlist">
                <div class="empty-wishlist-icon">
                    <i class="far fa-heart"></i>
                </div>
                <h2>{{ text_contents.137|default:"Your Wishlist is Empty" }}</h2>
                <p>{{ text_contents.138|default:"Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready." }}</p>
                <a href="?page=products" class="browse-shop-btn" id="section-178">{{ text_contents.139|default:"Start Shopping" }}</a>
            </div>
        {% endif %}
    </div>

    <!-- Recently Viewed Section -->
    <div class="recently-viewed" id="section-114">
        <h2 id="section-115">{{ text_contents.81|default:"Recently Viewed" }}</h2>
        {% if recently_viewed_products %}
        <div class="recent-grid" id="recentGrid">
            {% for rvp in recently_viewed_products|slice:":4" %}
            <a href="/product/{{ rvp.product.slug }}/" class="recent-card">
                <img src="{% if rvp.product.main_image %}{{ rvp.product.main_image.url }}{% else %}https://images.pexels.com/photos/2115258/pexels-photo-2115258.jpeg?auto=compress&cs=tinysrgb&w=400{% endif %}" alt="{{ rvp.product.title }}" class="recent-img">
                <div class="recent-info">
                    <div class="recent-name">{{ rvp.product.title|truncatechars:30 }}</div>
                    <div class="recent-price">{{ rvp.product.price|currency:page }}</div>
                </div>
            </a>
            {% endfor %}
        </div>
        {% else %}
        <div class="empty-recent">
            <i class="fas fa-history"></i>
            <p>No recently viewed products. Start browsing our collection!</p>
        </div>
        {% endif %}
    </div>
</div>

{% for component in components %}
    {% if component.drop_zone == '114' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% include 'builder/public_templates/ModernEcommerce22/snippets/footer.html' %}

{% for component in components %}
    {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% render_icon_script %}
<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
    // Wishlist Data from Backend
    let wishlistItems = [
        {% for item in wishlist_items %}
        {
            id: {{ item.product.id }},
            name: "{{ item.product.title|escapejs }}",
            category: "{{ item.product.category.name|default:''|lower }}",
            price: {{ item.product.price }},
            stock: "{% if item.product.quantity > 0 %}in-stock{% else %}out-of-stock{% endif %}",
            sale: {% if item.product.compare_at_price and item.product.compare_at_price > item.product.price %}true{% else %}false{% endif %},
            originalPrice: {% if item.product.compare_at_price %}{{ item.product.compare_at_price }}{% else %}null{% endif %}
        }{% if not forloop.last %},{% endif %}
        {% endfor %}
    ];
    
    let currentFilter = 'all';
    
    // Update Stats
    function updateStats() {
        const totalItems = wishlistItems.length;
        const totalValue = wishlistItems.reduce((sum, item) => sum + item.price, 0);
        const inStockItems = wishlistItems.filter(item => item.stock === 'in-stock').length;
        const onSaleItems = wishlistItems.filter(item => item.sale === true).length;
        
        const currencySymbol = '{{ page.currency_symbol|default:"$" }}';
        document.getElementById('totalItems').textContent = totalItems;
        document.getElementById('totalValue').textContent = currencySymbol + totalValue.toFixed(2);
        document.getElementById('inStockItems').textContent = inStockItems;
        document.getElementById('onSaleItems').textContent = onSaleItems;
    }
    
    // Filter Wishlist Items
    function filterWishlist() {
        const items = document.querySelectorAll('.wishlist-card');
        let visibleCount = 0;
        
        items.forEach((item, index) => {
            const category = item.dataset.category;
            const stock = item.dataset.stock;
            const sale = item.dataset.sale === 'true';
            let shouldShow = true;
            
            if (currentFilter === 'in-stock') {
                shouldShow = stock === 'in-stock';
            } else if (currentFilter === 'sale') {
                shouldShow = sale === true;
            }
            
            if (shouldShow) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });
        
        // Show empty state if no items
        const wishlistGrid = document.getElementById('wishlistGrid');
        const existingEmpty = document.querySelector('.empty-wishlist-state');
        
        if (visibleCount === 0 && wishlistItems.length > 0) {
            if (!existingEmpty) {
                const emptyDiv = document.createElement('div');
                emptyDiv.className = 'empty-wishlist empty-wishlist-state';
                emptyDiv.style.gridColumn = '1 / -1';
                emptyDiv.innerHTML = `
                    <div class="empty-wishlist-icon">
                        <i class="fas fa-filter"></i>
                    </div>
                    <h2>No Items Match Your Filter</h2>
                    <p>Try selecting a different filter to see your saved items.</p>
                    <button onclick="resetFilter()" class="browse-shop-btn" style="background: var(--teal-primary); border: none; cursor: pointer;">Clear Filters</button>
                `;
                wishlistGrid.appendChild(emptyDiv);
            }
        } else if (existingEmpty) {
            existingEmpty.remove();
        }
    }
    
    window.resetFilter = function() {
        currentFilter = 'all';
        document.querySelectorAll('.filter-chip').forEach(chip => {
            chip.classList.remove('active');
            if (chip.dataset.filter === 'all') chip.classList.add('active');
        });
        filterWishlist();
    };
    
    // Filter Chips
    document.querySelectorAll('.filter-chip').forEach(chip => {
        chip.addEventListener('click', function() {
            document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
            this.classList.add('active');
            currentFilter = this.dataset.filter;
            filterWishlist();
        });
    });
    
    // Move to Cart
    document.querySelectorAll('.move-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = parseInt(this.dataset.productId);
            const product = wishlistItems.find(i => i.id === productId);
            
            if (product && window.cartManager) {
                window.cartManager.addToCart(productId, 1);
                window.cartManager.removeFromWishlist(productId);
                
                const index = wishlistItems.findIndex(i => i.id === productId);
                wishlistItems.splice(index, 1);
                
                const card = this.closest('.wishlist-card');
                if (card) card.remove();
                
                updateStats();
                showNotification(`${product.name} moved to cart!`, 'success');
                
                if (wishlistItems.length === 0) {
                    showEmptyWishlist();
                }
            } else if (product) {
                showNotification(`${product.name} added to cart!`, 'success');
                const index = wishlistItems.findIndex(i => i.id === productId);
                wishlistItems.splice(index, 1);
                const card = this.closest('.wishlist-card');
                if (card) card.remove();
                updateStats();
                if (wishlistItems.length === 0) showEmptyWishlist();
            }
        });
    });
    
    // Remove from Wishlist
    document.querySelectorAll('.remove-wishlist-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = parseInt(this.dataset.productId);
            const product = wishlistItems.find(i => i.id === productId);
            
            if (product) {
                if (window.cartManager) {
                    window.cartManager.removeFromWishlist(productId);
                }
                
                const index = wishlistItems.findIndex(i => i.id === productId);
                wishlistItems.splice(index, 1);
                
                const card = this.closest('.wishlist-card');
                if (card) card.remove();
                
                updateStats();
                showNotification(`${product.name} removed from wishlist`, 'info');
                
                if (wishlistItems.length === 0) {
                    showEmptyWishlist();
                }
            }
        });
    });
    
    // Clear All Wishlist
    const clearWishlistBtn = document.getElementById('clearWishlistBtn');
    if (clearWishlistBtn) {
        clearWishlistBtn.addEventListener('click', function() {
            if (wishlistItems.length === 0) {
                showNotification('Your wishlist is already empty', 'info');
                return;
            }
            
            if (confirm('Are you sure you want to clear your entire wishlist? This action cannot be undone.')) {
                if (window.cartManager) {
                    window.cartManager.clearWishlist();
                }
                wishlistItems = [];
                updateStats();
                showEmptyWishlist();
                showNotification('Wishlist cleared', 'success');
            }
        });
    }
    
    function showEmptyWishlist() {
        const wishlistGrid = document.getElementById('wishlistGrid');
        wishlistGrid.innerHTML = `
            <div class="empty-wishlist" style="grid-column: 1 / -1;">
                <div class="empty-wishlist-icon">
                    <i class="far fa-heart"></i>
                </div>
                <h2>{{ text_contents.137|default:"Your Wishlist is Empty" }}</h2>
                <p>{{ text_contents.138|default:"Save items you love by clicking the heart icon. Come back here to view them all and purchase when you're ready." }}</p>
                <a href="?page=products" class="browse-shop-btn">Start Shopping</a>
            </div>
        `;
    }
    
    function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 100px;
            right: 20px;
            background: ${type === 'success' ? 'var(--teal-primary)' : type === 'error' ? 'var(--danger)' : 'var(--text-muted)'};
            color: ${type === 'success' ? 'var(--bg-dark)' : 'white'};
            padding: 14px 24px;
            border-radius: 50px;
            font-weight: 500;
            z-index: 10000;
            animation: slideIn 0.3s ease;
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        `;
        notification.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'}"></i> ${message}`;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }
    
    // Add animation styles
    if (!document.querySelector('#notification-styles')) {
        const style = document.createElement('style');
        style.id = 'notification-styles';
        style.textContent = `
            @keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);
    }
    
    // Initialize
    if (wishlistItems.length > 0) {
        updateStats();
    }
</script>
</body>
</html>