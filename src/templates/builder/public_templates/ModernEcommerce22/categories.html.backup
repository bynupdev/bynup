{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories | {{ page.brand_name }} - Precision Gaming Equipment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --teal-primary: #02ABB0;
            --teal-deep: #035A69;
            --teal-darker: #024E5B;
            --cyan-accent: #01A4BD;
            --gray-soft: #DCDADE;
            --bg-dark: #0A0F12;
            --bg-card: rgba(16, 24, 28, 0.85);
            --text-light: #F0F2F4;
            --text-muted: #9CA3AF;
            --border-subtle: rgba(220, 218, 222, 0.12);
            --glow-teal: rgba(2, 171, 176, 0.3);
        }
        {% generate_color_variables %}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
            padding-top: 80px;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Space Grotesk', monospace;
            font-weight: 600;
            letter-spacing: -0.02em;
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 32px;
        }

        .page-header {
            text-align: center;
            padding: 40px 0 30px;
            background: radial-gradient(circle at 50% 0%, rgba(2, 171, 176, 0.08), transparent);
            margin-bottom: 40px;
        }

        .page-header h1 {
            font-size: 3rem;
            margin-bottom: 12px;
            position: relative;
            display: inline-block;
        }

        .page-header h1::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, var(--teal-primary), var(--cyan-accent));
            border-radius: 3px;
        }

        .page-header p {
            color: var(--text-muted);
            font-size: 1rem;
            margin-top: 20px;
        }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
            margin-bottom: 80px;
        }

        .category-card {
            background: var(--bg-card);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid var(--border-subtle);
            position: relative;
            text-decoration: none;
            display: block;
        }

        .category-card:hover {
            transform: translateY(-10px);
            border-color: var(--teal-primary);
            box-shadow: 0 20px 35px -12px rgba(2, 171, 176, 0.2);
        }

        .category-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .category-card:hover .category-image {
            transform: scale(1.05);
        }

        .category-info {
            padding: 24px;
        }

        .category-icon {
            font-size: 2.5rem;
            color: var(--teal-primary);
            margin-bottom: 16px;
        }

        .category-name {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .category-count {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 12px;
        }

        .category-description {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .explore-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--teal-primary);
            font-weight: 500;
            font-size: 0.9rem;
            transition: gap 0.3s ease;
        }

        .category-card:hover .explore-link {
            gap: 12px;
        }

        .featured-section {
            margin-bottom: 80px;
        }

        .featured-section h2 {
            font-size: 2rem;
            margin-bottom: 40px;
            text-align: center;
        }

        .featured-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .featured-card {
            background: var(--bg-card);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid var(--border-subtle);
            text-decoration: none;
            display: block;
        }

        .featured-card:hover {
            transform: translateY(-5px);
            border-color: var(--teal-primary);
            box-shadow: 0 15px 30px rgba(2, 171, 176, 0.15);
        }

        .featured-img {
            width: 100%;
            aspect-ratio: 1.2 / 1;
            object-fit: cover;
        }

        .featured-info {
            padding: 20px;
        }

        .featured-name {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .featured-products-count {
            color: var(--teal-primary);
            font-size: 0.85rem;
            margin-bottom: 8px;
        }

        .featured-desc {
            color: var(--text-muted);
            font-size: 0.85rem;
            line-height: 1.5;
        }

        .guide-section {
            background: linear-gradient(135deg, rgba(2, 171, 176, 0.05), rgba(1, 164, 189, 0.02));
            border-radius: 24px;
            padding: 60px 40px;
            margin-bottom: 60px;
            border: 1px solid var(--border-subtle);
        }

        .guide-section h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: 40px;
        }

        .guide-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 40px;
        }

        .guide-item {
            text-align: center;
            padding: 20px;
        }

        .guide-icon {
            font-size: 2.5rem;
            color: var(--teal-primary);
            margin-bottom: 16px;
        }

        .guide-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .guide-desc {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .empty-categories {
            text-align: center;
            padding: 80px 20px;
            background: var(--bg-card);
            border-radius: 24px;
            border: 1px solid var(--border-subtle);
            grid-column: 1 / -1;
        }

        .empty-categories-icon {
            font-size: 5rem;
            color: var(--text-muted);
            margin-bottom: 24px;
        }

        .empty-categories h2 {
            font-size: 2rem;
            margin-bottom: 16px;
        }

        .empty-categories p {
            color: var(--text-muted);
            margin-bottom: 32px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .add-category-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--teal-primary), var(--cyan-accent));
            color: var(--bg-dark);
            padding: 14px 40px;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .add-category-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px var(--glow-teal);
        }

        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .featured-grid,
            .guide-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 992px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 70px;
            }
            .container {
                padding: 0 20px;
            }
            .page-header h1 {
                font-size: 2.2rem;
            }
            .categories-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .featured-grid,
            .guide-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            .guide-section {
                padding: 40px 20px;
            }
        }

        {% generate_section_styles style_customizations 116 140 %}
        {% generate_background_images background_images 116 140 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

{% include 'builder/public_templates/ModernEcommerce22/snippets/header1.html' %}

{% for component in components %}
    {% if component.drop_zone == '116' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Page Header -->
<div class="page-header" id="section-116">
    <div class="container">
        <h1 id="section-117">{{ text_contents.82|default:"Gear Categories" }}</h1>
        <p id="section-118">{{ text_contents.83|default:"Explore our curated collections of professional gaming equipment" }}</p>
    </div>
</div>

<div class="container">
    <!-- Categories Grid -->
    <div class="categories-grid" id="categoriesGrid">
        {% if categories %}
            {% for category in categories %}
            <a href="?page=products&category={{ category.slug }}" class="category-card" data-category-id="{{ category.id }}">
                {% if category.image %}
                    <img src="{{ category.image.url }}" alt="{{ category.name }}" class="category-image">
                {% else %}
                    <div class="category-image" style="background: linear-gradient(135deg, var(--teal-deep), var(--teal-darker)); display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-folder-open" style="font-size: 4rem; color: var(--teal-primary);"></i>
                    </div>
                {% endif %}
                <div class="category-info">
                    <div class="category-icon">
                        {% if category.icon %}
                            <i class="{{ category.icon }}"></i>
                        {% else %}
                            <i class="fas fa-folder"></i>
                        {% endif %}
                    </div>
                    <h3 class="category-name">{{ category.name }}</h3>
                    <div class="category-count">
                        {% if category.get_active_products_count %}
                            {{ category.get_active_products_count }} Products
                        {% else %}
                            {{ category.get_total_products_count|default:"0" }} Products
                        {% endif %}
                    </div>
                    <p class="category-description">{{ category.description|default:"Explore our collection of premium gaming gear in this category."|truncatechars:100 }}</p>
                    <span class="explore-link">Explore Collection <i class="fas fa-arrow-right"></i></span>
                </div>
            </a>
            {% endfor %}
        {% else %}
            <div class="empty-categories">
                <div class="empty-categories-icon">
                    <i class="fas fa-folder-open"></i>
                </div>
                <h2>No Categories Available</h2>
                <p>There are no gaming gear categories to display at the moment. Categories will appear here once they are added to your store.</p>
                <a href="/admin/add-category" class="add-category-btn">Add Your First Category</a>
            </div>
        {% endif %}
    </div>

    <!-- Featured Categories Section (only show if categories exist) -->
    {% if categories %}
    <div class="featured-section" id="section-123">
        <h2 id="section-124">{{ text_contents.87|default:"Featured Collections" }}</h2>
        <div class="featured-grid">
            {% for category in categories|slice:":3" %}
            <a href="?page=products&category={{ category.slug }}" class="featured-card">
                {% if category.image %}
                    <img src="{{ category.image.url }}" alt="{{ category.name }}" class="featured-img">
                {% else %}
                    <div class="featured-img" style="background: linear-gradient(135deg, var(--teal-deep), var(--teal-darker)); display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-gem" style="font-size: 3rem; color: var(--teal-primary);"></i>
                    </div>
                {% endif %}
                <div class="featured-info">
                    <h3 class="featured-name">{{ category.name }}</h3>
                    <div class="featured-products-count">{{ category.get_active_products_count|default:"0" }} Products</div>
                    <p class="featured-desc">{{ category.description|default:"Premium gaming gear for the modern warrior."|truncatechars:80 }}</p>
                </div>
            </a>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Category Guide Section -->
    <div class="guide-section" id="section-125">
        <h2 id="section-126">{{ text_contents.88|default:"Gear Selection Guide" }}</h2>
        <div class="guide-grid">
            <div class="guide-item">
                <div class="guide-icon"><i class="fas fa-tachometer-alt"></i></div>
                <h3 class="guide-title">Performance First</h3>
                <p class="guide-desc">Choose gear based on your gaming style - FPS, MOBA, or RPG optimized equipment for maximum competitive advantage.</p>
            </div>
            <div class="guide-item">
                <div class="guide-icon"><i class="fas fa-hand-peace"></i></div>
                <h3 class="guide-title">Ergonomics Matter</h3>
                <p class="guide-desc">Find the perfect fit with our ergonomic designs for marathon gaming sessions, reducing fatigue and improving performance.</p>
            </div>
            <div class="guide-item">
                <div class="guide-icon"><i class="fas fa-bluetooth"></i></div>
                <h3 class="guide-title">Connectivity</h3>
                <p class="guide-desc">Choose between wired for zero latency or wireless for maximum freedom with our cutting-edge wireless technology.</p>
            </div>
        </div>
    </div>
</div>

{% for component in components %}
    {% if component.drop_zone == '125' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% include 'builder/public_templates/ModernEcommerce22/snippets/footer.html' %}

{% for component in components %}
    {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% render_icon_script %}
<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
    // Animate category cards on scroll
    const categoryCards = document.querySelectorAll('.category-card');
    
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };
    
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);
    
    categoryCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px)';
        card.style.transition = `opacity 0.5s ease ${index * 0.1}s, transform 0.5s ease ${index * 0.1}s`;
        observer.observe(card);
    });
    
    // Featured cards animation
    const featuredCards = document.querySelectorAll('.featured-card');
    featuredCards.forEach((card, index) => {
        card.style.opacity = '0';
        card.style.transform = 'translateY(30px)';
        card.style.transition = `opacity 0.5s ease ${0.3 + index * 0.1}s, transform 0.5s ease ${0.3 + index * 0.1}s`;
        observer.observe(card);
    });
    
    // Guide items animation
    const guideItems = document.querySelectorAll('.guide-item');
    guideItems.forEach((item, index) => {
        item.style.opacity = '0';
        item.style.transform = 'translateY(20px)';
        item.style.transition = `opacity 0.5s ease ${0.6 + index * 0.1}s, transform 0.5s ease ${0.6 + index * 0.1}s`;
        observer.observe(item);
    });
</script>
</body>
</html>