    {% for component in components %}
        {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
        {% endif %}
    {% endfor %}

    <script>
        // Carousel functionality
        const carousels = {
            'popular': {
                element: document.getElementById('popular-carousel'),
                indicators: document.getElementById('popular-indicators'),
                currentSlide: 0,
                totalSlides: 3,
                autoSlideInterval: null
            },
            'category': {
                element: document.getElementById('category-carousel'),
                indicators: document.getElementById('category-indicators'),
                currentSlide: 0,
                totalSlides: 3,
                autoSlideInterval: null
            }
        };

        // Initialize carousels
        function initCarousels() {
            for (const carouselId in carousels) {
                const carousel = carousels[carouselId];
                startAutoSlide(carouselId);
            }
        }

        // Move carousel
        function moveCarousel(carouselId, direction) {
            const carousel = carousels[carouselId];
            const cardWidth = carousel.element.querySelector('.product-card').offsetWidth + 20;
            
            carousel.currentSlide += direction;
            
            // Handle wrap-around
            if (carousel.currentSlide < 0) {
                carousel.currentSlide = carousel.totalSlides - 1;
            } else if (carousel.currentSlide >= carousel.totalSlides) {
                carousel.currentSlide = 0;
            }
            
            updateCarousel(carouselId);
            resetAutoSlide(carouselId);
        }

        // Go to specific slide
        function goToSlide(carouselId, slideIndex) {
            carousels[carouselId].currentSlide = slideIndex;
            updateCarousel(carouselId);
            resetAutoSlide(carouselId);
        }

        // Update carousel position and indicators
        function updateCarousel(carouselId) {
            const carousel = carousels[carouselId];
            const cardWidth = carousel.element.querySelector('.product-card').offsetWidth + 20;
            const translateX = -carousel.currentSlide * (cardWidth * 4); // 4 cards per slide
            
            carousel.element.style.transform = `translateX(${translateX}px)`;
            
            // Update indicators
            const indicators = carousel.indicators.querySelectorAll('.indicator');
            indicators.forEach((indicator, index) => {
                indicator.classList.toggle('active', index === carousel.currentSlide);
            });
        }

        // Auto slide functionality
        function startAutoSlide(carouselId) {
            carousels[carouselId].autoSlideInterval = setInterval(() => {
                moveCarousel(carouselId, 1);
            }, 5000); // Change slide every 5 seconds
        }

        function resetAutoSlide(carouselId) {
            clearInterval(carousels[carouselId].autoSlideInterval);
            startAutoSlide(carouselId);
        }

        // Mobile menu functionality
        document.getElementById('mobile-menu-toggle').addEventListener('click', function() {
            document.getElementById('main-nav').classList.toggle('active');
        });

        // Placeholder functions for cart/wishlist (to be handled by Django)
        function addToCart(productId) {
            // This will be handled by Django AJAX
            console.log('Add to cart:', productId);
        }

        function addToWishlist(productId) {
            // This will be handled by Django AJAX
            console.log('Add to wishlist:', productId);
        }

        // Initialize on page load
        window.addEventListener('load', initCarousels);
    </script>
</body>
</html>
