<!-- builder/public_templates/ModernEcommerce16/snippets/header.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

{% render_icon_data icon_customizations %}

<style>
    :root {
        --soft-blush: #FAEEE9;
        --champagne-glow: #F5D69B;
        --mauve-rose: #A77A95;
        --lavender-mist: #C3C3D5;
        --plum-brown: #735366;
        --spacing-xl: 6rem;
        --spacing-lg: 4rem;
        --spacing-md: 2rem;
        --spacing-sm: 1rem;
        --border-radius: 12px;
        --transition: all 0.3s ease;
    }
    {% generate_color_variables %}

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Montserrat', sans-serif;
        background-color: var(--soft-blush);
        color: var(--plum-brown);
        overflow-x: hidden;
        line-height: 1.6;
        padding-top: 80px;
    }

    h1, h2, h3, h4, .logo a {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 500;
        letter-spacing: -0.01em;
    }

    .container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Header / Navigation */
    header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        padding: 1.2rem 0;
        background-color: rgba(250, 238, 233, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(167, 122, 149, 0.15);
        transition: var(--transition);
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo a {
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--plum-brown);
        text-decoration: none;
        letter-spacing: 1px;
    }

    .logo span {
        font-weight: 300;
        font-size: 0.9rem;
        letter-spacing: 2px;
        color: var(--mauve-rose);
        margin-left: 6px;
    }

    .desktop-nav {
        display: flex;
        gap: 2.5rem;
        list-style: none;
    }

    .desktop-nav a {
        text-decoration: none;
        color: var(--plum-brown);
        font-weight: 400;
        font-size: 0.95rem;
        transition: var(--transition);
        letter-spacing: 0.5px;
        position: relative;
    }

    .desktop-nav a:hover {
        color: var(--mauve-rose);
    }

    .desktop-nav a::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 1px;
        background: linear-gradient(90deg, var(--mauve-rose), var(--champagne-glow));
        transition: width 0.3s ease;
    }

    .desktop-nav a:hover::after {
        width: 100%;
    }

    .nav-icons {
        display: flex;
        gap: 1.5rem;
        align-items: center;
    }

    .icon-btn {
        position: relative;
        background: none;
        border: none;
        font-size: 1.2rem;
        color: var(--plum-brown);
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        padding: 0.4rem;
    }

    .icon-btn:hover {
        color: var(--mauve-rose);
    }

    .cart-counter, .wishlist-counter {
        position: absolute;
        top: -8px;
        right: -12px;
        background-color: var(--mauve-rose);
        color: var(--soft-blush);
        padding: 0.2rem 0.5rem;
        border-radius: 20px;
        font-size: 0.7rem;
        font-weight: 500;
        min-width: 18px;
        text-align: center;
    }

    /* Account Dropdown */
    .account-dropdown {
        position: relative;
        display: inline-block;
    }

    .dropdown {
        position: absolute;
        right: 0;
        top: 100%;
        width: 210px;
        background: white;
        border-radius: var(--border-radius);
        padding: 10px 0;
        list-style: none;
        margin: 0;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
        transform: translateY(-5px);
        opacity: 0;
        transition: all 0.2s ease;
        z-index: 1001;
        border: 1px solid rgba(167, 122, 149, 0.2);
    }

    .dropdown.show {
        display: block !important;
        opacity: 1 !important;
        transform: translateY(0) !important;
    }

    .dropdown a {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 20px;
        text-decoration: none;
        color: var(--plum-brown);
        transition: 0.2s;
        font-size: 0.9rem;
    }

    .dropdown a:hover {
        background-color: rgba(245, 214, 155, 0.3);
        transform: translateX(4px);
    }

    .dropdown .dropdown-close {
        text-align: right;
        padding: 5px 15px;
        cursor: pointer;
        font-size: 18px;
        color: var(--plum-brown);
    }

    .dropdown .dropdown-close:hover {
        color: var(--mauve-rose);
    }

    /* Hamburger Menu */
    .hamburger {
        display: none;
        cursor: pointer;
        font-size: 1.5rem;
        color: var(--plum-brown);
        background: none;
        border: none;
        padding: 0.4rem;
    }

    .mobile-nav {
        position: fixed;
        top: 0;
        right: -100%;
        width: 80%;
        max-width: 320px;
        height: 100vh;
        background-color: var(--soft-blush);
        z-index: 9999;
        padding: 2rem;
        transition: right 0.3s ease;
        box-shadow: -5px 0 30px rgba(115, 83, 102, 0.1);
        display: flex;
        flex-direction: column;
    }

    .mobile-nav.active {
        right: 0;
    }

    .mobile-nav-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(115, 83, 102, 0.1);
    }

    .mobile-nav-links {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        flex: 1;
    }

    .mobile-nav-links a {
        text-decoration: none;
        color: var(--plum-brown);
        font-size: 1.2rem;
        padding: 0.8rem 0;
        border-bottom: 1px solid rgba(115, 83, 102, 0.05);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .mobile-nav-links a i {
        width: 24px;
    }

    .mobile-account-links {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(115, 83, 102, 0.1);
    }

    .mobile-account-links a {
        display: block;
        padding: 0.8rem 0;
        color: var(--mauve-rose);
        text-decoration: none;
        font-size: 1rem;
    }

    .back-button {
        background: none;
        border: none;
        font-size: 1rem;
        color: var(--plum-brown);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Montserrat', sans-serif;
        padding: 0.5rem;
    }

    .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(115, 83, 102, 0.5);
        z-index: 9998;
        display: none;
    }

    .overlay.active {
        display: block;
    }

    /* Responsive Styles */
    @media (max-width: 992px) {
        .desktop-nav {
            display: none;
        }
        .hamburger {
            display: block;
        }
    }

    @media (max-width: 768px) {
        .container {
            padding: 0 1.5rem;
        }
        .logo a {
            font-size: 1.5rem;
        }
        body {
            padding-top: 70px;
        }
        header {
            padding: 1rem 0;
        }
    }

    @media (max-width: 576px) {
        .logo a {
            font-size: 1.3rem;
        }
        .logo span {
            font-size: 0.7rem;
        }
        .nav-icons {
            gap: 1rem;
        }
    }

    /* Dynamic Section Styles */
    {% generate_section_styles style_customizations 1 50 %}
    {% generate_background_images background_images 1 50 %}
    {% generate_hover_keyframes %}
</style>

<!-- Header -->
<header id="section-1">
    <div class="container header-container">
        <div class="logo">
            <a href="../../?page=home">
                <i class="fas fa-spa" data-icon="1"></i>
                <span id="section-2">{{ text_contents.1|default:"Éclat<span>Lumière</span>"|safe }}</span>
            </a>
        </div>
        <nav class="desktop-nav">
            <a href="../../?page=home" id="section-3">{{ text_contents.2|default:"Home" }}</a>
            <a href="../../?page=products" id="section-4">{{ text_contents.3|default:"Shop" }}</a>
            <a href="../../?page=about" id="section-5">{{ text_contents.4|default:"About Us" }}</a>
            <a href="../../?page=contact" id="section-6">{{ text_contents.5|default:"Contact" }}</a>
        </nav>
        <div class="nav-icons">
            <a href="../../?page=cart" class="icon-btn">
                <span class="cart-counter">{{ cart.items.count|default:"0" }}</span>
                <i class="fas fa-shopping-bag" data-icon="2"></i>
            </a>
            <a href="../../?page=wishlist" class="icon-btn">
                <span class="wishlist-counter">{{ wishlist.items.count|default:"0" }}</span>
                <i class="far fa-heart" data-icon="3"></i>
            </a>
            <!-- USER DROPDOWN -->
            <div style="position: relative;">
                <i class="far fa-user" data-icon="4" onclick="toggleDropdown()" style="cursor: pointer; font-size: 1.2rem;"></i>
                <ul id="dropdown" class="dropdown" style="display: none;">
                    <div class="dropdown-close" onclick="toggleDropdown()">
                        <i class="fas fa-times" data-icon="5"></i>
                    </div>
                    {% if show_auth_links %}
                        {% if not is_website_member %}
                            <li><a href="{{ registration_url }}" id="section-7">{{ text_contents.6|default:"Sign Up" }}</a></li>
                            <li><a href="{{ login_url }}" id="section-8">{{ text_contents.7|default:"Sign In" }}</a></li>
                            <li><a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-9">{{ text_contents.8|default:"Orders" }}</a></li>
                            <li><a href="../../?page=wishlist" id="section-10">{{ text_contents.9|default:"Wishlist" }}</a></li>
                            <li><a href="../../?page=account" id="section-11">{{ text_contents.10|default:"Account Settings" }}</a></li>
                        {% else %}
                            <li><a href="{% url 'payments:customer_order_history' page.subdomain %}" id="section-9">{{ text_contents.8|default:"Orders" }}</a></li>
                            <li><a href="../../?page=wishlist" id="section-10">{{ text_contents.9|default:"Wishlist" }}</a></li>
                            <!-- <li><a href="../../?page=account" id="section-11">{{ text_contents.10|default:"Account Settings" }}</a></li> -->
                            <li><a href="{{ website_logout_url }}" id="section-12">{{ text_contents.10|default:"Logout" }}</a></li>
                        {% endif %}
                    {% endif %}
                </ul>
            </div>
            <button class="hamburger" id="hamburgerBtn">
                <i class="fas fa-bars" data-icon="6"></i>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Navigation -->
<div class="mobile-nav" id="mobileNav">
    <div class="mobile-nav-header">
        <a href="../../?page=home" class="logo">{{page.brand_name}}</a>
        <button class="back-button" id="closeNav">
            <i class="fas fa-times" data-icon="5"></i>
        </button>
    </div>
    <div class="mobile-nav-links">
        <a href="../../?page=home"><i class="fas fa-home"></i> Home</a>
        <a href="../../?page=products"><i class="fas fa-shopping-bag"></i> Shop</a>
        <a href="../../?page=about"><i class="fas fa-info-circle"></i> About Us</a>
        <a href="../../?page=contact"><i class="fas fa-envelope"></i> Contact</a>
        <a href="../../?page=cart"><i class="fas fa-shopping-cart"></i> Cart <span class="cart-counter-mobile" style="margin-left: auto;">{{ cart.items.count|default:"0" }}</span></a>
        <a href="../../?page=wishlist"><i class="far fa-heart"></i> Wishlist <span class="wishlist-counter-mobile" style="margin-left: auto;">{{ wishlist.items.count|default:"0" }}</span></a>
    </div>
    <div class="mobile-account-links">
        {% if show_auth_links %}
            {% if not is_website_member %}
                <a href="{{ registration_url }}"><i class="fas fa-user-plus"></i> Sign Up</a>
                <a href="{{ login_url }}"><i class="fas fa-sign-in-alt"></i> Sign In</a>
            {% else %}
                <a href="{% url 'payments:customer_order_history' page.subdomain %}"><i class="fas fa-box"></i> Orders</a>
                <a href="{{ website_logout_url }}"><i class="fas fa-sign-out-alt"></i> Logout</a>
            {% endif %}
        {% endif %}
    </div>
</div>
<div class="overlay" id="mobileOverlay"></div>

<script>
    // Mobile Navigation
    const hamburgerBtn = document.getElementById('hamburgerBtn');
    const mobileNav = document.getElementById('mobileNav');
    const closeNav = document.getElementById('closeNav');
    const mobileOverlay = document.getElementById('mobileOverlay');

    function openMobileMenu() {
        mobileNav.classList.add('active');
        mobileOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeMobileMenu() {
        mobileNav.classList.remove('active');
        mobileOverlay.classList.remove('active');
        document.body.style.overflow = '';
    }

    if (hamburgerBtn) {
        hamburgerBtn.addEventListener('click', openMobileMenu);
    }
    if (closeNav) {
        closeNav.addEventListener('click', closeMobileMenu);
    }
    if (mobileOverlay) {
        mobileOverlay.addEventListener('click', closeMobileMenu);
    }

    // Close mobile nav when clicking a link
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-links a');
    mobileNavLinks.forEach(link => {
        link.addEventListener('click', closeMobileMenu);
    });

    // User Dropdown Toggle
    function toggleDropdown() {
        const menu = document.getElementById("dropdown");
        if (menu) {
            const isVisible = menu.style.display === "block";
            menu.style.display = isVisible ? "none" : "block";
            if (!isVisible) {
                menu.classList.add('show');
            } else {
                menu.classList.remove('show');
            }
        }
    }

    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        const dropdown = document.getElementById('dropdown');
        const userIcon = document.querySelector('.fa-user');
        if (dropdown && userIcon && !userIcon.contains(event.target) && !dropdown.contains(event.target)) {
            dropdown.style.display = 'none';
            dropdown.classList.remove('show');
        }
    });

    // Header scroll effect
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header');
        if (window.scrollY > 100) {
            header.style.padding = '0.8rem 0';
        } else {
            header.style.padding = '1.2rem 0';
        }
    });
</script>