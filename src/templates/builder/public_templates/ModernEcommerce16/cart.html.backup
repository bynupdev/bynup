<!-- builder/public_templates/ModernEcommerce16/cart.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart - {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --soft-blush: #FAEEE9;
            --champagne-glow: #F5D69B;
            --mauve-rose: #A77A95;
            --lavender-mist: #C3C3D5;
            --plum-brown: #735366;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }
        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1 {
            font-size: 3rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, var(--mauve-rose), var(--champagne-glow));
        }

        /* Cart Content Layout */
        .cart-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Cart Items Section */
        .cart-items {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.05);
            padding: var(--spacing-md);
        }

        .cart-items-header {
            display: grid;
            grid-template-columns: 2.5fr 1fr 1.5fr 0.5fr;
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(115, 83, 102, 0.1);
            font-weight: 600;
            color: var(--plum-brown);
            margin-bottom: var(--spacing-md);
            font-size: 0.9rem;
        }

        .cart-item {
            display: grid;
            grid-template-columns: 2.5fr 1fr 1.5fr 0.5fr;
            align-items: center;
            padding: var(--spacing-sm) 0;
            border-bottom: 1px solid rgba(115, 83, 102, 0.05);
            transition: var(--transition);
        }

        .cart-item:hover {
            background: rgba(250, 238, 233, 0.3);
        }

        /* Product Info in Cart */
        .cart-product-info {
            display: flex;
            align-items: center;
            gap: var(--spacing-sm);
        }

        .cart-product-image {
            width: 80px;
            height: 80px;
            border-radius: calc(var(--border-radius) - 2px);
            object-fit: cover;
            flex-shrink: 0;
        }

        .cart-product-details {
            flex: 1;
        }

        .cart-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.1rem;
            color: var(--plum-brown);
            margin-bottom: 0.3rem;
            font-weight: 500;
        }

        .cart-product-category {
            color: var(--mauve-rose);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.3rem;
        }

        .cart-product-variant {
            font-size: 0.75rem;
            color: rgba(115, 83, 102, 0.7);
        }

        /* Quantity Controls */
        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .quantity-btn {
            width: 32px;
            height: 32px;
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1rem;
            color: var(--plum-brown);
        }

        .quantity-btn:hover {
            background: var(--soft-blush);
            border-color: var(--mauve-rose);
            color: var(--mauve-rose);
        }

        .quantity-input {
            width: 50px;
            height: 32px;
            text-align: center;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 20px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
        }

        .quantity-input:focus {
            outline: none;
            border-color: var(--mauve-rose);
        }

        /* Price Display */
        .cart-product-price {
            font-size: 1rem;
            color: var(--mauve-rose);
            font-weight: 500;
        }

        /* Remove Button */
        .remove-btn {
            background: none;
            border: none;
            color: rgba(115, 83, 102, 0.5);
            cursor: pointer;
            font-size: 1rem;
            transition: var(--transition);
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        .remove-btn:hover {
            color: var(--mauve-rose);
            background: rgba(167, 122, 149, 0.1);
        }

        /* Cart Summary */
        .cart-summary {
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.05);
            padding: var(--spacing-md);
            height: fit-content;
            position: sticky;
            top: 120px;
        }

        .cart-summary h2 {
            font-size: 1.5rem;
            margin-bottom: var(--spacing-md);
            color: var(--plum-brown);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid rgba(115, 83, 102, 0.1);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 1rem;
            color: var(--plum-brown);
            font-size: 0.95rem;
        }

        .summary-row.total {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--mauve-rose);
            margin-top: var(--spacing-sm);
            padding-top: var(--spacing-sm);
            border-top: 1px solid rgba(115, 83, 102, 0.1);
        }

        /* Promo Code */
        .promo-code {
            margin: var(--spacing-md) 0;
        }

        .promo-code h3 {
            font-size: 1rem;
            margin-bottom: 0.8rem;
            color: var(--plum-brown);
        }

        .promo-input-group {
            display: flex;
            gap: 0.5rem;
        }

        .promo-input {
            flex: 1;
            padding: 0.8rem 1rem;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 40px;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
        }

        .promo-input:focus {
            outline: none;
            border-color: var(--mauve-rose);
        }

        .apply-promo-btn {
            background: var(--plum-brown);
            color: var(--soft-blush);
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: 40px;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.85rem;
            font-weight: 500;
        }

        .apply-promo-btn:hover {
            background: var(--mauve-rose);
            transform: translateY(-2px);
        }

        /* Checkout Button */
        .checkout-btn {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 1rem;
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 40px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            margin-top: var(--spacing-md);
            text-align: center;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .checkout-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(115, 83, 102, 0.3);
        }

        /* Continue Shopping */
        .continue-shopping {
            text-align: center;
            margin-top: var(--spacing-sm);
        }

        .continue-shopping a {
            color: var(--mauve-rose);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
        }

        .continue-shopping a:hover {
            text-decoration: underline;
        }

        /* Empty Cart State */
        .empty-cart {
            text-align: center;
            padding: var(--spacing-xl) var(--spacing-md);
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
        }

        .empty-cart-icon {
            font-size: 4rem;
            color: var(--champagne-glow);
            margin-bottom: var(--spacing-md);
        }

        .empty-cart h2 {
            font-size: 2rem;
            color: var(--plum-brown);
            margin-bottom: var(--spacing-sm);
        }

        .empty-cart p {
            color: var(--plum-brown);
            opacity: 0.8;
            margin-bottom: var(--spacing-md);
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .shop-now-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 1rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
        }

        .shop-now-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* You May Also Like Section */
        .you-may-also-like {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(115, 83, 102, 0.1);
        }

        .you-may-also-like h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--plum-brown);
        }

        .recommended-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .recommended-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .recommended-product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(115, 83, 102, 0.1);
        }

        .recommended-product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .recommended-product-card:hover .recommended-product-img {
            transform: scale(1.05);
        }

        .recommended-product-info {
            padding: 1rem;
            text-align: center;
        }

        .recommended-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.3rem;
        }

        .recommended-product-price {
            color: var(--mauve-rose);
            font-weight: 500;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .quick-add-btn {
            width: 100%;
            background: transparent;
            color: var(--mauve-rose);
            border: 1px solid var(--mauve-rose);
            padding: 0.5rem;
            font-size: 0.8rem;
            border-radius: 40px;
            cursor: pointer;
            transition: var(--transition);
            font-family: 'Montserrat', sans-serif;
        }

        .quick-add-btn:hover {
            background: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Empty State for You May Also Like */
        .empty-recommended {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            grid-column: 1 / -1;
        }

        .empty-recommended p {
            color: var(--plum-brown);
            opacity: 0.8;
        }

        /* Responsive Styles */
        @media (max-width: 992px) {
            .cart-content {
                grid-template-columns: 1fr;
                gap: var(--spacing-md);
            }
            .cart-summary {
                position: static;
                order: -1;
            }
            .cart-items-header {
                display: none;
            }
            .cart-item {
                grid-template-columns: 1fr;
                gap: var(--spacing-sm);
                padding: var(--spacing-md) 0;
                position: relative;
            }
            .cart-product-price {
                position: absolute;
                top: var(--spacing-md);
                right: 0;
            }
            .remove-btn {
                position: absolute;
                top: var(--spacing-md);
                right: 40px;
            }
            .quantity-controls {
                justify-content: flex-start;
                margin-top: 0.5rem;
            }
            .recommended-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            h1 {
                font-size: 2rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .cart-items, .cart-summary {
                padding: var(--spacing-sm);
            }
            .cart-product-image {
                width: 70px;
                height: 70px;
            }
            .recommended-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            .promo-input-group {
                flex-direction: column;
            }
            .apply-promo-btn {
                width: 100%;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 1.8rem;
            }
            .checkout-btn, .shop-now-btn {
                padding: 0.8rem 1.5rem;
                font-size: 0.9rem;
            }
            .empty-cart h2 {
                font-size: 1.5rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 300 330 %}
        {% generate_background_images background_images 300 330 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/header.html' %}

{% for component in components %}
    {% if component.drop_zone == '1' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Page Header -->
<div class="page-header" id="section-300">
    <div class="container">
        <h1 id="section-301">{{ text_contents.400|default:"Your Shopping Cart" }}</h1>
    </div>
</div>

{% for component in components %}
    {% if component.drop_zone == '300' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Cart Content -->
<div class="container">
    {% if cart and cart.items.all %}
        <div class="cart-content">
            <!-- Cart Items -->
            <div class="cart-items">
                <div class="cart-items-header">
                    <div id="section-302">{{ text_contents.401|default:"Product" }}</div>
                    <div id="section-303">{{ text_contents.402|default:"Price" }}</div>
                    <div id="section-304">{{ text_contents.403|default:"Quantity" }}</div>
                    <div></div>
                </div>

                {% for item in cart.items.all %}
                    <div class="cart-item" data-cart-item-id="{{ item.id }}" data-product-id="{{ item.product.id }}" 
                         data-selected-color="{{ item.selected_color|default:'' }}" 
                         data-selected-size="{{ item.selected_size|default:'' }}"
                         id="cart-item-{{ item.id }}">
                        <div class="cart-product-info">
                            <img src="{% if item.product.main_image %}{{ item.product.main_image.url }}{% else %}https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=100&auto=format{% endif %}" 
                                 alt="{{ item.product.title }}" 
                                 class="cart-product-image">
                            <div class="cart-product-details">
                                <div class="cart-product-name" id="section-305">{{ item.product.title }}</div>
                                <div class="cart-product-category" id="section-306">{{ item.product.category.name|default:"SKINCARE" }}</div>
                                {% if item.selected_color or item.selected_size %}
                                    <div class="cart-product-variant">
                                        Color: {{ item.selected_color|default:"N/A" }} | Size: {{ item.selected_size|default:"N/A" }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <div class="cart-product-price" data-price="{{ item.product.price }}">{{ item.product.price|currency:page }}</div>
                        <div class="quantity-controls">
                            <button class="quantity-btn decrement" data-action="decrement" data-product-id="{{ item.product.id }}">-</button>
                            <input type="number" class="quantity-input" value="{{ item.quantity }}" min="1" max="10" data-product-id="{{ item.product.id }}" data-cart-item-id="{{ item.id }}">
                            <button class="quantity-btn increment" data-action="increment" data-product-id="{{ item.product.id }}">+</button>
                        </div>
                        <button class="remove-btn" data-action="remove" data-product-id="{{ item.product.id }}" data-cart-item-id="{{ item.id }}">
                            <i class="fas fa-times" data-icon="200"></i>
                        </button>
                    </div>
                {% endfor %}
            </div>

            <!-- Cart Summary -->
            <div class="cart-summary">
                <h2 id="section-307">{{ text_contents.406|default:"Order Summary" }}</h2>
                <div class="summary-row">
                    <span id="section-308">{{ text_contents.407|default:"Subtotal" }}</span>
                    <span id="cart-subtotal">{{ cart.subtotal|currency:page }}</span>
                </div>
                <div class="summary-row">
                    <span id="section-309">{{ text_contents.408|default:"Shipping" }}</span>
                    <span id="cart-shipping">
                        {% if has_shipping_config %} <small>Calculated at Checkout</small> {% else %}Free{% endif %}
                    </span>
                </div>
                <div class="summary-row">
                    <span id="section-310">{{ text_contents.409|default:"Tax" }}</span>
                    <span id="cart-tax">{{ cart.tax_amount|currency:page }}</span>
                </div>
                <div class="summary-row total">
                    <span id="section-311">{{ text_contents.410|default:"Total" }}</span>
                    <span id="cart-total">{{ cart.total_amount|currency:page }}</span>
                </div>

                <!-- Promo Code -->
                <div class="promo-code">
                    <h3 id="section-312">{{ text_contents.411|default:"Promo Code" }}</h3>
                    <div class="promo-input-group">
                        <input type="text" class="promo-input" placeholder="Enter code" id="promo-code-input">
                        <button class="apply-promo-btn" id="section-313">{{ text_contents.412|default:"Apply" }}</button>
                    </div>
                </div>

                <!-- Checkout Button -->
                <button class="checkout-btn" id="section-314" onclick="proceedToCheckout()">
                    <i class="fas fa-lock" data-icon="201"></i> {{ text_contents.413|default:"Proceed to Checkout" }}
                </button>

                <!-- Continue Shopping -->
                <div class="continue-shopping">
                    <a href="?page=products" id="section-315">
                        <i class="fas fa-arrow-left" data-icon="202"></i> {{ text_contents.414|default:"Continue Shopping" }}
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <!-- Empty Cart State -->
        <div class="empty-cart">
            <div class="empty-cart-icon">
                <i class="fas fa-shopping-bag" data-icon="203"></i>
            </div>
            <h2 id="section-316">{{ text_contents.419|default:"Your Cart is Empty" }}</h2>
            <p id="section-317">{{ text_contents.420|default:"Looks like you haven't added any products to your cart yet. Explore our collection to find your perfect skincare essentials." }}</p>
            <a href="?page=products" class="shop-now-btn" id="section-318">{{ text_contents.421|default:"Start Shopping →" }}</a>
        </div>
    {% endif %}

    <!-- You May Also Like Section -->
    <div class="you-may-also-like" id="section-319">
        <h2 id="section-320">{{ text_contents.415|default:"You May Also Like" }}</h2>
        {% if recommended_products %}
            <div class="recommended-grid">
                {% for product in recommended_products|slice:":4" %}
                    <div class="recommended-product-card" data-product-id="{{ product.id }}">
                        <img src="{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=300&auto=format{% endif %}" 
                             alt="{{ product.title }}" 
                             class="recommended-product-img">
                        <div class="recommended-product-info">
                            <div class="recommended-product-name" id="section-321">{{ product.title|truncatechars:30 }}</div>
                            <div class="recommended-product-price" id="section-322">{{ product.price|currency:page }}</div>
                            <button class="quick-add-btn" id="section-323" data-add-to-cart="{{ product.id }}">{{ text_contents.418|default:"Quick Add" }}</button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-recommended">
                <p id="section-324">{{ text_contents.422|default:"Check back soon for product recommendations!" }}</p>
            </div>
        {% endif %}
    </div>
</div>

{% for component in components %}
    {% if component.drop_zone == '319' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/footer.html' %}

{% for component in components %}
    {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% render_icon_script %}
<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
    // Update cart totals function
    function updateCartTotals() {
        let subtotal = 0;
        document.querySelectorAll('.cart-item').forEach(item => {
            const priceText = item.querySelector('.cart-product-price').getAttribute('data-price');
            const price = parseFloat(priceText);
            const quantity = parseInt(item.querySelector('.quantity-input').value);
            const itemTotal = price * quantity;
            subtotal += itemTotal;
        });
        
        const shipping = 0;
        const tax =0 ;
        const total = subtotal + shipping + tax;
        
        const currencySymbol = '{{ page.currency_symbol|default:"$" }}';
        document.getElementById('cart-subtotal').textContent = currencySymbol + subtotal.toFixed(2);
        document.getElementById('cart-shipping').textContent = 0;
        document.getElementById('cart-tax').textContent =0;
        document.getElementById('cart-total').textContent = currencySymbol + total.toFixed(2);
    }

    // Helper function to get selected variants from cart item
    function getCartItemVariants(cartItem) {
        const variantText = cartItem.querySelector('.cart-product-variant')?.textContent || '';
        
        let selectedColor = '';
        let selectedSize = '';
        
        const colorMatch = variantText.match(/Color:\s*([^|]+)/);
        const sizeMatch = variantText.match(/Size:\s*([^|]+)/);
        
        if (colorMatch) selectedColor = colorMatch[1].trim();
        if (sizeMatch) selectedSize = sizeMatch[1].trim();
        
        // Also check for data attributes if they exist
        const colorAttr = cartItem.getAttribute('data-selected-color');
        const sizeAttr = cartItem.getAttribute('data-selected-size');
        
        if (colorAttr && colorAttr !== 'None') selectedColor = colorAttr;
        if (sizeAttr && sizeAttr !== 'None') selectedSize = sizeAttr;
        
        return { selected_color: selectedColor, selected_size: selectedSize };
    }

    // FIXED: Proceed to checkout with variants included
    function proceedToCheckout() {
        const cartItems = document.querySelectorAll('.cart-item');
        if (cartItems.length === 0) {
            alert('Your cart is empty. Please add items before checkout.');
            return;
        }
        
        const hostname = window.location.hostname;
        const pageDomain = document.body.getAttribute('data-page-subdomain');
        const subdomain = hostname.includes('localhost') ? pageDomain : hostname.split('.')[0];
        
        // Build cart data with variants
        const cartItemsData = [];
        let subtotal = 0;
        
        cartItems.forEach(item => {
            const productId = item.getAttribute('data-product-id');
            const productTitle = item.querySelector('.cart-product-name').textContent;
            const productPrice = parseFloat(item.querySelector('.cart-product-price').getAttribute('data-price'));
            const quantity = parseInt(item.querySelector('.quantity-input').value);
            const itemTotal = productPrice * quantity;
            subtotal += itemTotal;
            
            // Get variants for this cart item
            const { selected_color, selected_size } = getCartItemVariants(item);
            
            console.log('Cart item:', productTitle, 'Color:', selected_color, 'Size:', selected_size);
            
            cartItemsData.push({
                id: productId,
                title: productTitle,
                price: productPrice,
                quantity: quantity,
                selected_color: selected_color,
                selected_size: selected_size,
                total_price: itemTotal
            });
        });
        
        const shipping = 0;
        const tax = 0;
        const total = subtotal + shipping + tax;
        
        const cartData = {
            items: cartItemsData,
            subtotal: subtotal,
            shipping_amount: shipping,
            tax_amount: tax,
            total_amount: total
        };
        
        console.log('Cart data being sent to checkout:', cartData);
        
        // Redirect to payment selection with cart data including variants
        const params = new URLSearchParams({
            type: 'cart',
            cart: JSON.stringify(cartData)
        });
        
        window.location.href = `/payments/select-payment/${subdomain}/?${params.toString()}`;
    }

    // Quantity controls
    document.querySelectorAll('.quantity-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const input = this.parentElement.querySelector('.quantity-input');
            let value = parseInt(input.value);
            const productId = input.getAttribute('data-product-id');
            
            if (this.classList.contains('increment') && value < 10) {
                value++;
            } else if (this.classList.contains('decrement') && value > 1) {
                value--;
            }
            input.value = value;
            
            if (window.cartManager) {
                if (this.classList.contains('increment')) {
                    window.cartManager.incrementCartItem(productId, 1);
                } else {
                    window.cartManager.decrementCartItem(productId, 1);
                }
            }
            updateCartTotals();
        });
    });

    // Quantity input change
    document.querySelectorAll('.quantity-input').forEach(input => {
        input.addEventListener('change', function() {
            let value = parseInt(this.value);
            if (value < 1) value = 1;
            if (value > 10) value = 10;
            this.value = value;
            
            const productId = this.getAttribute('data-product-id');
            if (window.cartManager) {
                window.cartManager.updateCartItemQuantity(productId, value);
            }
            updateCartTotals();
        });
    });

    // Remove items
    document.querySelectorAll('.remove-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const productId = this.getAttribute('data-product-id');
            if (window.cartManager) {
                window.cartManager.removeFromCart(productId);
            }
            const cartItem = this.closest('.cart-item');
            if (cartItem) {
                cartItem.remove();
                updateCartTotals();
                
                if (document.querySelectorAll('.cart-item').length === 0) {
                    location.reload();
                }
            }
        });
    });

    // Promo code
    const applyPromoBtn = document.querySelector('.apply-promo-btn');
    if (applyPromoBtn) {
        applyPromoBtn.addEventListener('click', function() {
            const promoInput = document.querySelector('.promo-input');
            const promoCode = promoInput.value.trim();
            if (promoCode === 'WELCOME10') {
                alert('10% discount applied!');
                let subtotal = parseFloat(document.getElementById('cart-subtotal').textContent.replace('$', ''));
                const discount = subtotal * 0;
                subtotal = subtotal - discount;
                const shipping = 0;
                const tax = 0;
                const total = subtotal + shipping + tax;
                document.getElementById('cart-subtotal').textContent = `$${subtotal.toFixed(2)}`;
                document.getElementById('cart-total').textContent = `$${total.toFixed(2)}`;
            } else if (promoCode === 'FREESHIP') {
                document.getElementById('cart-shipping').textContent = 'Free';
                updateCartTotals();
                alert('Free shipping applied!');
            } else {
                alert('Invalid promo code. Try WELCOME10 or FREESHIP');
            }
            promoInput.value = '';
        });
    }

    // Quick add buttons
    document.querySelectorAll('.quick-add-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = this.getAttribute('data-add-to-cart');
            if (window.cartManager) {
                window.cartManager.addToCart(productId, 1);
            }
        });
    });

    if (document.querySelectorAll('.cart-item').length > 0) {
        updateCartTotals();
    }
</script>

</body>
</html>