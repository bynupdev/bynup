<!-- builder/public_templates/ModernEcommerce16/home.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --soft-blush: #FAEEE9;
            --champagne-glow: #F5D69B;
            --mauve-rose: #A77A95;
            --lavender-mist: #C3C3D5;
            --plum-brown: #735366;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }
        {% generate_color_variables %}
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1, h2, h3, h4, .logo a, .hero-headline {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Header / Navigation */
        header {
            position: sticky;
            top: 0;
            width: 100%;
            z-index: 1000;
            padding: 1.2rem 0;
            background-color: rgba(250, 238, 233, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(167, 122, 149, 0.15);
            transition: var(--transition);
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo a {
            font-size: 1.8rem;
            font-weight: 600;
            color: var(--plum-brown);
            text-decoration: none;
            letter-spacing: 1px;
        }

        .logo span {
            font-weight: 300;
            font-size: 0.9rem;
            letter-spacing: 2px;
            color: var(--mauve-rose);
            margin-left: 6px;
        }

        .desktop-nav {
            display: flex;
            gap: 2.5rem;
            list-style: none;
        }

        .desktop-nav a {
            text-decoration: none;
            color: var(--plum-brown);
            font-weight: 400;
            font-size: 0.95rem;
            transition: var(--transition);
            letter-spacing: 0.5px;
        }

        .desktop-nav a:hover {
            color: var(--mauve-rose);
        }

        .nav-icons {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .icon-btn {
            position: relative;
            background: none;
            border: none;
            font-size: 1.2rem;
            color: var(--plum-brown);
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }

        .icon-btn:hover {
            color: var(--mauve-rose);
        }

        .cart-counter, .wishlist-counter {
            position: absolute;
            top: -8px;
            right: -12px;
            background-color: var(--mauve-rose);
            color: var(--soft-blush);
            padding: 0.2rem 0.5rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
        }

        /* Account Dropdown */
        .account-dropdown {
            position: relative;
            display: inline-block;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--soft-blush);
            min-width: 200px;
            box-shadow: 0 8px 25px rgba(115, 83, 102, 0.1);
            z-index: 1;
            border-radius: var(--border-radius);
            overflow: hidden;
            margin-top: 10px;
            border: 1px solid rgba(167, 122, 149, 0.2);
        }

        .dropdown-content a {
            color: var(--plum-brown);
            padding: 0.8rem 1.5rem;
            text-decoration: none;
            display: block;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .dropdown-content a:hover {
            background-color: rgba(245, 214, 155, 0.3);
            color: var(--mauve-rose);
        }

        .account-dropdown:hover .dropdown-content {
            display: block;
        }

        /* Hamburger Menu */
        .hamburger {
            display: none;
            cursor: pointer;
            font-size: 1.5rem;
            color: var(--plum-brown);
            background: none;
            border: none;
        }

        .mobile-nav {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: var(--soft-blush);
            z-index: 9999;
            padding: 2rem;
            transform: translateX(-100%);
            transition: transform 0.4s ease;
        }

        .mobile-nav.active {
            transform: translateX(0);
        }

        .mobile-nav-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(115, 83, 102, 0.1);
        }

        .mobile-nav-links {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .mobile-nav-links a {
            text-decoration: none;
            color: var(--plum-brown);
            font-size: 1.2rem;
            padding: 0.8rem 0;
            border-bottom: 1px solid rgba(115, 83, 102, 0.05);
        }

        .back-button {
            background: none;
            border: none;
            font-size: 1rem;
            color: var(--plum-brown);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: 'Montserrat', sans-serif;
        }

        /* Hero Section */
        section.hero {
            position: relative;
            min-height: 85vh;
            display: flex;
            align-items: center;
            overflow: hidden;
            /* margin-top: 80px; */
        }

        .hero{
    width: 100%;
    height: 100%;
    background-image: url('https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1600&auto=format');
    background-size: cover;
    background-position: center 30%;
    z-index: 1;
}

        .hero-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: 70% 20%;
            z-index: 1;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, rgba(250, 238, 233, 0.85) 0%, rgba(250, 238, 233, 0.4) 70%);
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            max-width: 600px;
            padding: 2rem 0;
        }

        h1 {
            font-size: 3.5rem;
            font-weight: 500;
            color: var(--plum-brown);
            line-height: 1.2;
            margin-bottom: 1rem;
        }

        p {
            font-size: 1rem;
            line-height: 1.6;
            color: var(--plum-brown);
            margin-bottom: 2rem;
            font-weight: 400;
            max-width: 450px;
        }

        a.cta-btn {
            display: inline-block;
            background-color: var(--plum-brown);
            color: var(--soft-blush);
            padding: 0.9rem 2.4rem;
            font-weight: 500;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            font-size: 0.9rem;
            letter-spacing: 1px;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(115, 83, 102, 0.15);
        }

        a.cta-btn:hover {
            background-color: var(--mauve-rose);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* New Arrivals Section */
        section.new-arrivals {
            padding: var(--spacing-xl) 0;
            text-align: center;
        }

        .section-header {
            margin-bottom: var(--spacing-lg);
        }

        h2 {
            font-size: 2.5rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.5rem;
        }

        .section-header p {
            color: var(--plum-brown);
            font-size: 1rem;
            max-width: 600px;
            margin: 0 auto;
            opacity: 0.8;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .product-card {
            background: rgba(255, 255, 255, 0.5);
            backdrop-filter: blur(2px);
            border-radius: 24px;
            padding: 1.2rem 1rem 1.5rem;
            transition: var(--transition);
            text-align: center;
            box-shadow: 0 4px 12px rgba(115, 83, 102, 0.03);
            border: 1px solid rgba(195, 195, 213, 0.2);
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .product-card:hover {
            transform: scale(1.02);
            box-shadow: 0 20px 30px -12px rgba(115, 83, 102, 0.12);
            background: #fffcf9;
            border-color: var(--champagne-glow);
        }

        .product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            border-radius: 20px;
            margin-bottom: 1rem;
            box-shadow: 0 6px 12px rgba(0,0,0,0.02);
        }

        .product-category {
            color: var(--mauve-rose);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            margin: 0.5rem 0 0.25rem;
            color: var(--plum-brown);
        }

        .product-price {
            font-weight: 500;
            font-size: 1rem;
            color: var(--mauve-rose);
        }

        .see-more {
            display: inline-block;
            background-color: transparent;
            color: var(--mauve-rose);
            padding: 0.8rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
            border: 1px solid var(--mauve-rose);
        }

        .see-more:hover {
            background-color: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
        }

        .empty-state h3 {
            color: var(--plum-brown);
            margin-bottom: 1rem;
        }

        .empty-state a {
            color: var(--mauve-rose);
            text-decoration: none;
            font-weight: 500;
        }

        .empty-state a:hover {
            text-decoration: underline;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .products-grid {
                grid-template-columns: repeat(3, 1fr);
                gap: 1.5rem;
            }
            h1 {
                font-size: 3rem;
            }
        }

        @media (max-width: 992px) {
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1 {
                font-size: 2.8rem;
            }
            .desktop-nav {
                display: none;
            }
            .hamburger {
                display: block;
            }
        }

        @media (max-width: 768px) {
            section.hero {
                min-height: 70vh;
                justify-content: center;
                text-align: center;
            }
            .hero-content {
                text-align: center;
                margin: 0 auto;
                padding: 0 1rem;
            }
            p {
                margin-left: auto;
                margin-right: auto;
            }
            .hero-overlay {
                background: linear-gradient(0deg, rgba(250, 238, 233, 0.85) 0%, rgba(250, 238, 233, 0.5) 100%);
            }
            .products-grid {
                grid-template-columns: 1fr;
                gap: 1.5rem;
                max-width: 400px;
                margin-left: auto;
                margin-right: auto;
            }
            h2 {
                font-size: 2rem;
            }
            .container {
                padding: 0 1.5rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 2rem;
            }
            a.cta-btn, .see-more {
                padding: 0.7rem 1.8rem;
                font-size: 0.85rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 1 50 %}
        /* Dynamic Background Images */
        {% generate_background_images background_images 1 50 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/header.html' %}

{% for component in components %}
    {% if component.drop_zone == '1' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Hero Section -->
<section class="hero" id="section-13">
    <!-- <img class="hero-bg" src="{% if image_customizations.8 %}{{ image_customizations.8.image_url }}{% else %}https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1600&auto=format{% endif %}" alt="Luxury skincare model with radiant skin and elegant wristwatch"> -->
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <h1 id="section-14">{{ text_contents.11|default:'Where Beauty Meets Elegance' }}</h1>
        <p id="section-15">{{ text_contents.12|default:'Luxury skincare designed to enhance your natural glow with refined care.' }}</p>
        <a href="?page=products" class="cta-btn" id="section-16">{{ text_contents.13|default:'Shop Skincare' }}</a>
    </div>
</section>

{% for component in components %}
    {% if component.drop_zone == '13' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- New Arrivals Section -->
<section class="new-arrivals" id="section-17">
    <div class="container">
        <div class="section-header">
            <h2 id="section-18">{{ text_contents.14|default:'New Arrivals' }}</h2>
            <p id="section-19">{{ text_contents.15|default:'Discover our latest skincare innovations for radiant, healthy skin.' }}</p>
        </div>
        
        {% if products %}
            <div class="products-grid">
                {% for product in products|slice:":4" %}
                    <a href="/product/{{ product.slug }}/" class="product-card" id="section-20">
                        <img src="{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=500&auto=format{% endif %}" alt="{{ product.title }}" class="product-img">
                        <div class="product-category" id="section-21">{{ product.category.name|default:'SKINCARE' }}</div>
                        <div class="product-name" id="section-22">{{ product.title|truncatechars:30 }}</div>
                        <div class="product-price" id="section-23">{{ product.price|currency:page }}</div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state">
                <h3>No Products Yet</h3>
                <p>You haven't added any products to your collection yet. <a href="{{ SITE_DOMAIN }}/manage-products/{{ page.subdomain }}/">Add your first product</a> to get started.</p>
            </div>
        {% endif %}
        
        <a href="?page=products" class="see-more" id="section-24">{{ text_contents.16|default:'See More →' }}</a>
    </div>
</section>

{% for component in components %}
    {% if component.drop_zone == '17' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/footer.html' %}

{% for component in components %}
    {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% render_icon_script %}
<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
    // Mobile Navigation
    const hamburger = document.querySelector('.hamburger');
    const mobileNav = document.getElementById('mobileNav');
    const closeNav = document.getElementById('closeNav');

    if (hamburger) {
        hamburger.addEventListener('click', function() {
            mobileNav.classList.add('active');
        });
    }
    if (closeNav) {
        closeNav.addEventListener('click', function() {
            mobileNav.classList.remove('active');
        });
    }

    // Close mobile nav when clicking a link
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-links a');
    mobileNavLinks.forEach(link => {
        link.addEventListener('click', function() {
            mobileNav.classList.remove('active');
        });
    });

    // Header scroll effect
    window.addEventListener('scroll', function() {
        const header = document.querySelector('header');
        if (window.scrollY > 100) {
            header.style.padding = '0.8rem 0';
        } else {
            header.style.padding = '1.2rem 0';
        }
    });
</script>

</body>
</html>