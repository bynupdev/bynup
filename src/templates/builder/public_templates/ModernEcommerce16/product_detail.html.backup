<!-- builder/public_templates/ModernEcommerce16/product_details.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ product.title|default:"Product Details" }} | {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --soft-blush: #FAEEE9;
            --champagne-glow: #F5D69B;
            --mauve-rose: #A77A95;
            --lavender-mist: #C3C3D5;
            --plum-brown: #735366;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }
        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Breadcrumb */
        .breadcrumb {
            padding: var(--spacing-sm) 0;
            margin-bottom: var(--spacing-md);
            font-size: 0.85rem;
            color: var(--plum-brown);
            opacity: 0.7;
        }

        .breadcrumb a {
            color: var(--mauve-rose);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb a:hover {
            text-decoration: underline;
        }

        .breadcrumb span {
            margin: 0 0.5rem;
        }

        /* Product Details Layout */
        .product-details-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            margin-bottom: var(--spacing-xl);
        }

        /* Product Images */
        .product-images {
            position: relative;
        }

        .main-image-container {
            position: relative;
            overflow: hidden;
            border-radius: var(--border-radius);
            margin-bottom: var(--spacing-sm);
        }

        .main-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .thumbnail-container {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 1rem;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            border-radius: calc(var(--border-radius) - 2px);
            object-fit: cover;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
        }

        .thumbnail:hover {
            transform: translateY(-3px);
            border-color: var(--champagne-glow);
        }

        .thumbnail.active {
            border-color: var(--mauve-rose);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(167, 122, 149, 0.2);
        }

        /* Product Info */
        .product-info {
            padding: var(--spacing-md) 0;
        }

        h1.product-title {
            font-size: 2.5rem;
            color: var(--plum-brown);
            margin-bottom: var(--spacing-sm);
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: var(--spacing-sm);
        }

        .stars {
            color: var(--champagne-glow);
            font-size: 1rem;
        }

        .rating-count {
            color: var(--plum-brown);
            opacity: 0.7;
            font-size: 0.9rem;
        }

        .product-price {
            font-size: 2rem;
            color: var(--mauve-rose);
            margin-bottom: var(--spacing-md);
            font-weight: 500;
        }

        .product-description {
            color: var(--plum-brown);
            margin-bottom: var(--spacing-md);
            font-size: 1rem;
            line-height: 1.7;
        }

        /* Product Variants */
        .product-variants {
            margin-bottom: var(--spacing-md);
        }

        .variant-title {
            font-weight: 500;
            margin-bottom: 0.8rem;
            color: var(--plum-brown);
            font-size: 1rem;
        }

        .variant-options {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-bottom: 1.5rem;
        }

        .variant-option {
            padding: 0.7rem 1.5rem;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 40px;
            background: white;
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.9rem;
        }

        .variant-option:hover {
            border-color: var(--mauve-rose);
            transform: translateY(-2px);
        }

        .variant-option.active {
            border-color: var(--mauve-rose);
            background: rgba(167, 122, 149, 0.05);
            color: var(--mauve-rose);
            font-weight: 500;
        }

        .color-option {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            border: 2px solid transparent;
            cursor: pointer;
            transition: var(--transition);
        }

        .color-option.active {
            border-color: var(--plum-brown);
            transform: scale(1.1);
        }

        /* Product Actions */
        .product-actions {
            display: flex;
            gap: 1rem;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
        }

        .buy-now-btn {
            flex: 2;
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 1rem 2rem;
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 40px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .buy-now-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(115, 83, 102, 0.3);
        }

        .add-to-cart-details {
            flex: 1;
            background: white;
            color: var(--mauve-rose);
            padding: 1rem 2rem;
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 40px;
            border: 1px solid var(--mauve-rose);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .add-to-cart-details:hover {
            background: var(--mauve-rose);
            color: var(--soft-blush);
            transform: translateY(-3px);
        }

        .wishlist-details {
            width: 52px;
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 50%;
            color: var(--plum-brown);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            font-size: 1.2rem;
        }

        .wishlist-details:hover {
            background: rgba(167, 122, 149, 0.1);
            color: var(--mauve-rose);
            border-color: var(--mauve-rose);
            transform: scale(1.05);
        }

        /* Product Tabs */
        .product-tabs {
            margin-bottom: var(--spacing-xl);
        }

        .tab-headers {
            display: flex;
            border-bottom: 1px solid rgba(115, 83, 102, 0.1);
            margin-bottom: var(--spacing-md);
            gap: 2rem;
        }

        .tab-header {
            padding: 1rem 0;
            background: none;
            border: none;
            color: var(--plum-brown);
            font-size: 1rem;
            cursor: pointer;
            position: relative;
            transition: var(--transition);
            font-weight: 500;
        }

        .tab-header:hover {
            color: var(--mauve-rose);
        }

        .tab-header.active {
            color: var(--mauve-rose);
        }

        .tab-header.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--mauve-rose);
        }

        .tab-content {
            display: none;
            padding: var(--spacing-md) 0;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Reviews Section */
        .review-form {
            background: white;
            padding: var(--spacing-md);
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.05);
            margin-bottom: var(--spacing-lg);
        }

        .review-form h3 {
            font-size: 1.5rem;
            margin-bottom: var(--spacing-md);
            color: var(--plum-brown);
        }

        .rating-input {
            margin-bottom: 1.5rem;
        }

        .rating-input label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--plum-brown);
            font-weight: 500;
        }

        .star-rating-input {
            display: flex;
            gap: 0.5rem;
            font-size: 1.5rem;
            color: rgba(115, 83, 102, 0.2);
            cursor: pointer;
        }

        .star-rating-input .star {
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .star-rating-input .star:hover,
        .star-rating-input .star:hover ~ .star {
            color: var(--champagne-glow);
        }

        .star-rating-input .star.selected {
            color: var(--champagne-glow);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--plum-brown);
            font-weight: 500;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 1rem;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: var(--border-radius);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .form-group input:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--mauve-rose);
            box-shadow: 0 0 0 3px rgba(167, 122, 149, 0.1);
        }

        .submit-review-btn {
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 1rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            border-radius: 40px;
            border: none;
            cursor: pointer;
            transition: var(--transition);
        }

        .submit-review-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* Customer Reviews */
        .customer-reviews {
            margin-bottom: var(--spacing-lg);
        }

        .customer-reviews h3 {
            font-size: 1.5rem;
            margin-bottom: var(--spacing-md);
            color: var(--plum-brown);
        }

        .review-item {
            background: white;
            padding: var(--spacing-md);
            border-radius: var(--border-radius);
            margin-bottom: var(--spacing-sm);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
        }

        .review-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.8rem;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .reviewer-name {
            font-weight: 600;
            color: var(--plum-brown);
        }

        .review-date {
            color: rgba(115, 83, 102, 0.6);
            font-size: 0.8rem;
        }

        .review-rating {
            color: var(--champagne-glow);
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }

        .review-title {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: var(--plum-brown);
        }

        .review-text {
            color: var(--plum-brown);
            line-height: 1.6;
            font-size: 0.95rem;
        }

        /* Notification Popup */
        .notification-popup {
            position: fixed;
            top: 120px;
            right: 20px;
            background: var(--mauve-rose);
            color: var(--soft-blush);
            padding: 1rem 1.5rem;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.2);
            z-index: 10000;
            animation: slideIn 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .notification-popup.success {
            background: #28a745;
        }

        .notification-popup.error {
            background: #dc3545;
        }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        @keyframes slideOut {
            from { transform: translateX(0); opacity: 1; }
            to { transform: translateX(100%); opacity: 0; }
        }

        /* Related Products */
        .related-products {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(115, 83, 102, 0.1);
        }

        .related-products h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--plum-brown);
        }

        .related-products-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
        }

        .related-product-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .related-product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(115, 83, 102, 0.1);
        }

        .related-product-img {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .related-product-card:hover .related-product-img {
            transform: scale(1.05);
        }

        .related-product-info {
            padding: 1rem;
            text-align: center;
        }

        .related-product-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.3rem;
        }

        .related-product-price {
            color: var(--mauve-rose);
            font-weight: 500;
            font-size: 0.9rem;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
        }

        .empty-state p {
            color: var(--plum-brown);
            opacity: 0.8;
        }

        /* Responsive Styles */
        @media (max-width: 992px) {
            .product-details-container {
                grid-template-columns: 1fr;
                gap: var(--spacing-md);
            }
            .related-products-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1.product-title {
                font-size: 2rem;
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            .container {
                padding: 0 1.5rem;
            }
            .thumbnail {
                width: 60px;
                height: 60px;
            }
            .tab-headers {
                gap: 1rem;
            }
            .tab-header {
                font-size: 0.9rem;
            }
            .related-products-grid {
                grid-template-columns: 1fr;
                max-width: 350px;
                margin: 0 auto;
            }
            .product-actions {
                flex-direction: column;
            }
            .buy-now-btn, .add-to-cart-details {
                width: 100%;
            }
            .wishlist-details {
                width: 100%;
                height: 52px;
                border-radius: 40px;
            }
            .review-header {
                flex-direction: column;
                align-items: flex-start;
            }
            .notification-popup {
                top: 80px;
                right: 10px;
                left: 10px;
                max-width: calc(100% - 20px);
            }
        }

        @media (max-width: 576px) {
            h1.product-title {
                font-size: 1.8rem;
            }
            .product-price {
                font-size: 1.6rem;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 200 260 %}
        {% generate_background_images background_images 200 260 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/header2.html' %}

{% for component in components %}
    {% if component.drop_zone == '1' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Breadcrumb -->
<div class="breadcrumb" id="section-200">
    <div class="container">
        <a href="../../?page=home" id="section-201">{{ text_contents.300|default:"Home" }}</a> <span>/</span>
        <a href="../../?page=products" id="section-202">{{ text_contents.301|default:"Shop" }}</a> <span>/</span>
        <!-- {% if product.category %}
            <a href="../../?page=products&category={{ product.category.slug }}" id="section-203">{{ product.category.name }}</a> <span>/</span>
        {% endif %} -->
        <span class="current-product" id="section-203">{{ product.title|default:"Product Details" }}</span>
    </div>
</div>

{% for component in components %}
    {% if component.drop_zone == '200' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Product Details -->
<div class="container">
    {% if product %}
        <div class="product-details-container">
            <!-- Product Images -->
            <div class="product-images" id="section-204">
                <div class="main-image-container">
                    <img src="{% if product.main_image %}{{ product.main_image.url }}{% else %}https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=600&auto=format{% endif %}" 
                         alt="{{ product.title }}" 
                         class="main-image" 
                         id="mainProductImage">
                </div>
                <div class="thumbnail-container" id="thumbnailContainer">
                    {% if product.main_image %}
                        <img src="{{ product.main_image.url }}" alt="Main thumbnail" class="thumbnail active" data-image="{{ product.main_image.url }}">
                    {% endif %}
                    {% for image in product_images %}
                        <img src="{{ image.image.url }}" alt="Product thumbnail" class="thumbnail" data-image="{{ image.image.url }}">
                    {% empty %}
                        {% if product.image_gallery %}
                            {% for img_url in product.image_gallery|slice:":3" %}
                                <img src="{{ img_url }}" alt="Product thumbnail" class="thumbnail" data-image="{{ img_url }}">
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            <!-- Product Info -->
            <div class="product-info" id="section-205">
                <h1 class="product-title" id="section-206">{{ product.title|default:"Lumière Radiance Serum" }}</h1>
                <div class="product-rating">
                    <div class="stars">
                        {% for i in "12345"|make_list %}
                            {% if forloop.counter <= full_stars %}
                                <i class="fas fa-star" data-icon="100"></i>
                            {% elif forloop.counter == full_stars|add:1 and has_half_star %}
                                <i class="fas fa-star-half-alt" data-icon="101"></i>
                            {% else %}
                                <i class="far fa-star" data-icon="100"></i>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <span class="rating-count" id="section-207">{{ average_rating|default:"4.5" }} ({{ total_reviews|default:"128" }} Reviews)</span>
                </div>
                <div class="product-price" id="section-208">
                    {{ product.price|currency:page }}
                    {% if product.compare_at_price and product.compare_at_price > product.price %}
                        <span style="text-decoration: line-through; color: var(--lavender-mist); font-size: 1.2rem; margin-left: 0.5rem;">
                            {{ product.compare_at_price|currency:page }}
                        </span>
                    {% endif %}
                </div>
                <p class="product-description" id="section-209">
                    {{ product.short_description|default:product.description|striptags|truncatewords:50|default:"A luxurious radiance serum formulated with vitamin C and hyaluronic acid to brighten, hydrate, and restore youthful glow." }}
                </p>

                <!-- Color Variants -->
                {% if colors %}
                <div class="product-variants">
                    <div class="variant-title" id="section-210">{{ text_contents.307|default:"Color:" }}</div>
                    <div class="variant-options" id="colorOptions">
                        {% for color in colors %}
                            <div class="color-option {% if forloop.first %}active{% endif %}" 
                                 style="background-color: {{ color }};" 
                                 data-color="{{ color }}"
                                 title="{{ color|title }}"></div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Size Variants -->
                {% if sizes %}
                <div class="product-variants">
                    <div class="variant-title" id="section-211">{{ text_contents.308|default:"Size:" }}</div>
                    <div class="variant-options" id="sizeOptions">
                        {% for size in sizes %}
                            <div class="variant-option {% if forloop.first %}active{% endif %}" data-size="{{ size }}">{{ size }}</div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                <!-- Product Actions -->
                <div class="product-actions">
                    <button class="buy-now-btn" id="section-212" data-product-id="{{ product.id }}" data-product-title="{{ product.title }}" data-product-price="{{ product.price }}">
                        <i class="fas fa-bolt" data-icon="102"></i> {{ text_contents.309|default:"Buy Now" }}
                    </button>
                    <button class="add-to-cart-details" id="section-213" data-add-to-cart="{{ product.id }}">
                        <i class="fas fa-shopping-bag" data-icon="103"></i> {{ text_contents.310|default:"Add to Cart" }}
                    </button>
                    <button class="wishlist-details" data-add-to-wishlist="{{ product.id }}">
                        <i class="far fa-heart" data-icon="104"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Product Tabs -->
        <div class="product-tabs" id="section-214">
            <div class="tab-headers">
                <button class="tab-header active" id="section-215" data-tab="description">{{ text_contents.311|default:"Description" }}</button>
                <button class="tab-header" id="section-216" data-tab="ingredients">{{ text_contents.312|default:"Ingredients" }}</button>
                <button class="tab-header" id="section-217" data-tab="shipping">{{ text_contents.313|default:"Shipping & Returns" }}</button>
                <button class="tab-header" id="section-218" data-tab="reviews">{{ text_contents.314|default:"Reviews" }}</button>
            </div>

            <div class="tab-content active" id="description-tab">
                <h3 id="section-219">{{ text_contents.315|default:"Product Description" }}</h3>
                <div class="description-content" id="section-220">
                    {{ product.description|safe|default:"<p>This luxurious serum is formulated with premium ingredients to deliver visible results. The lightweight formula absorbs quickly, leaving skin feeling hydrated and looking radiant.</p><p><strong>Key Benefits:</strong></p><ul><li>Brightens and evens skin tone</li><li>Hydrates with hyaluronic acid</li><li>Reduces appearance of fine lines</li><li>Lightweight, fast-absorbing formula</li><li>Suitable for all skin types</li></ul>" }}
                </div>
            </div>

            <div class="tab-content" id="ingredients-tab">
                <h3 id="section-227">{{ text_contents.323|default:"Key Ingredients" }}</h3>
                <div class="ingredients-content" >
                    
                    {%for spec in product.dynamic_specs.all%}
                        <ul style="margin-left: 1.5rem; margin-top: 1rem;">
                            <li id="section-228"><strong>{{spec.title}}:</strong>{{spec.value}}</li>
                            <!-- <li id="section-225"><strong>Hyaluronic Acid:</strong> Provides deep hydration</li>
                            <li id="section-226"><strong>Vitamin E:</strong> Nourishes and soothes</li>
                            <li id="section-227"><strong>Ferulic Acid:</strong> Enhances stability and efficacy</li>
                            <li id="section-228"><strong>Aloe Vera:</strong> Calms and hydrates</li> -->
                        </ul>
                    {% endfor %}
                </div>
            </div>

            <div class="tab-content" id="shipping-tab">
                <h3 id="section-229">{{ text_contents.330|default:"Shipping & Returns" }}</h3>
                <div class="shipping-content" id="section-230">
                    <li id="section-37"><a href="{% url 'public_shipping_policy' subdomain=page.subdomain %}">Shipping & Returns</a></li>
                    <!-- <li id="section-38"><a href="{% url 'public_privacy' subdomain=page.subdomain %}">{{ text_contents.31|default:"Privacy Policy" }}</a></li>
                    <li id="section-39"><a href="{% url 'public_terms' subdomain=page.subdomain %}">{{ text_contents.32|default:"Terms & Conditions" }}</a></li>

                    <p><strong>Shipping:</strong> Free express shipping on all orders. Orders typically ship within 1-2 business days and arrive in 3-5 business days.</p>
                    <br>
                    <p><strong>Returns:</strong> We offer a 30-day return policy on unopened products in original packaging. For opened products, please contact our customer service team.</p>
                    <br>
                    <p><strong>Warranty:</strong> All products are backed by our 100% satisfaction guarantee.</p> -->
                </div>
            </div>

            <div class="tab-content" id="reviews-tab">
                <!-- Review Form -->
                <div class="review-form" id="section-238">
                    <h3 id="section-239">{{ text_contents.334|default:"Write a Review" }}</h3>
                    <form id="reviewForm" method="POST" action="{% url 'submit_review' page.subdomain %}">
                        {% csrf_token %}
                        <input type="hidden" name="product_id" value="{{ product.id }}">
                        <div class="rating-input">
                            <label id="section-240">{{ text_contents.335|default:"Your Rating:" }}</label>
                            <div class="star-rating-input" id="starRating">
                                <span class="star" data-rating="1" data-icon="105">★</span>
                                <span class="star" data-rating="2" data-icon="105">★</span>
                                <span class="star" data-rating="3" data-icon="105">★</span>
                                <span class="star" data-rating="4" data-icon="105">★</span>
                                <span class="star" data-rating="5" data-icon="105">★</span>
                            </div>
                            <input type="hidden" id="ratingValue" name="rating" value="0">
                        </div>
                        <div class="form-group">
                            <label id="section-241" for="reviewerName">{{ text_contents.336|default:"Your Name" }}</label>
                            <input type="text" id="reviewerName" name="user_name" required>
                        </div>
                        <div class="form-group">
                            <label id="section-242" for="reviewTitle">{{ text_contents.337|default:"Review Title" }}</label>
                            <input type="text" id="reviewTitle" name="title" required>
                        </div>
                        <div class="form-group">
                            <label id="section-243" for="reviewText">{{ text_contents.338|default:"Your Review" }}</label>
                            <textarea id="reviewText" name="comment" rows="4" required></textarea>
                        </div>
                        <button type="submit" class="submit-review-btn" id="section-244">{{ text_contents.339|default:"Submit Review" }}</button>
                    </form>
                    <!-- Success Popup (Hidden by default) -->
                <div style="display: none;" class="popup" id="successPopup">
                    <span class="popup-icon">✓</span>
                    <span class="popup-message">Review submitted successfully!</span>
                </div>
                </div>

                <!-- Customer Reviews -->
                <div class="customer-reviews" id="section-245">
                    <h3 id="section-246">{{ text_contents.340|default:"Customer Reviews" }}</h3>
                    {% if reviews %}
                        {% for review in reviews %}
                            <div class="review-item">
                                <div class="review-header">
                                    <div class="reviewer-name" id="section-247">{{ review.author_name|default:"Anonymous" }}</div>
                                    <div class="review-date" id="section-248">{{ review.created_at|date:"F d, Y" }}</div>
                                </div>
                                <div class="review-rating">
                                    {% for i in "12345"|make_list %}
                                        {% if forloop.counter <= review.rating %}
                                            <i class="fas fa-star" data-icon="100"></i>
                                        {% else %}
                                            <i class="far fa-star" data-icon="100"></i>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                                <div class="review-title" id="section-249">{{ review.title|default:"Great Product" }}</div>
                                <div class="review-text" id="section-250">{{ review.comment }}</div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="empty-state">
                            <p id="section-245">{{ text_contents.352|default:"No reviews yet. Be the first to review this product!" }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <div class="related-products" id="section-255">
            <h2 id="section-256">{{ text_contents.349|default:"You May Also Like" }}</h2>
            {% if related_products %}
                <div class="related-products-grid">
                    {% for related in related_products|slice:":4" %}
                        <a href="/product/{{ related.slug }}/" class="related-product-card">
                            <img src="{% if related.main_image %}{{ related.main_image.url }}{% else %}https://images.unsplash.com/photo-1596462502278-27bfdc5e29f2?w=300&auto=format{% endif %}" 
                                 alt="{{ related.title }}" 
                                 class="related-product-img">
                            <div class="related-product-info">
                                <div class="related-product-name" id="section-257">{{ related.title|truncatechars:30 }}</div>
                                <div class="related-product-price" id="section-258">{{ related.price|currency:page }}</div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="empty-state">
                    <p id="section-259">{{ text_contents.352|default:"No related products available for this item. Check back soon for new arrivals!" }}</p>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="empty-state">
            <h3 id="section-251">{{ text_contents.353|default:"Product Not Found" }}</h3>
            <p id="section-252">{{ text_contents.354|default:"The product you're looking for doesn't exist or has been removed." }}</p>
            <p><a href="../../?page=products" style="color: var(--mauve-rose); text-decoration: underline;" id="section-252">{{ text_contents.355|default:"Return to Shop" }}</a></p>
        </div>
    {% endif %}
</div>

{% for component in components %}
    {% if component.drop_zone == '245' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/footer2.html' %}

{% for component in components %}
    {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% render_icon_script %}
<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
    // Thumbnail Switcher
    const thumbnails = document.querySelectorAll('.thumbnail');
    const mainImage = document.getElementById('mainProductImage');

    if (thumbnails.length > 0 && mainImage) {
        thumbnails.forEach(thumbnail => {
            thumbnail.addEventListener('click', function() {
                thumbnails.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                const newImageSrc = this.getAttribute('data-image');
                if (newImageSrc) {
                    mainImage.src = newImageSrc;
                }
            });
        });
    }

    // Color Variant Selection
    const colorOptions = document.querySelectorAll('.color-option');
    if (colorOptions.length > 0) {
        colorOptions.forEach(option => {
            option.addEventListener('click', function() {
                colorOptions.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
            });
        });
    }

    // Size Variant Selection - FIXED
    const sizeOptions = document.querySelectorAll('.variant-option');
    if (sizeOptions.length > 0) {
        sizeOptions.forEach(option => {
            option.addEventListener('click', function() {
                // Remove active class from all size options
                sizeOptions.forEach(s => s.classList.remove('active'));
                // Add active class to clicked option
                this.classList.add('active');
                console.log('Selected size:', this.getAttribute('data-size'));
            });
        });
    }

    // Tab Switching
    const tabHeaders = document.querySelectorAll('.tab-header');
    const tabContents = document.querySelectorAll('.tab-content');

    if (tabHeaders.length > 0) {
        tabHeaders.forEach(header => {
            header.addEventListener('click', function() {
                const tabId = this.getAttribute('data-tab');
                tabHeaders.forEach(h => h.classList.remove('active'));
                tabContents.forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                document.getElementById(`${tabId}-tab`).classList.add('active');
            });
        });
    }

    // Star Rating for Review Form
    const stars = document.querySelectorAll('.star-rating-input .star');
    const ratingValue = document.getElementById('ratingValue');

    if (stars.length > 0) {
        stars.forEach(star => {
            star.addEventListener('click', function() {
                const rating = parseInt(this.getAttribute('data-rating'));
                ratingValue.value = rating;
                stars.forEach((s, index) => {
                    if (index < rating) {
                        s.classList.add('selected');
                    } else {
                        s.classList.remove('selected');
                    }
                });
            });
        });
    }

    // Helper functions for selected variants
    function getSelectedColor() {
        const activeColor = document.querySelector('.color-option.active');
        return activeColor ? activeColor.getAttribute('data-color') : '';
    }

    function getSelectedSize() {
        const activeSize = document.querySelector('.variant-option.active');
        return activeSize ? activeSize.getAttribute('data-size') : '';
    }

    // Show notification function
    function showNotification(message, type = 'success') {
        // Remove existing notifications
        const existingNotif = document.querySelector('.notification-popup');
        if (existingNotif) existingNotif.remove();

        const notification = document.createElement('div');
        notification.className = `notification-popup ${type}`;
        notification.innerHTML = `
            <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
            <span>${message}</span>
        `;
        document.body.appendChild(notification);

        setTimeout(() => {
            notification.style.animation = 'slideOut 0.3s ease';
            setTimeout(() => notification.remove(), 300);
        }, 3000);
    }

    // Add to Cart (handled by cart-manager.js)
    document.querySelectorAll('[data-add-to-cart]').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = this.dataset.addToCart;
            const quantity = 1;
            const selectedColor = getSelectedColor();
            const selectedSize = getSelectedSize();

            if (window.cartManager) {
                window.cartManager.addToCart(productId, quantity);
                showNotification('Item added to cart!', 'success');
            } else {
                fetch(`/builder/cart/add/{{ page.subdomain }}/`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': getCookie('csrftoken')
                    },
                    body: JSON.stringify({
                        product_id: productId,
                        quantity: quantity,
                        selected_color: selectedColor,
                        selected_size: selectedSize
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification('Item added to cart!', 'success');
                    } else {
                        showNotification(data.error || 'Error adding to cart', 'error');
                    }
                })
                .catch(() => showNotification('Network error. Please try again.', 'error'));
            }
        });
    });

    // Wishlist
    document.querySelectorAll('[data-add-to-wishlist]').forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = this.dataset.addToWishlist;

            if (window.cartManager) {
                window.cartManager.addToWishlist(productId);
                showNotification('Item added to wishlist!', 'success');
            } else {
                fetch(`/builder/wishlist/add/{{ page.subdomain }}/`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': getCookie('csrftoken')
                    },
                    body: JSON.stringify({ product_id: productId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification('Item added to wishlist!', 'success');
                    } else {
                        showNotification(data.error || 'Error adding to wishlist', 'error');
                    }
                })
                .catch(() => showNotification('Network error. Please try again.', 'error'));
            }
        });
    });

    // Buy Now Button - FIXED
    const buyNowBtn = document.querySelector('.buy-now-btn');
    if (buyNowBtn) {
        buyNowBtn.addEventListener('click', function() {
            const productId = this.dataset.productId;
            const productTitle = this.dataset.productTitle;
            const productPrice = parseFloat(this.dataset.productPrice);
            const selectedColor = getSelectedColor();
            const selectedSize = getSelectedSize();
            const quantity = 1;

            // Validate size selection if sizes exist
            const sizeOptionsExist = document.querySelectorAll('.variant-option').length > 0;
            if (sizeOptionsExist && !selectedSize) {
                showNotification('Please select a size', 'error');
                return;
            }

            // Create cart data for buy now
            const cartData = {
                items: [{
                    id: productId,
                    title: productTitle,
                    price: productPrice,
                    quantity: quantity,
                    selected_color: selectedColor,
                    selected_size: selectedSize,
                    total_price: productPrice * quantity
                }],
                subtotal: productPrice * quantity,
                shipping_amount: 5.00,
                tax_amount: (productPrice * quantity) * 0.08,
                total_amount: (productPrice * quantity) + 5.00 + ((productPrice * quantity) * 0.08),
                is_buy_now: true
            };

            // Get subdomain
            const hostname = window.location.hostname;
            const pageDomain = document.body.getAttribute('data-page-subdomain') || '{{ page.subdomain }}';
            const subdomain = hostname.includes('localhost') ? pageDomain : hostname.split('.')[0];

            // Redirect to payment selection
            const params = new URLSearchParams({
                type: 'instant',
                product: JSON.stringify(cartData.items[0])
            });

            window.location.href = `/payments/select-payment/${subdomain}/?${params.toString()}`;
        });
    }

    
    // CSRF Helper
    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }
</script>

<script>
// Review submission logic - FIXED (prevents redirect to JSON page)
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('reviewForm');
    const submitBtn = document.querySelector('.submit-review-btn');
    const successPopup = document.getElementById('successPopup');
    
    // Star rating functionality
    const stars = document.querySelectorAll('.star-rating-input .star');
    const ratingHiddenInput = document.getElementById('ratingValue');
    
    // Store original button text
    let originalButtonText = '';
    if (submitBtn) {
        originalButtonText = submitBtn.innerHTML;
    }
    
    // Function to reset star colors
    function resetStarRating() {
        if (ratingHiddenInput) {
            ratingHiddenInput.value = '0';
        }
        stars.forEach(star => {
            star.style.color = '#E0E0E0';
        });
    }
    
    // Add star rating click handlers
    if (stars.length > 0) {
        stars.forEach(star => {
            star.addEventListener('click', function() {
                const rating = this.getAttribute('data-rating');
                ratingHiddenInput.value = rating;
                console.log(`⭐ Rating selected: ${rating}`);
                
                // Update star colors based on rating
                stars.forEach(s => {
                    const starRating = parseInt(s.getAttribute('data-rating'));
                    if (starRating <= rating) {
                        s.style.color = '#FFD700';
                    } else {
                        s.style.color = '#E0E0E0';
                    }
                });
            });
            
            // Add hover effect
            star.addEventListener('mouseenter', function() {
                const rating = this.getAttribute('data-rating');
                stars.forEach(s => {
                    const starRating = parseInt(s.getAttribute('data-rating'));
                    if (starRating <= rating) {
                        s.style.color = '#FFD700';
                    }
                });
            });
        });
        
        // Reset hover effect on mouse leave
        const starContainer = document.querySelector('.star-rating-input');
        if (starContainer) {
            starContainer.addEventListener('mouseleave', function() {
                const currentRating = parseInt(ratingHiddenInput.value);
                stars.forEach(s => {
                    const starRating = parseInt(s.getAttribute('data-rating'));
                    if (currentRating > 0 && starRating <= currentRating) {
                        s.style.color = '#FFD700';
                    } else {
                        s.style.color = '#E0E0E0';
                    }
                });
            });
        }
    }
    
    if (form) {
        form.addEventListener('submit', async function(e) {
            // CRITICAL: Prevent default form submission (this stops redirect)
            e.preventDefault();
            e.stopPropagation();
            
            console.log('📝 Form submitted via AJAX');
            
            // Validate rating
            const rating = ratingHiddenInput.value;
            if (rating === '0') {
                showFormMessage('Please select a rating before submitting your review.', 'error');
                return;
            }
            
            // Validate name
            const userName = document.getElementById('reviewerName')?.value.trim();
            if (!userName) {
                showFormMessage('Please enter your name.', 'error');
                return;
            }
            
            // Validate comment
            const comment = document.getElementById('reviewText')?.value.trim();
            if (!comment) {
                showFormMessage('Please enter your review comment.', 'error');
                return;
            }
            
            // Disable button and show loading
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
            }
            
            try {
                // Get form data
                const formData = new FormData(form);
                
                // Get the correct URL from form action
                const submitUrl = form.getAttribute('action');
                console.log(`📤 Submitting to: ${submitUrl}`);
                
                // Submit via AJAX (this prevents page redirect)
                const response = await fetch(submitUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });
                
                const data = await response.json();
                console.log('📥 Server response:', data);
                
                if (data.success) {
                    // Show success popup
                    showSuccessPopup();
                    
                    // Reset form
                    form.reset();
                    resetStarRating();
                    
                    // Clear any existing messages
                    const existingMessages = form.querySelector('.form-messages');
                    if (existingMessages) {
                        existingMessages.remove();
                    }
                    
                    // Show success message
                    showFormMessage('Review submitted successfully! Page will refresh...', 'success');
                    
                    // Reload page after 2 seconds to show new review
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                    
                } else {
                    // Show error message
                    showFormMessage(data.error || 'Error submitting review. Please try again.', 'error');
                    
                    // Re-enable button
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalButtonText;
                    }
                }
                
            } catch (error) {
                console.error('❌ Error:', error);
                showFormMessage('Network error. Please try again.', 'error');
                
                // Re-enable button
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalButtonText;
                }
            }
        });
    }
    
    function showSuccessPopup() {
        if (successPopup) {
            successPopup.classList.add('show');
            successPopup.style.display = 'block';
            
            setTimeout(() => {
                successPopup.classList.remove('show');
                successPopup.style.display = 'none';
            }, 2000);
        } else {
            // Alternative if no popup element exists
            console.log('Review submitted successfully!');
        }
    }
    
    function showFormMessage(message, type) {
        // Remove any existing message container
        const existingContainer = form.querySelector('.form-messages');
        if (existingContainer) {
            existingContainer.remove();
        }
        
        // Create message container
        const messageContainer = document.createElement('div');
        messageContainer.className = `form-messages`;
        messageContainer.style.marginTop = '15px';
        messageContainer.style.padding = '12px';
        messageContainer.style.borderRadius = '6px';
        messageContainer.style.backgroundColor = type === 'error' ? '#f8d7da' : '#d4edda';
        messageContainer.style.border = `1px solid ${type === 'error' ? '#f5c6cb' : '#c3e6cb'}`;
        messageContainer.style.color = type === 'error' ? '#721c24' : '#155724';
        
        messageContainer.innerHTML = `
            <div style="display: flex; align-items: center; gap: 10px;">
                <span>${type === 'error' ? '❌' : '✅'}</span>
                <span style="flex: 1;">${message}</span>
                <button onclick="this.parentElement.parentElement.remove()" 
                        style="background: none; border: none; font-size: 18px; cursor: pointer;">&times;</button>
            </div>
        `;
        
        // Insert after the submit button
        if (submitBtn) {
            submitBtn.parentNode.insertBefore(messageContainer, submitBtn.nextSibling);
        } else {
            form.appendChild(messageContainer);
        }
        
        // Auto-hide after 5 seconds
        setTimeout(() => {
            if (messageContainer) {
                messageContainer.style.opacity = '0';
                messageContainer.style.transition = 'opacity 0.3s ease';
                setTimeout(() => {
                    if (messageContainer.parentNode) {
                        messageContainer.remove();
                    }
                }, 300);
            }
        }, 5000);
    }
    
    // Initial star rating reset
    resetStarRating();
    
    console.log('✅ Review form initialized - AJAX mode enabled');
});
</script>

</body>
</html>