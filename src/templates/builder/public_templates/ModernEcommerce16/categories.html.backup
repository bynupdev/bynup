<!-- builder/public_templates/ModernEcommerce16/categories.html -->
{% load static %}
{% load style_filters %}
{% load color_filters %}
{% load currency_filters %}
{% load icon_filters %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - {{ page.brand_name }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Montserrat:wght@100;200;300;400;500;600&display=swap" rel="stylesheet">
    {% render_icon_data icon_customizations %}
    <style>
        :root {
            --soft-blush: #FAEEE9;
            --champagne-glow: #F5D69B;
            --mauve-rose: #A77A95;
            --lavender-mist: #C3C3D5;
            --plum-brown: #735366;
            --spacing-xl: 6rem;
            --spacing-lg: 4rem;
            --spacing-md: 2rem;
            --spacing-sm: 1rem;
            --border-radius: 12px;
            --transition: all 0.3s ease;
        }
        {% generate_color_variables %}

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--soft-blush);
            color: var(--plum-brown);
            overflow-x: hidden;
            line-height: 1.6;
            padding-top: 100px;
        }

        h1, h2, h3, h4 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 500;
            letter-spacing: -0.01em;
        }

        .container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Page Header */
        .page-header {
            text-align: center;
            padding: var(--spacing-lg) 0 var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }

        h1 {
            font-size: 3rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 1rem;
            position: relative;
            display: inline-block;
        }

        h1::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 120px;
            height: 2px;
            background: linear-gradient(90deg, var(--mauve-rose), var(--champagne-glow));
        }

        .page-header p {
            color: var(--plum-brown);
            font-size: 1.1rem;
            max-width: 700px;
            margin: 1rem auto 0;
            opacity: 0.8;
        }

        /* Categories Filter */
        .categories-filter {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: var(--spacing-lg);
            flex-wrap: wrap;
        }

        .filter-cat-btn {
            padding: 0.7rem 1.8rem;
            background: white;
            border: 1px solid rgba(115, 83, 102, 0.2);
            border-radius: 40px;
            color: var(--plum-brown);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .filter-cat-btn:hover {
            border-color: var(--mauve-rose);
            color: var(--mauve-rose);
            transform: translateY(-2px);
        }

        .filter-cat-btn.active {
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            border-color: transparent;
        }

        /* Categories Grid */
        .categories-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-xl);
        }

        .category-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            border: 1px solid rgba(195, 195, 213, 0.2);
            position: relative;
            text-decoration: none;
            display: block;
            color: inherit;
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 30px rgba(115, 83, 102, 0.12);
            border-color: var(--champagne-glow);
        }

        .category-image-container {
            position: relative;
            overflow: hidden;
            aspect-ratio: 1 / 1;
        }

        .category-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .category-card:hover .category-image {
            transform: scale(1.1);
        }

        .category-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(115, 83, 102, 0.8), transparent);
            padding: 1.5rem;
            color: var(--soft-blush);
        }

        .category-overlay h3 {
            font-size: 1.3rem;
            margin-bottom: 0.3rem;
            color: var(--soft-blush);
        }

        .category-overlay .product-count {
            font-size: 0.8rem;
            opacity: 0.9;
        }

        .category-info {
            padding: 1.2rem;
            text-align: center;
        }

        .category-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.3rem;
        }

        .category-description {
            color: var(--plum-brown);
            font-size: 0.85rem;
            line-height: 1.5;
            margin-bottom: 1rem;
            opacity: 0.7;
        }

        .explore-btn {
            display: inline-block;
            background: transparent;
            color: var(--mauve-rose);
            border: 1px solid var(--mauve-rose);
            padding: 0.5rem 1.2rem;
            font-size: 0.8rem;
            border-radius: 40px;
            transition: var(--transition);
            cursor: pointer;
            text-decoration: none;
        }

        .explore-btn:hover {
            background: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Featured Collections Section */
        .featured-collections {
            margin-top: var(--spacing-xl);
            padding-top: var(--spacing-lg);
            border-top: 1px solid rgba(115, 83, 102, 0.1);
        }

        .featured-collections h2 {
            font-size: 2rem;
            text-align: center;
            margin-bottom: var(--spacing-lg);
            color: var(--plum-brown);
        }

        .collections-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-bottom: var(--spacing-lg);
        }

        .collection-card {
            background: white;
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            box-shadow: 0 5px 15px rgba(115, 83, 102, 0.05);
            text-decoration: none;
            display: block;
            color: inherit;
            cursor: pointer;
        }

        .collection-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(115, 83, 102, 0.1);
        }

        .collection-image {
            width: 100%;
            aspect-ratio: 1 / 1;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .collection-card:hover .collection-image {
            transform: scale(1.05);
        }

        .collection-info {
            padding: 1.2rem;
            text-align: center;
        }

        .collection-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.2rem;
            font-weight: 500;
            color: var(--plum-brown);
            margin-bottom: 0.5rem;
        }

        .collection-description {
            color: var(--plum-brown);
            font-size: 0.85rem;
            line-height: 1.5;
            margin-bottom: 1rem;
            opacity: 0.7;
        }

        .view-collection-btn {
            display: inline-block;
            background: transparent;
            color: var(--mauve-rose);
            border: 1px solid var(--mauve-rose);
            padding: 0.5rem 1.2rem;
            font-size: 0.8rem;
            border-radius: 40px;
            transition: var(--transition);
        }

        .view-collection-btn:hover {
            background: var(--mauve-rose);
            color: var(--soft-blush);
        }

        /* Empty State */
        .empty-categories {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: var(--border-radius);
            box-shadow: 0 5px 20px rgba(115, 83, 102, 0.05);
            margin: 2rem 0;
            grid-column: 1 / -1;
        }

        .empty-categories-icon {
            font-size: 4rem;
            color: var(--champagne-glow);
            margin-bottom: 1.5rem;
        }

        .empty-categories h2 {
            font-size: 2rem;
            color: var(--plum-brown);
            margin-bottom: 1rem;
        }

        .empty-categories p {
            color: var(--plum-brown);
            opacity: 0.8;
            margin-bottom: 1.5rem;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        .add-category-btn {
            display: inline-block;
            background: linear-gradient(135deg, var(--plum-brown), var(--mauve-rose));
            color: var(--soft-blush);
            padding: 0.9rem 2rem;
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 1px;
            text-decoration: none;
            border-radius: 40px;
            transition: var(--transition);
        }

        .add-category-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(115, 83, 102, 0.2);
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .categories-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .collections-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (max-width: 992px) {
            .categories-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .collections-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }
            h1 {
                font-size: 2rem;
            }
            .container {
                padding: 0 1.5rem;
            }
            .categories-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            .collections-grid {
                grid-template-columns: 1fr;
                max-width: 400px;
                margin: 0 auto;
            }
            .categories-filter {
                gap: 0.8rem;
            }
            .filter-cat-btn {
                padding: 0.6rem 1.2rem;
                font-size: 0.8rem;
            }
        }

        @media (max-width: 576px) {
            h1 {
                font-size: 1.8rem;
            }
            .page-header p {
                font-size: 1rem;
            }
            .categories-filter {
                flex-direction: column;
                align-items: stretch;
            }
            .filter-cat-btn {
                text-align: center;
            }
        }

        /* Dynamic Section Styles */
        {% generate_section_styles style_customizations 375 400 %}
        {% generate_background_images background_images 375 400 %}
        {% generate_hover_keyframes %}
    </style>
</head>
<body data-page-subdomain="{{ page.subdomain }}">

<!-- Header -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/header.html' %}

{% for component in components %}
    {% if component.drop_zone == '1' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Page Header -->
<div class="page-header" id="section-375">
    <div class="container">
        <h1 id="section-376">{{ text_contents.700|default:"Shop by Category" }}</h1>
        <p id="section-377">{{ text_contents.701|default:"Explore our curated skincare collections designed for every skin type and concern." }}</p>
    </div>
</div>

{% for component in components %}
    {% if component.drop_zone == '375' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Categories Filter -->
<div class="container">
    <div class="categories-filter" id="categoriesFilter">
        <button class="filter-cat-btn active" data-filter="all" id="section-378">{{ text_contents.702|default:"All Categories" }}</button>
        {% for category in categories %}
            <button class="filter-cat-btn" data-filter="{{ category.slug|default:category.name|slugify }}">{{ category.name }}</button>
        {% endfor %}
    </div>
</div>

<!-- Categories Grid -->
<div class="container">
    {% if categories %}
        <div class="categories-grid" id="categories-grid">
            {% for category in categories %}
                <div class="category-card" id="section-379"
                     data-category="{{ category.slug|default:category.name|slugify }}">
                    <div class="category-image-container">
                        <img src="{% if category.image %}{{ category.image.url }}{% else %}https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=400&auto=format{% endif %}" 
                             alt="{{ category.name }}" 
                             class="category-image">
                        <div class="category-overlay">
                            <h3>{{ category.name }}</h3>
                            <div class="product-count">{{ category.get_active_products_count }} Products</div>
                        </div>
                    </div>
                    <div class="category-info">
                        <div class="category-name" id="section-380">{{ category.name }}</div>
                        <div class="category-description" id="section-381">{{ category.description|default:"Discover our curated selection of premium skincare products."|truncatechars:60 }}</div>
                        <a href="?page=products&category={{ category.slug }}" class="explore-btn" id="section-382">{{ text_contents.705|default:"Explore →" }}</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-categories" id="section-379">
            <div class="empty-categories-icon">
                <i class="fas fa-gem" data-icon="500"></i>
            </div>
            <h2 id="section-381">{{ text_contents.710|default:"No Categories Available" }}</h2>
            <p id="section-382">{{ text_contents.711|default:"There are no skincare categories to display at the moment. Categories will appear here once they are added to your store." }}</p>
            <a href="{{ SITE_DOMAIN }}/manage-product-categories/{{ page.subdomain }}/" class="add-category-btn" id="section-391">{{ text_contents.712|default:"Add Your First Category →" }}</a>
        </div>
    {% endif %}

    <!-- Featured Collections Section -->
    <div class="featured-collections" id="section-383">
        <h2 id="section-384">{{ text_contents.706|default:"Featured Collections" }}</h2>
        {% if categories|length >= 3 %}
            <div class="collections-grid">
                {% for category in categories|slice:":3" %}
                    <div class="collection-card" data-category-slug="{{ category.slug }}">
                        <img src="{% if category.image %}{{ category.image.url }}{% else %}https://images.unsplash.com/photo-1570194065650-d99fb4f8f5fa?w=400&auto=format{% endif %}" 
                             alt="{{ category.name }}" 
                             class="collection-image">
                        <div class="collection-info">
                            <div class="collection-name" id="section-384">{{ category.name }} Collection</div>
                            <div class="collection-description" id="section-385">{{ category.description|default:"Discover our exclusive collection of premium skincare products."|truncatechars:80 }}</div>
                            <a href="?page=products&category={{ category.slug }}" class="view-collection-btn" id="section-386">{{ text_contents.709|default:"View Collection →" }}</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-categories" style="grid-column: 1 / -1;">
                <div class="empty-categories-icon">
                    <i class="fas fa-star" data-icon="501"></i>
                </div>
                <p>Add categories to see featured collections here.</p>
            </div>
        {% endif %}
    </div>
</div>

{% for component in components %}
    {% if component.drop_zone == '392' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

<!-- Footer -->
{% include 'builder/public_templates/ModernEcommerce16/snippets/footer.html' %}

{% for component in components %}
    {% if component.drop_zone == 'end' %}
        <section class="dynamic-component" data-instance-id="{{ component.instance_id }}">
            {{ component.html_content|safe }}
        </section>
    {% endif %}
{% endfor %}

{% render_icon_script %}
<script src="{% static 'builder/js/cart-manager.js' %}"></script>

<script>
    // Category Filtering
    const filterButtons = document.querySelectorAll('.filter-cat-btn');
    const categoryCards = document.querySelectorAll('.category-card');
    
    if (filterButtons.length > 0 && categoryCards.length > 0) {
        filterButtons.forEach(btn => {
            btn.addEventListener('click', function() {
                filterButtons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const filter = this.getAttribute('data-filter');
                
                let visibleCount = 0;
                categoryCards.forEach(card => {
                    const category = card.getAttribute('data-category');
                    if (filter === 'all' || category === filter) {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                const categoriesGrid = document.getElementById('categories-grid');
                const existingEmptyMsg = document.querySelector('.filter-empty-message');
                
                if (visibleCount === 0 && !existingEmptyMsg && categoriesGrid) {
                    const emptyMsg = document.createElement('div');
                    emptyMsg.className = 'empty-categories filter-empty-message';
                    emptyMsg.style.gridColumn = '1 / -1';
                    emptyMsg.innerHTML = `
                        <div class="empty-categories-icon">
                            <i class="fas fa-filter"></i>
                        </div>
                        <h3>No categories match your filter</h3>
                        <p>Try selecting a different category filter.</p>
                    `;
                    categoriesGrid.appendChild(emptyMsg);
                } else if (visibleCount > 0 && existingEmptyMsg) {
                    existingEmptyMsg.remove();
                }
            });
        });
    }
    
    // Collection card click tracking
    const collectionCards = document.querySelectorAll('.collection-card');
    collectionCards.forEach(card => {
        card.addEventListener('click', function(e) {
            if (e.target.tagName === 'A' || e.target.closest('a')) {
                return;
            }
            const categorySlug = this.getAttribute('data-category-slug');
            if (categorySlug) {
                window.location.href = `?page=products&category=${categorySlug}`;
            }
        });
    });
    
    // Explore buttons
    const exploreBtns = document.querySelectorAll('.explore-btn');
    exploreBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
            console.log('Exploring category');
        });
    });
</script>

</body>
</html>