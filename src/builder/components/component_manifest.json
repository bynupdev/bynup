          "kind": "dynamic",
          "file": "products/product-carousel.html",
          "thumbnail": null,
          "display_order": 1,
          "default_config": {
            "limit": 6,
            "featured_only": false,
            "order_by": "-created_at"
          },
          "config_schema": {
            "limit": {
              "type": "int",
              "label": "Products to show",
              "default": 6,
              "min": 1,
              "max": 24
            },
            "featured_only": {
              "type": "bool",
              "label": "Featured only",
              "default": false
            },
            "order_by": {
              "type": "select",
              "label": "Sort by",
              "default": "-created_at",
              "options": [
                { "value": "-created_at", "label": "Newest first" },
                { "value": "created_at", "label": "Oldest first" },
                { "value": "price", "label": "Price: Low → High" },
                { "value": "-price", "label": "Price: High → Low" },
                { "value": "-sale_count", "label": "Best selling" }
              ]
            }
          }
        },
